@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@inject ISpecService SpecService

@if (!string.IsNullOrWhiteSpace(_text))
{
    <div class="@CssClass" style="@Style">@_text</div>
}

@code {
    [Parameter] public string OwnerType { get; set; } = SpecOwners.Alternative;
    [Parameter] public int OwnerId { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string Style { get; set; } = "margin-top:8px;font-size:.9rem;line-height:1.7;color:#475569;";

    private int _loadedOwner;
    private string _loadedOwnerType = "";
    private string _text = "";

    protected override async Task OnParametersSetAsync()
    {
        if (OwnerId == _loadedOwner && OwnerType == _loadedOwnerType) return;
        _loadedOwner = OwnerId;
        _loadedOwnerType = OwnerType;
        _text = "";
        if (OwnerId <= 0) return;
        try
        {
            var questions = await SpecService.GetStandardQuestionsAsync();
            var answers = await SpecService.GetAnswersAsync(OwnerType, OwnerId);
            var lines = new List<string>();
            foreach (var q in questions)
            {
                var a = answers.FirstOrDefault(x => x.QuestionId == q.QuestionId);
                if (a == null) continue;
                string? value = q.DataType switch
                {
                    SpecDataTypes.Choice => !string.IsNullOrWhiteSpace(a.TextValue)
                        ? a.TextValue
                        : q.Options.FirstOrDefault(o => o.OptionId == a.OptionId)?.OptionNameAr,
                    SpecDataTypes.Number => a.NumberValue.HasValue ? $"{a.NumberValue:0.##} {q.UnitName}".Trim() : null,
                    _ => !string.IsNullOrWhiteSpace(a.TextValue)
                        ? a.TextValue
                        : q.Options.FirstOrDefault(o => o.OptionId == a.OptionId)?.OptionNameAr
                };
                if (!string.IsNullOrWhiteSpace(value))
                    lines.Add($"{q.QuestionNameAr}: {value}");
            }
            _text = string.Join(" · ", lines);
        }
        catch
        {
            _text = "";
        }
    }
}
