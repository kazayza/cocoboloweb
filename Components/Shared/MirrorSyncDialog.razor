@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using MudBlazor

@inject IInvoiceService InvoiceService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.SyncAlt" Color="Color.Warning" />
            <MudText Typo="Typo.h6">تنبيه: فاتورة المشتريات المرآة</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
                غيّرت أصناف العميل في فاتورة البيع رقم <b>@SaleReferenceNumber</b> —
                لازم يتعمل نفس التعديل في فاتورة الشراء المرآة <b>#@MirrorTransactionId</b>
                عشان المخزون وتكلفة المبيعات يفضلوا متوازنين.
            </MudAlert>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                ⚠️ لو كنت عدّلت المرآة يدوياً قبل ما تحفظ البيع — متستخدمش المزامنة الأوتوماتيك
                عشان التغيير ميتحسبش مرتين. اختار «افتح المرآة» وراجعها بنفسك.
            </MudText>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())" Disabled="_busy">
            لاحقاً
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Info"
                   StartIcon="@Icons.Material.Filled.Edit"
                   Disabled="_busy"
                   OnClick="@(() => MudDialog.Close(DialogResult.Ok("open")))">
            افتح المرآة أعدلها بنفسي
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.SyncAlt"
                   Disabled="_busy"
                   OnClick="SyncNow">
            زامن المرآة أوتوماتيك
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int MirrorTransactionId { get; set; }
    [Parameter] public string? SaleReferenceNumber { get; set; }
    [Parameter] public string? CurrentUserName { get; set; }

    private bool _busy;

    private async Task SyncNow()
    {
        _busy = true;
        try
        {
            var (ok, msg) = await InvoiceService.SyncMirrorWithSaleAsync(
                MirrorTransactionId, CurrentUserName ?? "system");
            Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);
            MudDialog.Close(DialogResult.Ok("synced"));
        }
        finally
        {
            _busy = false;
        }
    }
}
