        "get_price_change_requests" => Icons.Material.Filled.LocalOffer,
        "get_pending_delivery_permissions" => Icons.Material.Filled.LocalShipping,
        "get_attendance_today" => Icons.Material.Filled.HowToReg,
        "get_employee_attendance" => Icons.Material.Filled.EventAvailable,
        "get_employees_overview" => Icons.Material.Filled.Badge,
        "get_exemptions" => Icons.Material.Filled.EventBusy,
        "get_my_schedule" => Icons.Material.Filled.Schedule,
        _ => Icons.Material.Filled.Hub
    };
}
