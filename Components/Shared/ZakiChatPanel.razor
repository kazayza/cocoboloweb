    // فتح إشعار من الجدول (بيعلّمه مقروء ويفتح الصفحة)
    // ════════════════════════════════════════════════════════════
    private async Task OpenLinkAsync(ZakiRowLink link)
    {
        if (_user is null) return;

        var ok = await Notifs.MarkAsReadAsync(link.NotificationId, _user);
        if (!ok)
        {
            _voiceStatus = "الإشعار ده مش متاح ليك دلوقتي.";
            return;
        }

        var targetPath = Nav.ToAbsoluteUri(link.Url).AbsolutePath;
        var currentPath = new Uri(Nav.Uri).AbsolutePath;
        var samePage = string.Equals(currentPath, targetPath, StringComparison.OrdinalIgnoreCase);

        State.SetMiniOpen(false);
        Nav.NavigateTo(link.Url, forceLoad: samePage);
    }

