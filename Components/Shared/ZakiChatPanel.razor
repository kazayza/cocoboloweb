    private async Task ToggleHistoryAsync()
    {
        if (State.HistoryOpen)
        {
            State.SetHistoryOpen(false);
            return;
        }

        // بنحدّث القائمة الأول، وبعدين نفتحها (عشان ما يظهرش "فاضي" لحظة)
        await State.RefreshHistoryAsync(LogService, _userName ?? "");
        State.SetHistoryOpen(true);
    }

    private async Task OpenHistoryAsync(long conversationId)
    {
        if (State.IsBusy) return;
        _voiceStatus = null;
        await State.OpenConversationAsync(LogService, _userName ?? "", conversationId);
    }

    private async Task StopVoiceAsync()
    {
        _recording = false;
        _transcribing = true;
        _voiceStatus = "جاري تحويل الصوت لنص...";

        try
        {
            var clip = await JS.InvokeAsync<ZakiVoiceClip>("zakiVoice.stop");
            var bytes = Convert.FromBase64String(clip.Data ?? "");

            var mime = (clip.Mime ?? "audio/webm").Split(';')[0];
            var fileName = mime.Contains("mp4") ? "voice.mp4"
                         : mime.Contains("ogg") ? "voice.ogg"
                         : "voice.webm";

            var result = await VoiceService.TranscribeAsync(bytes, fileName, mime);

            if (result.Success)
            {
                _question = string.IsNullOrWhiteSpace(_question) ? result.Text : _question + " " + result.Text;
                _voiceStatus = null;
            }
            else
            {
                _voiceStatus = result.ErrorMessage;
            }
        }
        catch (Exception)
        {
            _voiceStatus = "حصل خطأ أثناء تسجيل الصوت. حاول تاني.";
        }
        finally
        {
            _transcribing = false;
        }
    }

    /// <summary>تنزيل الجدول كملف Excel</summary>
    private async Task ExportExcelAsync(ZakiTable table)
    {
        var base64 = ZakiExcelExporter.ToBase64(table);
        var fileName = ZakiExcelExporter.SafeFileName(table.Title) + ".xlsx";
        await JS.InvokeVoidAsync("downloadFileFromBase64", base64, fileName);
    }

    /// <summary>تنزيل الجدول كـ PDF رسمي (قالب ثابت — هيدر الشركة + الجدول + الفوتر)</summary>
    private async Task ExportPdfAsync(ZakiTable table)
    {
        try
        {
            var auth = await AuthProvider.GetAuthenticationStateAsync();
            var userName = auth.User.Identity?.Name ?? "";
            var bytes = PdfReports.GenerateTablePdf(table, userName);
            var base64 = Convert.ToBase64String(bytes);
            var fileName = ZakiExcelExporter.SafeFileName(table.Title) + ".pdf";
            await JS.InvokeVoidAsync("downloadFile", fileName, "application/pdf", base64);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Zaki PDF export failed: {ex.Message}");
        }
    }

