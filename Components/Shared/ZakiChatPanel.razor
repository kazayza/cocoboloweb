        "get_top_customers" => Icons.Material.Filled.Groups,
        "get_top_products" => Icons.Material.Filled.Inventory2,
        "get_sales_breakdown" => Icons.Material.Filled.PieChart,
        "get_sales_invoice_details" => Icons.Material.Filled.ReceiptLong,
        "get_customer_invoices" => Icons.Material.Filled.PersonSearch,
        "get_purchase_invoices_summary" => Icons.Material.Filled.ShoppingCart,
        "get_open_purchase_invoices" => Icons.Material.Filled.Money,
        "get_purchase_invoice_details" => Icons.Material.Filled.ReceiptLong,
        "get_payments_summary" => Icons.Material.Filled.Payments,
        "get_employee_tasks" => Icons.Material.Filled.Assignment,
        "get_invoice_edit_history" => Icons.Material.Filled.History,
