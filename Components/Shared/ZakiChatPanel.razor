@implements IDisposable

@using COCOBOLOERPNEW.Services.Assistant
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using System.Security.Claims

@inject ZakiAssistantService ZakiService
@inject ZakiChatState State
@inject ZakiLogService LogService
@inject ISnackbar Snackbar
@inject ZakiVoiceService VoiceService
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS
@inject ZakiNotificationService Notifs
@inject ZakiReportPdfService PdfReports
@inject NavigationManager Nav

<div class="zk-panel @(Compact ? "zk-compact" : "")">

    <!-- ═══ شريط السجل ═══ -->
    <div class="zk-bar">
        <button class="zk-chip @(State.HistoryOpen ? "zk-chip-on" : "")"
                disabled="@State.IsBusy"
                @onclick="ToggleHistoryAsync">
            <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" Class="zk-chip-icon" />
            <span>السجل</span>
        </button>
    </div>

    @if (State.HistoryOpen)
    {
        <div class="zk-history">
            @if (State.History.Count == 0)
            {
                <div class="zk-note">مفيش محادثات سابقة ليك لسه.</div>
            }

            @foreach (var h in State.History)
            {
                <button class="zk-history-item @(h.ConversationId == State.ConversationId ? "zk-history-current" : "")"
                        disabled="@State.IsBusy"
                        @onclick="() => OpenHistoryAsync(h.ConversationId)">
                    <span class="zk-history-title">@(string.IsNullOrWhiteSpace(h.Title) ? "محادثة" : h.Title)</span>
                    <span class="zk-history-date">@h.StartedAt.ToString("yyyy-MM-dd HH:mm")</span>
                </button>
            }
        </div>
    }

    <!-- ═══ أسئلة سريعة ═══ -->
    <div class="zk-suggest">
        @foreach (var s in Compact ? _suggestions.Take(4) : _suggestions)
        {
            <button class="zk-chip" disabled="@State.IsBusy" @onclick="() => AskSuggestion(s.Text)">
                <MudIcon Icon="@s.Icon" Size="Size.Small" Class="zk-chip-icon" />
                <span>@s.Text</span>
            </button>
        }
    </div>

    <!-- ═══ المحادثة (من تحت لفوق: آخر رسالة دايماً ظاهرة) ═══ -->
    <div class="zk-chat">

        @if (State.IsBusy)
        {
            <div class="zk-row zk-row-bot">
                <div class="zk-bot-avatar">
                    <img src="img/zaki-icon.png" class="zk-bot-img" alt="" />
                </div>
                <div class="zk-typing">
                    <span></span><span></span><span></span>
                </div>
            </div>
        }

        @for (int i = State.Items.Count - 1; i >= 0; i--)
        {
            var item = State.Items[i];

            @if (item.IsUser)
            {
                <div class="zk-row zk-row-user">
                    <div class="zk-bubble">@item.Text</div>
                </div>
            }
            else
            {
                <div class="zk-row zk-row-bot">
                    <div class="zk-bot-avatar">
                        <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Small" />
                    </div>
                    <div class="zk-bot-body">

                        <div class="zk-bubble @(item.Ok ? "" : "zk-bubble-error")">@RenderRich(item.Text)</div>

                        @if (item.MessageId.HasValue)
                        {
                            <div class="zk-feedback">
                                <MudIconButton Icon="@(item.Useful == true ? Icons.Material.Filled.ThumbUp : Icons.Material.Outlined.ThumbUp)"
                                               Size="Size.Small" Title="مفيد"
                                               Color="@(item.Useful == true ? Color.Success : Color.Default)"
                                               OnClick="@(() => GiveFeedbackAsync(item, true))" />
                                <MudIconButton Icon="@(item.Useful == false ? Icons.Material.Filled.ThumbDown : Icons.Material.Outlined.ThumbDown)"
                                               Size="Size.Small" Title="مش مفيد"
                                               Color="@(item.Useful == false ? Color.Error : Color.Default)"
                                               OnClick="@(() => GiveFeedbackAsync(item, false))" />
                                @if (item.Useful != null)
                                {
                                    <span class="zk-feedback-note">@(item.Useful == true ? "اتسجل: مفيد ✓" : "اتسجل: مش مفيد. هنحسّن الرد ده")</span>
                                }
                            </div>
                        }

                        @if (item.Tools.Count > 0)
                        {
                            <div class="zk-tools">
                                @foreach (var tool in item.Tools)
                                {
                                    <span class="zk-tool">
                                        <MudIcon Icon="@ToolIcon(tool)" Size="Size.Small" Class="zk-tool-icon" />
                                        @ToolLabel(tool)
                                    </span>
                                }
                            </div>
                        }

                        @foreach (var t in item.Tables)
                        {
                            <div class="zk-table-card">
                                <div class="zk-table-head">
                                    <span class="zk-table-title">@t.Title</span>
                                    <button class="zk-export" @onclick="() => ExportExcelAsync(t)">
                                        <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" />
                                        تصدير Excel
                                    </button>
                                    <button class="zk-export zk-export-pdf" @onclick="() => ExportPdfAsync(t)">
                                        <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small" />
                                        تصدير PDF
                                    </button>
                                </div>
                                <div class="zk-table-scroll">
                                    <table class="zk-table">
                                        <thead>
                                            <tr>
                                                @foreach (var h in t.Headers)
                                                {
                                                    <th>@h</th>
                                                }
                                                @if (t.RowLinks != null)
                                                {
                                                    <th></th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int ri = 0; ri < t.Rows.Count; ri++)
                                            {
                                                var row = t.Rows[ri];
                                                var link = (t.RowLinks != null && ri < t.RowLinks.Count) ? t.RowLinks[ri] : null;
                                                <tr>
                                                    @foreach (var cell in row)
                                                    {
                                                        <td>@cell</td>
                                                    }
                                                    @if (t.RowLinks != null)
                                                    {
                                                        <td>
                                                            @if (link != null)
                                                            {
                                                                <button class="zk-open" @onclick="() => OpenLinkAsync(link)">فتح</button>
                                                            }
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <div class="zk-table-stamp">البيانات حتى @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        }

                        @if (item.Tokens > 0)
                        {
                            <div class="zk-meta">التوكنز: @item.Tokens</div>
                        }
                    </div>
                </div>
            }
        }

        @if (State.Items.Count == 0)
        {
            <div class="zk-empty">
                <img src="img/zaki-icon.png" class="zk-empty-img" alt="زكي" />
                <div class="zk-empty-title">اسأل زكي عن شغلك أو عن أي حاجة</div>
                <div class="zk-empty-sub">اكتب سؤالك، أو ابدأ بضغطة:</div>
                <div class="zk-starters">
                    @foreach (var st in _starters)
                    {
                        <button type="button" class="zk-starter" disabled="@State.IsBusy" @onclick="() => AskSuggestion(st.Text)">
                            <MudIcon Icon="@st.Icon" Size="Size.Small" Class="zk-chip-icon" />
                            <span>@st.Text</span>
                        </button>
                    }
                </div>
            </div>
        }

        @if (!State.IsBusy && Suggestions.Count > 0)
        {
            <div class="zk-followup">
                <span class="zk-followup-label">أسئلة مقترحة:</span>
                @foreach (var sug in Suggestions)
                {
                    <button type="button" class="zk-followup-chip" @onclick="() => AskSuggested(sug)">@sug</button>
                }
            </div>
        }
    </div>

    <!-- ═══ شريط الكتابة ═══ -->
    <div class="zk-input">
        <MudTextField @bind-Value="_question"
                      Placeholder="اكتب سؤالك لزكي..."
                      Variant="Variant.Text"
                      DisableUnderLine="true"
                      Immediate="true"
                      Disabled="@State.IsBusy"
                      OnKeyDown="HandleKey"
                      Class="zk-input-field" />

        <MudIconButton Icon="@(_recording ? Icons.Material.Filled.Stop : Icons.Material.Filled.Mic)"
                       Class="@(_recording ? "zk-mic zk-mic-rec" : "zk-mic")"
                       Variant="Variant.Text"
                       OnClick="ToggleVoiceAsync"
                       Disabled="@(State.IsBusy || _transcribing)" />

        <MudIconButton Icon="@Icons.Material.Filled.Send"
                       Variant="Variant.Filled"
                       Class="zk-send"
                       OnClick="SendAsync"
                       Disabled="@(State.IsBusy || _recording || string.IsNullOrWhiteSpace(_question))" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_voiceStatus))
    {
        <div class="zk-note">@_voiceStatus</div>
    }

    <div class="zk-note">لا تكتب بيانات عملاء حساسة في الأسئلة العامة.</div>
</div>

@code {
    /// <summary>بيسجل 👍 / 👎 على رد زكي</summary>
    private async Task GiveFeedbackAsync(ZakiChatItem item, bool useful)
    {
        if (item.MessageId is not { } messageId)
            return;

        // المستخدم يقدر يغيّر رأيه: الحفظ بيحدّث التقييم القديم
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var userName = auth.User.Identity?.Name ?? "";

        if (await LogService.SaveFeedbackAsync(messageId, userName, useful))
        {
            item.Useful = useful;
            Snackbar.Add(useful ? "شكراً، اتسجل إنه مفيد" : "شكراً، اتسجل إنه مش مفيد", Severity.Success);
        }
        else
        {
            Snackbar.Add("ماقدرتش أسجل التقييم دلوقتي", Severity.Warning);
        }
    }

    /// <summary>وضع النافذة الصغيرة (الزر العائم)</summary>
    [Parameter] public bool Compact { get; set; }

    private sealed record Suggestion(string Text, string Icon);

    private readonly Suggestion[] _suggestions =
    {
        new("عندي كام فرصة مفتوحة؟", Icons.Material.Filled.TrendingUp),
        new("المهام المتأخرة عندي", Icons.Material.Filled.AlarmOn),
        new("اعرض ملخص أرقامي", Icons.Material.Filled.Dashboard),
        new("ملخص العملاء المحتملين", Icons.Material.Filled.PersonSearch),
        new("مؤشرات التسويق للشهر ده", Icons.Material.Filled.Campaign),
        new("المؤشرات التنفيذية للشهر ده", Icons.Material.Filled.AccountBalance)
    };

    private string _question = "";

    // ═══ P5: تنسيق الإجابات ═══

    /// <summary>عرض النص مع **غامق** وأسطر — من غير HTML خام</summary>
    private RenderFragment RenderRich(string text) => builder =>
    {
        if (string.IsNullOrEmpty(text)) return;

        var lines = text.Replace("\r\n", "\n").Split('\n');
        var seq = 0;
        foreach (var line in lines)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "zk-line");

            var parts = line.Split("**");
            for (var i = 0; i < parts.Length; i++)
            {
                if (parts[i].Length == 0) continue;
                if (i % 2 == 1)
                {
                    builder.OpenElement(seq++, "b");
                    builder.AddContent(seq++, parts[i]);
                    builder.CloseElement();
                }
                else
                {
                    builder.AddContent(seq++, parts[i]);
                }
            }

            builder.CloseElement();
        }
    };

    /// <summary>أسئلة مقترحة حسب أدوات آخر رد</summary>
    private List<string> Suggestions
    {
        get
        {
            if (State.Items.Count == 0) return new List<string>();
            var last = State.Items[^1];
            if (last.IsUser) return new List<string>();
            return SuggestionsFor(last.Tools);
        }
    }

    private readonly Suggestion[] _starters =
    {
        new("ملخص المبيعات الشهر ده", Icons.Material.Rounded.TrendingUp),
        new("مديونيات العملاء كام؟", Icons.Material.Rounded.AccountBalanceWallet),
        new("قيمة المخزون كام؟", Icons.Material.Rounded.Inventory2),
        new("إيه الأصناف اللي خلصت؟", Icons.Material.Rounded.WarningAmber),
        new("رصيد الخزينة كام؟", Icons.Material.Rounded.Savings),
        new("كام فرصة مفتوحة دلوقتي؟", Icons.Material.Rounded.Handshake),
        new("إيه المهام المتأخرة؟", Icons.Material.Rounded.TaskAlt),
        new("الحضور النهاردة عامل إزاي؟", Icons.Material.Rounded.Badge)
    };

    private static readonly string[] GenericSuggestions =
    {
        "ملخص المبيعات الشهر ده", "قيمة المخزون كام؟", "مديونيات العملاء كام؟", "إيه المهام المتأخرة؟"
    };

    private static List<string> SuggestionsFor(List<string> tools)
    {
        (string tool, string[] next)[] map =
        {
            ("get_open_opportunities", new[] { "ملخص الـ CRM إيه؟", "إيه المهام المتأخرة؟" }),
            ("get_crm_summary", new[] { "كام فرصة مفتوحة دلوقتي؟", "آخر التواصلات إيه؟" }),
            ("get_sales_invoices_summary", new[] { "مين أكبر العملاء؟", "إيه الفواتير اللي عليها متبقي؟" }),
            ("get_top_customers", new[] { "ملخص فواتير البيع", "مديونيات العملاء كام؟" }),
            ("get_customer_balances", new[] { "رصيد الخزينة كام؟", "حركة الخزينة النهاردة إيه؟" }),
            ("get_cashbox_summary", new[] { "حركة الخزينة النهاردة إيه؟", "مديونيات العملاء كام؟" }),
            ("get_stock_value", new[] { "إيه الأصناف اللي خلصت؟", "المخزون موزع إزاي على المخازن؟" }),
            ("get_low_stock", new[] { "قيمة المخزون كام؟", "آخر حركات المخزون إيه؟" }),
            ("get_exemptions", new[] { "الحضور النهاردة عامل إزاي؟", "عندي إشعارات جديدة إيه؟" }),
            ("get_unread_notifications", new[] { "إيه المهام المتأخرة؟", "ملخص المبيعات الشهر ده" })
        };

        var picks = new List<string>();
        foreach (var tool in tools)
        {
            foreach (var m in map)
            {
                if (m.tool != tool) continue;
                foreach (var next in m.next)
                    if (!picks.Contains(next)) picks.Add(next);
            }
            if (picks.Count >= 3) break;
        }

        foreach (var g in GenericSuggestions)
        {
            if (picks.Count >= 4) break;
            if (!picks.Contains(g)) picks.Add(g);
        }

        return picks.Take(4).ToList();
    }

    private async Task AskSuggested(string question)
    {
        if (State.IsBusy) return;
        _question = question;
        await SendAsync();
    }
    private string? _userName;
    private bool _recording;
    private bool _transcribing;
    private string? _voiceStatus;
    private ClaimsPrincipal? _user;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;

        var auth = await AuthProvider.GetAuthenticationStateAsync();
        _userName = auth.User.Identity?.Name ?? "";
        _user = auth.User;

        // بيحمّل آخر محادثة من قاعدة البيانات (مرة واحدة بس)
        await State.EnsureLoadedAsync(LogService, _userName);
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnStateChanged;

    private Task AskSuggestion(string text)
    {
        _question = text;
        return SendAsync();
    }

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SendAsync();
    }

    private async Task SendAsync()
    {
        var question = _question.Trim();
        if (State.IsBusy || _recording || question.Length == 0)
            return;

        var history = BuildHistory();
        State.Items.Add(new ZakiChatItem { IsUser = true, Text = question });
        _question = "";
        State.SetBusy(true);

        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var result = await ZakiService.AskAsync(auth.User, question, State.ConversationId, history);
        State.ConversationId = result.ConversationId ?? State.ConversationId;

        State.Items.Add(new ZakiChatItem
        {
            IsUser = false,
            Text = result.Text,
            Ok = result.Success,
            Tokens = result.TotalTokens,
            Tools = result.ToolsUsed.ToList(),
            Tables = result.Tables.ToList(),
            MessageId = result.MessageId
        });

        State.SetBusy(false);
    }

    /// <summary>آخر رسائل المحادثة الناجحة (سؤال/رد بس، من غير الجداول)</summary>
    private List<AiMessage> BuildHistory() =>
        State.Items
            .Where(i => i.Ok && !string.IsNullOrWhiteSpace(i.Text))
            .TakeLast(6)
            .Select(i => new AiMessage(i.IsUser ? "user" : "assistant", i.Text))
            .ToList();

    // ════════════════════════════════════════════════════════════
    // الميكروفون
    // ════════════════════════════════════════════════════════════
    private async Task ToggleVoiceAsync()
    {
        if (_recording)
            await StopVoiceAsync();
        else
            await StartVoiceAsync();
    }

    private async Task StartVoiceAsync()
    {
        _voiceStatus = null;

        string reason;
        try
        {
            // بيرجّع "" لو نجح، أو كود بيوضح السبب
            reason = await JS.InvokeAsync<string>("zakiVoice.start");
        }
        catch (Exception)
        {
            reason = "other";
        }

        if (string.IsNullOrEmpty(reason))
        {
            _recording = true;
            _voiceStatus = "جاري التسجيل. اضغط الزر الأحمر للإيقاف.";
            return;
        }

        _recording = false;
        _voiceStatus = MicErrorText(reason);
    }

    private static string MicErrorText(string reason) => reason switch
    {
        "insecure" => "الميكروفون مابيشتغلش على الرابط ده. افتح زكي من http://localhost (نفس البورت) أو من رابط https.",
        "nosupport" => "المتصفح ده مابيدعمش تسجيل الصوت. جرّب Chrome أو Edge.",
        "denied" => "الميكروفون متقفل للموقع. اضغط على أيقونة القفل جنب العنوان، اسمح بالميكروفون، وحدّث الصفحة.",
        "notfound" => "مالقيتش ميكروفون متوصل بالجهاز.",
        "busy" => "الميكروفون شغال في برنامج تاني. قفله وجرّب تاني.",
        _ => "ماقدرتش أفتح الميكروفون. حاول تاني."
    };

    // ════════════════════════════════════════════════════════════
    // فتح إشعار من الجدول (بيعلّمه مقروء ويفتح الصفحة)
    // ════════════════════════════════════════════════════════════
    private async Task OpenLinkAsync(ZakiRowLink link)
    {
        if (_user is null) return;

        var ok = await Notifs.MarkAsReadAsync(link.NotificationId, _user);
        if (!ok)
        {
            _voiceStatus = "الإشعار ده مش متاح ليك دلوقتي.";
            return;
        }

        var targetPath = Nav.ToAbsoluteUri(link.Url).AbsolutePath;
        var currentPath = new Uri(Nav.Uri).AbsolutePath;
        var samePage = string.Equals(currentPath, targetPath, StringComparison.OrdinalIgnoreCase);

        State.SetMiniOpen(false);
        Nav.NavigateTo(link.Url, forceLoad: samePage);
    }

    // ════════════════════════════════════════════════════════════
    // السجل
    // ════════════════════════════════════════════════════════════
    private async Task ToggleHistoryAsync()
    {
        if (State.HistoryOpen)
        {
            State.SetHistoryOpen(false);
            return;
        }

        // بنحدّث القائمة الأول، وبعدين نفتحها (عشان ما يظهرش "فاضي" لحظة)
        await State.RefreshHistoryAsync(LogService, _userName ?? "");
        State.SetHistoryOpen(true);
    }

    private async Task OpenHistoryAsync(long conversationId)
    {
        if (State.IsBusy) return;
        _voiceStatus = null;
        await State.OpenConversationAsync(LogService, _userName ?? "", conversationId);
    }

    private async Task StopVoiceAsync()
    {
        _recording = false;
        _transcribing = true;
        _voiceStatus = "جاري تحويل الصوت لنص...";

        try
        {
            var clip = await JS.InvokeAsync<ZakiVoiceClip>("zakiVoice.stop");
            var bytes = Convert.FromBase64String(clip.Data ?? "");

            var mime = (clip.Mime ?? "audio/webm").Split(';')[0];
            var fileName = mime.Contains("mp4") ? "voice.mp4"
                         : mime.Contains("ogg") ? "voice.ogg"
                         : "voice.webm";

            var result = await VoiceService.TranscribeAsync(bytes, fileName, mime);

            if (result.Success)
            {
                _question = string.IsNullOrWhiteSpace(_question) ? result.Text : _question + " " + result.Text;
                _voiceStatus = null;
            }
            else
            {
                _voiceStatus = result.ErrorMessage;
            }
        }
        catch (Exception)
        {
            _voiceStatus = "حصل خطأ أثناء تسجيل الصوت. حاول تاني.";
        }
        finally
        {
            _transcribing = false;
        }
    }

    /// <summary>تنزيل الجدول كملف Excel</summary>
    private async Task ExportExcelAsync(ZakiTable table)
    {
        var base64 = ZakiExcelExporter.ToBase64(table);
        var fileName = ZakiExcelExporter.SafeFileName(table.Title) + ".xlsx";
        await JS.InvokeVoidAsync("downloadFileFromBase64", base64, fileName);
    }

    /// <summary>تنزيل الجدول كـ PDF رسمي (قالب ثابت — هيدر الشركة + الجدول + الفوتر)</summary>
    private async Task ExportPdfAsync(ZakiTable table)
    {
        try
        {
            var auth = await AuthProvider.GetAuthenticationStateAsync();
            var userName = auth.User.Identity?.Name ?? "";
            var bytes = PdfReports.GenerateTablePdf(table, userName);
            var base64 = Convert.ToBase64String(bytes);
            var fileName = ZakiExcelExporter.SafeFileName(table.Title) + ".pdf";
            await JS.InvokeVoidAsync("downloadFile", fileName, "application/pdf", base64);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Zaki PDF export failed: {ex.Message}");
        }
    }

    private static string ToolLabel(string name) => ZakiLabels.Tool(name);

    private static string ToolIcon(string name) => name switch
    {
        "get_open_opportunities" => Icons.Material.Filled.TrendingUp,
        "get_open_tasks" => Icons.Material.Filled.Checklist,
        "get_overdue_tasks" => Icons.Material.Filled.AlarmOn,
        "get_crm_summary" => Icons.Material.Filled.Dashboard,
