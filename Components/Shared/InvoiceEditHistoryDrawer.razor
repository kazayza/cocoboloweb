    private void OpenRestoreConfirm(InvoiceAuditEntryDto e)
    {
        _restoreEntry = e;
        _restoreReason = null;
        _restoreConfirmOpen = true;
    }

    private async Task ConfirmRestore()
    {
        if (_isRestoring || _restoreEntry == null) return;
        if (string.IsNullOrWhiteSpace(_restoreReason))
        {
            Snackbar.Add("سبب الاسترجاع إلزامي", Severity.Warning);
            return;
        }

        _isRestoring = true;
        try
        {
            var (ok, msg) = await InvoiceService.RestoreInvoiceSnapshotAsync(
                TransactionId, _restoreEntry.AuditId, _currentUserName ?? "System", _restoreReason!.Trim());
            if (ok)
            {
                Snackbar.Add(msg, Severity.Success);
                _restoreConfirmOpen = false;
                await OpenAsync(TransactionId);
            }
            else
            {
                Snackbar.Add(msg, Severity.Error);
            }
        }
        finally
        {
            _isRestoring = false;
        }
    }
}
