@using System.Text.Json
@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services

@inject IInvoiceService InvoiceService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthProvider

@* ═══════════ ⭐ لوحة جانبية: سجل تعديلات الفاتورة (نفس نمط لوحة استرداد الخاسر) ═══════════ *@
@if (_open)
{
    <div class="ieh-overlay" @onclick="Close">
        <div class="ieh-drawer" @onclick="() => { }" @onclick:stopPropagation="true">
            <div class="ieh-drawer-head">
                <div>
                    <h3>🕘 سجل تعديلات الفاتورة</h3>
                    <p class="ieh-sub">@(_history?.ReferenceNumber ?? $"#{TransactionId}")</p>
                </div>
                <button type="button" class="ieh-x" @onclick="Close">✕</button>
            </div>
            <div class="ieh-drawer-body">
                @if (_loading)
                {
                    <div class="ieh-loading"><span class="ieh-spin"></span><span>جارٍ تحميل السجل…</span></div>
                }
                else if (_history == null)
                {
                    <div class="ieh-empty"><h3>الفاتورة غير موجودة</h3></div>
                }
                else if (_history.Entries.Count == 0)
                {
                    <div class="ieh-empty">
                        <h3>لا توجد حركات مسجلة</h3>
                        <p>سجل التعديلات يتكوّن تلقائياً مع الاستخدام (إنشاء / تعديل كامل / طلبات التعديل / إلغاء).</p>
                    </div>
                }
                else
                {
                    <div class="ieh-hint">📜 التسلسل الزمني — من الأحدث للأقدم</div>
                    <div class="ieh-list">
                        @foreach (var e in _history.Entries)
                        {
                            var changes = ComputeChanges(e);
                            <div class="ieh-item">
                                <div class="ieh-ico @GetChipClass(e.ActionType)"><MudIcon Icon="@GetEntryIcon(e.ActionType)" /></div>
                                <div class="ieh-item-top">
                                    <span class="ieh-act @GetChipClass(e.ActionType)">@GetActionLabel(e.ActionType)</span>
                                    <span class="ieh-date">@(e.ActionDate?.ToString("yyyy/MM/dd HH:mm"))</span>
                                </div>
                                <div class="ieh-by">بواسطة: @(string.IsNullOrWhiteSpace(e.LoginName) ? "النظام" : e.LoginName)</div>

                                @if (changes.Any())
                                {
                                    <div class="ieh-changes">
                                        @foreach (var c in changes)
                                        {
                                            <div class="ieh-change">
                                                <span class="ieh-clbl">@c.Label:</span>
                                                @if (!string.IsNullOrEmpty(c.Old))
                                                {
                                                    <span class="ieh-old">@c.Old</span>
                                                    <span class="ieh-arrow">←</span>
                                                }
                                                <span class="ieh-new">@(string.IsNullOrEmpty(c.New) ? "—" : c.New)</span>
                                            </div>
                                        }
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(e.Reason))
                                {
                                    <div class="ieh-reason">السبب: @e.Reason</div>
                                }

                                @if (e.ActionType == "FullEdit" && _canRestore && e.CanRestore)
                                {
                                    <button type="button" class="ieh-restore-btn" @onclick="() => OpenRestoreConfirm(e)">↺ استرجاع هذه النسخة</button>
                                }
                            </div>
                        }
                    </div>

                    <div class="ieh-footer-note">
                        إنشاء الفاتورة: @(_history.CreatedBy) — @_history.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ═══ دايلوج تأكيد الاسترجاع ═══ *@
<MudDialog @bind-Visible="_restoreConfirmOpen">
    <TitleContent>
        <div style="display:flex; align-items:center; gap:0.5rem;">
            <MudIcon Icon="@Icons.Material.Filled.SettingsBackupRestore" Color="Color.Warning" />
            <MudText Typo="Typo.h6">استرجاع نسخة من السجل</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined" Class="mb-3">
            سيتم إرجاع الفاتورة <strong>@(_history?.ReferenceNumber)</strong> إلى حالتها كما كانت في
            <strong>@(_restoreEntry?.ActionDate?.ToString("yyyy/MM/dd HH:mm"))</strong>
            — سيتم تصحيح المخزون تلقائياً ويسجَّل الاسترجاع في السجل باسمك.
        </MudAlert>
        <MudTextField @bind-Value="_restoreReason"
                      Label="سبب الاسترجاع (إلزامي)"
                      Lines="2" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="@(() => _restoreConfirmOpen = false)">إلغاء</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning"
                   Disabled="@(_isRestoring || string.IsNullOrWhiteSpace(_restoreReason))"
                   OnClick="ConfirmRestore">
            @if (_isRestoring)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            تأكيد الاسترجاع
        </MudButton>
    </DialogActions>
</MudDialog>

