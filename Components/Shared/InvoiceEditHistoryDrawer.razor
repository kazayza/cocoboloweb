@code {
    private int TransactionId { get; set; }
    private bool _open;
    private bool _loading;
    private bool _canRestore;
    private string? _currentUserName;
    private InvoiceEditHistoryDto? _history;

    private bool _restoreConfirmOpen;
    private InvoiceAuditEntryDto? _restoreEntry;
    private string? _restoreReason;
    private bool _isRestoring;

    // ⭐ الفتح المباشر من الصفحة
    public async Task OpenAsync(int transactionId)
    {
        TransactionId = transactionId;
        _open = true;
        _loading = true;

        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var u = auth.User;
        _canRestore = u.IsInRole("Admin") || u.IsInRole(SystemRoles.Admin)
            || u.IsInRole("AccountManager") || u.IsInRole(SystemRoles.AccountManager);
        _currentUserName = u.Identity?.Name ?? "System";

        // ⭐ حماية: سجل التعديلات للـ Admin ومدير الحسابات فقط — أي حد غير مصرح له تُقفل اللوحة فوراً
        if (!_canRestore)
        {
            _open = false;
            _loading = false;
            return;
        }

        try
        {
            _history = await InvoiceService.GetInvoiceEditHistoryAsync(transactionId);
        }
        finally
        {
            _loading = false;
        }
        StateHasChanged();
    }

    private void Close()
    {
        _open = false;
        StateHasChanged();
    }

    // ═══════════ استخراج تفاصيل كل حركة (ماذا تغيّر بالظبط) ═══════════
    private sealed record Chg(string Label, string? Old, string? New);

    private List<Chg> ComputeChanges(InvoiceAuditEntryDto e)
    {
        var res = new List<Chg>();
        JsonDocument? oldDoc = null, newDoc = null;
        try
        {
            if (!string.IsNullOrWhiteSpace(e.OldData)) oldDoc = JsonDocument.Parse(e.OldData);
            if (!string.IsNullOrWhiteSpace(e.NewData)) newDoc = JsonDocument.Parse(e.NewData);
            var o = oldDoc?.RootElement ?? default;
            var n = newDoc?.RootElement ?? default;

            switch (e.ActionType)
            {
                case "FullEdit":
                {
                    AddIfMoney(res, "إجمالي الأصناف", o, n);
                    AddIfMoney(res, "الخصم", o, n, "DiscountAmount");
                    AddIfMoney(res, "الصافي", o, n);
                    AddIfMoney(res, "رسوم إضافية", o, n, "TotalChargesAmount");
                    AddIfMoney(res, "الإجمالي", o, n);
                    AddStr(res, "المخزن", o, n, "WarehouseId", "مخزن #");
                    AddStr(res, "طريقة الدفع", o, n, "PaymentMethod");
                    AddDate(res, "تاريخ الفاتورة", o, n, "TransactionDate");
                    AddDate(res, "تاريخ الاستحقاق", o, n, "DueDate");
                    AddBool(res, "التسليم", o, n, "IsDelivered");

                    // الأصناف
                    var oldItems = GetItems(o);
                    var newItems = GetItems(n);
                    var oldById = oldItems.ToDictionary(i => GetInt(i, "DetailId"));
                    foreach (var ni in newItems)
                    {
                        var nid = GetInt(ni, "DetailId");
                        var nName = GetName(ni);
                        if (!oldById.TryGetValue(nid, out var oi))
                        {
                            res.Add(new Chg("صنف مضاف", null, nName));
                            continue;
                        }
                        var oName = GetName(oi);
                        if (GetInt(oi, "ProductId") != GetInt(ni, "ProductId"))
                        {
                            res.Add(new Chg("استبدال صنف", oName, nName));
                        }
                        else
                        {
                            var oq = GetDec(oi, "Quantity"); var nq = GetDec(ni, "Quantity");
                            if (oq != nq) res.Add(new Chg($"{nName} — الكمية", fmt(oq), fmt(nq)));
                            var op = GetDec(oi, "UnitPrice"); var np = GetDec(ni, "UnitPrice");
                            if (op != np) res.Add(new Chg($"{nName} — السعر", Money(op), Money(np)));
                        }
                    }
                    var newIds = newItems.Select(i => GetInt(i, "DetailId")).ToHashSet();
                    foreach (var oi in oldItems)
                        if (!newIds.Contains(GetInt(oi, "DetailId")))
                            res.Add(new Chg("صنف محذوف", GetName(oi), null));
                    break;
                }
                case "Update":
                {
                    AddStr(res, "الملاحظات", o, n, "Notes");
                    AddDate(res, "تاريخ الاستحقاق", o, n, "DueDate");
                    AddBool(res, "التسليم", o, n, "IsDelivered");
                    AddStr(res, "طريقة الدفع", o, n, "PaymentMethod");
                    break;
                }
                case "DeliveryPermissionRequest":
                {
                    var note = JStr(n, "Note");
                    if (!string.IsNullOrWhiteSpace(note)) res.Add(new Chg("تفاصيل الطلب", null, note));
                    break;
                }
                case "DeliveryPermissionGranted":
                {
                    res.Add(new Chg("الحالة", null, "تم منح الإذن — يجوز التسليم رغم وجود مبالغ متبقية"));
                    break;
                }
                case "ReceivePurchaseInvoice":
                {
                    AddStr(res, "المخزن المستلَم إليه", o, n, "WarehouseId", "مخزن #");
                    AddDate(res, "تاريخ الاستلام", o, n, "DeliveredAt");
                    AddStr(res, "ملاحظات الاستلام", o, n, "DeliveredNotes");
                    break;
                }
                case "UpdateDeliveryStatus":
                {
                    var st = JStr(n, "RequestedStatus");
                    if (!string.IsNullOrWhiteSpace(st)) res.Add(new Chg("الحالة المطلوبة", null, st));
                    AddStr(res, "موظف التوصيل", o, n, "DeliveryEmployeeName");
                    AddBool(res, "حالة التسليم", o, n, "IsDelivered");
                    AddDate(res, "تاريخ التسليم", o, n, "DeliveredAt");
                    AddStr(res, "ملاحظات التسليم", o, n, "DeliveredNotes");
                    break;
                }
                case "Insert":
                {
                    var gt = GetDec(n, "GrandTotal");
                    if (gt.HasValue) res.Add(new Chg("قيمة الفاتورة عند الإنشاء", null, Money(gt)));
                    var cnt = GetItems(n).Count;
                    if (cnt > 0) res.Add(new Chg("عدد الأصناف", null, cnt.ToString()));
                    break;
                }
                case "Cancel":
                {
                    var r = JStr(n, "EditReason") ?? JStr(o, "EditReason") ?? JStr(n, "Reason");
                    if (!string.IsNullOrWhiteSpace(r)) res.Add(new Chg("سبب الإلغاء", null, r));
                    break;
                }
                case "EditRequest":
                {
                    var r = JStr(n, "Reason");
                    if (!string.IsNullOrWhiteSpace(r)) res.Add(new Chg("سبب الطلب", null, r));
                    break;
                }
                case "EditApprove":
                case "EditReject":
                {
                    var nt = JStr(n, "Notes");
                    if (!string.IsNullOrWhiteSpace(nt))
                        res.Add(new Chg(e.ActionType == "EditReject" ? "سبب الرفض" : "ملاحظات الاعتماد", null, nt));
                    break;
                }
            }
        }
        catch { /* لو JSON غير متوقع — نعرض الحركة بدون تفاصيل */ }
        finally
        {
            oldDoc?.Dispose();
            newDoc?.Dispose();
        }
        return res;
    }

    // ── أدوات قراءة JSON بشكل متسامح ──
    private static string? JStr(JsonElement el, string name)
    {
        if (el.ValueKind != JsonValueKind.Object || !el.TryGetProperty(name, out var v)) return null;
        return v.ValueKind switch
        {
            JsonValueKind.String => v.GetString(),
            JsonValueKind.Number => v.GetRawText(),
            JsonValueKind.True => "نعم",
            JsonValueKind.False => "لا",
            _ => null
        };
    }

    private static decimal? GetDec(JsonElement el, string name)
    {
        if (el.ValueKind != JsonValueKind.Object || !el.TryGetProperty(name, out var v)) return null;
        if (v.ValueKind == JsonValueKind.Number) return v.GetDecimal();
        if (v.ValueKind == JsonValueKind.String && decimal.TryParse(v.GetString(), out var d)) return d;
        return null;
    }

    private static DateTime? GetDate(JsonElement el, string name)
    {
        if (el.ValueKind != JsonValueKind.Object || !el.TryGetProperty(name, out var v)) return null;
        if (v.ValueKind == JsonValueKind.String && DateTime.TryParse(v.GetString(), out var d)) return d;
        return null;
    }

    private static int GetInt(JsonElement el, string name)
    {
        if (el.ValueKind == JsonValueKind.Object && el.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.Number)
            return v.GetInt32();
        return 0;
    }

    private static bool? GetBool(JsonElement el, string name)
    {
        if (el.ValueKind != JsonValueKind.Object || !el.TryGetProperty(name, out var v)) return null;
        return v.ValueKind switch { JsonValueKind.True => true, JsonValueKind.False => false, _ => null };
    }

    private static List<JsonElement> GetItems(JsonElement el)
    {
        var list = new List<JsonElement>();
        if (el.ValueKind == JsonValueKind.Object && el.TryGetProperty("Items", out var arr) && arr.ValueKind == JsonValueKind.Array)
            foreach (var i in arr.EnumerateArray()) list.Add(i);
        return list;
    }

    private static string GetName(JsonElement item)
    {
        var n = JStr(item, "ProductName");
        if (string.IsNullOrWhiteSpace(n)) n = "#" + GetInt(item, "ProductId");
        return n;
    }

    private static string Money(decimal? v) => (v ?? 0).ToString("N2") + " ج";
    private static string? fmt(decimal? v) => v?.ToString("0.##");

    private void AddIfMoney(List<Chg> res, string label, JsonElement o, JsonElement n, string? prop = null)
    {
        var name = prop ?? label switch
        {
            "إجمالي الأصناف" => "TotalAmount",
            "الصافي" => "NetTotalAmount",
            "الإجمالي" => "GrandTotal",
            _ => prop!
        };
        var ov = GetDec(o, name); var nv = GetDec(n, name);
        if (ov != nv && (ov.HasValue || nv.HasValue))
            res.Add(new Chg(label, Money(ov), Money(nv)));
    }

    private static void AddStr(List<Chg> res, string label, JsonElement o, JsonElement n, string prop, string? prefix = null)
    {
        string? Map(string? v) => v == null ? null : (prefix ?? "") + v;
        var ov = Map(JStr(o, prop)); var nv = Map(JStr(n, prop));
        if (ov != nv && (ov != null || nv != null)) res.Add(new Chg(label, ov, nv));
    }

    private static void AddDate(List<Chg> res, string label, JsonElement o, JsonElement n, string prop)
    {
        var ov = GetDate(o, prop); var nv = GetDate(n, prop);
        if (ov != nv && (ov.HasValue || nv.HasValue))
            res.Add(new Chg(label, ov?.ToString("yyyy/MM/dd"), nv?.ToString("yyyy/MM/dd")));
    }

    private static void AddBool(List<Chg> res, string label, JsonElement o, JsonElement n, string prop)
    {
        var ov = GetBool(o, prop); var nv = GetBool(n, prop);
        if (ov != nv && (ov.HasValue || nv.HasValue))
            res.Add(new Chg(label, ov == true ? "تم التسليم" : ov == false ? "لم يتم" : null,
                                          nv == true ? "تم التسليم" : nv == false ? "لم يتم" : null));
    }

    private string GetChipClass(string action) => action switch
    {
        "Insert" => "a-ins",
        "Update" => "a-upd",
        "FullEdit" => "a-edit",
        "EditRequest" => "a-req",
        "EditApprove" => "a-appr",
