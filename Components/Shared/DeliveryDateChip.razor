@using MudBlazor

@* ⭐ شيب موعد تسليم بارز (يوم الأسبوع + التاريخ) ملوّن بحالة الموعد.
   Date هنا هو الموعد «المعروض» لهذا المستخدم بعد قاعدة الإخفاء — المكوّن يعرض فقط. *@
@if (Date.HasValue)
{
    var style = DeliveryDisplay.LineChipStyle(Date, IsOverdue, IsDelivered);
    <MudTooltip Text="@Date.Value.ToString("yyyy/MM/dd")">
        <MudChip T="string"
                 Size="@Size"
                 Variant="Variant.Filled"
                 Color="@style.Color"
                 Icon="@style.Icon">
            @DeliveryDisplay.FormatWeekdayDate(Date.Value)
        </MudChip>
    </MudTooltip>
}
else
{
    <MudChip T="string"
             Size="@Size"
             Variant="Variant.Outlined"
             Color="Color.Default"
             Icon="@Icons.Material.Filled.EventBusy">
        بلا موعد
    </MudChip>
}

@code {
    /// <summary>الموعد بصيغة العرض للمستخدم الحالي (بعد الإخفاء إن انطبق)</summary>
    [Parameter] public DateTime? Date { get; set; }

    /// <summary>الموعد فات وما زال البند/الموعد غير مكتمل — يُلوَّن بالأحمر</summary>
    [Parameter] public bool IsOverdue { get; set; }

    /// <summary>اكتمل التسليم — يُلوَّن بالأخضر ويتقدّم على أي حالة أخرى</summary>
    [Parameter] public bool IsDelivered { get; set; }

    [Parameter] public Size Size { get; set; } = Size.Medium;
}
