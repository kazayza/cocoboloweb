@implements IDisposable

@using COCOBOLOERPNEW.Services.Assistant
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

@inject ZakiAssistantService ZakiService
@inject ZakiChatState State
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

@if (_canUse)
{
    @if (State.MiniOpen)
    {
        <div class="zk-float-panel">
            <div class="zk-float-head">
                <span class="zk-float-title">
                    <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Small" />
                    زكي
                </span>
                <span class="zk-float-actions">
                    @if (!_onZakiPage)
                    {
                        <button class="zk-float-close" @onclick="OpenFullPage" title="فتح في صفحة كاملة">
                            <MudIcon Icon="@Icons.Material.Filled.OpenInFull" Size="Size.Small" />
                        </button>
                    }
                    <button class="zk-float-close" @onclick="CloseMini" title="إغلاق">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                    </button>
                </span>
            </div>
            <ZakiChatPanel Compact="true" />
        </div>
    }

    @if (!_onZakiPage)
    {
        <button class="zk-float-btn" @onclick="ToggleMini" title="زكي">
            <MudIcon Icon="@(State.MiniOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.SmartToy)" Size="Size.Large" />
        </button>
    }
}

@code {
    private bool _canUse;
    private bool _onZakiPage;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        _canUse = ZakiService.CanUse(auth.User);
        UpdateRoute();

        Nav.LocationChanged += OnLocationChanged;
        State.Changed += OnStateChanged;
    }

    private void UpdateRoute()
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri).ToLowerInvariant();
        _onZakiPage = rel.StartsWith("zaki");
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateRoute();
        InvokeAsync(StateHasChanged);
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void ToggleMini() => State.SetMiniOpen(!State.MiniOpen);

    private void CloseMini() => State.SetMiniOpen(false);

    /// <summary>يفتح صفحة زكي الكاملة بنفس المحادثة (الحالة مشتركة)</summary>
    private void OpenFullPage()
    {
        State.SetMiniOpen(false);
        Nav.NavigateTo("/zaki");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        State.Changed -= OnStateChanged;
    }
}
