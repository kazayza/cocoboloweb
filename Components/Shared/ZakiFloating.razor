@implements IDisposable

@using COCOBOLOERPNEW.Services
@using COCOBOLOERPNEW.Services.Assistant
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.Extensions.DependencyInjection
@using System.Security.Claims

@inject ZakiAssistantService ZakiService
@inject ZakiChatState State
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IServiceScopeFactory ScopeFactory

@if (_canUse)
{
    @if (State.MiniOpen)
    {
        <div class="zk-float-panel" id="zakiMiniPanel">
            <div class="zk-float-head">
                <span class="zk-float-title">
                    <img src="img/zaki-icon.png" class="zk-head-img" alt="زكي" draggable="false" />
                    زكي
                </span>
                <span class="zk-float-actions">
                    @if (!_onZakiPage)
                    {
                        <button class="zk-float-close" @onclick="OpenFullPage" title="فتح في صفحة كاملة">
                            <MudIcon Icon="@Icons.Material.Filled.OpenInFull" Size="Size.Small" />
                        </button>
                    }
                    <button class="zk-float-close" @onclick="CloseMini" title="إغلاق">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                    </button>
                </span>
            </div>
            <ZakiChatPanel Compact="true" />
        </div>
    }

    @if (!_onZakiPage)
    {
        <button id="zakiFab" class="zk-float-btn zk-fab @(State.MiniOpen ? "" : "zk-fab-orb")" @onclick="OnFabClick" title="زكي — المساعد الذكي">
            @if (State.MiniOpen)
            {
                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Large" />
            }
            else
            {
                <span class="zk-fab-ring" aria-hidden="true"></span>
                <img src="img/zaki-icon.png" class="zk-fab-img" alt="زكي" draggable="false" />
                @if (_unreadCount > 0)
                {
                    <span class="zk-fab-badge">@(_unreadCount > 99 ? "99+" : _unreadCount.ToString())</span>
                }
            }
        </button>
    }
}

@code {
    private bool _canUse;
    private bool _onZakiPage;

    // عدّاد الإشعارات غير المقروءة على الزر العائم
    private int _unreadCount;
    private string _userName = "";
    private List<string> _userRoles = new();
    private bool _lastMiniOpen;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        _canUse = ZakiService.CanUse(auth.User);
        UpdateRoute();

        Nav.LocationChanged += OnLocationChanged;
        State.Changed += OnStateChanged;

        if (_canUse)
        {
            _userName = auth.User.Identity?.Name ?? "";
            _userRoles = auth.User.Claims
                .Where(c => c.Type == ClaimTypes.Role || c.Type == "role" || c.Type.EndsWith("/role"))
                .Select(c => c.Value)
                .Distinct()
                .ToList();
            _lastMiniOpen = State.MiniOpen;
            await RefreshUnreadAsync();
        }
    }

    /// <summary>بيحدّث عدّاد غير المقروء من نفس مصدر جرس الإشعارات في التخطيط (NotificationService)
    /// وبنطاق DI جديد كل مرة — زي الجرس بالظبط — عشان مايخبطش في DbContext المشترك بتاع الجلسة</summary>
    private async Task RefreshUnreadAsync()
    {
        if (string.IsNullOrEmpty(_userName)) return;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var svc = scope.ServiceProvider.GetRequiredService<NotificationService>();
            _unreadCount = await svc.GetUnreadCountAsync(_userName, _userRoles);
        }
        catch
        {
            // العدّاد تجميلي: أي فشل بيخليه زي ما هو ومابيأثرش على الزر
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_canUse || _onZakiPage) return;

        try
        {
            // بننادي zakiInitFab في كل رسم (آمنة — بتعمل init مرة واحدة بس عبر data flag)
            // عشان لو الزرار ما كانش موجود وقت أول رسم يتفعّل أول ما يظهر
            await JS.InvokeVoidAsync("zakiInitFab");

            // بعد أي إعادة رسم (فتح/قفل) بنثبت النافذة الصغيرة جنب الزرار
            await JS.InvokeVoidAsync("zakiAnchorPanel");
        }
        catch
        {
            // JS مش متاح — الزرار شغال من غيره (المكان الافتراضي)
        }
    }

    private async Task OnFabClick()
    {
        // لو المستخدم كان بيسحب الزرار — متعاملهاش كضغطة
        try
        {
            var dragged = await JS.InvokeAsync<bool>("zakiFabWasDragged");
            if (dragged) return;
        }
        catch { }

        State.SetMiniOpen(!State.MiniOpen);
    }

    private void UpdateRoute()
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri).ToLowerInvariant();
        _onZakiPage = rel.StartsWith("zaki");
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateRoute();
        InvokeAsync(StateHasChanged);
    }

    private void OnStateChanged()
    {
        // فتح/قفل النافذة الصغيرة لحظة طبيعية لتحديث العدّاد — من غير أي بولينج
        if (State.MiniOpen != _lastMiniOpen)
        {
            _lastMiniOpen = State.MiniOpen;
            _ = InvokeAsync(async () =>
            {
                await RefreshUnreadAsync();
                StateHasChanged();
            });
            return;
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private void CloseMini() => State.SetMiniOpen(false);

    /// <summary>يفتح صفحة زكي الكاملة بنفس المحادثة (الحالة مشتركة)</summary>
    private void OpenFullPage()
    {
        State.SetMiniOpen(false);
        Nav.NavigateTo("/zaki");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        State.Changed -= OnStateChanged;
    }
}
