    <script>
    window.setupKanbanDnD = function() {
        document.addEventListener('dragover', function(e) {
            if (e.target.closest && e.target.closest('.kanban-col')) {
                e.preventDefault();
            }
        });
        document.addEventListener('drop', function(e) {
            if (e.target.closest && e.target.closest('.kanban-col')) {
                e.preventDefault();
            }
        });
    };
    </script>
