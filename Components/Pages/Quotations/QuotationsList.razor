    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        _currentUserName = user.Identity?.Name ?? "System";

        // ⭐ مشاهدو التكلفة المقيّدون (مدير الإنتاج / المصنع): دخول بالتكلفة فقط بدون كتابة
        _isCostOnlyViewer = user.IsInRole(SystemRoles.ProductionManager) || user.IsInRole("factory");

        _canView = user.HasClaim("Permission", "frmQuotationsList:View") || user.IsInRole("Admin") || _isCostOnlyViewer;
        _canAdd = user.HasClaim("Permission", "frmQuotationsList:Add") || user.IsInRole("Admin");
        _canDelete = user.HasClaim("Permission", "frmQuotationsList:Delete") || user.IsInRole("Admin");
        _canViewCost = user.IsInRole("Admin")
            || user.IsInRole("AccountManager")
            || _isCostOnlyViewer;

        // ⭐ صلاحية فتح الفواتير المرتبطة (نفس مفتاح صلاحية شاشة الفواتير)
        _canViewInvoices = user.HasClaim("Permission", "frm_PartiesInvoices:View")
                        || user.IsInRole(SystemRoles.Admin)
                        || user.IsInRole("Admin");

        if (!_canView) { Navigation.NavigateTo("/"); return; }

        try
        {
            _cashBoxes = await InvoiceService.GetCashBoxesAsync() ?? new();
            _employees = await EmployeeService.SearchEmployeesAsync("", 200);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"تعذّر تحميل البيانات الأساسية: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>⭐ طلب تسعير: إشعار لأعضاء دور المصنع بتحديث تكاليف هذا العرض</summary>
    private async Task RequestPricingAsync(QuotationListDto row)
    {
        try
        {
            _sendingPricingRequest = true;

            var (ok, msg) = await QuotationService.SendPricingRequestAsync(
                row.QuotationId, null, _currentUserName!);

            Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"تعذر إرسال طلب التسعير: {ex.Message}", Severity.Error);
        }
        finally
        {
            _sendingPricingRequest = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _didInitialLoad || !_canView)
            return;

        _didInitialLoad = true;

        try
        {
            await RestoreFilterStateAsync();
            ApplyQueryFilters();
            _dateFrom = _filter.DateFrom;
            _dateTo = _filter.DateTo;
            SyncActiveQuickFilter();
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"تعذّر تحميل شاشة عروض الأسعار: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyQueryFilters()
    {
        if (string.IsNullOrWhiteSpace(StatusQuery))
            return;

        var requestedStatus = StatusQuery.Trim();
        var matchedStatus = QuotationStatuses.All.Keys
            .FirstOrDefault(s => string.Equals(s, requestedStatus, StringComparison.OrdinalIgnoreCase));

        if (string.IsNullOrWhiteSpace(matchedStatus))
            return;

        _filter.PageNumber = 1;
        _filter.IsConverted = null;
        _filter.PendingOnly = null;

        if (matchedStatus == QuotationStatuses.Expired)
        {
            _filter.Status = null;
            _filter.IsExpired = true;
        }
        else
        {
            _filter.Status = matchedStatus;
            _filter.IsExpired = null;
        }

        SyncActiveQuickFilter();
    }

    private string GetStatCardClass(string quickFilter)
    {
        return _activeQuickFilter == quickFilter
            ? "stat-card active"
            : "stat-card";
    }

private async Task ApplyStatsQuickFilter(string quickFilter)
{
    _activeQuickFilter = quickFilter;

    // نحافظ على البحث والتاريخ والموظف
    // ونلغي فقط فلاتر الحالة السريعة
    _filter.PageNumber = 1;
    _filter.Status = null;
    _filter.IsConverted = null;
    _filter.IsExpired = null;
    _filter.PendingOnly = null;

    switch (quickFilter)
    {
        case QuickFilterConverted:
            _filter.IsConverted = true;
            break;

        case QuickFilterPending:
            _filter.PendingOnly = true;
            break;

        case QuickFilterAccepted:
            _filter.Status = QuotationStatuses.Accepted;
            break;

        case QuickFilterRejected:
            _filter.Status = QuotationStatuses.Rejected;
            break;

        case QuickFilterExpired:
            _filter.IsExpired = true;
            break;

        case QuickFilterAll:
        default:
            break;
    }

    await LoadData();
}

    private async Task LoadData()
    {
        try
        {
            _pagedResult = await QuotationService.GetQuotationsAsync(_filter);

            if (_pagedResult.TotalPages > 0 && _filter.PageNumber > _pagedResult.TotalPages)
            {
                _filter.PageNumber = _pagedResult.TotalPages;
                _pagedResult = await QuotationService.GetQuotationsAsync(_filter);
            }
            else if (_pagedResult.TotalPages == 0)
            {
                _filter.PageNumber = 1;
            }

            await RefreshStats();
            await SaveFilterStateAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"تعذّر تحميل القائمة: {ex.Message}", Severity.Error);
            _pagedResult = new PagedResult<QuotationListDto>();
        }
    }

    private async Task RefreshStats()
    {
        try
        {
            _stats = await QuotationService.GetStatsAsync(CloneFilter(_filter));
        }
        catch
        {
            _stats = new QuotationStatsDto();
        }
    }

    private async Task RestoreFilterStateAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", FilterStorageKey);
            if (string.IsNullOrWhiteSpace(json))
                return;

            var saved = JsonSerializer.Deserialize<QuotationFilterState>(json);
            if (saved is null)
                return;

            _filter = new QuotationFilterDto
            {
                SearchText = saved.SearchText,
                PartyId = saved.PartyId,
                EmpId = saved.EmpId,
                DateFrom = saved.DateFrom,
                DateTo = saved.DateTo,
                Status = saved.Status,
                IsConverted = saved.IsConverted,
                IsExpired = saved.IsExpired,
                PendingOnly = saved.PendingOnly,
                PageNumber = saved.PageNumber > 0 ? saved.PageNumber : 1,
                PageSize = saved.PageSize > 0 ? saved.PageSize : 25,
                SortBy = string.IsNullOrWhiteSpace(saved.SortBy) ? "QuotationDate" : saved.SortBy,
                SortDescending = saved.SortDescending
            };
        }
        catch
        {
            _filter = new QuotationFilterDto();
        }
    }

    private async Task SaveFilterStateAsync()
    {
        try
        {
            var state = new QuotationFilterState
            {
                SearchText = _filter.SearchText,
                PartyId = _filter.PartyId,
                EmpId = _filter.EmpId,
                DateFrom = _filter.DateFrom,
                DateTo = _filter.DateTo,
                Status = _filter.Status,
                IsConverted = _filter.IsConverted,
                IsExpired = _filter.IsExpired,
                PendingOnly = _filter.PendingOnly,
                PageNumber = _filter.PageNumber,
                PageSize = _filter.PageSize,
                SortBy = _filter.SortBy,
                SortDescending = _filter.SortDescending
            };

            var json = JsonSerializer.Serialize(state);
            await JS.InvokeVoidAsync("localStorage.setItem", FilterStorageKey, json);
        }
        catch
        {
        }
    }

    private QuotationFilterDto CloneFilter(QuotationFilterDto source)
    {
        return new QuotationFilterDto
        {
            SearchText = source.SearchText,
            PartyId = source.PartyId,
            EmpId = source.EmpId,
            DateFrom = source.DateFrom,
            DateTo = source.DateTo,
            Status = source.Status,
            IsConverted = source.IsConverted,
            IsExpired = source.IsExpired,
            PendingOnly = source.PendingOnly,
            PageNumber = source.PageNumber,
            PageSize = source.PageSize,
            SortBy = source.SortBy,
            SortDescending = source.SortDescending
        };
    }

    private async Task OnSearchChanged()
    {
        _filter.PageNumber = 1;
        SyncActiveQuickFilter();
        await LoadData();
    }

    private async Task OnFilterChanged()
{
    _filter.PageNumber = 1;
    SyncActiveQuickFilter();
    await LoadData();
}
private void SyncActiveQuickFilter()
{
    if (_filter.PendingOnly == true)
    {
        _activeQuickFilter = QuickFilterPending;
    }
    else if (_filter.IsConverted == true || _filter.Status == QuotationStatuses.Converted)
    {
        _activeQuickFilter = QuickFilterConverted;
    }
    else if (_filter.IsExpired == true || _filter.Status == QuotationStatuses.Expired)
    {
        _activeQuickFilter = QuickFilterExpired;
    }
    else if (_filter.Status == QuotationStatuses.Accepted)
    {
        _activeQuickFilter = QuickFilterAccepted;
    }
    else if (_filter.Status == QuotationStatuses.Rejected)
    {
        _activeQuickFilter = QuickFilterRejected;
    }
    else if (string.IsNullOrWhiteSpace(_filter.Status)
             && _filter.IsConverted == null
             && _filter.IsExpired == null
             && _filter.PendingOnly != true)
    {
        _activeQuickFilter = QuickFilterAll;
    }
    else
    {
        _activeQuickFilter = QuickFilterCustom;
    }
}

    private async Task OnDateFromChanged(DateTime? d)
