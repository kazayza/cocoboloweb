    private async Task ResetFilters()
{
    _filter = new();
    _dateFrom = null;
    _dateTo = null;
    _activeQuickFilter = QuickFilterAll;

    await LoadData();
}

    private void GoToAdd() => Navigation.NavigateTo("/quotations/new");
    private void GoToView(int id) => Navigation.NavigateTo($"/quotations/{id}");

    // ============================================================
    // Convert
    // ============================================================
    private async Task OpenConvertDialogAsync(QuotationListDto q)
    {
        if (q.InvoiceId != null)
        {
            Snackbar.Add("هذا العرض تم تحويله لفاتورة من قبل.", Severity.Warning);
            return;
        }

        _selected = q;
        _convertInvoiceDate = DateTime.Today;
        _convertQuotationValidUntil = q.ValidUntil;
        _convertMaxPeriodDays = 0;
        _convertGoToPayments = false;
        _convertAvailableAdvances = new();
        _selectedAdvanceChargeIds = new();

        try
        {
            var quotation = await QuotationService.GetQuotationForEditAsync(q.QuotationId);
            if (quotation != null)
            {
                _convertQuotationValidUntil = quotation.ValidUntil;
                _convertMaxPeriodDays = quotation.Items
                    .Where(i => i.Period.HasValue)
                    .Select(i => i.Period!.Value)
                    .DefaultIfEmpty(0)
                    .Max();

                if (quotation.PartyId.HasValue)
                {
                    _convertAvailableAdvances = await InvoiceService.GetCustomerAdvancesAsync(quotation.PartyId.Value, unappliedOnly: true) ?? new();

                    // ⭐ تحديد تلقائي (Pre-checked) لرسوم المعاينة والدفعات المقدمة الصريحة
                    // بحيث تُطبق كمدفوع على الفاتورة تلقائياً مع إمكانية فك التحديد
                    _selectedAdvanceChargeIds = new HashSet<int>(
                        _convertAvailableAdvances.Where(a => a.AutoApplyOnConvert).Select(a => a.ChargeId));
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"تعذّر تحميل بيانات التواريخ قبل التحويل: {ex.Message}", Severity.Warning);
        }

        RecalculateConvertDatesPreview();
        _showConvertDialog = true;
    }

    private Task OnConvertInvoiceDateChanged(DateTime? date)
    {
        _convertInvoiceDate = date ?? DateTime.Today;
        RecalculateConvertDatesPreview();
        return Task.CompletedTask;
    }

    private void RecalculateConvertDatesPreview()
    {
        var invoiceDate = (_convertInvoiceDate ?? DateTime.Today).Date;
        _convertCalculatedDueDate = invoiceDate.AddDays(_convertMaxPeriodDays);
    }

    private void ToggleAdvanceSelection(int chargeId, bool selected)
    {
        if (selected)
            _selectedAdvanceChargeIds.Add(chargeId);
        else
            _selectedAdvanceChargeIds.Remove(chargeId);
    }

    private decimal GetSelectedAdvanceTotal()
        => _convertAvailableAdvances
            .Where(a => _selectedAdvanceChargeIds.Contains(a.ChargeId))
            .Sum(a => a.ChargeAmount);

    private decimal GetRemainingAfterAdvances(decimal total)
        => Math.Max(0m, total - GetSelectedAdvanceTotal());

    private async Task ExecuteConvert()
    {
        if (_selected == null || _isConverting) return;

        if (GetSelectedAdvanceTotal() > _selected.GrandTotal)
        {
            Snackbar.Add("إجمالي الدفعات المقدمة المختارة أكبر من إجمالي عرض السعر.", Severity.Warning);
            return;
        }

        _isConverting = true;
        try
        {
            var (ok, msg, invId) = await QuotationService.ConvertToInvoiceAsync(
                _selected.QuotationId, _selectedAdvanceChargeIds.ToList(), _currentUserName!, _convertInvoiceDate);

            Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);

            if (ok && invId.HasValue)
            {
                _showConvertDialog = false;
                await LoadData();

                var remainingAfterAdvances = Math.Max(0m, _selected.GrandTotal - GetSelectedAdvanceTotal());
                if (_convertGoToPayments && remainingAfterAdvances > 0)
                    Navigation.NavigateTo($"/payments/new?type=Sale&invoice={invId.Value}");
                else if (_canViewInvoices)
                    Navigation.NavigateTo($"/sales/invoices/{invId.Value}");
                // ⭐ بدون صلاحية فواتير: نبقى في قائمة العروض (الفاتورة ظاهرة كمرجع نصي فقط)
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ غير متوقع: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isConverting = false;
        }
    }

    // ============================================================
    // Delete
    // ============================================================
    private void ConfirmDelete(QuotationListDto q)
    {
        if (q.InvoiceId != null)
        {
            Snackbar.Add("لا يمكن حذف عرض سعر تم تحويله لفاتورة.", Severity.Warning);
            return;
        }
        _selected = q;
        _showDeleteDialog = true;
    }
    [Inject] private IJSRuntime JS { get; set; } = null!;
[Inject] private IHttpClientFactory HttpFactory { get; set; } = null!;

private async Task ExportToExcel()
{
    try
    {
        Snackbar.Add("جاري تصدير الملف...", Severity.Info);

        var http = HttpFactory.CreateClient();
        http.BaseAddress = new Uri(Navigation.BaseUri);

        var response = await http.PostAsJsonAsync(
            "/api/quotations/export-excel", _filter);

        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add($"تعذّر التصدير. كود الخطأ: {response.StatusCode}", Severity.Error);
            return;
        }

        var bytes = await response.Content.ReadAsByteArrayAsync();
        var fileName = $"Quotations-{DateTime.Now:yyyyMMdd-HHmm}.xlsx";

        await DownloadFile(fileName,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            bytes);

        Snackbar.Add($"✅ تم تصدير {_pagedResult.TotalCount} عرض سعر بنجاح", Severity.Success);
    }
    catch (Exception ex)
    {
        Snackbar.Add($"خطأ في التصدير: {ex.Message}", Severity.Error);
    }
}

private async Task ExportToPdf()
{
    try
    {
        Snackbar.Add("جاري تصدير الملف...", Severity.Info);

        var http = HttpFactory.CreateClient();
        http.BaseAddress = new Uri(Navigation.BaseUri);

        var response = await http.PostAsJsonAsync(
            "/api/quotations/export-pdf", _filter);

        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add($"تعذّر التصدير. كود الخطأ: {response.StatusCode}", Severity.Error);
            return;
        }

        var bytes = await response.Content.ReadAsByteArrayAsync();
        var fileName = $"Quotations-{DateTime.Now:yyyyMMdd-HHmm}.pdf";

        await DownloadFile(fileName, "application/pdf", bytes);

        Snackbar.Add($"✅ تم تصدير {_pagedResult.TotalCount} عرض سعر بنجاح", Severity.Success);
    }
    catch (Exception ex)
    {
        Snackbar.Add($"خطأ في التصدير: {ex.Message}", Severity.Error);
    }
}

/// <summary>تنزيل ملف من الـ bytes عبر JS</summary>
private async Task DownloadFile(string fileName, string contentType, byte[] bytes)
{
    var base64 = Convert.ToBase64String(bytes);
    await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, contentType, base64);
}

    private async Task ExecuteDelete()
    {
        if (_selected == null || _isDeleting) return;

        _isDeleting = true;
        try
        {
            var (ok, msg) = await QuotationService.DeleteQuotationAsync(
                _selected.QuotationId, _currentUserName!);

            Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);

            if (ok)
            {
                _showDeleteDialog = false;
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"تعذّر الحذف: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private string GetPricingModeText(string? pricingType)
        => QuotationPricingModes.All.GetValueOrDefault(pricingType ?? PricingTiers.Premium, "بريميوم");

    private Color GetPricingModeColor(string? pricingType)
    {
        return pricingType switch
        {
            var t when t == PricingTiers.CClass => Color.Secondary,
            var t when t == PricingTiers.Elite => Color.Warning,
            var t when t == QuotationPricingModes.Mixed => Color.Primary,
            _ => Color.Info
        };
    }

    private string FormatMoney(decimal v) => $"{v:N2} ج";
    private string FormatCompactMoney(decimal value)
{
    var abs = Math.Abs(value);

    if (abs >= 1_000_000_000)
        return $"{value / 1_000_000_000m:N2}B ج";

    if (abs >= 1_000_000)
        return $"{value / 1_000_000m:N2}M ج";

    if (abs >= 1_000)
        return $"{value / 1_000m:N0}K ج";

    return $"{value:N0} ج";
}

