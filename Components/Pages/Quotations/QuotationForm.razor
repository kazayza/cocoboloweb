@page "/quotations/new"
@page "/quotations/{Id:int}"
@page "/quotations/{Id:int}/edit"

@using Microsoft.AspNetCore.Components
@using global::COCOBOLOERPNEW.DTOs
@using global::COCOBOLOERPNEW.Services
@using global::COCOBOLOERPNEW.Helpers
@using global::COCOBOLOERPNEW.Models

@inject IQuotationService QuotationService
@inject IInvoiceService InvoiceService
@inject IOpportunityService OpportunityService
@inject IProductService ProductService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthProvider
@inject IDialogService DialogService

@if (_isLoading)
{
    <div class="loading-container">
        <div class="loading-card">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.h6" Class="mt-4" Style="color: var(--gold);">جاري تحميل البيانات...</MudText>
        </div>
    </div>
}
else
{
    var isOverdue = _form.ValidUntil.HasValue && _form.ValidUntil.Value.Date < DateTime.Today && !_form.IsConverted;
    var daysLeft = _form.DaysUntilExpiry;

    <div class="quotation-form-page" dir="rtl">

        <!-- ============= HEADER ============= -->
        <div class="form-header">
            <div class="header-top">
                <div class="header-left">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowForward"
                                   Color="Color.Inherit" OnClick="GoBack" />
                    <div>
                        <h1>
                            <MudIcon Icon="@Icons.Material.Filled.RequestQuote" />
                            @(IsEdit ? (_isReadOnly ? "عرض سعر" : "تعديل عرض السعر") : "عرض سعر جديد")
                        </h1>
                        <p>
                            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(_form.Status)">
                                @GetStatusText(_form.Status)
                            </MudChip>
                            @if (isOverdue)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error"
                                         Icon="@Icons.Material.Filled.Warning">منتهي الصلاحية</MudChip>
                            }
                            @if (_form.Status == QuotationStatuses.Rejected && !string.IsNullOrEmpty(_rejectionReason))
{
    <MudAlert Severity="Severity.Warning" Class="mt-3" Icon="@Icons.Material.Filled.Info">
        <strong>سبب الرفض من العميل:</strong>
        <br />
        @_rejectionReason
        @if (_rejectedAt.HasValue || !string.IsNullOrWhiteSpace(_rejectedBy))
        {
            <div style="font-size:0.85rem; opacity:0.8; margin-top:8px; line-height:1.8;">
                @if (!string.IsNullOrWhiteSpace(_rejectedBy))
                {
                    <div>
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                        تم تسجيل الرفض بواسطة: <strong>@_rejectedBy</strong>
                    </div>
                }
                @if (_rejectedAt.HasValue)
                {
                    <div>
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                        تاريخ الرفض: <strong>@_rejectedAt.Value.ToString("yyyy/MM/dd HH:mm")</strong>
                    </div>
                }
            </div>
        }
    </MudAlert>
}
                            @if (!string.IsNullOrEmpty(_form.ReferenceNumber))
                            {
                                <span> • @_form.ReferenceNumber</span>
                            }
                            @if (!string.IsNullOrEmpty(_form.EmpName))
                            {
                                <span> • الموظف: @_form.EmpName</span>
                            }
                        </p>
                    </div>
                </div>
                <div class="header-right">
                    <MudButton Variant="Variant.Outlined" Color="Color.Inherit" OnClick="GoBack"
                               StartIcon="@Icons.Material.Filled.Close">إلغاء</MudButton>

                    @if (IsEdit)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="OpenPrintPage"
                                   StartIcon="@Icons.Material.Filled.Print">طباعة</MudButton>

                        @if (!_form.IsConverted && (string.IsNullOrWhiteSpace(_form.Status) || _form.Status == QuotationStatuses.Draft))
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Success"
                                       OnClick="OpenWhatsAppDialog"
                                       StartIcon="@Icons.Material.Filled.Send"
                                       Style="background: #25D366 !important;">
                                إرسال واتساب
                            </MudButton>
                        }

                        @if (_isReadOnly && _canEdit && !_form.IsConverted)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Warning"
                                       OnClick="@(() => _isReadOnly = false)"
                                       StartIcon="@Icons.Material.Filled.Edit">تعديل</MudButton>
                        }

                        @if (!_form.IsConverted && _canEdit)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Inherit"
                                       OnClick="OpenChangeStatusDialog"
                                       StartIcon="@Icons.Material.Filled.Flag">تغيير الحالة</MudButton>
                        }
                        @* ⭐ زرارين رد العميل (يظهروا لو العرض مش متحول ومش متأكد منه) *@
@if (IsEdit && _form.QuotationId > 0 && !_form.IsConverted 
     && _form.Status != QuotationStatuses.Accepted 
     && _form.Status != QuotationStatuses.Rejected
     && _form.Status != QuotationStatuses.Converted)
{
    <MudTooltip Text="تسجيل موافقة العميل (بعد التواصل معه)">
        <MudButton Variant="Variant.Filled" Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.ThumbUp"
                   OnClick="@(() => UpdateCustomerResponse(true))"
                   Disabled="@_isUpdatingResponse"
                   Size="Size.Small"
                   Class="mx-1">
            العميل وافق
        </MudButton>
    </MudTooltip>

    <MudTooltip Text="تسجيل رفض العميل">
        <MudButton Variant="Variant.Filled" Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.ThumbDown"
                   OnClick="@(() => UpdateCustomerResponse(false))"
                   Disabled="@_isUpdatingResponse"
                   Size="Size.Small"
                   Class="mx-1">
            العميل رفض
        </MudButton>
    </MudTooltip>
}

                        @if (!_form.IsConverted)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Success"
                                       OnClick="OpenConvertDialog"
                                       StartIcon="@Icons.Material.Filled.SwapHoriz">
                                تحويل لفاتورة
                            </MudButton>
                        }
                    }

                    @if (!_isReadOnly && !_form.IsConverted)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="SaveQuotation"
                                   Disabled="@_isSaving"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   Class="save-btn">
                            @if (_isSaving)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                            }
                            حفظ
                        </MudButton>
                    }
                </div>
            </div>

            <!-- ⭐ Quick Summary -->
            @if (IsEdit)
            {
                <div class="header-summary">
                    <div class="summary-pill">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                        <div>
                            <span>العميل</span>
                            <strong>@(_form.PartyName ?? "-")</strong>
                        </div>
                    </div>
                    <div class="summary-pill">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" />
                        <div>
                            <span>التاريخ</span>
                            <strong>@_form.QuotationDate.ToString("yyyy/MM/dd")</strong>
                        </div>
                    </div>
                    <div class="summary-pill pill-total">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Small" />
                        <div>
                            <span>الإجمالي</span>
                            <strong>@FormatMoney(_form.GrandTotal) ج</strong>
                        </div>
                    </div>
                    <div class="summary-pill">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" />
                        <div>
                            <span>الأصناف</span>
                            <strong>@_form.Items.Count</strong>
                        </div>
                    </div>
                    @if (_form.ValidUntil.HasValue)
                    {
                        <div class="summary-pill @(isOverdue ? "pill-overdue" : (daysLeft <= 7 ? "pill-warning" : ""))">
                            <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" />
                            <div>
                                <span>الصلاحية</span>
                                <strong>
                                    @_form.ValidUntil.Value.ToString("yyyy/MM/dd")
                                    @if (daysLeft.HasValue && daysLeft.Value >= 0 && !_form.IsConverted)
                                    {
                                        <span style="font-size:0.7rem; opacity:0.85;"> (@daysLeft يوم)</span>
                                    }
                                </strong>
                            </div>
                        </div>
                    }
                    @if (GetSelectedOpportunity() is OpportunityLookupDto linkedOpportunity)
                    {
                        <div class="summary-pill pill-opportunity">
                            <MudIcon Icon="@Icons.Material.Filled.TrackChanges" Size="Size.Small" />
                            <div>
                                <span>فرصة البيع</span>
                                <strong>#@linkedOpportunity.OpportunityId — @(linkedOpportunity.StageNameAr ?? "—")</strong>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ⭐ تنبيهات -->
        @if (_form.IsConverted)
        {
            <MudAlert Severity="Severity.Success" Class="mb-3" Icon="@Icons.Material.Filled.CheckCircle"
                      Variant="Variant.Filled" Dense="true">
                ✅ تم تحويل عرض السعر إلى الفاتورة
                <a href="/sales/invoices/@_form.InvoiceId" style="color: white; text-decoration: underline; font-weight: 800;">
                    @_form.InvoiceReference
                </a>
                ولا يمكن تعديله.
            </MudAlert>
        }

        @if (_form.Status == QuotationStatuses.Sent && !_form.IsConverted)
        {
            <MudAlert Severity="Severity.Info" Class="mb-3" Icon="@Icons.Material.Filled.MarkEmailRead" Dense="true">
                ✅ تم إرسال عرض السعر للعميل، ويمكنك الآن متابعة الرد أو تغيير الحالة عند الحاجة.
            </MudAlert>
        }

        @if (_form.Status == QuotationStatuses.Accepted)
        {
            <MudAlert Severity="Severity.Success" Class="mb-3" Icon="@Icons.Material.Filled.ThumbUp" Dense="true">
                <strong>تمت الموافقة على عرض السعر</strong>
                @if (_acceptedAt.HasValue || !string.IsNullOrWhiteSpace(_acceptedBy))
                {
                    <div style="font-size:0.85rem; opacity:0.9; margin-top:8px; line-height:1.8;">
                        @if (!string.IsNullOrWhiteSpace(_acceptedBy))
                        {
                            <div>
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                تم اعتماد العرض بواسطة: <strong>@_acceptedBy</strong>
                            </div>
                        }
                        @if (_acceptedAt.HasValue)
                        {
                            <div>
                                <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                                تاريخ ووقت الموافقة: <strong>@_acceptedAt.Value.ToString("yyyy/MM/dd HH:mm")</strong>
                            </div>
                        }
                    </div>
                }
            </MudAlert>
        }

        @if (isOverdue && !_form.IsConverted)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3" Icon="@Icons.Material.Filled.Warning"
                      Variant="Variant.Filled" Dense="true">
                ⚠️ عرض السعر منتهي الصلاحية منذ <strong>@(Math.Abs((DateTime.Today - _form.ValidUntil!.Value.Date).Days)) يوم</strong>
            </MudAlert>
        }
        else if (daysLeft.HasValue && daysLeft.Value <= 7 && daysLeft.Value >= 0 && !_form.IsConverted)
        {
            <MudAlert Severity="Severity.Info" Class="mb-3" Icon="@Icons.Material.Filled.AccessTime" Dense="true">
                ℹ️ عرض السعر ينتهي خلال <strong>@daysLeft يوم</strong>
            </MudAlert>
        }

        <div class="form-grid">
            <!-- ============= Main Column ============= -->
            <div class="main-col">

                <!-- بيانات عرض السعر -->
                <MudPaper Class="form-section" Elevation="0">
                    <div class="section-header">
                        <MudIcon Icon="@Icons.Material.Filled.Description" />
                        <h3>بيانات عرض السعر</h3>
                    </div>
                    <div class="quotation-meta-grid">
                        <MudTextField Value="@_form.ReferenceNumber"
              Label="الرقم"
              Variant="Variant.Outlined"
              ReadOnly="true"
              Margin="Margin.Dense" />

                        <MudDatePicker Date="_form.QuotationDate"
                                       DateChanged="@(d => _form.QuotationDate = d ?? DateTime.Now)"
                                       Label="تاريخ العرض" Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       ReadOnly="@_isReadOnly" />

                        <MudDatePicker Date="_form.ValidUntil"
                                       DateChanged="@(d => _form.ValidUntil = d)"
                                       Label="ساري لحد تاريخ"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true"
                                       ReadOnly="@_isReadOnly" />

                        <MudSelect T="int?" @bind-Value="_form.WarehouseId"
                                   Label="المخزن (اختياري)"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true"
                                   Disabled="@_isReadOnly">
                            @foreach (var w in _warehouses)
                            {
                                <MudSelectItem T="int?" Value="@((int?)w.WarehouseId)">@(string.IsNullOrWhiteSpace(w.Branch?.BranchNameAr) ? w.WarehouseName : $"{w.WarehouseName} — {w.Branch!.BranchNameAr}")</MudSelectItem>
                            }
                        </MudSelect>

                        <MudTextField Value="@(_form.EmpName ?? "غير محدد")"
                                      Label="الموظف" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Person" />

                        <MudSelect T="string" Value="_form.PricingType"
                                   ValueChanged="@((string v) => OnPricingTypeChanged(v))"
                                   Label="وضع التسعير"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Disabled="@_isReadOnly">
                            @foreach (var tier in QuotationPricingModes.All)
                            {
                                <MudSelectItem T="string" Value="@tier.Key">@tier.Value</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                </MudPaper>

                <!-- العميل -->
                <MudPaper Class="form-section" Elevation="0">
                    <div class="section-header">
                        <MudIcon Icon="@Icons.Material.Filled.Person" />
                        <h3>العميل</h3>
                    </div>

                    <MudAutocomplete T="PartyLookupDto"
                                     Label="ابحث عن العميل بالاسم أو الهاتف *"
                                     Value="_selectedParty"
                                     ValueChanged="OnPartySelected"
                                     SearchFunc="SearchParties"
                                     ToStringFunc="@(p => p == null ? "" : p.PartyName)"
                                     Variant="Variant.Outlined"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                     Clearable="true"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true"
                                     Disabled="@_isReadOnly"
                                     MinCharacters="1">
                        <ItemTemplate Context="party">
                            <div style="display:flex; flex-direction:column; gap:0.25rem;">
                                <strong>@party.PartyName</strong>
                                <span style="font-size:0.78rem; color:var(--mud-palette-text-secondary);">
                                    @if (!string.IsNullOrEmpty(party.Phone))
                                    {
                                        <span>📞 @party.Phone</span>
                                    }
                                    @if (!string.IsNullOrEmpty(party.City))
                                    {
                                        <span> • @party.City</span>
                                    }
                                </span>
                            </div>
                        </ItemTemplate>
                    </MudAutocomplete>

                    @if (_form.PartyId.HasValue && !string.IsNullOrEmpty(_form.PartyPhone))
                    {
                        <div class="party-phone-info mt-2">
                            <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" />
                            <span>الهاتف: <strong>@_form.PartyPhone</strong></span>
                        </div>
                    }

                    @if (_form.PartyId.HasValue)
                    {
                        <div class="opportunity-link-box mt-3">
                            <div class="opportunity-link-head">
                                <div>
                                    <strong>ربط بفرصة بيع</strong>
                                    <div class="opportunity-link-sub">اختياري، لكن مطلوب إذا أردت ربط العرض والفاتورة لاحقًا بالـ CRM بشكل صحيح.</div>
                                </div>
                                @if (!_isReadOnly)
                                {
                                    <div class="opportunity-link-actions">
                                        <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Refresh"
                                                   OnClick="@(() => LoadOpportunitiesForParty(_form.PartyId!.Value))">
                                            تحديث
                                        </MudButton>
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Add"
                                                   OnClick="OpenCreateOpportunityAsync">
                                            إنشاء فرصة
                                        </MudButton>
                                    </div>
                                }
                            </div>

                            <MudSelect T="int?"
                                       Value="_form.OpportunityId"
                                       ValueChanged="OnOpportunityChanged"
                                       Label="فرصة البيع"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true"
                                       Disabled="@_isReadOnly">
                                @foreach (var opp in _partyOpportunities)
                                {
                                    <MudSelectItem T="int?" Value="@((int?)opp.OpportunityId)">
                                        @($"#{opp.OpportunityId} — {(opp.StageNameAr ?? "بدون مرحلة")} — {(opp.ExpectedValue.HasValue ? FormatMoney(opp.ExpectedValue.Value) + " ج" : "بدون قيمة")}")
                                    </MudSelectItem>
                                }
                            </MudSelect>

                            @if (!_partyOpportunities.Any())
                            {
                                <div class="opportunity-link-empty">لا توجد فرص بيع مرتبطة بهذا العميل حاليًا.</div>
                            }
                            else if (_form.OpportunityId.HasValue)
                            {
                                var currentOpp = _partyOpportunities.FirstOrDefault(o => o.OpportunityId == _form.OpportunityId.Value);
                                if (currentOpp != null)
                                {
                                    <div class="opportunity-link-summary">
                                        <span>الفرصة المختارة: <strong>#@currentOpp.OpportunityId</strong></span>
                                        <span>•</span>
                                        <span>المرحلة: <strong>@(currentOpp.StageNameAr ?? "—")</strong></span>
                                        @if (currentOpp.ExpectedValue.HasValue)
                                        {
                                            <span>•</span>
                                            <span>القيمة المتوقعة: <strong>@FormatMoney(currentOpp.ExpectedValue.Value) ج</strong></span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(currentOpp.EmployeeName))
                                        {
                                            <span>•</span>
                                            <span>مسؤول الفرصة: <strong>@currentOpp.EmployeeName</strong></span>
                                        }
                                    </div>

                                    <div class="opportunity-preview-card">
                                        <div class="opportunity-preview-top">
                                            <div class="opportunity-preview-title-wrap">
                                                <div class="opportunity-preview-icon">
                                                    <MudIcon Icon="@Icons.Material.Filled.TrackChanges" Size="Size.Small" />
                                                </div>
                                                <div>
                                                    <div class="opportunity-preview-title">الفرصة المرتبطة بالعرض</div>
                                                    <div class="opportunity-preview-sub">هذا العرض وهذا التحويل إلى الفاتورة سيتسجلان على نفس الفرصة.</div>
                                                </div>
                                            </div>
                                            @if (!_isReadOnly)
                                            {
                                                <MudButton Variant="Variant.Outlined"
                                                           Color="Color.Info"
                                                           Size="Size.Small"
                                                           StartIcon="@Icons.Material.Filled.OpenInNew"
                                                           OnClick="@(() => OpenOpportunityDetails(currentOpp.OpportunityId))">
                                                    فتح الفرصة
                                                </MudButton>
                                            }
                                        </div>

                                        <div class="opportunity-preview-grid">
                                            <div class="opp-preview-item">
                                                <span class="opp-preview-label">رقم الفرصة</span>
                                                <strong>#@currentOpp.OpportunityId</strong>
                                            </div>
                                            <div class="opp-preview-item">
                                                <span class="opp-preview-label">المرحلة الحالية</span>
                                                <strong>@(currentOpp.StageNameAr ?? "—")</strong>
                                            </div>
                                            <div class="opp-preview-item">
                                                <span class="opp-preview-label">مسؤول الفرصة</span>
                                                <strong>@(currentOpp.EmployeeName ?? "غير محدد")</strong>
                                            </div>
                                            <div class="opp-preview-item">
                                                <span class="opp-preview-label">القيمة المتوقعة</span>
                                                <strong>@(currentOpp.ExpectedValue.HasValue ? FormatMoney(currentOpp.ExpectedValue.Value) + " ج" : "غير محددة")</strong>
                                            </div>
                                        </div>

                                        
                                    </div>
                                }
                            }
                        </div>
                    }
                </MudPaper>

                <!-- ⭐ الأصناف (Cards زي الفواتير) -->
                <MudPaper Class="form-section" Elevation="0">
                    <div class="section-header" style="justify-content: space-between;">
                        <div style="display:flex; align-items:center; gap:0.5rem;">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
                            <h3>الأصناف (@_form.Items.Count)</h3>
                        </div>
                        @if (!_isReadOnly && _availableProducts.Any())
                        {
                            <div class="view-toggle-group">
                                <MudButton Variant="@(_productSelectionView == "cards" ? Variant.Filled : Variant.Outlined)"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick='@(() => _productSelectionView = "cards")'>بطاقات</MudButton>
                                <MudButton Variant="@(_productSelectionView == "table" ? Variant.Filled : Variant.Outlined)"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick='@(() => _productSelectionView = "table")'>جدول</MudButton>
                            </div>
                        }
                    </div>

                    @if (!_isReadOnly && _form.PartyId.HasValue && !_availableProducts.Any())
                    {
                        <div class="empty-items">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Large" />
                            <p>لا توجد منتجات متاحة لهذا العميل</p>
                        </div>
                    }
                    else if (!_isReadOnly && !_form.PartyId.HasValue)
                    {
                        <div class="empty-items">
                            <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Size="Size.Large" />
                            <p>اختر العميل أولاً لعرض المنتجات المتاحة</p>
                        </div>
                    }

                    <!-- شبكة المنتجات المتاحة -->
                    @if (!_isReadOnly && _availableProducts.Any() && _productSelectionView == "cards")
                    {
                        <div class="products-grid">
                            @foreach (var prod in _availableProducts)
                            {
                                var isAdded = AreAllAvailableTiersAdded(prod);
                                <div class="product-card @(isAdded ? "product-added" : "")">
                                    <div class="product-card-img">
                                        <img src="/api/product-images/@prod.ProductId"
                                             alt="@prod.ProductName"
                                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                                        <div class="img-placeholder-sm" style="display:none">📦</div>
                                    </div>
                                    <div class="product-card-info">
                                        <strong class="product-card-name">@prod.ProductName</strong>
                                        @if (!string.IsNullOrEmpty(prod.ProductDescription))
                                        {
                                            <span class="product-card-desc">@prod.ProductDescription</span>
                                        }

                                        @{
                                            var hasCClass = HasProductTier(prod, PricingTiers.CClass);
                                            var hasPremium = HasProductTier(prod, PricingTiers.Premium);
                                            var hasElite = HasProductTier(prod, PricingTiers.Elite);
                                            var addedCClass = IsTierAlreadyAdded(prod.ProductId, PricingTiers.CClass);
                                            var addedPremium = IsTierAlreadyAdded(prod.ProductId, PricingTiers.Premium);
                                            var addedElite = IsTierAlreadyAdded(prod.ProductId, PricingTiers.Elite);
                                            var defaultTier = GetDefaultTierForAdd();
                                            var canAddByDefault = HasProductTier(prod, defaultTier);
                                            var alreadyAddedByDefault = IsTierAlreadyAdded(prod.ProductId, defaultTier);
                                        }

                                        <div class="product-card-pricing-list">
                                            @if (hasCClass)
                                            {
                                                <div class="price-line price-cclass">
                                                    <span class="price-tag">
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Dense="true">C Class</MudChip>
                                                    </span>
                                                    <span class="price-value">@($"{(prod.SuggestedSalePriceCClass ?? 0):N2}") ج</span>
                                                </div>
                                            }

                                            @if (hasPremium)
                                            {
                                                <div class="price-line price-premium">
                                                    <span class="price-tag">
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Dense="true">Premium</MudChip>
                                                    </span>
                                                    <span class="price-value">@($"{(prod.SuggestedSalePrice ?? 0):N2}") ج</span>
                                                </div>
                                            }

                                            @if (hasElite)
                                            {
                                                <div class="price-line price-elite">
                                                    <span class="price-tag">
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Dense="true">Elite</MudChip>
                                                    </span>
                                                    <span class="price-value">@($"{(prod.SuggestedSalePriceElite ?? 0):N2}") ج</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
