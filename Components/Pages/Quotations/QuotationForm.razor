    private void SyncQuotationFromOpportunity(OpportunityLookupDto opportunity, bool preserveIfEmptyOnly)
    {
        // متعمدين ما نغيرش موظف عرض السعر من موظف الفرصة.
        // موظف العرض يظل هو المستخدم الحالي/الذي أنشأ العرض.
    }

    private void OpenOpportunityDetails(int opportunityId)
    {
        if (opportunityId <= 0) return;
        Navigation.NavigateTo($"/crm/opportunities/{opportunityId}");
    }

    private async Task OpenCreateOpportunityAsync()
    {
        if (!_form.PartyId.HasValue || _form.PartyId.Value <= 0)
        {
            Snackbar.Add("اختر العميل أولاً قبل إنشاء فرصة بيع.", Severity.Warning);
