    private async Task EnsureAlternativesLoadedAsync(IEnumerable<int> productIds)
    {
        var ids = productIds.Where(id => id > 0).Distinct().ToList();
        foreach (var id in ids)
        {
            if (_productApprovedAlternatives.ContainsKey(id))
                continue;

            var allAlternatives = await ProductService.GetFactoryAlternativesAsync(id);
            _productApprovedAlternatives[id] = allAlternatives
                .Where(a => a.Status == ProductFactoryAlternativeStatuses.Approved || a.IsPrimary)
                .OrderByDescending(a => a.IsPrimary)
                .ThenBy(a => a.AlternativeName)
                .ToList();
        }
    }

    private IEnumerable<ProductFactoryAlternativeDto> GetSelectableAlternatives(int productId)
        => _productApprovedAlternatives.TryGetValue(productId, out var list)
            ? list
            : Enumerable.Empty<ProductFactoryAlternativeDto>();

    private bool HasSelectableAlternatives(int productId)
        => GetSelectableAlternatives(productId).Any();

    private async Task OnAlternativeChanged(int index, int? alternativeId)
    {
        if (index < 0 || index >= _form.Items.Count)
            return;

        var item = _form.Items[index];
        await EnsureAlternativesLoadedAsync(new[] { item.ProductId });

        var selected = GetSelectableAlternatives(item.ProductId)
            .FirstOrDefault(a => a.AlternativeId == alternativeId);

        item.SelectedAlternativeId = selected?.AlternativeId;
        item.SelectedAlternativeName = selected?.AlternativeName;
        item.SelectedAlternativeSummary = selected?.SpecificationSummary;
        item.AlternativeSalePriceCClass = selected?.SuggestedSalePriceCClass;
        item.AlternativeSalePricePremium = selected?.SuggestedSalePricePremium;
        item.AlternativeSalePriceElite = selected?.SuggestedSalePriceElite;
        item.AlternativePurchasePriceCClass = selected?.PurchasePriceCClass;
        item.AlternativePurchasePricePremium = selected?.PurchasePricePremium;
        item.AlternativePurchasePriceElite = selected?.PurchasePriceElite;
        item.AlternativePeriod = selected?.Period;

        if (selected != null && !HasItemTier(item, item.PricingTier))
        {
            var fallbackTier = GetAvailableTiers(item).Select(t => t.Key).FirstOrDefault();
            if (!string.IsNullOrWhiteSpace(fallbackTier))
                item.PricingTier = fallbackTier;
        }

        item.UnitPrice = GetPriceByTier(item, item.PricingTier);

        RecalculateTotals();
    }

