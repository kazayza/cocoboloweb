    // ============================================================
    // Pricing
    // ============================================================
    private string NormalizeHeaderPricingMode(string? mode)
    {
        if (string.Equals(mode, QuotationPricingModes.Mixed, StringComparison.OrdinalIgnoreCase))
            return QuotationPricingModes.Mixed;

        return NormalizeTier(mode);
    }

    private string NormalizeTier(string? tier)
    {
        if (string.Equals(tier, PricingTiers.CClass, StringComparison.OrdinalIgnoreCase))
            return PricingTiers.CClass;

        if (string.Equals(tier, PricingTiers.Elite, StringComparison.OrdinalIgnoreCase))
            return PricingTiers.Elite;

        return PricingTiers.Premium;
    }

    private bool IsMixedPricingMode => NormalizeHeaderPricingMode(_form.PricingType) == QuotationPricingModes.Mixed;

    private string GetTierLabel(string? tier)
        => PricingTiers.All.GetValueOrDefault(NormalizeTier(tier), "بريميوم");

    private string GetPricingModeLabel(string? mode)
        => QuotationPricingModes.All.GetValueOrDefault(NormalizeHeaderPricingMode(mode), "بريميوم");

    private Color GetTierButtonColor(string? tier)
    {
        return NormalizeTier(tier) switch
        {
            var t when t == PricingTiers.CClass => Color.Secondary,
            var t when t == PricingTiers.Elite => Color.Warning,
            _ => Color.Info
        };
    }

    private string GetDefaultTierForAdd()
        => IsMixedPricingMode ? PricingTiers.Premium : NormalizeTier(_form.PricingType);

    private bool HasProductTier(ProductLookupDto product, string tier)
    {
        return NormalizeTier(tier) switch
        {
            var t when t == PricingTiers.CClass => (product.SuggestedSalePriceCClass ?? 0) > 0,
            var t when t == PricingTiers.Elite => (product.SuggestedSalePriceElite ?? 0) > 0,
            _ => (product.SuggestedSalePrice ?? 0) > 0
        };
    }

    private bool HasItemTier(QuotationItemDto item, string tier)
    {
        if (item.SelectedAlternativeId.HasValue)
        {
            return NormalizeTier(tier) switch
            {
                var t when t == PricingTiers.CClass => (item.AlternativeSalePriceCClass ?? 0) > 0,
                var t when t == PricingTiers.Elite => ((item.AlternativeSalePriceElite ?? item.AlternativeSalePricePremium) ?? 0) > 0,
                _ => (item.AlternativeSalePricePremium ?? 0) > 0
            };
        }

        return NormalizeTier(tier) switch
        {
            var t when t == PricingTiers.CClass => (item.SalePriceCClass ?? 0) > 0,
            var t when t == PricingTiers.Elite => (item.SalePriceElite ?? 0) > 0,
            _ => (item.SalePricePremium ?? 0) > 0
        };
    }

    private bool IsTierAlreadyAdded(int productId, string tier)
        => _form.Items.Any(i => i.ProductId == productId && i.PricingTier == NormalizeTier(tier));

    private bool AreAllAvailableTiersAdded(ProductLookupDto product)
    {
        var availableTiers = new List<string>();

        if (HasProductTier(product, PricingTiers.CClass))
            availableTiers.Add(PricingTiers.CClass);
        if (HasProductTier(product, PricingTiers.Premium))
            availableTiers.Add(PricingTiers.Premium);
        if (HasProductTier(product, PricingTiers.Elite))
            availableTiers.Add(PricingTiers.Elite);

        return availableTiers.Any() && availableTiers.All(t => IsTierAlreadyAdded(product.ProductId, t));
    }

    private IEnumerable<KeyValuePair<string, string>> GetAvailableTiers(QuotationItemDto item)
    {
        if (HasItemTier(item, PricingTiers.CClass))
            yield return new KeyValuePair<string, string>(PricingTiers.CClass, PricingTiers.All[PricingTiers.CClass]);

        if (HasItemTier(item, PricingTiers.Premium))
            yield return new KeyValuePair<string, string>(PricingTiers.Premium, PricingTiers.All[PricingTiers.Premium]);

        if (HasItemTier(item, PricingTiers.Elite))
            yield return new KeyValuePair<string, string>(PricingTiers.Elite, PricingTiers.All[PricingTiers.Elite]);
    }

    private void SyncPricingTypeFromItems()
    {
        if (!_form.Items.Any())
        {
            _form.PricingType = NormalizeHeaderPricingMode(_form.PricingType);
            if (string.IsNullOrWhiteSpace(_form.PricingType))
                _form.PricingType = PricingTiers.Premium;
            return;
        }

        var distinctTiers = _form.Items
            .Select(i => NormalizeTier(i.PricingTier))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        _form.PricingType = distinctTiers.Count == 1
            ? distinctTiers[0]
            : QuotationPricingModes.Mixed;
    }

    private void OnPricingTypeChanged(string newType)
    {
        var normalizedMode = NormalizeHeaderPricingMode(newType);

        if (normalizedMode == QuotationPricingModes.Mixed)
        {
            _form.PricingType = QuotationPricingModes.Mixed;
            RecalculateTotals();
            return;
        }

        if (_form.Items.Any())
        {
            var unsupportedItems = _form.Items
                .Where(i => !HasItemTier(i, normalizedMode))
                .Select(i => i.ProductName)
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .Distinct()
                .ToList();

            if (unsupportedItems.Any())
            {
                Snackbar.Add($"لا يمكن تحويل كل البنود إلى {GetTierLabel(normalizedMode)} لأن بعض الأصناف لا تملك هذه الباقة: {string.Join("، ", unsupportedItems.Take(3))}", Severity.Warning);
                SyncPricingTypeFromItems();
                return;
            }

            foreach (var item in _form.Items)
            {
                item.PricingTier = normalizedMode;
                if (item.ProductId > 0)
                    item.UnitPrice = GetPriceByTier(item, normalizedMode);
            }
        }

        _form.PricingType = normalizedMode;
        RecalculateTotals();
        SyncPricingTypeFromItems();
    }

    private void OnTierChanged(int index, string newTier)
    {
        if (index < 0 || index >= _form.Items.Count) return;

        var item = _form.Items[index];
        var effectiveTier = NormalizeTier(newTier);

        if (!HasItemTier(item, effectiveTier))
        {
            Snackbar.Add($"الباقة {GetTierLabel(effectiveTier)} غير متاحة لهذا الصنف.", Severity.Warning);
            return;
        }

        item.PricingTier = effectiveTier;
        if (item.ProductId > 0)
            item.UnitPrice = GetPriceByTier(item, effectiveTier);

        RecalculateTotals();
        SyncPricingTypeFromItems();
    }

    private static decimal GetPriceByTier(QuotationItemDto item, string tier)
    {
        if (item.SelectedAlternativeId.HasValue)
        {
            return tier switch
            {
                var t when t == PricingTiers.CClass => item.AlternativeSalePriceCClass ?? 0m,
                var t when t == PricingTiers.Elite => item.AlternativeSalePriceElite ?? item.AlternativeSalePricePremium ?? 0m,
                _ => item.AlternativeSalePricePremium ?? 0m
            };
        }

        return tier switch
        {
            var t when t == PricingTiers.CClass => item.SalePriceCClass ?? 0m,
            var t when t == PricingTiers.Elite => item.SalePriceElite ?? item.SalePricePremium ?? 0m,
            _ => item.SalePricePremium ?? 0m
        };
    }
    /// <summary>
/// سعر البيع الأساسي من جدول المنتجات حسب الباقة المختارة.
/// ممنوع سعر البيع في عرض السعر يقل عنه.
/// </summary>
private decimal GetBaseSalePrice(QuotationItemDto item)
{
    return GetPriceByTier(item, item.PricingTier);
}
/// <summary>مجموع الأسعار الأساسية لكل الأصناف حسب الباقة المختارة</summary>
private decimal GetBaseTotal()
{
    return Math.Round(_form.Items.Sum(i => i.Quantity * GetBaseSalePrice(i)), 2);
}

/// <summary>إجمالي الزيادة الحالية فوق الأسعار الأساسية.</summary>
private decimal GetIncreaseDiscountCap()
{
    return Math.Max(0, Math.Round(_form.TotalAmount - GetBaseTotal(), 2));
}

/// <summary>أقصى خصم من السعر الأساسي لصلاحية مدير المبيعات.</summary>
private decimal GetSalesManagerDiscountCap()
{
    return Math.Round(GetBaseTotal() * (SalesManagerDiscountLimitPercent / 100m), 2);
}

/// <summary>أقصى خصم من السعر الأساسي لصلاحية الدور الحالي فقط، بدون الزيادة.</summary>
private decimal GetRoleBaseDiscountCap()
{
    if (_isAdmin || _isAccountManager)
        return GetBaseTotal();

    if (_isSalesManager)
        return GetSalesManagerDiscountCap();

    return 0m;
}

/// <summary>الحد النهائي للخصم = الزيادة الحالية + خصم الدور من الأساسي.</summary>
private decimal GetRoleDiscountCap()
{
    return Math.Round(Math.Min(_form.TotalAmount, GetIncreaseDiscountCap() + GetRoleBaseDiscountCap()), 2);
}

private decimal GetMaxDiscount()
{
    var preservedDiscount = Math.Min(Math.Max(_originalDiscountAmount, 0m), _form.TotalAmount);
    return Math.Max(preservedDiscount, GetRoleDiscountCap());
}

private string? GetDiscountPermissionMessage(decimal requestedDiscountAmount)
{
    requestedDiscountAmount = Math.Round(Math.Max(requestedDiscountAmount, 0m), 0);
    if (requestedDiscountAmount <= 0)
        return null;

    var baseTotal = GetBaseTotal();
    var increaseCap = GetIncreaseDiscountCap();
    var salesManagerBaseCap = GetSalesManagerDiscountCap();
    var salesManagerTotalCap = Math.Min(_form.TotalAmount, increaseCap + salesManagerBaseCap);
    var preservedDiscount = Math.Min(Math.Max(_originalDiscountAmount, 0m), _form.TotalAmount);

    if (requestedDiscountAmount > _form.TotalAmount)
        return $"لا يمكن أن يتجاوز الخصم إجمالي عرض السعر الحالي ({FormatMoney(_form.TotalAmount)} ج).";

    if (requestedDiscountAmount <= increaseCap || requestedDiscountAmount <= preservedDiscount)
        return null;

    if (_isAdmin || _isAccountManager)
        return null;

    if (_isSalesManager)
    {
        var allowed = Math.Max(preservedDiscount, salesManagerTotalCap);
        return requestedDiscountAmount > allowed
            ? $"هذا الخصم من صلاحية مدير الحسابات أو الأدمن. حد مدير المبيعات = الزيادة الحالية + {SalesManagerDiscountLimitPercent:N0}% من السعر الأساسي، بإجمالي {FormatMoney(salesManagerTotalCap)} ج."
            : null;
    }

    return requestedDiscountAmount <= salesManagerTotalCap
        ? $"هذا الخصم من صلاحية مدير المبيعات. البائع يخصم فقط من الزيادة الحالية ({FormatMoney(increaseCap)} ج)، وحد مدير المبيعات الإجمالي هو {FormatMoney(salesManagerTotalCap)} ج."
        : "هذا الخصم من صلاحية مدير الحسابات أو الأدمن.";
}

private bool TryApplyDiscountPermission(ref decimal requestedDiscountAmount, bool showWarning = false)
{
    requestedDiscountAmount = Math.Round(Math.Max(requestedDiscountAmount, 0m), 0);

    var message = GetDiscountPermissionMessage(requestedDiscountAmount);
    var maxDiscount = GetMaxDiscount();

    if (requestedDiscountAmount > maxDiscount)
        requestedDiscountAmount = maxDiscount;

    if (!string.IsNullOrWhiteSpace(message) && showWarning)
        Snackbar.Add(message, Severity.Warning);

    return string.IsNullOrWhiteSpace(message);
}

private string GetDiscountPermissionHint()
{
    var baseTotal = GetBaseTotal();
    var increaseCap = GetIncreaseDiscountCap();
    var salesManagerBaseCap = GetSalesManagerDiscountCap();
    var salesManagerTotalCap = Math.Min(_form.TotalAmount, increaseCap + salesManagerBaseCap);
    var preservedDiscount = Math.Min(Math.Max(_originalDiscountAmount, 0m), _form.TotalAmount);

    if (_isAdmin || _isAccountManager)
        return $"صلاحيتك الحالية: خصم الزيادة الحالية بالكامل ({FormatMoney(increaseCap)} ج) + خصم من الأساسي حتى {FormatMoney(baseTotal)} ج.";

    if (_isSalesManager)
    {
        if (preservedDiscount > salesManagerTotalCap)
            return $"الخصم الحالي محفوظ كما هو، لكن أي زيادة جديدة فوقه تحتاج مدير الحسابات أو الأدمن. حدك الطبيعي = الزيادة الحالية + {SalesManagerDiscountLimitPercent:N0}% من الأساسي = {FormatMoney(salesManagerTotalCap)} ج.";

        return $"صلاحيتك الحالية: خصم الزيادة الحالية بالكامل ({FormatMoney(increaseCap)} ج) + خصم من الأساسي حتى {FormatMoney(salesManagerBaseCap)} ج. الإجمالي المسموح = {FormatMoney(salesManagerTotalCap)} ج.";
    }

    return preservedDiscount > increaseCap
        ? "الخصم الحالي محفوظ كما هو، لكن أي زيادة جديدة فوقه تحتاج مدير المبيعات أو أعلى حسب القيمة."
        : $"صلاحيتك الحالية: خصم الزيادة الحالية فقط = {FormatMoney(increaseCap)} ج، ولا يمكن النزول تحت إجمالي السعر الأساسي ({FormatMoney(baseTotal)} ج).";
}

private static decimal RoundPriceToNearest100(decimal value)
{
    return Math.Round(value / 100m, 0, MidpointRounding.AwayFromZero) * 100m;
}

private static decimal RoundPriceUpTo100(decimal value)
{
    return Math.Ceiling(value / 100m) * 100m;
}

private decimal NormalizeSalePrice(QuotationItemDto item, decimal rawPrice)
{
    var basePrice = GetBaseSalePrice(item);
    var rounded = RoundPriceToNearest100(rawPrice);
    if (!_canOverrideBasePrice && rounded < basePrice)
        rounded = RoundPriceUpTo100(basePrice);
    return rounded;
}

/// <summary>
/// تكلفة الوحدة حسب الباقة المختارة.
/// Premium => PurchasePricePremium
/// Elite => PurchasePriceElite ولو مش موجودة يرجع Premium
/// </summary>
private decimal GetUnitCost(QuotationItemDto item)
{
    if (item.SelectedAlternativeId.HasValue)
    {
        return NormalizeTier(item.PricingTier) switch
        {
            var t when t == PricingTiers.CClass => item.AlternativePurchasePriceCClass ?? 0m,
            var t when t == PricingTiers.Elite => item.AlternativePurchasePriceElite ?? item.AlternativePurchasePricePremium ?? 0m,
            _ => item.AlternativePurchasePricePremium ?? 0m
        };
    }

    return NormalizeTier(item.PricingTier) switch
    {
        var t when t == PricingTiers.CClass => item.PurchasePriceCClass ?? 0m,
        var t when t == PricingTiers.Elite => item.PurchasePriceElite ?? item.PurchasePricePremium ?? 0m,
        _ => item.PurchasePricePremium ?? 0m
    };
}

/// <summary>
/// إجمالي تكلفة السطر = الكمية × تكلفة الوحدة.
/// </summary>
private decimal GetLineCost(QuotationItemDto item)
{
    return Math.Round(item.Quantity * GetUnitCost(item), 2);
}

/// <summary>
/// إجمالي تكلفة عرض السعر بالكامل.
/// </summary>
private decimal GetTotalCost()
{
    return Math.Round(_form.Items.Sum(GetLineCost), 2);
}

/// <summary>
/// الربح = إجمالي البيع بعد الخصم - إجمالي التكلفة.
/// </summary>
private decimal GetGrossProfit()
{
    return Math.Round(_form.GrandTotal - GetTotalCost(), 2);
}

/// <summary>
/// هامش الربح من البيع.
/// </summary>
//private decimal? GetProfitMarginPercentage()
//{
   // if (_form.GrandTotal <= 0) return null;

   // return Math.Round((GetGrossProfit() / _form.GrandTotal) * 100m, 2);
//}
private decimal? GetProfitMarginPercentage()
{
    var totalCost = GetTotalCost();

    if (totalCost <= 0) return null;

    return Math.Round((GetGrossProfit() / totalCost) * 100m, 2);
}
/// <summary>
/// عند تغيير سعر البيع يدويًا، يمنع أن يقل عن سعر البيع الأساسي من جدول المنتجات.
/// </summary>
private void OnUnitPriceChanged(QuotationItemDto item, decimal newPrice)
{
    var basePrice = GetBaseSalePrice(item);

    if (newPrice < basePrice)
    {
        item.UnitPrice = RoundPriceUpTo100(basePrice);

        Snackbar.Add(
            $"لا يمكن تقليل سعر البيع عن السعر الأساسي: {FormatMoney(basePrice)} ج",
            Severity.Warning);
    }
    else
    {
        item.UnitPrice = NormalizeSalePrice(item, newPrice);
    }

    RecalculateTotals();
}
/// <summary>
/// زيادة سعر منتج واحد بنسبة معينة على السعر الحالي داخل عرض السعر.
/// </summary>
private void IncreaseItemPrice(int index, decimal percentage)
{
    if (index < 0 || index >= _form.Items.Count) return;

    if (percentage <= 0)
    {
        Snackbar.Add("يرجى إدخال نسبة زيادة أكبر من صفر.", Severity.Warning);
        return;
    }

    var item = _form.Items[index];
    var basePrice = GetBaseSalePrice(item);

    // الزيادة تكون على السعر الحالي، ولو السعر الحالي أقل من الأساسي نبدأ من الأساسي
    var currentPrice = item.UnitPrice > 0 ? item.UnitPrice : basePrice;
    if (currentPrice < basePrice)
        currentPrice = basePrice;

    var newPrice = currentPrice + (currentPrice * percentage / 100m);

item.UnitPrice = NormalizeSalePrice(item, newPrice);

    RecalculateTotals();

    Snackbar.Add(
        $"تمت زيادة سعر '{item.ProductName}' بنسبة {percentage:N2}%",
        Severity.Success);
}
/// <summary>
/// زيادة أسعار كل المنتجات بنسبة معينة على الأسعار الحالية داخل عرض السعر.
/// </summary>
private void IncreaseAllPrices(decimal percentage)
{
    if (!_form.Items.Any())
    {
        Snackbar.Add("لا توجد منتجات في عرض السعر.", Severity.Warning);
        return;
    }

    if (percentage <= 0)
    {
        Snackbar.Add("يرجى إدخال نسبة زيادة أكبر من صفر.", Severity.Warning);
        return;
    }

    foreach (var item in _form.Items)
    {
        var basePrice = GetBaseSalePrice(item);

        var currentPrice = item.UnitPrice > 0 ? item.UnitPrice : basePrice;
        if (currentPrice < basePrice)
            currentPrice = basePrice;

        var newPrice = currentPrice + (currentPrice * percentage / 100m);

item.UnitPrice = NormalizeSalePrice(item, newPrice);
    }

    RecalculateTotals();

    Snackbar.Add(
        $"تمت زيادة أسعار كل المنتجات بنسبة {percentage:N2}%",
        Severity.Success);
}

    // ============================================================
    // Products (Cards)
