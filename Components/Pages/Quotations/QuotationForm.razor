                    <div class="summary-row total-row">
                        <span>الإجمالي النهائي:</span>
                        <strong>@FormatMoney(_form.GrandTotal) ج</strong>
                    </div>

                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3" Icon="@Icons.Material.Filled.Info">
                        <small>عرض السعر <strong>لا يؤثر على المخزون</strong>. يمكنك تحويله لفاتورة لاحقاً.</small>
                    </MudAlert>
                </MudPaper>
            </div>
        </div>
    </div>
}

<!-- ============= Discount Request Dialog ============= -->
<MudDialog @bind-Visible="_showDiscountRequestDialog" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <div style="display:flex; align-items:center; gap:0.5rem;">
            <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Color="Color.Warning" />
            <MudText Typo="Typo.h6">طلب خصم</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Info">
            سيتم إرسال طلب تفصيلي إلى مدير المبيعات ومدير الحسابات والأدمن للمراجعة.
        </MudAlert>

        <div class="discount-request-meta mb-3">
            <div><strong>العميل:</strong> @(_form.PartyName ?? "—")</div>
            <div><strong>المرجع:</strong> @(_form.ReferenceNumber ?? (IsEdit ? $"QT-{_form.QuotationDate.Year}-{_form.QuotationId:D5}" : "مسودة جديدة"))</div>
            <div><strong>الإجمالي الحالي:</strong> @FormatMoney(_form.GrandTotal) ج</div>
            <div><strong>حد صلاحيتك الحالي:</strong> @FormatMoney(GetMaxDiscount()) ج</div>
        </div>

        <div class="discount-tabs mb-3">
            <button type="button"
                    class="discount-tab @(_discountRequestByPercentage ? "active" : "")"
                    @onclick="@(() => _discountRequestByPercentage = true)">
                <MudIcon Icon="@Icons.Material.Filled.Percent" Size="Size.Small" />
                <span>بالنسبة</span>
            </button>
            <button type="button"
                    class="discount-tab @(!_discountRequestByPercentage ? "active" : "")"
                    @onclick="@(() => _discountRequestByPercentage = false)">
                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" />
                <span>بالقيمة</span>
            </button>
        </div>

        @if (_discountRequestByPercentage)
        {
            <MudNumericField @bind-Value="_discountRequestPercentage"
                             T="decimal?"
                             Label="نسبة الخصم المطلوبة"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="0m" Max="100m" Step="1m"
                             Adornment="Adornment.End" AdornmentText="%" />
        }
        else
        {
            <MudNumericField @bind-Value="_discountRequestAmount"
                             T="decimal?"
                             Label="قيمة الخصم المطلوبة"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="0m" Step="50m"
                             Adornment="Adornment.End" AdornmentText="ج" />
        }

        <MudTextField @bind-Value="_discountRequestReason"
                      Label="سبب طلب الخصم"
                      Placeholder="اكتب سبب الطلب أو ملاحظة مختصرة..."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Lines="3"
                      Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showDiscountRequestDialog = false)" Variant="Variant.Outlined">إلغاء</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled"
                   OnClick="SendDiscountRequestAsync" Disabled="@_isSendingDiscountRequest">
            @if (_isSendingDiscountRequest)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            إرسال الطلب
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- ============= Convert to Invoice Dialog ============= -->
<MudDialog @bind-Visible="_showConvertDialog">
    <TitleContent>
        <div style="display:flex; align-items:center; gap:0.5rem;">
            <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Success" />
            <MudText Typo="Typo.h6">تحويل عرض السعر لفاتورة</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Class="mb-3" Icon="@Icons.Material.Filled.Info">
            سيتم إنشاء <strong>فاتورة مبيعات</strong> + <strong>فاتورة مشتريات مرتبطة</strong> تلقائياً
        </MudAlert>

        <MudText Class="mb-3">
            <strong>العميل:</strong> @_form.PartyName <br />
            <strong>الإجمالي:</strong> <span style="color: var(--mud-palette-success); font-weight: 700;">@FormatMoney(_form.GrandTotal) ج</span>
        </MudText>

        <MudAlert Severity="Severity.Warning" Class="mb-3" Icon="@Icons.Material.Filled.Event">
            <div><strong>تنبيه مهم بخصوص التواريخ:</strong></div>
            <div>تاريخ صلاحية عرض السعر <strong>@(_form.ValidUntil?.ToString("yyyy/MM/dd") ?? "غير محدد")</strong> لن يتم نسخه إلى الفاتورة.</div>
            <div>سيتم حساب تاريخ الفاتورة من التاريخ الذي تختاره أدناه، ثم حساب تاريخ التسليم/الاستحقاق على أساس <strong>أكبر مدة تصنيع</strong> بين الأصناف.</div>
            <div>أكبر مدة تصنيع حالية: <strong>@_convertMaxPeriodDays يوم</strong></div>
            <div>تاريخ التسليم/الاستحقاق المتوقع: <strong>@(_convertCalculatedDueDate?.ToString("yyyy/MM/dd") ?? "-")</strong></div>
            <div style="margin-top:6px;">إذا أردت تعديل التاريخ، غيّر <strong>تاريخ الفاتورة</strong> قبل الضغط على تحويل.</div>
        </MudAlert>

        <MudDatePicker Date="_convertInvoiceDate"
                       DateChanged="OnConvertInvoiceDateChanged"
                       Label="تاريخ الفاتورة"
                       Variant="Variant.Outlined"
                       Class="mb-3" />

        <MudText Typo="Typo.body2" Class="mb-2" Style="font-weight:700;">الدفعات المقدمة المتاحة للعميل</MudText>

        @if (_convertAvailableAdvances.Any())
        {
            <div class="convert-advances-list mb-3">
                @foreach (var adv in _convertAvailableAdvances)
                {
                    <div class="convert-advance-item">
                        <MudCheckBox T="bool"
                                     Value="@_selectedAdvanceChargeIds.Contains(adv.ChargeId)"
                                     ValueChanged="@(v => ToggleAdvanceSelection(adv.ChargeId, v))"
                                     Color="Color.Success" />
                        <div class="convert-advance-body">
                            <strong>@(adv.ChargeDescription ?? "دفعة مقدمة")</strong>
                            <small>@(adv.CreatedAt?.ToString("yyyy/MM/dd") ?? "-")</small>
                        </div>
                        <div class="convert-advance-amount">@FormatMoney(adv.ChargeAmount) ج</div>
                    </div>
                }
            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">لا توجد دفعات مقدمة متاحة لهذا العميل.</MudAlert>
        }

        <MudPaper Class="convert-summary-box mb-3" Elevation="0">
            <div><strong>إجمالي عرض السعر:</strong> @FormatMoney(_form.GrandTotal) ج</div>
            <div><strong>الدفعات المقدمة المختارة:</strong> @FormatMoney(GetSelectedAdvanceTotal()) ج</div>
            <div><strong>المتبقي بعد الخصم:</strong> @FormatMoney(GetRemainingAfterAdvances(_form.GrandTotal)) ج</div>
        </MudPaper>

        <MudSwitch T="bool" @bind-Value="_convertGoToPayments"
                   Label="بعد التحويل افتح شاشة المدفوعات لو يوجد متبقي على الفاتورة"
                   Color="Color.Primary" Class="mb-1" />
        <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">
            سيتم تطبيق الدفعات المقدمة أولاً، ثم عند اختيار هذا الخيار سيتم فتح شاشة المدفوعات على الفاتورة الجديدة مباشرة.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showConvertDialog = false)" Variant="Variant.Outlined">إلغاء</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled"
                   OnClick="ExecuteConvert" Disabled="@_isConverting">
            @if (_isConverting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            تحويل
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- ============= WhatsApp Dialog ============= -->
<!-- ============= WhatsApp Dialog (Improved) ============= -->
<MudDialog @bind-Visible="_showWhatsAppDialog" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <div style="display:flex; align-items:center; gap:0.5rem;">
            <MudIcon Icon="@Icons.Material.Filled.Share" Style="color: #25D366;" />
            <MudText Typo="Typo.h6">مشاركة عرض السعر عبر واتساب</MudText>
        </div>
    </TitleContent>
    <DialogContent>

        <MudAlert Severity="Severity.Success" Class="mb-3" Dense="true" Icon="@Icons.Material.Filled.CheckCircle">
            <strong>الرسالة فيها رابط مباشر</strong> للعميل لعرض / تنزيل / طباعة العرض من المتصفح،
            بدون الحاجة لإرفاق ملفات يدوياً.
        </MudAlert>

        <!-- اختيار كود الدولة + الرقم -->
        <MudText Typo="Typo.body2" Class="mb-2" Style="font-weight:600;">رقم الواتساب:</MudText>
        <div class="d-flex gap-2 align-items-start mb-1">
            <MudSelect T="string" @bind-Value="_whatsappCountryCode"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       Style="max-width:170px;" Dense="true">
                @foreach (var c in PhoneNormalizer.Countries)
                {
                    <MudSelectItem T="string" Value="@c.Value.DialCode">
                        @c.Value.DisplayName (+@c.Value.DialCode)
                    </MudSelectItem>
                }
            </MudSelect>

            <MudTextField @bind-Value="_whatsappPhone"
                          Placeholder="01001234567"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Phone"
                          Style="flex:1;" />
        </div>

        @{
            var preview = GetPhonePreview();
        }
        @if (!string.IsNullOrEmpty(preview))
        {
            <MudText Typo="Typo.caption" Style="@(preview.StartsWith("✅") ? "color:green;" : "color:#d32f2f;")">
                @preview
            </MudText>
        }

        <!-- رابط المشاركة + زرار النسخ -->
        <MudText Typo="Typo.body2" Class="mt-3 mb-2" Style="font-weight:600;">رابط المشاركة:</MudText>
        <MudTextField @bind-Value="_shareLink" 
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      ReadOnly="true"
                      Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                      OnAdornmentClick="CopyShareLink"
                      AdornmentAriaLabel="نسخ الرابط" />

        <!-- الرسالة (قابلة للتعديل) -->
        <MudTextField @bind-Value="_whatsappMessage"
                      Label="نص الرسالة"
                      Variant="Variant.Outlined"
                      Lines="7"
                      Class="mt-3" />

    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showWhatsAppDialog = false)" Variant="Variant.Outlined">إلغاء</MudButton>

        <MudButton Variant="Variant.Outlined" Color="Color.Info"
                   StartIcon="@Icons.Material.Filled.OpenInNew"
                   OnClick="PreviewShareLink">
            معاينة الرابط
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Send"
                   OnClick="OpenWhatsApp"
                   Style="background: #25D366 !important; color: white !important;">
            إرسال واتساب
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- ============= Change Status Dialog ============= -->
<MudDialog @bind-Visible="_showStatusDialog">
    <TitleContent>
        <div style="display:flex; align-items:center; gap:0.5rem;">
            <MudIcon Icon="@Icons.Material.Filled.Flag" Color="Color.Primary" />
            <MudText Typo="Typo.h6">تغيير حالة عرض السعر</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Class="mb-3">
            <strong>الحالة الحالية:</strong>
            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(_form.Status)">
                @GetStatusText(_form.Status)
            </MudChip>
        </MudText>

        <MudSelect T="string" @bind-Value="_newStatus"
                   Label="الحالة الجديدة *"
                   Variant="Variant.Outlined">
            @foreach (var s in QuotationStatuses.All.Where(x => x.Key != QuotationStatuses.Converted && x.Key != QuotationStatuses.Expired))
            {
                <MudSelectItem T="string" Value="@s.Key">@s.Value</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showStatusDialog = false)" Variant="Variant.Outlined">إلغاء</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="ExecuteChangeStatus" Disabled="@_isChangingStatus">
            @if (_isChangingStatus)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            تغيير
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    /* ============================================ */
    /*  PAGE LAYOUT                                  */
    /* ============================================ */
    .quotation-form-page {
        padding: 1rem;
        max-width: 1800px;
        margin: 0 auto;
        direction: rtl;
    }

    /* ============================================ */
    /*  HEADER                                       */
    /* ============================================ */
    .form-header {
        background: linear-gradient(135deg, var(--gold), var(--gold-dark));
        border-radius: 16px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.5rem;
        color: white;
    }

    .header-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .header-left { display: flex; align-items: center; gap: 1rem; }
    .header-left h1 {
        margin: 0; font-size: 1.4rem; font-weight: 800;
        display: flex; align-items: center; gap: 0.5rem;
    }
    .header-left p { margin: 0; font-size: 0.85rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
    .header-right { display: flex; gap: 0.5rem; flex-wrap: wrap; }

    .save-btn {
        background: rgba(255,255,255,0.95) !important;
        color: var(--navy-dark) !important;
        font-weight: 700 !important;
    }

    /* Summary Pills */
    .header-summary {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        padding-top: 0.75rem;
        border-top: 1px solid rgba(255,255,255,0.25);
    }

    .summary-pill {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(4px);
        padding: 0.5rem 0.85rem;
        border-radius: 10px;
        flex: 1;
        min-width: 140px;
    }
    .summary-pill span { font-size: 0.72rem; opacity: 0.85; display: block; }
    .summary-pill strong { font-size: 0.88rem; display: block; }

    .pill-total { background: rgba(255,255,255,0.25); }
    .pill-opportunity { background: rgba(79,70,229,0.28); }
    .pill-warning { background: rgba(245,158,11,0.3); }
    .pill-overdue {
        background: rgba(239,68,68,0.4);
        animation: pulse-bg 2s infinite;
    }

    @@keyframes pulse-bg {
        0%, 100% { background: rgba(239,68,68,0.3); }
        50% { background: rgba(239,68,68,0.5); }
    }

    /* ============================================ */
    /*  GRID LAYOUT                                  */
    /* ============================================ */
    .form-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(300px, 22vw, 360px);
    gap: 1rem;
    align-items: start;
}

.main-col,
.sidebar-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
}

.sidebar-col {
    align-self: start;
}

    /* ============================================ */
    /*  SECTIONS                                     */
    /* ============================================ */
    .form-section {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-divider);
        border-radius: 14px;
        padding: 1.25rem;
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--mud-palette-divider);
    }
    .section-header h3 { margin: 0; font-size: 1.05rem; font-weight: 700; }

    .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
    }
    .quotation-meta-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.65rem;
    align-items: start;
}

.quotation-meta-grid .mud-input-control {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
}

@@media (max-width: 1300px) {
    .quotation-meta-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@@media (max-width: 700px) {
    .quotation-meta-grid {
        grid-template-columns: 1fr;
    }
}

    /* ============================================ */
    /*  PARTY                                        */
    /* ============================================ */
    .party-phone-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 0.85rem;
        background: var(--gold-subtle);
        border-radius: 8px;
        font-size: 0.88rem;
    }

    .opportunity-link-box {
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.08), rgba(79, 70, 229, 0.03));
        border: 1px solid rgba(99, 102, 241, 0.18);
        border-radius: 14px;
        padding: 1rem;
        box-shadow: 0 4px 14px rgba(79, 70, 229, 0.06);
    }

    .opportunity-link-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
        flex-wrap: wrap;
    }

    .opportunity-link-sub {
        color: var(--mud-palette-text-secondary);
        font-size: 0.78rem;
        margin-top: 0.2rem;
        line-height: 1.5;
    }

    .opportunity-link-actions {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
    }

    .opportunity-link-empty {
        margin-top: 0.5rem;
        color: var(--mud-palette-text-secondary);
        font-size: 0.78rem;
        background: rgba(255,255,255,0.55);
        border-radius: 8px;
        padding: 0.55rem 0.7rem;
    }

    .opportunity-link-summary {
        margin-top: 0.65rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex-wrap: wrap;
        font-size: 0.8rem;
        color: var(--mud-palette-text-primary);
        background: rgba(255,255,255,0.7);
        border-radius: 10px;
        padding: 0.6rem 0.8rem;
        border: 1px dashed rgba(99, 102, 241, 0.2);
    }

    .opportunity-preview-card {
        margin-top: 0.8rem;
        background: rgba(255,255,255,0.82);
        border: 1px solid rgba(99,102,241,0.16);
        border-radius: 12px;
        padding: 0.9rem;
    }

    .opportunity-preview-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 0.85rem;
    }

    .opportunity-preview-title-wrap {
        display: flex;
        gap: 0.7rem;
        align-items: flex-start;
    }

    .opportunity-preview-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: rgba(79,70,229,0.12);
        color: #4f46e5;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .opportunity-preview-title {
        font-size: 0.88rem;
        font-weight: 800;
        color: var(--mud-palette-text-primary);
        margin-bottom: 0.2rem;
    }

    .opportunity-preview-sub {
        font-size: 0.75rem;
        color: var(--mud-palette-text-secondary);
        line-height: 1.5;
    }

    .opportunity-preview-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.6rem;
    }

    .opp-preview-item {
        background: var(--mud-palette-background);
        border: 1px solid var(--mud-palette-divider);
        border-radius: 10px;
        padding: 0.65rem 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.18rem;
    }

    .opp-preview-label {
        font-size: 0.72rem;
        color: var(--mud-palette-text-secondary);
    }

    .opp-preview-item strong {
        font-size: 0.86rem;
        color: var(--mud-palette-text-primary);
    }

    .opportunity-preview-note {
        margin-top: 0.75rem;
        display: flex;
        align-items: flex-start;
        gap: 0.45rem;
        padding: 0.65rem 0.75rem;
        background: rgba(14,165,233,0.07);
        border: 1px dashed rgba(14,165,233,0.22);
        border-radius: 10px;
        font-size: 0.76rem;
        color: #475569;
        line-height: 1.55;
    }

    /* ============================================ */
    /*  PRODUCTS GRID                                */
    /* ============================================ */
    .empty-items {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        padding: 2rem;
        color: var(--mud-palette-text-secondary);
    }

    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 0.75rem;
        max-height: 400px;
        overflow-y: auto;
        padding: 0.25rem;
    }

    .product-card {
        background: var(--mud-palette-background);
        border: 1px solid var(--mud-palette-divider);
        border-radius: 10px;
        padding: 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        transition: all 0.2s ease;
    }
    .product-card:hover {
        border-color: var(--gold);
        box-shadow: 0 2px 8px rgba(212,175,55,0.15);
    }
