                                                               OnClick="@(() => AddProductWithTier(context, PricingTiers.CClass))"
                                                               Disabled="@IsTierAlreadyAdded(context.ProductId, PricingTiers.CClass)"
                                                               Class="tier-btn">C</MudButton>
                                                }
                                                @if (HasProductTier(context, PricingTiers.Premium))
                                                {
                                                    <MudButton Variant="@(IsTierAlreadyAdded(context.ProductId, PricingTiers.Premium) ? Variant.Outlined : Variant.Filled)"
                                                               Color="Color.Info" Size="Size.Small"
                                                               OnClick="@(() => AddProductWithTier(context, PricingTiers.Premium))"
                                                               Disabled="@IsTierAlreadyAdded(context.ProductId, PricingTiers.Premium)"
                                                               Class="tier-btn">P</MudButton>
                                                }
                                                @if (HasProductTier(context, PricingTiers.Elite))
                                                {
                                                    <MudButton Variant="@(IsTierAlreadyAdded(context.ProductId, PricingTiers.Elite) ? Variant.Outlined : Variant.Filled)"
                                                               Color="Color.Warning" Size="Size.Small"
                                                               OnClick="@(() => AddProductWithTier(context, PricingTiers.Elite))"
                                                               Disabled="@IsTierAlreadyAdded(context.ProductId, PricingTiers.Elite)"
                                                               Class="tier-btn">E</MudButton>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            var defaultTier = GetDefaultTierForAdd();
                                            var canAddByDefault = HasProductTier(context, defaultTier);
                                            var alreadyAddedByDefault = IsTierAlreadyAdded(context.ProductId, defaultTier);
                                            <MudButton Variant="@(alreadyAddedByDefault ? Variant.Outlined : Variant.Filled)"
