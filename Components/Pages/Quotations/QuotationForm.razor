    color: var(--mud-palette-text-primary);
}

.price-adjust-title strong {
    display: block;
    font-size: 0.95rem;
    font-weight: 800;
}

.price-adjust-title span {
    display: block;
    font-size: 0.76rem;
    color: var(--mud-palette-text-secondary);
    margin-top: 0.15rem;
}

.price-adjust-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
}

.price-increase-field {
    width: 150px;
}

@@media (max-width: 700px) {
    .price-adjust-toolbar {
        flex-direction: column;
        align-items: stretch;
    }

    .price-adjust-actions {
