                                                       OnClick="@(() => AddProductWithTier(context, defaultTier))"
                                                       Disabled="@(!canAddByDefault || alreadyAddedByDefault)">
                                                @(alreadyAddedByDefault ? "مضاف" : GetTierLabel(defaultTier))
                                            </MudButton>
                                        }
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
