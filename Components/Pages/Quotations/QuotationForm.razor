                       $"📋 عرض سعر رقم: {_form.ReferenceNumber}\n" +
                       $"📅 التاريخ: {_form.QuotationDate:yyyy/MM/dd}\n" +
                       $"🏷️ نوع الباقة: {GetPricingModeLabel(_form.PricingType)}{(_form.PricingType == QuotationPricingModes.Mixed ? " (حسب بنود العرض)" : "")}\n" +
                       $"💰 الإجمالي: {FormatMoney(_form.GrandTotal)} ج\n\n" +
                       $"👇 لعرض / تحميل / طباعة عرض السعر، اضغط الرابط:\n" +
                       $"{_shareLink}\n\n" +
                       $"شركة COCOBOLO";

    _showWhatsAppDialog = true;
}

