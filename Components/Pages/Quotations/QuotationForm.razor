                                                    @if (hasCClass)
                                                    {
                                                        <MudButton Variant="@(addedCClass ? Variant.Outlined : Variant.Filled)"
                                                                   Color="Color.Secondary"
                                                                   Size="Size.Small"
                                                                   StartIcon="@(addedCClass ? Icons.Material.Filled.Check : Icons.Material.Filled.Add)"
                                                                   OnClick="@(() => AddProductWithTier(prod, PricingTiers.CClass))"
                                                                   Disabled="@addedCClass"
                                                                   Class="tier-btn">
                                                            @(addedCClass ? "مضاف" : "C Class")
                                                        </MudButton>
                                                    }

                                                    @if (hasPremium)
                                                    {
                                                        <MudButton Variant="@(addedPremium ? Variant.Outlined : Variant.Filled)"
                                                                   Color="Color.Info"
                                                                   Size="Size.Small"
                                                                   StartIcon="@(addedPremium ? Icons.Material.Filled.Check : Icons.Material.Filled.Add)"
                                                                   OnClick="@(() => AddProductWithTier(prod, PricingTiers.Premium))"
                                                                   Disabled="@addedPremium"
                                                                   Class="tier-btn">
                                                            @(addedPremium ? "مضاف" : "Premium")
                                                        </MudButton>
                                                    }

                                                    @if (hasElite)
