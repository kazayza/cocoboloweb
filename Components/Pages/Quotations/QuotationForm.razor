                                                <MudButton Variant="@(alreadyAddedByDefault ? Variant.Outlined : Variant.Filled)"
                                                           Color="@GetTierButtonColor(defaultTier)"
                                                           Size="Size.Small"
                                                           StartIcon="@(alreadyAddedByDefault ? Icons.Material.Filled.Check : Icons.Material.Filled.Add)"
                                                           OnClick="@(() => AddProductWithTier(prod, defaultTier))"
