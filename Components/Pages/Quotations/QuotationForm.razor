   /* ============================================ */
/*  ITEMS TABLE - CLEAN COMPACT VERSION          */
/* ============================================ */

.items-table {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
}

/* بدون تكلفة */
.items-header,
.item-row {
    display: grid;
    grid-template-columns:
        68px
        minmax(250px, 1.15fr)
        88px
        64px
        minmax(230px, 1.1fr)
        120px
        42px;
    gap: 0.45rem;
    align-items: center;
    min-width: 900px;
}

/* مع عمود التكلفة */
.items-table.with-cost .items-header,
.items-table.with-cost .item-row {
    grid-template-columns:
        68px
        minmax(250px, 1.05fr)
        86px
        64px
        minmax(235px, 1.05fr)
        118px
        118px
        42px;
    min-width: 1020px;
}

.items-header {
    padding: 0.55rem 0.6rem;
    background: var(--mud-palette-background);
    border-radius: 10px;
    font-weight: 800;
    font-size: 0.82rem;
    color: var(--mud-palette-text-primary);
}

.item-row {
    padding: 0.45rem 0.6rem;
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 10px;
    background: var(--mud-palette-surface);
    min-height: 74px;
}

.items-header > div,
.item-row > div {
    min-width: 0;
    display: flex;
    align-items: center;
}

.items-header > div:not(.col-product),
.item-row > div:not(.col-product) {
    justify-content: center;
    text-align: center;
}

.col-product {
    justify-content: flex-start;
    text-align: right;
    overflow: hidden;
    flex-direction: column;
    align-items: flex-start !important;
}

.col-product strong {
    display: block;
    max-width: 100%;
    font-size: 0.86rem;
    font-weight: 800;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

 .item-name-display {
    font-size: 0.7rem;
    color: var(--mud-palette-text-secondary);
    margin-top: 0.15rem;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.item-alt-wrap {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
    margin-top: 0.3rem;
}

.item-alt-wrap.compact {
    border-top: 1px dashed rgba(148,163,184,0.18);
    padding-top: 0.35rem;
}

.item-alt-headline {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
}

.item-alt-caption {
    font-size: 0.68rem;
    font-weight: 800;
    color: #64748b;
}

.item-alt-select {
    width: 100%;
}

.item-alt-select .mud-input-control {
    width: 100%;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
}

.item-alt-select .mud-input-root {
    min-height: 36px !important;
}

.item-alt-select.compact-select {
    max-width: 100%;
}

.item-alt-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 800;
}

.item-alt-badge.base {
    background: rgba(100,116,139,0.12);
    color: #475569;
}

.item-alt-badge.selected {
    background: rgba(16,185,129,0.12);
    color: #047857;
}

.item-alt-summary {
    margin-top: 0.08rem;
    font-size: 0.68rem;
    color: #64748b;
    line-height: 1.45;
    white-space: normal;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* الصورة */
.item-thumb {
    width: 58px;
    height: 58px;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid var(--mud-palette-divider);
}

.item-thumb-placeholder {
    width: 58px;
    height: 58px;
    background: var(--mud-palette-background);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.55rem;
}

/* الحقول */
.table-input,
.col-tier .mud-input-control,
.col-qty .mud-input-control,
.col-price .mud-input-control {
    width: 100%;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
}

.item-row .mud-input-root {
    min-height: 38px !important;
}

.item-row input {
    text-align: center !important;
    font-weight: 700;
}

/* خلية السعر */
.price-cell {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) 58px 26px;
    grid-template-rows: 38px;
    gap: 0.35rem;
    align-items: center;
}

.price-cell.readonly {
    grid-template-columns: minmax(0, 1fr) 26px;
}

.price-cell .mud-input-control {
    grid-column: 1;
    grid-row: 1;
}

.increase-item-btn {
    grid-column: 2;
    grid-row: 1;
    width: 58px;
    min-width: 58px !important;
    height: 38px;
    margin: 0 !important;
    padding: 0 !important;
    font-size: 0.72rem !important;
    font-weight: 800 !important;
    border-radius: 10px !important;
}

.base-price-info {
    grid-column: 3;
    grid-row: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #64748b;
    cursor: help;
}

.price-cell.readonly .base-price-info {
    grid-column: 2;
}

/* لو لسه موجود في الـ HTML من نسخة قديمة */
.base-price-hint {
    display: none !important;
}

/* خلية التكلفة */
.cost-cell {
    display: flex !important;
    flex-direction: column;
    justify-content: center !important;
    align-items: center !important;
    gap: 0.12rem;
    background: rgba(180, 83, 9, 0.055);
    border: 1px solid rgba(180, 83, 9, 0.14);
    border-radius: 10px;
    padding: 0.3rem 0.4rem;
    color: #b45309;
    min-height: 48px;
}

.cost-cell strong {
    font-size: 0.82rem;
    font-weight: 900;
    white-space: nowrap;
}

.cost-cell span {
    font-size: 0.63rem;
    color: #64748b;
    white-space: nowrap;
}

/* الإجمالي */
.total-cell {
    justify-content: center !important;
}

.total-cell strong {
    color: #047857;
    font-size: 0.88rem;
    font-weight: 900;
    white-space: nowrap;
}

.col-action {
    justify-content: center !important;
}

/* ============================================ */
/*  PRICE ADJUST TOOLS                           */
/* ============================================ */
.price-adjust-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: linear-gradient(135deg, rgba(16,185,129,0.09), rgba(59,130,246,0.07));
    border: 1px solid rgba(16,185,129,0.22);
    border-radius: 12px;
    padding: 0.85rem 1rem;
    margin: 1rem 0 0.75rem;
}

.price-adjust-title {
    display: flex;
