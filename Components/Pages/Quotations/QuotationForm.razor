    private void AddProductToQuotation(ProductLookupDto product)
    {
        var targetTier = IsMixedPricingMode ? PricingTiers.Premium : GetDefaultTierForAdd();
        AddProductWithTier(product, targetTier);
    }

    /// <summary>
    /// ✅ إضافة منتج بتسعير محدد (CClass / Premium / Elite).
    /// لو الباقة غير متاحة للمنتج → نوقف الإضافة ونوضح السبب.
    /// ولو المنتج مضاف بنفس الباقة → نزود كميته.
    /// </summary>
    private void AddProductWithTier(ProductLookupDto product, string tier)
    {
        if (product is null) return;

        var effectiveTier = NormalizeTier(tier);

        if (!HasProductTier(product, effectiveTier))
        {
            Snackbar.Add($"المنتج '{product.ProductName}' لا يملك سعر {GetTierLabel(effectiveTier)}.", Severity.Warning);
            return;
        }

        var existing = _form.Items.FirstOrDefault(i =>
            i.ProductId == product.ProductId && i.PricingTier == effectiveTier);

        if (existing != null)
        {
            existing.Quantity += 1;
            RecalculateTotals();
            SyncPricingTypeFromItems();
            Snackbar.Add($"تم زيادة الكمية للمنتج '{product.ProductName}' ({GetTierLabel(effectiveTier)}).", Severity.Success);
            return;
        }

        var newItem = new QuotationItemDto
        {
            ProductId = product.ProductId,
            ProductName = product.ProductName,
            ProductDescription = product.ProductDescription,
            Quantity = 1,
            PricingTier = effectiveTier,
            SalePriceCClass = product.SuggestedSalePriceCClass,
            SalePricePremium = product.SuggestedSalePrice,
            SalePriceElite = product.SuggestedSalePriceElite,
            PurchasePriceCClass = product.PurchasePriceCClass,
            PurchasePricePremium = product.PurchasePrice,
            PurchasePriceElite = product.PurchasePriceElite,
            Period = product.Period
        };

        newItem.UnitPrice = GetPriceByTier(newItem, effectiveTier);
        _form.Items.Add(newItem);
        RecalculateTotals();
        SyncPricingTypeFromItems();
    }

    private void RemoveItem(int index)
    {
        if (index < 0 || index >= _form.Items.Count) return;
        _form.Items.RemoveAt(index);
        RecalculateTotals();
        SyncPricingTypeFromItems();
    }

    // ============================================================
    // ✅ Calculations - بدون لمس الخصم (الخصم ليه handlers خاصة)
    // ============================================================
    /// <summary>إعادة حساب الإجماليات بعد تعديل الأصناف</summary>
private void RecalculateTotals()
{
    _form.TotalAmount = Math.Round(_form.Items.Sum(i => i.TotalAmount), 2);

    if (_discountByPercentage)
    {
        if (_form.DiscountPercentage.HasValue && _form.DiscountPercentage.Value > 0)
        {
            var requestedDiscount = Math.Round((_form.TotalAmount * (_form.DiscountPercentage.Value / 100m)) / 100m, 0) * 100m;
            TryApplyDiscountPermission(ref requestedDiscount);
            _form.DiscountAmount = requestedDiscount;
        }
        else
        {
            _form.DiscountAmount = 0;
        }
    }
    else
    {
        var requestedDiscount = _form.DiscountAmount ?? 0m;
        requestedDiscount = Math.Round(requestedDiscount / 100m, 0) * 100m;
        TryApplyDiscountPermission(ref requestedDiscount);
        _form.DiscountAmount = requestedDiscount;
    }

    _form.DiscountPercentage = _form.TotalAmount > 0
        ? Math.Round(((_form.DiscountAmount ?? 0m) / _form.TotalAmount) * 100, 2)
        : 0;

    _form.NetTotalAmount = _form.TotalAmount - (_form.DiscountAmount ?? 0);
    _form.GrandTotal = _form.NetTotalAmount ?? 0;

    StateHasChanged();
}

    // ============================================================
    // ✅ معالجات الخصم المرن
    // ============================================================
    /// <summary>المستخدم غيّر نسبة الخصم → احسب القيمة منها</summary>
    /// <summary>المستخدم غيّر نسبة الخصم</summary>
private void OnDiscountPercentageChanged(decimal? newPercentage)
{
    _discountByPercentage = true;
    _form.DiscountPercentage = newPercentage;

    if (newPercentage.HasValue && newPercentage.Value > 0)
    {
        var rawAmount = _form.TotalAmount * (newPercentage.Value / 100m);
        var requestedDiscount = Math.Round(rawAmount / 100m, 0) * 100m;
        TryApplyDiscountPermission(ref requestedDiscount, showWarning: true);
        _form.DiscountAmount = requestedDiscount;
    }
    else
    {
        _form.DiscountAmount = 0;
    }

    _form.DiscountPercentage = _form.TotalAmount > 0
        ? Math.Round(((_form.DiscountAmount ?? 0m) / _form.TotalAmount) * 100, 2)
        : 0;

    UpdateGrandTotal();
}

/// <summary>المستخدم غيّر قيمة الخصم</summary>
private void OnDiscountAmountChanged(decimal? newAmount)
{
    _discountByPercentage = false;

    var requestedDiscount = newAmount.HasValue
        ? Math.Round(newAmount.Value / 100m, 0) * 100m
        : 0m;
    TryApplyDiscountPermission(ref requestedDiscount, showWarning: true);
    _form.DiscountAmount = requestedDiscount;

    _form.DiscountPercentage = _form.TotalAmount > 0
        ? Math.Round((requestedDiscount / _form.TotalAmount) * 100, 2)
        : 0;

    UpdateGrandTotal();
}

/// <summary>إلغاء الخصم تمامًا</summary>
private void ClearDiscount()
{
    _form.DiscountAmount = 0;
    _form.DiscountPercentage = 0;
    _discountByPercentage = true;  // reset
    UpdateGrandTotal();
}

/// <summary>تحديث الإجمالي النهائي</summary>
private void UpdateGrandTotal()
{
    var requestedDiscount = _form.DiscountAmount ?? 0m;
    TryApplyDiscountPermission(ref requestedDiscount);
    _form.DiscountAmount = requestedDiscount;
    _form.DiscountPercentage = _form.TotalAmount > 0
        ? Math.Round((requestedDiscount / _form.TotalAmount) * 100, 2)
        : 0;
    _form.NetTotalAmount = _form.TotalAmount - requestedDiscount;
    _form.GrandTotal = _form.NetTotalAmount ?? 0;
    StateHasChanged();
}

    private string FormatMoney(decimal v) => $"{v:N2}";

    private void OpenDiscountRequestDialog()
    {
        _discountRequestByPercentage = _discountByPercentage;
        _discountRequestAmount = _form.DiscountAmount;
        _discountRequestPercentage = _form.DiscountPercentage;
        _discountRequestReason = "";
        _showDiscountRequestDialog = true;
    }

    private async Task SendDiscountRequestAsync()
    {
        if (_isSendingDiscountRequest) return;

        if (_form.PartyId is null or 0)
        {
            Snackbar.Add("اختر العميل أولاً قبل إرسال طلب الخصم.", Severity.Warning);
            return;
        }

        decimal? requestedAmount = null;
        decimal? requestedPercentage = null;

        if (_discountRequestByPercentage)
        {
            if (!_discountRequestPercentage.HasValue || _discountRequestPercentage.Value <= 0)
            {
                Snackbar.Add("أدخل نسبة الخصم المطلوبة أولاً.", Severity.Warning);
                return;
            }

            requestedPercentage = Math.Round(_discountRequestPercentage.Value, 2);
            requestedAmount = _form.TotalAmount > 0
                ? Math.Round((_form.TotalAmount * (requestedPercentage.Value / 100m)) / 100m, 0) * 100m
                : 0m;
        }
        else
        {
            if (!_discountRequestAmount.HasValue || _discountRequestAmount.Value <= 0)
            {
                Snackbar.Add("أدخل قيمة الخصم المطلوبة أولاً.", Severity.Warning);
                return;
            }

            requestedAmount = Math.Round(_discountRequestAmount.Value, 0);
            requestedPercentage = _form.TotalAmount > 0
                ? Math.Round((requestedAmount.Value / _form.TotalAmount) * 100m, 2)
                : 0m;
        }

        if (requestedAmount.GetValueOrDefault() <= GetMaxDiscount())
        {
            Snackbar.Add("الخصم المطلوب داخل صلاحيتك الحالية ويمكنك تطبيقه مباشرة بدون إرسال طلب.", Severity.Info);
            return;
        }

        if (string.IsNullOrWhiteSpace(_discountRequestReason))
        {
            Snackbar.Add("اكتب سبب طلب الخصم حتى تصل الرسالة بشكل واضح للمراجعين.", Severity.Warning);
            return;
        }

        _isSendingDiscountRequest = true;
        try
        {
            var request = new QuotationDiscountRequestDto
            {
                QuotationId = IsEdit ? _form.QuotationId : null,
                ReferenceNumber = _form.ReferenceNumber,
                PartyId = _form.PartyId,
                PartyName = _form.PartyName,
                EmpId = _form.EmpId,
                EmpName = _form.EmpName,
                TotalAmount = _form.TotalAmount,
                GrandTotal = _form.GrandTotal,
                CurrentDiscountAmount = _form.DiscountAmount ?? 0m,
                CurrentDiscountPercentage = _form.DiscountPercentage ?? 0m,
                RequestedDiscountAmount = requestedAmount,
                RequestedDiscountPercentage = requestedPercentage,
                Reason = _discountRequestReason.Trim()
            };

            var (ok, msg) = await QuotationService.SendDiscountRequestAsync(request, _currentUserName!);
            Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);

            if (ok)
                _showDiscountRequestDialog = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"تعذّر إرسال طلب الخصم: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSendingDiscountRequest = false;
        }
    }

    // ============================================================
    // Save
    // ============================================================
    private async Task SaveQuotation()
    {
        if (_isSaving) return;

        if (_form.PartyId is null or 0)
        {
            Snackbar.Add("يرجى اختيار العميل", Severity.Warning);
            return;
        }
        if (!_form.Items.Any())
        {
            Snackbar.Add("يجب إضافة صنف واحد على الأقل", Severity.Warning);
            return;
        }
        if (_form.Items.Any(i => i.Quantity <= 0))
        {
            Snackbar.Add("يجب أن تكون الكمية أكبر من صفر لكل صنف", Severity.Warning);
            return;
        }
        if (_form.Items.Any(i => i.UnitPrice < 0))
        {
            Snackbar.Add("السعر لا يمكن أن يكون سالباً", Severity.Warning);
            return;
        }
        if (_form.ValidUntil.HasValue && _form.ValidUntil.Value.Date < _form.QuotationDate.Date)
        {
            Snackbar.Add("تاريخ انتهاء الصلاحية يجب أن يكون بعد تاريخ العرض", Severity.Warning);
            return;
        }

        SyncPricingTypeFromItems();
        RecalculateTotals();

        var currentDiscountMessage = GetDiscountPermissionMessage(_form.DiscountAmount ?? 0m);
        if (!string.IsNullOrWhiteSpace(currentDiscountMessage))
        {
            Snackbar.Add(currentDiscountMessage, Severity.Warning);
            return;
        }

        _isSaving = true;

        try
        {
            if (IsEdit)
            {
                var (ok, msg) = await QuotationService.UpdateQuotationAsync(_form, _currentUserName!);
                Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);
                if (ok)
                {
                    // أعد القراءة عشان الـ IDs الجديدة بتاعة الـ Items
                    var refreshed = await QuotationService.GetQuotationForEditAsync(_form.QuotationId);
                    if (refreshed != null)
                    {
                        _form = refreshed;
                        _originalDiscountAmount = _form.DiscountAmount ?? 0m;
                    }
                }
            }
            else
            {
                var (ok, msg, id) = await QuotationService.CreateQuotationAsync(_form, _currentUserName!);
                Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);
                if (ok)
                    _originalDiscountAmount = _form.DiscountAmount ?? 0m;
                if (ok && id.HasValue)
                    Navigation.NavigateTo($"/quotations/{id.Value}");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"تعذّر الحفظ: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    // ============================================================
    // Convert to Invoice
    // ============================================================
    private async Task OpenConvertDialog()
    {
        if (_form.IsConverted)
        {
            Snackbar.Add("هذا العرض تم تحويله لفاتورة بالفعل.", Severity.Warning);
            return;
        }

        _convertInvoiceDate = DateTime.Today;
        _convertMaxPeriodDays = _form.Items
            .Where(i => i.Period.HasValue)
            .Select(i => i.Period!.Value)
            .DefaultIfEmpty(0)
            .Max();
        _convertGoToPayments = false;
        _convertAvailableAdvances = _form.PartyId.HasValue
            ? await InvoiceService.GetCustomerAdvancesAsync(_form.PartyId.Value, unappliedOnly: true) ?? new List<CustomerAdvanceDto>()
            : new List<CustomerAdvanceDto>();
        _selectedAdvanceChargeIds = new();
        RecalculateConvertDatesPreview();
        _showConvertDialog = true;
    }

    private Task OnConvertInvoiceDateChanged(DateTime? date)
    {
        _convertInvoiceDate = date ?? DateTime.Today;
        RecalculateConvertDatesPreview();
        return Task.CompletedTask;
    }

    private void RecalculateConvertDatesPreview()
    {
        var invoiceDate = (_convertInvoiceDate ?? DateTime.Today).Date;
        _convertCalculatedDueDate = invoiceDate.AddDays(_convertMaxPeriodDays);
    }

    private void ToggleAdvanceSelection(int chargeId, bool selected)
    {
        if (selected)
            _selectedAdvanceChargeIds.Add(chargeId);
        else
            _selectedAdvanceChargeIds.Remove(chargeId);
    }

    private decimal GetSelectedAdvanceTotal()
        => _convertAvailableAdvances
            .Where(a => _selectedAdvanceChargeIds.Contains(a.ChargeId))
            .Sum(a => a.ChargeAmount);

    private decimal GetRemainingAfterAdvances(decimal total)
        => Math.Max(0m, total - GetSelectedAdvanceTotal());

    private async Task ExecuteConvert()
    {
        if (_isConverting) return;

        if (GetSelectedAdvanceTotal() > _form.GrandTotal)
        {
            Snackbar.Add("إجمالي الدفعات المقدمة المختارة أكبر من إجمالي عرض السعر.", Severity.Warning);
            return;
        }

        _isConverting = true;
        try
        {
            var (ok, msg, invId) = await QuotationService.ConvertToInvoiceAsync(
                _form.QuotationId, _selectedAdvanceChargeIds.ToList(), _currentUserName!, _convertInvoiceDate);

            Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);

            if (ok && invId.HasValue)
            {
                _showConvertDialog = false;
                var remainingAfterAdvances = Math.Max(0m, _form.GrandTotal - GetSelectedAdvanceTotal());
                if (_convertGoToPayments && remainingAfterAdvances > 0)
                    Navigation.NavigateTo($"/payments/new?type=Sale&invoice={invId.Value}");
                else
                    Navigation.NavigateTo($"/sales/invoices/{invId.Value}");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"تعذّر التحويل: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isConverting = false;
        }
    }

