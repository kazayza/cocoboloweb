    private async Task<int?> ResolveCurrentEmployeeIdAsync(db24804Context db)
    {
        if (_currentUserId.HasValue)
        {
            var byUserId = await db.Users.AsNoTracking()
                .Where(u => u.UserId == _currentUserId.Value && u.EmployeeId != null)
                .Select(u => u.EmployeeId)
                .FirstOrDefaultAsync();

            if (byUserId.HasValue)
                return byUserId;
        }

        var normalizedUserName = (_currentUserName ?? string.Empty).Trim();
        if (!string.IsNullOrWhiteSpace(normalizedUserName))
        {
            var byUserName = await db.Users.AsNoTracking()
                .Where(u => u.EmployeeId != null && u.Username.Trim() == normalizedUserName)
                .Select(u => u.EmployeeId)
                .FirstOrDefaultAsync();

            if (byUserName.HasValue)
                return byUserName;
        }

        return null;
    }

