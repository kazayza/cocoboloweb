                new("تم الإرسال",    await db.Quotations.AsNoTracking().CountAsync(q => q.Status == QuotationStatuses.Sent),      QuotationStatuses.Sent,      GetQuoteStatusColor(QuotationStatuses.Sent)),
                new("مقبول",         await db.Quotations.AsNoTracking().CountAsync(q => q.Status == QuotationStatuses.Accepted),  QuotationStatuses.Accepted,  GetQuoteStatusColor(QuotationStatuses.Accepted)),
                new("مرفوض",         await db.Quotations.AsNoTracking().CountAsync(q => q.Status == QuotationStatuses.Rejected),  QuotationStatuses.Rejected,  GetQuoteStatusColor(QuotationStatuses.Rejected)),
                new("محوّل لفاتورة", await db.Quotations.AsNoTracking().CountAsync(q => q.Status == QuotationStatuses.Converted), QuotationStatuses.Converted, GetQuoteStatusColor(QuotationStatuses.Converted)),
                new("منتهي",         await db.Quotations.AsNoTracking().CountAsync(q => q.Status == QuotationStatuses.Expired),   QuotationStatuses.Expired,   GetQuoteStatusColor(QuotationStatuses.Expired)),
