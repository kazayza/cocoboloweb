        if (string.IsNullOrWhiteSpace(text))
            return task.IsLeadTask ? "متابعة ليد مستحقة" : "متابعة عميل مستحقة";

        return text.Length > 70 ? text[..70] + "..." : text;
    }

    private string GetCrmFollowupClass(TaskListDto task)
    {
        var due = task.DueDate.Date;
        if (due < DateTime.Today) return "overdue";
        if (due == DateTime.Today) return "today";
        return "upcoming";
    }

    private string GetCrmDueBadgeClass(TaskListDto task) => GetCrmFollowupClass(task);

    private string GetCrmDueBadgeText(TaskListDto task)
    {
        var due = task.DueDate.Date;
        if (due < DateTime.Today)
        {
            var days = (DateTime.Today - due).Days;
            return days <= 1 ? "متأخر" : $"متأخر {days} يوم";
        }

        if (due == DateTime.Today) return "اليوم";
        if (due == DateTime.Today.AddDays(1)) return "غدًا";
        return task.DueDate.ToString("dd/MM");
    }

    private string GetCrmDueTimeText(TaskListDto task)
    {
        if (task.DueTime.HasValue)
            return task.DueTime.Value.ToString("HH\\:mm");

        return task.DueDate.ToString("dd/MM/yyyy");
    }

    private int GetAttentionCount(string severity) => _attentionItems.Count(i => i.Severity == severity);

    private IEnumerable<AttentionItem> GetVisibleAttentionItems() => _attentionItems.Take(6);

    private static int GetSeverityRank(string severity) => severity switch
    {
        "high" => 3,
        "medium" => 2,
        _ => 1
    };

    private static string TimeAgo(DateTime dt)
    {
        var span = DateTime.Now - dt;
        if (span.TotalSeconds < 60) return "الآن";
        if (span.TotalMinutes < 60) return $"منذ {(int)span.TotalMinutes} دقيقة";
        if (span.TotalHours   < 24) return $"منذ {(int)span.TotalHours} ساعة";
        if (span.TotalDays    < 7)  return $"منذ {(int)span.TotalDays} يوم";
        return dt.ToString("dd/MM/yyyy");
    }

    private async Task SetChartPeriod(int days)
    {
        if (_chartPeriod == days && _salesChart.Any())
            return;

        _isChartLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            _chartPeriod = days;
            await LoadChartData();
            try { await JS.InvokeVoidAsync("localStorage.setItem", ChartPeriodStorageKey, days.ToString()); } catch { }
        }
        finally
        {
            _isChartLoading = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private static string GetStatClass(string val) =>
        val.Length >= 7 ? "val-sm" : val.Length >= 5 ? "val-md" : "val-num";

