    private async Task LoadChartData()
    {
        if (!_p.ViewSales) return;
        try
        {
            using var db  = await DbFactory.CreateDbContextAsync();
            var days      = _chartPeriod;
            var start     = DateTime.Today.AddDays(-(days - 1));

            // تحديد التجميع: ساعي لليوم، يومي للأسبوع والشهر، أسبوعي لـ 3 شهور، شهري للسنة
            bool groupByHour  = days <= 1;
            bool groupByMonth = days >= 365;
            bool groupByWeek  = days >= 90 && !groupByMonth;

            var sales = await db.Transactions.AsNoTracking()
                .Where(t => t.TransactionType == "Sale" && t.TransactionDate >= start)
                .Select(t => new { At = t.TransactionDate, t.GrandTotal })
                .ToListAsync();

            var expenses = _p.ViewExpenses
                ? await db.Expenses.AsNoTracking()
                    .Where(e => e.ExpenseDate >= start)
                    .Select(e => new { At = e.ExpenseDate, e.Amount })
                    .ToListAsync()
                : new();

            if (groupByHour)
            {
                var baseDay = DateTime.Today;
                _salesChart = Enumerable.Range(0, 24).Select(i =>
                {
                    var fromHour = baseDay.AddHours(i);
                    var toHour = fromHour.AddHours(1);
                    var amt = sales.Where(t => t.At >= fromHour && t.At < toHour).Sum(t => t.GrandTotal);
                    return new DayData(fromHour.ToString("HH:mm"), amt);
                }).ToList();

                _expensesChart = Enumerable.Range(0, 24).Select(i =>
                {
                    var fromHour = baseDay.AddHours(i);
                    var toHour = fromHour.AddHours(1);
                    var amt = expenses.Where(e => e.At >= fromHour && e.At < toHour).Sum(e => e.Amount);
                    return new DayData(fromHour.ToString("HH:mm"), amt);
                }).ToList();
            }
            else if (groupByMonth)
            {
                // تجميع شهري
                _salesChart = Enumerable.Range(0, 12).Select(i =>
                {
                    var d   = start.AddMonths(i);
                    if (d > DateTime.Today) return null;
                    var amt = sales.Where(t => t.At.Year == d.Year && t.At.Month == d.Month).Sum(t => t.GrandTotal);
                    return new DayData(d.ToString("MM/yy"), amt);
                }).Where(x => x != null).Select(x => x!).ToList();

                _expensesChart = Enumerable.Range(0, 12).Select(i =>
                {
                    var d   = start.AddMonths(i);
                    if (d > DateTime.Today) return null;
                    var amt = expenses.Where(e => e.At.Year == d.Year && e.At.Month == d.Month).Sum(e => e.Amount);
                    return new DayData(d.ToString("MM/yy"), amt);
                }).Where(x => x != null).Select(x => x!).ToList();
            }
            else if (groupByWeek)
            {
                // تجميع أسبوعي
                int weeks = days / 7;
                _salesChart = Enumerable.Range(0, weeks).Select(i =>
                {
                    var wStart = start.AddDays(i * 7);
                    var wEnd   = wStart.AddDays(7);
                    var amt    = sales.Where(t => t.At >= wStart && t.At < wEnd).Sum(t => t.GrandTotal);
                    return new DayData(wStart.ToString("dd/MM"), amt);
                }).ToList();

                _expensesChart = Enumerable.Range(0, weeks).Select(i =>
                {
                    var wStart = start.AddDays(i * 7);
                    var wEnd   = wStart.AddDays(7);
                    var amt    = expenses.Where(e => e.At >= wStart && e.At < wEnd).Sum(e => e.Amount);
                    return new DayData(wStart.ToString("dd/MM"), amt);
                }).ToList();
            }
            else
            {
                // تجميع يومي
                _salesChart = Enumerable.Range(0, days).Select(i =>
                {
                    var d   = start.AddDays(i);
                    var next = d.AddDays(1);
                    var amt = sales.Where(t => t.At >= d && t.At < next).Sum(t => t.GrandTotal);
                    return new DayData(d.ToString("dd/MM"), amt);
                }).ToList();

                _expensesChart = Enumerable.Range(0, days).Select(i =>
                {
                    var d   = start.AddDays(i);
                    var next = d.AddDays(1);
                    var amt = expenses.Where(e => e.At >= d && e.At < next).Sum(e => e.Amount);
                    return new DayData(d.ToString("dd/MM"), amt);
                }).ToList();
            }

            _chartRenderKey++;
        }
        catch (Exception ex) { Console.WriteLine($"[LoadChartData] {ex.Message}"); }
    }

    private async Task LoadAttentionItems()
    {
        var items = new List<AttentionItem>();
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            if (_p.ViewQuotes)
            {
                var pending = await db.Quotations.AsNoTracking()
                    .CountAsync(q => (q.Status == "Draft" || q.Status == "Sent") && q.InvoiceId == null);
                if (pending > 0)
                    items.Add(new() { Emoji = "⏳", Title = $"{pending} عرض سعر في انتظار رد", Description = "تابع مع العملاء", Link = "/quotations", Severity = "medium" });

                var soon = DateTime.Today.AddDays(3);
                var exp  = await db.Quotations.AsNoTracking()
                    .CountAsync(q => q.ValidUntil.HasValue && q.ValidUntil.Value.Date >= DateTime.Today
                                  && q.ValidUntil.Value.Date <= soon
                                  && q.InvoiceId == null && q.Status != "Rejected" && q.Status != "Expired");
                if (exp > 0)
                    items.Add(new() { Emoji = "⚠️", Title = $"{exp} عرض ينتهي خلال 3 أيام", Description = "تواصل مع العملاء قبل الانتهاء", Link = "/quotations", Severity = "high" });

                var accepted = await db.Quotations.AsNoTracking()
                    .CountAsync(q => q.Status == "Accepted" && q.InvoiceId == null);
                if (accepted > 0)
                    items.Add(new() { Emoji = "✅", Title = $"{accepted} عرض مقبول جاهز للتحويل", Description = "حوّلها لفواتير الآن", Link = "/quotations", Severity = "high" });

                var expired = await db.Quotations.AsNoTracking()
                    .CountAsync(q => q.ValidUntil.HasValue && q.ValidUntil.Value.Date < DateTime.Today
                                  && q.InvoiceId == null && q.Status != "Rejected" && q.Status != "Expired");
                if (expired > 0)
                    items.Add(new() { Emoji = "⏰", Title = $"{expired} عرض منتهي الصلاحية", Description = "يحتاج مراجعة", Link = "/quotations", Severity = "low" });
            }

            if (_p.ViewSales)
            {
                var overdue = DateTime.Today.AddDays(-30);
                var oldInv  = await db.Transactions.AsNoTracking()
                    .CountAsync(t => t.TransactionType == "Sale"
                                  && t.InvoiceStatus == "Open"
                                  && t.TransactionDate <= overdue);
                if (oldInv > 0)
                    items.Add(new() { Emoji = "💰", Title = $"{oldInv} فاتورة متأخرة السداد (+30 يوم)", Description = "راجع المتأخرات", Link = "/sales/invoices", Severity = "high" });

                if (_p.ViewDeliveryTracking)
                {
                    var overdueDeliveries = await db.VwSalesDeliveryStatuses.AsNoTracking()
                        .CountAsync(d => d.DeliveryStatus != "تم التسليم"
                                      && d.DueDate.HasValue
                                      && d.DueDate.Value.Date < DateTime.Today);
                    if (overdueDeliveries > 0)
                        items.Add(new() { Emoji = "🚚", Title = $"{overdueDeliveries} تسليم متأخر", Description = "افتح شاشة متابعة التسليمات", Link = "/sales-delivery-status", Severity = "high" });

                    var dueTodayDeliveries = await db.VwSalesDeliveryStatuses.AsNoTracking()
                        .CountAsync(d => d.DeliveryStatus != "تم التسليم"
                                      && d.DueDate.HasValue
                                      && d.DueDate.Value.Date == DateTime.Today);
                    if (dueTodayDeliveries > 0)
                        items.Add(new() { Emoji = "📦", Title = $"{dueTodayDeliveries} تسليم مستحق اليوم", Description = "راجع جدول التسليم اليومي", Link = "/sales-delivery-status", Severity = "medium" });
                }
            }

            if (_p.ViewComplaints)
            {
                var oldComp = await db.Complaints.AsNoTracking()
                    .CountAsync(c => (c.Status == 1 || c.Status == 2)
                                  && c.CreatedAt.HasValue
                                  && c.CreatedAt.Value <= DateTime.Today.AddDays(-7));
                if (oldComp > 0)
                    items.Add(new() { Emoji = "🔴", Title = $"{oldComp} شكوى مفتوحة أكثر من 7 أيام", Description = "تابع الشكاوى القديمة", Link = "/complaints/list", Severity = "high" });
            }

            if (_p.ViewProducts)
            {
                var needPrice = await db.Products.AsNoTracking()
                    .CountAsync(p => p.PricingStatusId == 2);
                if (needPrice > 0)
                    items.Add(new() { Emoji = "🏷️", Title = $"{needPrice} منتج في انتظار التسعير", Description = "ادخل التكلفة لتحديد السعر", Link = "/products", Severity = "medium" });
            }
        }
        catch (Exception ex) { Console.WriteLine($"[LoadAttentionItems] {ex.Message}"); }

        _attentionItems = items
            .OrderByDescending(i => GetSeverityRank(i.Severity))
            .ThenBy(i => i.Title)
            .ToList();
    }

    private async Task LoadPersonalizedInsights()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var today = DateTime.Today;
            var tomorrow = today.AddDays(1);
            var thisMonthStart = new DateTime(today.Year, today.Month, 1);
            var soon = today.AddDays(3);

            var priorityItems = new List<PriorityItem>();

            if (_p.ViewQuotes)
            {
                var pendingQuotes = await db.Quotations.AsNoTracking()
                    .CountAsync(q => (q.Status == QuotationStatuses.Draft || q.Status == QuotationStatuses.Sent) && q.InvoiceId == null);
                if (pendingQuotes > 0)
                    priorityItems.Add(new("عروض تحتاج متابعة", pendingQuotes, "تابع العروض المعلقة مع العملاء", "/quotations", Icons.Material.Filled.RequestQuote, "#06b6d4", "medium", 70));

                var acceptedQuotes = await db.Quotations.AsNoTracking()
                    .CountAsync(q => q.Status == QuotationStatuses.Accepted && q.InvoiceId == null);
                if (acceptedQuotes > 0)
                    priorityItems.Add(new("عروض جاهزة للتحويل", acceptedQuotes, "حوّل العروض المقبولة إلى فواتير", "/quotations", Icons.Material.Filled.ReceiptLong, "#10b981", "high", 95));

                var expiringQuotes = await db.Quotations.AsNoTracking()
                    .CountAsync(q => q.ValidUntil.HasValue
                                  && q.ValidUntil.Value.Date >= today
                                  && q.ValidUntil.Value.Date <= soon
                                  && q.InvoiceId == null
                                  && (q.Status == QuotationStatuses.Draft || q.Status == QuotationStatuses.Sent));
                if (expiringQuotes > 0)
                    priorityItems.Add(new("عروض قربت تنتهي", expiringQuotes, "تواصل سريع قبل انتهاء الصلاحية", "/quotations", Icons.Material.Filled.Schedule, "#f59e0b", "medium", 80));
            }

            if (_p.ViewDeliveryTracking)
            {
                _deliveryWidget.OverdueCount = await db.VwSalesDeliveryStatuses.AsNoTracking()
                    .CountAsync(d => d.DeliveryStatus != "تم التسليم" && d.DueDate.HasValue && d.DueDate.Value.Date < today);

                _deliveryWidget.DueTodayCount = await db.VwSalesDeliveryStatuses.AsNoTracking()
                    .CountAsync(d => d.DeliveryStatus != "تم التسليم" && d.DueDate.HasValue && d.DueDate.Value.Date == today);

                _deliveryWidget.DeliveredTodayCount = await db.VwSalesDeliveryStatuses.AsNoTracking()
                    .CountAsync(d => d.DeliveryStatus == "تم التسليم" && d.DeliveredAt.HasValue && d.DeliveredAt.Value >= today && d.DeliveredAt.Value < tomorrow);

                _deliveryWidget.PendingCount = await db.VwSalesDeliveryStatuses.AsNoTracking()
                    .CountAsync(d => d.DeliveryStatus != "تم التسليم");

                if (_deliveryWidget.OverdueCount > 0)
                    priorityItems.Add(new("تسليمات متأخرة", _deliveryWidget.OverdueCount, "راجع أوامر التسليم المتأخرة فورًا", "/sales-delivery-status", Icons.Material.Filled.LocalShipping, "#ef4444", "high", 100));

                if (_deliveryWidget.DueTodayCount > 0)
                    priorityItems.Add(new("تسليمات مستحقة اليوم", _deliveryWidget.DueTodayCount, "رتّب جدول التسليم اليومي", "/sales-delivery-status", Icons.Material.Filled.LocalShipping, "#14b8a6", "high", 90));
            }

            if (_p.ViewSales || _p.ViewCashBox || _p.ViewExpenses)
            {
                _financeWidget.OpenInvoicesCount = await db.Transactions.AsNoTracking()
                    .CountAsync(t => t.TransactionType == "Sale" && t.InvoiceStatus == "Open");

                _financeWidget.OverdueInvoicesCount = await db.Transactions.AsNoTracking()
                    .CountAsync(t => t.TransactionType == "Sale" && t.InvoiceStatus == "Open" && t.TransactionDate <= today.AddDays(-30));

                var saleTransactionIds = db.Transactions.AsNoTracking()
                    .Where(t => t.TransactionType == "Sale")
                    .Select(t => t.TransactionId);

                _financeWidget.CollectionsToday = await db.Payments.AsNoTracking()
                    .Where(p => saleTransactionIds.Contains(p.TransactionId) && p.PaymentDate >= today && p.PaymentDate < tomorrow)
                    .SumAsync(p => (decimal?)p.Amount) ?? 0;

                _financeWidget.CollectionsThisMonth = await db.Payments.AsNoTracking()
                    .Where(p => saleTransactionIds.Contains(p.TransactionId) && p.PaymentDate >= thisMonthStart)
                    .SumAsync(p => (decimal?)p.Amount) ?? 0;

                _financeWidget.ExpensesThisMonth = await db.Expenses.AsNoTracking()
                    .Where(e => e.ExpenseDate >= thisMonthStart)
                    .SumAsync(e => (decimal?)e.Amount) ?? 0;

                if (_p.ViewCashBox)
                {
                    var boxes = await CashBoxService.GetCashBoxesAsync(true);
                    _financeWidget.CashBalance = boxes.Sum(b => b.CurrentBalance);
                }

                if (_financeWidget.OverdueInvoicesCount > 0)
                    priorityItems.Add(new("متحصلات متأخرة", _financeWidget.OverdueInvoicesCount, "ابدأ بالفواتير المفتوحة القديمة", "/sales/invoices", Icons.Material.Filled.Payments, "#f97316", "high", 85));
            }

            if (_p.ViewProducts)
            {
                var productsPendingPricing = await db.Products.AsNoTracking()
                    .CountAsync(p => p.PricingStatusId == 2);
                if (productsPendingPricing > 0)
                    priorityItems.Add(new("منتجات بانتظار التسعير", productsPendingPricing, "استكمال التسعير يسرّع البيع والعروض", "/products", Icons.Material.Filled.Inventory2, "#8b5cf6", "medium", 60));
            }

            if (_p.ViewComplaints)
            {
                var oldComplaints = await db.Complaints.AsNoTracking()
                    .CountAsync(c => (c.Status == 1 || c.Status == 2)
                                  && c.CreatedAt.HasValue
                                  && c.CreatedAt.Value <= today.AddDays(-7));
                if (oldComplaints > 0)
                    priorityItems.Add(new("شكاوى قديمة مفتوحة", oldComplaints, "المتابعة السريعة ترفع رضا العملاء", "/complaints/list", Icons.Material.Filled.SupportAgent, "#ef4444", "high", 88));
            }

            _priorityItems = priorityItems
                .OrderByDescending(i => i.Rank)
                .ThenByDescending(i => i.Count)
                .Take(6)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LoadPersonalizedInsights] {ex.Message}");
            _priorityItems = new();
            _deliveryWidget = new();
            _financeWidget = new();
        }
    }

    private async Task LoadCrmHomeInsights()
    {
        _crmWidget = new();
        _crmUpcomingTasks = new();
        _crmTeamWidget = new();
        _crmTeamMembers = new();
        _crmHomeLoadFailed = false;
        _crmTeamLoadFailed = false;

        if (!_p.ViewTasks && !_p.ViewLeads)
            return;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var today = DateTime.Today;
            var startOfWeek = today.AddDays(-(int)today.DayOfWeek);
            var endOfWeek = startOfWeek.AddDays(7);

            var employeeId = await ResolveCurrentEmployeeIdAsync(db);

            _crmWidget.IsEmployeeLinked = employeeId.HasValue;
            _crmWidget.EmployeeId = employeeId;

            var result = await TaskService.GetTasksAsync(new TaskFilterDto
            {
                PageNumber = 1,
                PageSize = 5000,
                SortBy = "DueDate",
                SortDescending = false
            });

            var allTasks = result.Items
                .Where(t => t.IsActive && t.Status != "Completed" && t.Status != "Cancelled")
                .Where(t => (_p.ViewTasks && !t.IsLeadTask) || (_p.ViewLeads && t.IsLeadTask))
                .OrderBy(t => t.DueDate.Date)
                .ThenBy(t => t.DueTime ?? new TimeOnly(23, 59))
                .ToList();

            if (employeeId.HasValue)
            {
                var myTasks = allTasks.Where(t => t.AssignedTo == employeeId.Value).ToList();

                _crmWidget.TotalCount = myTasks.Count;
                _crmWidget.TodayCount = myTasks.Count(t => t.DueDate.Date == today);
                _crmWidget.OverdueCount = myTasks.Count(t => t.DueDate.Date < today);
                _crmWidget.WeekCount = myTasks.Count(t => t.DueDate.Date >= today && t.DueDate.Date < endOfWeek);
                _crmWidget.LeadCount = myTasks.Count(t => t.IsLeadTask);
                _crmWidget.ClientCount = myTasks.Count(t => !t.IsLeadTask);

                _crmUpcomingTasks = myTasks.Take(5).ToList();
            }

            if (ShouldShowCrmTeamWidget())
            {
                _crmTeamWidget.TotalCount = allTasks.Count;
                _crmTeamWidget.TodayCount = allTasks.Count(t => t.DueDate.Date == today);
                _crmTeamWidget.OverdueCount = allTasks.Count(t => t.DueDate.Date < today);

                var grouped = allTasks
                    .GroupBy(t => new { t.AssignedTo, Name = string.IsNullOrWhiteSpace(t.AssignedToName) ? "غير محدد" : t.AssignedToName! })
                    .Select(g => new CrmTeamMemberItem
                    {
                        EmployeeId = g.Key.AssignedTo,
                        Name = g.Key.Name,
                        TotalCount = g.Count(),
                        OverdueCount = g.Count(x => x.DueDate.Date < today),
                        TodayCount = g.Count(x => x.DueDate.Date == today),
                        LeadCount = g.Count(x => x.IsLeadTask)
                    })
                    .OrderByDescending(x => x.OverdueCount)
                    .ThenByDescending(x => x.TodayCount)
                    .ThenByDescending(x => x.TotalCount)
                    .ThenBy(x => x.Name)
                    .ToList();

                _crmTeamMembers = grouped;
                _crmTeamWidget.MembersWithOverdueCount = grouped.Count(x => x.OverdueCount > 0);
                _crmTeamWidget.ActiveMembersCount = grouped.Count;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LoadCrmHomeInsights] {ex.Message}");
            _crmHomeLoadFailed = true;
            _crmTeamLoadFailed = ShouldShowCrmTeamWidget();
            _crmWidget = new();
            _crmUpcomingTasks = new();
            _crmTeamWidget = new();
            _crmTeamMembers = new();
        }
    }

