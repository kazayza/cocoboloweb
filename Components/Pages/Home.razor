    };

    private decimal _quotesDonutTotal => _quotesDonut.Sum(s => s.Value);

    private decimal _quoteAcceptanceRate
    {
        get
        {
            var total = _quotesDonutTotal;
            if (total <= 0) return 0;

            var accepted = _quotesDonut
                .Where(s => s.Status == QuotationStatuses.Accepted || s.Status == QuotationStatuses.Converted)
                .Sum(s => s.Value);

            return Math.Round((accepted / total) * 100m, 1);
        }
    }

