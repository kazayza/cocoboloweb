@page "/"
@implements IDisposable

@using ApexCharts
@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using COCOBOLOERPNEW.Models
@using System.Security.Claims
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor

@inject NotificationService      NotificationService
@inject AuthenticationStateProvider AuthProvider
@inject IDbContextFactory<db24804Context> DbFactory
@inject ICashBoxService          CashBoxService
@inject ITaskService             TaskService
@inject NavigationManager        Navigation
@inject ISnackbar                Snackbar
@inject IJSRuntime               JS

<PageTitle>الرئيسية — COCOBOLO ERP</PageTitle>

@if (_isLoading)
{
    <div class="loading-screen">
        <div class="loading-content">
            <div class="loading-spinner-box">
                <MudProgressCircular Color="MudBlazor.Color.Secondary" Size="MudBlazor.Size.Large" Indeterminate="true" />
            </div>
            <MudText Typo="Typo.h6" Class="loading-text">جاري تحميل لوحة التحكم...</MudText>
            <div class="loading-dots">
                <span></span><span></span><span></span>
            </div>
        </div>
    </div>
}
else
{
<div dir="rtl" class="home-page">

    <!-- ⭐ BACKGROUND DECORATIONS -->
    <div class="page-bg-decorations">
        <div class="bg-orb bg-orb-1"></div>
        <div class="bg-orb bg-orb-2"></div>
        <div class="bg-orb bg-orb-3"></div>
    </div>

    <!-- ⭐ TOP ACCENT BAR -->
    <div class="top-accent-bar">
        <div class="accent-shimmer"></div>
    </div>

    <!-- ⭐ PREMIUM HEADER -->
    <div class="home-header">
        <div class="header-bg">
            <div class="header-gradient"></div>
            <div class="header-orbs">
                <div class="header-orb orb-1"></div>
                <div class="header-orb orb-2"></div>
                <div class="header-orb orb-3"></div>
            </div>
            <div class="header-grid"></div>
        </div>

        <div class="header-content">
            <div class="header-top">
                <div class="header-info">
                    <div class="header-icon-wrapper">
                        <div class="header-icon-glow"></div>
                        <div class="header-icon">
                            <span class="greet-emoji">@_greetingIcon</span>
                        </div>
                        <div class="header-icon-badge">
                            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="MudBlazor.Size.Small" />
                        </div>
                        <div class="header-icon-badge-secondary">
                            <MudIcon Icon="@Icons.Material.Filled.Verified" Size="MudBlazor.Size.Small" />
                        </div>
                    </div>
                    <div class="header-text">
                        <div class="header-title-row">
                            <h1>@_greetingMessage</h1>
                            <span class="premium-badge">
                                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="MudBlazor.Size.Small" />
                                @_currentUserRole
                            </span>
                        </div>
                        <p>
                            <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="MudBlazor.Size.Small" Class="subtitle-icon" />
                            @_greetingSubtext
                        </p>
                    </div>
                </div>
            </div>

            <!-- Stats Grid (inside header) -->
            <div class="stats-grid">
                @if (_p.ViewSales)
                {
                    <div class="stat-card stat-sales animate-card" style="--delay: 0.05s"
                         @onclick='() => Navigation.NavigateTo("/sales/invoices")'>
                        <div class="stat-glow"></div>
                        <div class="stat-accent"></div>
                        <div class="stat-content">
                            <div class="stat-icon-box">
                                <MudIcon Icon="@Icons.Material.Rounded.TrendingUp" />
                            </div>
                            <div class="stat-data">
                                <div class="stat-value-row">
                                    <span class='stat-value @GetStatClass(FormatMoney(_kpi.SalesThisMonth))'>@FormatMoney(_kpi.SalesThisMonth)</span>
                                    @if (_kpi.SalesGrowth != 0)
                                    {
                                        <span class='stat-trend @(_kpi.SalesGrowth >= 0 ? "trend-up" : "trend-down")'>
                                            <MudIcon Icon="@(_kpi.SalesGrowth >= 0 ? Icons.Material.Filled.TrendingUp : Icons.Material.Filled.TrendingDown)" Size="MudBlazor.Size.Small" />
                                            @Math.Abs(_kpi.SalesGrowth)%
                                        </span>
                                    }
                                </div>
                                <div class="stat-label">مبيعات الشهر</div>
                            </div>
                        </div>
                    </div>
                }

                @if (_p.ViewQuotes)
                {
                    <div class="stat-card stat-quotes animate-card" style="--delay: 0.1s"
                         @onclick='() => Navigation.NavigateTo("/quotations")'>
                        <div class="stat-glow"></div>
                        <div class="stat-accent"></div>
                        <div class="stat-content">
                            <div class="stat-icon-box">
                                <MudIcon Icon="@Icons.Material.Rounded.RequestQuote" />
                            </div>
                            <div class="stat-data">
                                <div class="stat-value-row">
                                    <span class='stat-value @GetStatClass(_kpi.QuotesTotal.ToString())'>@_kpi.QuotesTotal</span>
                                    @if (_kpi.QuotesPending > 0)
                                    {
                                        <span class="stat-percent">@_kpi.QuotesPending معلق</span>
                                    }
                                </div>
                                <div class="stat-label">عروض الأسعار</div>
                            </div>
                        </div>
                    </div>
                }

                @if (_p.ViewCustomers)
                {
                    <div class="stat-card stat-customers animate-card" style="--delay: 0.15s"
                         @onclick='() => Navigation.NavigateTo("/customers")'>
                        <div class="stat-glow"></div>
                        <div class="stat-accent"></div>
                        <div class="stat-content">
                            <div class="stat-icon-box">
                                <MudIcon Icon="@Icons.Material.Rounded.Groups" />
                            </div>
                            <div class="stat-data">
                                <div class="stat-value-row">
                                    <span class='stat-value @GetStatClass(_kpi.CustomersTotal.ToString())'>@_kpi.CustomersTotal</span>
                                    <span class="stat-percent">@_kpi.CustomersActive نشط</span>
                                </div>
                                <div class="stat-label">العملاء</div>
                            </div>
                        </div>
                    </div>
                }
                

                @if (_p.ViewCashBox)
                {
                    <div class="stat-card stat-cash animate-card" style="--delay: 0.2s"
                         @onclick='() => Navigation.NavigateTo("/cashbox/dashboard")'>
                        <div class="stat-glow"></div>
                        <div class="stat-accent"></div>
                        <div class="stat-content">
                            <div class="stat-icon-box">
                                <MudIcon Icon="@Icons.Material.Rounded.AccountBalance" />
                            </div>
                            <div class="stat-data">
                                <div class="stat-value-row">
                                    <span class='stat-value @GetStatClass(FormatMoney(_kpi.CashBalance))'>@FormatMoney(_kpi.CashBalance)</span>
                                </div>
                                <div class="stat-label">رصيد الخزنة</div>
                            </div>
                        </div>
                    </div>
                }

                @if (_p.ViewProducts)
                {
                    <div class="stat-card stat-products animate-card" style="--delay: 0.25s"
                         @onclick='() => Navigation.NavigateTo("/products")'>
                        <div class="stat-glow"></div>
                        <div class="stat-accent"></div>
                        <div class="stat-content">
                            <div class="stat-icon-box">
                                <MudIcon Icon="@Icons.Material.Rounded.Inventory2" />
                            </div>
                            <div class="stat-data">
                                <div class="stat-value-row">
                                    <span class='stat-value @GetStatClass(_kpi.ProductsTotal.ToString())'>@_kpi.ProductsTotal</span>
                                    @if (_kpi.ProductsPendingPrice > 0)
                                    {
                                        <span class="stat-percent warn">@_kpi.ProductsPendingPrice تسعير</span>
                                    }
                                </div>
                                <div class="stat-label">المنتجات</div>
                            </div>
                        </div>
                    </div>
                }

                @if (_p.ViewEmployees)
                {
                    <div class="stat-card stat-hr animate-card" style="--delay: 0.3s"
                         @onclick='() => Navigation.NavigateTo("/employees")'>
                        <div class="stat-glow"></div>
                        <div class="stat-accent"></div>
                        <div class="stat-content">
                            <div class="stat-icon-box">
                                <MudIcon Icon="@Icons.Material.Rounded.Badge" />
                            </div>
                            <div class="stat-data">
                                <div class="stat-value-row">
                                    <span class='stat-value @GetStatClass(_kpi.EmployeesTotal.ToString())'>@_kpi.EmployeesTotal</span>
                                </div>
                                <div class="stat-label">الموظفين</div>
                            </div>
                        </div>
                    </div>
                }
                @if (_p.ViewComplaints)
{
    <div class="stat-card stat-complaints animate-card" style="--delay: 0.35s"
         @onclick='() => Navigation.NavigateTo("/complaints/list")'>
        <div class="stat-glow"></div>
        <div class="stat-accent"></div>
        <div class="stat-content">
            <div class="stat-icon-box" style="background: rgba(239,68,68,0.15); color: #ef4444;">
                <MudIcon Icon="@Icons.Material.Rounded.SupportAgent" />
            </div>
            <div class="stat-data">
                <div class="stat-value-row">
                    <span class='stat-value @GetStatClass(_kpi.ComplaintsThisMonth.ToString())'>@_kpi.ComplaintsThisMonth</span>
                    @if (_kpi.ComplaintsActive > 0)
                    {
                        <span class="stat-percent warn" style="color: #ef4444;">@_kpi.ComplaintsActive مفتوحة</span>
                    }
                </div>
                <div class="stat-label">شكاوى الشهر</div>
            </div>
        </div>
    </div>
}

                @if (_p.ViewExpenses)
                {
                    <div class="stat-card stat-expenses animate-card" style="--delay: 0.35s"
                         @onclick='() => Navigation.NavigateTo("/expenses")'>
                        <div class="stat-glow"></div>
                        <div class="stat-accent"></div>
                        <div class="stat-content">
                            <div class="stat-icon-box">
                                <MudIcon Icon="@Icons.Material.Rounded.AccountBalanceWallet" />
                            </div>
                            <div class="stat-data">
                                <div class="stat-value-row">
                                    <span class='stat-value @GetStatClass(FormatMoney(_kpi.ExpensesThisMonth))'>@FormatMoney(_kpi.ExpensesThisMonth)</span>
                                </div>
                                <div class="stat-label">مصروفات الشهر</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ⭐ QUICK ACCESS -->
    @{ var quickLinks = BuildQuickLinks(); }
    @if (quickLinks.Any())
    {
        <div class="pro-card animate-card" style="--delay: 0.2s">
            <div class="card-hdr">
                <div class="hdr-left">
                    <div class="hdr-icon" style="background: linear-gradient(135deg,#667eea,#764ba2)">
                        <MudIcon Icon="@Icons.Material.Rounded.Apps" />
                    </div>
                    <div>
                        <h3>وصول سريع</h3>
                        <p>انتقل مباشرة لأي قسم</p>
                    </div>
                </div>
            </div>
            <div class="quick-grid">
                @foreach (var link in quickLinks)
                {
                    <button class="quick-btn" @onclick="() => Navigation.NavigateTo(link.Url)"
                            style="--qc: @link.Color">
                        <div class="quick-btn-icon">
                            <MudIcon Icon="@link.Icon" />
                        </div>
                        <span>@link.Label</span>
                    </button>
                }
            </div>
        </div>
    }

    @if (_priorityItems.Any() || ShouldShowDeliveryWidget() || ShouldShowFinanceWidget() || ShouldShowCrmWidget() || ShouldShowCrmTeamWidget())
    {
        <div class="focus-layout animate-card" style="--delay: 0.26s">
            @if (_priorityItems.Any())
            {
                <div class="pro-card focus-main-card">
                    <div class="card-hdr">
                        <div class="hdr-left">
                            <div class="hdr-icon focus-icon">
                                <MudIcon Icon="@Icons.Material.Filled.Bolt" />
                            </div>
                            <div>
                                <h3>أولوياتك اليوم</h3>
                                <p>@GetPrioritySectionSubtitle()</p>
                            </div>
                        </div>
                    </div>

                    <div class="priority-grid">
                        @foreach (var item in _priorityItems.Take(6))
                        {
                            <button type="button" class='priority-item @item.Severity' @onclick='() => Navigation.NavigateTo(item.Link)'>
                                <div class="priority-icon" style='@($"--priority-color: {item.Color}")'>
                                    <MudIcon Icon="@item.Icon" />
                                </div>
                                <div class="priority-text">
                                    <strong>@item.Title</strong>
                                    <small>@item.Description</small>
                                </div>
                                <div class="priority-meta">
                                    <span class="priority-count">@item.Count</span>
                                    <span class="priority-action">افتح</span>
                                </div>
                            </button>
                        }
                    </div>
                </div>
            }

            @if (ShouldShowDeliveryWidget() || ShouldShowFinanceWidget() || ShouldShowCrmWidget() || ShouldShowCrmTeamWidget())
            {
                <div class='focus-side-stack @(!_priorityItems.Any() ? "full-width" : "")'>
                    @if (ShouldShowDeliveryWidget())
                    {
                        <div class="pro-card mini-insight-card delivery-widget-card">
                            <div class="card-hdr mini-card-hdr">
                                <div class="hdr-left">
                                    <div class="hdr-icon delivery-widget-icon">
                                        <MudIcon Icon="@Icons.Material.Filled.LocalShipping" />
                                    </div>
                                    <div>
                                        <h3>متابعة التسليمات</h3>
                                        <p>حالة التنفيذ اليوم</p>
                                    </div>
                                </div>
                                <button class="view-all" @onclick='() => Navigation.NavigateTo("/sales-delivery-status")'>
                                    فتح المتابعة
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="MudBlazor.Size.Small" />
                                </button>
                            </div>
                            <div class="mini-metrics-grid">
                                @foreach (var metric in BuildDeliveryMetrics())
                                {
                                    <div class='mini-metric @metric.Tone'>
                                        <span>@metric.Label</span>
                                        <strong>@metric.Value</strong>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (ShouldShowCrmWidget())
                    {
                        <div class="pro-card mini-insight-card crm-widget-card">
                            <div class="card-hdr mini-card-hdr">
                                <div class="hdr-left">
                                    <div class="hdr-icon crm-widget-icon">
                                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" />
                                    </div>
                                    <div>
                                        <h3>متابعات CRM الخاصة بي</h3>
                                        <p>@GetCrmWidgetSubtitle()</p>
                                    </div>
                                </div>
                                <button class="view-all" @onclick='() => Navigation.NavigateTo(GetCrmMainRoute())'>
                                    افتح المتابعة
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="MudBlazor.Size.Small" />
                                </button>
                            </div>

                            @if (_crmHomeLoadFailed)
                            {
                                <div class="crm-empty-note error-note">
                                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="MudBlazor.Size.Small" />
                                    <span>تعذر تحميل متابعات CRM الآن. غالبًا كانت مشكلة تحميل داخلية وليست مشكلة ربط موظف.</span>
                                </div>
                            }
                            else if (!_crmWidget.IsEmployeeLinked)
                            {
                                <div class="crm-empty-note">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="MudBlazor.Size.Small" />
                                    <span>هذا الحساب غير مربوط بموظف، لذلك لم نتمكن من إظهار متابعاتك الشخصية.</span>
                                </div>
                            }
                            else
                            {
                                <div class="mini-metrics-grid crm-metrics-grid">
                                    @foreach (var metric in BuildCrmMetrics())
                                    {
                                        <div class='mini-metric @metric.Tone'>
                                            <span>@metric.Label</span>
                                            <strong>@metric.Value</strong>
                                        </div>
                                    }
                                </div>

                                <div class="crm-quick-actions">
                                    @if (_p.ViewTasks)
                                    {
                                        <button type="button" class="crm-action-btn" @onclick='() => Navigation.NavigateTo("/crm/tasks")'>
                                            <MudIcon Icon="@Icons.Material.Filled.TaskAlt" Size="MudBlazor.Size.Small" />
                                            <span>المهام</span>
                                        </button>
                                    }
                                    @if (_p.ViewLeads)
                                    {
                                        <button type="button" class="crm-action-btn" @onclick='() => Navigation.NavigateTo("/crm/leads/my")'>
                                            <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Size="MudBlazor.Size.Small" />
                                            <span>الليدز</span>
                                        </button>
                                    }
                                    @if (_p.ViewTasks)
                                    {
                                        <button type="button" class="crm-action-btn" @onclick='() => Navigation.NavigateTo("/crm/my-calendar")'>
                                            <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="MudBlazor.Size.Small" />
                                            <span>جدولي</span>
                                        </button>
                                    }
                                </div>

                                @if (_crmUpcomingTasks.Any())
                                {
                                    <div class="crm-followup-list">
                                        @foreach (var task in _crmUpcomingTasks.Take(5))
                                        {
                                            <button type="button" class='crm-followup-item @GetCrmFollowupClass(task)' @onclick='() => Navigation.NavigateTo(GetCrmItemLink(task))'>
                                                <div class='crm-followup-icon @(task.IsLeadTask ? "lead" : "client")'>
                                                    <MudIcon Icon="@(task.IsLeadTask ? Icons.Material.Filled.Campaign : Icons.Material.Filled.Groups)" Size="MudBlazor.Size.Small" />
                                                </div>
                                                <div class="crm-followup-text">
                                                    <div class="crm-followup-title-row">
                                                        <strong>@(task.ClientName ?? "غير محدد")</strong>
                                                        <span class="crm-followup-type">@(task.IsLeadTask ? "ليد" : "عميل")</span>
                                                    </div>
                                                    <small>@GetCrmTaskSummary(task)</small>
                                                </div>
                                                <div class="crm-followup-meta">
                                                    <span class='crm-due-badge @GetCrmDueBadgeClass(task)'>@GetCrmDueBadgeText(task)</span>
                                                    <small>@GetCrmDueTimeText(task)</small>
                                                </div>
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="empty-state compact-empty-state crm-empty-state-box">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                                        <p>لا توجد متابعات مفتوحة لك حالياً</p>
                                    </div>
                                }
                            }
                        </div>
                    }

                    @if (ShouldShowCrmTeamWidget())
                    {
                        <div class="pro-card mini-insight-card crm-team-widget-card">
                            <div class="card-hdr mini-card-hdr">
                                <div class="hdr-left">
                                    <div class="hdr-icon crm-team-widget-icon">
                                        <MudIcon Icon="@Icons.Material.Filled.Groups" />
                                    </div>
                                    <div>
                                        <h3>ملخص فريق CRM</h3>
                                        <p>@GetCrmTeamSubtitle()</p>
                                    </div>
                                </div>
                                <button class="view-all" @onclick='() => Navigation.NavigateTo("/crm/my-calendar")'>
                                    فتح تقويم الفريق
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="MudBlazor.Size.Small" />
                                </button>
                            </div>

                            @if (_crmTeamLoadFailed)
                            {
                                <div class="crm-empty-note error-note">
                                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="MudBlazor.Size.Small" />
                                    <span>تعذر تحميل ملخص فريق CRM الآن. راجع التحميل بعد تحديث الصفحة أو إعادة الدخول.</span>
                                </div>
                            }
                            else if (_crmTeamWidget.TotalCount <= 0)
                            {
                                <div class="empty-state compact-empty-state crm-empty-state-box">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                                    <p>لا توجد متابعات مفتوحة للفريق حالياً</p>
                                </div>
                            }
                            else
                            {
                                <div class="mini-metrics-grid crm-team-metrics-grid">
                                    @foreach (var metric in BuildCrmTeamMetrics())
                                    {
                                        <div class='mini-metric @metric.Tone'>
                                            <span>@metric.Label</span>
                                            <strong>@metric.Value</strong>
                                        </div>
                                    }
                                </div>

                                @if (_crmTeamMembers.Any())
                                {
                                    <div class="team-member-list">
                                        @foreach (var member in _crmTeamMembers.Take(5))
                                        {
                                            <div class="team-member-row">
                                                <div class="team-member-main">
                                                    <strong>@member.Name</strong>
                                                    <small>@GetCrmTeamMemberSummary(member)</small>
                                                </div>
                                                <div class="team-count-cluster">
                                                    <span class='team-count-badge danger @(member.OverdueCount <= 0 ? "hidden-badge" : "")'>متأخر @member.OverdueCount</span>
                                                    <span class='team-count-badge warning @(member.TodayCount <= 0 ? "hidden-badge" : "")'>اليوم @member.TodayCount</span>
                                                    <span class="team-count-badge info">مفتوح @member.TotalCount</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }

                    @if (ShouldShowFinanceWidget())
                    {
                        <div class="pro-card mini-insight-card finance-widget-card">
                            <div class="card-hdr mini-card-hdr">
                                <div class="hdr-left">
                                    <div class="hdr-icon finance-widget-icon">
                                        <MudIcon Icon="@Icons.Material.Filled.Payments" />
                                    </div>
                                    <div>
                                        <h3>التحصيلات والمستحقات</h3>
                                        <p>ملخص مالي سريع حسب صلاحيتك</p>
                                    </div>
                                </div>
                                <button class="view-all" @onclick='() => Navigation.NavigateTo(_p.ViewCashBox ? "/cashbox/dashboard" : "/sales/invoices")'>
                                    فتح التفاصيل
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="MudBlazor.Size.Small" />
                                </button>
                            </div>
                            <div class="mini-metrics-grid finance-metrics-grid">
                                @foreach (var metric in BuildFinanceMetrics())
                                {
                                    <div class='mini-metric @metric.Tone'>
                                        <span>@metric.Label</span>
                                        <strong>@metric.Value</strong>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <!-- ⭐ ATTENTION + CHART -->
    <div class="content-row attention-chart-row animate-card" style="--delay: 0.3s">
        @if (_attentionItems.Any())
        {
            <div class="pro-card attention-card-layout">
                <div class="card-hdr">
                    <div class="hdr-left">
                        <div class="hdr-icon attention-icon">
                            <MudIcon Icon="@Icons.Material.Filled.NotificationImportant" />
                        </div>
                        <div>
                            <h3>تحتاج اهتمامك</h3>
                            <p>@_attentionItems.Count تنبيه نشط</p>
                        </div>
                    </div>
                </div>
                <div class="attention-summary-row">
                    <span class="attention-summary-pill high">عاجل @GetAttentionCount("high")</span>
                    <span class="attention-summary-pill medium">اليوم @GetAttentionCount("medium")</span>
                    <span class="attention-summary-pill low">متابعة @GetAttentionCount("low")</span>
                </div>
                <div class="att-list">
                    @foreach (var item in GetVisibleAttentionItems())
                    {
                        <div class='att-row @item.Severity' @onclick='() => Navigation.NavigateTo(item.Link)'>
                            <div class="att-emoji">@item.Emoji</div>
                            <div class="att-text">
                                <strong>@item.Title</strong>
                                <small>@item.Description</small>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="MudBlazor.Size.Small" Class="att-arrow" />
                        </div>
                    }
                </div>
            </div>
        }

        @if (_p.ViewSales && _salesChart.Any())
        {
            <div class='pro-card chart-card-layout @(_attentionItems.Any() ? "" : "full-width")'>
                <div class="card-hdr card-hdr-chart">
                    <div class="hdr-left">
                        <div class="hdr-icon chart-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Analytics" />
                        </div>
                        <div>
                            <h3>تحليل المبيعات</h3>
                            <p>@GetChartGroupingText() — @GetChartRangeText()</p>
                        </div>
                    </div>

                    <div class="chart-controls">
                        <div class="chart-summary-pills">
                            <div class="chart-pill sales">
                                <span>المبيعات</span>
                                <strong>@FormatMoney(_chartSalesTotal)</strong>
                            </div>
                            <div class="chart-pill expenses">
                                <span>المصروفات</span>
                                <strong>@FormatMoney(_chartExpensesTotal)</strong>
                            </div>
                            <div class='chart-pill net @(GetChartNetClass())'>
                                <span>الصافي</span>
                                <strong>@FormatMoney(_chartNetTotal)</strong>
                            </div>
                        </div>

                        <div class="period-toggle" role="tablist" aria-label="فترات تحليل المبيعات">
                            <button type="button" class='period-btn @(_chartPeriod == 1   ? "active" : "")' @onclick='() => SetChartPeriod(1)'>اليوم</button>
                            <button type="button" class='period-btn @(_chartPeriod == 7   ? "active" : "")' @onclick='() => SetChartPeriod(7)'>7 أيام</button>
                            <button type="button" class='period-btn @(_chartPeriod == 30  ? "active" : "")' @onclick='() => SetChartPeriod(30)'>30 يوم</button>
                            <button type="button" class='period-btn @(_chartPeriod == 90  ? "active" : "")' @onclick='() => SetChartPeriod(90)'>3 شهور</button>
                            <button type="button" class='period-btn @(_chartPeriod == 365 ? "active" : "")' @onclick='() => SetChartPeriod(365)'>سنة</button>
                        </div>
                    </div>
                </div>

                <div class="chart-meta-row">
                    <div class="chart-meta-badge">
                        <MudIcon Icon="@Icons.Material.Filled.AutoGraph" Size="MudBlazor.Size.Small" />
                        <span>التجميع: @GetChartGroupingText()</span>
                    </div>
                    <div class="chart-meta-badge subtle">
                        <MudIcon Icon="@Icons.Material.Filled.DateRange" Size="MudBlazor.Size.Small" />
                        <span>@GetChartRangeText()</span>
                    </div>
                </div>

                <div class='sales-chart-shell @(_isChartLoading ? "loading" : "")'>
                    @if (_isChartLoading)
                    {
                        <div class="chart-loading-overlay">
                            <MudProgressCircular Color="MudBlazor.Color.Success" Indeterminate="true" Size="MudBlazor.Size.Medium" />
                            <span>جاري تحديث التحليل...</span>
                        </div>
                    }

                    <ApexChart TItem="DayData" @key="_chartRenderKey" Options="_salesChartOptions" Height="340">
                        <ApexPointSeries TItem="DayData"
                                         Items="_salesChart"
                                         Name="المبيعات"
                                         SeriesType="SeriesType.Area"
                                         XValue="@(d => d.Label)"
                                         YValue="@(d => (decimal?)d.Amount)" />
                        <ApexPointSeries TItem="DayData"
                                         Items="_expensesChart"
                                         Name="المصروفات"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(d => d.Label)"
                                         YValue="@(d => (decimal?)d.Amount)" />
                    </ApexChart>
                </div>
            </div>
        }
    </div>

    <!-- ⭐ QUOTES DONUT + RECENT QUOTES -->
    @if (_p.ViewQuotes && _kpi.QuotesTotal > 0)
    {
        <div class="content-row animate-card" style="--delay: 0.35s">
            <div class="pro-card quote-chart-card">
                <div class="card-hdr quote-chart-hdr">
                    <div class="hdr-left">
                        <div class="hdr-icon" style="background: linear-gradient(135deg,#06b6d4,#0891b2)">
                            <MudIcon Icon="@Icons.Material.Filled.DonutLarge" />
                        </div>
                        <div>
                            <h3>توزيع عروض الأسعار</h3>
                            <p>حالة العروض الحالية — اضغط على أي شريحة أو حالة للتصفية</p>
                        </div>
                    </div>

                    <div class="quote-chart-summary">
                        <div class="quote-acceptance-pill" title="مقبول + محوّل لفاتورة من إجمالي العروض">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" />
                            <span>معدل القبول</span>
                            <strong>@FormatQuotePercent(_quoteAcceptanceRate)</strong>
                        </div>

                        <button type="button" class="view-all" @onclick="() => NavigateToQuotesFiltered(null)">
                            عرض الكل
                            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="MudBlazor.Size.Small" />
                        </button>
                    </div>
                </div>

                <div class="quote-chart-wrap">
                    <ApexChart TItem="SliceData"
                               Options="_donutOptions"
                               Height="280"
                               OnDataPointSelection="OnQuoteSliceSelected">
                        <ApexPointSeries TItem="SliceData"
                                         Items="_quotesDonut"
                                         Name="العروض"
                                         SeriesType="SeriesType.Donut"
                                         XValue="@(d => d.Label)"
                                         YValue="@(d => (decimal?)d.Value)" />
                    </ApexChart>
                </div>

                <div class="quote-legend-grid" aria-label="تفاصيل حالات عروض الأسعار">
                    @foreach (var slice in _quotesDonut)
                    {
                        <button type="button"
                                class="quote-legend-item"
                                style="@($"--slice-color: {slice.Color};")"
                                title="فتح عروض حالة @slice.Label"
                                @onclick="() => NavigateToQuotesFiltered(slice.Status)">
                            <span class="quote-legend-dot"></span>
                            <span class="quote-legend-text">@slice.Label</span>
                            <span class="quote-legend-value">@FormatQuoteCount(slice.Value)</span>
                            <span class="quote-legend-percent">@FormatQuotePercent(GetQuoteSlicePercent(slice))</span>
                        </button>
                    }
                </div>
            </div>

            <div class="pro-card">
                <div class="card-hdr">
                    <div class="hdr-left">
                        <div class="hdr-icon quote-icon">
                            <MudIcon Icon="@Icons.Material.Filled.RequestQuote" />
                        </div>
                        <div>
                            <h3>آخر عروض الأسعار</h3>
                            <p>أحدث 5 عروض</p>
                        </div>
                    </div>
                    <button class="view-all" @onclick='() => Navigation.NavigateTo("/quotations")'>
                        عرض الكل
                        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="MudBlazor.Size.Small" />
                    </button>
                </div>
                @if (_recentQuotes.Any())
                {
                    <div class="activity-list">
                        @foreach (var q in _recentQuotes)
                        {
                            <div class="activity-item" @onclick='() => Navigation.NavigateTo("/quotations/" + q.QuotationId)'>
                                <div class="ai-id">@q.ReferenceNumber</div>
                                <div class="ai-info">
                                    <strong>@q.PartyName</strong>
                                    <small>
                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="MudBlazor.Size.Small" />
                                        @q.QuotationDate.ToString("dd/MM/yyyy")
                                    </small>
                                </div>
                                <div class="ai-amount">@q.GrandTotal.ToString("N0") <span class="cur">ج.م</span></div>
                                <span class='ai-status quote-@(q.Status.ToLower())'>@GetQuoteStatusText(q.Status)</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <MudIcon Icon="@Icons.Material.Filled.RequestQuote" />
                        <p>لا توجد عروض حديثة</p>
                    </div>
                }
            </div>
        </div>
    }

    <!-- ⭐ RECENT INVOICES -->
    @if (_p.ViewSales)
    {
        <div class="content-row animate-card" style="--delay: 0.4s">
            <div class="pro-card full-width">
                <div class="card-hdr">
                    <div class="hdr-left">
                        <div class="hdr-icon invoice-icon">
                            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" />
                        </div>
                        <div>
                            <h3>آخر فواتير المبيعات</h3>
                            <p>أحدث 5 فواتير</p>
                        </div>
                    </div>
                    <button class="view-all" @onclick='() => Navigation.NavigateTo("/sales/invoices")'>
                        عرض الكل
                        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="MudBlazor.Size.Small" />
                    </button>
                </div>
                @if (_recentInvoices.Any())
                {
                    <div class="activity-list">
                        @foreach (var inv in _recentInvoices)
                        {
                            <div class="activity-item" @onclick='() => Navigation.NavigateTo("/sales/invoices/" + inv.TransactionId)'>
                                <div class="ai-id">#@inv.TransactionId</div>
                                <div class="ai-info">
                                    <strong>@inv.PartyName</strong>
                                    <small>
                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="MudBlazor.Size.Small" />
                                        @inv.Date.ToString("dd/MM/yyyy")
                                    </small>
                                </div>
                                <div class="ai-amount">@inv.GrandTotal.ToString("N0") <span class="cur">ج.م</span></div>
                                <span class='ai-status @GetStatusClass(inv.InvoiceStatus)'>@GetInvoiceStatusText(inv.InvoiceStatus)</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" />
                        <p>لا توجد فواتير حديثة</p>
                    </div>
                }
            </div>
        </div>
    }

    <!-- ⭐ NOTIFICATIONS -->
    <div class="pro-card notif-card animate-card" style="--delay: 0.45s">
        <div class="card-hdr">
            <div class="hdr-left">
                <div class="hdr-icon notif-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Notifications" />
                </div>
                <div>
                    <h3>الإشعارات الأخيرة</h3>
                    <p>@_unreadNotifications إشعار غير مقروء</p>
                </div>
            </div>
            <button class="view-all" @onclick='() => Navigation.NavigateTo("/notifications")'>
                عرض الكل
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="MudBlazor.Size.Small" />
            </button>
        </div>
        @if (_notifications.Any())
        {
            <div class="notif-list">
                @foreach (var n in _notifications.Take(5))
                {
                    <div class='notif-item @(n.IsRead ? "" : "unread")'>
                        <div class="ni-icon">
                            <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Size="MudBlazor.Size.Small" />
                        </div>
                        <div class="ni-content">
                            <div class="ni-header">
                                <strong>@n.Title</strong>
                                <small>@TimeAgo(n.CreatedAt)</small>
                            </div>
                            <p>@n.Message</p>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <MudIcon Icon="@Icons.Material.Filled.NotificationsOff" />
                <p>لا توجد إشعارات</p>
            </div>
        }
    </div>

</div>

<!-- ⭐ FAB -->
<div class='fab-wrap @(_fabOpen ? "open" : "")'>
    @if (_fabOpen)
    {
        <div class="fab-overlay" @onclick="ToggleFab"></div>
    }
    <div class="fab-menu">
        @if (_p.AddCustomer)
        {
            <button class="fab-item" @onclick='() => NavTo("/customers/form")'>
                <span class="fab-tip">إضافة عميل</span>
                <div class="fab-icon"><MudIcon Icon="@Icons.Material.Filled.PersonAdd" /></div>
            </button>
        }
        @if (_p.AddProduct)
        {
            <button class="fab-item" @onclick='() => NavTo("/products/form")'>
                <span class="fab-tip">إضافة منتج</span>
                <div class="fab-icon"><MudIcon Icon="@Icons.Material.Filled.Inventory2" /></div>
            </button>
        }
        @if (_p.AddQuote)
        {
            <button class="fab-item" @onclick='() => NavTo("/quotations/new")'>
                <span class="fab-tip">عرض سعر جديد</span>
                <div class="fab-icon"><MudIcon Icon="@Icons.Material.Filled.RequestQuote" /></div>
            </button>
        }
        @if (_p.AddInvoice)
        {
            <button class="fab-item" @onclick='() => NavTo("/sales/invoices/new")'>
                <span class="fab-tip">فاتورة جديدة</span>
                <div class="fab-icon"><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" /></div>
            </button>
        }
        @if (_p.AddCashBox)
        {
            <button class="fab-item" @onclick='() => NavTo("/cashbox/manual")'>
                <span class="fab-tip">سند خزنة</span>
                <div class="fab-icon"><MudIcon Icon="@Icons.Material.Filled.Payments" /></div>
            </button>
        }
        @if (_p.AddComplaint)
        {
            <button class="fab-item" @onclick='() => NavTo("/complaints/form")'>
                <span class="fab-tip">شكوى جديدة</span>
                <div class="fab-icon"><MudIcon Icon="@Icons.Material.Filled.SupportAgent" /></div>
            </button>
        }
        @if (_p.AddInspection)
        {
            <button class="fab-item" @onclick='() => NavTo("/additional-charges")'>
                <span class="fab-tip">رسم معاينة</span>
                <div class="fab-icon"><MudIcon Icon="@Icons.Material.Filled.Search" /></div>
            </button>
        }
    </div>
    <button class="fab-main" @onclick="ToggleFab" title='@(_fabOpen ? "إغلاق" : "إضافة سريعة")'>
        <MudIcon Icon="@(_fabOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.Add)" />
    </button>
</div>
}

<style>
    /* ══════════════════════════════════════════════════════════════
       CSS VARIABLES
    ══════════════════════════════════════════════════════════════ */
    :root {
        --gold:       #D4A853;
        --gold-dark:  #B8912A;
        --gold-light: #F0DBA8;
        --gold-bg:    #FEFBF3;
        --navy:       #1B2A4A;
        --navy-dark:  #0F1D36;
        --navy-light: #2D4A7A;
    }

    /* ══════════════════════════════════════════════════════════════
       ANIMATIONS
    ══════════════════════════════════════════════════════════════ */
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@keyframes float {
        0%, 100% { transform: translateY(0); }
        50%      { transform: translateY(-15px); }
    }
    @@keyframes floatDelayed {
        0%, 100% { transform: translateY(0) translateX(0); }
        50%      { transform: translateY(-20px) translateX(10px); }
    }
    @@keyframes pulseSlow {
        0%, 100% { opacity: 0.5; transform: scale(1); }
        50%      { opacity: 0.8; transform: scale(1.1); }
    }
    @@keyframes pulseGlow {
        0%, 100% { box-shadow: 0 0 0 0 rgba(212,168,83,0.4); }
        50%      { box-shadow: 0 0 25px 8px rgba(212,168,83,0.15); }
    }
    @@keyframes shimmer {
        0%   { transform: translateX(-100%); }
        100% { transform: translateX(100%); }
    }
    @@keyframes bounceSoft {
        0%, 100% { transform: translateY(0); }
        50%      { transform: translateY(-3px); }
    }
    @@keyframes loadingDots {
        0%, 80%, 100% { transform: scale(0); opacity: 0; }
        40%           { transform: scale(1); opacity: 1; }
    }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    .animate-card {
        animation: fadeInUp 0.5s ease-out backwards;
        animation-delay: var(--delay, 0s);
    }

    /* ══════════════════════════════════════════════════════════════
       LOADING
    ══════════════════════════════════════════════════════════════ */
    .loading-screen {
        display: flex; align-items: center;
        justify-content: center; min-height: 70vh;
    }
    .loading-content { text-align: center; }
    .loading-spinner-box {
        width: 80px; height: 80px;
        margin: 0 auto 1rem;
        display: flex; align-items: center; justify-content: center;
    }
    .loading-text { color: var(--mud-palette-text-secondary); }
    .loading-dots {
        display: flex; justify-content: center;
        gap: .5rem; margin-top: 1rem;
    }
    .loading-dots span {
        width: 10px; height: 10px;
        background: var(--gold); border-radius: 50%;
        animation: loadingDots 1.4s infinite ease-in-out both;
    }
    .loading-dots span:nth-child(1) { animation-delay: -.32s; }
    .loading-dots span:nth-child(2) { animation-delay: -.16s; }

    /* ══════════════════════════════════════════════════════════════
       PAGE
    ══════════════════════════════════════════════════════════════ */
    .home-page {
        position: relative;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 1.5rem 120px;
    }

    /* ══════════════════════════════════════════════════════════════
       BACKGROUND ORBS
    ══════════════════════════════════════════════════════════════ */
    .page-bg-decorations {
        position: fixed; inset: 0;
        pointer-events: none; overflow: hidden; z-index: 0;
    }
    .bg-orb { position: absolute; border-radius: 50%; filter: blur(80px); }
    .bg-orb-1 {
        width: 400px; height: 400px; top: -150px; right: -150px;
        background: radial-gradient(circle, rgba(212,168,83,.12), transparent 70%);
    }
    .bg-orb-2 {
        width: 350px; height: 350px; bottom: -100px; left: -100px;
        background: radial-gradient(circle, rgba(59,130,246,.08), transparent 70%);
    }
    .bg-orb-3 {
        width: 250px; height: 250px; top: 30%; right: 40%;
        background: radial-gradient(circle, rgba(139,92,246,.05), transparent 70%);
    }

    /* ══════════════════════════════════════════════════════════════
       TOP ACCENT BAR
    ══════════════════════════════════════════════════════════════ */
    .top-accent-bar {
        height: 5px;
        background: linear-gradient(90deg, var(--gold), var(--gold-dark), var(--gold));
        position: relative; overflow: hidden;
        margin-bottom: 1.5rem;
        border-radius: 0 0 10px 10px;
    }
    .accent-shimmer {
        position: absolute; inset: 0;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,.4), transparent);
        animation: shimmer 3s ease-in-out infinite;
    }

    /* ══════════════════════════════════════════════════════════════
       PREMIUM HEADER
    ══════════════════════════════════════════════════════════════ */
    .home-header {
        position: relative; border-radius: 24px;
        overflow: hidden; margin-bottom: 1.5rem;
        animation: fadeInUp .5s ease-out;
    }
    .header-bg { position: absolute; inset: 0; }
    .header-gradient {
        position: absolute; inset: 0;
        background: linear-gradient(135deg, var(--navy-dark) 0%, var(--navy) 40%, var(--navy-light) 100%);
    }
    .header-orbs { position: absolute; inset: 0; overflow: hidden; }
    .header-orb { position: absolute; border-radius: 50%; }
    .header-orb.orb-1 {
        width: 400px; height: 400px; top: -180px; right: -120px;
        background: radial-gradient(circle, rgba(212,168,83,.25), transparent 60%);
        animation: float 8s ease-in-out infinite;
    }
    .header-orb.orb-2 {
        width: 300px; height: 300px; bottom: -120px; left: 15%;
        background: radial-gradient(circle, rgba(212,168,83,.15), transparent 60%);
        animation: floatDelayed 10s ease-in-out infinite;
    }
    .header-orb.orb-3 {
        width: 180px; height: 180px; top: 25%; left: 8%;
        background: radial-gradient(circle, rgba(255,255,255,.05), transparent 60%);
        animation: pulseSlow 6s ease-in-out infinite;
    }
    .header-grid {
        position: absolute; inset: 0;
        background-image:
            linear-gradient(rgba(255,255,255,.02) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,.02) 1px, transparent 1px);
        background-size: 40px 40px;
    }
    .header-content {
        position: relative; z-index: 2;
        padding: 2rem 2.5rem;
    }
    .header-top {
        display: flex; align-items: center;
        justify-content: space-between;
        flex-wrap: wrap; gap: 1.5rem;
        margin-bottom: 2rem;
    }
    .header-info { display: flex; align-items: center; gap: 1.25rem; }
    .header-icon-wrapper { position: relative; }
    .header-icon-glow {
        position: absolute; inset: -10px;
        background: var(--gold); border-radius: 20px;
        filter: blur(20px); opacity: .3;
        animation: pulseGlow 4s ease-in-out infinite;
    }
    .header-icon {
        position: relative; width: 64px; height: 64px;
        background: rgba(255,255,255,.1);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 20px;
        display: flex; align-items: center; justify-content: center;
        color: var(--gold); box-shadow: 0 8px 32px rgba(0,0,0,.2);
    }
    .header-icon::before {
        content: ''; position: absolute; inset: 0;
        border-radius: 20px;
        background: linear-gradient(135deg, rgba(255,255,255,.2), transparent 50%);
        pointer-events: none;
    }
    .greet-emoji { font-size: 2rem; line-height: 1; }
    .header-icon-badge {
        position: absolute; top: -6px; right: -6px;
        width: 24px; height: 24px;
        background: linear-gradient(135deg, var(--gold), var(--gold-dark));
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        color: white; box-shadow: 0 4px 12px rgba(212,168,83,.4);
        animation: bounceSoft 2s ease-in-out infinite;
    }
    .header-icon-badge ::deep .mud-icon-root { font-size: 12px !important; }
    .header-icon-badge-secondary {
        position: absolute; bottom: -4px; left: -4px;
        width: 20px; height: 20px;
        background: linear-gradient(135deg, #10b981, #059669);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        color: white; box-shadow: 0 4px 12px rgba(16,185,129,.4);
        opacity: 0; transform: scale(.8);
        transition: all .3s ease;
    }
    .header-icon-wrapper:hover .header-icon-badge-secondary {
        opacity: 1; transform: scale(1);
    }
    .header-icon-badge-secondary ::deep .mud-icon-root { font-size: 10px !important; }
    .header-text h1 {
        margin: 0; font-size: 1.8rem; font-weight: 900;
        color: white; letter-spacing: -.5px;
    }
    .header-title-row {
        display: flex; align-items: center;
        gap: .75rem; flex-wrap: wrap;
    }
    .premium-badge {
        display: inline-flex; align-items: center; gap: .35rem;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(212,168,83,.3);
        color: var(--gold);
        font-size: .7rem; font-weight: 700;
        padding: .3rem .6rem; border-radius: 20px;
    }
    .premium-badge ::deep .mud-icon-root { font-size: 10px !important; }
    .header-text p {
        margin: .5rem 0 0; font-size: .9rem;
        color: rgba(255,255,255,.6);
        display: flex; align-items: center; gap: .5rem;
    }
    .subtitle-icon { color: #10b981 !important; font-size: 16px !important; }

    /* ══════════════════════════════════════════════════════════════
       STATS GRID (inside header)
    ══════════════════════════════════════════════════════════════ */
    .stats-grid { display: flex; gap: 1rem; flex-wrap: wrap; }
    .stat-card {
        position: relative;
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 16px; padding: 1rem 1.25rem;
        display: flex; align-items: center; gap: .875rem;
        flex: 1; min-width: 150px; overflow: hidden;
        transition: all .4s ease; cursor: pointer;
    }
    .stat-card:hover {
        background: rgba(255,255,255,.1);
        transform: translateY(-3px);
        border-color: rgba(212,168,83,.3);
    }
    .stat-glow {
        position: absolute; inset: -50%;
        opacity: 0; transition: opacity .5s ease;
        pointer-events: none;
    }
    .stat-card:hover .stat-glow { opacity: 1; }
    .stat-accent {
        position: absolute; top: 0; left: 0; right: 0; height: 3px;
        transform: scaleX(0); transform-origin: right;
        transition: transform .4s ease;
    }
    .stat-card:hover .stat-accent { transform: scaleX(1); }
    .stat-content {
        position: relative; z-index: 2;
        display: flex; align-items: center; gap: .75rem;
    }
    .stat-icon-box {
        width: 46px; height: 46px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0; transition: transform .3s ease;
    }
    .stat-card:hover .stat-icon-box { transform: scale(1.1); }
    .stat-data { min-width: 0; }
    .stat-value-row { display: flex; align-items: center; gap: .5rem; }
    .stat-value {
        font-size: 1.5rem; font-weight: 900;
        color: #ffffff; line-height: 1;
        font-variant-numeric: tabular-nums;
        text-shadow: 0 1px 3px rgba(0,0,0,.25);
    }
    /* حجم ديناميكي حسب طول الرقم */
    .stat-value.val-sm  { font-size: 1.15rem; }
    .stat-value.val-md  { font-size: 1.3rem; }
    .stat-value.val-num { font-size: 1.5rem; }
    .stat-percent {
        font-size: .65rem; font-weight: 700;
        background: rgba(16,185,129,.2); color: #10b981;
        padding: .15rem .4rem; border-radius: 6px;
    }
    .stat-percent.warn { background: rgba(245,158,11,.2); color: #f59e0b; }
    .stat-trend {
        display: inline-flex; align-items: center; gap: .15rem;
        font-size: .6rem; font-weight: 700;
        padding: .15rem .4rem; border-radius: 6px;
    }
    .stat-trend ::deep .mud-icon-root { font-size: 10px !important; }
    .stat-trend.trend-up   { background: rgba(16,185,129,.2); color: #10b981; }
    .stat-trend.trend-down { background: rgba(239,68,68,.2);  color: #ef4444; }
    .stat-label {
        font-size: .72rem; font-weight: 600;
        color: rgba(241,245,249,.6); margin-top: .15rem;
    }

    /* Stat color themes */
    .stat-sales     .stat-glow    { background: radial-gradient(circle, rgba(16,185,129,.2), transparent 70%); }
    .stat-sales     .stat-accent  { background: linear-gradient(90deg, #10b981, #059669); }
    .stat-sales     .stat-icon-box { background: rgba(16,185,129,.15); color: #10b981; }
    .stat-quotes    .stat-glow    { background: radial-gradient(circle, rgba(139,92,246,.2), transparent 70%); }
    .stat-quotes    .stat-accent  { background: linear-gradient(90deg, #8b5cf6, #7c3aed); }
    .stat-quotes    .stat-icon-box { background: rgba(139,92,246,.15); color: #8b5cf6; }
    .stat-customers .stat-glow    { background: radial-gradient(circle, rgba(59,130,246,.2), transparent 70%); }
    .stat-customers .stat-accent  { background: linear-gradient(90deg, #3b82f6, #2563eb); }
    .stat-customers .stat-icon-box { background: rgba(59,130,246,.15); color: #3b82f6; }
    .stat-cash      .stat-glow    { background: radial-gradient(circle, rgba(212,168,83,.2), transparent 70%); }
    .stat-cash      .stat-accent  { background: linear-gradient(90deg, var(--gold), var(--gold-dark)); }
    .stat-cash      .stat-icon-box { background: rgba(212,168,83,.15); color: var(--gold); }
    .stat-products  .stat-glow    { background: radial-gradient(circle, rgba(139,92,246,.2), transparent 70%); }
    .stat-products  .stat-accent  { background: linear-gradient(90deg, #8b5cf6, #6d28d9); }
    .stat-products  .stat-icon-box { background: rgba(139,92,246,.15); color: #8b5cf6; }
    .stat-hr        .stat-glow    { background: radial-gradient(circle, rgba(236,72,153,.2), transparent 70%); }
    .stat-hr        .stat-accent  { background: linear-gradient(90deg, #ec4899, #db2777); }
    .stat-hr        .stat-icon-box { background: rgba(236,72,153,.15); color: #ec4899; }
    .stat-expenses  .stat-glow    { background: radial-gradient(circle, rgba(249,115,22,.2), transparent 70%); }
    .stat-expenses  .stat-accent  { background: linear-gradient(90deg, #f97316, #ea580c); }
    .stat-expenses  .stat-icon-box { background: rgba(249,115,22,.15); color: #f97316; }

    /* ── Chart Period Toggle ── */
    .chart-controls {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: .75rem;
    }
    .chart-summary-pills {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: .5rem;
    }
    .chart-pill {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .45rem .75rem;
        border-radius: 999px;
        border: 1px solid var(--mud-palette-divider);
        background: var(--mud-palette-background);
        color: var(--mud-palette-text-secondary);
        font-size: .76rem;
        font-weight: 700;
        white-space: nowrap;
    }
    .chart-pill strong {
        font-size: .88rem;
        font-weight: 900;
        color: var(--mud-palette-text-primary);
        font-variant-numeric: tabular-nums;
    }
    .chart-pill.sales {
        background: linear-gradient(135deg, rgba(16,185,129,.12), rgba(16,185,129,.05));
        border-color: rgba(16,185,129,.22);
        color: #047857;
    }
    .chart-pill.expenses {
        background: linear-gradient(135deg, rgba(239,68,68,.12), rgba(239,68,68,.05));
        border-color: rgba(239,68,68,.2);
        color: #b91c1c;
    }
    .chart-pill.net.positive {
        background: linear-gradient(135deg, rgba(14,165,233,.12), rgba(59,130,246,.05));
        border-color: rgba(37,99,235,.18);
        color: #1d4ed8;
    }
    .chart-pill.net.negative {
        background: linear-gradient(135deg, rgba(249,115,22,.12), rgba(239,68,68,.05));
        border-color: rgba(234,88,12,.18);
        color: #c2410c;
    }
    .period-toggle {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        background: linear-gradient(135deg, rgba(15,23,42,.05), rgba(15,23,42,.02));
        border: 1px solid rgba(148,163,184,.18);
        border-radius: 14px;
        padding: 4px;
        gap: 4px;
    }
    .period-btn {
        padding: .42rem .8rem;
        min-width: 74px;
        border: none;
        border-radius: 10px;
        font-size: .75rem;
        font-weight: 800;
        cursor: pointer;
        background: transparent;
        color: #64748b;
        transition: all .2s ease;
        font-family: inherit;
    }
    .period-btn:hover {
        color: #0f172a;
        background: rgba(255,255,255,.65);
    }
    .period-btn.active {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
        box-shadow: 0 8px 16px rgba(16,185,129,.22);
    }

    /* ══════════════════════════════════════════════════════════════
       QUICK ACCESS
    ══════════════════════════════════════════════════════════════ */
    .quick-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
        gap: .75rem;
    }
    .quick-btn {
        display: flex; flex-direction: column; align-items: center;
        gap: .5rem; padding: 1rem .5rem;
        border: 1.5px solid var(--mud-palette-divider);
        border-radius: 12px;
        background: var(--mud-palette-background);
        cursor: pointer; transition: all .2s ease;
        font-size: .8rem; font-weight: 700;
        color: var(--mud-palette-text-primary);
        font-family: inherit;
    }
    .quick-btn:hover {
        border-color: var(--qc);
        color: var(--qc);
        transform: translateY(-3px);
        box-shadow: 0 6px 16px color-mix(in srgb, var(--qc) 20%, transparent);
    }
    .quick-btn-icon {
        width: 44px; height: 44px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        background: color-mix(in srgb, var(--qc) 12%, transparent);
        color: var(--qc); transition: transform .2s;
    }
    .quick-btn:hover .quick-btn-icon { transform: scale(1.1); }
    .quick-btn-icon .mud-icon-root { font-size: 1.3rem !important; }

    /* ══════════════════════════════════════════════════════════════
       FOCUS / PRIORITIES
    ══════════════════════════════════════════════════════════════ */
    .focus-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.55fr) minmax(320px, .95fr);
        gap: 1rem;
        margin-bottom: 1.5rem;
        position: relative;
        z-index: 1;
    }
    .focus-side-stack {
        display: grid;
        gap: 1rem;
        align-content: start;
    }
    .focus-side-stack.full-width {
        grid-column: 1 / -1;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
    .focus-icon { background: linear-gradient(135deg, #f59e0b, #f97316); }
    .delivery-widget-icon { background: linear-gradient(135deg, #14b8a6, #0f766e); }
    .crm-widget-icon { background: linear-gradient(135deg, #8b5cf6, #6d28d9); }
    .crm-team-widget-icon { background: linear-gradient(135deg, #0ea5e9, #2563eb); }
    .finance-widget-icon { background: linear-gradient(135deg, #3b82f6, #1d4ed8); }
    .priority-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .75rem;
    }
    .priority-item {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: .75rem;
        width: 100%;
        padding: .9rem 1rem;
        border-radius: 14px;
        border: 1px solid var(--mud-palette-divider);
        background: var(--mud-palette-background);
        color: var(--mud-palette-text-primary);
        cursor: pointer;
        text-align: right;
        font-family: inherit;
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
        border-right: 4px solid transparent;
    }
    .priority-item:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(15,23,42,.08);
    }
    .priority-item.high { border-right-color: #ef4444; }
    .priority-item.medium { border-right-color: #f59e0b; }
    .priority-item.low { border-right-color: #3b82f6; }
    .priority-icon {
        --priority-color: #64748b;
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: color-mix(in srgb, var(--priority-color) 14%, transparent);
        color: var(--priority-color);
    }
    .priority-icon ::deep .mud-icon-root { font-size: 1.35rem !important; }
    .priority-text strong {
        display: block;
        font-size: .9rem;
        font-weight: 800;
        color: var(--mud-palette-text-primary);
    }
    .priority-text small {
        display: block;
        margin-top: .15rem;
        font-size: .76rem;
        color: var(--mud-palette-text-secondary);
    }
    .priority-meta {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: .25rem;
        white-space: nowrap;
    }
    .priority-count {
        min-width: 34px;
        padding: .22rem .55rem;
        border-radius: 999px;
        background: rgba(15,23,42,.06);
        color: var(--mud-palette-text-primary);
        font-size: .78rem;
        font-weight: 900;
        text-align: center;
        font-variant-numeric: tabular-nums;
    }
    .priority-action {
        font-size: .72rem;
        font-weight: 700;
        color: var(--mud-palette-text-secondary);
    }
    .mini-insight-card {
        margin-bottom: 0;
    }
    .mini-card-hdr {
        margin-bottom: .85rem;
    }
    .mini-metrics-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .65rem;
    }
    .mini-metric {
        padding: .8rem .85rem;
        border-radius: 14px;
        border: 1px solid var(--mud-palette-divider);
        background: var(--mud-palette-background);
        display: flex;
        flex-direction: column;
        gap: .25rem;
    }
    .mini-metric span {
        font-size: .74rem;
        font-weight: 700;
        color: var(--mud-palette-text-secondary);
    }
    .mini-metric strong {
        font-size: 1rem;
        font-weight: 900;
        color: var(--mud-palette-text-primary);
        font-variant-numeric: tabular-nums;
    }
    .mini-metric.info {
        background: linear-gradient(135deg, rgba(59,130,246,.08), rgba(59,130,246,.03));
        border-color: rgba(59,130,246,.15);
    }
    .mini-metric.success {
        background: linear-gradient(135deg, rgba(16,185,129,.08), rgba(16,185,129,.03));
        border-color: rgba(16,185,129,.15);
    }
    .mini-metric.warning {
        background: linear-gradient(135deg, rgba(245,158,11,.1), rgba(245,158,11,.04));
        border-color: rgba(245,158,11,.18);
    }
    .mini-metric.danger {
        background: linear-gradient(135deg, rgba(239,68,68,.09), rgba(239,68,68,.03));
        border-color: rgba(239,68,68,.16);
    }
    .crm-empty-note {
        display: flex;
        align-items: center;
        gap: .55rem;
        padding: .9rem 1rem;
        border-radius: 14px;
        background: rgba(245,158,11,.08);
        border: 1px solid rgba(245,158,11,.16);
        color: #92400e;
        font-size: .8rem;
        font-weight: 700;
        line-height: 1.6;
    }
    .crm-empty-note ::deep .mud-icon-root {
        color: #f59e0b;
        flex-shrink: 0;
    }
    .crm-empty-note.error-note {
        background: rgba(239,68,68,.08);
        border-color: rgba(239,68,68,.16);
        color: #991b1b;
    }
    .crm-empty-note.error-note ::deep .mud-icon-root {
        color: #ef4444;
    }
    .crm-quick-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        margin: .85rem 0;
    }
    .crm-action-btn {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        border: 1px solid var(--mud-palette-divider);
        background: var(--mud-palette-surface);
        color: var(--mud-palette-text-primary);
        border-radius: 10px;
        padding: .45rem .75rem;
        font-size: .74rem;
        font-weight: 800;
        font-family: inherit;
        cursor: pointer;
        transition: all .18s ease;
    }
    .crm-action-btn:hover {
        border-color: #8b5cf6;
        color: #6d28d9;
        background: rgba(139,92,246,.05);
        transform: translateY(-1px);
    }
    .crm-followup-list {
        display: flex;
        flex-direction: column;
        gap: .55rem;
    }
    .crm-followup-item {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: .65rem;
        width: 100%;
        padding: .75rem .85rem;
        border-radius: 14px;
        border: 1px solid var(--mud-palette-divider);
        background: var(--mud-palette-background);
        cursor: pointer;
        text-align: right;
        font-family: inherit;
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
        border-right: 4px solid transparent;
    }
    .crm-followup-item:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(15,23,42,.07);
    }
    .crm-followup-item.overdue { border-right-color: #ef4444; }
    .crm-followup-item.today { border-right-color: #f59e0b; }
    .crm-followup-item.upcoming { border-right-color: #3b82f6; }
    .crm-followup-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .crm-followup-icon.client {
        background: rgba(59,130,246,.12);
        color: #2563eb;
    }
    .crm-followup-icon.lead {
        background: rgba(236,72,153,.12);
        color: #db2777;
    }
    .crm-followup-title-row {
        display: flex;
        align-items: center;
        gap: .45rem;
        flex-wrap: wrap;
    }
    .crm-followup-title-row strong {
        font-size: .88rem;
        font-weight: 800;
        color: var(--mud-palette-text-primary);
    }
    .crm-followup-type {
        display: inline-flex;
        align-items: center;
        padding: .15rem .45rem;
        border-radius: 999px;
        background: rgba(15,23,42,.06);
        color: var(--mud-palette-text-secondary);
        font-size: .67rem;
        font-weight: 800;
    }
    .crm-followup-text small {
        display: block;
        margin-top: .15rem;
        color: var(--mud-palette-text-secondary);
        font-size: .75rem;
        line-height: 1.5;
    }
    .crm-followup-meta {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: .3rem;
        white-space: nowrap;
    }
    .crm-followup-meta small {
        color: var(--mud-palette-text-secondary);
        font-size: .7rem;
        font-weight: 700;
    }
    .crm-due-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: .2rem .5rem;
        border-radius: 999px;
        font-size: .68rem;
        font-weight: 900;
        border: 1px solid transparent;
    }
    .crm-due-badge.overdue {
        background: rgba(239,68,68,.1);
        color: #b91c1c;
        border-color: rgba(239,68,68,.16);
    }
    .crm-due-badge.today {
        background: rgba(245,158,11,.12);
        color: #b45309;
        border-color: rgba(245,158,11,.16);
    }
    .crm-due-badge.upcoming {
        background: rgba(59,130,246,.1);
        color: #1d4ed8;
        border-color: rgba(59,130,246,.16);
    }
    .compact-empty-state {
        padding: 1.2rem .75rem;
    }
    .crm-empty-state-box {
        margin-top: .25rem;
    }
    .team-member-list {
        display: flex;
        flex-direction: column;
        gap: .55rem;
        margin-top: .85rem;
    }
    .team-member-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        padding: .75rem .85rem;
        border-radius: 14px;
        border: 1px solid var(--mud-palette-divider);
        background: var(--mud-palette-background);
    }
    .team-member-main {
        min-width: 0;
    }
    .team-member-main strong {
        display: block;
        font-size: .86rem;
        font-weight: 800;
        color: var(--mud-palette-text-primary);
    }
    .team-member-main small {
        display: block;
        margin-top: .18rem;
        color: var(--mud-palette-text-secondary);
        font-size: .74rem;
        line-height: 1.45;
    }
    .team-count-cluster {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: .35rem;
    }
    .team-count-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: .18rem .48rem;
        border-radius: 999px;
        font-size: .68rem;
        font-weight: 900;
        border: 1px solid transparent;
        white-space: nowrap;
    }
    .team-count-badge.danger {
        background: rgba(239,68,68,.1);
        color: #b91c1c;
        border-color: rgba(239,68,68,.16);
    }
    .team-count-badge.warning {
        background: rgba(245,158,11,.12);
        color: #b45309;
        border-color: rgba(245,158,11,.16);
    }
    .team-count-badge.info {
        background: rgba(59,130,246,.1);
        color: #1d4ed8;
        border-color: rgba(59,130,246,.16);
    }
    .team-count-badge.hidden-badge {
        opacity: .45;
    }

    /* ══════════════════════════════════════════════════════════════
       CONTENT CARDS
    ══════════════════════════════════════════════════════════════ */
    .content-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem; margin-bottom: 1.5rem;
        position: relative; z-index: 1;
    }
    .attention-chart-row {
        grid-template-columns: minmax(320px, .9fr) minmax(0, 1.7fr);
