@page "/inventory/stock-entry"
@page "/inventory/opening-balance"

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@attribute [Authorize]

@inject IStockService StockService
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>إضافة رصيد للمخزن</PageTitle>

@if (_isLoading)
{
    <div class="stock-loading-wrap">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h6" Class="mt-4">جاري تحميل شاشة الرصيد الافتتاحي...</MudText>
    </div>
}
else if (!_canView)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="ma-4">
        غير مسموح لك بعرض هذه الشاشة.
    </MudAlert>
}
else
{
    <div class="stock-page" dir="rtl">
        <div class="stock-hero">
            <div class="stock-hero-bg"></div>
            <div class="stock-hero-content">
                <div>
                    <h1>إضافة رصيد للمخزن</h1>
                    <p>أضف المنتج فعليًا إلى صالة العرض أو المخزن وحدد الكمية والمبرر بشكل واضح.</p>
                </div>
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack">
                    رجوع
                </MudButton>
            </div>
        </div>

        <MudGrid Spacing="3" Class="mt-1">
            <MudItem xs="12" lg="8">
                <MudPaper Class="stock-form-card" Elevation="0">
                    <div class="section-header">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
                        <div>
                            <h3>بيانات الإضافة</h3>
                            <p>اختر الفرع ثم المخزن ثم المنتج الذي تريد إضافته فعليًا للموقع.</p>
                        </div>
                    </div>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="6">
                            <MudSelect T="int?" Label="الفرع *" Variant="Variant.Outlined" Dense="true"
                                       Value="_form.BranchId" ValueChanged="OnBranchChanged">
                                @foreach (var branch in _branches)
                                {
                                    <MudSelectItem T="int?" Value="@((int?)branch.BranchId)">@branch.BranchNameAr</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudSelect T="int?" Label="المخزن *" Variant="Variant.Outlined" Dense="true"
                                       Value="_form.WarehouseId" ValueChanged="OnWarehouseChanged" Disabled="@(!_warehouses.Any())">
                                @foreach (var warehouse in _warehouses)
                                {
                                    <MudSelectItem T="int?" Value="@((int?)warehouse.WarehouseId)">@warehouse.WarehouseName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12">
                            <MudAutocomplete T="StockProductLookupDto"
                                             Label="المنتج (منتجات المعرض فقط) *"
                                             Variant="Variant.Outlined"
                                             Dense="true"
                                             Value="_selectedProduct"
                                             ValueChanged="OnProductChanged"
                                             SearchFunc="SearchProductsAsync"
                                             ToStringFunc="@(p => p == null ? string.Empty : $"{p.ProductName} {(p.HasCustomer ? $"- {p.CustomerName}" : "- منتج معرض")}")"
                                             Clearable="true"
                                             ResetValueOnEmptyText="true">
                                <ItemTemplate Context="product">
                                    <div class="stock-product-item">
                                        <div>
                                            <strong>@product.ProductName</strong>
                                            <div class="stock-product-sub">@(product.HasCustomer ? $"مرتبط بالعميل: {product.CustomerName}" : "منتج معرض / بدون عميل")</div>
                                        </div>
                                        <span class="stock-product-badge">#@product.ProductId</span>
                                    </div>
                                </ItemTemplate>
                            </MudAutocomplete>
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudNumericField T="int" Label="الكمية *" Variant="Variant.Outlined" Dense="true" Min="1" @bind-Value="_form.Quantity" />
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudNumericField T="decimal?" Label="التكلفة المرجعية" Variant="Variant.Outlined" Dense="true" Min="0" @bind-Value="_form.UnitPrice" />
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudSelect T="string" Label="سبب الحركة *" Variant="Variant.Outlined" Dense="true" @bind-Value="_form.EntryReason">
                                <MudSelectItem T="string" Value='@("OpeningBalance")'>رصيد افتتاحي</MudSelectItem>
                                <MudSelectItem T="string" Value='@("ShowroomSupply")'>إدخال للمخزن / صالة العرض</MudSelectItem>
                                <MudSelectItem T="string" Value='@("FactoryReceive")'>استلام من المصنع</MudSelectItem>
                                <MudSelectItem T="string" Value='@("Adjustment")'>تسوية مخزنية</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField T="string" Label="ملاحظات" Variant="Variant.Outlined" Dense="true" Lines="3" @bind-Value="_form.Notes" />
                        </MudItem>
                    </MudGrid>

                    <MudDivider Class="my-4" />

                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                        <MudButton Variant="Variant.Text" OnClick="ResetForm">مسح النموذج</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_isSaving" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">
                            @(_isSaving ? "جاري الحفظ..." : "حفظ الإضافة")
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="4">
                <MudStack Spacing="2">
                    <MudPaper Class="stock-side-card" Elevation="0">
                        <div class="section-header compact">
                            <MudIcon Icon="@Icons.Material.Filled.Info" />
                            <div>
                                <h3>الرصيد الحالي</h3>
                                <p>قبل الحفظ</p>
                            </div>
                        </div>

                        <div class="stock-stat-box">
                            <span class="stock-stat-label">الرصيد الحالي في المخزن المختار</span>
                            <strong class="stock-stat-value">@_currentStock</strong>
                        </div>

                        @if (_selectedProduct != null)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                                المنتج المختار: <strong>@_selectedProduct.ProductName</strong>
                            </MudAlert>
                        }
                    </MudPaper>

                    <MudPaper Class="stock-side-card" Elevation="0">
                        <div class="section-header compact">
                            <MudIcon Icon="@Icons.Material.Filled.TipsAndUpdates" />
                            <div>
                                <h3>طريقة العمل الصحيحة</h3>
                                <p>علشان تعرف المنتج تبع أي فرع / معرض</p>
                            </div>
                        </div>

                        <ul class="stock-tips">
                            <li>كوّد المنتج أولًا من شاشة المنتجات.</li>
                            <li>هذه الشاشة مخصصة لمنتجات المعرض فقط، وليست لمنتجات العملاء المخصصة.</li>
                            <li>اختر الفرع ثم صالة العرض / المخزن المناسب.</li>
                            <li>أدخل الكمية الفعلية الموجودة في المكان المختار.</li>
                            <li>بعد الحفظ سيظهر المنتج داخل هذا الفرع/المخزن في شاشة المنتجات.</li>
                        </ul>
                    </MudPaper>
                </MudStack>
            </MudItem>
        </MudGrid>
    </div>
}

<style>
    .stock-loading-wrap {
        min-height: 50vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .stock-page {
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .stock-hero {
        position: relative;
        overflow: hidden;
        border-radius: 22px;
        background: linear-gradient(135deg,#0f172a 0%,#1e293b 100%);
        color: white;
        box-shadow: 0 16px 45px rgba(15,23,42,.18);
    }

    .stock-hero-bg {
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at 15% 20%, rgba(56,189,248,.22), transparent 35%),
            radial-gradient(circle at 85% 80%, rgba(34,197,94,.16), transparent 30%);
    }

    .stock-hero-content {
        position: relative;
        z-index: 1;
        padding: 1.4rem 1.6rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .stock-hero h1 {
        margin: 0;
        font-size: 1.55rem;
        font-weight: 800;
    }

    .stock-hero p {
        margin: .3rem 0 0;
        color: rgba(255,255,255,.82);
    }

    .stock-form-card, .stock-side-card {
        border-radius: 18px;
        background: white;
        border: 1px solid rgba(226,232,240,.9);
        box-shadow: 0 14px 28px rgba(15,23,42,.05);
        padding: 1rem;
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: .75rem;
        margin-bottom: 1rem;
    }

    .section-header.compact { margin-bottom: .8rem; }

    .section-header h3 {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 800;
        color: #0f172a;
    }

    .section-header p {
        margin: .15rem 0 0;
        color: #64748b;
        font-size: .82rem;
    }

    .stock-product-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        width: 100%;
    }

    .stock-product-sub {
        color: #64748b;
        font-size: .78rem;
    }

    .stock-product-badge {
        background: rgba(59,130,246,.12);
        color: #2563eb;
        padding: .2rem .55rem;
        border-radius: 999px;
        font-weight: 800;
        font-size: .75rem;
    }

    .stock-stat-box {
        border-radius: 16px;
        background: linear-gradient(135deg, #eff6ff, #f8fafc);
        padding: 1rem;
        border: 1px solid rgba(59,130,246,.12);
    }

    .stock-stat-label {
        display: block;
        color: #64748b;
        font-size: .85rem;
        margin-bottom: .35rem;
    }

    .stock-stat-value {
        font-size: 2rem;
        font-weight: 900;
        color: #0f172a;
    }

    .stock-tips {
        margin: 0;
        padding-right: 1rem;
        color: #475569;
        line-height: 1.8;
        font-size: .92rem;
    }
</style>

@code {
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _canView;
    private string _currentUserName = "system";

    private StockEntryFormDto _form = new() { Quantity = 1, EntryReason = "OpeningBalance" };
    private StockProductLookupDto? _selectedProduct;
    private List<BranchListDto> _branches = new();
    private List<WarehouseListDto> _warehouses = new();
    private int _currentStock;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        _currentUserName = user.Identity?.Name ?? "system";
        _canView = user.IsInRole("Admin")
            || user.IsInRole(SystemRoles.Admin)
            || user.IsInRole(SystemRoles.GeneralManager)
            || user.IsInRole(SystemRoles.AccountManager)
            || user.IsInRole(SystemRoles.ProductionManager)
            || user.IsInRole("factory");

        if (!_canView)
        {
            _isLoading = false;
            return;
        }

        _branches = await StockService.GetBranchesAsync();
        _isLoading = false;
    }

    private async Task OnBranchChanged(int? value)
    {
        _form.BranchId = value;
        _form.WarehouseId = null;
        _currentStock = 0;
        _warehouses = await StockService.GetWarehousesAsync(value);
    }

    private async Task OnWarehouseChanged(int? value)
    {
        _form.WarehouseId = value;
        await RefreshCurrentStockAsync();
    }

    private async Task<IEnumerable<StockProductLookupDto>> SearchProductsAsync(string? value, CancellationToken token)
    {
        return await StockService.SearchProductsAsync(value, 30);
    }

    private async Task OnProductChanged(StockProductLookupDto? product)
    {
        _selectedProduct = product;
        _form.ProductId = product?.ProductId;
        await RefreshCurrentStockAsync();
    }

    private async Task RefreshCurrentStockAsync()
    {
        if (_form.ProductId.HasValue && _form.WarehouseId.HasValue)
            _currentStock = await StockService.GetCurrentStockAsync(_form.ProductId.Value, _form.WarehouseId.Value);
        else
            _currentStock = 0;
    }

    private async Task SaveAsync()
    {
        if (!_form.BranchId.HasValue)
        {
            Snackbar.Add("اختيار الفرع مطلوب", Severity.Warning);
            return;
        }

        if (!_form.WarehouseId.HasValue)
        {
            Snackbar.Add("اختيار المخزن مطلوب", Severity.Warning);
            return;
        }

        if (!_form.ProductId.HasValue || _selectedProduct == null)
        {
            Snackbar.Add("اختيار المنتج مطلوب", Severity.Warning);
            return;
        }

        if (_form.Quantity <= 0)
        {
            Snackbar.Add("الكمية يجب أن تكون أكبر من صفر", Severity.Warning);
            return;
        }

        _isSaving = true;
        try
        {
            var result = await StockService.AddStockEntryAsync(_form, _currentUserName);
            Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);

            if (result.Success)
            {
                _currentStock = result.NewQuantity ?? _currentStock;
                ResetForm();
                _warehouses = _form.BranchId.HasValue ? await StockService.GetWarehousesAsync(_form.BranchId) : new();
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ResetForm()
    {
        var branchId = _form.BranchId;
        var warehouseId = _form.WarehouseId;
        _form = new StockEntryFormDto
        {
            BranchId = branchId,
            WarehouseId = warehouseId,
            Quantity = 1,
            EntryReason = "OpeningBalance"
        };
        _selectedProduct = null;
        _currentStock = 0;
    }

    private void GoBack() => Navigation.NavigateTo("/products");
}
