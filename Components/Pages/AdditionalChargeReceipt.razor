@page "/additional-charges/{Id:int}/receipt"
@layout COCOBOLOERPNEW.Components.Layout.EmptyLayout

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services

@inject IAdditionalChargeService ChargeService
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (_isLoading)
{
    <div class="loading-container">
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
    </div>
}
else if (_data == null)
{
    <div class="not-found">
        <h2>الإيصال غير موجود</h2>
    </div>
}
else
{
    <div class="print-actions no-print">
        <button class="btn-action btn-print" @onclick="PrintNow">🖨️ طباعة</button>
        <button class="btn-action btn-back" @onclick="GoBack">← رجوع</button>
    </div>

    <div class="print-page">
        <div class="content" dir="rtl">
            <div class="invoice-top-meta">
                <div class="meta-type">@_data.ReceiptTypeAr</div>
                <div class="meta-number">@_data.ReceiptNumber</div>
                <div class="meta-date">@_data.ReceiptDate.ToString("yyyy/MM/dd")</div>
            </div>

            <div class="party-grid">
                <div class="party-box">
                    <h3>بيانات العميل</h3>
                    <div class="party-line"><strong>الاسم:</strong> @_data.PartyName</div>
                    @if (!string.IsNullOrWhiteSpace(_data.PartyPhone))
                    {
                        <div class="party-line"><strong>الهاتف:</strong> @_data.PartyPhone</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_data.CustomerCity))
                    {
                        <div class="party-line"><strong>المدينة:</strong> @_data.CustomerCity</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_data.CustomerAddress))
                    {
                        <div class="party-line"><strong>العنوان:</strong> @_data.CustomerAddress</div>
                    }
                </div>

                <div class="party-box">
                    <h3>تفاصيل السند</h3>
                    <div class="party-line"><strong>نوع العملية:</strong> @_data.ReceiptCategoryLabel</div>
                    <div class="party-line"><strong>الحالة:</strong> <span class="status-badge status-paid">@_data.StatusName</span></div>
                    @if (!string.IsNullOrWhiteSpace(_data.CashBoxName))
                    {
                        <div class="party-line"><strong>الخزينة:</strong> @_data.CashBoxName</div>
                    }
                    <div class="party-line"><strong>أُنشئ بواسطة:</strong> @(_data.CreatedBy ?? "النظام")</div>
                    @if (!string.IsNullOrWhiteSpace(_data.AppliedToReferenceNumber))
                    {
                        <div class="party-line separator-top"><strong>الفاتورة المرتبطة:</strong> @_data.AppliedToReferenceNumber</div>
                    }
                </div>
            </div>

            <div class="receipt-amount-box">
                <div class="receipt-amount-label">المبلغ المستلم</div>
                <div class="receipt-amount-value">@FormatMoney(_data.ChargeAmount) ج.م</div>
                <div class="receipt-amount-words">@_data.AmountInWords</div>
            </div>

            <table class="summary-table receipt-summary-table">
                <tr>
                    <td>رقم السند</td>
                    <td>@_data.ReceiptNumber</td>
                </tr>
                <tr>
                    <td>تاريخ الإصدار</td>
                    <td>@_data.ReceiptDate.ToString("yyyy/MM/dd HH:mm")</td>
                </tr>
                <tr>
                    <td>البند</td>
                    <td>@_data.ReceiptCategoryLabel</td>
                </tr>
                @if (!string.IsNullOrWhiteSpace(_data.ChargeDescription))
                {
                    <tr>
                        <td>البيان</td>
                        <td>@_data.ChargeDescription</td>
                    </tr>
                }
            </table>

            @if (!string.IsNullOrWhiteSpace(_data.Notes))
            {
                <div class="notes-box receipt-notes-box">
                    <strong>ملاحظات:</strong>
                    <p>@_data.Notes</p>
                </div>
            }

            <div class="receipt-legal-box">
                @if (_data.IsInspection)
                {
                    <span>هذا السند يثبت استلام <strong>رسوم المعاينة</strong> من العميل، ويتم التعامل معها طبقًا لسياسة التعاقد المعتمدة بالشركة.</span>
                }
                else if (_data.IsAdvanceLike)
                {
                    <span>هذا السند يثبت استلام <strong>دفعة مقدمة / عربون</strong> من العميل، ويمكن تسويتها لاحقًا على الفاتورة أو التعاقد المرتبط.</span>
                }
                else
                {
                    <span>هذا السند يثبت استلام مبلغ تحت بند <strong>@_data.ReceiptCategoryLabel</strong>.</span>
                }
            </div>

            <div class="receipt-issued-by">
                تم الاستلام بواسطة: <strong>@(_data.CreatedByDisplayName ?? _data.CreatedBy ?? "")</strong>
            </div>

            <div class="signatures signatures-large">
                <div class="signature-box">
                    <div class="signature-line"></div>
                    <div class="signature-label">توقيع المستلم</div>
                    <div class="signature-name">@(_data.CreatedByDisplayName ?? _data.CreatedBy ?? "")</div>
                </div>
                <div class="signature-box">
                    <div class="signature-line"></div>
                    <div class="signature-label">توقيع العميل</div>
                    <div class="signature-name">@_data.PartyName</div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    body {
        margin: 0;
        padding: 0;
        background: #f2f2f2;
        font-family: 'Segoe UI', 'Tajawal', sans-serif;
    }

    .loading-container,
    .not-found {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
    }

    .print-actions {
        position: fixed;
        top: 1rem;
        left: 1rem;
        display: flex;
        gap: .5rem;
        z-index: 9999;
    }

    .btn-action {
        border: none;
        border-radius: 8px;
        padding: .7rem 1.4rem;
        cursor: pointer;
        font-weight: 700;
    }

    .btn-print {
        background: #d4af37;
        color: white;
    }

    .btn-back {
        background: #ddd;
    }

    .print-page {
        width: 210mm;
        height: 297mm;
        margin: 1rem auto;
        position: relative;
        background-image: url('/images/design-background.png');
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center;
        overflow: hidden;
        box-shadow: 0 0 10px rgba(0,0,0,.15);
        box-sizing: border-box;
    }

    .content {
        position: relative;
        height: 100%;
        padding-top: 42mm;
        padding-bottom: 38mm;
        padding-left: 12mm;
        padding-right: 12mm;
        box-sizing: border-box;
    }

    .invoice-top-meta {
        position: absolute;
        top: 14mm;
        left: 14mm;
        width: 52mm;
        text-align: center;
        z-index: 5;
    }

    .meta-type {
        font-size: .95rem;
        font-weight: 700;
        color: #1a2842;
        margin-bottom: .3rem;
    }

    .meta-number {
        font-size: .88rem;
        font-weight: 600;
        color: #444;
        margin-bottom: .2rem;
        letter-spacing: .5px;
    }

    .meta-date {
        font-size: .8rem;
        color: #666;
    }

    .party-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .party-box {
        background: #faf6e8;
        border: 1px solid #d4af3744;
        border-radius: 10px;
        padding: 1rem;
    }

    .party-box h3 {
        margin: 0 0 .45rem 0;
        font-size: .88rem;
        color: #1a2842;
        padding-bottom: .35rem;
        border-bottom: 1px solid #d4af3744;
    }

    .party-line {
        font-size: .76rem;
        margin: .18rem 0;
        line-height: 1.45;
    }

    .separator-top {
        margin-top: .5rem;
        padding-top: .5rem;
        border-top: 1px dashed #ccc;
    }

    .status-badge {
        display: inline-block;
        padding: .2rem .6rem;
        border-radius: 5px;
        font-size: .75rem;
        font-weight: 700;
    }

    .status-paid {
        background: #d4edda;
        color: #155724;
    }

    .receipt-amount-box {
        background: linear-gradient(135deg, #1a2842 0%, #243b63 100%);
        color: white;
        border-radius: 14px;
        padding: 1.2rem 1.4rem;
        margin-bottom: 1rem;
        text-align: center;
        box-shadow: 0 8px 22px rgba(26,40,66,.15);
    }

    .receipt-amount-label {
        font-size: .82rem;
        opacity: .85;
        margin-bottom: .35rem;
    }

    .receipt-amount-value {
        font-size: 2rem;
        font-weight: 900;
        color: #f4d37e;
        line-height: 1.1;
        margin-bottom: .45rem;
    }

    .receipt-amount-words {
        font-size: .86rem;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 10px;
        padding: .6rem .75rem;
        line-height: 1.7;
    }

    .summary-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
    }

    .summary-table td {
        border-bottom: 1px solid #eee;
        padding: .55rem;
        font-size: .84rem;
    }

    .summary-table td:last-child {
        text-align: left;
        font-weight: 700;
    }

    .receipt-summary-table {
        margin-bottom: 1rem;
        border: 1px solid #ddd;
    }

    .notes-box {
        background: #fafafa;
        border-right: 3px solid #d4af37;
        padding: .8rem;
        border-radius: 8px;
    }

    .receipt-notes-box {
        margin-bottom: 1rem;
        min-height: 70px;
    }

    .notes-box p {
        margin: .4rem 0 0;
        line-height: 1.8;
        font-size: .83rem;
    }

    .receipt-legal-box {
        background: #fffaf0;
        border: 1px solid #efd9a2;
        border-radius: 10px;
        padding: .85rem 1rem;
        line-height: 1.8;
        font-size: .82rem;
        color: #3b3b3b;
    }

    .receipt-issued-by {
        margin-top: .75rem;
        font-size: .82rem;
        color: #1a2842;
        text-align: left;
    }

    .signatures {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        margin-top: 2rem;
    }

    .signatures-large {
        width: 80%;
        margin: 2rem auto 0 auto;
    }

    .signature-box {
        text-align: center;
    }

    .signature-line {
        border-top: 1px solid #333;
        margin-top: 2.5rem;
        margin-bottom: .5rem;
    }

    .signature-label {
        font-weight: 700;
    }

    .signature-name {
        margin-top: .3rem;
        color: #666;
        font-size: .8rem;
    }

    @@media print {
        @@page {
            size: A4;
            margin: 0;
        }

        html, body {
            width: 210mm;
            height: auto;
            margin: 0;
            padding: 0;
            background: white;
        }

        .no-print {
            display: none !important;
        }

        .print-page {
            margin: 0;
            box-shadow: none;
            page-break-after: always;
            break-after: page;
        }
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private bool _isLoading = true;
    private AdditionalChargeReceiptDto? _data;

    protected override async Task OnInitializedAsync()
    {
        _data = await ChargeService.GetChargeReceiptAsync(Id);
        _isLoading = false;
    }

    private async Task PrintNow() => await JS.InvokeVoidAsync("window.print");
    private void GoBack() => Navigation.NavigateTo($"/additional-charges/{Id}/edit");
    private string FormatMoney(decimal v) => $"{v:N2}";
}
