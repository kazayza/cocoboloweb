@page "/hr/payroll/bonuses"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using MudBlazor

@inject IPayrollService PayrollService
@inject IEmployeeService EmployeeService
@inject ICashBoxService CashBoxService
@inject IEmployeeLoanService LoanService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider

<PageTitle>دفعات خارج الراتب</PageTitle>

<div class="ob-page">

    <div class="top-accent"><div class="accent-shimmer"></div></div>

    @* ══ (12-H17) Premium Header ══ *@
    <div class="dash-header">
        <div class="dh-bg">
            <div class="dh-gradient"></div>
            <div class="dh-orbs">
                <div class="dh-orb dh-o1"></div>
                <div class="dh-orb dh-o2"></div>
                <div class="dh-orb dh-o3"></div>
            </div>
            <div class="dh-grid"></div>
        </div>
        <div class="dh-content">
            <div class="dh-info">
                <div class="dh-icon-wrap">
                    <div class="dh-icon-glow"></div>
                    <div class="dh-icon">
                        <MudIcon Icon="@Icons.Material.Filled.CardGiftcard" Size="Size.Large" />
                    </div>
                    <div class="dh-badge"><MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" /></div>
                </div>
                <div class="dh-text">
                    <div class="dh-title-row">
                        <h1>حوافز ومكافآت خارج الراتب</h1>
                        <span class="premium-tag">
                            <MudIcon Icon="@Icons.Material.Filled.Diamond" Size="Size.Small" />
                            Premium
                        </span>
                    </div>
                    <p class="dh-subtitle">
                        <MudIcon Icon="@Icons.Material.Filled.Insights" Size="Size.Small" />
                        طلب واعتماد وصرف أي مكافأة أو حافز في منتصف الشهر بعيدًا عن كشف الراتب — @DateTime.Now.ToString("dddd yyyy/MM/dd", new System.Globalization.CultureInfo("ar-EG"))
                    </p>
                </div>
            </div>
            <div class="dh-actions">
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PostAdd"
                           OnClick="OpenForm" Class="dh-btn-primary">
                    <span class="btn-shine"></span>طلب دفعة جديدة
                </MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ReceiptLong"
                           OnClick='@(() => Nav.NavigateTo("/hr/payroll"))' Class="dh-btn-ghost">
                    سجل الرواتب
                </MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Calculate"
                           OnClick='@(() => Nav.NavigateTo("/hr/payroll/processor"))' Class="dh-btn-ghost">
                    معالجة مرتبات
                </MudButton>
            </div>
        </div>
    </div>

    @* ══ شريط المسار ══ *@
    <div class="ob-steps mb-3">
        <span class="ob-step"><b>1</b> تسجيل الطلب</span>
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Class="ob-step-arrow" />
        <span class="ob-step"><b>2</b> إرسال للمراجعة</span>
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Class="ob-step-arrow" />
        <span class="ob-step"><b>3</b> اعتماد</span>
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Class="ob-step-arrow" />
        <span class="ob-step"><b>4</b> صرف من الخزينة</span>
        <span class="ob-steps-note">
            <MudIcon Icon="@Icons.Material.Filled.Info" />
            لمكافأة أو حافز أو عمولة مستقلة لا تدخل ضمن صافي المرتب الشهري
        </span>
    </div>

    @* ══ الإحصاءات — كروت بيضاء بخطوط ملونة (بلا خلفيات ملونة) ══ *@
    @if (_stats is not null)
    {
        <div class="ob-stats-bar mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Insights" />
            <span>إحصاء @(string.IsNullOrEmpty(_filter.Month) ? "كل الشهور" : FormatMonth(_filter.Month))</span>
        </div>

        <div class="ob-summary mb-4">
            <div class="ob-sum-item">
                <div class="ob-sum-ic navy"><MudIcon Icon="@Icons.Material.Filled.AttachMoney" /></div>
                <div class="ob-sum-txt">
                    <span>إجمالي الطلبات</span>
                    <b class="navy">@_stats.TotalAmount.ToString("N0") جـ</b>
                </div>
            </div>
            <div class="ob-sum-item">
                <div class="ob-sum-ic amber"><MudIcon Icon="@Icons.Material.Filled.RateReview" /></div>
                <div class="ob-sum-txt">
                    <span>قيد المراجعة</span>
                    <b class="amber">@_stats.ReviewCount</b>
                </div>
            </div>
            <div class="ob-sum-item">
                <div class="ob-sum-ic blue"><MudIcon Icon="@Icons.Material.Filled.Verified" /></div>
                <div class="ob-sum-txt">
                    <span>معتمد</span>
                    <b class="blue">@_stats.ApprovedCount</b>
                </div>
            </div>
            <div class="ob-sum-item">
                <div class="ob-sum-ic green"><MudIcon Icon="@Icons.Material.Filled.Paid" /></div>
                <div class="ob-sum-txt">
                    <span>مدفوع</span>
                    <b class="green">@_stats.PaidCount</b>
                </div>
            </div>
            <div class="ob-sum-item">
                <div class="ob-sum-ic red"><MudIcon Icon="@Icons.Material.Filled.Close" /></div>
                <div class="ob-sum-txt">
                    <span>مرفوض</span>
                    <b class="red">@_stats.RejectedCount</b>
                </div>
            </div>
            <div class="ob-sum-item">
                <div class="ob-sum-ic slate"><MudIcon Icon="@Icons.Material.Filled.Cancel" /></div>
                <div class="ob-sum-txt">
                    <span>ملغي</span>
                    <b class="slate">@_stats.CancelledCount</b>
                </div>
            </div>
        </div>
    }

    @* ══ نموذج طلب دفعة (مطوي) ══ *@
    <MudExpansionPanels Class="mb-4 ob-form-panels" Elevation="0">
        <MudExpansionPanel @bind-Expanded="_formExpanded">
            <TitleContent>
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.PostAdd" Class="ob-panel-ic" />
                    <MudText Typo="Typo.h6">طلب حافز - عمولة - مكافأة جديدة</MudText>
                </div>
            </TitleContent>
            <ChildContent>
            <MudPaper Class="pa-4 rounded-xl ob-form-card">
                <MudGrid>
                    <MudItem xs="12">
                        <MudAutocomplete T="EmployeeListDto"
                                         Label="الموظف *"
                                         @bind-Value="_selectedEmployee"
                                         SearchFunc="SearchEmployeesAsync"
                                         ToStringFunc="EmployeeToString"
                                         Variant="Variant.Outlined"
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.Person"
                                         ResetValueOnEmptyText="true"
                                         CoerceValue="true"
                                         Margin="Margin.Dense">
                            <ItemTemplate Context="emp">
                                <div class="pa-1">
                                    <MudText Typo="Typo.body2"><b>@emp.FullName</b></MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @(emp.Department ?? "بدون قسم")
                                    </MudText>
                                </div>
                            </ItemTemplate>
                        </MudAutocomplete>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudDatePicker Date="_paymentDate"
                                       DateChanged="OnPaymentDateChangedAsync"
                                       Label="تاريخ الدفعة"
                                       Variant="Variant.Outlined"
                                       DateFormat="dd/MM/yyyy"
                                       Margin="Margin.Dense" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect T="string"
                                   @bind-Value="_formModel.PaymentType"
                                   Label="نوع الدفعة"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            <MudSelectItem T="string" Value="@("BonusSeparate")">مكافأة منفصلة</MudSelectItem>
                            <MudSelectItem T="string" Value="@("CommissionSeparate")">عمولة منفصلة</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal"
                                         @bind-Value="_formModel.Amount"
                                         Label="المبلغ *"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="0"
                                         Adornment="Adornment.End"
                                         AdornmentText="جـ" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        @* (12-H17) قائمة شهور بدل النص اليدوي — صفر أخطاء صيغة *@
                        <MudSelect T="string"
                                   Value="_referenceMonth"
                                   ValueChanged="OnReferenceMonthChanged"
                                   Label="الشهر المرجعي *"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Adornment="Adornment.Start"
                                   AdornmentIcon="@Icons.Material.Filled.CalendarMonth"
                                   HelperText="شهر استحقاق الدفعة — حر تماماً ومستقل عن تاريخ الصرف">
                            @foreach (var m in _referenceMonthChoices)
                            {
                                <MudSelectItem T="string" Value="@m">@FormatMonth(m)</MudSelectItem>
                            }
                        </MudSelect>
                        @if (IsReferenceMonthMismatch)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                                <div class="d-flex align-center gap-2 flex-wrap">
                                    <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" />
                                    <MudText Typo="Typo.body2">
                                        الشهر المرجعي <b>@(string.IsNullOrWhiteSpace(_referenceMonth) ? "—" : FormatMonth(_referenceMonth))</b>
                                        يختلف عن شهر الصرف <b>@FormatMonth(_paymentDateMonth)</b> — هذا مقصود (مكافأة متأخرة / مقدمة).
                                    </MudText>
                                    <MudSpacer />
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="SyncReferenceMonthToPaymentDate"
                                               StartIcon="@Icons.Material.Filled.Sync">مزامنة مع شهر الصرف</MudButton>
                                </div>
                            </MudAlert>
                        }
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField T="string"
                                      @bind-Value="_formModel.Description"
                                      Label="وصف الدفعة *"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Placeholder="مثال: مكافأة أداء / صرف حافز خاص / عمولة عملية معينة" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField T="string"
                                      @bind-Value="_formModel.Reason"
                                      Label="سبب أو مبرر الطلب"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="3" />
                    </MudItem>

                    @if (_selectedEmployee is not null || _formModel.Amount > 0)
                    {
                        <MudItem xs="12">
                            <div class="ob-form-summary">
                                <div class="ob-fs-cell">
                                    <span>الموظف</span>
                                    <b>@(_selectedEmployee?.FullName ?? "—")</b>
                                </div>
                                <div class="ob-fs-cell">
                                    <span>النوع</span>
                                    <b>@PaymentTypeAr(_formModel.PaymentType)</b>
                                </div>
                                <div class="ob-fs-cell">
                                    <span>المبلغ</span>
                                    <b class="gold">@_formModel.Amount.ToString("N2") جـ</b>
                                </div>
                                <div class="ob-fs-cell">
                                    <span>الشهر المرجعي</span>
                                    <b>@GetMonthDisplay()</b>
                                </div>
                            </div>
                        </MudItem>
                    }

                    <MudItem xs="12">
                        <div class="d-flex gap-2 flex-wrap">
                            <MudButton Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Send"
                                       OnClick="SaveAsync"
                                       Disabled="_saving"
                                       Class="ob-save-btn">
                                <span class="btn-shine"></span>
                                @(_saving ? "جاري الحفظ..." : "حفظ وإرسال للمراجعة")
                            </MudButton>

                            <MudButton Variant="Variant.Text"
                                       Color="Color.Default"
                                       StartIcon="@Icons.Material.Filled.RestartAlt"
                                       OnClick="ResetForm">
                                تفريغ النموذج
                            </MudButton>
                        </div>
                    </MudItem>
                </MudGrid>
            </MudPaper>
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>

    @* ══ شرائح الشهور ══ *@
    <div class="month-picker-row">
        <span class="month-picker-label">
            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" />
            اختر الشهر
        </span>
        @foreach (var m in _offPayrollMonthChips)
        {
            <button type="button"
                    class="month-chip @(IsMonthActive(m.Month) ? "active" : "")"
                    @onclick="() => SelectMonthAsync(m.Month)">
                <span class="month-chip-name">@FormatMonth(m.Month)</span>
                <span class="month-chip-meta">@(m.PayrollCount > 0 ? $"{m.PayrollCount} دفعة · {FormatCompactMoney(m.TotalNet)}" : "لا دفعات")</span>
            </button>
        }
        <button type="button"
                class="month-chip all-chip @(string.IsNullOrEmpty(_filter.Month) ? "active" : "")"
                @onclick="SelectAllMonthsAsync">
            <span class="month-chip-name">كل الشهور</span>
        </button>
    </div>

    @* ══ الفلاتر — سطر واحد (بدون قائمة الشهر المكررة) ══ *@
    <div class="sticky-filter-shell">
        <MudPaper Class="pa-3 mb-3 rounded-xl d-flex align-center gap-3 flex-wrap">
            <MudTextField @bind-Value="_filter.SearchText"
                          Placeholder="بحث بالموظف أو الوصف"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="min-width:220px"
                          Clearable="true"
                          OnKeyUp="OnSearchKeyUp" />

            <MudSelect T="string"
                       @bind-Value="_filter.PaymentStatus"
                       Label="الحالة"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Style="min-width:160px"
                       Clearable="true">
                <MudSelectItem T="string" Value="@PayrollPaymentStatuses.PendingReview">قيد المراجعة</MudSelectItem>
                <MudSelectItem T="string" Value="@PayrollPaymentStatuses.Approved">معتمد</MudSelectItem>
                <MudSelectItem T="string" Value="@PayrollPaymentStatuses.Paid">مدفوع</MudSelectItem>
                <MudSelectItem T="string" Value="@PayrollPaymentStatuses.Rejected">مرفوض</MudSelectItem>
                <MudSelectItem T="string" Value="@PayrollPaymentStatuses.Cancelled">ملغي</MudSelectItem>
            </MudSelect>

            <MudSelect T="string"
                       @bind-Value="_filter.PaymentType"
                       Label="النوع"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Style="min-width:160px"
                       Clearable="true">
                <MudSelectItem T="string" Value="@("BonusSeparate")">مكافأة منفصلة</MudSelectItem>
                <MudSelectItem T="string" Value="@("CommissionSeparate")">عمولة منفصلة</MudSelectItem>
            </MudSelect>

            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Search"
                       OnClick="LoadAsync">
                تحديث
            </MudButton>
        </MudPaper>
    </div>

    @* ══ الجدول ══ *@
    <MudPaper Class="rounded-xl overflow-hidden ob-table-wrap">
        @if (_loading)
        {
            <MudProgressLinear Indeterminate Color="Color.Primary" />
        }

        <MudTable Items="_items" Dense Hover Striped Elevation="0">
            <HeaderContent>
                <MudTh>الموظف</MudTh>
                <MudTh>الفترة</MudTh>
                <MudTh>النوع / الوصف</MudTh>
                <MudTh>المبلغ</MudTh>
                <MudTh>الحالة</MudTh>
                <MudTh>إجراءات</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudText Typo="Typo.body2"><b>@context.EmployeeName</b></MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@(context.Department ?? "—")</MudText>
                </MudTd>

                <MudTd>
                    <MudText Typo="Typo.body2">@FormatMonth(context.PayrollMonth)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        تم الطلب @((context.RequestedAt ?? DateTime.Now).ToString("dd/MM/yyyy"))
                    </MudText>
                </MudTd>

                <MudTd>
                    <MudText Typo="Typo.body2"><b>@context.PaymentTypeAr</b></MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Description</MudText>
                </MudTd>

                <MudTd>
                    <MudText Typo="Typo.body1" Style="font-weight:800">@context.Amount.ToString("N2") جـ</MudText>
                </MudTd>

                <MudTd>
                    <MudChip T="string" Size="Size.Small" Style="@($"background:{context.StatusColor};color:white")">
                        @context.PaymentStatus
                    </MudChip>
                    @if (context.PaidAt.HasValue)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.PaidAt.Value.ToString("dd/MM/yyyy HH:mm")</MudText>
                    }
                </MudTd>

                <MudTd>
                    @if (context.PaymentStatus == PayrollPaymentStatuses.PendingReview && _canReview)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       Title="اعتماد"
                                       OnClick="@(() => ApproveAsync(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       Title="رفض"
                                       OnClick="@(() => OpenRejectDialog(context))" />
                    }

                    @if ((context.PaymentStatus == PayrollPaymentStatuses.Approved || context.PaymentStatus == PayrollPaymentStatuses.Unpaid) && _canPay)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Payment"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Title="صرف"
                                       OnClick="@(() => OpenPayDialogAsync(context))" />
                    }

                    @if (context.PaymentStatus != PayrollPaymentStatuses.Paid)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       Title="إلغاء"
                                       OnClick="@(() => CancelAsync(context))" />
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4" Color="Color.Secondary" Align="Align.Center">
                    لا توجد دفعات خارج الراتب مطابقة للفلاتر الحالية
                </MudText>
            </NoRecordsContent>
        </MudTable>

        @* ══ (12-H17) شريط الإجماليات ══ *@
        <div class="ob-totals">
            <div class="ob-tot-head">
                <MudIcon Icon="@Icons.Material.Filled.Insights" />
                <span>إجمالي @_items.Count دفعة (المعروض)</span>
            </div>
            <div class="ob-tot-cells">
                <div class="ob-tot-cell">
                    <span>إجمالي المبالغ</span>
                    <b>@_items.Sum(i => i.Amount).ToString("N0") جـ</b>
                </div>
                <div class="ob-tot-cell">
                    <span>مدفوع</span>
                    <b class="ok">@_items.Where(i => i.PaymentStatus == PayrollPaymentStatuses.Paid).Sum(i => i.Amount).ToString("N0") جـ</b>
                </div>
                <div class="ob-tot-cell net">
                    <span>منتظر (مراجعة + معتمد)</span>
                    <b>@_items.Where(i => i.PaymentStatus == PayrollPaymentStatuses.PendingReview || i.PaymentStatus == PayrollPaymentStatuses.Approved).Sum(i => i.Amount).ToString("N0") جـ</b>
                </div>
            </div>
        </div>
    </MudPaper>
</div>

@* ══ حوار الصرف (inline كما هو — تحسين تصميم داخلي فقط) ══ *@
<MudDialog @bind-Visible="_payDialogOpen">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-3">صرف دفعة خارج الراتب</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            سيتم صرف الدفعة من الخزينة المختارة وتسجيلها كحركة مستقلة.
        </MudText>
        <MudSelect T="int?"
                   @bind-Value="_selectedPayCashBoxId"
                   Label="الخزينة"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   FullWidth>
            @foreach (var cb in _cashBoxes)
            {
                <MudSelectItem T="int?" Value="@((int?)cb.CashBoxId)">@cb.CashBoxName (@cb.CurrentBalance.ToString("N0") جـ)</MudSelectItem>
            }
        </MudSelect>

        @if (_payPendingInstallments.Count > 0)
        {
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2" Class="mb-1 ob-alloc-title">
                <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" />
                مقاصة أقساط السلف (اختياري)
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                حدد الأقساط التي تُخصم من قيمة الدفعة — كامل القسط أو جزء منه. الباقي يُصرف نقدًا للموظف.
            </MudText>
            <div class="opa-items">
                @foreach (var inst in _payPendingInstallments)
                {
                    var selected = _payAlloc.ContainsKey(inst.InstallmentId);
                    <div class="opa-item @(selected ? "selected" : "")">
                        <MudCheckBox T="bool" Value="selected" ValueChanged="@(v => TogglePayAlloc(inst, v))" Dense="true" />
                        <div class="opa-item-txt">
                            <div class="opa-item-t">قسط @inst.InstallmentNumber</div>
                            <div class="opa-item-s">@inst.MonthDisplay · @inst.Amount.ToString("N2") جـ</div>
                        </div>
                        @if (selected)
                        {
                            <MudNumericField T="decimal" Value="_payAlloc[inst.InstallmentId]"
                                             ValueChanged="@(v => OnPayAllocChanged(inst.InstallmentId, v, inst.Amount))"
                                             Label="المخصص" Variant="Variant.Outlined" Margin="Margin.Dense"
                                             Min="0.01m" Max="@inst.Amount" Style="max-width:140px" />
                        }
                    </div>
                }
            </div>
            <div class="opa-sum">
                <span>قيمة الدفعة: <b>@_payAmount.ToString("N2") جـ</b></span>
                <span>المخصص للأقساط: <b class="gold">@PayAllocTotal.ToString("N2") جـ</b></span>
                <span>النقدي للموظف: <b class="@(PayCashAmount < 0 ? "bad" : "cash")">@PayCashAmount.ToString("N2") جـ</b></span>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick='@(() => _payDialogOpen = false)'>إلغاء</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SubmitPayAsync">صرف</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_rejectDialogOpen">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-3">رفض دفعة خارج الراتب</MudText>
        <MudTextField T="string" @bind-Value="_rejectReason" Label="سبب الرفض" Variant="Variant.Outlined" Lines="3" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick='@(() => _rejectDialogOpen = false)'>إلغاء</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="SubmitRejectAsync">رفض</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private OffPayrollPaymentFormDto _formModel = new()
    {
        PaymentDate = DateTime.Today,
        PaymentType = "BonusSeparate"
    };

    private EmployeeListDto? _selectedEmployee;
    private DateTime? _paymentDate = DateTime.Today;
    private bool _saving;
    private bool _loading;
    private bool _formExpanded;   // (12-H17) زر الهيدر يفتح الفورم
    private string _currentUser = "system";
    private bool _canReview;
    private bool _canPay;

    private OffPayrollPaymentFilterDto _filter = new()
    {
        Month = DateTime.Today.ToString("yyyy-MM")
    };

    private string _referenceMonth = DateTime.Today.ToString("yyyy-MM");
    private bool _userEditedReferenceMonth;
    private string _paymentDateMonth => (_paymentDate ?? DateTime.Today).ToString("yyyy-MM");
    private bool IsReferenceMonthMismatch => !string.IsNullOrWhiteSpace(_referenceMonth) && _referenceMonth != _paymentDateMonth;
    private List<PayrollMonthSummaryDto> _offPayrollMonths = new();
    private List<PayrollMonthSummaryDto> _offPayrollMonthChips = new();

    // (12-H17) قائمة الشهور المرجعية: الحالي + 24 شهر للخلف
    private List<string> _referenceMonthChoices =
        Enumerable.Range(0, 25).Select(i => DateTime.Today.AddMonths(-i).ToString("yyyy-MM")).ToList();

    private List<OffPayrollPaymentListDto> _items = new();
    private OffPayrollPaymentStatsDto? _stats;
    private List<CashBoxListDto> _cashBoxes = new();
    private bool _payDialogOpen;
    private int _payPayrollId;
    private int? _selectedPayCashBoxId;

    // (12-H11/ب) مقاصة أقساط السلف من الدفعة
    private List<InstallmentListDto> _payPendingInstallments = new();
    private Dictionary<int, decimal> _payAlloc = new();
    private decimal _payAmount;

    private decimal PayAllocTotal => _payAlloc.Values.Sum();
    private decimal PayCashAmount => _payAmount - PayAllocTotal;
    private bool _rejectDialogOpen;
    private int _rejectPayrollId;
    private string? _rejectReason;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        _currentUser = user.Identity?.Name ?? "system";

        var canView = user.IsInRole("Admin")
                      || user.IsInRole("HrManager")
                      || user.IsInRole("HRManager")
                      || user.IsInRole("AccountManager")
                      || user.IsInRole("Accountant")
                      || user.IsInRole("AccountsManager")
                      || user.HasClaim("Permission", "frm_PayrollPayment:View")
                      || user.HasClaim("Permission", "frm_Payroll:View");

        // (12-H17) توحيد AccountsManager مع باقي الشاشات
        _canReview = user.IsInRole("Admin") || user.IsInRole("AccountManager") || user.IsInRole("AccountsManager");
        _canPay = user.IsInRole("Admin") || user.IsInRole("AccountManager") || user.IsInRole("AccountsManager");

        if (!canView)
        {
            Nav.NavigateTo("/access-denied");
            return;
        }

        _cashBoxes = await CashBoxService.GetCashBoxesAsync(activeOnly: true);
        await LoadMonthSummariesAsync();
        await LoadAsync();
    }

    private void OpenForm() => _formExpanded = true;

    private async Task<IEnumerable<EmployeeListDto>> SearchEmployeesAsync(string? value, CancellationToken ct)
    {
        try
        {
            return await EmployeeService.SearchEmployeesAsync(value ?? string.Empty, 20);
        }
        catch
        {
            return Enumerable.Empty<EmployeeListDto>();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            _items = await PayrollService.GetOffPayrollPaymentsAsync(_filter);
            _stats = await PayrollService.GetOffPayrollPaymentStatsAsync(_filter);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ في تحميل الدفعات: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SaveAsync()
    {
        if (_selectedEmployee is null)
        {
            Snackbar.Add("يجب اختيار الموظف", Severity.Warning);
            return;
        }

        if (_formModel.Amount <= 0)
        {
            Snackbar.Add("أدخل مبلغًا أكبر من صفر", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_formModel.Description))
        {
            Snackbar.Add("اكتب وصف الدفعة", Severity.Warning);
            return;
        }

        if (NormalizeMonthOrNull(_referenceMonth) is null)
        {
            Snackbar.Add("صيغة الشهر المرجعي غير صحيحة — اكتب yyyy-MM", Severity.Warning);
            return;
        }

        _saving = true;
        StateHasChanged();

        try
        {
            _formModel.EmployeeID = _selectedEmployee.EmployeeId;
            _formModel.EmployeeName = _selectedEmployee.FullName;
            _formModel.Department = _selectedEmployee.Department;
            _formModel.PaymentDate = _paymentDate ?? DateTime.Today;

            // (12-H17) إصلاح الباج: كان السطر التالي يُكتب بعده بقيمة خام تلغي التطبيع
            _formModel.ReferenceMonth = NormalizeMonthOrNull(_referenceMonth)
                                        ?? _formModel.PaymentDate.ToString("yyyy-MM");

            var (ok, msg, _) = await PayrollService.SaveOffPayrollPaymentAsync(_formModel, _currentUser);
            Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);

            if (ok)
            {
                ResetForm();
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private void ResetForm()
    {
        _selectedEmployee = null;
        _paymentDate = DateTime.Today;
        _referenceMonth = DateTime.Today.ToString("yyyy-MM");
        _userEditedReferenceMonth = false;
        _formModel = new OffPayrollPaymentFormDto
        {
            PaymentDate = DateTime.Today,
            PaymentType = "BonusSeparate"
        };
        StateHasChanged();
    }

    private async Task ApproveAsync(OffPayrollPaymentListDto item)
    {
        var (ok, msg) = await PayrollService.ApprovePayrollAsync(item.PayrollID, _currentUser);
        Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);
        if (ok)
            await LoadAsync();
    }

    private void OpenRejectDialog(OffPayrollPaymentListDto item)
    {
        _rejectPayrollId = item.PayrollID;
        _rejectReason = null;
        _rejectDialogOpen = true;
    }

    private async Task SubmitRejectAsync()
    {
        var (ok, msg) = await PayrollService.RejectPayrollAsync(_rejectPayrollId, _currentUser, _rejectReason);
        Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);
        if (ok)
        {
            _rejectDialogOpen = false;
            await LoadAsync();
        }
    }

    private async Task OpenPayDialogAsync(OffPayrollPaymentListDto item)
    {
        _payPayrollId = item.PayrollID;
        _payAmount    = item.Amount;
        _payAlloc     = new Dictionary<int, decimal>();
        _selectedPayCashBoxId = _cashBoxes.FirstOrDefault(c => c.IsDefault)?.CashBoxId ?? _cashBoxes.FirstOrDefault()?.CashBoxId;
        try { _payPendingInstallments = await LoanService.GetPendingInstallmentsAsync(item.EmployeeID); }
        catch { _payPendingInstallments = new(); }
        _payDialogOpen = true;
    }

    private void TogglePayAlloc(InstallmentListDto inst, bool value)
    {
        if (value) _payAlloc[inst.InstallmentId] = inst.Amount;
        else _payAlloc.Remove(inst.InstallmentId);
    }

    private void OnPayAllocChanged(int installmentId, decimal value, decimal max)
    {
        if (value > max) value = max;
        if (value < 0) value = 0;
        _payAlloc[installmentId] = value;
    }

    private async Task SubmitPayAsync()
    {
        if (!_selectedPayCashBoxId.HasValue)
        {
            Snackbar.Add("يرجى اختيار الخزينة", Severity.Warning);
            return;
        }

        // (12-H11/ب) مع مقاصة أقساط سلف
        if (_payAlloc.Count > 0)
        {
            if (_payAlloc.Any(kv => kv.Value <= 0))
            {
                Snackbar.Add("كل مبلغ مخصص يجب أن يكون أكبر من صفر", Severity.Warning);
                return;
            }
            if (PayAllocTotal > _payAmount)
            {
                Snackbar.Add($"إجمالي المخصص للأقساط ({PayAllocTotal:N2}) أكبر من قيمة الدفعة ({_payAmount:N2})", Severity.Warning);
                return;
            }

            var items = _payAlloc
                .Select(kv => new OutOfPayrollPaymentItemDto { InstallmentId = kv.Key, Amount = kv.Value })
                .ToList();

            var (oka, msga) = await PayrollService.PayOneWithLoanAllocationAsync(_payPayrollId, _selectedPayCashBoxId.Value, items, _currentUser);
            Snackbar.Add(msga, oka ? Severity.Success : Severity.Error);
            if (oka)
            {
                _payDialogOpen = false;
                await LoadAsync();
            }
            return;
        }

        var (ok, msg) = await PayrollService.PayOneAsync(_payPayrollId, _selectedPayCashBoxId.Value, _currentUser);
        Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);
        if (ok)
        {
            _payDialogOpen = false;
            await LoadAsync();
        }
    }

    private async Task CancelAsync(OffPayrollPaymentListDto item)
    {
        var parameters = new DialogParameters<MudMessageBox>
        {
            { x => x.Message, $"هل تريد إلغاء الدفعة الخاصة بـ {item.EmployeeName}؟" },
            { x => x.YesText, "إلغاء الدفعة" },
            { x => x.CancelText, "تراجع" }
        };

        var dialog = await DialogService.ShowAsync<MudMessageBox>(
            "تأكيد الإلغاء",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall });

        if ((await dialog.Result) is { Canceled: true })
            return;

        var (ok, msg) = await PayrollService.CancelAsync(item.PayrollID, _currentUser);
        Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);
        if (ok)
            await LoadAsync();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LoadAsync();
    }

    private static string EmployeeToString(EmployeeListDto? employee) => employee?.FullName ?? string.Empty;

    private string GetMonthDisplay() => FormatMonth(_referenceMonth);

    // ── اختيار الشهر: شرائح (دفعات خارج الراتب) ──────
    private async Task LoadMonthSummariesAsync()
    {
        try
        {
            _offPayrollMonths = await PayrollService.GetMonthSummariesAsync(offPayrollOnly: true);
        }
        catch
        {
            _offPayrollMonths = new List<PayrollMonthSummaryDto>();
        }

        var currentMonth = DateTime.Today.ToString("yyyy-MM");
        if (_offPayrollMonths.All(m => m.Month != currentMonth))
            _offPayrollMonths.Insert(0, new PayrollMonthSummaryDto { Month = currentMonth });
        _offPayrollMonthChips = _offPayrollMonths.Take(6).ToList();
    }

    private bool IsMonthActive(string month) => _filter.Month == month;

    private async Task SelectMonthAsync(string month)
    {
        if (_filter.Month == month) return;
        _filter.Month = month;
        await LoadAsync();
    }

    private async Task SelectAllMonthsAsync()
    {
        _filter.Month = null;
        await LoadAsync();
    }

    private static string FormatCompactMoney(decimal v) =>
        v >= 1_000_000m ? $"{v / 1_000_000m:N1} مليون ج" : $"{v / 1_000m:N0} ألف ج";

    private static string PaymentTypeAr(string paymentType) => paymentType switch
    {
        "CommissionSeparate" => "عمولة منفصلة",
        _ => "مكافأة منفصلة"
    };

    // يقبل أي صيغة شهر شائعة (yyyy-MM, yyyy/MM, MM/yyyy, M/yyyy...) ويعيد yyyy-MM أو null لو غير صالح
    private static string? NormalizeMonthOrNull(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;
        var s = raw.Trim().Replace("/", "-").Replace(".", "-");
        if (DateTime.TryParseExact(s, new[] { "yyyy-MM", "yyyy-M", "MM-yyyy", "M-yyyy", "yyyy-MM-dd", "yyyy-M-d" }, null,
            System.Globalization.DateTimeStyles.None, out var d))
            return d.ToString("yyyy-MM");
        if (DateTime.TryParse(s, out d))
            return d.ToString("yyyy-MM");
        return null;
    }

    private async Task OnPaymentDateChangedAsync(DateTime? value)
    {
        _paymentDate = value;
        if (!_userEditedReferenceMonth)
            _referenceMonth = (value ?? DateTime.Today).ToString("yyyy-MM");
    }

    private void OnReferenceMonthChanged(string? value)
    {
        _referenceMonth = value ?? string.Empty;
        _userEditedReferenceMonth = true;
    }

    private void SyncReferenceMonthToPaymentDate()
    {
        _referenceMonth = _paymentDateMonth;
        _userEditedReferenceMonth = false;
    }

    private static string FormatMonth(string? month) =>
        string.IsNullOrWhiteSpace(month)
            ? "—"
            : DateTime.TryParseExact(month + "-01", "yyyy-MM-dd", null,
                System.Globalization.DateTimeStyles.None, out var date)
                ? date.ToString("MMMM yyyy", new System.Globalization.CultureInfo("ar-EG"))
                : month;
}

