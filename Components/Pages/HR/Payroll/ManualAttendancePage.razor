@page "/hr/payroll/attendance"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using MudBlazor
@using System.Globalization

@inject IPayrollService              PayrollService
@inject ISnackbar                    Snackbar
@inject AuthenticationStateProvider  AuthProvider

<PageTitle>الحضور اليدوي للموظفين المعفيين</PageTitle>

<div dir="rtl" class="man-page">

    <div class="top-accent"><div class="accent-shimmer"></div></div>

    @* ══ Premium Header — نفس تصميم لوحة الخزينة ══ *@
    <div class="dash-header">
        <div class="dh-bg">
            <div class="dh-gradient"></div>
            <div class="dh-orbs">
                <div class="dh-orb dh-o1"></div>
                <div class="dh-orb dh-o2"></div>
                <div class="dh-orb dh-o3"></div>
            </div>
            <div class="dh-grid"></div>
        </div>
        <div class="dh-content">
            <div class="dh-info">
                <div class="dh-icon-wrap">
                    <div class="dh-icon-glow"></div>
                    <div class="dh-icon">
                        <MudIcon Icon="@Icons.Material.Filled.HowToReg" Size="Size.Large" />
                    </div>
                    <div class="dh-badge"><MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" /></div>
                </div>
                <div class="dh-text">
                    <div class="dh-title-row">
                        <h1>الحضور اليدوي</h1>
                        <span class="premium-tag">
                            <MudIcon Icon="@Icons.Material.Filled.Diamond" Size="Size.Small" />
                            Premium
                        </span>
                    </div>
                    <p class="dh-subtitle">
                        <MudIcon Icon="@Icons.Material.Filled.Insights" Size="Size.Small" />
                        للموظفين المعفيين من البصمة — @DateTime.Now.ToString("dddd yyyy/MM/dd", new CultureInfo("ar-EG"))
                    </p>
                </div>
            </div>
            <div class="dh-actions">
                @if (_records.Any())
                {
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveAllAsync" Disabled="_saving" Class="dh-btn-primary">
                        <span class="btn-shine"></span>@(_saving ? "جاري الحفظ..." : "حفظ الكل")
                    </MudButton>
                }
            </div>
        </div>
    </div>

    @* ══ الفلتر — سطر واحد ══ *@
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius: 16px;">
        <div class="man-filter-row">
            <MudDatePicker Class="mfr-month" Label="شهر الحضور"
                           Date="_monthDate" DateChanged="OnMonthChanged"
                           OpenTo="OpenTo.Month" FixDay="1" DateFormat="yyyy-MM"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Editable="false" Clearable="false" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mfr-btn"
                       StartIcon="@Icons.Material.Filled.Search" OnClick="LoadAsync" Disabled="_loading">
                عرض
            </MudButton>
            <div class="mfr-hint">
                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                <span>البيانات تُحمّل تلقائيًا عند تغيير الشهر</span>
            </div>
        </div>
    </MudPaper>

    @if (_loading)
    {
        <MudPaper Class="pa-8 text-center" Elevation="2" Style="border-radius:16px;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mb-3" />
            <div><MudText Color="Color.Secondary">جاري تحميل بيانات الحضور اليدوي...</MudText></div>
        </MudPaper>
    }
    else if (_records.Any())
    {
        @* ══ ملخص الشهر ══ *@
        <div class="man-summary mb-3">
            <div class="man-sum-item">
                <span>الموظفون المعفيون</span>
                <b>@_records.Count</b>
            </div>
            <div class="man-sum-item">
                <span>موظفون بحضور كامل</span>
                <b class="ok">@FullAttendanceCount</b>
            </div>
            <div class="man-sum-item">
                <span>إجمالي أيام الغياب</span>
                <b class="bad">@TotalAbsent</b>
            </div>
            <div class="man-sum-item">
                <span>دقائق التأخير</span>
                <b class="warn">@TotalLate</b>
            </div>
        </div>

        @* ══ الجدول ══ *@
        <div class="man-table-shell mb-3">
            <MudTable Items="_records" Dense="true" Hover="true" Striped="true" Elevation="0">
                <HeaderContent>
                    <MudTh>الموظف</MudTh>
                    <MudTh>القسم</MudTh>
                    <MudTh Style="text-align:center">أيام الحضور</MudTh>
                    <MudTh Style="text-align:center">أيام الغياب</MudTh>
                    <MudTh Style="text-align:center">دقائق التأخير</MudTh>
                    <MudTh>ملاحظات</MudTh>
                    <MudTh Style="text-align:center">حفظ</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <div class="d-flex align-center gap-2">
                            <MudAvatar Size="Size.Small" Class="man-avatar">
                                @context.EmployeeName.FirstOrDefault()
                            </MudAvatar>
                            <MudText Typo="Typo.body2" Style="font-weight:700">@context.EmployeeName</MudText>
                        </div>
                    </MudTd>
                    <MudTd>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@(context.Department ?? "—")</MudText>
                    </MudTd>
                    <MudTd Style="text-align:center">
                        <MudNumericField T="int" @bind-Value="context.PresentDays"
                                         Min="0" Max="31" Class="man-num"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudTd>
                    <MudTd Style="text-align:center">
                        <MudNumericField T="int" @bind-Value="context.AbsenceDays"
                                         Min="0" Max="31" Class="man-num"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudTd>
                    <MudTd Style="text-align:center">
                        <MudNumericField T="int" @bind-Value="context.LateMinutes"
                                         Min="0" Class="man-num man-num-wide"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudTd>
                    <MudTd>
                        <MudTextField T="string" @bind-Value="context.Notes" Class="man-note"
                                      Placeholder="ملاحظة اختيارية..."
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.StickyNote2"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudTd>
                    <MudTd Style="text-align:center">
                        <MudTooltip Text="حفظ هذا الموظف" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Success"
                                           Variant="Variant.Outlined" Size="Size.Small"
                                           OnClick="@(() => SaveOneAsync(context))" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </div>

        <div class="man-info-strip">
            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
            <span>الموظفون المعفيون من البصمة يظهرون هنا بحضور كامل افتراضيًا — عدّل الأرقام لو فيه غياب أو تأخير ثم احفظ (فردى أو حفظ الكل).</span>
        </div>
    }
    else if (_searched)
    {
        <MudPaper Class="pa-8 text-center" Elevation="2" Style="border-radius:16px;">
            <MudIcon Icon="@Icons.Material.Filled.PersonOff" Style="font-size:54px; opacity:.4" Color="Color.Secondary" />
            <MudText Typo="Typo.h6" Class="mt-3">لا يوجد موظفون معفيون من البصمة في النظام</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                لإضافة موظف معفى: اذهب لبيانات الموظف وفعّل خيار «معفى من البصمة»
            </MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-8 text-center" Elevation="2" Style="border-radius:16px;">
            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Style="font-size:54px; opacity:.4" Color="Color.Secondary" />
            <div class="mt-3"><MudText Typo="Typo.h6" Color="Color.Secondary">اختر الشهر لعرض الحضور اليدوي</MudText></div>
            <MudText Typo="Typo.body2" Color="Color.Secondary">البيانات تُحمّل تلقائيًا عند تغيير الشهر</MudText>
        </MudPaper>
    }
</div>

@code {
    private string                    _month       = DateTime.Today.ToString("yyyy-MM");
    private DateTime?                 _monthDate   = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private List<ManualAttendanceDto> _records     = new();
    private bool                      _loading;
    private bool                      _saving;
    private bool                      _searched;
    private string                    _currentUser = "system";

    // (12-H13) ملخص حي
    private int FullAttendanceCount => _records.Count(r => r.AbsenceDays == 0 && r.LateMinutes == 0);
    private int TotalAbsent  => _records.Sum(r => r.AbsenceDays);
    private int TotalLate    => _records.Sum(r => r.LateMinutes);

    protected override async Task OnInitializedAsync()
    {
        var auth     = await AuthProvider.GetAuthenticationStateAsync();
        _currentUser = auth.User.Identity?.Name ?? "system";
    }

    // (12-H13) تغيير الشهر من التقويم = تحميل تلقائي
    private async Task OnMonthChanged(DateTime? d)
    {
        if (!d.HasValue) return;
        _monthDate = new DateTime(d.Value.Year, d.Value.Month, 1);
        _month     = _monthDate.Value.ToString("yyyy-MM");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!ValidateMonth(_month))
        {
            Snackbar.Add("صيغة الشهر غير صحيحة (مثال: 2026-05)", Severity.Warning);
            return;
        }

        _loading  = true;
        _searched = false;
        StateHasChanged();

        try
        {
            _records  = await PayrollService.GetManualAttendanceAsync(_month);
            _searched = true;

            if (_records.Any())
                Snackbar.Add($"تم تحميل {_records.Count} موظف معفى", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // حفظ موظف واحد
    private async Task SaveOneAsync(ManualAttendanceDto dto)
    {
        var (ok, msg) = await PayrollService.SaveManualAttendanceAsync(dto, _currentUser);
        Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);
        if (ok) await LoadAsync(); // إعادة تحميل لتحديث الـ ManualID
    }

    // حفظ الكل دفعة واحدة
    private async Task SaveAllAsync()
    {
        _saving = true;
        StateHasChanged();

        int success = 0, failed = 0;
        foreach (var dto in _records)
        {
            var (ok, _) = await PayrollService.SaveManualAttendanceAsync(dto, _currentUser);
            if (ok) success++; else failed++;
        }

        _saving = false;
        Snackbar.Add(
            $"تم حفظ {success} موظف" + (failed > 0 ? $" | فشل {failed}" : ""),
            failed > 0 ? Severity.Warning : Severity.Success);

        if (success > 0) await LoadAsync();
    }

    private static bool ValidateMonth(string? m) =>
        !string.IsNullOrWhiteSpace(m) &&
        DateTime.TryParseExact(m + "-01", "yyyy-MM-dd",
            null, System.Globalization.DateTimeStyles.None, out _);
}

<style>
    /* ══ (12-H13) Premium Header — نفس تصميم لوحة الخزينة بالضبط ══ */
    .man-page {
        --gold: #D4A853; --gold-dark: #B8912A;
        --navy: #1B2A4A; --navy-dark: #0F1D36; --navy-light: #2D4A7A;
        max-width: 1800px; margin: 0 auto; position: relative;
    }
    @@keyframes manFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-18px); } }
    @@keyframes manShimmer { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }
    @@keyframes manPulse { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.15); opacity: 0.7; } }

    .top-accent { height: 5px; background: linear-gradient(90deg, var(--gold), var(--gold-dark), var(--gold)); position: relative; overflow: hidden; margin-bottom: 1.5rem; border-radius: 0 0 10px 10px; }
    .accent-shimmer { position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent); animation: manShimmer 3s ease-in-out infinite; }

    .dash-header { position: relative; border-radius: 24px; overflow: hidden; margin-bottom: 1.5rem; }
    .dh-bg { position: absolute; inset: 0; }
    .dh-gradient { position: absolute; inset: 0; background: linear-gradient(135deg, #070D1A 0%, var(--navy) 40%, var(--navy-light) 100%); }
    .dh-orbs { position: absolute; inset: 0; overflow: hidden; }
    .dh-orb { position: absolute; border-radius: 50%; }
    .dh-o1 { width: 380px; height: 380px; top: -160px; right: -100px; background: radial-gradient(circle, rgba(212,168,83,0.3), transparent 60%); animation: manFloat 8s ease-in-out infinite; }
    .dh-o2 { width: 260px; height: 260px; bottom: -100px; left: 15%; background: radial-gradient(circle, rgba(212,168,83,0.15), transparent 60%); }
    .dh-o3 { width: 180px; height: 180px; top: 30%; left: 8%; background: radial-gradient(circle, rgba(255,255,255,0.04), transparent 60%); }
    .dh-grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px); background-size: 40px 40px; }
    .dh-content { position: relative; z-index: 2; padding: 2rem 2.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem; }
    .dh-info { display: flex; align-items: center; gap: 1.5rem; }
    .dh-icon-wrap { position: relative; width: 80px; height: 80px; }
    .dh-icon-glow { position: absolute; inset: -15px; background: radial-gradient(circle, rgba(212,168,83,0.4), transparent 70%); filter: blur(20px); animation: manPulse 3s ease-in-out infinite; }
    .dh-icon { position: relative; width: 100%; height: 100%; background: linear-gradient(135deg, var(--gold), var(--gold-dark)); border-radius: 22px; display: flex; align-items: center; justify-content: center; color: var(--navy-dark); box-shadow: 0 10px 40px rgba(212,168,83,0.4), inset 0 1px 0 rgba(255,255,255,0.2); }
    .dh-icon ::deep .mud-icon-root { font-size: 38px !important; color: var(--navy-dark) !important; }
    .dh-badge { position: absolute; bottom: -6px; left: -6px; width: 28px; height: 28px; background: linear-gradient(135deg, var(--gold), var(--gold-dark)); border-radius: 50%; border: 3px solid var(--navy-dark); display: flex; align-items: center; justify-content: center; color: white; }
    .dh-badge ::deep .mud-icon-root { font-size: 13px !important; color: white !important; }
    .dh-text { color: white; }
    .dh-title-row { display: flex; align-items: center; gap: 0.85rem; flex-wrap: wrap; }
    .dh-text h1 { margin: 0; font-size: 1.9rem; font-weight: 900; letter-spacing: -0.5px; line-height: 1.2; }
    .premium-tag { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.85rem; background: linear-gradient(135deg, var(--gold), var(--gold-dark)); border-radius: 20px; font-size: 0.72rem; font-weight: 700; color: var(--navy-dark); box-shadow: 0 4px 12px rgba(212,168,83,0.3); }
    .premium-tag ::deep .mud-icon-root { font-size: 12px !important; color: var(--navy-dark) !important; }
    .dh-subtitle { display: flex; align-items: center; gap: 0.5rem; margin: 0.5rem 0 0; color: rgba(255,255,255,0.7); font-size: 0.92rem; }
    .dh-subtitle ::deep .mud-icon-root { color: var(--gold) !important; font-size: 16px !important; }
    .dh-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }
    .dh-btn-primary { background: linear-gradient(135deg, var(--gold), var(--gold-dark)) !important; color: var(--navy-dark) !important; font-weight: 700 !important; border-radius: 12px !important; padding: 0.65rem 1.25rem !important; box-shadow: 0 8px 20px rgba(212,168,83,0.3) !important; position: relative; overflow: hidden; text-transform: none !important; }
    .btn-shine { position: absolute; top: 0; left: -100%; width: 100%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.5), transparent); animation: manShimmer 3s ease-in-out infinite; }

    /* ══ فلتر سطر واحد ══ */
    .man-filter-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .man-filter-row .mfr-month { flex: 0 0 190px; }
    .man-filter-row .mfr-btn { flex: 0 0 auto; height: 40px; border-radius: 8px; }
    .mfr-hint { display: flex; align-items: center; gap: 6px; color: #94a3b8; font-size: 12.5px; }

    /* ══ الملخص ══ */
    .man-summary { display: flex; gap: 10px; flex-wrap: wrap; }
    .man-sum-item { flex: 1 1 150px; background: #fff; border: 1px solid #e8edf5; border-radius: 14px; padding: 10px 16px; display: flex; flex-direction: column; gap: 2px; }
    .man-sum-item span { font-size: 11.5px; color: #7a869c; font-weight: 600; }
    .man-sum-item b { font-size: 1.25rem; color: #1B2A4A; }
    .man-sum-item b.ok { color: #059669; }
    .man-sum-item b.bad { color: #dc2626; }
    .man-sum-item b.warn { color: #d97706; }

    /* ══ الجدول والحقول ══ */
    .man-table-shell { border: 1px solid #e8edf5; border-radius: 14px; overflow: hidden; background: #fff; }
    .man-table-shell ::deep .mud-table-head .mud-table-cell { background: #f8fafc; font-weight: 800; color: #1B2A4A; }
    .man-avatar { background: linear-gradient(135deg, var(--gold), var(--gold-dark)) !important; color: var(--navy-dark) !important; font-weight: 800; }
    .man-num { width: 96px !important; }
    .man-num ::deep input { text-align: center; font-weight: 800; }
    .man-num-wide { width: 120px !important; }
    .man-note { min-width: 190px; }
    .man-note ::deep input { font-size: 12.5px; }

    .man-info-strip { display: flex; align-items: center; gap: 8px; background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; border-radius: 12px; padding: 10px 14px; font-size: 12.5px; }

    @@media (max-width: 768px) {
        .dh-content { flex-direction: column; align-items: flex-start; padding: 1.5rem; }
        .dh-text h1 { font-size: 1.5rem; }
    }
</style>
