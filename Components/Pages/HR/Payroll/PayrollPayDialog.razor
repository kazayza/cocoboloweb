@using COCOBOLOERPNEW.DTOs
@using MudBlazor

<MudDialog>
    <DialogContent>
        <div class="paydlg-summary">
            <div class="paydlg-emp">
                <span class="paydlg-name">@EmployeeName</span>
                <span class="paydlg-meta">راتب شهر @MonthDisplay</span>
            </div>
            <div class="paydlg-net">
                <span>الصافي المستحق</span>
                <b>@NetSalary.ToString("N2") جـ</b>
            </div>
        </div>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="my-3">
            سيتم صرف صافي الراتب، وأي إضافات منفصلة محفوظة على هذا الراتب ستُصرف كحركات مستقلة من نفس الخزينة.
        </MudAlert>

        <MudSelect T="int?" @bind-Value="_cashBoxId" Label="الخزينة" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth>
            @foreach (var cb in CashBoxes)
            {
                <MudSelectItem T="int?" Value="@((int?)cb.CashBoxId)">@cb.CashBoxName (@cb.CurrentBalance.ToString("N0") جـ)</MudSelectItem>
            }
        </MudSelect>

        @if (SelectedBalance.HasValue && SelectedBalance.Value < NetSalary)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                رصيد هذه الخزينة (@SelectedBalance.Value.ToString("N0") جـ) أقل من الصافي المستحق (@NetSalary.ToString("N0") جـ)
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">إلغاء</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.Payment"
                   OnClick="Submit" Disabled="!_cashBoxId.HasValue">
            صرف
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string EmployeeName { get; set; } = "";
    [Parameter] public string MonthDisplay { get; set; } = "";
    [Parameter] public decimal NetSalary { get; set; }
    [Parameter] public List<CashBoxListDto> CashBoxes { get; set; } = new();

    private int? _cashBoxId;

    private decimal? SelectedBalance => CashBoxes.FirstOrDefault(c => c.CashBoxId == _cashBoxId)?.CurrentBalance;

    protected override void OnInitialized()
    {
        _cashBoxId = CashBoxes.FirstOrDefault(c => c.IsDefault)?.CashBoxId
                     ?? CashBoxes.FirstOrDefault()?.CashBoxId;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit() => MudDialog.Close(DialogResult.Ok(_cashBoxId));
}

<style>
    .paydlg-summary { display: flex; align-items: center; justify-content: space-between; gap: 12px; background: #f8fafc; border: 1px solid #e8edf5; border-radius: 12px; padding: 10px 14px; flex-wrap: wrap; }
    .paydlg-emp { display: flex; flex-direction: column; gap: 2px; }
    .paydlg-name { font-weight: 800; color: #1B2A4A; font-size: 15px; }
    .paydlg-meta { font-size: 12px; color: #7a869c; font-weight: 600; }
    .paydlg-net { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }
    .paydlg-net span { font-size: 11px; color: #7a869c; font-weight: 600; }
    .paydlg-net b { font-size: 17px; color: #059669; font-weight: 900; white-space: nowrap; }
</style>
