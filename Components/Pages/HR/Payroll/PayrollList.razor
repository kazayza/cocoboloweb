@page "/hr/payroll"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using Microsoft.AspNetCore.WebUtilities
@using MudBlazor

@inject IPayrollService PayrollService
@inject ICashBoxService CashBoxService
@inject IBranchService BranchService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS

<PageTitle>سجل المرتبات</PageTitle>

<div class="pl-page">

    <div class="top-accent"><div class="accent-shimmer"></div></div>

    @* ══ (12-H16) Premium Header ══ *@
    <div class="dash-header">
        <div class="dh-bg">
            <div class="dh-gradient"></div>
            <div class="dh-orbs">
                <div class="dh-orb dh-o1"></div>
                <div class="dh-orb dh-o2"></div>
                <div class="dh-orb dh-o3"></div>
            </div>
            <div class="dh-grid"></div>
        </div>
        <div class="dh-content">
            <div class="dh-info">
                <div class="dh-icon-wrap">
                    <div class="dh-icon-glow"></div>
                    <div class="dh-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Large" />
                    </div>
                    <div class="dh-badge"><MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" /></div>
                </div>
                <div class="dh-text">
                    <div class="dh-title-row">
                        <h1>سجل المرتبات</h1>
                        <span class="premium-tag">
                            <MudIcon Icon="@Icons.Material.Filled.Diamond" Size="Size.Small" />
                            Premium
                        </span>
                    </div>
                    <p class="dh-subtitle">
                        <MudIcon Icon="@Icons.Material.Filled.Insights" Size="Size.Small" />
                        مراجعة واعتماد وصرف المرتبات المحفوظة من شاشة المعالجة — @DateTime.Now.ToString("dddd yyyy/MM/dd", new System.Globalization.CultureInfo("ar-EG"))
                    </p>
                </div>
            </div>
            <div class="dh-actions">
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                           OnClick='@(() => Nav.NavigateTo("/hr/payroll/processor"))' Class="dh-btn-primary">
                    <span class="btn-shine"></span>معالجة مرتبات جديدة
                </MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CardGiftcard"
                           OnClick='@(() => Nav.NavigateTo("/hr/payroll/bonuses"))' Class="dh-btn-ghost">
                    دفعات خارج الراتب
                </MudButton>
            </div>
        </div>
    </div>

    @* ══ شريط المسار (بدل الـAlert الدائم) ══ *@
    <div class="pl-steps mb-3">
        <span class="pl-step"><b>1</b> معالجة الشهر</span>
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Class="pl-step-arrow" />
        <span class="pl-step"><b>2</b> حفظ وإرسال للمراجعة</span>
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Class="pl-step-arrow" />
        <span class="pl-step"><b>3</b> اعتماد</span>
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Class="pl-step-arrow" />
        <span class="pl-step"><b>4</b> صرف فردي</span>
        <span class="pl-steps-note">
            <MudIcon Icon="@Icons.Material.Filled.Info" />
            الإضافات المنفصلة تُسجل داخل الراتب للمراجعة ولكن تُصرف كحركة مستقلة عند الدفع
        </span>
    </div>

    @* ══ الإحصاءات ══ *@
    @if (_stats is not null)
    {
        <div class="pl-stats-bar mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Insights" />
            <span>إحصاء @_statsTitle</span>
            @if (string.IsNullOrEmpty(_filter.PayrollMonth))
            {
                <span class="pl-stats-hint">
                    <MudIcon Icon="@Icons.Material.Filled.Info" />
                    «كل الشهور» محددة — الإحصاء المعروض للشهر الحالي فقط
                </span>
            }
        </div>

        <div class="pl-summary mb-4">
            <div class="pl-sum-item">
                <div class="pl-sum-ic navy"><MudIcon Icon="@Icons.Material.Filled.Payments" /></div>
                <div class="pl-sum-txt">
                    <span>إجمالي الصافي</span>
                    <b class="navy">@_stats.TotalNetThisMonth.ToString("N0") جـ</b>
                </div>
            </div>
            <div class="pl-sum-item">
                <div class="pl-sum-ic amber"><MudIcon Icon="@Icons.Material.Filled.RateReview" /></div>
                <div class="pl-sum-txt">
                    <span>قيد المراجعة</span>
                    <b class="amber">@_stats.ReviewCount</b>
                </div>
            </div>
            <div class="pl-sum-item">
                <div class="pl-sum-ic blue"><MudIcon Icon="@Icons.Material.Filled.Verified" /></div>
                <div class="pl-sum-txt">
                    <span>معتمد</span>
                    <b class="blue">@_stats.ApprovedCount</b>
                </div>
            </div>
            <div class="pl-sum-item">
                <div class="pl-sum-ic green"><MudIcon Icon="@Icons.Material.Filled.Paid" /></div>
                <div class="pl-sum-txt">
                    <span>مدفوع</span>
                    <b class="green">@_stats.PaidCount</b>
                </div>
            </div>
            <div class="pl-sum-item">
                <div class="pl-sum-ic purple"><MudIcon Icon="@Icons.Material.Filled.CardGiftcard" /></div>
                <div class="pl-sum-txt">
                    <span>إضافات منفصلة</span>
                    <b class="purple">@_stats.TotalSeparateBonuses.ToString("N0") جـ</b>
                </div>
            </div>
            <div class="pl-sum-item">
                <div class="pl-sum-ic red"><MudIcon Icon="@Icons.Material.Filled.History" /></div>
                <div class="pl-sum-txt">
                    <span>غير مدفوع قديم</span>
                    <b class="red">@_stats.PendingCount</b>
                </div>
            </div>
        </div>
    }

    @* ══ شرائح الشهور ══ *@
    <div class="month-picker-row">
        <span class="month-picker-label">
            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" />
            اختر الشهر
        </span>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                       Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                       Class="month-nav-btn" Title="شهر أقدم"
                       Disabled="@(!_canNavigateMonths)"
                       OnClick="GoToPrevMonthAsync" />
        @foreach (var m in _monthChips)
        {
            <button type="button"
                    class="month-chip @(IsMonthActive(m.Month) ? "active" : "")"
                    @onclick="() => SelectMonthAsync(m.Month)">
                <span class="month-chip-name">@FormatMonth(m.Month)</span>
                <span class="month-chip-meta">@(m.PayrollCount > 0 ? $"{m.PayrollCount} مرتب · {FormatCompactMoney(m.TotalNet)}" : "لا مرتبات")</span>
            </button>
        }
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                       Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                       Class="month-nav-btn" Title="شهر أحدث"
                       Disabled="@(!_canNavigateMonths)"
                       OnClick="GoToNextMonthAsync" />
        <button type="button"
                class="month-chip all-chip @(string.IsNullOrEmpty(_filter.PayrollMonth) ? "active" : "")"
                @onclick="SelectAllMonthsAsync">
            <span class="month-chip-name">كل الشهور</span>
        </button>
    </div>

    @* ══ الفلاتر — سطر واحد (بدون قائمة الشهر المكررة) ══ *@
    <div class="sticky-filter-shell">
        <MudPaper Class="pa-3 mb-3 rounded-xl d-flex align-center gap-3 flex-wrap">
            <MudTextField @bind-Value="_filter.SearchText"
                          Placeholder="بحث باسم الموظف أو القسم"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="min-width:220px"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          OnKeyUp="OnSearchKeyUp" />

            <MudSelect T="string"
                       @bind-Value="_selectedStatus"
                       Placeholder="الحالة"
                       Style="min-width:170px"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true">
                <MudSelectItem T="string" Value="@PayrollPaymentStatuses.PendingReview">قيد المراجعة</MudSelectItem>
                <MudSelectItem T="string" Value="@PayrollPaymentStatuses.Approved">معتمد</MudSelectItem>
                <MudSelectItem T="string" Value="@PayrollPaymentStatuses.Paid">مدفوع</MudSelectItem>
                <MudSelectItem T="string" Value="@PayrollPaymentStatuses.Rejected">مرفوض</MudSelectItem>
                <MudSelectItem T="string" Value="@PayrollPaymentStatuses.Unpaid">غير مدفوع</MudSelectItem>
                <MudSelectItem T="string" Value="@PayrollPaymentStatuses.Cancelled">ملغي</MudSelectItem>
            </MudSelect>

            <MudSelect T="int?"
                       Value="_filter.BranchId"
                       ValueChanged="@(async v => { _filter.BranchId = v; await SearchAsync(); })"
                       Placeholder="كل الفروع"
                       Style="min-width:175px"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true" ClearText="كل الفروع">
                @foreach (var b in _branches)
                {
                    <MudSelectItem T="int?" Value="b.BranchId">@b.BranchNameAr</MudSelectItem>
                }
            </MudSelect>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Search"
                       OnClick="SearchAsync">
                بحث
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Rounded.TableChart"
                       Style="color:#10B981; border-color:#10B981;"
                       OnClick="ExportExcelAsync"
                       Disabled="_exporting"
                       Class="no-print">
                @(_exporting ? "جاري..." : "تصدير Excel")
            </MudButton>
        </MudPaper>
    </div>

    @* ══ الجدول ══ *@
    <MudPaper Class="rounded-xl overflow-hidden pl-table-wrap">
        @if (_loading)
        {
            <MudProgressLinear Indeterminate Color="Color.Primary" />
        }

        <MudTable Items="_payrolls" Dense Hover Striped Elevation="0" Loading="_loading">
            <HeaderContent>
                <MudTh>الموظف</MudTh>
                <MudTh>الشهر</MudTh>
                <MudTh>المبالغ</MudTh>
                <MudTh>الحضور</MudTh>
                <MudTh>الحالة</MudTh>
                <MudTh>إجراءات</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudText><b>@context.EmployeeName</b></MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @EmployeeMeta(context)
                    </MudText>
                </MudTd>

                <MudTd>
                    <MudText Typo="Typo.body2">@FormatMonth(context.PayrollMonth)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.PayrollMonth</MudText>
                </MudTd>

                <MudTd>
                    <MudText Typo="Typo.body1" Style="font-weight:800">@context.NetSalary.ToString("N2") جـ</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        أساسي @context.BasicSalary.ToString("N0") + إضافات @context.BonusInPayroll.ToString("N0") جـ
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Error">خصومات @context.TotalDeductions.ToString("N0") جـ</MudText>
                </MudTd>

                <MudTd>
                    <MudText Typo="Typo.body2">@context.PresentDays / @context.WorkingDaysInMonth</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        غياب @context.AbsenceDays يوم · تأخير @context.LateDisplay
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="@(context.IsManualAttendance ? Color.Warning : Color.Default)">
                        @(context.IsManualAttendance ? "يدوي" : "بصمة")
                    </MudChip>
                </MudTd>

                <MudTd>
                    <MudChip T="string"
                             Size="Size.Small"
                             Style="@($"background:{context.StatusColor};color:white")">
                        @context.PaymentStatus
                    </MudChip>
                    @if (context.PaymentDate.HasValue)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @context.PaymentDate.Value.ToString("dd/MM/yyyy HH:mm")
                        </MudText>
                    }
                    else if (context.CreatedAt.HasValue)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            تم الإنشاء @context.CreatedAt.Value.ToString("dd/MM/yyyy")
                        </MudText>
                    }
                </MudTd>

                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Receipt"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   Title="قسيمة الراتب"
                                   OnClick="@(() => OpenPayslipAsync(context.PayrollID))" />

                    @if (context.PaymentStatus == PayrollPaymentStatuses.PendingReview && _canReview)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                       Size="Size.Small"
                                       Color="Color.Success"
                                       Title="اعتماد"
                                       OnClick="@(() => ApproveAsync(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       Title="رفض"
                                       OnClick="@(() => OpenRejectDialog(context))" />
                    }

                    @if ((context.PaymentStatus == PayrollPaymentStatuses.Approved || context.PaymentStatus == PayrollPaymentStatuses.Unpaid) && _canPay)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Payment"
                                       Size="Size.Small"
                                       Color="Color.Success"
                                       Title="صرف فردي"
                                       OnClick="@(() => OpenPayDialog(context))" />
                    }

                    @if (context.PaymentStatus != PayrollPaymentStatuses.Paid)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       Title="إلغاء"
                                       OnClick="@(() => CancelAsync(context))" />
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4" Color="Color.Secondary" Align="Align.Center">
                    لا توجد مرتبات مطابقة للفلاتر الحالية
                </MudText>
            </NoRecordsContent>
        </MudTable>

        @if (_totalPages > 1)
        {
            <div class="d-flex align-center justify-space-between pa-3">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    إجمالي @_totalCount مرتب
                </MudText>
                <MudPagination Count="_totalPages"
                               Selected="_filter.PageNumber"
                               SelectedChanged="OnPageChangedAsync"
                               Color="Color.Primary" />
            </div>
        }
    </MudPaper>
</div>

@code {
    private List<PayrollListDto> _payrolls = new();
    private PayrollStatsDto? _stats;
    private PayrollFilterDto _filter = new()
    {
        PayrollMonth = DateTime.Today.ToString("yyyy-MM"),
        PageSize = 20
    };

    private string _currentMonth = DateTime.Today.ToString("yyyy-MM");
    private List<PayrollMonthSummaryDto> _months = new();
    private List<PayrollMonthSummaryDto> _monthChips = new();
    private List<BranchOptionDto> _branches = new();
    private string _selectedStatus = string.Empty;
    private bool _loading = true;
    private bool _exporting;
    private int _totalCount;
    private int _totalPages => (int)Math.Ceiling((double)_totalCount / _filter.PageSize);
    private string _currentUser = "system";
    private bool _canReview;
    private bool _canPay;
    private List<CashBoxListDto> _cashBoxes = new();

    // (12-H16) عنوان الإحصاء يوضح الشهر الفعلي المعروض
    private string _statsTitle => FormatMonth(_filter.PayrollMonth ?? _currentMonth);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        _currentUser = user.Identity?.Name ?? "system";

        var canView = user.IsInRole("Admin")
                      || user.IsInRole("HrManager")
                      || user.IsInRole("HRManager")
                      || user.IsInRole("AccountManager")
                      || user.IsInRole("Accountant")
                      || user.IsInRole("AccountsManager")
                      || user.HasClaim("Permission", "frmPayrollProcessor:View")
                      || user.HasClaim("Permission", "frm_Payroll:View");

        // (12-H16) توحيد مسمى AccountsManager مع باقي الشاشات
        _canReview = user.IsInRole("Admin") || user.IsInRole("AccountManager") || user.IsInRole("AccountsManager");
        _canPay = user.IsInRole("Admin") || user.IsInRole("AccountManager") || user.IsInRole("AccountsManager");

        if (!canView)
        {
            Nav.NavigateTo("/access-denied");
            return;
        }

        // قراءة الشهر من الرابط ?month=2026-05 (لينك قابل للمشاركة وزر رجوع سليم)
        try
        {
            var query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
            if (query.TryGetValue("month", out var monthValue)
                && !string.IsNullOrWhiteSpace(monthValue))
            {
                _filter.PayrollMonth = monthValue.ToString();
            }
        }
        catch { }

        _cashBoxes = await CashBoxService.GetCashBoxesAsync(activeOnly: true);

        try
        {
            _branches = await BranchService.GetBranchesForFilterAsync();
        }
        catch { _branches = new(); }

        await LoadMonthSummariesAsync();
        await LoadAsync();
        await LoadStatsAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var result = await PayrollService.GetPayrollsAsync(_filter);
            _payrolls = result.Items;
            _totalCount = result.TotalCount;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ في تحميل المرتبات: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadStatsAsync()
    {
        try
        {
            _stats = await PayrollService.GetStatsAsync(_filter.PayrollMonth ?? DateTime.Today.ToString("yyyy-MM"));
        }
        catch
        {
            _stats = null;
        }
    }

    // ── اختيار الشهر: شرائح + تنقل ‹ › ──────────────────
    private bool _canNavigateMonths =>
        !string.IsNullOrEmpty(_filter.PayrollMonth) && _months.Count > 1;

    private async Task LoadMonthSummariesAsync()
    {
        try
        {
            _months = await PayrollService.GetMonthSummariesAsync();
        }
        catch
        {
            _months = new List<PayrollMonthSummaryDto>();
        }

        // الشهر الحالي يظهر دائماً حتى لو فاضي (بعدد 0)
        if (_months.All(m => m.Month != _currentMonth))
            _months.Insert(0, new PayrollMonthSummaryDto { Month = _currentMonth });

        if (string.IsNullOrWhiteSpace(_filter.PayrollMonth))
            _filter.PayrollMonth = _currentMonth;

        _monthChips = _months.Take(6).ToList();
    }

    private bool IsMonthActive(string month) => _filter.PayrollMonth == month;

    private async Task SelectMonthAsync(string month)
    {
        if (_filter.PayrollMonth == month) return;
        _filter.PayrollMonth = month;
        _filter.PageNumber = 1;
        await SearchAsync();
        SyncMonthInUrl();
    }

    private async Task SelectAllMonthsAsync()
    {
        _filter.PayrollMonth = null;
        _filter.PageNumber = 1;
        await SearchAsync();
        SyncMonthInUrl();
    }

    private async Task GoToPrevMonthAsync() // شهر أقدم
    {
        var idx = _months.FindIndex(m => m.Month == _filter.PayrollMonth);
        if (idx < 0 || idx >= _months.Count - 1) return;
        await SelectMonthAsync(_months[idx + 1].Month);
    }

    private async Task GoToNextMonthAsync() // شهر أحدث
    {
        var idx = _months.FindIndex(m => m.Month == _filter.PayrollMonth);
        if (idx <= 0) return;
        await SelectMonthAsync(_months[idx - 1].Month);
    }

    private void SyncMonthInUrl()
    {
        try
        {
            Nav.NavigateTo(Nav.GetUriWithQueryParameter("month", (string?)_filter.PayrollMonth), replace: true);
        }
        catch { }
    }

    private static string FormatCompactMoney(decimal v) =>
        v >= 1_000_000m ? $"{v / 1_000_000m:N1} مليون ج" : $"{v / 1_000m:N0} ألف ج";

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    private async Task SearchAsync()
    {
        _filter.PaymentStatus = string.IsNullOrWhiteSpace(_selectedStatus) ? null : _selectedStatus;
        _filter.PageNumber = 1;
        await LoadAsync();
        await LoadStatsAsync();
    }

    private async Task OnPageChangedAsync(int page)
    {
        _filter.PageNumber = page;
        await LoadAsync();
    }

    private async Task ExportExcelAsync()
    {
        _exporting = true;
        StateHasChanged();

        try
        {
            var exportFilter = new PayrollFilterDto
            {
                PayrollMonth = _filter.PayrollMonth,
                MonthFrom = _filter.MonthFrom,
                MonthTo = _filter.MonthTo,
                EmployeeID = _filter.EmployeeID,
                Department = _filter.Department,
                PaymentStatus = string.IsNullOrWhiteSpace(_selectedStatus) ? null : _selectedStatus,
                SearchText = _filter.SearchText,
                HasLoans = _filter.HasLoans,
                AttendanceSource = _filter.AttendanceSource,
                MinNetSalary = _filter.MinNetSalary,
                MaxNetSalary = _filter.MaxNetSalary,
                MinDeductions = _filter.MinDeductions,
                MaxDeductions = _filter.MaxDeductions,
                PageNumber = 1,
                PageSize = 100000
            };

            var bytes = await PayrollService.ExportPayrollsExcelAsync(exportFilter);
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFileFromBase64", base64,
                $"سجل_المرتبات_{_filter.PayrollMonth ?? DateTime.Today.ToString("yyyy-MM")}.xlsx");

            Snackbar.Add("تم التصدير بنجاح", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ: {ex.Message}", Severity.Error);
        }
        finally
        {
            _exporting = false;
            StateHasChanged();
        }
    }

    private async Task OpenPayslipAsync(int payrollId)
    {
        var parameters = new DialogParameters
        {
            [nameof(PayslipDialog.PayrollId)] = payrollId,
            [nameof(PayslipDialog.CurrentUser)] = _currentUser
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        await DialogService.ShowAsync<PayslipDialog>("قسيمة الراتب", parameters, options);
    }

    private async Task ApproveAsync(PayrollListDto payroll)
    {
        var (ok, msg) = await PayrollService.ApprovePayrollAsync(payroll.PayrollID, _currentUser);
        Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);

        if (ok)
        {
            await LoadAsync();
            await LoadStatsAsync();
        }
    }

    // (12-H16) حوار الرفض عبر DialogService (بدل inline MudDialog)
    private async Task OpenRejectDialog(PayrollListDto payroll)
    {
        var parameters = new DialogParameters
        {
            [nameof(PayrollRejectDialog.EmployeeName)] = payroll.EmployeeName,
            [nameof(PayrollRejectDialog.MonthDisplay)] = FormatMonth(payroll.PayrollMonth)
        };

        var dialog = await DialogService.ShowAsync<PayrollRejectDialog>(
            "رفض راتب", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            var reason = result.Data as string;
            var (ok, msg) = await PayrollService.RejectPayrollAsync(
                payroll.PayrollID, _currentUser,
                string.IsNullOrWhiteSpace(reason) ? null : reason);

            Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);
            if (ok)
            {
                await LoadAsync();
                await LoadStatsAsync();
            }
        }
    }

    // (12-H16) حوار الصرف عبر DialogService (بدل inline MudDialog)
    private async Task OpenPayDialog(PayrollListDto payroll)
    {
        var parameters = new DialogParameters
        {
            [nameof(PayrollPayDialog.EmployeeName)] = payroll.EmployeeName,
            [nameof(PayrollPayDialog.MonthDisplay)] = FormatMonth(payroll.PayrollMonth),
            [nameof(PayrollPayDialog.NetSalary)] = payroll.NetSalary,
            [nameof(PayrollPayDialog.CashBoxes)] = _cashBoxes
        };

        var dialog = await DialogService.ShowAsync<PayrollPayDialog>(
            "صرف راتب فردي", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });

        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is int cashBoxId)
        {
            var (ok, msg) = await PayrollService.PayOneAsync(payroll.PayrollID, cashBoxId, _currentUser);
            Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);
            if (ok)
            {
                await LoadAsync();
                await LoadStatsAsync();
            }
        }
    }

    private async Task CancelAsync(PayrollListDto payroll)
    {
        var parameters = new DialogParameters<MudMessageBox>
        {
            { x => x.Message,    $"هل تريد إلغاء راتب {payroll.EmployeeName} لشهر {payroll.PayrollMonth}؟" },
            { x => x.YesText,    "إلغاء الراتب" },
            { x => x.CancelText, "تراجع" }
        };

        var dialog = await DialogService.ShowAsync<MudMessageBox>(
            "تأكيد الإلغاء", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall });

        if ((await dialog.Result) is { Canceled: true })
            return;

        var (ok, msg) = await PayrollService.CancelAsync(payroll.PayrollID, _currentUser);
        Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);

        if (ok)
        {
            await LoadAsync();
            await LoadStatsAsync();
        }
    }

    private static string EmployeeMeta(PayrollListDto payroll) =>
        string.IsNullOrWhiteSpace(payroll.JobTitle)
            ? (payroll.Department ?? "—")
            : $"{payroll.Department ?? "—"} · {payroll.JobTitle}";

    private static string FormatMonth(string? month) =>
        string.IsNullOrWhiteSpace(month)
            ? "—"
            : DateTime.TryParseExact(month + "-01", "yyyy-MM-dd", null,
                System.Globalization.DateTimeStyles.None, out var date)
                ? date.ToString("MMMM yyyy", new System.Globalization.CultureInfo("ar-EG"))
                : month;
}

