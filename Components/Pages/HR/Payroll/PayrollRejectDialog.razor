@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            سيتم تسجيل راتب <b>@EmployeeName</b> لشهر @MonthDisplay كمرفوض.
        </MudText>
        <MudTextField T="string" @bind-Value="_reason" Label="سبب الرفض (اختياري)"
                      Variant="Variant.Outlined" Lines="3" MaxLength="300" Counter="300" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">إلغاء</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Close" OnClick="Submit">
            رفض
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string EmployeeName { get; set; } = "";
    [Parameter] public string MonthDisplay { get; set; } = "";

    private string? _reason;

    private void Cancel() => MudDialog.Cancel();

    private void Submit() => MudDialog.Close(DialogResult.Ok(_reason ?? ""));
}
