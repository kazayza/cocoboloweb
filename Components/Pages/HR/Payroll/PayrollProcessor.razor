@page "/hr/payroll/processor"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using MudBlazor
@using System.Globalization

@inject IPayrollService PayrollService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS

<PageTitle>معالجة المرتبات</PageTitle>

<div dir="rtl" class="pp-page">

    <div class="top-accent"><div class="accent-shimmer"></div></div>

    @* (12-H14) منع مغادرة الصفحة وفيه تعديلات غير مرسلة *@
    <NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

    @* ══ Premium Header ══ *@
    <div class="dash-header">
        <div class="dh-bg">
            <div class="dh-gradient"></div>
            <div class="dh-orbs">
                <div class="dh-orb dh-o1"></div>
                <div class="dh-orb dh-o2"></div>
                <div class="dh-orb dh-o3"></div>
            </div>
            <div class="dh-grid"></div>
        </div>
        <div class="dh-content">
            <div class="dh-info">
                <div class="dh-icon-wrap">
                    <div class="dh-icon-glow"></div>
                    <div class="dh-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Calculate" Size="Size.Large" />
                    </div>
                    <div class="dh-badge"><MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" /></div>
                </div>
                <div class="dh-text">
                    <div class="dh-title-row">
                        <h1>معالجة المرتبات</h1>
                        <span class="premium-tag">
                            <MudIcon Icon="@Icons.Material.Filled.Diamond" Size="Size.Small" />
                            Premium
                        </span>
                    </div>
                    <p class="dh-subtitle">
                        <MudIcon Icon="@Icons.Material.Filled.Insights" Size="Size.Small" />
                        احسب المرتبات وراجع البنود ثم أرسلها للمراجعة — @DateTime.Now.ToString("dddd yyyy/MM/dd", new CultureInfo("ar-EG"))
                    </p>
                </div>
            </div>
            <div class="dh-actions">
                @if (_canProcess)
                {
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Calculate"
                               OnClick="CalculateAsync" Class="dh-btn-primary"
                               Disabled="_calculating || string.IsNullOrWhiteSpace(_selectedMonth)">
                        <span class="btn-shine"></span>@(_calculating ? "جاري الحساب..." : "احسب المرتبات")
                    </MudButton>
                }
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ListAlt"
                           OnClick='@(() => Nav.NavigateTo("/hr/payroll"))' Class="dh-btn-ghost">سجل الرواتب</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CardGiftcard"
                           OnClick='@(() => Nav.NavigateTo("/hr/payroll/bonuses"))' Class="dh-btn-ghost">دفعات خارج الراتب</MudButton>
            </div>
        </div>
    </div>

    @* ══ شريط الخطوات والتنبيه ══ *@
    <div class="pp-steps mb-3">
        <span class="pp-step"><b>1</b> احسب مرتبات الشهر</span>
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Class="pp-step-arrow" />
        <span class="pp-step"><b>2</b> راجع وعدّل البنود</span>
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Class="pp-step-arrow" />
        <span class="pp-step"><b>3</b> احفظ وأرسل للمراجعة</span>
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Class="pp-step-arrow" />
        <span class="pp-step"><b>4</b> الاعتماد والصرف من سجل الرواتب</span>
        <span class="pp-steps-note">
            <MudIcon Icon="@Icons.Material.Filled.Info" />
            هذه الشاشة لا تقوم بالصرف — بعد الإرسال يتم إشعار مدير الحسابات والأدمن
        </span>
    </div>

    @* ══ الفلتر — سطر واحد ══ *@
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius: 16px;">
        <div class="pp-filter-row">
            <MudSelect T="string" Class="pfr-month" Value="_selectedMonth" ValueChanged="OnMonthChangedAsync"
                       Label="الشهر" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var m in _monthOptions)
                {
                    <MudSelectItem T="string" Value="@m.Month">@FormatMonth(m.Month)@(m.PayrollCount > 0 ? " — مسجل" : "")</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="pfr-chip" OnClick="@(() => QuickMonthAsync(0))">الشهر الحالي</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="pfr-chip" OnClick="@(() => QuickMonthAsync(-1))">الشهر السابق</MudButton>
            @if (_calculations.Any() && _selectedMonth != _calculationsMonth)
            {
                <div class="pp-mismatch">
                    <MudIcon Icon="@Icons.Material.Filled.WarningAmber" />
                    <span>البيانات المعروضة محسوبة لشهر <b>@FormatMonth(_calculationsMonth)</b> — اضغط «احسب المرتبات» لتحديث الشهر المختار قبل الإرسال</span>
                </div>
            }
        </div>
    </MudPaper>

    @* ══ KPIs ══ *@
    @if (_calculations.Any())
    {
        <div class="pp-summary mb-3">
            <div class="pp-sum-item">
                <span>جاهز للإرسال</span>
                <b class="ok">@SelectedCount</b>
            </div>
            <div class="pp-sum-item">
                <span>إجمالي المستحق (مختار)</span>
                <b>@SelectedSum(c => c.GrossSalary).ToString("N0") جـ</b>
            </div>
            <div class="pp-sum-item">
                <span>إجمالي الخصومات (مختار)</span>
                <b class="bad">@SelectedSum(c => c.TotalDeductions).ToString("N0") جـ</b>
            </div>
            <div class="pp-sum-item">
                <span>إضافات خارج الراتب (مختار)</span>
                <b class="info">@SelectedSum(c => c.TotalSeparateBonuses).ToString("N0") جـ</b>
            </div>
            <div class="pp-sum-item">
                <span>صافي داخل الراتب (مختار)</span>
                <b class="warn">@SelectedSum(c => c.NetSalary).ToString("N0") جـ</b>
            </div>
        </div>
    }

    @if (_calculations.Any())
    {
        @* ══ أدوات الإرسال ══ *@
        <MudPaper Class="pa-3 mb-3" Elevation="2" Style="border-radius: 16px;">
            <div class="pp-toolbar">
                @if (_canProcess)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Send"
                               OnClick="SaveWithoutPayAsync"
                               Disabled="_processing || !HasSelected || _selectedMonth != _calculationsMonth">
                        @(_processing ? "جاري الإرسال..." : $"حفظ وإرسال للمراجعة ({SelectedCount} موظف)")
                    </MudButton>
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.FileDownload"
                           OnClick="ExportCsvAsync" Disabled="_exporting">
                    @(_exporting ? "جاري التصدير..." : "تصدير Excel")
                </MudButton>

                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                    تعديلات يدوية: @_calculations.Count(c => c.HasManualOverrides)
                </MudChip>
                <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small">
                    مسجلة مسبقًا: @_calculations.Count(c => c.HasExistingPayroll)
                </MudChip>
                <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small">
                    إضافات داخل الراتب: @_calculations.Sum(c => c.TotalBonusInPayroll).ToString("N0") جـ
                </MudChip>
                @if (_dirty)
                {
                    <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Size="Size.Small"
                             Icon="@Icons.Material.Filled.EditNote">
                        تعديلات غير مرسلة
                    </MudChip>
                }
            </div>
        </MudPaper>

        @* ══ بحث وفلاتر الجدول ══ *@
        <MudPaper Class="pa-4 mb-3" Elevation="2" Style="border-radius: 16px;">
            <div class="pp-filter-row">
                <MudTextField T="string" Class="pfr-search" Label="بحث بالاسم" @bind-Value="_searchText"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Immediate="true"
                              Placeholder="ابحث..." />
                <MudSelect T="string" Class="pfr-dept" Label="القسم" @bind-Value="_deptFilter"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" ClearText="كل الأقسام">
                    @foreach (var d in DepartmentOptions)
                    {
                        <MudSelectItem T="string" Value="@d">@d</MudSelectItem>
                    }
                </MudSelect>
                <MudCheckBox T="bool" @bind-Value="_onlyOverridden" Dense="true" Label="المعدّلون يدويًا فقط"
                             Color="Color.Warning" Class="pfr-check" />
            </div>
        </MudPaper>

        @* ══ الجدول ══ *@
        <div class="pp-table-shell mb-3">
            @if (_calculating)
            {
                <MudProgressLinear Indeterminate Color="Color.Primary" />
            }

            <MudTable Items="FilteredCalculations" Dense="true" Hover="true" Striped="true" Elevation="0">
                <HeaderContent>
                    <MudTh Style="width:50px">
                        <MudCheckBox T="bool" Value="_allSelected" ValueChanged="ToggleAll" Disabled="!_canProcess" />
                    </MudTh>
                    <MudTh>الموظف</MudTh>
                    <MudTh>الحضور</MudTh>
                    <MudTh>الخصومات الآلية</MudTh>
                    <MudTh>التعديلات اليدوية</MudTh>
                    <MudTh>الصافي داخل الراتب</MudTh>
                    <MudTh>إضافات منفصلة</MudTh>
                    <MudTh>الحالة</MudTh>
                    <MudTh Style="text-align:center">إجراءات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudCheckBox T="bool"
                                     Value="@context.IsSelected"
                                     ValueChanged="@(v => UpdateSelection(context, v))"
                                     Disabled="context.HasExistingPayroll || !_canProcess" />
                    </MudTd>

                    <MudTd>
                        <MudText Typo="Typo.body2" Style="font-weight:700">@context.EmployeeName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @(context.Department ?? "—") · أساسي @context.BasicSalary.ToString("N2") جـ
                        </MudText>
                    </MudTd>

                    <MudTd>
                        <MudText Typo="Typo.body2">
                            @context.PresentDays / @context.WorkingDaysInMonth
                            <MudTooltip Text="تفاصيل البصمة">
                                <MudIconButton Icon="@Icons.Material.Filled.Fingerprint" Size="Size.Small"
                                               Variant="Variant.Text" Color="Color.Info" Class="pp-mini-link"
                                               OnClick='@(() => Nav.NavigateTo("/attendance"))' />
                            </MudTooltip>
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            غياب @context.AbsenceDays يوم · تأخير @context.LateDisplay
                        </MudText>
                        <MudChip T="string" Size="Size.Small" Color="@(context.IsManualAttendance ? Color.Warning : Color.Default)">
                            @(context.IsManualAttendance ? "يدوي" : "بصمة")
                        </MudChip>
                    </MudTd>

                    <MudTd>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.caption">غياب: @FormatMoney(context.AbsenceDeduction)</MudText>
                            <MudText Typo="Typo.caption">تأخير: @FormatMoney(context.LateDeduction)</MudText>
                            <MudText Typo="Typo.caption">سلف: @FormatMoney(context.LoanDeduction)</MudText>
                            @if (context.HasManualOverrides)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                                    خصومات معدلة يدويًا
                                </MudChip>
                            }
                        </MudStack>
                    </MudTd>

                    <MudTd>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.caption">جزاءات/خصومات: @FormatMoney(context.TotalPenalties)</MudText>
                            <MudText Typo="Typo.caption">إضافات داخل الراتب: @FormatMoney(context.TotalBonusInPayroll)</MudText>
                            <MudText Typo="Typo.caption">عدد البنود: @(context.Penalties.Count + context.BonusItems.Count + context.SeparateBonuses.Count)</MudText>
                        </MudStack>
                    </MudTd>

                    <MudTd>
                        <MudText Typo="Typo.body1" Style="font-weight:800">@context.NetSalary.ToString("N2") جـ</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            إجمالي المستحق @context.GrossSalary.ToString("N2") جـ
                        </MudText>
                    </MudTd>

                    <MudTd>
                        @if (context.TotalSeparateBonuses > 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Info" Style="font-weight:700">@context.TotalSeparateBonuses.ToString("N2") جـ</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.SeparateBonuses.Count بند منفصل</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">لا يوجد</MudText>
                        }
                    </MudTd>

                    <MudTd>
                        @if (context.HasExistingPayroll)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">مسجل مسبقًا</MudChip>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Warning</MudText>
                        }
                        else if (!string.IsNullOrWhiteSpace(context.Warning))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">ملاحظة</MudChip>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Warning</MudText>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">جاهز للمراجعة</MudChip>
                        }
                    </MudTd>

                    <MudTd Style="text-align:center">
                        @if (!context.HasExistingPayroll && _canProcess)
                        {
                            <MudTooltip Text="تعديل البنود">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                               Color="Color.Primary" Variant="Variant.Outlined"
                                               OnClick="@(() => OpenItemsDialogAsync(context))" />
                            </MudTooltip>
                            <MudTooltip Text="إزالة من المعالجة">
                                <MudIconButton Icon="@Icons.Material.Filled.PersonRemove" Size="Size.Small"
                                               Color="Color.Error" Variant="Variant.Outlined"
                                               OnClick="@(() => RemoveEmployee(context))" />
                            </MudTooltip>
                        }
                        else
                        {
                            <span class="pp-dash">—</span>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4" Color="Color.Secondary" Align="Align.Center">
                        لا نتائج مطابقة للبحث الحالي
                    </MudText>
                </NoRecordsContent>
            </MudTable>

            @* ══ (12-H16) شريط الإجماليات — مستقل عن أعمدة الجدول ══ *@
            <div class="pp-totals">
                <div class="pp-tot-head">
                    <MudIcon Icon="@Icons.Material.Filled.Insights" />
                    <span>إجمالي @FilteredCalculations.Count() موظف (المعروض)</span>
                </div>
                <div class="pp-tot-cells">
                    <div class="pp-tot-cell">
                        <span>إجمالي المستحق</span>
                        <b>@FilteredCalculations.Sum(c => c.GrossSalary).ToString("N0") جـ</b>
                    </div>
                    <div class="pp-tot-cell">
                        <span>الخصومات</span>
                        <b class="bad">@FilteredCalculations.Sum(c => c.TotalDeductions).ToString("N0") جـ</b>
                    </div>
                    <div class="pp-tot-cell">
                        <span>جزاءات يدوية</span>
                        <b class="bad">@FilteredCalculations.Sum(c => c.TotalPenalties).ToString("N0") جـ</b>
                    </div>
                    <div class="pp-tot-cell">
                        <span>إضافات داخل الراتب</span>
                        <b class="ok">@FilteredCalculations.Sum(c => c.TotalBonusInPayroll).ToString("N0") جـ</b>
                    </div>
                    <div class="pp-tot-cell">
                        <span>إضافات منفصلة</span>
                        <b class="info">@FilteredCalculations.Sum(c => c.TotalSeparateBonuses).ToString("N0") جـ</b>
                    </div>
                    <div class="pp-tot-cell net">
                        <span>الصافي داخل الراتب</span>
                        <b>@FilteredCalculations.Sum(c => c.NetSalary).ToString("N0") جـ</b>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <MudPaper Class="pa-8 text-center" Elevation="2" Style="border-radius:16px;">
            <MudIcon Icon="@Icons.Material.Filled.Payments" Style="font-size:54px; opacity:.4" Color="Color.Secondary" />
            <div class="mt-3"><MudText Typo="Typo.h6">ابدأ بحساب المرتبات للشهر المطلوب</MudText></div>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                بعد الحساب ستتمكن من مراجعة الغياب والتأخير والجزاءات والمكافآت ثم إرسال البيانات للمراجعة.
            </MudText>
        </MudPaper>
    }
</div>

@code {
    private string _selectedMonth = DateTime.Today.ToString("yyyy-MM");
    private string? _calculationsMonth;   // (12-H14) الشهر الفعلي للبيانات المحسوبة — حماية عدم التطابق
    private List<PayrollMonthSummaryDto> _monthOptions = new();
    private bool _calculating;
    private bool _processing;
    private bool _exporting;
    private bool _allSelected = true;
    private bool _dirty;                  // (12-H14) تعديلات غير مرسلة
    private string _currentUser = "system";
    private bool _canProcess;

    private List<PayrollCalculationDto> _calculations = new();

    // (12-H14) بحث وفلاتر
    private string? _searchText;
    private string? _deptFilter;
    private bool _onlyOverridden;

    private IEnumerable<PayrollCalculationDto> FilteredCalculations => _calculations
        .Where(c => string.IsNullOrWhiteSpace(_searchText)
                 || c.EmployeeName.Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase))
        .Where(c => string.IsNullOrWhiteSpace(_deptFilter) || c.Department == _deptFilter)
        .Where(c => !_onlyOverridden || c.HasManualOverrides);

    private List<string> DepartmentOptions =>
        _calculations.Select(c => c.Department).Where(d => !string.IsNullOrWhiteSpace(d)).Distinct().OrderBy(d => d).ToList()!;

    private bool HasSelected => _calculations.Any(c => c.IsSelected && !c.HasExistingPayroll);
    private int SelectedCount => _calculations.Count(c => c.IsSelected && !c.HasExistingPayroll);
    private decimal SelectedSum(Func<PayrollCalculationDto, decimal> selector) =>
        _calculations.Where(c => c.IsSelected && !c.HasExistingPayroll).Sum(selector);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        _currentUser = user.Identity?.Name ?? "system";

        await LoadMonthOptionsAsync();

        var canView = user.IsInRole("Admin")
                      || user.IsInRole("HrManager")
                      || user.IsInRole("HRManager")
                      || user.IsInRole("AccountManager")
                      || user.IsInRole("Accountant")
                      || user.IsInRole("AccountsManager")
                      || user.HasClaim("Permission", "frm_Payroll:View");

        if (!canView)
        {
            Nav.NavigateTo("/access-denied");
            return;
        }

        // (12-H14) أفعال الحساب والإرسال تحتاج صلاحية تعديل — الخدمة نفسها بلا بوابة
        _canProcess = user.IsInRole("Admin")
                      || user.IsInRole("HrManager")
                      || user.IsInRole("HRManager")
                      || user.IsInRole("AccountManager")
                      || user.IsInRole("AccountsManager")
                      || user.HasClaim("Permission", "frm_Payroll:Edit");
    }

    // (12-H14) تحذير التنقل وفيه تعديلات غير مرسلة (NavigationLock = نمط net8 الصحيح)
    private void OnBeforeInternalNavigation(LocationChangingContext ctx)
    {
        if (!_dirty) return;
        ctx.PreventNavigation();
        _ = ConfirmLeaveAsync(ctx.TargetLocation);
    }

    private async Task ConfirmLeaveAsync(string target)
    {
        var parameters = new DialogParameters<MudMessageBox>
        {
            { x => x.Message,    "فيه تعديلات على البنود لسه مااترسلتش للمراجعة. لو مشيت دلوقتي هتضيع. متأكد إنك عايز تسيب الصفحة؟" },
            { x => x.YesText,    "سيب الصفحة" },
            { x => x.CancelText, "اقعد وعدّل" }
        };
        var dialog = await DialogService.ShowAsync<MudMessageBox>(
            "تعديلات غير مرسلة", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall });

        if ((await dialog.Result) is { Canceled: true }) return;

        _dirty = false;
        Nav.NavigateTo(target);
    }

    private async Task CalculateAsync()
    {
        if (!ValidateMonth(_selectedMonth))
        {
            Snackbar.Add("صيغة الشهر غير صحيحة (مثال: 2026-05)", Severity.Warning);
            return;
        }

        _calculating = true;
        StateHasChanged();

        try
        {
            _calculations = await PayrollService.CalculateMonthAsync(_selectedMonth);
            foreach (var calc in _calculations)
                calc.IsSelected = !calc.HasExistingPayroll;

            _allSelected = _calculations.Any(c => !c.HasExistingPayroll);
            _calculationsMonth = _selectedMonth;   // (12-H14) سجّل شهر البيانات
            _dirty = false;
            _searchText = null; _deptFilter = null; _onlyOverridden = false;
            Snackbar.Add($"تم حساب {_calculations.Count} موظف", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ: {ex.Message}", Severity.Error);
        }
        finally
        {
            _calculating = false;
            StateHasChanged();
        }
    }

    private void RemoveEmployee(PayrollCalculationDto calc)
    {
        _calculations.Remove(calc);
        SyncSelectAll();
        _dirty = true;   // الإزالة بتأثر على الإرسال

        // (12-H14) Undo
        Snackbar.Add($"تم إزالة {calc.EmployeeName} من هذه المعالجة", Severity.Info, cfg =>
        {
            cfg.Action = "تراجع";
            cfg.ActionColor = Color.Warning;
            cfg.VisibleStateDuration = 6000;
            cfg.OnClick = _ =>
            {
                if (!_calculations.Contains(calc))
                {
                    _calculations.Add(calc);
                    SyncSelectAll();
                    StateHasChanged();
                }
                return Task.CompletedTask;
            };
        });
    }

    private async Task SaveWithoutPayAsync()
    {
        if (!HasSelected)
        {
            Snackbar.Add("لم يتم اختيار أي موظف", Severity.Warning);
            return;
        }

        // (12-H14) حماية نهائية: البيانات المرسلة = بيانات شهر الحساب نفسه
        var monthToSave = _calculationsMonth ?? _selectedMonth;

        var parameters = new DialogParameters<MudMessageBox>
        {
            { x => x.Message,    $"سيتم حفظ وإرسال {SelectedCount} راتب لشهر {FormatMonth(monthToSave)} للمراجعة. هل تريد المتابعة؟" },
            { x => x.YesText,    "نعم، إرسال للمراجعة" },
            { x => x.CancelText, "إلغاء" }
        };

        var dialog = await DialogService.ShowAsync<MudMessageBox>(
            "تأكيد الإرسال", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall });

        if ((await dialog.Result) is { Canceled: true })
            return;

        _processing = true;
        StateHasChanged();

        try
        {
            var (ok, msg, _) = await PayrollService.SaveOnlyAsync(monthToSave, _calculations, _currentUser);
            Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);
            if (ok)
            {
                _dirty = false;
                await CalculateAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ: {ex.Message}", Severity.Error);
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }

    private async Task OpenItemsDialogAsync(PayrollCalculationDto calc)
    {
        var parameters = new DialogParameters
        {
            [nameof(PayrollItemsDialog.Calc)] = calc,
            [nameof(PayrollItemsDialog.OnSaved)] = EventCallback.Factory.Create(this, () =>
            {
                _dirty = true;   // (12-H14) تعديل البنود = تغيير غير مرسل
                StateHasChanged();
            })
        };

        await DialogService.ShowAsync<PayrollItemsDialog>(
            $"بنود راتب {calc.EmployeeName}",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true });
    }

    // (12-H14) تصدير CSV (بيفتح في Excel) بنفس نمط downloadFileFromBase64
    private async Task ExportCsvAsync()
    {
        _exporting = true;
        StateHasChanged();
        try
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine("الموظف,القسم,أساسي,حضور,أيام عمل,غياب,تأخير,خصم غياب,خصم تأخير,سلف,جزاءات,إضافات داخل الراتب,إجمالي مستحق,صافي,إضافات منفصلة,مسجل مسبقًا,ملاحظات");
            foreach (var c in FilteredCalculations)
            {
                sb.AppendLine(string.Join(",",
                    Esc(c.EmployeeName), Esc(c.Department ?? ""), c.BasicSalary.ToString("0.##"),
                    c.PresentDays, c.WorkingDaysInMonth, c.AbsenceDays, Esc(c.LateDisplay),
                    c.AbsenceDeduction.ToString("0.##"), c.LateDeduction.ToString("0.##"), c.LoanDeduction.ToString("0.##"),
                    c.TotalPenalties.ToString("0.##"), c.TotalBonusInPayroll.ToString("0.##"),
                    c.GrossSalary.ToString("0.##"), c.NetSalary.ToString("0.##"), c.TotalSeparateBonuses.ToString("0.##"),
                    c.HasExistingPayroll ? "نعم" : "لا", Esc(c.Warning ?? "")));
            }

            var bytes = System.Text.Encoding.UTF8.GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"معالجة_المرتبات_{_calculationsMonth}_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            await JS.InvokeVoidAsync("downloadFileFromBase64", base64, fileName);
            Snackbar.Add("تم التصدير بنجاح", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ في التصدير: {ex.Message}", Severity.Error);
        }
        finally
        {
            _exporting = false;
            StateHasChanged();
        }
    }

    private static string Esc(string s) =>
        s.Contains(',') || s.Contains('"') ? "\"" + s.Replace("\"", "\"\"") + "\"" : s;

    private void ToggleAll(bool value)
    {
        _allSelected = value;
        foreach (var calc in _calculations.Where(c => !c.HasExistingPayroll))
            calc.IsSelected = value;

        StateHasChanged();
    }

    private void UpdateSelection(PayrollCalculationDto calc, bool value)
    {
        calc.IsSelected = value;
        SyncSelectAll();
        StateHasChanged();
    }

    private void SyncSelectAll()
    {
        var selectable = _calculations.Where(c => !c.HasExistingPayroll).ToList();
        _allSelected = selectable.Any() && selectable.All(c => c.IsSelected);
    }

    private static string FormatMoney(decimal amount) => amount <= 0 ? "—" : amount.ToString("N2") + " جـ";

    private async Task LoadMonthOptionsAsync()
    {
        try
        {
            _monthOptions = await PayrollService.GetMonthSummariesAsync();
        }
        catch
        {
            _monthOptions = new List<PayrollMonthSummaryDto>();
        }

        var currentMonth = DateTime.Today.ToString("yyyy-MM");
        if (_monthOptions.All(m => m.Month != currentMonth))
            _monthOptions.Insert(0, new PayrollMonthSummaryDto { Month = currentMonth });
        var prevMonth = DateTime.Today.AddMonths(-1).ToString("yyyy-MM");
        if (_monthOptions.All(m => m.Month != prevMonth))
            _monthOptions.Insert(1, new PayrollMonthSummaryDto { Month = prevMonth });
    }

    private async Task OnMonthChangedAsync(string? month)
    {
        _selectedMonth = string.IsNullOrWhiteSpace(month)
            ? DateTime.Today.ToString("yyyy-MM")
            : month;
        await Task.CompletedTask;
    }

    private async Task QuickMonthAsync(int monthsOffset)
    {
        _selectedMonth = DateTime.Today.AddMonths(monthsOffset).ToString("yyyy-MM");
        await Task.CompletedTask;
        StateHasChanged();
    }

    private static string FormatMonth(string? month) =>
        string.IsNullOrWhiteSpace(month)
            ? "—"
            : DateTime.TryParseExact(month + "-01", "yyyy-MM-dd", null,
                System.Globalization.DateTimeStyles.None, out var date)
                ? date.ToString("MMMM yyyy", new System.Globalization.CultureInfo("ar-EG"))
                : month;

    private static bool ValidateMonth(string? month) =>
        !string.IsNullOrWhiteSpace(month)
        && DateTime.TryParseExact(month + "-01", "yyyy-MM-dd", null,
            System.Globalization.DateTimeStyles.None, out _);
}

