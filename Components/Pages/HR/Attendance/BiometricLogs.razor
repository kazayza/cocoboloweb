    }

    private bool TryGetScope(out DateTime from, out DateTime to, out int? employeeId, out string error)
    {
        from = DateTime.Today;
        to = DateTime.Today;
        employeeId = null;
        error = "";

        if (_scope == "day")
        {
            if (!_processDate.HasValue) { error = "اختار التاريخ."; return false; }
            from = to = _processDate.Value.Date;
        }
        else if (_scope == "month")
        {
            if (!_monthAnchor.HasValue) { error = "اختار الشهر."; return false; }
            from = new DateTime(_monthAnchor.Value.Year, _monthAnchor.Value.Month, 1);
            to = from.AddMonths(1).AddDays(-1);
        }
        else
        {
            if (!_rangeFrom.HasValue || !_rangeTo.HasValue) { error = "اختار من وإلى."; return false; }
            from = _rangeFrom.Value.Date;
            to = _rangeTo.Value.Date;
        }

        if (_scope == "employee")
        {
            if (_selectedEmployee?.BioEmployeeId == null)
            {
                error = "اختار موظف مربوط بكود بصمة.";
                return false;
            }
            employeeId = _selectedEmployee.EmployeeId;
        }

        if (to < from) (from, to) = (to, from);
        if (from > DateTime.Today) { error = "الفترة في المستقبل."; return false; }
        if (to > DateTime.Today) to = DateTime.Today;
        if ((to - from).Days + 1 > 31) { error = "الحد 31 يوم في المرة الواحدة."; return false; }
        return true;
    }

    private async Task ProcessLogs()
    {
        if (!TryGetScope(out var from, out var to, out var employeeId, out var error))
        {
            _previewError = error;
            return;
        }

        _previewError = null;
        var preview = await AttendanceService.PreviewBiometricProcessAsync(from, to, employeeId);
        if (!preview.Ok)
        {
            _previewError = preview.Message;
            return;
        }

        if (preview.NeedsPayrollConfirmation && !_confirmPayroll)
        {
            _payrollWarning = preview.Message;
            return;
        }

        _isProcessing = true;
        _processSummary = null;
        _progress = 0;
        StateHasChanged();

        var punch = 0;
        var created = 0;
        var updated = 0;
        var skipped = 0;
        var failed = new List<string>();

        try
        {
            var authState = await AuthState.GetAuthenticationStateAsync();
            var userName = authState.User.Identity?.Name ?? "System";
            var days = preview.DayCount;

            for (var i = 0; i < days; i++)
            {
                var date = preview.From.AddDays(i);
                _progressText = $"اليوم {i + 1} من {days} — {date:yyyy/MM/dd}";
                _progress = (i + 1) * 100d / days;
                StateHasChanged();

                var day = await AttendanceService.ProcessBiometricDayAsync(
                    date, employeeId, _includeManual, _confirmPayroll || !preview.NeedsPayrollConfirmation, userName);
                if (!day.Success)
                {
                    failed.Add(day.Message);
                    if (day.NeedsPayrollConfirmation)
                    {
                        _payrollWarning = day.Message;
                        break;
                    }
                    continue;
                }

                punch += day.PunchUpdated;
                created += day.CoverageCreated;
                updated += day.CoverageUpdated;
                skipped += day.ManualSkipped;
            }

            _processSummary = $"خلصت: {punch} من البصمة، {created} سجل جديد، {updated} محدّث، {skipped} تعديل يدوي متخطى.";
            if (failed.Count > 0)
                _processSummary += " تعذر: " + string.Join(" | ", failed.Take(3));

            Snackbar.Add(_processSummary, failed.Count == 0 ? Severity.Success : Severity.Warning);
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ: {ex.Message}", Severity.Error);
            _processSummary = ex.Message;
        }

        _isProcessing = false;
        _progress = 100;
        StateHasChanged();
    }

    private string GetExpectedLogType(BiometricLogDto log)
    {
        var key = $"{log.BiometricCode}_{log.LogDate:yyyyMMdd}";
        if (_firstLogPerEmployee.TryGetValue(key, out var firstTime))
        {
            return log.LogTime == firstTime ? "حضور" : "انصراف";
        }
        return "حضور";
    }
