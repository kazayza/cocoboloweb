@page "/attendance/logs"
@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject IAttendanceService AttendanceService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthState
@inject IEmployeeService EmployeeService

<PageTitle>سجلات البصمة الخام</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4 hr-page-shell">
            
            @* ═══════════════ HEADER ═══════════════ *@
            <MudPaper Class="mb-4 overflow-hidden" Elevation="0" 
                      Style="border-radius: 20px; background: linear-gradient(135deg, #37474F 0%, #546E7A 50%, #78909C 100%);">
                <div class="pa-5">
                    <div class="d-flex align-center justify-space-between flex-wrap gap-3">
                        <div class="d-flex align-center gap-3">
                            <MudAvatar Size="Size.Large" 
                                       Style="background: rgba(255,255,255,0.15); backdrop-filter: blur(10px);">
                                <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Medium" Color="Color.Surface" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.h5" Color="Color.Surface" Class="font-weight-bold">
                                    سجلات البصمة الخام
                                </MudText>
                                <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.7);">
                                    جميع البصمات الواردة من أجهزة الموبايل
                                </MudText>
                            </div>
                        </div>
                        
                        <div class="d-flex flex-wrap gap-2">
                            @if (_hasProcessPermission)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Info"
                                           StartIcon="@Icons.Material.Filled.CloudUpload"
                                           Href="/attendance/import">
                                    استيراد ملف بصمة
                                </MudButton>
                                <MudButton Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.Sync"
                                           OnClick="OpenProcessDialog"
                                           Disabled="_isProcessing"
                                           Class="bp-open">
                                    @(_isProcessing ? "جاري المعالجة..." : "معالجة البصمات")
                                </MudButton>
                            }
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Dark"
                                       StartIcon="@Icons.Material.Filled.ArrowBack"
                                       Href="/attendance">
                                العودة
                            </MudButton>
                        </div>
                    </div>
                </div>

                @* Quick Stats *@
                <div style="background: rgba(0,0,0,0.1); padding: 12px 20px;">
                    <div class="d-flex justify-center gap-6 flex-wrap">
                        <div class="d-flex align-center gap-2">
                            <MudAvatar Size="Size.Small" Style="background: rgba(255,255,255,0.2);">
                                <MudIcon Icon="@Icons.Material.Filled.Fingerprint" Size="Size.Small" Color="Color.Surface" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.7);">إجمالي السجلات</MudText>
                                <MudText Typo="Typo.subtitle1" Color="Color.Surface" Class="font-weight-bold">@_totalCount</MudText>
                            </div>
                        </div>
                        <div class="d-flex align-center gap-2">
                            <MudAvatar Size="Size.Small" Style="background: rgba(76, 175, 80, 0.3);">
                                <MudIcon Icon="@Icons.Material.Filled.Today" Size="Size.Small" Style="color: #81C784;" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.7);">بصمات اليوم</MudText>
                                <MudText Typo="Typo.subtitle1" Color="Color.Surface" Class="font-weight-bold">@_todayCount</MudText>
                            </div>
                        </div>
                        <div class="d-flex align-center gap-2">
                            <MudAvatar Size="Size.Small" Style="background: rgba(33, 150, 243, 0.3);">
                                <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Style="color: #64B5F6;" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.7);">عدد الموظفين</MudText>
                                <MudText Typo="Typo.subtitle1" Color="Color.Surface" Class="font-weight-bold">@_employeeCount</MudText>
                            </div>
                        </div>
                    </div>
                </div>
            </MudPaper>

            @* ═══════════════ FILTERS ═══════════════ *@
            <div class="sticky-filter-shell">
            <MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius: 16px;">
                <MudGrid Spacing="3">
                    <MudItem xs="6" md="2">
                        <MudDatePicker Label="من تاريخ"
                                       @bind-Date="_dateFrom"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Editable="true"
                                       Clearable="true"
                                       DateFormat="yyyy/MM/dd" />
                    </MudItem>
                    <MudItem xs="6" md="2">
                        <MudDatePicker Label="إلى تاريخ"
                                       @bind-Date="_dateTo"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Editable="true"
                                       Clearable="true"
                                       DateFormat="yyyy/MM/dd" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string"
                                      Label="بحث (اسم الموظف)"
                                      @bind-Value="_searchText"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Clearable="true"
                                      OnKeyUp="HandleKeyUp"
                                      Placeholder="ابحث..." />
                    </MudItem>
                    <MudItem xs="6" md="2">
                        <MudNumericField T="int?"
                                         Label="كود البصمة"
                                         @bind-Value="_biometricCode"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Clearable="true"
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.Fingerprint" />
                    </MudItem>
                    <MudItem xs="6" md="1" Class="d-flex align-end">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   OnClick="ApplyFilter"
                                   Style="border-radius: 8px; min-height: 40px;">
                            <MudIcon Icon="@Icons.Material.Filled.Search" />
                        </MudButton>
                    </MudItem>
                    <MudItem xs="12" md="2" Class="d-flex align-end">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.ClearAll"
                                   OnClick="ResetFilters"
                                   Style="border-radius: 8px;">
                            مسح الفلاتر
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>
            </div>

            @* ═══════════════ DATA TABLE ═══════════════ *@
            <MudPaper Elevation="2" Style="border-radius: 16px; overflow: hidden;">
                <div class="pa-3 d-flex align-center justify-space-between" style="background: var(--mud-palette-background-grey);">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.List" Color="Color.Primary" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">سجلات البصمة</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">
                            @_totalCount سجل
                        </MudChip>
                    </div>
                </div>

                <MudDivider />

                @if (_isLoading)
                {
                    <div class="pa-4">
                        @for (int i = 0; i < 8; i++)
                        {
                            <div class="d-flex gap-4 mb-3">
                                <MudSkeleton Width="5%" Height="24px" />
                                <MudSkeleton Width="20%" Height="24px" />
                                <MudSkeleton Width="15%" Height="24px" />
                                <MudSkeleton Width="15%" Height="24px" />
                                <MudSkeleton Width="10%" Height="24px" />
                                <MudSkeleton Width="15%" Height="24px" />
                            </div>
                        }
                    </div>
                }
                else if (_logs.Count == 0)
                {
                    <div class="pa-8 text-center">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff" 
                                 Size="Size.Large" 
                                 Style="font-size: 64px; color: #E0E0E0;" />
                        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-4">
                            لا توجد سجلات بصمة
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            جرب تغيير الفلاتر أو اختر فترة مختلفة
                        </MudText>
                    </div>
                }
                else
                {
                    <MudTable Items="@_logs" Hover="true" Elevation="0" Dense="false" Striped="true">
                        <HeaderContent>
                            <MudTh>الموظف</MudTh>
                            <MudTh>كود البصمة</MudTh>
                            <MudTh>التاريخ</MudTh>
                            <MudTh>الوقت</MudTh>
                            <MudTh>النوع المتوقع</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="log">
                            <MudTd DataLabel="الموظف">
                                <div class="d-flex align-center gap-2">
                                    <MudAvatar Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                                        @(log.EmployeeName?.Length > 0 ? log.EmployeeName[0] : '?')
                                    </MudAvatar>
                                    <div>
                                        <MudText Typo="Typo.body1" Class="font-weight-bold">
                                            @(log.EmployeeName ?? $"كود: {log.BiometricCode}")
                                        </MudText>
                                        @if (!string.IsNullOrEmpty(log.Department))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@log.Department</MudText>
                                        }
                                    </div>
                                </div>
                            </MudTd>
                            <MudTd DataLabel="كود البصمة">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                    @log.BiometricCode
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="التاريخ">
                                <MudText Typo="Typo.body1" Class="font-weight-medium">@log.LogDateDisplay</MudText>
                            </MudTd>
                            <MudTd DataLabel="الوقت">
                                <MudText Typo="Typo.body1" Class="font-weight-bold" Color="Color.Primary">
                                    @log.LogTimeDisplay
                                </MudText>
                            </MudTd>
                            <MudTd DataLabel="النوع">
                                @{
                                    var logType = GetExpectedLogType(log);
                                }
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                         Style="@(logType == "حضور" ? "background: #E8F5E9; color: #2E7D32;" : "background: #E3F2FD; color: #1565C0;")">
                                    <MudIcon Icon="@(logType == "حضور" ? Icons.Material.Filled.Login : Icons.Material.Filled.Logout)" 
                                             Size="Size.Small" Class="ml-1" />
                                    @logType
                                </MudChip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>

                    @* Pagination *@
                    <MudDivider />
                    <div class="pa-3 d-flex flex-wrap align-center justify-space-between gap-3" style="background: var(--mud-palette-background-grey);">
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">عرض</MudText>
                            <MudSelect T="int" 
                                       Value="@_filter.PageSize"
                                       ValueChanged="OnPageSizeChanged"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Style="width: 80px;">
                                <MudSelectItem T="int" Value="25">25</MudSelectItem>
                                <MudSelectItem T="int" Value="50">50</MudSelectItem>
                                <MudSelectItem T="int" Value="100">100</MudSelectItem>
                            </MudSelect>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">سجل</MudText>
                        </div>

                        <div class="d-flex align-center gap-2">
                            <MudIconButton Icon="@Icons.Material.Filled.FirstPage" 
                                           Size="Size.Small"
                                           Disabled="@(!_hasPrevious)"
                                           OnClick="@(() => OnPageChanged(1))" />
                            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" 
                                           Size="Size.Small"
                                           Disabled="@(!_hasPrevious)"
                                           OnClick="@(() => OnPageChanged(_currentPage - 1))" />
                            <MudText Typo="Typo.body2" Class="px-2 font-weight-bold">
                                صفحة @_currentPage من @_totalPages
                            </MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" 
                                           Size="Size.Small"
                                           Disabled="@(!_hasNext)"
                                           OnClick="@(() => OnPageChanged(_currentPage + 1))" />
                            <MudIconButton Icon="@Icons.Material.Filled.LastPage" 
                                           Size="Size.Small"
                                           Disabled="@(!_hasNext)"
                                           OnClick="@(() => OnPageChanged(_totalPages))" />
                        </div>

                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="font-weight-medium">
                            إجمالي: <strong>@_totalCount</strong>
                        </MudText>
                    </div>
                }
            </MudPaper>
        </MudContainer>

        <MudDialog Visible="_showProcessDialog" VisibleChanged="@(v => _showProcessDialog = v)"
                   Options="@_processDialogOptions" Class="bp-dialog">
            <TitleContent>
                <div class="bp-head">
                    <div class="bp-head-mark"></div>
                    <div>
                        <div class="bp-head-title">معالجة البصمة</div>
                        <div class="bp-head-sub">تحويل البصمات الخام إلى حضور وانصراف</div>
                    </div>
                </div>
            </TitleContent>

            <DialogContent>
                <div class="bp-scopes">
                    <button type="button" class="bp-scope @(_scope == "day" ? "is-on" : "")" @onclick="@(() => SetScope("day"))">يوم</button>
                    <button type="button" class="bp-scope @(_scope == "period" ? "is-on" : "")" @onclick="@(() => SetScope("period"))">فترة</button>
                    <button type="button" class="bp-scope @(_scope == "month" ? "is-on" : "")" @onclick="@(() => SetScope("month"))">شهر</button>
                    <button type="button" class="bp-scope @(_scope == "employee" ? "is-on" : "")" @onclick="@(() => SetScope("employee"))">موظف</button>
                </div>
                <p class="bp-hint">@ScopeHint</p>

                @if (_scope == "day")
                {
                    <MudDatePicker Label="التاريخ" Date="_processDate" DateChanged="OnProcessDateChanged"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Editable="true"
                                   DateFormat="yyyy/MM/dd" Class="mt-2" MaxDate="DateTime.Today" />
                }
                else if (_scope == "month")
                {
                    <MudDatePicker Label="أي يوم في الشهر" Date="_monthAnchor" DateChanged="OnMonthChanged"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Editable="true"
                                   DateFormat="yyyy/MM/dd" Class="mt-2" MaxDate="DateTime.Today" />
                }
                else
                {
                    <MudGrid Spacing="2" Class="mt-2">
                        <MudItem xs="6">
                            <MudDatePicker Label="من" Date="_rangeFrom" DateChanged="OnRangeFromChanged"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Editable="true"
                                           DateFormat="yyyy/MM/dd" MaxDate="DateTime.Today" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudDatePicker Label="إلى" Date="_rangeTo" DateChanged="OnRangeToChanged"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Editable="true"
                                           DateFormat="yyyy/MM/dd" MaxDate="DateTime.Today" />
                        </MudItem>
                    </MudGrid>
                }

                @if (_scope == "employee")
                {
                    <MudAutocomplete T="EmployeeListDto" Label="الموظف"
                                     Value="_selectedEmployee" ValueChanged="OnEmployeeChanged"
                                     SearchFunc="SearchProcessEmployees"
                                     ToStringFunc="@(e => e == null ? string.Empty : $"{e.FullName} ({e.BioEmployeeId})")"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3"
                                     ResetValueOnEmptyText="true" CoerceText="true" />
                }

                <label class="bp-check">
                    <MudCheckBox T="bool" @bind-Value="_includeManual" Color="Color.Primary" Dense="true" />
                    <span>شمل السجلات المعدلة يدويًا. من غيرها التصحيح اليدوي يفضل زي ما هو.</span>
                </label>

                @if (!string.IsNullOrWhiteSpace(_payrollWarning))
                {
                    <div class="bp-warn">@_payrollWarning</div>
                    <label class="bp-check">
                        <MudCheckBox T="bool" @bind-Value="_confirmPayroll" Color="Color.Primary" Dense="true" />
                        <span>أؤكد المعالجة. جداول الرواتب لن تتغير.</span>
                    </label>
                }

                @if (!string.IsNullOrWhiteSpace(_previewError))
                {
                    <div class="bp-error">@_previewError</div>
                }

                @if (_isProcessing)
                {
                    <MudProgressLinear Color="Color.Primary" Value="_progress" Class="mt-4" />
                    <p class="bp-progress">@_progressText</p>
                }

                @if (!string.IsNullOrWhiteSpace(_processSummary))
                {
                    <div class="bp-done">@_processSummary</div>
                }
            </DialogContent>

            <DialogActions>
                <MudButton Variant="Variant.Text" OnClick="@(() => _showProcessDialog = false)" Disabled="_isProcessing" Class="bp-close">إغلاق</MudButton>
                <MudButton Variant="Variant.Filled" OnClick="ProcessLogs" Disabled="@(!CanStartProcess)" Class="bp-start">
                    @(_isProcessing ? "جاري المعالجة..." : "بدء المعالجة")
                </MudButton>
            </DialogActions>
        </MudDialog>

    </Authorized>
    
    <NotAuthorized>
        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
            <MudPaper Class="pa-8 text-center" Elevation="3" Style="border-radius: 20px;">
                <MudIcon Icon="@Icons.Material.Filled.Login" Size="Size.Large" 
                         Style="font-size: 64px; color: #FF9800;" Class="mb-4" />
                <MudText Typo="Typo.h5" Color="Color.Warning" Class="mb-2">تسجيل الدخول مطلوب</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">
                    يرجى تسجيل الدخول للوصول لهذه الصفحة
                </MudText>
            </MudPaper>
        </MudContainer>
    </NotAuthorized>
</AuthorizeView>

<style>
    .bp-open {
        background: var(--navy, #1a2842) !important;
        color: #fff !important;
        border-radius: 10px;
    }
    .bp-dialog {
        border-radius: 16px;
        overflow: hidden;
    }
    .bp-head { display: flex; align-items: center; gap: 12px; }
    .bp-head-mark {
        width: 4px; height: 36px; border-radius: 4px;
        background: var(--gold, #d4af37);
    }
    .bp-head-title { font-weight: 700; color: var(--navy-dark, #0f1a2e); font-size: 1.05rem; }
    .bp-head-sub { color: #64748b; font-size: .8rem; }
    .bp-scopes { display: flex; gap: 8px; flex-wrap: wrap; }
    .bp-scope {
        border: 1px solid var(--gold-border, rgba(212,175,55,.35));
        background: #fff;
        color: var(--navy, #1a2842);
        border-radius: 10px;
        padding: 8px 16px;
        font-weight: 600;
        cursor: pointer;
    }
    .bp-scope.is-on {
        background: var(--navy, #1a2842);
        color: #fff;
        border-color: var(--navy, #1a2842);
    }
    .bp-hint { margin: 12px 0 4px; color: #64748b; font-size: .85rem; }
    .bp-check { display: flex; align-items: flex-start; gap: 4px; margin-top: 10px; color: var(--navy-dark, #0f1a2e); font-size: .88rem; }
    .bp-warn, .bp-error, .bp-done {
        margin-top: 12px; padding: 10px 12px; border-radius: 10px; font-size: .88rem;
    }
    .bp-warn { background: var(--gold-subtle, rgba(212,175,55,.12)); color: var(--navy-dark, #0f1a2e); border: 1px solid var(--gold-border, rgba(212,175,55,.35)); }
    .bp-error { background: #fef2f2; color: #991b1b; }
    .bp-done { background: #f0fdf4; color: #166534; }
    .bp-progress { margin: 6px 0 0; color: #64748b; font-size: .8rem; }
    .bp-start {
        background: var(--gold, #d4af37) !important;
        color: var(--navy-dark, #0f1a2e) !important;
        font-weight: 700;
        border-radius: 10px;
    }
    .bp-close { color: var(--navy, #1a2842) !important; }
</style>



@code {
    // State
    private bool _isLoading = true;
    private bool _isProcessing;
    private bool _hasProcessPermission;
    
    // Data
    private List<BiometricLogDto> _logs = new();
    private BiometricLogFilterDto _filter = new() { DateFrom = DateTime.Today, DateTo = DateTime.Today };
    
    // Filter fields
    private DateTime? _dateFrom;
    private DateTime? _dateTo;
    private string? _searchText;
    private int? _biometricCode;
    
    // Pagination
    private int _currentPage = 1;
    private int _totalPages;
    private int _totalCount;
    private bool _hasPrevious;
    private bool _hasNext;
    
    // Stats
    private int _todayCount;
    private int _employeeCount;
    
    // Process Dialog
    private bool _showProcessDialog;
    private string _scope = "day";
    private DateTime? _processDate = DateTime.Today;
    private DateTime? _monthAnchor = DateTime.Today;
    private DateTime? _rangeFrom = DateTime.Today.AddDays(-6);
    private DateTime? _rangeTo = DateTime.Today;
    private EmployeeListDto? _selectedEmployee;
    private bool _includeManual;
    private bool _confirmPayroll;
    private string? _payrollWarning;
    private string? _previewError;
    private string? _processSummary;
    private double _progress;
    private string _progressText = "";
    
    private DialogOptions _processDialogOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseButton = true,
        BackdropClick = false
    };

    // Track first log per employee per day for type detection
    private Dictionary<string, TimeOnly> _firstLogPerEmployee = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var user = authState.User;

        _hasProcessPermission = user.IsInRole("Admin") || 
                                user.IsInRole("Account") ||
                                user.IsInRole("AccountManager") ||
                                user.IsInRole("HrManager") ||
                                user.IsInRole("HRManager");

        _dateFrom = _filter.DateFrom;
        _dateTo = _filter.DateTo;

        await LoadData();
        await LoadQuickStats();

        _isLoading = false;
    }

    private async Task LoadData()
    {
        _filter.PageNumber = _currentPage;
        _filter.DateFrom = _dateFrom;
        _filter.DateTo = _dateTo;
        _filter.BiometricCode = _biometricCode;

        var result = await AttendanceService.GetBiometricLogsAsync(_filter);

        _logs = result.Items;
        _totalCount = result.TotalCount;
        _totalPages = result.TotalPages;
        _hasPrevious = result.HasPrevious;
        _hasNext = result.HasNext;

        // Build first-log lookup
        _firstLogPerEmployee.Clear();
        var grouped = _logs.GroupBy(l => $"{l.BiometricCode}_{l.LogDate:yyyyMMdd}");
        foreach (var group in grouped)
        {
            var firstLog = group.OrderBy(l => l.LogTime).First();
            _firstLogPerEmployee[group.Key] = firstLog.LogTime;
        }
    }

    private async Task LoadQuickStats()
    {
        var todayFilter = new BiometricLogFilterDto
        {
            DateFrom = DateTime.Today,
            DateTo = DateTime.Today,
            PageSize = 1
        };
        var todayResult = await AttendanceService.GetBiometricLogsAsync(todayFilter);
        _todayCount = todayResult.TotalCount;
        
        // عدد الموظفين الفريدين في الفترة المحددة
        _employeeCount = _logs.Select(l => l.BiometricCode).Distinct().Count();
    }

