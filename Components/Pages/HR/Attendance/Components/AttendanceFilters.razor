@namespace COCOBOLOERPNEW.Components.Pages.HR.Attendance.Components
@using COCOBOLOERPNEW.DTOs

<MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius: 16px;">
    <div class="att-filter-row">

        @* التاريخ من *@
        <MudDatePicker Class="afr-date" Label="من تاريخ"
                       @bind-Date="_dateFrom"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Editable="true"
                       Clearable="true"
                       DateFormat="yyyy/MM/dd"
                       Placeholder="اختر" />

        @* التاريخ إلى *@
        <MudDatePicker Class="afr-date" Label="إلى تاريخ"
                       @bind-Date="_dateTo"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Editable="true"
                       Clearable="true"
                       DateFormat="yyyy/MM/dd"
                       Placeholder="اختر" />

        @* الفرع *@
        <MudSelect T="int?"
                   Class="afr-field"
                   Label="الفرع"
                   @bind-Value="_branchId"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Clearable="true"
                   ClearText="كل الفروع">
            @foreach (var b in BranchOptions)
            {
                <MudSelectItem T="int?" Value="b.BranchId">@b.BranchNameAr</MudSelectItem>
            }
        </MudSelect>

        @* البحث *@
        <MudTextField T="string"
                      Class="afr-search"
                      Label="بحث (اسم / قسم)"
                      @bind-Value="_searchText"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true"
                      Immediate="true"
                      OnKeyUp="HandleKeyUp"
                      Placeholder="ابحث..." />

        @* الحالة *@
        <MudSelect T="string"
                   Class="afr-status"
                   Label="الحالة"
                   @bind-Value="_status"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Clearable="true"
                   AnchorOrigin="Origin.BottomCenter">
            <MudSelectItem T="string" Value="@AttendanceStatus.Present">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                    حاضر
                </div>
            </MudSelectItem>
            <MudSelectItem T="string" Value="@AttendanceStatus.Absent">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Color="Color.Error" />
                    غائب
                </div>
            </MudSelectItem>
            <MudSelectItem T="string" Value="@AttendanceStatus.Late">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Color="Color.Warning" />
                    متأخر
                </div>
            </MudSelectItem>
            <MudSelectItem T="string" Value="@AttendanceStatus.Permission">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Small" Color="Color.Secondary" />
                    إذن
                </div>
            </MudSelectItem>
            <MudSelectItem T="string" Value="@AttendanceStatus.Errand">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.WorkOutline" Size="Size.Small" Color="Color.Info" />
                    مأمورية
                </div>
            </MudSelectItem>
            <MudSelectItem T="string" Value="@AttendanceStatus.EarlyLeave">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.ExitToApp" Size="Size.Small" Color="Color.Warning" />
                    انصراف مبكر
                </div>
            </MudSelectItem>
            <MudSelectItem T="string" Value="@AttendanceStatus.Holiday">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.BeachAccess" Size="Size.Small" Color="Color.Info" />
                    إجازة رسمية
                </div>
            </MudSelectItem>
            <MudSelectItem T="string" Value="@AttendanceStatus.OffDay">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.Weekend" Size="Size.Small" Color="Color.Default" />
                    راحة
                </div>
            </MudSelectItem>
        </MudSelect>

        @* فلاتر سريعة *@
        <MudSelect T="string"
                   Class="afr-field"
                   Label="فلتر سريع"
                   Value="_quickFilter"
                   ValueChanged="OnQuickFilterChanged"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Clearable="true">
            <MudSelectItem T="string" Value="@("today")">اليوم</MudSelectItem>
            <MudSelectItem T="string" Value="@("yesterday")">أمس</MudSelectItem>
            <MudSelectItem T="string" Value="@("thisWeek")">هذا الأسبوع</MudSelectItem>
            <MudSelectItem T="string" Value="@("thisMonth")">هذا الشهر</MudSelectItem>
            <MudSelectItem T="string" Value="@("lastMonth")">الشهر الماضي</MudSelectItem>
        </MudSelect>

        @* بحث *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Class="afr-btn"
                   OnClick="ExecuteSearch"
                   Title="بحث">
            <MudIcon Icon="@Icons.Material.Filled.Search" />
        </MudButton>

        @* مسح الكل *@
        <MudIconButton Icon="@Icons.Material.Filled.ClearAll"
                       Color="Color.Error"
                       Variant="Variant.Outlined"
                       Class="afr-clear"
                       OnClick="ResetAll"
                       Title="مسح كل الفلاتر" />

    </div>
</MudPaper>

@code {
    [Parameter] public AttendanceFilterDto Filter { get; set; } = new();
    [Parameter] public EventCallback OnSearch { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }
    [Parameter] public List<BranchOptionDto> BranchOptions { get; set; } = new();

    private DateTime? _dateFrom;
    private DateTime? _dateTo;
    private string? _searchText;
    private string? _status;
    private string? _quickFilter;
    private int? _branchId;

    protected override void OnInitialized()
    {
        _dateFrom = Filter.DateFrom;
        _dateTo = Filter.DateTo;
        _searchText = Filter.SearchText;
        _status = Filter.Status;
        _branchId = Filter.BranchId;
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ExecuteSearch();
    }

    private async Task OnQuickFilterChanged(string value)
    {
        _quickFilter = value;
        var today = DateTime.Today;

        switch (value)
        {
            case "today":
                _dateFrom = today;
                _dateTo = today;
                break;
            case "yesterday":
                _dateFrom = today.AddDays(-1);
                _dateTo = today.AddDays(-1);
                break;
            case "thisWeek":
                var diff = (7 + (today.DayOfWeek - DayOfWeek.Saturday)) % 7;
                _dateFrom = today.AddDays(-diff);
                _dateTo = today;
                break;
            case "thisMonth":
                _dateFrom = new DateTime(today.Year, today.Month, 1);
                _dateTo = today;
                break;
            case "lastMonth":
                var lastMonth = today.AddMonths(-1);
                _dateFrom = new DateTime(lastMonth.Year, lastMonth.Month, 1);
                _dateTo = new DateTime(lastMonth.Year, lastMonth.Month, DateTime.DaysInMonth(lastMonth.Year, lastMonth.Month));
                break;
        }

        await ExecuteSearch();
    }

    private async Task ExecuteSearch()
    {
        Filter.DateFrom = _dateFrom;
        Filter.DateTo = _dateTo;
        Filter.SearchText = _searchText;
        Filter.Status = _status;
        Filter.BranchId = _branchId;

        await OnSearch.InvokeAsync();
    }

    private async Task ResetAll()
    {
        _dateFrom = null;
        _dateTo = null;
        _searchText = null;
        _status = null;
        _quickFilter = null;
        _branchId = null;

        await OnReset.InvokeAsync();
    }
}
<style>
    .att-filter-row {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .att-filter-row .afr-date   { flex: 1 1 125px; min-width: 118px; }
    .att-filter-row .afr-field  { flex: 1 1 120px; min-width: 115px; }
    .att-filter-row .afr-status { flex: 1.1 1 130px; min-width: 125px; }
    .att-filter-row .afr-search { flex: 1.7 1 185px; min-width: 170px; }
    .att-filter-row .afr-btn    { flex: 0 0 auto; height: 40px; min-width: 52px; border-radius: 8px; }
    .att-filter-row .afr-clear  { flex: 0 0 auto; }
</style>
