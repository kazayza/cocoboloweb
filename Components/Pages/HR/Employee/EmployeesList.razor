@page "/employees"
@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using COCOBOLOERPNEW.Models
@using System.Security.Claims
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject IEmployeeService EmployeeService
@inject IBranchService BranchService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Authorize]

<div dir="rtl" class="emp-page">

    <!-- ═══════════════════════════════════════════ -->
    <!-- Header -->
    <!-- ═══════════════════════════════════════════ -->
    <div class="top-accent"><div class="accent-shimmer"></div></div>

    <div class="dash-header">
        <div class="dh-bg">
            <div class="dh-gradient"></div>
            <div class="dh-orbs">
                <div class="dh-orb dh-o1"></div>
                <div class="dh-orb dh-o2"></div>
                <div class="dh-orb dh-o3"></div>
            </div>
            <div class="dh-grid"></div>
        </div>
        <div class="dh-content">
            <div class="dh-info">
                <div class="dh-icon-wrap">
                    <div class="dh-icon-glow"></div>
                    <div class="dh-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Large" />
                    </div>
                    <div class="dh-badge"><MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" /></div>
                </div>
                <div class="dh-text">
                    <div class="dh-title-row">
                        <h1>إدارة الموظفين</h1>
                        <span class="premium-tag">
                            <MudIcon Icon="@Icons.Material.Filled.Diamond" Size="Size.Small" />
                            Premium
                        </span>
                    </div>
                    <p class="dh-subtitle">
                        <MudIcon Icon="@Icons.Material.Filled.Insights" Size="Size.Small" />
                        إدارة بيانات الموظفين والحالات والرواتب — @DateTime.Now.ToString("dddd yyyy/MM/dd", new CultureInfo("ar-EG"))
                    </p>
                </div>
            </div>
            <div class="dh-actions">
                @if (_canAdd)
                {
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PersonAdd"
                               OnClick="@(() => Navigation.NavigateTo("/employees/add"))" Class="dh-btn-primary">
                        <span class="btn-shine"></span>إضافة موظف جديد
                    </MudButton>
                }
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════ -->
    <!-- Stats Cards -->
    <!-- ═══════════════════════════════════════════ -->
    @if (_stats != null)
    {
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(155px, 1fr)); gap: 0.75rem; margin-bottom: 1rem;">
            <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 12px; padding: 1rem; text-align: center; color: white;">
                <div style="display:flex; align-items:center; justify-content:center; gap:0.4rem; margin-bottom:0.25rem;">
                    <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" />
                    <span style="font-size:0.78rem; opacity:0.85;">إجمالي الموظفين</span>
                </div>
                <div style="font-size:1.5rem; font-weight:800;">@_stats.TotalEmployees</div>
            </div>
            <div style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); border-radius: 12px; padding: 1rem; text-align: center; color: white;">
                <div style="display:flex; align-items:center; justify-content:center; gap:0.4rem; margin-bottom:0.25rem;">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                    <span style="font-size:0.78rem; opacity:0.85;">نشط</span>
                </div>
                <div style="font-size:1.5rem; font-weight:800;">@_stats.ActiveCount</div>
            </div>
            <div style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); border-radius: 12px; padding: 1rem; text-align: center; color: white;">
                <div style="display:flex; align-items:center; justify-content:center; gap:0.4rem; margin-bottom:0.25rem;">
                    <MudIcon Icon="@Icons.Material.Filled.PauseCircle" Size="Size.Small" />
                    <span style="font-size:0.78rem; opacity:0.85;">موقوف</span>
                </div>
                <div style="font-size:1.5rem; font-weight:800;">@_stats.SuspendedCount</div>
            </div>
            <div style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); border-radius: 12px; padding: 1rem; text-align: center; color: white;">
                <div style="display:flex; align-items:center; justify-content:center; gap:0.4rem; margin-bottom:0.25rem;">
                    <MudIcon Icon="@Icons.Material.Filled.BeachAccess" Size="Size.Small" />
                    <span style="font-size:0.78rem; opacity:0.85;">بالإجازة</span>
                </div>
                <div style="font-size:1.5rem; font-weight:800;">@_stats.OnLeaveCount</div>
            </div>
            <div style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); border-radius: 12px; padding: 1rem; text-align: center; color: white;">
                <div style="display:flex; align-items:center; justify-content:center; gap:0.4rem; margin-bottom:0.25rem;">
                    <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" />
                    <span style="font-size:0.78rem; opacity:0.85;">إجمالي الرواتب</span>
                </div>
                <div style="font-size:1.15rem; font-weight:800;">@_stats.TotalSalaries.ToString("N0")</div>
                <div style="font-size:0.72rem; opacity:0.7;">ج.م / شهر</div>
            </div>
            <div style="background: linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%); border-radius: 12px; padding: 1rem; text-align: center; color: white;">
                <div style="display:flex; align-items:center; justify-content:center; gap:0.4rem; margin-bottom:0.25rem;">
                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" />
                    <span style="font-size:0.78rem; opacity:0.85;">متوسط المرتب</span>
                </div>
                <div style="font-size:1.15rem; font-weight:800;">@_stats.AverageSalary.ToString("N0")</div>
                <div style="font-size:0.72rem; opacity:0.7;">ج.م</div>
            </div>
        </div>
    }

    <!-- ═══════════════════════════════════════════ -->
    <!-- Filters -->
    <!-- ═══════════════════════════════════════════ -->
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius: 16px;">
        <div class="emp-filter-row">
            <MudTextField T="string" Class="efr-search" Label="بحث بالاسم أو الرقم القومي" @bind-Value="_filter.SearchTerm"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true"
                          Immediate="true" OnKeyUp="OnSearchKeyPress" Placeholder="ابحث..." />

            <MudSelect T="string" Class="efr-f" Label="القسم" Value="_selectedDepartment" ValueChanged="OnDepartmentChanged"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                @foreach (var dept in _departments)
                {
                    <MudSelectItem T="string" Value="@dept">@dept</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="int?" Class="efr-f" Label="الفرع" Value="_selectedBranchId" ValueChanged="OnBranchChanged"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" ClearText="كل الفروع">
                @foreach (var branch in _branches)
                {
                    <MudSelectItem T="int?" Value="branch.BranchId">@branch.BranchNameAr</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="string" Class="efr-f" Label="الحالة" Value="_selectedStatus" ValueChanged="OnStatusChanged"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" ClearText="كل الحالات">
                <MudSelectItem T="string" Value="@EmployeeStatuses.Active">@EmployeeStatuses.Active</MudSelectItem>
                <MudSelectItem T="string" Value="@EmployeeStatuses.Suspended">@EmployeeStatuses.Suspended</MudSelectItem>
                <MudSelectItem T="string" Value="@EmployeeStatuses.Resigned">@EmployeeStatuses.Resigned</MudSelectItem>
                <MudSelectItem T="string" Value="@EmployeeStatuses.OnLeave">@EmployeeStatuses.OnLeave</MudSelectItem>
            </MudSelect>

            <MudSelect T="string" Class="efr-g" Label="النوع" Value="_selectedGender" ValueChanged="OnGenderChanged"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                <MudSelectItem T="string" Value="@("ذكر")">ذكر</MudSelectItem>
                <MudSelectItem T="string" Value="@("أنثى")">أنثى</MudSelectItem>
            </MudSelect>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="efr-btn" OnClick="ApplyFilter" Title="تطبيق الفلتر">
                <MudIcon Icon="@Icons.Material.Filled.FilterList" />
            </MudButton>

            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Error" Variant="Variant.Outlined"
                           OnClick="ResetFilter" Title="إعادة تعيين الفلاتر" />
        </div>
    </MudPaper>

    <!-- ═══════════════════════════════════════════ -->
    <!-- Employees Table -->
    <!-- ═══════════════════════════════════════════ -->
    <MudPaper Style="background: var(--mud-palette-surface); border: 1px solid var(--mud-palette-divider); border-radius: 14px; padding: 1rem;" Elevation="0">
        @if (_isLoading)
        {
            <div style="display:flex; justify-content:center; padding:3rem;">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (_employees.Items.Any())
        {
            <MudTable T="EmployeeListDto" Items="@_employees.Items" Hover="true" Elevation="0" Dense="true">
                <ToolBarContent>
                    <MudText Typo="Typo.h6" Style="font-weight:700;">
                        قائمة الموظفين
                    </MudText>
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="ml-2">
                        @_employees.TotalCount موظف
                    </MudChip>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>الاسم</MudTh>
                    <MudTh>الوظيفة</MudTh>
                    <MudTh>القسم</MudTh>
                    <MudTh>النوع</MudTh>
                    <MudTh>الموبايل</MudTh>
                    <MudTh>المرتب</MudTh>
                    <MudTh>تاريخ التعيين</MudTh>
                    <MudTh>الحالة</MudTh>
                    <MudTh>إجراءات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                            @context.EmployeeId
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <div style="display:flex; align-items:center; gap:0.5rem;">
                            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                                @context.FullName.Substring(0, Math.Min(2, context.FullName.Length))
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.body2" Style="font-weight:600;">@context.FullName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.NationalId</MudText>
                            </div>
                        </div>
                    </MudTd>
                    <MudTd>@context.JobTitle</MudTd>
                    <MudTd>
                        @if (!string.IsNullOrEmpty(context.Department))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@context.Department</MudChip>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </MudTd>
                    <MudTd>
                        @if (context.Gender == "ذكر")
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Male" Color="Color.Primary" />
                        }
                        else if (context.Gender == "أنثى")
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Female" Color="Color.Secondary" />
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </MudTd>
                    <MudTd>@(context.MobilePhone ?? "-")</MudTd>
                    <MudTd>
                        <strong style="color: #2e7d32;">
                            @((context.CurrentSalaryBase ?? 0).ToString("N0")) ج.م
                        </strong>
                    </MudTd>
                    <MudTd>@(context.HireDate?.ToString("yyyy/MM/dd") ?? "-")</MudTd>
                    <MudTd>
                        @{
                            var sColor = context.Status switch
                            {
                                "نشط" => Color.Success,
                                "موقوف" => Color.Warning,
                                "مستقيل" => Color.Error,
                                "بالإجازة" => Color.Info,
                                _ => Color.Default
                            };
                        }
                        <MudChip T="string" Color="@sColor" Size="Size.Small" Variant="Variant.Filled">
                            @context.Status
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudTooltip Text="التفاصيل" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" Size="Size.Small"
                                           OnClick="@(() => Navigation.NavigateTo($"/employees/edit/{context.EmployeeId}"))" />
                        </MudTooltip>
                        @if (_canEdit)
                        {
                            <MudTooltip Text="تعديل" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                               OnClick="@(() => Navigation.NavigateTo($"/employees/edit/{context.EmployeeId}"))" />
                            </MudTooltip>
                        }
                        @if (_canEdit && context.Status != EmployeeStatuses.Resigned)
                        {
                            <MudTooltip Text="تغيير الحالة" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Warning" Size="Size.Small"
                                               OnClick="@(() => OpenStatusDialog(context))" />
                            </MudTooltip>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <!-- Pagination -->
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:1rem; padding-top:0.75rem; border-top:1px solid var(--mud-palette-divider);">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    إجمالي @_employees.TotalCount موظف - صفحة @_employees.PageNumber من @_employees.TotalPages
                </MudText>
                <div style="display:flex; gap:0.5rem;">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               Disabled="@(_employees.PageNumber <= 1)"
                               OnClick="@(() => GoToPage(_employees.PageNumber - 1))">
                        السابق
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               Disabled="@(!_employees.HasNext)"
                               OnClick="@(() => GoToPage(_employees.PageNumber + 1))">
                        التالي
                    </MudButton>
                </div>
            </div>
        }
        else
        {
            <div style="display:flex; flex-direction:column; align-items:center; justify-content:center; padding:3rem;">
                <MudIcon Icon="@Icons.Material.Filled.PersonOff" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">لا يوجد موظفين</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">أضف موظف جديد للبدء</MudText>
            </div>
        }
    </MudPaper>
</div>

<!-- ═══════════════════════════════════════════ -->
<!-- Status Change Dialog -->
<!-- ═══════════════════════════════════════════ -->
<MudDialog @bind-IsOpen="_statusDialogOpen">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-3">تغيير حالة الموظف</MudText>
        <MudText Typo="Typo.body1" Class="mb-3">
            <strong>@_selectedEmployee?.FullName</strong> - الحالة الحالية:
            <MudChip T="string" Size="Size.Small" Color="Color.Warning">@_selectedEmployee?.Status</MudChip>
        </MudText>
        <MudSelect T="string" Label="الحالة الجديدة" @bind-Value="_newStatus" Variant="Variant.Outlined" Class="mb-3">
            <MudSelectItem T="string" Value="@EmployeeStatuses.Active">@EmployeeStatuses.Active</MudSelectItem>
            <MudSelectItem T="string" Value="@EmployeeStatuses.Suspended">@EmployeeStatuses.Suspended</MudSelectItem>
            <MudSelectItem T="string" Value="@EmployeeStatuses.Resigned">@EmployeeStatuses.Resigned</MudSelectItem>
            <MudSelectItem T="string" Value="@EmployeeStatuses.OnLeave">@EmployeeStatuses.OnLeave</MudSelectItem>
        </MudSelect>
        <MudTextField T="string" Label="سبب التغيير" @bind-Value="_statusReason" Variant="Variant.Outlined" Lines="3" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="ChangeStatus" Variant="Variant.Filled">تأكيد</MudButton>
        <MudButton OnClick="@(() => _statusDialogOpen = false)">إلغاء</MudButton>
    </DialogActions>
</MudDialog>

<style>
    /* ══ (12-H12) Premium Header — نفس تصميم لوحة الخزينة بالضبط ══ */
    .emp-page {
        --gold: #D4A853; --gold-dark: #B8912A;
        --navy: #1B2A4A; --navy-dark: #0F1D36; --navy-light: #2D4A7A;
        max-width: 1800px; margin: 0 auto; position: relative;
    }
    @@keyframes empFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-18px); } }
    @@keyframes empShimmer { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }
    @@keyframes empPulse { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.15); opacity: 0.7; } }

    .top-accent { height: 5px; background: linear-gradient(90deg, var(--gold), var(--gold-dark), var(--gold)); position: relative; overflow: hidden; margin-bottom: 1.5rem; border-radius: 0 0 10px 10px; }
    .accent-shimmer { position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent); animation: empShimmer 3s ease-in-out infinite; }

    .dash-header { position: relative; border-radius: 24px; overflow: hidden; margin-bottom: 1.5rem; }
    .dh-bg { position: absolute; inset: 0; }
    .dh-gradient { position: absolute; inset: 0; background: linear-gradient(135deg, #070D1A 0%, var(--navy) 40%, var(--navy-light) 100%); }
    .dh-orbs { position: absolute; inset: 0; overflow: hidden; }
    .dh-orb { position: absolute; border-radius: 50%; }
    .dh-o1 { width: 380px; height: 380px; top: -160px; right: -100px; background: radial-gradient(circle, rgba(212,168,83,0.3), transparent 60%); animation: empFloat 8s ease-in-out infinite; }
    .dh-o2 { width: 260px; height: 260px; bottom: -100px; left: 15%; background: radial-gradient(circle, rgba(212,168,83,0.15), transparent 60%); }
    .dh-o3 { width: 180px; height: 180px; top: 30%; left: 8%; background: radial-gradient(circle, rgba(255,255,255,0.04), transparent 60%); }
    .dh-grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px); background-size: 40px 40px; }
    .dh-content { position: relative; z-index: 2; padding: 2rem 2.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem; }
    .dh-info { display: flex; align-items: center; gap: 1.5rem; }
    .dh-icon-wrap { position: relative; width: 80px; height: 80px; }
    .dh-icon-glow { position: absolute; inset: -15px; background: radial-gradient(circle, rgba(212,168,83,0.4), transparent 70%); filter: blur(20px); animation: empPulse 3s ease-in-out infinite; }
    .dh-icon { position: relative; width: 100%; height: 100%; background: linear-gradient(135deg, var(--gold), var(--gold-dark)); border-radius: 22px; display: flex; align-items: center; justify-content: center; color: var(--navy-dark); box-shadow: 0 10px 40px rgba(212,168,83,0.4), inset 0 1px 0 rgba(255,255,255,0.2); }
    .dh-icon ::deep .mud-icon-root { font-size: 38px !important; color: var(--navy-dark) !important; }
    .dh-badge { position: absolute; bottom: -6px; left: -6px; width: 28px; height: 28px; background: linear-gradient(135deg, var(--gold), var(--gold-dark)); border-radius: 50%; border: 3px solid var(--navy-dark); display: flex; align-items: center; justify-content: center; color: white; }
    .dh-badge ::deep .mud-icon-root { font-size: 13px !important; color: white !important; }
    .dh-text { color: white; }
    .dh-title-row { display: flex; align-items: center; gap: 0.85rem; flex-wrap: wrap; }
    .dh-text h1 { margin: 0; font-size: 1.9rem; font-weight: 900; letter-spacing: -0.5px; line-height: 1.2; }
    .premium-tag { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.85rem; background: linear-gradient(135deg, var(--gold), var(--gold-dark)); border-radius: 20px; font-size: 0.72rem; font-weight: 700; color: var(--navy-dark); box-shadow: 0 4px 12px rgba(212,168,83,0.3); }
    .premium-tag ::deep .mud-icon-root { font-size: 12px !important; color: var(--navy-dark) !important; }
    .dh-subtitle { display: flex; align-items: center; gap: 0.5rem; margin: 0.5rem 0 0; color: rgba(255,255,255,0.7); font-size: 0.92rem; }
    .dh-subtitle ::deep .mud-icon-root { color: var(--gold) !important; font-size: 16px !important; }
    .dh-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }
    .dh-btn-primary { background: linear-gradient(135deg, var(--gold), var(--gold-dark)) !important; color: var(--navy-dark) !important; font-weight: 700 !important; border-radius: 12px !important; padding: 0.65rem 1.25rem !important; box-shadow: 0 8px 20px rgba(212,168,83,0.3) !important; position: relative; overflow: hidden; text-transform: none !important; }
    .btn-shine { position: absolute; top: 0; left: -100%; width: 100%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.5), transparent); animation: empShimmer 3s ease-in-out infinite; }

    /* ══ فلاتر سطر واحد ══ */
    .emp-filter-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .emp-filter-row .efr-search { flex: 1.8 1 200px; min-width: 180px; }
    .emp-filter-row .efr-f { flex: 1.2 1 130px; min-width: 125px; }
    .emp-filter-row .efr-g { flex: 0.9 1 105px; min-width: 100px; }
    .emp-filter-row .efr-btn { flex: 0 0 auto; height: 40px; min-width: 52px; border-radius: 8px; }

    @@media (max-width: 768px) {
        .dh-content { flex-direction: column; align-items: flex-start; padding: 1.5rem; }
        .dh-text h1 { font-size: 1.5rem; }
    }
</style>

@code {
    private bool _isLoading = false;
    private bool _canView = false;
    private bool _canAdd = false;
    private bool _canEdit = false;

    // Data
    private PagedResult<EmployeeListDto> _employees = new();
    private EmployeeFilterDto _filter = new();
    private EmployeeStatsDto? _stats;
    private List<string> _departments = new();
    private List<BranchOptionDto> _branches = new();

    // Filter select values
    private string? _selectedDepartment;
    private string? _selectedStatus;
    private string? _selectedGender;
    private int? _selectedBranchId;

    // Status dialog
    private bool _statusDialogOpen = false;
    private EmployeeListDto? _selectedEmployee;
    private string _newStatus = "";
    private string _statusReason = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        _canView = user.HasClaim("Permission", "frm_Employeeslist:View") || user.IsInRole("Admin");
        _canAdd = user.HasClaim("Permission", "frm_Employees:Add") || user.IsInRole("Admin");
        _canEdit = user.HasClaim("Permission", "frm_Employeeslist:Edit") || user.IsInRole("Admin");

        if (!_canView)
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }

        // (12-H12) الشاشة تفتح دايمًا على الحالة = نشط
        _selectedStatus = EmployeeStatuses.Active;
        _filter.Status  = EmployeeStatuses.Active;

        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _employees = await EmployeeService.GetEmployeesAsync(_filter);
            _stats = await EmployeeService.GetStatsAsync();
            _departments = await EmployeeService.GetDepartmentsAsync();

            if (_branches.Count == 0)
            {
                try { _branches = await BranchService.GetBranchesForFilterAsync(); }
                catch { _branches = new(); }
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ApplyFilter()
    {
        _filter.PageNumber = 1;
        await LoadData();
    }

    private async Task OnSearchKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyFilter();
        }
    }

    private async Task OnDepartmentChanged(string? value)
    {
        _selectedDepartment = value;
        _filter.Department = value;
        _filter.PageNumber = 1;
        await LoadData();
    }

    private async Task OnBranchChanged(int? value)
    {
        _selectedBranchId = value;
        _filter.BranchId = value;
        _filter.PageNumber = 1;
        await LoadData();
    }

    private async Task OnStatusChanged(string? value)
    {
        _selectedStatus = value;
        _filter.Status = value;
        _filter.PageNumber = 1;
        await LoadData();
    }

    private async Task OnGenderChanged(string? value)
    {
        _selectedGender = value;
        _filter.Gender = value;
        _filter.PageNumber = 1;
        await LoadData();
    }

    private async Task ResetFilter()
    {
        _filter = new EmployeeFilterDto { Status = EmployeeStatuses.Active };
        _selectedDepartment = null;
        _selectedStatus = EmployeeStatuses.Active;
        _selectedGender = null;
        _selectedBranchId = null;
        await LoadData();
    }

    private async Task GoToPage(int page)
    {
        _filter.PageNumber = page;
        await LoadData();
    }

    private void OpenStatusDialog(EmployeeListDto employee)
    {
        _selectedEmployee = employee;
        _newStatus = employee.Status;
        _statusReason = "";
        _statusDialogOpen = true;
    }

    private async Task ChangeStatus()
    {
        if (_selectedEmployee == null) return;

        var result = await EmployeeService.ChangeStatusAsync(
            _selectedEmployee.EmployeeId, _newStatus, _statusReason,
            (await AuthProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "System");

        if (result.Success)
        {
            Snackbar.Add(result.Message, Severity.Success);
            _statusDialogOpen = false;
            await LoadData();
        }
        else
        {
            Snackbar.Add(result.Message, Severity.Error);
        }
    }
}