@page "/admin/permissions/manage"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@using Microsoft.EntityFrameworkCore
@using COCOBOLOERPNEW.Models
@using COCOBOLOERPNEW.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject db24804Context Db
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<div class="assign-page">
    <div class="page-header">
        <div class="header-content">
            <div class="header-left">
                <div class="page-icon"><MudIcon Icon="@Icons.Material.Filled.ManageAccounts" /></div>
                <div class="header-text">
                    <h1>ربط الصلاحيات</h1>
                    <p class="subtitle">صلاحيات الشاشات تُحفظ فور التحديد، وهي مستقلة عن الدور</p>
                </div>
            </div>
            <MudButton Variant="Variant.Outlined" Class="link-btn" StartIcon="@Icons.Material.Rounded.Security" OnClick="OpenCatalog">سجل الصلاحيات</MudButton>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <MudAlert Severity="@(_isError ? Severity.Error : Severity.Success)" Class="mb-3">@_message</MudAlert>
    }

    <section class="filter-panel">
        <div class="filter-grid">
            <div class="field field-user">
                <span class="field-label">المستخدم</span>
                <div class="field-box">
                    <MudIcon Icon="@Icons.Material.Outlined.Person" Class="field-icon" />
                    <MudAutocomplete T="User" Value="Selected" ValueChanged="OnUserPicked" SearchFunc="SearchUsers" ToStringFunc="UserText"
                                     Placeholder="ابحث بالاسم أو اسم الدخول" Variant="Variant.Text" Margin="Margin.Dense" Class="bare-field"
                                     Clearable="true" MinCharacters="0" CoerceText="true" ResetValueOnEmptyText="true" />
                </div>
            </div>
            <div class="field">
                <span class="field-label">بحث الصلاحيات</span>
                <div class="field-box">
                    <MudIcon Icon="@Icons.Material.Outlined.Search" Class="field-icon" />
                    <MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Immediate="true" DebounceInterval="250"
                                  Placeholder="اسم الصلاحية أو الشاشة" Variant="Variant.Text" Margin="Margin.Dense" Class="bare-field" Disabled="@(_selectedUser <= 0)" />
                </div>
            </div>
            <div class="field field-copy">
                <span class="field-label">نسخ من مستخدم</span>
                <div class="field-box">
                    <MudIcon Icon="@Icons.Material.Outlined.ContentCopy" Class="field-icon" />
                    <MudAutocomplete T="User" Value="_copyUser" ValueChanged="AskCopyUser" SearchFunc="SearchCopyUsers" ToStringFunc="UserText"
                                     Placeholder="ابحث عن المستخدم المصدر" Variant="Variant.Text" Margin="Margin.Dense" Class="bare-field"
                                     Disabled="@(_selectedUser <= 0)" Clearable="true" MinCharacters="0" CoerceText="true" ResetValueOnEmptyText="true" />
                </div>
            </div>
            <div class="result-chip">
                <span>مفعّل</span>
                <strong>@ActiveCount</strong>
            </div>
        </div>

        @if (_selectedUser > 0)
        {
            <div class="status-row">
                <div class="status-chips">
                    <button type="button" class="@(_onlyAssigned ? "" : "on")" @onclick="ShowAllRows">الكل</button>
                    <button type="button" class="@(_onlyAssigned ? "on" : "")" @onclick="ShowAssigned">المربوطة فقط</button>
                    @foreach (var category in Categories)
                    {
                        <button type="button" class="@(_category == category ? "on" : "")" @onclick="() => SetCategory(category)">@CategoryLabel(category)</button>
                    }
                </div>
                <div class="row-actions">
                    <button type="button" @onclick="SelectVisible" disabled="@_busy">تحديد الظاهر</button>
                    <button type="button" class="danger" @onclick="ClearVisible" disabled="@_busy">إلغاء الظاهر</button>
                </div>
            </div>
            <div class="account-summary">
                <span><small>الدور</small>@SystemRoleCatalog.Text(Selected?.Role)</span>
                <span><small>الموظف</small>@EmployeeName(Selected?.EmployeeId)</span>
                <span><small>الحالة</small>@(Selected?.IsActive == true ? "نشط" : "غير نشط")</span>
                <span><small>الظاهر</small>@VisiblePermissions.Count()</span>
            </div>
        }
    </section>

    @if (_selectedUser <= 0)
    {
        <div class="table-container state-box">
            <MudIcon Icon="@Icons.Material.Outlined.ManageAccounts" Size="Size.Large" />
            <h3>اختر مستخدمًا</h3>
            <p>بعد الاختيار تظهر صلاحيات الشاشات، وأي تحديد يُحفظ مباشرة.</p>
        </div>
    }
    else if (!VisiblePermissions.Any())
    {
        <div class="table-container state-box">
            <h3>لا توجد نتائج</h3>
            <p>غيّر البحث أو الفئة.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <table class="assign-table">
                <thead>
                    <tr>
                        <th>الصلاحية</th>
                        <th>الشاشة</th>
                        <th>الفئة</th>
                        <th>عرض</th>
                        <th>إضافة</th>
                        <th>تعديل</th>
                        <th>حذف</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in VisiblePermissions)
                    {
                        <tr class="@(item.CanView || item.CanAdd || item.CanEdit || item.CanDelete ? "linked" : "")">
                            <td>
                                <strong>@item.Permission.PermissionName</strong>
                                @if (!string.IsNullOrWhiteSpace(item.Permission.Description))
                                {
                                    <small>@item.Permission.Description</small>
                                }
                            </td>
                            <td><span class="form-name">@(item.Permission.FormName ?? "—")</span></td>
                            <td><span class="cat-badge">@CategoryLabel(item.Permission.Category)</span></td>
                            <td><label class="tick"><input type="checkbox" checked="@item.CanView" disabled="@_busy" @onchange="e => OnView(item, e)" /></label></td>
                            <td><label class="tick"><input type="checkbox" checked="@item.CanAdd" disabled="@_busy" @onchange="e => OnAdd(item, e)" /></label></td>
                            <td><label class="tick"><input type="checkbox" checked="@item.CanEdit" disabled="@_busy" @onchange="e => OnEdit(item, e)" /></label></td>
                            <td><label class="tick"><input type="checkbox" checked="@item.CanDelete" disabled="@_busy" @onchange="e => OnDelete(item, e)" /></label></td>
                            <td><button type="button" class="row-all" @onclick="() => ToggleRow(item)" disabled="@_busy">الصف</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_confirmCopy)
{
    <MudOverlay Visible="true" Class="copy-overlay">
        <div class="copy-dialog" @onclick:stopPropagation="true">
            <h2>نسخ الصلاحيات</h2>
            <p>ستُستبدل صلاحيات <strong>@Selected?.FullName</strong> بصلاحيات المستخدم المختار. لا يمكن التراجع بعد التأكيد.</p>
            <div class="dialog-actions">
                <MudButton Variant="Variant.Outlined" OnClick="CancelCopy" Disabled="_busy">إلغاء</MudButton>
                <MudButton Variant="Variant.Filled" Class="save-btn" OnClick="ConfirmCopy" Disabled="_busy">نسخ واستبدال</MudButton>
            </div>
        </div>
    </MudOverlay>
}

<style>
    .assign-page { padding: 1.5rem 1.75rem 2.5rem; direction: rtl; color: #1E293B; }
    .page-header { background: linear-gradient(135deg, #0A1628 0%, #1E293B 100%); border-bottom: 3px solid #D4AF37; border-radius: 18px; padding: 1.5rem 1.75rem; margin-bottom: 1.25rem; box-shadow: 0 12px 30px rgba(10, 22, 40, 0.18); }
    .header-content, .header-left, .dialog-actions { display: flex; align-items: center; }
    .header-content { justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
    .header-left { gap: 1rem; }
    .page-icon { width: 58px; height: 58px; border-radius: 16px; display: grid; place-items: center; color: #D4AF37; background: rgba(212, 175, 55, 0.14); border: 1px solid rgba(212, 175, 55, 0.45); }
    .page-icon .mud-icon-root { font-size: 1.8rem; }
    .header-text h1 { margin: 0; color: #fff; font-size: 1.7rem; font-weight: 800; }
    .header-text .subtitle { margin: 0.3rem 0 0; color: #CBD5E1; }
    .link-btn { color: #fff !important; border-color: rgba(212, 175, 55, 0.7) !important; }
    .filter-panel, .table-container, .copy-dialog { background: #fff; border: 1px solid #E2E8F0; border-radius: 16px; }
    .filter-panel { padding: 1rem; margin-bottom: 1rem; box-shadow: 0 8px 24px rgba(10, 22, 40, 0.05); }
    .filter-grid { display: grid; grid-template-columns: minmax(240px, 1.3fr) minmax(200px, 1fr) minmax(200px, 1fr) auto; gap: 0.85rem; align-items: end; }
    .field-label { display: block; margin: 0 0.15rem 0.4rem; color: #64748B; font-size: 0.75rem; font-weight: 800; }
    .field-box { height: 48px; display: flex; align-items: center; gap: 0.35rem; padding: 0 0.75rem; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px; transition: border-color .15s, box-shadow .15s, background .15s; }
    .field-box:focus-within { background: #fff; border-color: #D4AF37; box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.18); }
    .field-icon { color: #D4AF37; font-size: 1.15rem; }
    .result-chip { min-width: 84px; height: 48px; border-radius: 12px; background: #0A1628; color: #D4AF37; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .result-chip span { font-size: 0.68rem; font-weight: 700; color: #CBD5E1; }
    .result-chip strong { font-size: 1.15rem; line-height: 1.1; }
    .status-row, .row-actions { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-top: 0.85rem; flex-wrap: wrap; }
    .status-chips { min-height: 48px; display: flex; flex-wrap: wrap; gap: 4px; padding: 4px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px; }
    .status-chips button, .row-actions button, .row-all { border: 0; background: transparent; color: #64748B; border-radius: 9px; padding: 0.45rem 0.8rem; font-weight: 800; cursor: pointer; }
    .status-chips button.on { background: #0A1628; color: #fff; }
    .row-actions button { background: #0A1628; color: #fff; }
    .row-actions button.danger, .row-all { background: transparent; color: #B91C1C; }
    .account-summary { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6rem; margin-top: 0.85rem; }
    .account-summary span { background: #0A1628; color: #fff; border-radius: 12px; padding: 0.55rem 0.75rem; }
    .account-summary small { display: block; color: #D4AF37; font-size: 0.68rem; font-weight: 800; }
    .table-container { overflow: auto; }
    .state-box { min-height: 220px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.45rem; color: #64748B; }
    .state-box h3 { margin: 0; color: #1E293B; }
    .assign-table { width: 100%; border-collapse: collapse; min-width: 860px; }
    .assign-table th, .assign-table td { padding: 0.8rem 0.9rem; text-align: right; border-bottom: 1px solid #F1F5F9; vertical-align: middle; }
    .assign-table th { background: #F4F6F9; color: #0A1628; font-size: 0.78rem; font-weight: 800; }
    .assign-table td strong, .assign-table td small { display: block; }
    .assign-table td small { color: #64748B; font-size: 0.8rem; }
    .assign-table tr.linked { background: rgba(212, 175, 55, 0.08); }
    .form-name, .cat-badge { display: inline-flex; border-radius: 999px; padding: 0.18rem 0.6rem; font-size: 0.78rem; font-weight: 700; }
    .form-name { direction: ltr; background: #F4F6F9; color: #0A1628; }
    .cat-badge { background: rgba(212, 175, 55, 0.16); color: #0A1628; }
    .tick { display: grid; place-items: center; }
    .tick input { width: 18px; height: 18px; accent-color: #0A1628; cursor: pointer; }
    .copy-overlay { z-index: 1400; display: flex; align-items: flex-start; justify-content: center; padding-top: 14vh; }
    .copy-dialog { width: min(460px, 92vw); padding: 1.4rem; }
    .copy-dialog h2 { margin: 0 0 0.4rem; color: #0A1628; }
    .copy-dialog p { color: #64748B; line-height: 1.7; }
    .dialog-actions { justify-content: flex-end; gap: 0.5rem; }
    .save-btn { background: #0A1628 !important; color: #fff !important; }
    ::deep .bare-field { flex: 1; }
    ::deep .bare-field .mud-input-control { margin: 0; }
    ::deep .bare-field .mud-input-slot { padding: 0; min-height: 46px; }
    ::deep .bare-field .mud-input { color: #1E293B; font-weight: 600; }
    ::deep .bare-field .mud-input-underline:before, ::deep .bare-field .mud-input-underline:after { display: none; }
    @@media (max-width: 1000px) {
        .assign-page { padding: 1rem; }
        .filter-grid, .account-summary { grid-template-columns: 1fr; }
        .status-row { align-items: stretch; }
    }
</style>

@code {
    private static readonly (string Value, string Label)[] KnownCategories =
    {
        ("Administration", "الإدارة"),
        ("Forms", "الشاشات"),
        ("Reports", "التقارير"),
        ("Settings", "الإعدادات")
    };

    [SupplyParameterFromQuery(Name = "user")]
    public int UserFromQuery { get; set; }

    private List<User> _users = new();
    private Dictionary<int, string> _employeeNames = new();
    private int _selectedUser;
    private int _copySource;
    private User? _copyUser;
    private List<UserPermissionItem> _permissionList = new();
    private ClaimsPrincipal? _currentUser;
    private string _search = "";
    private string _category = "";
    private bool _onlyAssigned;
    private bool _busy;
    private bool _confirmCopy;
    private bool _isError;
    private string? _message;

    private User? Selected => _users.FirstOrDefault(u => u.UserId == _selectedUser);
    private int ActiveCount => _permissionList.Sum(p => (p.CanView ? 1 : 0) + (p.CanAdd ? 1 : 0) + (p.CanEdit ? 1 : 0) + (p.CanDelete ? 1 : 0));
    private IEnumerable<string> Categories => _permissionList.Select(p => p.Permission.Category).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().OrderBy(c => c)!;
    private IEnumerable<UserPermissionItem> VisiblePermissions => _permissionList.Where(Matches);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUser = auth.User;
        _users = await Db.Users.AsNoTracking().OrderByDescending(u => u.IsActive).ThenBy(u => u.FullName).ToListAsync();
        var ids = _users.Where(u => u.EmployeeId.HasValue).Select(u => u.EmployeeId!.Value).Distinct().ToList();
        _employeeNames = ids.Count == 0
            ? new()
            : await Db.Employees.AsNoTracking().Where(e => ids.Contains(e.EmployeeId)).ToDictionaryAsync(e => e.EmployeeId, e => e.FullName);
        if (UserFromQuery > 0)
            await OnUserSelected(UserFromQuery);
    }

    private string UserLabel(User user) => user.IsActive == false ? $"{user.FullName} — غير نشط" : $"{user.FullName} — {user.Username}";
    private string UserText(User? user) => user == null ? "" : UserLabel(user);

    private Task<IEnumerable<User>> SearchUsers(string? value, CancellationToken token)
        => Task.FromResult(FilterUsers(_users, value));

    private Task<IEnumerable<User>> SearchCopyUsers(string? value, CancellationToken token)
        => Task.FromResult(FilterUsers(_users.Where(u => u.UserId != _selectedUser), value));

    private static IEnumerable<User> FilterUsers(IEnumerable<User> source, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return source.Take(30);
        var term = value.Trim();
        return source.Where(u =>
            (u.FullName ?? "").ContainsArabic(term) ||
            (u.Username ?? "").ContainsArabic(term) ||
            SystemRoleCatalog.Text(u.Role).ContainsArabic(term)).Take(30);
    }

    private async Task OnUserPicked(User? user) => await OnUserSelected(user?.UserId ?? 0);
    private string EmployeeName(int? id) => id is int employeeId && _employeeNames.TryGetValue(employeeId, out var name) ? name : "بدون ربط";
    private static string CategoryLabel(string? category)
    {
        if (string.IsNullOrWhiteSpace(category)) return "—";
        foreach (var item in KnownCategories)
            if (string.Equals(item.Value, category, StringComparison.OrdinalIgnoreCase)) return item.Label;
        return category;
    }

    private void OpenCatalog() => Navigation.NavigateTo("/admin/permissions");
    private void ShowAllRows() { _onlyAssigned = false; _category = ""; }
    private void ShowAssigned() { _onlyAssigned = true; _category = ""; }
    private void SetCategory(string category) { _category = category; _onlyAssigned = false; }

    private async Task OnUserSelected(int userId)
    {
        _selectedUser = userId;
        _search = "";
        _category = "";
        _onlyAssigned = false;
        _copySource = 0;
        if (userId > 0) await LoadUserPermissions();
        else _permissionList.Clear();
    }

    private async Task LoadUserPermissions()
    {
        var all = await Db.Permissions.AsNoTracking().OrderBy(p => p.Category).ThenBy(p => p.PermissionName).ToListAsync();
        var mine = await Db.UserPermissions.AsNoTracking().Where(up => up.UserId == _selectedUser).ToListAsync();
        _permissionList = all.Select(p =>
        {
            var existing = mine.FirstOrDefault(up => up.PermissionId == p.PermissionId);
            return new UserPermissionItem
            {
                PermissionId = p.PermissionId,
                Permission = p,
                CanView = existing?.CanView ?? false,
                CanAdd = existing?.CanAdd ?? false,
                CanEdit = existing?.CanEdit ?? false,
                CanDelete = existing?.CanDelete ?? false
            };
        }).ToList();
    }

    private bool Matches(UserPermissionItem item)
    {
        if (_onlyAssigned && !item.CanView && !item.CanAdd && !item.CanEdit && !item.CanDelete) return false;
        if (!string.IsNullOrWhiteSpace(_category) && !string.Equals(item.Permission.Category, _category, StringComparison.OrdinalIgnoreCase)) return false;
        if (string.IsNullOrWhiteSpace(_search)) return true;
        var term = _search.Trim();
        return (item.Permission.PermissionName ?? "").ContainsArabic(term)
            || (item.Permission.FormName ?? "").ContainsArabic(term)
            || (item.Permission.Description ?? "").ContainsArabic(term)
            || CategoryLabel(item.Permission.Category).ContainsArabic(term);
    }

    private Task OnSearchChanged(string value) { _search = value ?? ""; return Task.CompletedTask; }
    private Task OnView(UserPermissionItem item, ChangeEventArgs e) { item.CanView = e.Value is true; return OnPermissionChanged(item); }
    private Task OnAdd(UserPermissionItem item, ChangeEventArgs e) { item.CanAdd = e.Value is true; return OnPermissionChanged(item); }
    private Task OnEdit(UserPermissionItem item, ChangeEventArgs e) { item.CanEdit = e.Value is true; return OnPermissionChanged(item); }
    private Task OnDelete(UserPermissionItem item, ChangeEventArgs e) { item.CanDelete = e.Value is true; return OnPermissionChanged(item); }

    private async Task ToggleRow(UserPermissionItem item)
    {
        var on = !(item.CanView && item.CanAdd && item.CanEdit && item.CanDelete);
        item.CanView = item.CanAdd = item.CanEdit = item.CanDelete = on;
        await OnPermissionChanged(item);
    }

    private async Task OnPermissionChanged(UserPermissionItem item)
    {
        if (_busy || _selectedUser <= 0) return;
        _busy = true;
        try
        {
            var existing = await Db.UserPermissions.FirstOrDefaultAsync(up => up.UserId == _selectedUser && up.PermissionId == item.PermissionId);
            if (!item.CanView && !item.CanAdd && !item.CanEdit && !item.CanDelete)
            {
                if (existing != null) Db.UserPermissions.Remove(existing);
            }
            else if (existing == null)
            {
                Db.UserPermissions.Add(new UserPermission
                {
                    UserId = _selectedUser,
                    PermissionId = item.PermissionId,
                    CanView = item.CanView,
                    CanAdd = item.CanAdd,
                    CanEdit = item.CanEdit,
                    CanDelete = item.CanDelete,
                    AssignedBy = _currentUser?.Identity?.Name,
                    AssignedDate = DateTime.Now
                });
            }
            else
            {
                existing.CanView = item.CanView;
                existing.CanAdd = item.CanAdd;
                existing.CanEdit = item.CanEdit;
                existing.CanDelete = item.CanDelete;
                existing.AssignedBy = _currentUser?.Identity?.Name;
                existing.AssignedDate = DateTime.Now;
            }
            await Db.SaveChangesAsync();
            _isError = false;
            _message = null;
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = "تعذر حفظ الصلاحية: " + ex.Message;
            await LoadUserPermissions();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SelectVisible()
    {
        foreach (var item in VisiblePermissions.ToList())
            item.CanView = item.CanAdd = item.CanEdit = item.CanDelete = true;
        await SaveAll("تم تحديد الظاهر");
    }

    private async Task ClearVisible()
    {
        foreach (var item in VisiblePermissions.ToList())
            item.CanView = item.CanAdd = item.CanEdit = item.CanDelete = false;
        await SaveAll("تم إلغاء الظاهر");
    }

    private Task AskCopyUser(User? user)
    {
        _copyUser = user;
        _copySource = user?.UserId ?? 0;
        _confirmCopy = _copySource > 0 && _copySource != _selectedUser;
        return Task.CompletedTask;
    }

    private void CancelCopy() { _confirmCopy = false; _copySource = 0; _copyUser = null; }

    private async Task ConfirmCopy()
    {
        var source = await Db.UserPermissions.AsNoTracking().Where(up => up.UserId == _copySource).ToListAsync();
        foreach (var item in _permissionList)
        {
            var match = source.FirstOrDefault(s => s.PermissionId == item.PermissionId);
            item.CanView = match?.CanView ?? false;
            item.CanAdd = match?.CanAdd ?? false;
            item.CanEdit = match?.CanEdit ?? false;
            item.CanDelete = match?.CanDelete ?? false;
        }
        _confirmCopy = false;
        await SaveAll("تم نسخ الصلاحيات");
        _copySource = 0;
        _copyUser = null;
    }

    private async Task SaveAll(string success)
    {
        if (_busy || _selectedUser <= 0) return;
        _busy = true;
        try
        {
            var existing = await Db.UserPermissions.Where(up => up.UserId == _selectedUser).ToListAsync();
            Db.UserPermissions.RemoveRange(existing);
            foreach (var item in _permissionList.Where(p => p.CanView || p.CanAdd || p.CanEdit || p.CanDelete))
            {
                Db.UserPermissions.Add(new UserPermission
                {
                    UserId = _selectedUser,
                    PermissionId = item.PermissionId,
                    CanView = item.CanView,
                    CanAdd = item.CanAdd,
                    CanEdit = item.CanEdit,
                    CanDelete = item.CanDelete,
                    AssignedBy = _currentUser?.Identity?.Name,
                    AssignedDate = DateTime.Now
                });
            }
            await Db.SaveChangesAsync();
            _isError = false;
            _message = success;
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = "تعذر الحفظ: " + ex.Message;
            await LoadUserPermissions();
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class UserPermissionItem
    {
        public int PermissionId { get; set; }
        public Permission Permission { get; set; } = new();
        public bool CanView { get; set; }
        public bool CanAdd { get; set; }
        public bool CanEdit { get; set; }
        public bool CanDelete { get; set; }
    }
}
