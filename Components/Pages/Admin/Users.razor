@page "/admin/users"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@using Microsoft.EntityFrameworkCore
@using COCOBOLOERPNEW.Models
@using COCOBOLOERPNEW.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject db24804Context Db
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<div class="users-admin-page">
    <div class="page-header">
        <div class="header-content">
            <div class="header-left">
                <div class="page-icon">
                    <MudIcon Icon="@Icons.Material.Filled.SupervisedUserCircle" />
                </div>
                <div class="header-text">
                    <h1>إدارة المستخدمين</h1>
                    <p class="subtitle">عرض الحسابات والأدوار وربط الموظف والفرع</p>
                </div>
            </div>
            @if (HasPermission("frm_AddUser", "Add"))
            {
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Rounded.PersonAdd" Class="add-btn" OnClick="AddNewUser">
                    إضافة مستخدم جديد
                </MudButton>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_loadError</MudAlert>
    }

    <section class="filter-panel">
        <div class="filter-grid">
            <div class="field field-search">
                <span class="field-label">بحث</span>
                <div class="field-box">
                    <MudIcon Icon="@Icons.Material.Outlined.Search" Class="field-icon" />
                    <MudTextField T="string" Value="_searchText" ValueChanged="OnSearchChanged" Immediate="true" DebounceInterval="250"
                                  Placeholder="الاسم، اسم المستخدم، الموظف أو البريد" Variant="Variant.Text" Margin="Margin.Dense" Class="bare-field" />
                </div>
            </div>
            <div class="field">
                <span class="field-label">الدور</span>
                <div class="field-box">
                    <MudIcon Icon="@Icons.Material.Outlined.WorkspacePremium" Class="field-icon" />
                    <MudSelect T="string" Value="_filterRole" ValueChanged="OnRoleChanged" Placeholder="كل الأدوار" Variant="Variant.Text" Margin="Margin.Dense" Clearable="true" Class="bare-field">
                        @foreach (var role in RoleOptions)
                        {
                            <MudSelectItem T="string" Value="@role.Value">@role.Label</MudSelectItem>
                        }
                    </MudSelect>
                </div>
            </div>
            <div class="field">
                <span class="field-label">صلاحية الشاشة</span>
                <div class="field-box">
                    <MudIcon Icon="@Icons.Material.Outlined.VpnKey" Class="field-icon" />
                    <MudSelect T="string" Value="_filterPermission" ValueChanged="OnPermissionChanged" Placeholder="كل الصلاحيات" Variant="Variant.Text" Margin="Margin.Dense" Clearable="true" Class="bare-field">
                        @foreach (var name in _permissionOptions)
                        {
                            <MudSelectItem T="string" Value="@name">@name</MudSelectItem>
                        }
                    </MudSelect>
                </div>
            </div>
            <div class="field field-status">
                <span class="field-label">الحالة</span>
                <div class="status-chips">
                    <button type="button" class="@(_filterActive == null ? "on" : "")" @onclick="() => OnStatusChanged(null)">الكل</button>
                    <button type="button" class="@(_filterActive == 1 ? "on good" : "")" @onclick="() => OnStatusChanged(1)">نشط</button>
                    <button type="button" class="@(_filterActive == 0 ? "on bad" : "")" @onclick="() => OnStatusChanged(0)">غير نشط</button>
                </div>
            </div>
            <div class="result-chip">
                <span>النتائج</span>
                <strong>@_filteredUsers.Count</strong>
            </div>
        </div>
        @if (HasActiveFilters)
        {
            <div class="active-filters">
                @if (!string.IsNullOrWhiteSpace(_searchText))
                {
                    <button type="button" class="tag" @onclick="() => OnSearchChanged(string.Empty)">بحث: @_searchText <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" /></button>
                }
                @if (!string.IsNullOrWhiteSpace(_filterRole))
                {
                    <button type="button" class="tag" @onclick="() => OnRoleChanged(null)">الدور: @RoleText(_filterRole) <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" /></button>
                }
                @if (!string.IsNullOrWhiteSpace(_filterPermission))
                {
                    <button type="button" class="tag" @onclick="() => OnPermissionChanged(null)">الصلاحية: @_filterPermission <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" /></button>
                }
                <button type="button" class="clear-all" @onclick="ClearFilters">مسح الكل</button>
            </div>
        }
    </section>

    <div class="table-container">
        @if (_isLoading)
        {
            <div class="state-box">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                <p>جارٍ تحميل المستخدمين...</p>
            </div>
        }
        else if (!_filteredUsers.Any())
        {
            <div class="state-box">
                <MudIcon Icon="@Icons.Material.Filled.PersonOff" Size="Size.Large" />
                <h3>لا توجد نتائج</h3>
                <p>@(HasActiveFilters ? "لا يوجد مستخدم مطابق للبحث أو التصفية." : "لا يوجد مستخدمون في النظام.")</p>
            </div>
        }
        else
        {
            <MudTable Items="_filteredUsers" Hover="true" Breakpoint="Breakpoint.Md" RowsPerPage="20" Elevation="0" Class="users-table">
                <HeaderContent>
                    <MudTh>الكود</MudTh>
                    <MudTh>المستخدم</MudTh>
                    <MudTh>البريد</MudTh>
                    <MudTh>الدور</MudTh>
                    <MudTh>الموظف</MudTh>
                    <MudTh>الفرع</MudTh>
                    <MudTh>الحالة</MudTh>
                    <MudTh>آخر دخول</MudTh>
                    <MudTh>الإجراءات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="الكود"><span class="user-id">@context.UserId</span></MudTd>
                    <MudTd DataLabel="المستخدم">
                        <div class="name-cell">
                            <strong>@context.FullName</strong>
                            <span>@context.Username</span>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="البريد">@(string.IsNullOrWhiteSpace(context.Email) ? "—" : context.Email)</MudTd>
                    <MudTd DataLabel="الدور"><span class="role-badge">@RoleText(context.Role)</span></MudTd>
                    <MudTd DataLabel="الموظف">@EmployeeName(context.EmployeeId)</MudTd>
                    <MudTd DataLabel="الفرع">@BranchName(context.DefaultBranchId)</MudTd>
                    <MudTd DataLabel="الحالة">
                        <span class="status-badge @(context.IsActive == true ? "active" : "inactive")">@(context.IsActive == true ? "نشط" : "غير نشط")</span>
                    </MudTd>
                    <MudTd DataLabel="آخر دخول">@(context.LastLogin?.ToString("yyyy/MM/dd HH:mm") ?? "—")</MudTd>
                    <MudTd DataLabel="الإجراءات">
                        <div class="action-buttons">
                            @if (HasPermission("frm_AddUser", "Edit"))
                            {
                                <MudTooltip Text="ربط الصلاحيات">
                                    <MudIconButton Icon="@Icons.Material.Rounded.VpnKey" Color="Color.Info" Size="Size.Small" OnClick="() => OpenPermissions(context)" />
                                </MudTooltip>
                                <MudTooltip Text="تعديل">
                                    <MudIconButton Icon="@Icons.Material.Rounded.Edit" Color="Color.Warning" Size="Size.Small" OnClick="() => EditUser(context)" />
                                </MudTooltip>
                            }
                            @if (HasPermission("frm_AllUsers", "Delete"))
                            {
                                <MudTooltip Text="حذف">
                                    <MudIconButton Icon="@Icons.Material.Rounded.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => OpenDeleteDialog(context)" />
                                </MudTooltip>
                            }
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </div>
</div>

@if (_deleteDialogOpen)
{
    <MudOverlay Visible="true" Class="delete-overlay">
        <div class="delete-dialog" @onclick:stopPropagation="true">
            <MudIcon Icon="@Icons.Material.Rounded.WarningAmber" Class="dialog-icon" />
            <h2>تأكيد الحذف</h2>
            <p>هل تريد حذف المستخدم <strong>@_userToDelete?.FullName</strong>؟</p>
            <p class="warning-text">لا يمكن التراجع عن هذا الإجراء.</p>
            <div class="dialog-actions">
                <MudButton Variant="Variant.Outlined" OnClick="CancelDelete">إلغاء</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="ConfirmDelete">حذف المستخدم</MudButton>
            </div>
        </div>
    </MudOverlay>
}

<style>
    .users-admin-page { padding: 1.5rem 1.75rem 2.5rem; direction: rtl; color: #1E293B; }
    .page-header {
        background: linear-gradient(135deg, #0A1628 0%, #1E293B 100%);
        border-bottom: 3px solid #D4AF37;
        border-radius: 18px;
        padding: 1.5rem 1.75rem;
        margin-bottom: 1.25rem;
        box-shadow: 0 12px 30px rgba(10, 22, 40, 0.18);
    }
    .header-content, .header-left, .action-buttons, .dialog-actions { display: flex; align-items: center; }
    .header-content { justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
    .header-left { gap: 1rem; }
    .page-icon {
        width: 58px; height: 58px; border-radius: 16px;
        display: grid; place-items: center; color: #D4AF37;
        background: rgba(212, 175, 55, 0.14); border: 1px solid rgba(212, 175, 55, 0.45);
    }
    .page-icon .mud-icon-root { font-size: 1.8rem; }
    .header-text h1 { margin: 0; color: #fff; font-size: 1.7rem; font-weight: 800; }
    .header-text .subtitle { margin: 0.3rem 0 0; color: #CBD5E1; }
    .add-btn { background: #D4AF37 !important; color: #0A1628 !important; font-weight: 800 !important; border-radius: 12px !important; }
    .filter-panel, .table-container, .delete-dialog { background: #fff; border: 1px solid #E2E8F0; border-radius: 16px; }
    .filter-panel { padding: 1rem 1rem 0.85rem; margin-bottom: 1rem; box-shadow: 0 8px 24px rgba(10, 22, 40, 0.05); }
    .filter-grid { display: grid; grid-template-columns: minmax(260px, 1.5fr) minmax(180px, 1fr) minmax(200px, 1fr) auto auto; gap: 0.85rem; align-items: end; }
    .field-label { display: block; margin: 0 0.15rem 0.4rem; color: #64748B; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.02em; }
    .field-box { height: 48px; display: flex; align-items: center; gap: 0.35rem; padding: 0 0.75rem; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px; transition: border-color .15s, box-shadow .15s, background .15s; }
    .field-box:focus-within { background: #fff; border-color: #D4AF37; box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.18); }
    .field-icon { color: #D4AF37; font-size: 1.15rem; }
    .status-chips { height: 48px; display: flex; padding: 4px; gap: 4px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px; }
    .status-chips button { border: 0; background: transparent; color: #64748B; border-radius: 9px; padding: 0 0.9rem; font-weight: 800; cursor: pointer; }
    .status-chips button.on { background: #0A1628; color: #fff; }
    .status-chips button.on.good { background: #047857; }
    .status-chips button.on.bad { background: #B91C1C; }
    .result-chip { min-width: 84px; height: 48px; border-radius: 12px; background: #0A1628; color: #D4AF37; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .result-chip span { font-size: 0.68rem; font-weight: 700; color: #CBD5E1; }
    .result-chip strong { font-size: 1.15rem; line-height: 1.1; }
    .active-filters { display: flex; flex-wrap: wrap; gap: 0.45rem; align-items: center; margin-top: 0.85rem; }
    .tag, .clear-all { border: 0; cursor: pointer; border-radius: 999px; display: inline-flex; align-items: center; gap: 0.25rem; font-weight: 700; }
    .tag { background: rgba(212, 175, 55, 0.16); color: #0A1628; padding: 0.28rem 0.55rem 0.28rem 0.75rem; }
    .clear-all { background: transparent; color: #B91C1C; padding: 0.28rem 0.4rem; }
    ::deep .bare-field { flex: 1; }
    ::deep .bare-field .mud-input-control { margin: 0; }
    ::deep .bare-field .mud-input-slot { padding: 0; min-height: 46px; }
    ::deep .bare-field .mud-input { color: #1E293B; font-weight: 600; }
    ::deep .bare-field .mud-input-underline:before, ::deep .bare-field .mud-input-underline:after { display: none; }
    .table-container { overflow: hidden; }
    .state-box { min-height: 240px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.6rem; color: #64748B; }
    .state-box h3 { margin: 0; color: #1E293B; }
    .user-id { color: #64748B; font-weight: 700; }
    .name-cell strong, .name-cell span { display: block; }
    .name-cell span { color: #64748B; font-size: 0.82rem; }
    .role-badge, .status-badge { display: inline-flex; align-items: center; border-radius: 999px; padding: 0.22rem 0.7rem; font-size: 0.8rem; font-weight: 700; }
    .role-badge { background: rgba(212, 175, 55, 0.16); color: #0A1628; }
    .status-badge.active { background: #ECFDF5; color: #047857; }
    .status-badge.inactive { background: #FEF2F2; color: #B91C1C; }
    .action-buttons { gap: 0.15rem; }
    .delete-overlay { z-index: 1400; }
    .delete-dialog { width: min(460px, 92vw); padding: 1.5rem; text-align: center; }
    .dialog-icon { color: #D4AF37; font-size: 2.4rem; margin-bottom: 0.4rem; }
    .delete-dialog h2 { margin: 0 0 0.4rem; color: #0A1628; }
    .delete-dialog p { color: #64748B; }
    .warning-text { color: #B91C1C !important; }
    .dialog-actions { justify-content: center; gap: 0.6rem; }
    ::deep .users-table .mud-table-head { background: #F4F6F9; }
    ::deep .users-table th { color: #0A1628; font-weight: 800; }
    @@media (max-width: 1100px) {
        .users-admin-page { padding: 1rem; }
        .header-text h1 { font-size: 1.35rem; }
        .filter-grid { grid-template-columns: 1fr 1fr; }
        .field-search, .field-status, .result-chip { grid-column: 1 / -1; }
        .status-chips button { flex: 1; }
    }
</style>

@code {
    private List<User> _allUsers = new();
    private List<User> _filteredUsers = new();
    private Dictionary<int, string> _employeeNames = new();
    private Dictionary<int, string> _branchNames = new();
    private Dictionary<int, HashSet<string>> _userPermissions = new();
    private List<string> _permissionOptions = new();
    private string _searchText = "";
    private string? _filterRole;
    private string? _filterPermission;
    private int? _filterActive;
    private string? _loadError;
    private ClaimsPrincipal? _currentUser;
    private bool _isLoading = true;
    private bool _deleteDialogOpen;
    private User? _userToDelete;

    [SupplyParameterFromQuery(Name = "permission")]
    public string? PermissionFromQuery { get; set; }

    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(_searchText) || !string.IsNullOrWhiteSpace(_filterRole) || !string.IsNullOrWhiteSpace(_filterPermission) || _filterActive.HasValue;

    private IEnumerable<(string Value, string Label)> RoleOptions
    {
        get
        {
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var role in SystemRoleCatalog.Roles)
            {
                if (seen.Add(role.Value))
                    yield return role;
            }
            foreach (var role in _allUsers.Select(u => u.Role).Where(r => !string.IsNullOrWhiteSpace(r)))
            {
                if (seen.Add(role!))
                    yield return (role!, role!);
            }
        }
    }

    private static string RoleText(string? role) => SystemRoleCatalog.Text(role);
    private string EmployeeName(int? id) => id is int employeeId && _employeeNames.TryGetValue(employeeId, out var name) ? name : "—";
    private string BranchName(int? id) => id is int branchId && _branchNames.TryGetValue(branchId, out var name) ? name : "—";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUser = auth.User;
        if (!string.IsNullOrWhiteSpace(PermissionFromQuery))
            _filterPermission = PermissionFromQuery;
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            _allUsers = await Db.Users.AsNoTracking().OrderByDescending(u => u.CreatedAt).ThenByDescending(u => u.UserId).ToListAsync();
            await LoadEmployeesAndBranches();
            await LoadPermissions();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            _loadError = "تعذر تحميل المستخدمين: " + ex.Message;
            if (_filteredUsers.Count == 0)
                _filteredUsers = _allUsers.ToList();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadEmployeesAndBranches()
    {
        var employeeIds = _allUsers.Where(u => u.EmployeeId.HasValue).Select(u => u.EmployeeId!.Value).Distinct().ToList();
        _employeeNames = employeeIds.Count == 0
            ? new()
            : await Db.Employees.AsNoTracking().Where(e => employeeIds.Contains(e.EmployeeId)).ToDictionaryAsync(e => e.EmployeeId, e => e.FullName ?? "");
        var branchIds = _allUsers.Where(u => u.DefaultBranchId.HasValue).Select(u => u.DefaultBranchId!.Value).Distinct().ToList();
        _branchNames = branchIds.Count == 0
            ? new()
            : await Db.Branches.AsNoTracking().Where(b => branchIds.Contains(b.BranchId)).ToDictionaryAsync(b => b.BranchId, b => b.BranchNameAr ?? "");
    }

    private async Task LoadPermissions()
    {
        try
        {
            var links = await (
                from up in Db.UserPermissions.AsNoTracking()
                join p in Db.Permissions.AsNoTracking() on up.PermissionId equals p.PermissionId
                where (up.CanView || up.CanAdd || up.CanEdit || up.CanDelete) && p.PermissionName != null
                select new { up.UserId, p.PermissionName }
            ).ToListAsync();
            _userPermissions = links.GroupBy(x => x.UserId).ToDictionary(g => g.Key, g => g.Select(x => x.PermissionName).ToHashSet());
            _permissionOptions = links.Select(x => x.PermissionName).Distinct().OrderBy(x => x).ToList();
        }
        catch (Exception ex)
        {
            _userPermissions = new();
            _permissionOptions = new();
            _loadError = "تم تحميل المستخدمين، وتعذر تحميل صلاحيات الشاشات: " + ex.Message;
        }
    }

    private Task OnSearchChanged(string value) { _searchText = value ?? ""; ApplyFilters(); return Task.CompletedTask; }
    private Task OnRoleChanged(string? value) { _filterRole = value; ApplyFilters(); return Task.CompletedTask; }
    private Task OnPermissionChanged(string? value) { _filterPermission = value; ApplyFilters(); return Task.CompletedTask; }
    private Task OnStatusChanged(int? value) { _filterActive = value; ApplyFilters(); return Task.CompletedTask; }

    private void ApplyFilters()
    {
        IEnumerable<User> query = _allUsers;
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var search = _searchText.Trim();
            query = query.Where(u =>
                (u.FullName ?? "").ContainsArabic(search) ||
                (u.Username ?? "").ContainsArabic(search) ||
                (u.Email ?? "").ContainsArabic(search) ||
                EmployeeName(u.EmployeeId).ContainsArabic(search) ||
                RoleText(u.Role).ContainsArabic(search));
        }
        if (!string.IsNullOrWhiteSpace(_filterRole))
            query = query.Where(u => string.Equals(u.Role, _filterRole, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_filterPermission))
            query = query.Where(u => _userPermissions.TryGetValue(u.UserId, out var names) && names.Contains(_filterPermission));
        if (_filterActive.HasValue)
            query = query.Where(u => (u.IsActive == true) == (_filterActive.Value == 1));
        _filteredUsers = query.ToList();
    }

    private void ClearFilters()
    {
        _searchText = "";
        _filterRole = null;
        _filterPermission = null;
        _filterActive = null;
        ApplyFilters();
    }

    private void AddNewUser() => Navigation.NavigateTo("/admin/users/new");
    private void EditUser(User user) => Navigation.NavigateTo($"/admin/users/{user.UserId}");
    private void OpenPermissions(User user) => Navigation.NavigateTo($"/admin/permissions/manage?user={user.UserId}");

    private void OpenDeleteDialog(User user)
    {
        _userToDelete = user;
        _deleteDialogOpen = true;
    }

    private async Task ConfirmDelete()
    {
        if (_userToDelete == null) return;
        try
        {
            var entity = await Db.Users.FirstOrDefaultAsync(u => u.UserId == _userToDelete.UserId);
            if (entity != null)
            {
                Db.Users.Remove(entity);
                await Db.SaveChangesAsync();
                _allUsers.RemoveAll(u => u.UserId == entity.UserId);
                ApplyFilters();
            }
        }
        catch (Exception ex)
        {
            _loadError = "تعذر حذف المستخدم: " + ex.Message;
        }
        CancelDelete();
    }

    private void CancelDelete()
    {
        _deleteDialogOpen = false;
        _userToDelete = null;
    }

    private bool HasPermission(string formName, string action)
        => _currentUser?.Claims.Any(c => c.Type == "Permission" && c.Value == $"{formName}:{action}") == true;
}
