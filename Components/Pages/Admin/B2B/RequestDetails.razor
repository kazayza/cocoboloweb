        .item-row-content { grid-template-columns: 1fr; }
        .hero-status-area { align-items: flex-start; width: 100%; }
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private bool _isLoading = true;
    private string _currentUserName = "system";
    private B2BRequestDetailDto? _request;
    private string? _previewImageUrl;
    private string _previewImageTitle = "";
    private string _selectedStatus = B2BRequestStatuses.New;
    private string? _internalNotes;
    private string? _customerResponse;
    private int? _relatedQuotationId;
    private int? _relatedInvoiceId;
    private B2BQuotationLookupDto? _selectedQuotation;
    private B2BInvoiceLookupDto? _selectedInvoice;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        if (!B2BPermissions.CanManage(user))
        {
            Snackbar.Add("ليس لديك صلاحية متابعة الطلب", Severity.Error);
            Navigation.NavigateTo("/");
            return;
        }

        _currentUserName = user.Identity?.Name ?? "system";
        _request = await RequestService.GetByIdAsync(Id);
        if (_request != null)
        {
            SyncEditorFromRequest();
            await LoadRelatedLookupsAsync();
        }
        _isLoading = false;
    }

    private void SyncEditorFromRequest()
    {
        if (_request == null) return;
        _selectedStatus = _request.Status;
        _internalNotes = _request.InternalNotes;
        _customerResponse = _request.CustomerResponse;
        _relatedQuotationId = _request.RelatedQuotationId;
        _relatedInvoiceId = _request.RelatedInvoiceId;
    }

    private async Task LoadRelatedLookupsAsync()
    {
        _selectedQuotation = _relatedQuotationId.HasValue
            ? await RequestService.GetQuotationLookupByIdAsync(_relatedQuotationId.Value)
            : null;

        _selectedInvoice = _relatedInvoiceId.HasValue
            ? await RequestService.GetInvoiceLookupByIdAsync(_relatedInvoiceId.Value)
            : null;
    }

    private async Task SaveManagementAsync()
    {
        var (success, message) = await RequestService.UpdateStatusAsync(
            Id,
            _selectedStatus,
            _currentUserName,
            _internalNotes,
            _customerResponse,
            _relatedQuotationId,
            _relatedInvoiceId);

        Snackbar.Add(message, success ? Severity.Success : Severity.Error);
        if (!success) return;

        _request = await RequestService.GetByIdAsync(Id);
        if (_request != null)
        {
            SyncEditorFromRequest();
            await LoadRelatedLookupsAsync();
        }
        StateHasChanged();
    }

    private async Task<IEnumerable<B2BQuotationLookupDto>> SearchQuotationLookupAsync(string? value, CancellationToken token)
    {
        if (_request == null) return Enumerable.Empty<B2BQuotationLookupDto>();
        try { return await RequestService.SearchQuotationsAsync(_request.PartyId, value, 20); }
        catch { return Enumerable.Empty<B2BQuotationLookupDto>(); }
    }

    private async Task<IEnumerable<B2BInvoiceLookupDto>> SearchInvoiceLookupAsync(string? value, CancellationToken token)
    {
        if (_request == null) return Enumerable.Empty<B2BInvoiceLookupDto>();
        try { return await RequestService.SearchInvoicesAsync(_request.PartyId, value, 20); }
        catch { return Enumerable.Empty<B2BInvoiceLookupDto>(); }
    }

    private async Task OnQuotationSelected(B2BQuotationLookupDto? item)
    {
        _selectedQuotation = item;
        _relatedQuotationId = item?.QuotationId;

        if (item?.InvoiceId is int linkedInvoiceId)
        {
            _selectedInvoice = await RequestService.GetInvoiceLookupByIdAsync(linkedInvoiceId);
            _relatedInvoiceId = _selectedInvoice?.TransactionId ?? linkedInvoiceId;
        }
    }

    private async Task OnInvoiceSelected(B2BInvoiceLookupDto? item)
    {
        _selectedInvoice = item;
        _relatedInvoiceId = item?.TransactionId;

        if (item?.QuotationId is int linkedQuotationId)
        {
            _selectedQuotation = await RequestService.GetQuotationLookupByIdAsync(linkedQuotationId);
            _relatedQuotationId = _selectedQuotation?.QuotationId ?? linkedQuotationId;
        }
    }

    private void ClearQuotationSelection()
    {
        _selectedQuotation = null;
        _relatedQuotationId = null;
    }

    private void ClearInvoiceSelection()
    {
        _selectedInvoice = null;
        _relatedInvoiceId = null;
    }

    private void OpenQuotation(int quotationId) => Navigation.NavigateTo($"/quotations/{quotationId}");

    private void OpenInvoice(int invoiceId) => Navigation.NavigateTo($"/sales/invoices/{invoiceId}");

    private List<TimelineStepVm> GetTimelineSteps()
    {
        var handled = _request!.HandledAt.HasValue;
        var final = _request.Status is B2BRequestStatuses.Converted
            or B2BRequestStatuses.Closed
            or B2BRequestStatuses.Rejected;

        return
        [
            new("تم إنشاء الطلب", _request.CreatedAt.ToString("yyyy/MM/dd HH:mm"), true),
            new("المراجعة / المعالجة", handled ? _request.HandledAt!.Value.ToString("yyyy/MM/dd HH:mm") : "بانتظار المراجعة", handled),
            new("الحالة النهائية", GetRequestStatusText(_request.Status), final)
        ];
    }

    private void OpenPreview(string imageUrl, string? title)
    {
        _previewImageUrl = imageUrl;
        _previewImageTitle = string.IsNullOrWhiteSpace(title) ? "صورة المنتج" : title;
    }

    private void ClosePreview()
    {
        _previewImageUrl = null;
        _previewImageTitle = string.Empty;
    }

