@code {
    [Parameter] public int Id { get; set; }

    private bool _isLoading = true;
    private string _currentUserName = "system";
    private B2BRequestDetailDto? _request;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        if (!B2BPermissions.CanManage(user))
        {
            Snackbar.Add("ليس لديك صلاحية متابعة الطلب", Severity.Error);
            Navigation.NavigateTo("/");
            return;
        }

        _currentUserName = user.Identity?.Name ?? "system";
        _request = await RequestService.GetByIdAsync(Id);
        _isLoading = false;
    }

    private async Task UpdateStatusAsync(string status)
    {
        var (success, message) = await RequestService.UpdateStatusAsync(Id, status, _currentUserName);
        Snackbar.Add(message, success ? Severity.Success : Severity.Error);
        if (!success) return;
        _request = await RequestService.GetByIdAsync(Id);
        StateHasChanged();
    }

    private List<TimelineStepVm> GetTimelineSteps()
    {
        var handled = _request!.HandledAt.HasValue;
        var final = _request.Status is B2BRequestStatuses.Converted
            or B2BRequestStatuses.Closed
            or B2BRequestStatuses.Rejected;

        return
        [
            new("تم إنشاء الطلب", _request.CreatedAt.ToString("yyyy/MM/dd HH:mm"), true),
            new("المراجعة / المعالجة", handled ? _request.HandledAt!.Value.ToString("yyyy/MM/dd HH:mm") : "بانتظار المراجعة", handled),
            new("الحالة النهائية", GetRequestStatusText(_request.Status), final)
        ];
    }

    private static int GetProgressPercent(string status) => status switch
    {
        B2BRequestStatuses.New => 20,
        B2BRequestStatuses.UnderReview => 50,
        B2BRequestStatuses.Converted => 100,
        B2BRequestStatuses.Closed => 100,
        B2BRequestStatuses.Rejected => 100,
        _ => 10
    };

    private static string GetRequestTypeText(string v) => v switch
    {
        B2BRequestTypes.Quotation => "طلب عرض سعر",
        B2BRequestTypes.Reorder => "إعادة طلب",
        B2BRequestTypes.PaymentProof => "إثبات دفع",
        B2BRequestTypes.Support => "دعم / استفسار",
        _ => v
    };

    private static string GetRequestStatusText(string v) => v switch
    {
        B2BRequestStatuses.New => "جديد",
        B2BRequestStatuses.UnderReview => "تحت المراجعة",
        B2BRequestStatuses.Converted => "تم التحويل",
        B2BRequestStatuses.Closed => "مغلق",
        B2BRequestStatuses.Rejected => "مرفوض",
        _ => v
    };

    private static string GetStatusClass(string v) => v switch
    {
        B2BRequestStatuses.New => "new",
        B2BRequestStatuses.UnderReview => "review",
        B2BRequestStatuses.Converted => "converted",
        B2BRequestStatuses.Closed => "closed",
        B2BRequestStatuses.Rejected => "rejected",
        _ => "closed"
    };

    private sealed record TimelineStepVm(string Title, string Subtitle, bool Done);
}