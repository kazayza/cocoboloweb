    private static string FormatMoney(decimal value) => value.ToString("N2");

    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024) return $"{bytes / 1024d / 1024d:F1} MB";
        if (bytes >= 1024) return $"{bytes / 1024d:F0} KB";
        return $"{bytes} B";
    }

