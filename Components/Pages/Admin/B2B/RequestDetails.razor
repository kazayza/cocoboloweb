@page "/admin/b2b/requests/{Id:int}"

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject IB2BRequestService RequestService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>تفاصيل طلب B2B</PageTitle>

@if (_isLoading)
{
    <div class="b2b-loading">
        <div class="loading-shell">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <div class="loading-text">
                <strong>جاري تحميل تفاصيل الطلب</strong>
                <span>يرجى الانتظار لحظات...</span>
            </div>
        </div>
    </div>
}
else if (_request == null)
{
    <div class="b2b-not-found" dir="rtl">
        <div class="not-found-card">
            <div class="not-found-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
                    <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                </svg>
            </div>
            <strong>الطلب غير موجود</strong>
            <p>الطلب المطلوب غير موجود أو تم حذفه.</p>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.ArrowForward"
                       OnClick='() => Navigation.NavigateTo("/admin/b2b/requests")'>
                العودة للطلبات
            </MudButton>
        </div>
    </div>
}
else
{
    <div dir="rtl" class="admin-detail-page">

        <!-- ══════════ BACK BAR ══════════ -->
        <div class="back-bar">
            <button class="back-btn" @onclick='() => Navigation.NavigateTo("/admin/b2b/requests")'>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9,18 15,12 9,6"/></svg>
                العودة لقائمة الطلبات
            </button>
        </div>

        <!-- ══════════ HERO ══════════ -->
        <section class="detail-hero">
            <div class="hero-glow g1"></div>
            <div class="hero-glow g2"></div>

            <div class="hero-body">
                <div class="hero-icon-wrap">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14,2 14,8 20,8"/>
                        <line x1="16" y1="13" x2="8" y2="13"/>
                        <line x1="16" y1="17" x2="8" y2="17"/>
                    </svg>
                </div>
                <div class="hero-text">
                    <div class="hero-chip">
                        <span class="chip-dot"></span>
                        إدارة داخلية — تفاصيل الطلب
                    </div>
                    <h1>طلب #@_request.RequestId</h1>
                    <p>@_request.PartyName — @GetRequestTypeText(_request.RequestType)</p>
                </div>
            </div>

            <div class="hero-status-area">
                <span class='status-badge @GetStatusClass(_request.Status)'>@GetRequestStatusText(_request.Status)</span>
                <div class="hero-progress">
                    <div class='hero-progress-fill @GetStatusClass(_request.Status)' style="width:@(GetProgressPercent(_request.Status))%"></div>
                </div>
                <span class="hero-progress-label">@GetProgressPercent(_request.Status)% مكتمل</span>
            </div>
        </section>

        <!-- ══════════ CONTENT ══════════ -->
        <div class="detail-layout">

            <!-- ── Main ── -->
            <div class="detail-main">

                <!-- Info -->
                <section class="surface">
                    <div class="surface-header">
                        <div class="surface-icon info-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                        </div>
                        <div>
                            <h3>معلومات الطلب</h3>
                            <p>البيانات الأساسية والأطراف المعنية.</p>
                        </div>
                    </div>

                    <div class="info-cards-grid">
                        <div class="info-card">
                            <div class="info-card-icon blue">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            </div>
                            <div class="info-card-body"><span>العميل</span><strong>@_request.PartyName</strong></div>
                        </div>

                        <div class="info-card">
                            <div class="info-card-icon green">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                            </div>
                            <div class="info-card-body"><span>مستخدم البوابة</span><strong>@_request.PortalUserName</strong></div>
                        </div>

                        <div class="info-card">
                            <div class="info-card-icon purple">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            </div>
                            <div class="info-card-body"><span>الموظف المسئول</span><strong>@(_request.ResponsibleEmployeeName ?? "لم يحدد")</strong></div>
                        </div>

                        <div class="info-card">
                            <div class="info-card-icon amber">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            </div>
                            <div class="info-card-body"><span>تاريخ الإنشاء</span><strong>@_request.CreatedAt.ToString("yyyy/MM/dd HH:mm")</strong></div>
                        </div>

                        <div class="info-card">
                            <div class="info-card-icon slate">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
                            </div>
                            <div class="info-card-body"><span>آخر تحديث</span><strong>@(_request.HandledAt.HasValue ? _request.HandledAt.Value.ToString("yyyy/MM/dd HH:mm") : "لم تتم بعد")</strong></div>
                        </div>

                        <div class="info-card">
                            <div class="info-card-icon teal">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            </div>
                            <div class="info-card-body"><span>منشئ السجل</span><strong>@_request.CreatedBy</strong></div>
                        </div>
                    </div>
                </section>

                <!-- Notes -->
                <section class="surface">
                    <div class="surface-header">
                        <div class="surface-icon notes-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        </div>
                        <div>
                            <h3>ملاحظات الطلب</h3>
                            <p>الملاحظات المرفقة من العميل.</p>
                        </div>
                    </div>
                    <div class="notes-content">
                        @if (string.IsNullOrWhiteSpace(_request.Notes))
                        {
                            <div class="notes-empty">لا توجد ملاحظات مرفقة مع هذا الطلب.</div>
                        }
                        else
                        {
                            <div class="notes-text">@_request.Notes</div>
                        }
                    </div>
                </section>

                <!-- Items -->
                @if (_request.Items.Any())
                {
                    <section class="surface">
                        <div class="surface-header">
                            <div class="surface-icon items-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16,8 20,8 23,11 23,16 16,16 16,8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                            </div>
                            <div>
                                <h3>البنود المرسلة</h3>
                                <p>عدد البنود: <b>@_request.Items.Count</b></p>
                            </div>
                        </div>

                        <div class="items-list">
                            @for (var i = 0; i < _request.Items.Count; i++)
                            {
                                var item = _request.Items[i];
                                <div class="item-row">
                                    <div class="item-row-badge">@(i + 1)</div>
                                    <div class="item-row-content">
                                        <div class="item-field"><span>المنتج</span><strong>@(string.IsNullOrWhiteSpace(item.ProductName) ? "غير محدد" : item.ProductName)</strong></div>
                                        <div class="item-field"><span>الكمية</span><strong>@item.Quantity</strong></div>
                                        <div class="item-field"><span>ملاحظات</span><strong>@(string.IsNullOrWhiteSpace(item.Notes) ? "—" : item.Notes)</strong></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                }
            </div>

            <!-- ── Sidebar ── -->
            <div class="detail-sidebar">

                <!-- Quick Actions -->
                <section class="surface actions-surface">
                    <div class="surface-header">
                        <div class="surface-icon actions-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13,2 3,14 12,14 11,22 21,10 12,10 13,2"/></svg>
                        </div>
                        <h3>إجراءات سريعة</h3>
                    </div>

                    <div class="actions-grid">
                        @if (_request.Status != B2BRequestStatuses.UnderReview)
                        {
                            <button class="action-btn review-btn" @onclick='() => UpdateStatusAsync(B2BRequestStatuses.UnderReview)'>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
                                تحت المراجعة
                            </button>
                        }

                        @if (_request.Status != B2BRequestStatuses.Converted)
                        {
                            <button class="action-btn convert-btn" @onclick='() => UpdateStatusAsync(B2BRequestStatuses.Converted)'>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20,6 9,17 4,12"/></svg>
                                تم التحويل
                            </button>
                        }

                        @if (_request.Status != B2BRequestStatuses.Closed)
                        {
                            <button class="action-btn close-btn" @onclick='() => UpdateStatusAsync(B2BRequestStatuses.Closed)'>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                إغلاق
                            </button>
                        }

                        @if (_request.Status != B2BRequestStatuses.Rejected)
                        {
                            <button class="action-btn reject-btn" @onclick='() => UpdateStatusAsync(B2BRequestStatuses.Rejected)'>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                                رفض
                            </button>
                        }
                    </div>
                </section>

                <!-- Timeline -->
                <section class="surface">
                    <div class="surface-header">
                        <div class="surface-icon timeline-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
                        </div>
                        <h3>مسار الطلب</h3>
                    </div>

                    <div class="timeline">
                        @{
                            var steps = GetTimelineSteps();
                        }
                        @for (var i = 0; i < steps.Count; i++)
                        {
                            var step = steps[i];
                            var isLast = i == steps.Count - 1;
                            <div class='tl-step @(step.Done ? "done" : "pending")'>
                                <div class="tl-dot-area">
                                    <div class="tl-dot">
                                        @if (step.Done)
                                        {
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20,6 9,17 4,12"/></svg>
                                        }
                                    </div>
                                    @if (!isLast)
                                    {
                                        <div class='tl-line @(step.Done ? "done" : "pending")'></div>
                                    }
                                </div>
                                <div class="tl-content">
                                    <strong>@step.Title</strong>
                                    <small>@step.Subtitle</small>
                                </div>
                            </div>
                        }
                    </div>
                </section>

                <!-- Related -->
                @if (_request.RelatedQuotationId.HasValue || _request.RelatedInvoiceId.HasValue)
                {
                    <section class="surface">
                        <div class="surface-header">
                            <div class="surface-icon related-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                            </div>
                            <h3>مرتبط بـ</h3>
                        </div>

                        <div class="related-list">
                            @if (_request.RelatedQuotationId.HasValue)
                            {
                                <div class="related-card green">
                                    <div class="related-card-icon">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14,2 14,8 20,8"/></svg>
                                    </div>
                                    <div><span>عرض سعر</span><strong>#@_request.RelatedQuotationId</strong></div>
                                </div>
                            }
                            @if (_request.RelatedInvoiceId.HasValue)
                            {
                                <div class="related-card blue">
                                    <div class="related-card-icon">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                                    </div>
                                    <div><span>فاتورة</span><strong>#@_request.RelatedInvoiceId</strong></div>
                                </div>
                            }
                        </div>
                    </section>
                }

                <!-- Summary -->
                <section class="surface summary-surface">
                    <div class="summary-row"><span>رقم الطلب</span><strong>#@_request.RequestId</strong></div>
                    <div class="summary-row"><span>النوع</span><strong>@GetRequestTypeText(_request.RequestType)</strong></div>
                    <div class="summary-row"><span>الحالة</span><span class='status-pill sm @GetStatusClass(_request.Status)'>@GetRequestStatusText(_request.Status)</span></div>
                    <div class="summary-row"><span>عدد البنود</span><strong>@_request.Items.Count</strong></div>
                    <div class="summary-row"><span>أنشأه</span><strong>@_request.CreatedBy</strong></div>
                    @if (!string.IsNullOrWhiteSpace(_request.HandledBy))
                    {
                        <div class="summary-row"><span>عالجه</span><strong>@_request.HandledBy</strong></div>
                    }
                </section>
            </div>
        </div>
    </div>
}

<style>
    :root {
        --surface: #ffffff;
        --border: #e4eaf3;
        --text: #0f172a;
        --muted: #64748b;
        --primary: #2563eb;
        --primary-light: #dbeafe;
        --r-xl: 28px;
        --r-lg: 22px;
        --r-md: 16px;
        --sh-sm: 0 4px 14px rgba(15,23,42,.04);
        --sh-md: 0 12px 30px rgba(15,23,42,.06);
        --sh-lg: 0 20px 50px rgba(15,23,42,.10);
    }

    .b2b-loading { min-height: 55vh; display: flex; align-items: center; justify-content: center; }
    .loading-shell { display: flex; align-items: center; gap: 1rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-xl); padding: 1.4rem 1.6rem; box-shadow: var(--sh-lg); }
    .loading-text { display: flex; flex-direction: column; gap: .12rem; }
    .loading-text strong { color: var(--text); font-size: .95rem; }
    .loading-text span { color: var(--muted); font-size: .82rem; }

    .b2b-not-found { min-height: 50vh; display: flex; align-items: center; justify-content: center; }
    .not-found-card { display: flex; flex-direction: column; align-items: center; gap: .65rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-xl); padding: 2rem 2.5rem; text-align: center; box-shadow: var(--sh-lg); }
    .not-found-card strong { color: var(--text); font-size: 1.05rem; }
    .not-found-card p { margin: 0; color: var(--muted); font-size: .88rem; }

    .admin-detail-page { display: flex; flex-direction: column; gap: .9rem; padding: .15rem; }

    .back-bar { display: flex; }
    .back-btn {
        display: inline-flex; align-items: center; gap: .4rem;
        background: var(--surface); border: 1px solid var(--border);
        border-radius: 14px; padding: .5rem .85rem;
        color: var(--text); font-family: inherit; font-size: .84rem; font-weight: 800;
        cursor: pointer; transition: .2s ease; box-shadow: var(--sh-sm);
    }
    .back-btn:hover { transform: translateY(-1px); box-shadow: var(--sh-md); }

    /* ══ HERO ══ */
    .detail-hero {
        position: relative; overflow: hidden;
        border-radius: var(--r-xl); padding: 1rem 1.2rem; color: #fff;
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #2563eb 100%);
        display: flex; align-items: center; justify-content: space-between;
        gap: 1rem; flex-wrap: wrap; box-shadow: 0 16px 42px rgba(15,23,42,.20);
    }
    .hero-glow { position: absolute; border-radius: 50%; filter: blur(70px); opacity: .3; pointer-events: none; }
    .hero-glow.g1 { width: 180px; height: 180px; top: -50px; right: -25px; background: radial-gradient(circle, #60a5fa, transparent); }
    .hero-glow.g2 { width: 140px; height: 140px; bottom: -40px; left: -15px; background: radial-gradient(circle, #34d399, transparent); }

    .hero-body { position: relative; z-index: 1; display: flex; align-items: center; gap: .85rem; flex: 1; }
    .hero-icon-wrap { width: 50px; height: 50px; border-radius: var(--r-md); background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.16); display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #dbeafe; }
    .hero-text { flex: 1; }
    .hero-chip { display: inline-flex; align-items: center; gap: .4rem; padding: .25rem .65rem; border-radius: 999px; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.14); font-size: .68rem; font-weight: 800; margin-bottom: .3rem; }
    .chip-dot { width: 7px; height: 7px; border-radius: 50%; background: #34d399; animation: pulse-dot 2s infinite; }
    @@keyframes pulse-dot { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: .4; transform: scale(1.5); } }
    .hero-text h1 { margin: 0; font-size: 1.3rem; font-weight: 900; }
    .hero-text p { margin: .2rem 0 0; color: #bfdbfe; font-size: .84rem; }

    .hero-status-area { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: flex-end; gap: .4rem; min-width: 160px; }
    .status-badge { display: inline-flex; padding: .35rem .8rem; border-radius: 999px; font-size: .74rem; font-weight: 900; }
    .status-badge.new { background: rgba(219,234,254,.9); color: #1d4ed8; }
    .status-badge.review { background: rgba(254,243,199,.9); color: #b45309; }
    .status-badge.converted { background: rgba(209,250,229,.9); color: #047857; }
    .status-badge.closed { background: rgba(226,232,240,.9); color: #475569; }
    .status-badge.rejected { background: rgba(254,226,226,.9); color: #b91c1c; }

    .hero-progress { width: 100%; height: 4px; border-radius: 999px; background: rgba(255,255,255,.15); overflow: hidden; }
    .hero-progress-fill { height: 100%; border-radius: 999px; transition: width .4s ease; }
    .hero-progress-fill.new { background: #60a5fa; } .hero-progress-fill.review { background: #fbbf24; }
    .hero-progress-fill.converted { background: #34d399; } .hero-progress-fill.closed { background: #94a3b8; }
    .hero-progress-fill.rejected { background: #f87171; }
    .hero-progress-label { color: #bfdbfe; font-size: .7rem; }

    /* ══ LAYOUT ══ */
    .detail-layout { display: grid; grid-template-columns: 1fr 340px; gap: 1rem; }
    .detail-main { display: flex; flex-direction: column; gap: .9rem; }
    .detail-sidebar { display: flex; flex-direction: column; gap: .9rem; }

    .surface {
        background: rgba(255,255,255,.96); border: 1px solid var(--border);
        border-radius: var(--r-xl); padding: 1.1rem; box-shadow: var(--sh-sm);
    }
    .surface-header { display: flex; align-items: flex-start; gap: .7rem; margin-bottom: .85rem; }
    .surface-icon { width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .info-icon { background: #f1f5f9; color: var(--muted); }
    .notes-icon { background: #fef3c7; color: #d97706; }
    .items-icon { background: #dbeafe; color: #2563eb; }
    .timeline-icon { background: #d1fae5; color: #059669; }
    .related-icon { background: #e0e7ff; color: #4f46e5; }
    .actions-icon { background: #fef3c7; color: #d97706; }
