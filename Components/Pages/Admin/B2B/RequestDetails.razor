@page "/admin/b2b/requests/{Id:int}"

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject IB2BRequestService RequestService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>تفاصيل طلب B2B</PageTitle>

@if (_isLoading)
{
    <div class="b2b-loading">
        <div class="loading-shell">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <div class="loading-text">
                <strong>جاري تحميل تفاصيل الطلب</strong>
                <span>يرجى الانتظار لحظات...</span>
            </div>
        </div>
    </div>
}
else if (_request == null)
{
    <div class="b2b-not-found" dir="rtl">
        <div class="not-found-card">
            <div class="not-found-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
                    <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                </svg>
            </div>
            <strong>الطلب غير موجود</strong>
            <p>الطلب المطلوب غير موجود أو تم حذفه.</p>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.ArrowForward"
                       OnClick='() => Navigation.NavigateTo("/admin/b2b/requests")'>
                العودة للطلبات
            </MudButton>
        </div>
    </div>
}
else
{
    <div dir="rtl" class="admin-detail-page">

        <!-- ══════════ BACK BAR ══════════ -->
        <div class="back-bar">
            <button class="back-btn" @onclick='() => Navigation.NavigateTo("/admin/b2b/requests")'>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9,18 15,12 9,6"/></svg>
                العودة لقائمة الطلبات
            </button>
        </div>

        <!-- ══════════ HERO ══════════ -->
        <section class="detail-hero">
            <div class="hero-glow g1"></div>
            <div class="hero-glow g2"></div>

            <div class="hero-body">
                <div class="hero-icon-wrap">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14,2 14,8 20,8"/>
                        <line x1="16" y1="13" x2="8" y2="13"/>
                        <line x1="16" y1="17" x2="8" y2="17"/>
                    </svg>
                </div>
                <div class="hero-text">
                    <div class="hero-chip">
                        <span class="chip-dot"></span>
                        إدارة داخلية — تفاصيل الطلب
                    </div>
                    <h1>طلب #@_request.RequestId</h1>
                    <p>@_request.PartyName — @GetRequestTypeText(_request.RequestType)</p>
                </div>
            </div>

            <div class="hero-status-area">
                <span class='status-badge @GetStatusClass(_request.Status)'>@GetRequestStatusText(_request.Status)</span>
                <div class="hero-progress">
                    <div class='hero-progress-fill @GetStatusClass(_request.Status)' style="width:@(GetProgressPercent(_request.Status))%"></div>
                </div>
                <span class="hero-progress-label">@GetProgressPercent(_request.Status)% مكتمل</span>
            </div>
        </section>

        <!-- ══════════ CONTENT ══════════ -->
        <div class="detail-layout">

            <!-- ── Main ── -->
            <div class="detail-main">

                <!-- Info -->
                <section class="surface">
                    <div class="surface-header">
                        <div class="surface-icon info-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                        </div>
                        <div>
                            <h3>معلومات الطلب</h3>
                            <p>البيانات الأساسية والأطراف المعنية.</p>
                        </div>
                    </div>

                    <div class="info-cards-grid">
                        <div class="info-card">
                            <div class="info-card-icon blue">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            </div>
                            <div class="info-card-body"><span>العميل</span><strong>@_request.PartyName</strong></div>
                        </div>

                        <div class="info-card">
                            <div class="info-card-icon green">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                            </div>
                            <div class="info-card-body"><span>مستخدم البوابة</span><strong>@_request.PortalUserName</strong></div>
                        </div>

                        <div class="info-card">
                            <div class="info-card-icon purple">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            </div>
                            <div class="info-card-body"><span>الموظف المسئول</span><strong>@(_request.ResponsibleEmployeeName ?? "لم يحدد")</strong></div>
                        </div>

                        <div class="info-card">
                            <div class="info-card-icon amber">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            </div>
                            <div class="info-card-body"><span>تاريخ الإنشاء</span><strong>@_request.CreatedAt.ToString("yyyy/MM/dd HH:mm")</strong></div>
                        </div>

                        <div class="info-card">
                            <div class="info-card-icon slate">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
                            </div>
                            <div class="info-card-body"><span>آخر تحديث</span><strong>@(_request.HandledAt.HasValue ? _request.HandledAt.Value.ToString("yyyy/MM/dd HH:mm") : "لم تتم بعد")</strong></div>
                        </div>

                        <div class="info-card">
                            <div class="info-card-icon teal">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            </div>
                            <div class="info-card-body"><span>منشئ السجل</span><strong>@_request.CreatedBy</strong></div>
                        </div>
                    </div>
                </section>

                <!-- Notes -->
                <section class="surface">
                    <div class="surface-header">
                        <div class="surface-icon notes-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        </div>
                        <div>
                            <h3>ملاحظات الطلب</h3>
                            <p>الملاحظات المرفقة من العميل.</p>
                        </div>
                    </div>
                    <div class="notes-content">
                        @if (string.IsNullOrWhiteSpace(_request.Notes))
                        {
                            <div class="notes-empty">لا توجد ملاحظات مرفقة مع هذا الطلب.</div>
                        }
                        else
                        {
                            <div class="notes-text">@_request.Notes</div>
                        }
                    </div>
                </section>

                <section class="surface">
                    <div class="surface-header">
                        <div class="surface-icon internal-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><path d="M21 12c.552 0 1 .448 1 1v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-8c0-.552.448-1 1-1"/><path d="M16 5a4 4 0 1 0-8 0v7h8V5z"/></svg>
                        </div>
                        <div>
                            <h3>ملاحظات داخلية</h3>
                            <p>تظهر للفريق الداخلي فقط ولا يراها العميل.</p>
                        </div>
                    </div>
                    <div class="notes-content">
                        @if (string.IsNullOrWhiteSpace(_request.InternalNotes))
                        {
                            <div class="notes-empty">لا توجد ملاحظات داخلية حتى الآن.</div>
                        }
                        else
                        {
                            <div class="notes-text">@_request.InternalNotes</div>
                        }
                    </div>
                </section>

                <section class="surface">
                    <div class="surface-header">
                        <div class="surface-icon response-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                        </div>
                        <div>
                            <h3>الرد الظاهر للعميل</h3>
                            <p>هذا النص سيظهر للعميل داخل البورتال ويستخدم أيضًا في الإشعار.</p>
                        </div>
                    </div>
                    <div class="notes-content">
                        @if (string.IsNullOrWhiteSpace(_request.CustomerResponse))
                        {
                            <div class="notes-empty">لم يتم إرسال رد ظاهر للعميل بعد.</div>
                        }
                        else
                        {
                            <div class="notes-text">@_request.CustomerResponse</div>
                        }
                    </div>
                </section>

                <!-- Items -->
                @if (_request.Items.Any())
                {
                    <section class="surface">
                        <div class="surface-header">
                            <div class="surface-icon items-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16,8 20,8 23,11 23,16 16,16 16,8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                            </div>
                            <div>
                                <h3>البنود المرسلة</h3>
                                <p>عدد البنود: <b>@_request.Items.Count</b></p>
                            </div>
                        </div>

                        <div class="items-list">
                            @for (var i = 0; i < _request.Items.Count; i++)
                            {
                                var item = _request.Items[i];
                                <div class="item-row">
                                    <div class="item-row-badge">@(i + 1)</div>
                                    <div class="item-row-content with-image">
                                        <div class="item-product-block">
                                            @if (!string.IsNullOrWhiteSpace(item.ProductImageUrl))
                                            {
                                                <button type="button" class="thumb-btn" @onclick='() => OpenPreview(item.ProductImageUrl!, item.ProductName)'>
                                                    <img src="@item.ProductImageUrl" alt="@item.ProductName" class="item-product-thumb" />
                                                </button>
                                            }
                                            <div class="item-field"><span>المنتج</span><strong>@(string.IsNullOrWhiteSpace(item.ProductName) ? "غير محدد" : item.ProductName)</strong></div>
                                        </div>
                                        <div class="item-field"><span>الكمية</span><strong>@item.Quantity</strong></div>
                                        <div class="item-field"><span>ملاحظات</span><strong>@(string.IsNullOrWhiteSpace(item.Notes) ? "—" : item.Notes)</strong></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                }

                @if (_request.Attachments.Any())
                {
                    <section class="surface attachments-surface">
                        <div class="surface-header">
                            <div class="surface-icon attachments-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.44 11.05l-8.49 8.49a5.5 5.5 0 0 1-7.78-7.78l9.19-9.19a3.5 3.5 0 0 1 4.95 4.95l-9.2 9.19a1.5 1.5 0 0 1-2.12-2.12l8.49-8.48"/></svg>
                            </div>
                            <div>
                                <h3>المرفقات</h3>
                                <p>الملفات التي أرفقها العميل مع الطلب.</p>
                            </div>
                        </div>

                        <div class="attachments-list-grid">
                            @foreach (var attachment in _request.Attachments)
                            {
                                <a class="attachment-card" href="@attachment.RelativePath" target="_blank">
                                    <strong>@attachment.FileName</strong>
                                    <span>@FormatFileSize(attachment.FileSizeBytes)</span>
                                    <small>@attachment.UploadedAt.ToString("yyyy/MM/dd HH:mm")</small>
                                </a>
                            }
                        </div>
                    </section>
                }
            </div>

            <!-- ── Sidebar ── -->
            <div class="detail-sidebar">

                <!-- Management Panel -->
                <section class="surface actions-surface">
                    <div class="surface-header">
                        <div class="surface-icon actions-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13,2 3,14 12,14 11,22 21,10 12,10 13,2"/></svg>
                        </div>
                        <div>
                            <h3>إدارة الطلب</h3>
                            <p>حدّث الحالة، أضف ملاحظات داخلية، واكتب ردًا يظهر للعميل.</p>
                        </div>
                    </div>

                    <div class="quick-status-row">
                        <button class="action-btn review-btn" @onclick='() => _selectedStatus = B2BRequestStatuses.UnderReview'>تحت المراجعة</button>
                        <button class="action-btn convert-btn" @onclick='() => _selectedStatus = B2BRequestStatuses.Converted'>تم التحويل</button>
                        <button class="action-btn close-btn" @onclick='() => _selectedStatus = B2BRequestStatuses.Closed'>إغلاق</button>
                        <button class="action-btn reject-btn" @onclick='() => _selectedStatus = B2BRequestStatuses.Rejected'>رفض</button>
                    </div>

                    <MudSelect T="string" @bind-Value="_selectedStatus" Label="الحالة الجديدة" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="@B2BRequestStatuses.New">جديد</MudSelectItem>
                        <MudSelectItem Value="@B2BRequestStatuses.UnderReview">تحت المراجعة</MudSelectItem>
                        <MudSelectItem Value="@B2BRequestStatuses.Converted">تم التحويل</MudSelectItem>
                        <MudSelectItem Value="@B2BRequestStatuses.Closed">مغلق</MudSelectItem>
                        <MudSelectItem Value="@B2BRequestStatuses.Rejected">مرفوض</MudSelectItem>
                    </MudSelect>

                    <MudTextField T="string" @bind-Value="_internalNotes" Label="ملاحظات داخلية (لا تظهر للعميل)" Lines="4" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField T="string" @bind-Value="_customerResponse" Label="رسالة / رد للعميل" Lines="4" Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="هذا النص سيظهر للعميل داخل البورتال ويُستخدم في الإشعار كذلك." />

                    <div class="smart-link-box">
                        <div class="smart-link-head">
                            <strong>الربط الذكي</strong>
                            <span>ابحث داخل سجلات نفس العميل فقط، وسيتم جلب الرقم الحقيقي وربطه تلقائيًا.</span>
                        </div>

                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudAutocomplete T="B2BQuotationLookupDto"
                                                 Value="_selectedQuotation"
                                                 ValueChanged="OnQuotationSelected"
                                                 SearchFunc="SearchQuotationLookupAsync"
                                                 ToStringFunc="@(x => x?.DisplayName ?? string.Empty)"
                                                 Label="ابحث عن عرض السعر المرتبط"
                                                 HelperText="إذا كان عرض السعر محولًا لفاتورة، سيتم اقتراح الفاتورة تلقائيًا."
                                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 Clearable="true" ResetValueOnEmptyText="true" CoerceText="false"
                                                 Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search">
                                    <ItemTemplate Context="quote">
                                        <div class="lookup-item">
                                            <div class="lookup-top-line">
                                                <strong>@quote.ReferenceNumber</strong>
                                                <span class="lookup-status green">@GetQuotationStatusText(quote.Status)</span>
                                            </div>
                                            <small>@quote.PartyName — @quote.QuotationDate.ToString("yyyy/MM/dd") — @FormatMoney(quote.GrandTotal) ج</small>
                                            @if (quote.InvoiceId.HasValue)
                                            {
                                                <span class="link-inline-hint">محوّل لفاتورة: @(quote.InvoiceReferenceNumber ?? $"#{quote.InvoiceId.Value}")</span>
                                            }
                                        </div>
                                    </ItemTemplate>
                                </MudAutocomplete>

                                @if (_selectedQuotation != null)
                                {
                                    <div class="linked-preview-card green">
                                        <div>
                                            <span>عرض السعر المحدد</span>
                                            <strong>@_selectedQuotation.ReferenceNumber</strong>
                                            <small>@_selectedQuotation.QuotationDate.ToString("yyyy/MM/dd") — @FormatMoney(_selectedQuotation.GrandTotal) ج</small>
                                        </div>
                                        <div class="link-preview-actions">
                                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Success" StartIcon="@Icons.Material.Filled.OpenInNew" OnClick='() => OpenQuotation(_selectedQuotation.QuotationId)'>فتح السجل</MudButton>
                                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Default" StartIcon="@Icons.Material.Filled.LinkOff" OnClick="ClearQuotationSelection">فك الربط</MudButton>
                                        </div>
                                    </div>
                                }
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudAutocomplete T="B2BInvoiceLookupDto"
                                                 Value="_selectedInvoice"
                                                 ValueChanged="OnInvoiceSelected"
                                                 SearchFunc="SearchInvoiceLookupAsync"
                                                 ToStringFunc="@(x => x?.DisplayName ?? string.Empty)"
                                                 Label="ابحث عن الفاتورة المرتبطة"
                                                 HelperText="إذا كانت الفاتورة ناتجة من عرض سعر، سيتم اقتراح عرض السعر تلقائيًا."
                                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 Clearable="true" ResetValueOnEmptyText="true" CoerceText="false"
                                                 Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search">
                                    <ItemTemplate Context="invoice">
                                        <div class="lookup-item">
                                            <div class="lookup-top-line">
                                                <strong>@invoice.ReferenceNumber</strong>
                                                <span class="lookup-status blue">@GetInvoiceStatusText(invoice.Status)</span>
                                            </div>
                                            <small>@invoice.PartyName — @invoice.TransactionDate.ToString("yyyy/MM/dd") — @FormatMoney(invoice.GrandTotal) ج</small>
                                            <span class="link-inline-hint">مدفوع: @FormatMoney(invoice.PaidAmount) ج — متبقي: @FormatMoney(invoice.Remaining) ج</span>
                                        </div>
                                    </ItemTemplate>
                                </MudAutocomplete>

                                @if (_selectedInvoice != null)
                                {
                                    <div class="linked-preview-card blue">
                                        <div>
                                            <span>الفاتورة المحددة</span>
                                            <strong>@_selectedInvoice.ReferenceNumber</strong>
                                            <small>@_selectedInvoice.TransactionDate.ToString("yyyy/MM/dd") — @FormatMoney(_selectedInvoice.GrandTotal) ج</small>
                                        </div>
                                        <div class="link-preview-actions">
                                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.OpenInNew" OnClick='() => OpenInvoice(_selectedInvoice.TransactionId)'>فتح السجل</MudButton>
                                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Default" StartIcon="@Icons.Material.Filled.LinkOff" OnClick="ClearInvoiceSelection">فك الربط</MudButton>
                                        </div>
                                    </div>
                                }
                            </MudItem>
                        </MudGrid>
                    </div>

                    <div class="management-actions-row">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveManagementAsync">حفظ التحديث</MudButton>
                    </div>
                </section>

                <!-- Timeline -->
                <section class="surface">
                    <div class="surface-header">
                        <div class="surface-icon timeline-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
                        </div>
                        <h3>مسار الطلب</h3>
                    </div>

                    <div class="timeline">
                        @{
                            var steps = GetTimelineSteps();
                        }
                        @for (var i = 0; i < steps.Count; i++)
                        {
                            var step = steps[i];
                            var isLast = i == steps.Count - 1;
                            <div class='tl-step @(step.Done ? "done" : "pending")'>
                                <div class="tl-dot-area">
                                    <div class="tl-dot">
                                        @if (step.Done)
                                        {
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20,6 9,17 4,12"/></svg>
                                        }
                                    </div>
                                    @if (!isLast)
                                    {
                                        <div class='tl-line @(step.Done ? "done" : "pending")'></div>
                                    }
                                </div>
                                <div class="tl-content">
                                    <strong>@step.Title</strong>
                                    <small>@step.Subtitle</small>
                                </div>
                            </div>
                        }
                    </div>
                </section>

                <!-- Related -->
                @if (_selectedQuotation != null || _selectedInvoice != null || _request.RelatedQuotationId.HasValue || _request.RelatedInvoiceId.HasValue)
                {
                    <section class="surface">
                        <div class="surface-header">
                            <div class="surface-icon related-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                            </div>
                            <h3>مرتبط بـ</h3>
                        </div>

                        <div class="related-list">
                            @if (_selectedQuotation != null)
                            {
                                <div class="related-card green related-card-rich">
                                    <div class="related-card-icon">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14,2 14,8 20,8"/></svg>
                                    </div>
                                    <div class="related-rich-body">
                                        <span>عرض سعر</span>
                                        <strong>@_selectedQuotation.ReferenceNumber</strong>
                                        <small>@_selectedQuotation.QuotationDate.ToString("yyyy/MM/dd") — @FormatMoney(_selectedQuotation.GrandTotal) ج</small>
                                    </div>
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Success" StartIcon="@Icons.Material.Filled.OpenInNew" OnClick='() => OpenQuotation(_selectedQuotation.QuotationId)'>فتح</MudButton>
                                </div>
                            }
                            else if (_request.RelatedQuotationId.HasValue)
                            {
                                <div class="related-card green">
                                    <div class="related-card-icon">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14,2 14,8 20,8"/></svg>
                                    </div>
                                    <div><span>عرض سعر</span><strong>#@_request.RelatedQuotationId</strong></div>
                                </div>
                            }

                            @if (_selectedInvoice != null)
                            {
                                <div class="related-card blue related-card-rich">
                                    <div class="related-card-icon">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                                    </div>
                                    <div class="related-rich-body">
                                        <span>فاتورة</span>
                                        <strong>@_selectedInvoice.ReferenceNumber</strong>
                                        <small>@_selectedInvoice.TransactionDate.ToString("yyyy/MM/dd") — @FormatMoney(_selectedInvoice.GrandTotal) ج</small>
                                    </div>
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.OpenInNew" OnClick='() => OpenInvoice(_selectedInvoice.TransactionId)'>فتح</MudButton>
                                </div>
                            }
                            else if (_request.RelatedInvoiceId.HasValue)
                            {
                                <div class="related-card blue">
                                    <div class="related-card-icon">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                                    </div>
                                    <div><span>فاتورة</span><strong>#@_request.RelatedInvoiceId</strong></div>
                                </div>
                            }
                        </div>
                    </section>
                }

                <!-- Summary -->
                <section class="surface summary-surface">
                    <div class="summary-row"><span>رقم الطلب</span><strong>#@_request.RequestId</strong></div>
                    <div class="summary-row"><span>النوع</span><strong>@GetRequestTypeText(_request.RequestType)</strong></div>
                    <div class="summary-row"><span>الحالة</span><span class='status-pill sm @GetStatusClass(_request.Status)'>@GetRequestStatusText(_request.Status)</span></div>
                    <div class="summary-row"><span>عدد البنود</span><strong>@_request.Items.Count</strong></div>
                    <div class="summary-row"><span>أنشأه</span><strong>@_request.CreatedBy</strong></div>
                    @if (!string.IsNullOrWhiteSpace(_request.HandledBy))
                    {
                        <div class="summary-row"><span>عالجه</span><strong>@_request.HandledBy</strong></div>
                    }
                </section>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_previewImageUrl))
{
    <div class="image-preview-overlay" @onclick="ClosePreview">
        <div class="image-preview-card" @onclick:stopPropagation="true">
