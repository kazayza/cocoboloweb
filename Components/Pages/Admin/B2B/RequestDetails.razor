    .attachments-list-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:.7rem}
    .attachment-card{display:flex;flex-direction:column;gap:.2rem;padding:.85rem;border:1px solid #e2e8f0;border-radius:14px;background:#f8fafc;text-decoration:none;color:inherit;transition:.18s}
