@page "/admin/b2b/requests"

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms

@inject IB2BRequestService RequestService
@inject IB2BPortalUserService PortalUserService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>طلبات B2B</PageTitle>

@if (_isLoading)
{
    <div class="b2b-loading">
        <div class="loading-shell">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <div class="loading-text">
                <strong>جاري تحميل الطلبات</strong>
                <span>يرجى الانتظار لحظات...</span>
            </div>
        </div>
    </div>
}
else
{
    var filtered = FilteredRequests.ToList();

    <div dir="rtl" class="admin-requests-page">

        <!-- ══════════════ HERO ══════════════ -->
        <section class="hero-panel">
            <div class="hero-glow g1"></div>
            <div class="hero-glow g2"></div>

            <div class="hero-body">
                <div class="hero-icon-wrap">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14,2 14,8 20,8"/>
                        <line x1="16" y1="13" x2="8" y2="13"/>
                        <line x1="16" y1="17" x2="8" y2="17"/>
                    </svg>
                </div>
                <div class="hero-text">
                    <div class="hero-chip">
                        <span class="chip-dot"></span>
                        إدارة داخلية
                    </div>
                    <h1>إدارة طلبات B2B</h1>
                    <p>صندوق وارد موحّد لمتابعة الطلبات الجديدة، مراجعتها، وتحويلها إلى إجراءات داخلية.</p>
                </div>
            </div>

            <div class="hero-side">
                <div class="hero-metrics-row">
                    <div class="h-metric">
                        <strong>@_allRequests.Count</strong>
                        <span>إجمالي</span>
                    </div>
                    <div class="h-metric-sep"></div>
                    <div class="h-metric">
                        <strong>@_allRequests.Count(x => x.Status == B2BRequestStatuses.New || x.Status == B2BRequestStatuses.UnderReview)</strong>
                        <span>نشطة</span>
                    </div>
                    <div class="h-metric-sep"></div>
                    <div class="h-metric">
                        <strong>@filtered.Count</strong>
                        <span>ظاهرة</span>
                    </div>
                </div>

                <div class="hero-side-actions">
                    <button class="refresh-btn" @onclick="LoadAsync">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23,4 23,10 17,10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                        تحديث
                    </button>
                    <button class="create-btn" @onclick="ToggleCreateInternal">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        طلب جديد نيابة عن عميل
                    </button>
                </div>
            </div>
        </section>

        <!-- ══════════════ KPIs ══════════════ -->
        <section class="kpi-strip">
            <div class="kpi-card kpi-blue">
                <div class="kpi-dot new-dot"></div>
                <div class="kpi-info"><span>جديد</span><strong>@_allRequests.Count(x => x.Status == B2BRequestStatuses.New)</strong></div>
                @if (_allRequests.Any(x => x.Status == B2BRequestStatuses.New))
                {
                    <div class="kpi-alert"><span class="alert-dot"></span>تحتاج مراجعة</div>
                }
            </div>
            <div class="kpi-card kpi-amber">
                <div class="kpi-dot review-dot"></div>
                <div class="kpi-info"><span>تحت المراجعة</span><strong>@_allRequests.Count(x => x.Status == B2BRequestStatuses.UnderReview)</strong></div>
            </div>
            <div class="kpi-card kpi-green">
                <div class="kpi-dot converted-dot"></div>
                <div class="kpi-info"><span>تم التحويل</span><strong>@_allRequests.Count(x => x.Status == B2BRequestStatuses.Converted)</strong></div>
            </div>
            <div class="kpi-card kpi-slate">
                <div class="kpi-dot closed-dot"></div>
                <div class="kpi-info"><span>مغلقة</span><strong>@_allRequests.Count(x => x.Status == B2BRequestStatuses.Closed)</strong></div>
            </div>
            <div class="kpi-card kpi-red">
                <div class="kpi-dot rejected-dot"></div>
                <div class="kpi-info"><span>مرفوضة</span><strong>@_allRequests.Count(x => x.Status == B2BRequestStatuses.Rejected)</strong></div>
            </div>
        </section>

        @if (_showInternalCreate)
        {
            <section class="requests-surface internal-create-surface">
                <div class="surface-title-row">
                    <div>
                        <h3>إنشاء طلب نيابة عن العميل</h3>
                        <p>استخدم هذا النموذج عندما يطلب العميل عبر الهاتف أو واتساب أو الزيارة دون الدخول إلى البوابة.</p>
                    </div>
                </div>

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudAutocomplete T="B2BLookupDto"
                                         Value="_selectedParty"
                                         ValueChanged="OnInternalPartyChanged"
                                         SearchFunc="SearchPartiesAsync"
                                         ToStringFunc="@(x => x?.Name ?? string.Empty)"
                                         Label="ابحث عن العميل"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Clearable="true" ResetValueOnEmptyText="true" CoerceText="false"
                                         Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect T="string" @bind-Value="_internalCreate.RequestSource" Label="مصدر الطلب" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="@("Internal")">داخلي</MudSelectItem>
                            <MudSelectItem Value="@("Phone")">هاتف</MudSelectItem>
                            <MudSelectItem Value="@("WhatsApp")">واتساب</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect T="int?" @bind-Value="_internalCreate.ResponsibleEmployeeId" Label="الموظف المسئول" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                            @foreach (var emp in _employees)
                            {
                                <MudSelectItem Value="@((int?)emp.Id)">@emp.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="int?" @bind-Value="_internalCreate.PortalUserId" Label="مستخدم البوابة (اختياري)" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                            @foreach (var pu in _partyPortalUsers)
                            {
                                <MudSelectItem Value="@((int?)pu.Id)">@pu.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" @bind-Value="_internalCreate.RequestedContactName" Label="اسم الشخص الذي طلب" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" @bind-Value="_internalCreate.RequestedContactPhone" Label="هاتف جهة التواصل" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" @bind-Value="_internalCreate.RequestType" Label="نوع الطلب" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="@B2BRequestTypes.Quotation">طلب عرض سعر</MudSelectItem>
                            <MudSelectItem Value="@B2BRequestTypes.Reorder">إعادة طلب</MudSelectItem>
                            <MudSelectItem Value="@B2BRequestTypes.PaymentProof">إثبات دفع</MudSelectItem>
                            <MudSelectItem Value="@B2BRequestTypes.Support">دعم / استفسار</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="8">
                        <MudTextField T="string" @bind-Value="_internalCreate.Notes" Label="ملخص / ملاحظات عامة" Lines="4" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>

                @if (!_internalCreate.PartyId.HasValue)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                        اختر العميل أولاً قبل اختيار مستخدم البوابة أو حفظ الطلب.
                    </MudAlert>
                }
                else if (!_partyPortalUsers.Any())
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                        لا يوجد حساب بوابة لهذا العميل — يمكن المتابعة بدون بوابة، أو إنشاء حساب لاحقًا من شاشة مستخدمي البوابة.
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                        يوجد لهذا العميل حسابات بوابة مرتبطة — اختيار مستخدم البوابة اختياري فقط.
                    </MudAlert>
                }

                @if (SupportsItems(_internalCreate.RequestType))
                {
                    <div class="internal-items-zone">
                        <div class="internal-items-head">
                            <strong>بنود الطلب</strong>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="AddInternalItemLine">إضافة بند</MudButton>
                        </div>
                        @for (var i = 0; i < _internalCreate.Items.Count; i++)
                        {
                            var idx = i;
                            <div class="internal-item-row">
                                <MudGrid>
                                    <MudItem xs="12" md="5">
                                        <MudAutocomplete T="B2BProductLookupDto"
                                                         Value="_internalCreate.Items[idx].SelectedProduct"
                                                         ValueChanged="@(p => OnInternalProductChanged(idx, p))"
                                                         SearchFunc="SearchProductsAsync"
                                                         ToStringFunc="@(p => p?.DisplayName ?? string.Empty)"
                                                         Label="ابحث عن المنتج"
                                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                                         Clearable="true" ResetValueOnEmptyText="true" CoerceText="false"
                                                         Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search">
                                            <ItemTemplate Context="product">
                                                <div class="product-dropdown-item with-image">
                                                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                                    {
                                                        <img src="@product.ImageUrl" alt="@product.ProductName" class="product-thumb" />
                                                    }
                                                    <div class="product-dropdown-text">
                                                        <strong>@product.ProductName</strong>
                                                        @if (!string.IsNullOrWhiteSpace(product.ProductDescription))
                                                        { <small>@product.ProductDescription</small> }
                                                    </div>
                                                </div>
                                            </ItemTemplate>
                                        </MudAutocomplete>
                                    </MudItem>
                                    <MudItem xs="12" md="2">
                                        <MudNumericField T="decimal" @bind-Value="_internalCreate.Items[idx].Quantity" Label="الكمية" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" md="4">
                                        <MudTextField T="string" @bind-Value="_internalCreate.Items[idx].Notes" Label="ملاحظات البند" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" md="1" Class="d-flex align-center justify-center">
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick='() => RemoveInternalItemLine(idx)' />
                                    </MudItem>
                                </MudGrid>
                            </div>
                        }
                    </div>
                }

                <div class="attachments-zone">
                    <div class="internal-items-head">
                        <strong>مرفقات الطلب</strong>
                    </div>
                    <InputFile OnChange="OnInternalFilesChanged" multiple class="attachment-input" />
                    @if (_internalFiles.Any())
                    {
                        <div class="attachments-preview-list">
                            @foreach (var file in _internalFiles)
                            {
                                <div class="attachment-chip">
                                    <span>@file.Name</span>
                                    <small>@FormatFileSize(file.Size)</small>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="internal-create-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateInternalAsync">حفظ الطلب</MudButton>
                    <MudButton Variant="Variant.Text" OnClick="ResetInternalForm">مسح</MudButton>
                </div>
            </section>
        }

        <!-- ══════════════ REQUESTS LIST ══════════════ -->
        <section class="requests-surface">

            <!-- Toolbar -->
            <div class="toolbar">
                <div class="toolbar-search">
                    <MudTextField T="string" @bind-Value="_searchText"
                                  Placeholder="ابحث بالعميل، المستخدم، أو رقم الطلب..."
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Clearable="true" Immediate="true" />
                </div>
                <div class="toolbar-select">
                    <MudSelect T="string" Value="_statusFilter" ValueChanged="OnStatusChanged"
                               Label="فلتر الحالة" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                        <MudSelectItem Value="@B2BRequestStatuses.New">جديد</MudSelectItem>
                        <MudSelectItem Value="@B2BRequestStatuses.UnderReview">تحت المراجعة</MudSelectItem>
                        <MudSelectItem Value="@B2BRequestStatuses.Converted">تم التحويل</MudSelectItem>
                        <MudSelectItem Value="@B2BRequestStatuses.Closed">مغلق</MudSelectItem>
                        <MudSelectItem Value="@B2BRequestStatuses.Rejected">مرفوض</MudSelectItem>
                    </MudSelect>
                </div>
            </div>

            <!-- Filter chips -->
            <div class="filter-chips">
                @foreach (var f in _statusFilters)
                {
                    <button type="button"
                            class='filter-chip @(_statusFilter == f.Key ? "active" : "")'
                            @onclick='() => OnStatusChanged(f.Key == "All" ? null : f.Key)'>
                        @f.Title <b>@GetFilterCount(f.Key)</b>
                    </button>
                }
            </div>

            <!-- Results -->
            @if (filtered.Any())
            {
                <div class="results-header">
                    <span>عرض <b>@filtered.Count</b> من <b>@_allRequests.Count</b> طلب</span>
                </div>

                <div class="requests-grid">
                    @foreach (var req in filtered)
                    {
                        <div class='req-card @GetStatusClass(req.Status)'>
                            <!-- Card top -->
                            <div class="req-card-top">
                                <div class="req-card-id">
                                    <span class="req-hash">#@req.RequestId</span>
                                    <span class="req-customer">@req.PartyName</span>
                                </div>
                                <span class='status-pill @GetStatusClass(req.Status)'>@GetRequestStatusText(req.Status)</span>
                            </div>

                            <!-- Progress -->
                            <div class="req-progress">
                                <div class='req-progress-fill @GetStatusClass(req.Status)' style="width:@(GetProgressPercent(req.Status))%"></div>
                            </div>

                            <!-- Meta -->
                            <div class="req-card-meta">
                                <div class="meta-chip">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14,2 14,8 20,8"/></svg>
                                    @GetRequestTypeText(req.RequestType)
                                </div>
                                <div class="meta-chip">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                    @req.CreatedAt.ToString("yyyy/MM/dd")
                                </div>
                            </div>

                            <div class="req-card-details">
                                <div class="detail-row">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                    <span>مستخدم البوابة:</span>
                                    <strong>@GetPortalUserDisplay(req)</strong>
                                </div>
                                <div class="detail-row">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22,12 18,12 15,21 9,3 6,12 2,12"/></svg>
                                    <span>المصدر:</span>
                                    <strong>@GetRequestSourceText(req.RequestSource)</strong>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(req.RequestedContactName) || !string.IsNullOrWhiteSpace(req.RequestedContactPhone))
                                {
                                    <div class="detail-row">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 3.15 10.8 19.79 19.79 0 0 1 .08 2.09 2 2 0 0 1 2.06-.09h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L6.09 7.91a16 16 0 0 0 10 10l1.36-1.22a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                                        <span>جهة التواصل:</span>
                                        <strong>@GetContactDisplay(req)</strong>
                                    </div>
                                }
                                <div class="detail-row">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                                    <span>الموظف المسئول:</span>
                                    <strong>@(req.ResponsibleEmployeeName ?? "لم يحدد")</strong>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(req.Notes))
                            {
                                <div class="req-card-note">
                                    @(req.Notes.Length > 100 ? req.Notes[..100] + "..." : req.Notes)
                                </div>
                            }

                            <!-- Actions -->
                            <div class="req-card-actions">
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                           EndIcon="@Icons.Material.Filled.ArrowBack"
                                           OnClick='() => Navigation.NavigateTo($"/admin/b2b/requests/{req.RequestId}")'>
                                    فتح التفاصيل
                                </MudButton>

                                @if (req.Status == B2BRequestStatuses.New)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Visibility"
                                               OnClick='() => UpdateStatusAsync(req.RequestId, B2BRequestStatuses.UnderReview)'>
                                        مراجعة
                                    </MudButton>
                                }

                                @if (req.Status == B2BRequestStatuses.New || req.Status == B2BRequestStatuses.UnderReview)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Check"
                                               OnClick='() => UpdateStatusAsync(req.RequestId, B2BRequestStatuses.Converted)'>
                                        تحويل
                                    </MudButton>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-state-visual">🔍</div>
                    <strong>لا توجد طلبات مطابقة</strong>
                    <p>جرّب تغيير كلمات البحث أو اختيار حالة أخرى من الفلاتر.</p>
                </div>
            }
        </section>
    </div>
}

<style>
    :root {
        --surface: #ffffff;
        --border: #e4eaf3;
        --text: #0f172a;
        --muted: #64748b;
        --primary: #2563eb;
        --primary-light: #dbeafe;
        --r-xl: 28px;
        --r-lg: 22px;
        --r-md: 16px;
        --sh-sm: 0 4px 14px rgba(15,23,42,.04);
        --sh-md: 0 12px 30px rgba(15,23,42,.06);
        --sh-lg: 0 20px 50px rgba(15,23,42,.10);
    }

    .b2b-loading { min-height: 55vh; display: flex; align-items: center; justify-content: center; }
    .loading-shell { display: flex; align-items: center; gap: 1rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-xl); padding: 1.4rem 1.6rem; box-shadow: var(--sh-lg); }
    .loading-text { display: flex; flex-direction: column; gap: .12rem; }
    .loading-text strong { color: var(--text); font-size: .95rem; }
    .loading-text span { color: var(--muted); font-size: .82rem; }

    .admin-requests-page { display: flex; flex-direction: column; gap: 1rem; padding: .15rem; }

    /* ══ HERO ══ */
    .hero-panel {
        position: relative; overflow: hidden;
        border-radius: var(--r-xl); padding: 1rem 1.2rem;
        color: #fff;
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #2563eb 100%);
        display: flex; align-items: center; justify-content: space-between;
        gap: 1rem; flex-wrap: wrap;
        box-shadow: 0 16px 42px rgba(15,23,42,.20);
    }

    .hero-glow { position: absolute; border-radius: 50%; filter: blur(70px); opacity: .3; pointer-events: none; }
    .hero-glow.g1 { width: 180px; height: 180px; top: -50px; right: -25px; background: radial-gradient(circle, #60a5fa, transparent); }
    .hero-glow.g2 { width: 140px; height: 140px; bottom: -40px; left: -15px; background: radial-gradient(circle, #34d399, transparent); }

    .hero-body { position: relative; z-index: 1; display: flex; align-items: center; gap: .85rem; flex: 1; flex-wrap: wrap; }
    .hero-icon-wrap {
        width: 50px; height: 50px; border-radius: var(--r-md);
        background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.16);
        display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #dbeafe;
    }
    .hero-text { flex: 1; min-width: 200px; }
    .hero-chip {
        display: inline-flex; align-items: center; gap: .4rem;
        padding: .28rem .7rem; border-radius: 999px;
        background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.14);
        font-size: .7rem; font-weight: 800; margin-bottom: .35rem;
    }
