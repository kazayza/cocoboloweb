@code {
    private bool _isLoading = true;
    private bool _showInternalCreate;
    private string? _statusFilter;
    private string _searchText = string.Empty;
    private string _currentUserName = "system";
    private List<B2BRequestListDto> _allRequests = new();
    private List<B2BLookupDto> _employees = new();
    private List<B2BLookupDto> _partyPortalUsers = new();
    private B2BLookupDto? _selectedParty;
    private List<IBrowserFile> _internalFiles = new();
    private B2BInternalCreateRequestDto _internalCreate = new()
    {
        RequestSource = "Internal",
        RequestType = B2BRequestTypes.Quotation,
        Items = new List<B2BRequestItemInputDto> { new() { Quantity = 1 } }
    };

    private readonly List<StatusFilterVm> _statusFilters =
    [
        new("All", "الكل"),
        new(B2BRequestStatuses.New, "جديد"),
        new(B2BRequestStatuses.UnderReview, "قيد المراجعة"),
        new(B2BRequestStatuses.Converted, "محوّل"),
        new(B2BRequestStatuses.Closed, "مغلق"),
        new(B2BRequestStatuses.Rejected, "مرفوض")
    ];

    private IEnumerable<B2BRequestListDto> FilteredRequests => _allRequests.Where(x =>
        (string.IsNullOrWhiteSpace(_searchText)
            || x.PartyName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            || x.PortalUserName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            || x.RequestId.ToString().Contains(_searchText, StringComparison.OrdinalIgnoreCase))
        && (string.IsNullOrWhiteSpace(_statusFilter) || x.Status == _statusFilter));

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        if (!B2BPermissions.CanManage(user))
        {
            Snackbar.Add("ليس لديك صلاحية متابعة طلبات B2B", Severity.Error);
            Navigation.NavigateTo("/");
            return;
        }

        _currentUserName = user.Identity?.Name ?? "system";
        _employees = await PortalUserService.GetEmployeeLookupsAsync();
        await LoadAsync();
        _isLoading = false;
    }

    private async Task LoadAsync()
    {
        _allRequests = await RequestService.GetRequestsAsync();
    }

    private void ToggleCreateInternal() => _showInternalCreate = !_showInternalCreate;

    private async Task<IEnumerable<B2BLookupDto>> SearchPartiesAsync(string? value, CancellationToken token)
    {
        try { return await PortalUserService.SearchPartyLookupsAsync(value, 20); }
        catch { return Enumerable.Empty<B2BLookupDto>(); }
    }

    private async Task OnInternalPartyChanged(B2BLookupDto? item)
    {
        _selectedParty = item;
        _internalCreate.PartyId = item?.Id;
        _internalCreate.PortalUserId = null;
        _partyPortalUsers = item is null ? new() : await PortalUserService.GetPortalUserLookupsByPartyAsync(item.Id);
    }

    private bool SupportsItems(string type)
        => type is B2BRequestTypes.Quotation or B2BRequestTypes.Reorder;

    private void AddInternalItemLine() => _internalCreate.Items.Add(new B2BRequestItemInputDto { Quantity = 1 });

    private void RemoveInternalItemLine(int index)
    {
        if (index >= 0 && index < _internalCreate.Items.Count)
            _internalCreate.Items.RemoveAt(index);
    }

    private async Task<IEnumerable<B2BProductLookupDto>> SearchProductsAsync(string? value, CancellationToken token)
    {
        try { return await RequestService.SearchProductsAsync(value, 50); }
        catch { return Enumerable.Empty<B2BProductLookupDto>(); }
    }

    private Task OnInternalProductChanged(int index, B2BProductLookupDto? product)
    {
        if (index < 0 || index >= _internalCreate.Items.Count) return Task.CompletedTask;
        _internalCreate.Items[index].SelectedProduct = product;
        _internalCreate.Items[index].ProductId = product?.ProductId;
        return Task.CompletedTask;
    }

    private Task OnInternalFilesChanged(InputFileChangeEventArgs e)
    {
        _internalFiles = e.GetMultipleFiles(10).ToList();
        return Task.CompletedTask;
    }

    private void ResetInternalForm()
    {
        _selectedParty = null;
        _partyPortalUsers = new();
        _internalFiles = new();
        _internalCreate = new B2BInternalCreateRequestDto
        {
            RequestSource = "Internal",
            RequestType = B2BRequestTypes.Quotation,
            Items = new List<B2BRequestItemInputDto> { new() { Quantity = 1 } }
        };
    }

    private async Task CreateInternalAsync()
    {
        if (!_internalCreate.PartyId.HasValue)
        {
            Snackbar.Add("اختر العميل أولاً", Severity.Warning);
            return;
        }

        var hasItems = _internalCreate.Items.Any(i => i.ProductId.HasValue || !string.IsNullOrWhiteSpace(i.Notes));
        if (SupportsItems(_internalCreate.RequestType) && !hasItems)
        {
            Snackbar.Add("أضف بندًا واحدًا على الأقل للطلب الداخلي.", Severity.Warning);
            return;
        }

        if (!SupportsItems(_internalCreate.RequestType) && string.IsNullOrWhiteSpace(_internalCreate.Notes))
        {
            Snackbar.Add("اكتب ملخص الطلب قبل الحفظ.", Severity.Warning);
            return;
        }

        var result = await RequestService.CreateInternalAsync(_internalCreate, _currentUserName);
        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
        if (!result.Success) return;

        if (result.Id.HasValue && _internalFiles.Any())
        {
            var upload = await RequestService.UploadAttachmentsAsync(result.Id.Value, _internalFiles, _currentUserName);
            Snackbar.Add(upload.Message, upload.Success ? Severity.Success : Severity.Warning);
        }

        await LoadAsync();
        var createdId = result.Id;
        ResetInternalForm();
        _showInternalCreate = false;
        if (createdId.HasValue)
            Navigation.NavigateTo($"/admin/b2b/requests/{createdId.Value}");
    }

    private async Task OnStatusChanged(string? value)
    {
        _statusFilter = value;
        await Task.CompletedTask;
    }

    private async Task UpdateStatusAsync(int requestId, string status)
    {
        var (success, message) = await RequestService.UpdateStatusAsync(requestId, status, _currentUserName);
        Snackbar.Add(message, success ? Severity.Success : Severity.Error);
        if (success)
            await LoadAsync();
    }

    private int GetFilterCount(string key) =>
        key == "All" ? _allRequests.Count : _allRequests.Count(x => x.Status == key);

    private static string GetRequestSourceText(string value) => value switch
    {
        "Portal" => "من البوابة",
        "Internal" => "داخلي",
        "Phone" => "هاتف",
        "WhatsApp" => "واتساب",
        _ => value
    };

    private static string GetPortalUserDisplay(B2BRequestListDto req)
        => !string.IsNullOrWhiteSpace(req.PortalUserName)
            ? req.PortalUserName
            : "تم إنشاؤه بواسطة الموظف";

    private static string GetContactDisplay(B2BRequestListDto req)
        => string.Join(" — ", new[] { req.RequestedContactName, req.RequestedContactPhone }.Where(x => !string.IsNullOrWhiteSpace(x)));

    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024) return $"{bytes / 1024d / 1024d:F1} MB";
        if (bytes >= 1024) return $"{bytes / 1024d:F0} KB";
        return $"{bytes} B";
    }

    private static int GetProgressPercent(string status) => status switch
    {
        B2BRequestStatuses.New => 20,
        B2BRequestStatuses.UnderReview => 50,
        B2BRequestStatuses.Converted => 100,
        B2BRequestStatuses.Closed => 100,
        B2BRequestStatuses.Rejected => 100,
        _ => 10
    };

    private static string GetRequestTypeText(string v) => v switch
    {
        B2BRequestTypes.Quotation => "طلب عرض سعر",
        B2BRequestTypes.Reorder => "إعادة طلب",
        B2BRequestTypes.PaymentProof => "إثبات دفع",
        B2BRequestTypes.Support => "دعم / استفسار",
        _ => v
    };

    private static string GetRequestStatusText(string v) => v switch
    {
        B2BRequestStatuses.New => "جديد",
        B2BRequestStatuses.UnderReview => "تحت المراجعة",
        B2BRequestStatuses.Converted => "تم التحويل",
        B2BRequestStatuses.Closed => "مغلق",
        B2BRequestStatuses.Rejected => "مرفوض",
        _ => v
    };

    private static string GetStatusClass(string v) => v switch
    {
        B2BRequestStatuses.New => "new",
        B2BRequestStatuses.UnderReview => "review",
        B2BRequestStatuses.Converted => "converted",
        B2BRequestStatuses.Closed => "closed",
        B2BRequestStatuses.Rejected => "rejected",
        _ => "closed"
    };

    private sealed record StatusFilterVm(string Key, string Title);
}