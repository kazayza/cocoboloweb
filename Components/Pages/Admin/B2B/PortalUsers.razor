@page "/admin/b2b/portal-users"

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject IB2BPortalUserService UserService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>مستخدمي بوابة B2B</PageTitle>

@if (_isLoading)
{
    <div class="b2b-loading">
        <div class="loading-shell">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <div class="loading-text">
                <strong>جاري تحميل المستخدمين</strong>
                <span>يرجى الانتظار لحظات...</span>
            </div>
        </div>
    </div>
}
else
{
    <div dir="rtl" class="admin-users-page">

        <!-- ══════════════ HERO ══════════════ -->
        <section class="hero-panel">
            <div class="hero-glow g1"></div>
            <div class="hero-glow g2"></div>

            <div class="hero-body">
                <div class="hero-icon-wrap">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </div>
                <div class="hero-text">
                    <div class="hero-chip">
                        <span class="chip-dot"></span>
                        إدارة داخلية
                    </div>
                    <h1>مستخدمي بوابة B2B</h1>
                    <p>إدارة حسابات العملاء المرتبطة بالبوابة وربطها بالموظف المسئول.</p>
                </div>
            </div>

            <div class="hero-side">
                <div class="hero-metrics-row">
                    <div class="h-metric">
                        <strong>@_users.Count</strong>
                        <span>إجمالي</span>
                    </div>
                    <div class="h-metric-sep"></div>
                    <div class="h-metric">
                        <strong>@_users.Count(x => x.IsActive)</strong>
                        <span>نشط</span>
                    </div>
                    <div class="h-metric-sep"></div>
                    <div class="h-metric">
                        <strong>@_users.Count(x => !x.IsActive)</strong>
                        <span>موقوف</span>
                    </div>
                </div>

                <button class="hero-action-btn" @onclick="NewUser">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    حساب جديد
                </button>
            </div>
        </section>

        <!-- ══════════════ KPIs ══════════════ -->
        <section class="kpi-strip">
            <div class="kpi-card kpi-blue">
                <div class="kpi-icon-wrap">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <div class="kpi-info"><span>إجمالي المستخدمين</span><strong>@_users.Count</strong></div>
            </div>
            <div class="kpi-card kpi-green">
                <div class="kpi-icon-wrap">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20,6 9,17 4,12"/></svg>
                </div>
                <div class="kpi-info"><span>حسابات نشطة</span><strong>@_users.Count(x => x.IsActive)</strong></div>
            </div>
            <div class="kpi-card kpi-red">
                <div class="kpi-icon-wrap">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                </div>
                <div class="kpi-info"><span>حسابات موقوفة</span><strong>@_users.Count(x => !x.IsActive)</strong></div>
            </div>
            <div class="kpi-card kpi-amber">
                <div class="kpi-icon-wrap">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
                </div>
                <div class="kpi-info"><span>دخلوا مؤخرًا</span><strong>@_users.Count(x => x.LastLogin.HasValue && x.LastLogin.Value > DateTime.Now.AddDays(-7))</strong></div>
            </div>
        </section>

        <!-- ══════════════ USERS LIST ══════════════ -->
        <section class="users-surface">
            <div class="surface-header">
                <div class="surface-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                </div>
                <div>
                    <h3>قائمة المستخدمين</h3>
                    <p>جميع الحسابات المسجلة في بوابة العملاء B2B.</p>
                </div>
            </div>

            <!-- Search -->
            <div class="users-toolbar">
                <MudTextField T="string" @bind-Value="_searchText"
                              Placeholder="ابحث بالاسم، اسم المستخدم، أو العميل..."
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true" Immediate="true" />

                <div class="filter-chips">
                    <button type="button" class='filter-chip @(_activeFilter == null ? "active" : "")' @onclick="() => _activeFilter = null">الكل <b>@_users.Count</b></button>
                    <button type="button" class='filter-chip @(_activeFilter == true ? "active" : "")' @onclick="() => _activeFilter = true">نشط <b>@_users.Count(x => x.IsActive)</b></button>
                    <button type="button" class='filter-chip @(_activeFilter == false ? "active" : "")' @onclick="() => _activeFilter = false">موقوف <b>@_users.Count(x => !x.IsActive)</b></button>
                </div>
            </div>

            @{
                var filtered = FilteredUsers.ToList();
            }

            @if (filtered.Any())
            {
                <div class="results-header">
                    <span>عرض <b>@filtered.Count</b> من <b>@_users.Count</b> مستخدم</span>
                </div>

                <div class="users-grid">
                    @foreach (var user in filtered)
                    {
                        <div class='user-card @(user.IsActive ? "active-user" : "inactive-user")'>
                            <div class="user-card-top">
                                <div class="user-avatar">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                </div>
                                <div class="user-info">
                                    <strong>@user.FullName</strong>
                                    <small>@@@user.UserName</small>
                                </div>
                                <span class='user-status @(user.IsActive ? "active" : "inactive")'>
                                    @(user.IsActive ? "نشط" : "موقوف")
                                </span>
                            </div>

                            <div class="user-card-meta">
                                <div class="meta-chip">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                    @user.PartyName
                                </div>
                                @if (!string.IsNullOrWhiteSpace(user.ResponsibleEmployeeName))
                                {
                                    <div class="meta-chip employee">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                                        @user.ResponsibleEmployeeName
                                    </div>
                                }
                            </div>

                            <div class="user-card-details">
                                @if (user.LastLogin.HasValue)
                                {
                                    <div class="detail-chip">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
                                        آخر دخول: @user.LastLogin.Value.ToString("yyyy/MM/dd HH:mm")
                                    </div>
                                }
                                else
                                {
                                    <div class="detail-chip muted">لم يسجل دخول بعد</div>
                                }
                            </div>

                            <!-- Permissions -->
                            <div class="user-permissions">
                                <span class='perm-chip @(user.CanViewPrices ? "on" : "off")'>الأسعار</span>
                                <span class='perm-chip @(user.CanViewFinancials ? "on" : "off")'>المالية</span>
                                <span class='perm-chip @(user.CanRequestQuotation ? "on" : "off")'>طلبات</span>
                                <span class='perm-chip @(user.CanUploadPaymentProof ? "on" : "off")'>إثبات دفع</span>
                            </div>

                            <div class="user-card-actions">
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Edit"
                                           OnClick='() => EditUserAsync(user.PortalUserId)'>
                                    تعديل
                                </MudButton>
                                <MudButton Variant="Variant.Text"
                                           Color="@(user.IsActive ? Color.Error : Color.Success)"
                                           Size="Size.Small"
                                           StartIcon="@(user.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)"
                                           OnClick='() => ToggleUserAsync(user.PortalUserId, !user.IsActive)'>
                                    @(user.IsActive ? "إيقاف" : "تفعيل")
                                </MudButton>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-state-visual">👥</div>
                    <strong>لا توجد نتائج مطابقة</strong>
                    <p>جرّب تغيير كلمات البحث أو اختيار فلتر آخر.</p>
                </div>
            }
        </section>

        <!-- ══════════════ FORM ══════════════ -->
        @if (_showForm)
        {
            <section class="form-surface">
                <div class="surface-header">
                    <div class="surface-icon form-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            @if (_form.PortalUserId > 0)
                            {
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                            }
                            else
                            {
                                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/>
                            }
                        </svg>
                    </div>
                    <div>
                        <h3>@(_form.PortalUserId > 0 ? "تعديل حساب" : "إنشاء حساب جديد")</h3>
                        <p>@(_form.PortalUserId > 0 ? "عدّل بيانات الحساب والصلاحيات." : "أنشئ حساب بوابة جديد للعميل.")</p>
                    </div>
                </div>

                <!-- Party + Employee -->
                <div class="form-section">
                    <div class="form-section-label">
                        <span class="section-badge blue">1</span>
                        <strong>العميل والموظف المسئول</strong>
                    </div>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <div class="party-search-box">
                                <MudAutocomplete T="B2BLookupDto"
                                                 Value="_selectedParty"
                                                 ValueChanged="OnPartyChanged"
                                                 SearchFunc="SearchPartiesAsync"
                                                 ToStringFunc="@(x => x?.Name ?? string.Empty)"
                                                 Label="ابحث عن العميل"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 Clearable="true" ResetValueOnEmptyText="true" CoerceText="false"
                                                 Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search">
                                    <ItemTemplate Context="item">
                                        <div class="lookup-item">
                                            <strong>@item.Name</strong>
                                            <small>كود: @item.Id</small>
                                        </div>
                                    </ItemTemplate>
                                </MudAutocomplete>
                                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.PersonAdd"
                                           OnClick='() => Navigation.NavigateTo("/customers/form")'>
                                    عميل جديد
                                </MudButton>
                            </div>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSelect T="int?" Label="الموظف المسئول" @bind-Value="_form.ResponsibleEmployeeId"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                                @foreach (var emp in _employees)
                                {
                                    <MudSelectItem Value="@((int?)emp.Id)">@emp.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </div>

                <!-- Account info -->
                <div class="form-section">
                    <div class="form-section-label">
                        <span class="section-badge green">2</span>
                        <strong>بيانات الحساب</strong>
                    </div>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="الاسم الكامل" @bind-Value="_form.FullName" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="اسم المستخدم" @bind-Value="_form.UserName" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="كلمة المرور" @bind-Value="_form.Password"
                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                          HelperText="@(_form.PortalUserId > 0 ? "اتركها فارغة لعدم التغيير" : "")" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="الموبايل" @bind-Value="_form.Mobile" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="البريد الإلكتروني" @bind-Value="_form.Email" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>
                </div>

                <!-- Permissions -->
                <div class="form-section">
                    <div class="form-section-label">
                        <span class="section-badge amber">3</span>
                        <strong>الصلاحيات والحالة</strong>
                    </div>

                    <div class="permissions-grid">
                        <div class='perm-toggle @(_form.IsActive ? "on" : "off")' @onclick="() => _form.IsActive = !_form.IsActive">
                            <div class="perm-toggle-dot"></div>
                            <div class="perm-toggle-text">
                                <strong>الحساب نشط</strong>
                                <small>@(_form.IsActive ? "المستخدم يمكنه الدخول" : "الحساب موقوف")</small>
                            </div>
                        </div>

                        <div class='perm-toggle @(_form.CanViewPrices ? "on" : "off")' @onclick="() => _form.CanViewPrices = !_form.CanViewPrices">
                            <div class="perm-toggle-dot"></div>
                            <div class="perm-toggle-text">
                                <strong>يشاهد الأسعار</strong>
                                <small>عرض الأسعار في الكتالوج</small>
                            </div>
                        </div>

                        <div class='perm-toggle @(_form.CanViewFinancials ? "on" : "off")' @onclick="() => _form.CanViewFinancials = !_form.CanViewFinancials">
                            <div class="perm-toggle-dot"></div>
                            <div class="perm-toggle-text">
                                <strong>يشاهد البيانات المالية</strong>
                                <small>الفواتير والأرصدة</small>
                            </div>
                        </div>

                        <div class='perm-toggle @(_form.CanRequestQuotation ? "on" : "off")' @onclick="() => _form.CanRequestQuotation = !_form.CanRequestQuotation">
                            <div class="perm-toggle-dot"></div>
                            <div class="perm-toggle-text">
                                <strong>ينشئ طلبات عروض</strong>
                                <small>إرسال طلبات عروض أسعار</small>
                            </div>
                        </div>

                        <div class='perm-toggle @(_form.CanUploadPaymentProof ? "on" : "off")' @onclick="() => _form.CanUploadPaymentProof = !_form.CanUploadPaymentProof">
                            <div class="perm-toggle-dot"></div>
                            <div class="perm-toggle-text">
                                <strong>يرفع إثبات دفع</strong>
                                <small>إرسال تفاصيل التحويلات</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="form-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium"
                               StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">
                        @(_form.PortalUserId > 0 ? "حفظ التعديلات" : "إنشاء الحساب")
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Medium"
                               StartIcon="@Icons.Material.Filled.Close" OnClick="CancelForm">
                        إلغاء
                    </MudButton>
                </div>
            </section>
        }
    </div>
}

<style>
    :root {
        --surface:#ffffff;--border:#e4eaf3;--text:#0f172a;--muted:#64748b;
        --primary:#2563eb;--primary-light:#dbeafe;
        --r-xl:28px;--r-lg:22px;--r-md:16px;
        --sh-sm:0 4px 14px rgba(15,23,42,.04);--sh-md:0 12px 30px rgba(15,23,42,.06);--sh-lg:0 20px 50px rgba(15,23,42,.10);
    }

    .b2b-loading{min-height:55vh;display:flex;align-items:center;justify-content:center}
    .loading-shell{display:flex;align-items:center;gap:1rem;background:var(--surface);border:1px solid var(--border);border-radius:var(--r-xl);padding:1.4rem 1.6rem;box-shadow:var(--sh-lg)}
    .loading-text{display:flex;flex-direction:column;gap:.12rem}
    .loading-text strong{color:var(--text);font-size:.95rem}.loading-text span{color:var(--muted);font-size:.82rem}

    .admin-users-page{display:flex;flex-direction:column;gap:1rem;padding:.15rem}

    /* ══ HERO ══ */
    .hero-panel{position:relative;overflow:hidden;border-radius:var(--r-xl);padding:1rem 1.2rem;color:#fff;background:linear-gradient(135deg,#0f172a 0%,#1e3a8a 50%,#2563eb 100%);display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;box-shadow:0 16px 42px rgba(15,23,42,.20)}
    .hero-glow{position:absolute;border-radius:50%;filter:blur(70px);opacity:.3;pointer-events:none}
    .hero-glow.g1{width:180px;height:180px;top:-50px;right:-25px;background:radial-gradient(circle,#60a5fa,transparent)}
    .hero-glow.g2{width:140px;height:140px;bottom:-40px;left:-15px;background:radial-gradient(circle,#34d399,transparent)}

    .hero-body{position:relative;z-index:1;display:flex;align-items:center;gap:.85rem;flex:1;flex-wrap:wrap}
    .hero-icon-wrap{width:50px;height:50px;border-radius:var(--r-md);background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.16);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#dbeafe}
    .hero-text{flex:1;min-width:200px}
    .hero-chip{display:inline-flex;align-items:center;gap:.4rem;padding:.28rem .7rem;border-radius:999px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.14);font-size:.7rem;font-weight:800;margin-bottom:.35rem}
    .chip-dot{width:7px;height:7px;border-radius:50%;background:#34d399;animation:pulse-dot 2s infinite}
    @@keyframes pulse-dot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(1.5)}}
    .hero-text h1{margin:0;font-size:1.3rem;font-weight:900;line-height:1.2}
    .hero-text p{margin:.25rem 0 0;color:#bfdbfe;font-size:.84rem;line-height:1.6}

    .hero-side{position:relative;z-index:1;display:flex;flex-direction:column;gap:.6rem;align-items:flex-end}

    .hero-metrics-row{display:flex;align-items:center;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:var(--r-lg);backdrop-filter:blur(8px);overflow:hidden}
    .h-metric{flex:1;display:flex;flex-direction:column;align-items:center;padding:.55rem .5rem;min-width:65px}
    .h-metric strong{font-size:1.2rem;font-weight:900;line-height:1}
    .h-metric span{margin-top:.15rem;color:#bfdbfe;font-size:.68rem;font-weight:700}
    .h-metric-sep{width:1px;height:28px;background:rgba(255,255,255,.14);flex-shrink:0}

    .hero-action-btn{display:inline-flex;align-items:center;gap:.4rem;padding:.5rem .9rem;border-radius:14px;background:#fff;color:#0f172a;font-family:inherit;font-size:.82rem;font-weight:800;border:none;cursor:pointer;transition:.2s ease;box-shadow:0 8px 20px rgba(0,0,0,.12)}
    .hero-action-btn:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(0,0,0,.16)}

    /* ══ KPIs ══ */
    .kpi-strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(195px,1fr));gap:.8rem}
    .kpi-card{display:flex;align-items:center;gap:.75rem;background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);padding:.85rem .95rem;box-shadow:var(--sh-sm);transition:.22s ease}
    .kpi-card:hover{transform:translateY(-2px);box-shadow:var(--sh-md)}
    .kpi-icon-wrap{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .kpi-blue .kpi-icon-wrap{background:#dbeafe;color:#2563eb}.kpi-green .kpi-icon-wrap{background:#d1fae5;color:#059669}
    .kpi-red .kpi-icon-wrap{background:#fee2e2;color:#dc2626}.kpi-amber .kpi-icon-wrap{background:#fef3c7;color:#d97706}
    .kpi-info{display:flex;flex-direction:column}.kpi-info span{color:var(--muted);font-size:.78rem;margin-bottom:.1rem}.kpi-info strong{color:var(--text);font-size:1.25rem;line-height:1}

    /* ══ USERS SURFACE ══ */
    .users-surface{background:rgba(255,255,255,.96);border:1px solid var(--border);border-radius:var(--r-xl);padding:1.2rem;box-shadow:var(--sh-md)}
    .surface-header{display:flex;align-items:flex-start;gap:.7rem;margin-bottom:.85rem}
    .surface-icon{width:40px;height:40px;border-radius:12px;background:#f1f5f9;color:var(--muted);display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .form-icon{background:#dbeafe;color:#2563eb}
    .surface-header h3{margin:0;color:var(--text);font-size:1rem;font-weight:900}
    .surface-header p{margin:.15rem 0 0;color:var(--muted);font-size:.82rem}

    .users-toolbar{display:flex;flex-direction:column;gap:.7rem;margin-bottom:.9rem}
    .users-toolbar .mud-input-control{max-width:500px}

    .filter-chips{display:flex;gap:.5rem;flex-wrap:wrap}
    .filter-chip{display:inline-flex;align-items:center;gap:.4rem;border:1px solid var(--border);background:var(--surface);color:#334155;border-radius:999px;padding:.4rem .7rem;font-family:inherit;cursor:pointer;font-size:.78rem;font-weight:800;transition:.2s ease}
    .filter-chip:hover{transform:translateY(-1px);border-color:#c0cee0}
    .filter-chip.active{background:var(--text);color:#fff;border-color:var(--text);box-shadow:0 8px 16px rgba(15,23,42,.12)}
    .filter-chip b{min-width:20px;height:20px;padding:0 .3rem;border-radius:999px;display:inline-flex;align-items:center;justify-content:center;background:#f1f5f9;color:var(--text);font-size:.66rem;font-weight:900}
    .filter-chip.active b{background:rgba(255,255,255,.15);color:#fff}

    .results-header{margin-bottom:.7rem;color:var(--muted);font-size:.82rem}.results-header b{color:var(--text)}

    /* ── User cards ── */
    .users-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:.9rem}

    .user-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-xl);padding:.95rem;display:flex;flex-direction:column;gap:.6rem;box-shadow:var(--sh-sm);transition:.25s ease}
    .user-card:hover{transform:translateY(-3px);box-shadow:var(--sh-lg)}
    .user-card.active-user{border-top:4px solid #10b981}
    .user-card.inactive-user{border-top:4px solid #94a3b8;opacity:.85}

    .user-card-top{display:flex;align-items:center;gap:.7rem}
    .user-avatar{width:40px;height:40px;border-radius:12px;background:#f1f5f9;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--muted)}
    .user-info{flex:1;display:flex;flex-direction:column}
    .user-info strong{color:var(--text);font-size:.9rem}
    .user-info small{color:var(--muted);font-size:.76rem}

    .user-status{display:inline-flex;padding:.22rem .55rem;border-radius:999px;font-size:.66rem;font-weight:900}
    .user-status.active{background:#d1fae5;color:#047857}
    .user-status.inactive{background:#e2e8f0;color:#475569}

    .user-card-meta{display:flex;gap:.4rem;flex-wrap:wrap}
    .meta-chip{display:inline-flex;align-items:center;gap:.3rem;padding:.32rem .5rem;border-radius:10px;background:#f8fafc;border:1px solid #edf2f7;color:var(--muted);font-size:.72rem}
    .meta-chip.employee{background:#eff6ff;border-color:#dbeafe;color:#1d4ed8}

    .user-card-details{display:flex;gap:.4rem;flex-wrap:wrap}
    .detail-chip{display:inline-flex;align-items:center;gap:.3rem;font-size:.72rem;color:var(--muted);padding:.3rem .5rem;border-radius:8px;background:#f8fafc;border:1px solid #edf2f7}
    .detail-chip.muted{color:#94a3b8;font-style:italic}

    .user-permissions{display:flex;gap:.35rem;flex-wrap:wrap}
    .perm-chip{padding:.2rem .45rem;border-radius:8px;font-size:.66rem;font-weight:800}
    .perm-chip.on{background:#d1fae5;color:#047857}
    .perm-chip.off{background:#f1f5f9;color:#94a3b8;text-decoration:line-through}

    .user-card-actions{display:flex;gap:.35rem;flex-wrap:wrap;padding-top:.4rem;border-top:1px solid #f1f5f9}

    /* ══ FORM ══ */
    .form-surface{background:rgba(255,255,255,.96);border:1px solid var(--border);border-radius:var(--r-xl);padding:1.2rem;box-shadow:var(--sh-md)}

    .form-section{margin-bottom:1rem;padding:1rem;border:1px solid #edf2f7;border-radius:var(--r-lg);background:#fbfdff}
    .form-section-label{display:flex;align-items:center;gap:.6rem;margin-bottom:.75rem}
    .section-badge{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:900;flex-shrink:0;color:#fff}
    .section-badge.blue{background:#2563eb}.section-badge.green{background:#059669}.section-badge.amber{background:#d97706}
    .form-section-label strong{color:var(--text);font-size:.92rem}

    .party-search-box{display:flex;flex-direction:column;gap:.55rem}

    .lookup-item{display:flex;flex-direction:column;gap:2px}
    .lookup-item strong{color:var(--text);font-size:.86rem}
    .lookup-item small{color:var(--muted);font-size:.72rem}

    /* ── Permission toggles ── */
    .permissions-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:.6rem}

    .perm-toggle{display:flex;align-items:center;gap:.65rem;padding:.7rem .85rem;border-radius:14px;border:1.5px solid var(--border);background:var(--surface);cursor:pointer;transition:.22s ease}
    .perm-toggle:hover{transform:translateY(-1px);box-shadow:var(--sh-sm)}
    .perm-toggle.on{border-color:#6ee7b7;background:#f0fdf4}
    .perm-toggle.off{border-color:#e2e8f0;background:#f8fafc}

    .perm-toggle-dot{width:14px;height:14px;border-radius:50%;flex-shrink:0;border:2px solid #cbd5e1;transition:.2s ease}
    .perm-toggle.on .perm-toggle-dot{background:#10b981;border-color:#10b981;box-shadow:0 0 0 3px rgba(16,185,129,.15)}
    .perm-toggle.off .perm-toggle-dot{background:#e2e8f0;border-color:#cbd5e1}

    .perm-toggle-text{display:flex;flex-direction:column}
    .perm-toggle-text strong{color:var(--text);font-size:.84rem}
    .perm-toggle-text small{color:var(--muted);font-size:.72rem}

    .form-actions{display:flex;gap:.65rem;align-items:center;flex-wrap:wrap;padding-top:1rem;border-top:1px solid #edf2f7;margin-top:.5rem}

    /* ── Empty ── */
    .empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.5rem;padding:2rem 1rem;text-align:center;border-radius:var(--r-xl);background:linear-gradient(180deg,#fbfdff,#f8fafc);border:1.5px dashed #d8e2ec}
    .empty-state-visual{font-size:1.8rem;margin-bottom:.2rem}
    .empty-state strong{color:var(--text);font-size:.95rem}
    .empty-state p{margin:0;color:var(--muted);font-size:.85rem}

    /* ── Responsive ── */
    @@media(max-width:960px){.hero-panel{padding:.9rem 1rem}.hero-text h1{font-size:1.15rem}}
    @@media(max-width:700px){
        .hero-panel,.users-surface,.form-surface{border-radius:var(--r-lg);padding:.9rem}
        .hero-body,.hero-side{flex-direction:column;align-items:flex-start}
        .hero-side{width:100%;align-items:stretch}
        .hero-metrics-row{width:100%}
        .hero-action-btn{width:100%;justify-content:center}
        .users-toolbar .mud-input-control{max-width:100%}
        .user-card-actions{flex-direction:column}
        .user-card-actions .mud-button-root{width:100%}
        .permissions-grid{grid-template-columns:1fr}
        .form-actions{flex-direction:column}
        .form-actions .mud-button-root{width:100%}
    }
</style>

@code {
    private bool _isLoading = true;
    private bool _showForm;
    private string _currentUserName = "system";
    private string _searchText = string.Empty;
    private bool? _activeFilter;
    private List<B2BPortalUserListDto> _users = new();
    private List<B2BLookupDto> _employees = new();
    private B2BPortalUserFormDto _form = new();
    private B2BLookupDto? _selectedParty;

    private IEnumerable<B2BPortalUserListDto> FilteredUsers => _users.Where(u =>
    {
        if (_activeFilter.HasValue && u.IsActive != _activeFilter.Value) return false;
        if (string.IsNullOrWhiteSpace(_searchText)) return true;
        var t = _searchText.Trim();
        return u.FullName.Contains(t, StringComparison.OrdinalIgnoreCase)
            || u.UserName.Contains(t, StringComparison.OrdinalIgnoreCase)
            || u.PartyName.Contains(t, StringComparison.OrdinalIgnoreCase);
    });

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        if (!B2BPermissions.CanManage(user))
        {
            Snackbar.Add("ليس لديك صلاحية إدارة بوابة B2B", Severity.Error);
            Navigation.NavigateTo("/");
            return;
        }

        _currentUserName = user.Identity?.Name ?? "system";
        await LoadAsync();
        _isLoading = false;
    }

    private async Task LoadAsync()
    {
        _users = await UserService.GetUsersAsync();
        _employees = await UserService.GetEmployeeLookupsAsync();
    }

    private void NewUser()
    {
        _form = new B2BPortalUserFormDto();
        _selectedParty = null;
        _showForm = true;
    }

    private async Task EditUserAsync(int id)
    {
        _form = await UserService.GetForEditAsync(id) ?? new B2BPortalUserFormDto();
        _selectedParty = _form.PartyId.HasValue
            ? await UserService.GetPartyLookupByIdAsync(_form.PartyId.Value)
            : null;
        _showForm = true;
    }

    private async Task SaveAsync()
    {
        var (success, message, _) = await UserService.SaveAsync(_form, _currentUserName);
        Snackbar.Add(message, success ? Severity.Success : Severity.Error);
        if (!success) return;
        _showForm = false;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task ToggleUserAsync(int id, bool isActive)
    {
        var (success, message) = await UserService.SetActiveAsync(id, isActive, _currentUserName);
        Snackbar.Add(message, success ? Severity.Success : Severity.Error);
        if (success) await LoadAsync();
    }

    private async Task<IEnumerable<B2BLookupDto>> SearchPartiesAsync(string? value, CancellationToken token)
    {
        try { return await UserService.SearchPartyLookupsAsync(value, 20); }
        catch { return Enumerable.Empty<B2BLookupDto>(); }
    }

    private Task OnPartyChanged(B2BLookupDto? item)
    {
        _selectedParty = item;
        _form.PartyId = item?.Id;
        return Task.CompletedTask;
    }

    private void CancelForm()
    {
        _showForm = false;
        _selectedParty = null;
        _form = new B2BPortalUserFormDto();
    }
}