@page "/admin/permissions"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@using Microsoft.EntityFrameworkCore
@using COCOBOLOERPNEW.Models
@using COCOBOLOERPNEW.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject db24804Context Db
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<div class="permissions-page">
    <div class="page-header">
        <div class="header-content">
            <div class="header-left">
                <div class="page-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Security" />
                </div>
                <div class="header-text">
                    <h1>إدارة الصلاحيات</h1>
                    <p class="subtitle">صلاحيات الشاشات، منفصلة عن الدور الوظيفي</p>
                </div>
            </div>
            <div class="header-actions">
                <MudButton Variant="Variant.Outlined" Class="link-btn" StartIcon="@Icons.Material.Rounded.VpnKey" OnClick="OpenAssign">ربط بالمستخدمين</MudButton>
                @if (HasPermission("frm_AddPermission", "Add"))
                {
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Rounded.Add" Class="add-btn" OnClick="() => OpenForm(null)">صلاحية جديدة</MudButton>
                }
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <MudAlert Severity="@(_isError ? Severity.Error : Severity.Success)" Class="mb-4">@_message</MudAlert>
    }

    <section class="filter-panel">
        <div class="filter-grid">
            <div class="field field-search">
                <span class="field-label">بحث</span>
                <div class="field-box">
                    <MudIcon Icon="@Icons.Material.Outlined.Search" Class="field-icon" />
                    <MudTextField T="string" Value="_searchText" ValueChanged="OnSearchChanged" Immediate="true" DebounceInterval="250"
                                  Placeholder="اسم الصلاحية، اسم الشاشة أو الوصف" Variant="Variant.Text" Margin="Margin.Dense" Class="bare-field" />
                </div>
            </div>
            <div class="field field-cats">
                <span class="field-label">الفئة</span>
                <div class="status-chips">
                    <button type="button" class="@(_filterCategory == "all" ? "on" : "")" @onclick="ShowAllCategories">الكل</button>
                    @foreach (var category in CategoryOptions)
                    {
                        <button type="button" class="@(_filterCategory == category.Value ? "on" : "")" @onclick="() => SetCategory(category.Value)">@category.Label</button>
                    }
                </div>
            </div>
            <div class="result-chip">
                <span>النتائج</span>
                <strong>@_filteredPermissions.Count</strong>
            </div>
        </div>
        @if (HasActiveFilters)
        {
            <div class="active-filters">
                @if (!string.IsNullOrWhiteSpace(_searchText))
                {
                    <button type="button" class="tag" @onclick="() => OnSearchChanged(string.Empty)">بحث: @_searchText <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" /></button>
                }
                @if (_filterCategory != "all")
                {
                    <button type="button" class="tag" @onclick="ShowAllCategories">الفئة: @CategoryLabel(_filterCategory) <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" /></button>
                }
                <button type="button" class="clear-all" @onclick="ClearFilters">مسح الكل</button>
            </div>
        }
    </section>

    <div class="table-container">
        @if (_isLoading)
        {
            <div class="state-box"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /> <p>جارٍ تحميل الصلاحيات...</p></div>
        }
        else if (!_filteredPermissions.Any())
        {
            <div class="state-box">
                <MudIcon Icon="@Icons.Material.Outlined.Security" Size="Size.Large" />
                <h3>لا توجد نتائج</h3>
                <p>@(HasActiveFilters ? "لا توجد صلاحية مطابقة للبحث أو الفئة." : "لا توجد صلاحيات مسجلة.")</p>
            </div>
        }
        else
        {
            <MudTable Items="_filteredPermissions" Hover="true" Breakpoint="Breakpoint.Md" RowsPerPage="20" Elevation="0" Class="permissions-table">
                <HeaderContent>
                    <MudTh>الكود</MudTh>
                    <MudTh>الصلاحية</MudTh>
                    <MudTh>الشاشة</MudTh>
                    <MudTh>الفئة</MudTh>
                    <MudTh>المستخدمون</MudTh>
                    <MudTh>الإجراءات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="الكود"><span class="perm-id">@context.PermissionId</span></MudTd>
                    <MudTd DataLabel="الصلاحية">
                        <div class="name-cell">
                            <strong>@context.PermissionName</strong>
                            <span>@(string.IsNullOrWhiteSpace(context.Description) ? "بدون وصف" : context.Description)</span>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="الشاشة"><span class="form-name">@(context.FormName ?? "—")</span></MudTd>
                    <MudTd DataLabel="الفئة"><span class="cat-badge">@CategoryLabel(context.Category)</span></MudTd>
                    <MudTd DataLabel="المستخدمون">
                        <button type="button" class="use-link" @onclick="() => OpenUsers(context)">@Usage(context.PermissionId)</button>
                    </MudTd>
                    <MudTd DataLabel="الإجراءات">
                        <div class="action-buttons">
                            @if (HasPermission("frm_AddPermission", "Edit"))
                            {
                                <MudTooltip Text="تعديل"><MudIconButton Icon="@Icons.Material.Rounded.Edit" Color="Color.Warning" Size="Size.Small" OnClick="() => OpenForm(context)" /></MudTooltip>
                            }
                            @if (HasPermission("frm_AddPermission", "Delete"))
                            {
                                <MudTooltip Text="حذف"><MudIconButton Icon="@Icons.Material.Rounded.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => OpenDeleteDialog(context)" /></MudTooltip>
                            }
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </div>
</div>

@if (_formOpen)
{
    <MudOverlay Visible="true" Class="form-overlay">
        <div class="permission-form" @onclick:stopPropagation="true">
            <div class="form-header">
                <div>
                    <h2>@(_editingPermission != null ? "تعديل صلاحية" : "صلاحية جديدة")</h2>
                    <p>الاسم الظاهر واسم الشاشة الذي يقرأه النظام</p>
                </div>
                <button type="button" class="close-btn" @onclick="CloseForm"><MudIcon Icon="@Icons.Material.Filled.Close" /></button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_formError))
            {
                <div class="form-error">@_formError</div>
            }
            <div class="form-grid">
                <div class="field">
                    <span class="field-label">اسم الصلاحية <b>*</b></span>
                    <div class="field-box">
                        <MudIcon Icon="@Icons.Material.Outlined.Label" Class="field-icon" />
                        <MudTextField @bind-Value="_formModel.PermissionName" Variant="Variant.Text" Margin="Margin.Dense" Placeholder="الاسم الظاهر للمستخدم" Class="bare-field" />
                    </div>
                </div>
                <div class="field">
                    <span class="field-label">اسم الشاشة <b>*</b></span>
                    <div class="field-box">
                        <MudIcon Icon="@Icons.Material.Outlined.Code" Class="field-icon" />
                        <MudTextField @bind-Value="_formModel.FormName" Variant="Variant.Text" Margin="Margin.Dense" Placeholder="frm_Example" Class="bare-field ltr" />
                    </div>
                    <span class="field-hint">يُحفظ كما هو، مثل frm_Users.</span>
                </div>
                <div class="field field-wide">
                    <span class="field-label">الفئة <b>*</b></span>
                    <div class="status-chips">
                        @foreach (var category in FormCategories)
                        {
                            <button type="button" class="@(_formModel.Category == category.Value ? "on" : "")" @onclick="() => _formModel.Category = category.Value">@category.Label</button>
                        }
                    </div>
                </div>
                <div class="field field-wide">
                    <span class="field-label">الوصف</span>
                    <div class="field-box tall">
                        <MudIcon Icon="@Icons.Material.Outlined.Notes" Class="field-icon" />
                        <MudTextField @bind-Value="_formModel.Description" Variant="Variant.Text" Margin="Margin.Dense" Lines="2" Placeholder="شرح مختصر لوظيفة الصلاحية" Class="bare-field" />
                    </div>
                </div>
            </div>
            <div class="account-summary">
                <span><small>الاسم</small>@(string.IsNullOrWhiteSpace(_formModel.PermissionName) ? "—" : _formModel.PermissionName)</span>
                <span><small>الشاشة</small>@(string.IsNullOrWhiteSpace(_formModel.FormName) ? "—" : _formModel.FormName)</span>
                <span><small>الفئة</small>@CategoryLabel(_formModel.Category)</span>
            </div>
            <div class="form-footer">
                <MudButton Variant="Variant.Outlined" OnClick="CloseForm" Disabled="_isSaving">إلغاء</MudButton>
                <MudButton Variant="Variant.Filled" Class="save-btn" StartIcon="@Icons.Material.Filled.Save" OnClick="SavePermission" Disabled="_isSaving">@(_isSaving ? "جارٍ الحفظ..." : _editingPermission != null ? "حفظ التعديل" : "حفظ الصلاحية")</MudButton>
            </div>
        </div>
    </MudOverlay>
}

@if (_deleteDialogOpen)
{
    <MudOverlay Visible="true" Class="form-overlay">
        <div class="delete-dialog" @onclick:stopPropagation="true">
            <MudIcon Icon="@Icons.Material.Rounded.WarningAmber" Class="dialog-icon" />
            <h2>حذف الصلاحية</h2>
            <p>هل تريد حذف <strong>@_permToDelete?.PermissionName</strong>؟</p>
            @if (_permToDelete != null && Usage(_permToDelete.PermissionId) > 0)
            {
                <p class="warning-text">مرتبطة بـ @Usage(_permToDelete.PermissionId) مستخدم. أزل الربط أولًا من شاشة ربط الصلاحيات.</p>
            }
            else
            {
                <p class="warning-text">لا يمكن التراجع عن الحذف.</p>
            }
            <div class="dialog-actions">
                <MudButton Variant="Variant.Outlined" OnClick="CancelDelete">إلغاء</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="ConfirmDelete" Disabled="@(_permToDelete != null && Usage(_permToDelete.PermissionId) > 0)">حذف</MudButton>
            </div>
        </div>
    </MudOverlay>
}

