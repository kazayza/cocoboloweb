</style>

@code {
    private static readonly (string Value, string Label)[] KnownCategories =
    {
        ("Administration", "الإدارة"),
        ("Forms", "الشاشات"),
        ("Reports", "التقارير"),
        ("Settings", "الإعدادات")
    };

    private List<Permission> _allPermissions = new();
    private List<Permission> _filteredPermissions = new();
    private Dictionary<int, int> _usage = new();
    private string _searchText = "";
    private string _filterCategory = "all";
    private ClaimsPrincipal? _currentUser;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isError;
    private string? _message;
    private string? _formError;
    private bool _formOpen;
    private Permission? _editingPermission;
    private PermissionFormModel _formModel = new();
    private bool _deleteDialogOpen;
    private Permission? _permToDelete;

    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(_searchText) || _filterCategory != "all";
    private IEnumerable<(string Value, string Label)> CategoryOptions => KnownCategories.Concat(ExtraCategories());
    private IEnumerable<(string Value, string Label)> FormCategories
    {
        get
        {
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var category in CategoryOptions)
            {
                if (seen.Add(category.Value))
                    yield return category;
            }
            if (!string.IsNullOrWhiteSpace(_formModel.Category) && seen.Add(_formModel.Category))
                yield return (_formModel.Category, CategoryLabel(_formModel.Category));
        }
    }

    private int Usage(int id) => _usage.TryGetValue(id, out var count) ? count : 0;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUser = auth.User;
        await LoadPermissions();
    }

    private async Task LoadPermissions()
    {
        _isLoading = true;
        _isError = false;
        try
        {
            _allPermissions = await Db.Permissions.AsNoTracking().OrderBy(p => p.Category).ThenBy(p => p.PermissionName).ToListAsync();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = "تعذر تحميل الصلاحيات: " + ex.Message;
        }
        try
        {
            _usage = await Db.UserPermissions.AsNoTracking()
                .GroupBy(up => up.PermissionId)
                .Select(g => new { g.Key, Count = g.Select(x => x.UserId).Distinct().Count() })
                .ToDictionaryAsync(x => x.Key, x => x.Count);
        }
        catch
        {
            _usage = new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IEnumerable<(string Value, string Label)> ExtraCategories()
    {
        var known = KnownCategories.Select(c => c.Value).ToHashSet(StringComparer.OrdinalIgnoreCase);
        return _allPermissions.Select(p => p.Category).Where(c => !string.IsNullOrWhiteSpace(c) && !known.Contains(c!)).Distinct()!.Select(c => (c!, c!));
    }

    private static string CategoryLabel(string? category)
    {
        if (string.IsNullOrWhiteSpace(category)) return "—";
        foreach (var item in KnownCategories)
            if (string.Equals(item.Value, category, StringComparison.OrdinalIgnoreCase)) return item.Label;
        return category;
    }

    private Task OnSearchChanged(string value)
    {
        _searchText = value ?? "";
        ApplyFilters();
        return Task.CompletedTask;
    }

    private void ShowAllCategories() => SetCategory("all");

    private void SetCategory(string category)
    {
        _filterCategory = string.IsNullOrWhiteSpace(category) ? "all" : category;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        IEnumerable<Permission> query = _allPermissions;
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var search = _searchText.Trim();
            query = query.Where(p =>
                (p.PermissionName ?? "").ContainsArabic(search) ||
                (p.FormName ?? "").ContainsArabic(search) ||
                (p.Description ?? "").ContainsArabic(search) ||
                CategoryLabel(p.Category).ContainsArabic(search));
        }
        if (_filterCategory != "all")
            query = query.Where(p => string.Equals(p.Category, _filterCategory, StringComparison.OrdinalIgnoreCase));
        _filteredPermissions = query.ToList();
    }

    private void ClearFilters()
    {
        _searchText = "";
        _filterCategory = "all";
        ApplyFilters();
    }

    private void OpenAssign() => Navigation.NavigateTo("/admin/permissions/manage");
    private void OpenUsers(Permission permission) => Navigation.NavigateTo($"/admin/users?permission={Uri.EscapeDataString(permission.PermissionName)}");

    private void OpenForm(Permission? permission)
    {
        _formError = null;
        _editingPermission = permission;
        _formModel = permission == null
            ? new PermissionFormModel()
            : new PermissionFormModel
            {
                PermissionName = permission.PermissionName,
                FormName = permission.FormName ?? "",
                Category = string.IsNullOrWhiteSpace(permission.Category) ? "Forms" : permission.Category,
                Description = permission.Description ?? ""
            };
        _formOpen = true;
    }

    private void CloseForm()
    {
        _formOpen = false;
        _editingPermission = null;
        _formModel = new();
        _formError = null;
    }

    private async Task SavePermission()
    {
        var name = _formModel.PermissionName?.Trim();
        var form = _formModel.FormName?.Trim();
        if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(form) || string.IsNullOrWhiteSpace(_formModel.Category))
        {
            _formError = "اسم الصلاحية واسم الشاشة والفئة مطلوبة.";
            return;
        }
        var currentId = _editingPermission?.PermissionId ?? 0;
        if (_allPermissions.Any(p => p.PermissionId != currentId && string.Equals(p.PermissionName, name, StringComparison.OrdinalIgnoreCase)))
        {
            _formError = "اسم الصلاحية موجود بالفعل.";
            return;
        }

        _isSaving = true;
        try
        {
            if (_editingPermission != null)
            {
                var entity = await Db.Permissions.FirstOrDefaultAsync(p => p.PermissionId == _editingPermission.PermissionId);
                if (entity == null) { _formError = "الصلاحية غير موجودة."; return; }
                entity.PermissionName = name;
                entity.FormName = form;
                entity.Category = _formModel.Category;
                entity.Description = string.IsNullOrWhiteSpace(_formModel.Description) ? null : _formModel.Description.Trim();
            }
            else
            {
                Db.Permissions.Add(new Permission
                {
                    PermissionName = name,
                    FormName = form,
                    Category = _formModel.Category,
                    Description = string.IsNullOrWhiteSpace(_formModel.Description) ? null : _formModel.Description.Trim(),
                    CreatedBy = _currentUser?.Identity?.Name ?? "system",
                    CreatedAt = DateTime.Now
                });
            }
            await Db.SaveChangesAsync();
            CloseForm();
            _isError = false;
            _message = "تم حفظ الصلاحية";
            await LoadPermissions();
        }
        catch (Exception ex)
        {
            _formError = "تعذر الحفظ: " + ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void OpenDeleteDialog(Permission permission)
    {
        _permToDelete = permission;
        _deleteDialogOpen = true;
    }

    private async Task ConfirmDelete()
    {
        if (_permToDelete == null) return;
        if (Usage(_permToDelete.PermissionId) > 0)
        {
            _isError = true;
            _message = "لا يمكن حذف صلاحية مرتبطة بمستخدمين.";
            CancelDelete();
            return;
        }
        try
        {
            var entity = await Db.Permissions.FirstOrDefaultAsync(p => p.PermissionId == _permToDelete.PermissionId);
            if (entity != null)
            {
                Db.Permissions.Remove(entity);
                await Db.SaveChangesAsync();
            }
            _isError = false;
            _message = "تم حذف الصلاحية";
            await LoadPermissions();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = "تعذر الحذف: " + ex.Message;
        }
        CancelDelete();
    }

    private void CancelDelete()
    {
        _deleteDialogOpen = false;
        _permToDelete = null;
    }

    private bool HasPermission(string formName, string action)
        => _currentUser?.Claims.Any(c => c.Type == "Permission" && c.Value == $"{formName}:{action}") == true;

    private sealed class PermissionFormModel
    {
        public string PermissionName { get; set; } = "";
        public string FormName { get; set; } = "";
        public string Category { get; set; } = "Forms";
        public string Description { get; set; } = "";
    }
}
