@page "/admin/users/new"
@page "/admin/users/{UserId:int}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@using Microsoft.EntityFrameworkCore
@using COCOBOLOERPNEW.Models
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using COCOBOLOERPNEW.Services
@inject db24804Context Db
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<div class="user-form-page">
    <div class="page-header">
        <div class="header-content">
            <button type="button" class="back-btn" @onclick="Cancel">
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
            </button>
            <div class="header-info">
                <h1>@(_isEdit ? "تعديل مستخدم" : "إضافة مستخدم جديد")</h1>
                <p class="subtitle">@(_isEdit ? "تحديث بيانات الحساب والدور وربط الموظف" : "إنشاء حساب جديد وربطه بموظف وفرع")</p>
            </div>
            @if (_isEdit && _model.LastLogin.HasValue)
            {
                <div class="last-login-badge">
                    <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" />
                    <div>
                        <span class="label">آخر دخول</span>
                        <span class="value">@_model.LastLogin.Value.ToString("yyyy/MM/dd HH:mm")</span>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <MudAlert Severity="@(_isError ? Severity.Error : Severity.Success)" Class="mb-4">@_message</MudAlert>
    }

    <div class="form-container">
        <MudForm @ref="_form">
            <div class="form-section">
                <div class="section-header">
                    <MudIcon Icon="@Icons.Material.Filled.AccountCircle" />
                    <div>
                        <h2>معلومات الحساب</h2>
                        <p>اسم الدخول والاسم الظاهر ووسيلة التواصل</p>
                    </div>
                </div>
                <div class="section-body">
                    <div class="form-grid">
                        <div class="field">
                            <span class="field-label">اسم المستخدم <b>*</b></span>
                            <div class="field-box @(_isEdit ? "locked" : "")">
                                <MudIcon Icon="@Icons.Material.Outlined.Person" Class="field-icon" />
                                <MudTextField @bind-Value="_model.Username" Variant="Variant.Text" Margin="Margin.Dense" ReadOnly="_isEdit" Placeholder="اسم الدخول" Class="bare-field" />
                            </div>
                            @if (_isEdit) { <span class="field-hint">لا يتغير بعد الإنشاء.</span> }
                        </div>
                        <div class="field">
                            <span class="field-label">الاسم الكامل <b>*</b></span>
                            <div class="field-box">
                                <MudIcon Icon="@Icons.Material.Outlined.Badge" Class="field-icon" />
                                <MudTextField @bind-Value="_model.FullName" Variant="Variant.Text" Margin="Margin.Dense" Placeholder="الاسم كما يظهر في النظام" Class="bare-field" />
                            </div>
                        </div>
                        <div class="field">
                            <span class="field-label">كلمة المرور @if (_isEdit) { <em>اتركها فارغة للإبقاء على الحالية</em> } else { <b>*</b> }</span>
                            <div class="field-box">
                                <MudIcon Icon="@Icons.Material.Outlined.Lock" Class="field-icon" />
                                <MudTextField @bind-Value="_model.Password" Variant="Variant.Text" Margin="Margin.Dense" InputType="@(_showPassword ? InputType.Text : InputType.Password)" Placeholder="ثمانية أحرف على الأقل" Class="bare-field" />
                                <button type="button" class="eye-btn" @onclick="() => _showPassword = !_showPassword" aria-label="إظهار كلمة المرور">
                                    <MudIcon Icon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)" Size="Size.Small" />
                                </button>
                            </div>
                            <span class="field-hint">التغيير يحدّث كلمة المرور المشفرة.</span>
                        </div>
                        <div class="field">
                            <span class="field-label">البريد الإلكتروني</span>
                            <div class="field-box">
                                <MudIcon Icon="@Icons.Material.Outlined.Email" Class="field-icon" />
                                <MudTextField @bind-Value="_model.Email" Variant="Variant.Text" Margin="Margin.Dense" Placeholder="name@company.com" Class="bare-field" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="section-header">
                    <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" />
                    <div>
                        <h2>الدور والربط</h2>
                        <p>الدور الوظيفي غير صلاحيات الشاشات</p>
                    </div>
                </div>
                <div class="section-body">
                    <div class="form-grid">
                        <div class="field">
                            <span class="field-label">الدور الوظيفي <b>*</b></span>
                            <div class="field-box">
                                <MudIcon Icon="@Icons.Material.Outlined.WorkspacePremium" Class="field-icon" />
                                <MudSelect T="string" Value="_model.Role" ValueChanged="OnRoleChanged" Placeholder="اختر الدور" Variant="Variant.Text" Margin="Margin.Dense" Class="bare-field">
                                    @foreach (var role in SystemRoleCatalog.ForSelect(_model.Role))
                                    {
                                        <MudSelectItem Value="@role.Value">@role.Label</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                        </div>
                        <div class="field">
                            <span class="field-label">حالة الحساب</span>
                            <div class="status-chips">
                                <button type="button" class="@(_model.IsActive ? "on good" : "")" @onclick="() => _model.IsActive = true">نشط</button>
                                <button type="button" class="@(!_model.IsActive ? "on bad" : "")" @onclick="() => _model.IsActive = false">غير نشط</button>
                            </div>
                        </div>
                        <div class="field">
                            <span class="field-label">الموظف المرتبط</span>
                            <div class="field-box">
                                <MudIcon Icon="@Icons.Material.Outlined.Badge" Class="field-icon" />
                                <MudSelect T="int?" Value="_model.EmployeeId" ValueChanged="OnEmployeeChanged" Placeholder="بدون ربط" Variant="Variant.Text" Margin="Margin.Dense" Clearable="true" Class="bare-field">
                                    <MudSelectItem T="int?" Value="null">بدون ربط</MudSelectItem>
                                    @foreach (var employee in _employees)
                                    {
                                        <MudSelectItem T="int?" Value="@employee.Id">@employee.Name@(string.IsNullOrWhiteSpace(employee.Title) ? "" : $" — {employee.Title}")</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                            <span class="field-hint">مطلوب لوصول إشعار الجوب أوردر.</span>
                        </div>
                        <div class="field">
                            <span class="field-label">الفرع الافتراضي</span>
                            <div class="field-box">
                                <MudIcon Icon="@Icons.Material.Outlined.Store" Class="field-icon" />
                                <MudSelect T="int?" @bind-Value="_model.DefaultBranchId" Placeholder="بدون فرع" Variant="Variant.Text" Margin="Margin.Dense" Clearable="true" Class="bare-field">
                                    <MudSelectItem T="int?" Value="null">بدون فرع</MudSelectItem>
                                    @foreach (var branch in _branches)
                                    {
                                        <MudSelectItem T="int?" Value="@branch.Id">@branch.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                            <span class="field-hint">إن تُرك فارغًا يُستخدم فرع الموظف.</span>
                        </div>
                    </div>
                    <div class="account-summary">
                        <span><small>الدور</small>@RoleLabel</span>
                        <span><small>الموظف</small>@EmployeeLabel</span>
                        <span><small>الفرع</small>@BranchLabel</span>
                        <span class="@(_model.IsActive ? "good" : "bad")"><small>الحالة</small>@(_model.IsActive ? "نشط" : "غير نشط")</span>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                @if (_isEdit && _model.UserId > 0)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.VpnKey" OnClick="OpenPermissions" Disabled="_isSaving" Class="link-btn">صلاحيات الشاشات</MudButton>
                }
                <div class="actions-end">
                    <MudButton Variant="Variant.Outlined" OnClick="Cancel" Disabled="_isSaving">إلغاء</MudButton>
                    <MudButton Variant="Variant.Filled" Class="save-btn" OnClick="SaveUser" Disabled="_isSaving" StartIcon="@Icons.Material.Filled.Save">
                        @(_isSaving ? "جارٍ الحفظ..." : _isEdit ? "حفظ التعديل" : "حفظ المستخدم")
                    </MudButton>
                </div>
            </div>
        </MudForm>
    </div>
</div>

<style>
    .user-form-page { padding: 1.5rem 1.75rem 2.5rem; direction: rtl; color: #1E293B; }
    .page-header, .form-container { background: #fff; border: 1px solid #E2E8F0; border-radius: 18px; }
    .page-header {
        background: linear-gradient(135deg, #0A1628 0%, #1E293B 100%);
        border-bottom: 3px solid #D4AF37;
        padding: 1.35rem 1.5rem;
        margin-bottom: 1.25rem;
        box-shadow: 0 12px 30px rgba(10, 22, 40, 0.18);
    }
    .header-content { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
    .back-btn { width: 44px; height: 44px; border: 0; border-radius: 12px; background: rgba(212, 175, 55, 0.16); color: #D4AF37; cursor: pointer; }
    .header-info { flex: 1; }
    .header-info h1 { margin: 0; color: #fff; font-size: 1.6rem; font-weight: 800; }
    .header-info .subtitle { margin: 0.25rem 0 0; color: #CBD5E1; }
    .last-login-badge { margin-right: auto; display: flex; gap: 0.55rem; align-items: center; color: #fff; background: rgba(255,255,255,0.08); border: 1px solid rgba(212,175,55,0.35); border-radius: 12px; padding: 0.55rem 0.8rem; }
    .last-login-badge .label { display: block; color: #D4AF37; font-size: 0.75rem; }
    .form-container { overflow: hidden; box-shadow: 0 8px 24px rgba(10, 22, 40, 0.06); }
    .form-section + .form-section { border-top: 1px solid #E2E8F0; }
    .section-header { display: flex; gap: 0.8rem; align-items: center; padding: 1.15rem 1.4rem; background: #F4F6F9; }
    .section-header .mud-icon-root { color: #D4AF37; font-size: 1.6rem; }
    .section-header h2 { margin: 0; font-size: 1.05rem; color: #0A1628; }
    .section-header p { margin: 0.15rem 0 0; color: #64748B; font-size: 0.85rem; }
    .section-body { padding: 1.15rem 1.25rem 1rem; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.95rem 1rem; }
    .field-label { display: block; margin: 0 0.15rem 0.4rem; color: #64748B; font-size: 0.75rem; font-weight: 800; }
    .field-label b { color: #EF4444; }
    .field-label em { font-style: normal; color: #94A3B8; font-weight: 600; }
    .field-box, .status-chips { height: 48px; display: flex; align-items: center; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px; }
    .field-box { gap: 0.35rem; padding: 0 0.75rem; transition: border-color .15s, box-shadow .15s, background .15s; }
    .field-box:focus-within { background: #fff; border-color: #D4AF37; box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.18); }
    .field-box.locked { background: #F1F5F9; }
    .field-icon, .eye-btn { color: #D4AF37; font-size: 1.15rem; }
    .eye-btn { border: 0; background: transparent; cursor: pointer; display: grid; place-items: center; }
    .field-hint { display: block; margin: 0.35rem 0.15rem 0; color: #64748B; font-size: 0.78rem; }
    .status-chips { padding: 4px; gap: 4px; }
    .status-chips button { flex: 1; border: 0; background: transparent; color: #64748B; border-radius: 9px; font-weight: 800; cursor: pointer; }
    .status-chips button.on.good { background: #047857; color: #fff; }
    .status-chips button.on.bad { background: #B91C1C; color: #fff; }
    .account-summary { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6rem; margin-top: 1rem; }
    .account-summary span { background: #0A1628; color: #fff; border-radius: 12px; padding: 0.55rem 0.75rem; min-height: 52px; }
    .account-summary small { display: block; color: #D4AF37; font-size: 0.68rem; font-weight: 800; margin-bottom: 0.15rem; }
    .account-summary .good { background: #047857; }
    .account-summary .bad { background: #B91C1C; }
    ::deep .bare-field { flex: 1; }
    ::deep .bare-field .mud-input-control { margin: 0; }
    ::deep .bare-field .mud-input-slot { padding: 0; min-height: 46px; }
    ::deep .bare-field .mud-input { color: #1E293B; font-weight: 600; }
    ::deep .bare-field .mud-input-underline:before, ::deep .bare-field .mud-input-underline:after { display: none; }
    .form-actions { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 1rem 1.4rem 1.25rem; background: #F4F6F9; border-top: 1px solid #E2E8F0; }
    .actions-end { display: flex; gap: 0.6rem; margin-right: auto; }
    .save-btn { background: #0A1628 !important; color: #fff !important; }
    .save-btn:hover { background: #1E293B !important; }
    @@media (max-width: 800px) {
        .user-form-page { padding: 1rem; }
        .form-actions, .header-content { flex-direction: column; align-items: stretch; }
        .form-grid, .account-summary { grid-template-columns: 1fr; }
        .actions-end, .last-login-badge { width: 100%; margin: 0; }
    }
</style>

@code {
    [Parameter] public int? UserId { get; set; }

    private MudForm? _form;
    private bool _isEdit;
    private bool _isSaving;
    private bool _showPassword;
    private bool _isError;
    private string _message = "";
    private ClaimsPrincipal? _currentUser;
    private UserEditModel _model = new() { IsActive = true, Role = "User" };
    private List<EmployeeOption> _employees = new();
    private List<BranchOption> _branches = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUser = auth.User;
        await LoadLookups();
        if (UserId.HasValue)
        {
            _isEdit = true;
            await LoadUser(UserId.Value);
        }
    }

    private async Task LoadLookups()
    {
        _employees = await Db.Employees.AsNoTracking()
            .Where(e => e.EndDate == null || e.EndDate > DateTime.Today)
            .OrderBy(e => e.FullName)
            .Select(e => new EmployeeOption { Id = e.EmployeeId, Name = e.FullName, Title = e.JobTitle, BranchId = e.BranchId })
            .ToListAsync();
        _branches = await Db.Branches.AsNoTracking()
            .Where(b => b.IsActive)
            .OrderBy(b => b.BranchNameAr)
            .Select(b => new BranchOption { Id = b.BranchId, Name = b.BranchNameAr })
            .ToListAsync();
    }

    private async Task LoadUser(int id)
    {
        var user = await Db.Users.FirstOrDefaultAsync(u => u.UserId == id);
        if (user == null)
        {
            _isError = true;
            _message = "المستخدم غير موجود";
            return;
        }
        _model = new UserEditModel
        {
            UserId = user.UserId,
            Username = user.Username,
            FullName = user.FullName,
            Email = user.Email,
            Role = string.IsNullOrWhiteSpace(user.Role) ? "User" : user.Role,
            IsActive = user.IsActive ?? true,
            LastLogin = user.LastLogin,
            EmployeeId = user.EmployeeId,
            DefaultBranchId = user.DefaultBranchId
        };
        if (user.EmployeeId is int linked && _employees.All(e => e.Id != linked))
        {
            var ended = await Db.Employees.AsNoTracking()
                .Where(e => e.EmployeeId == linked)
                .Select(e => new EmployeeOption { Id = e.EmployeeId, Name = e.FullName, Title = e.JobTitle, BranchId = e.BranchId })
                .FirstOrDefaultAsync();
            if (ended != null) _employees.Insert(0, ended);
        }
        if (user.DefaultBranchId is int branchId && _branches.All(b => b.Id != branchId))
        {
            var branch = await Db.Branches.AsNoTracking()
                .Where(b => b.BranchId == branchId)
                .Select(b => new BranchOption { Id = b.BranchId, Name = b.BranchNameAr })
                .FirstOrDefaultAsync();
            if (branch != null) _branches.Insert(0, branch);
        }
    }

    private async Task SaveUser()
    {
        _isSaving = true;
        _isError = false;
        _message = "";
        if (!HasPermission("frm_AddUser", _isEdit ? "Edit" : "Add")) { Fail("ليس لديك صلاحية لهذا الإجراء"); return; }
        if (string.IsNullOrWhiteSpace(_model.Username) || string.IsNullOrWhiteSpace(_model.FullName)) { Fail("اسم المستخدم والاسم الكامل مطلوبان"); return; }
        if (string.IsNullOrWhiteSpace(_model.Role)) { Fail("اختر الدور الوظيفي"); return; }
        if (!_isEdit && (string.IsNullOrWhiteSpace(_model.Password) || _model.Password.Trim().Length < 8)) { Fail("كلمة المرور مطلوبة، وثمانية أحرف على الأقل"); return; }
        if (_isEdit && !string.IsNullOrWhiteSpace(_model.Password) && _model.Password.Trim().Length < 8) { Fail("كلمة المرور الجديدة يجب أن تكون ثمانية أحرف على الأقل"); return; }

        try
        {
            if (_isEdit)
            {
                var user = await Db.Users.FirstOrDefaultAsync(u => u.UserId == _model.UserId);
                if (user == null) { Fail("المستخدم غير موجود"); return; }
                user.FullName = _model.FullName.Trim();
                user.Email = BlankToNull(_model.Email);
                user.Role = _model.Role;
                user.IsActive = _model.IsActive;
                user.EmployeeId = _model.EmployeeId;
                user.DefaultBranchId = ResolveBranch();
                ApplyPassword(user);
                await Db.SaveChangesAsync();
                _message = "تم تحديث المستخدم";
            }
            else
            {
                var username = _model.Username.Trim();
                if (await Db.Users.AnyAsync(u => u.Username == username)) { Fail("اسم المستخدم موجود بالفعل"); return; }
                var user = new User
                {
                    Username = username,
                    FullName = _model.FullName.Trim(),
                    Email = BlankToNull(_model.Email),
                    Role = _model.Role,
                    IsActive = _model.IsActive,
                    EmployeeId = _model.EmployeeId,
                    DefaultBranchId = ResolveBranch(),
                    CreatedAt = DateTime.Now,
                    CreatedBy = _currentUser?.Identity?.Name ?? "System"
                };
                ApplyPassword(user);
                Db.Users.Add(user);
                await Db.SaveChangesAsync();
                _message = "تم إضافة المستخدم";
            }
            await Task.Delay(600);
            Navigation.NavigateTo("/admin/users");
        }
        catch (Exception ex)
        {
            Fail("تعذر الحفظ: " + ex.Message);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static string? BlankToNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private void ApplyPassword(User user)
    {
        if (string.IsNullOrWhiteSpace(_model.Password)) return;
        user.Password = _model.Password;
        user.HashedPassword = PasswordHasher.HashPassword(_model.Password);
    }

    private void Fail(string message)
    {
        _isError = true;
        _message = message;
        _isSaving = false;
    }

    private string RoleLabel => SystemRoleCatalog.Text(_model.Role);
    private string EmployeeLabel => _employees.FirstOrDefault(e => e.Id == _model.EmployeeId)?.Name ?? "بدون ربط";
    private string BranchLabel => _model.DefaultBranchId is int id
        ? _branches.FirstOrDefault(b => b.Id == id)?.Name ?? "فرع الموظف"
        : (_model.EmployeeId.HasValue ? "فرع الموظف" : "بدون فرع");

    private void Cancel() => Navigation.NavigateTo("/admin/users");
    private void OnRoleChanged(string role) => _model.Role = role;
    private void OnEmployeeChanged(int? employeeId)
    {
        _model.EmployeeId = employeeId;
        if (_model.DefaultBranchId == null && employeeId is int id)
            _model.DefaultBranchId = _employees.FirstOrDefault(e => e.Id == id)?.BranchId;
    }
    private int? ResolveBranch()
    {
        if (_model.DefaultBranchId.HasValue) return _model.DefaultBranchId;
        if (_model.EmployeeId is int id) return _employees.FirstOrDefault(e => e.Id == id)?.BranchId;
        return null;
    }
    private void OpenPermissions()
    {
        if (_model.UserId > 0) Navigation.NavigateTo($"/admin/permissions/manage?user={_model.UserId}");
    }
    private bool HasPermission(string formName, string action)
        => _currentUser?.Claims.Any(c => c.Type == "Permission" && c.Value == $"{formName}:{action}") == true;

    private sealed class UserEditModel
    {
        public int UserId { get; set; }
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
        public string FullName { get; set; } = "";
        public string? Email { get; set; }
        public string Role { get; set; } = "User";
        public bool IsActive { get; set; } = true;
        public DateTime? LastLogin { get; set; }
        public int? EmployeeId { get; set; }
        public int? DefaultBranchId { get; set; }
    }
    private sealed class EmployeeOption
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string? Title { get; set; }
        public int? BranchId { get; set; }
    }
    private sealed class BranchOption
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }
}
