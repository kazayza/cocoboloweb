    // ═══════════ مشاركة الفلاتر عبر الرابط ═══════════
    private Dictionary<string, string> ParseQuery()
    {
        var d = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var u = Nav.Uri;
        var i = u.IndexOf('?');
        if (i < 0) return d;
        foreach (var part in u[(i + 1)..].Split('&'))
        {
            if (string.IsNullOrWhiteSpace(part)) continue;
            var kv = part.Split('=', 2);
            var k = Uri.UnescapeDataString(kv[0]);
            var v = kv.Length > 1 ? Uri.UnescapeDataString(kv[1]) : "";
            d[k] = v;
        }
        return d;
    }

    private void ApplyQueryToFilters()
    {
        var q = ParseQuery();
        if (q.Count == 0)
        {
            // افتراضي: كل الفترات
            _from = null; _to = null; _quick = "all"; _status = "all"; _empId = null; _q = "";
            return;
        }
        if (q.TryGetValue("from", out var f) && DateTime.TryParse(f, out var fd)) { _from = fd; _quick = null; }
        if (q.TryGetValue("to", out var tt) && DateTime.TryParse(tt, out var td)) { _to = td; _quick = null; }
        if (!_from.HasValue && !_to.HasValue) _quick = "all";
        _status = q.TryGetValue("status", out var st) ? st : "all";
        _empId = q.TryGetValue("emp", out var em) && int.TryParse(em, out var ev) ? ev : (int?)null;
        _q = q.TryGetValue("q", out var qq) ? qq : "";
    }

    private void SyncUrl()
    {
        var path = Nav.ToAbsoluteUri(Nav.Uri).GetLeftPart(UriPartial.Path);
        var parts = new List<string>();
        if (_from.HasValue) parts.Add("from=" + _from.Value.ToString("yyyy-MM-dd"));
        if (_to.HasValue) parts.Add("to=" + _to.Value.ToString("yyyy-MM-dd"));
        if (_status != "all") parts.Add("status=" + Uri.EscapeDataString(_status));
        if (_empId.HasValue) parts.Add("emp=" + _empId.Value);
        if (!string.IsNullOrWhiteSpace(_q)) parts.Add("q=" + Uri.EscapeDataString(_q.Trim()));
        var url = parts.Count > 0 ? path + "?" + string.Join("&", parts) : path;
        if (!string.Equals(Nav.Uri, url, StringComparison.OrdinalIgnoreCase))
            Nav.NavigateTo(url, new NavigationOptions { ReplaceHistoryEntry = true });
    }

    // ═══════════ لوحة سجل الفرصة ═══════════
    private int? _panelOppId;
    private string _panelClientName = "";
    private bool _panelLoading;
    private List<RecoveryHistoryDto> _panelHistory = new();

    private async Task OpenRowHistory(int oppId)
    {
        _panelOppId = oppId;
        _panelClientName = _result.Rows.FirstOrDefault(r => r.OpportunityId == oppId)?.ClientName ?? "";
        _panelHistory = new List<RecoveryHistoryDto>();
        _panelLoading = true;
        try
        {
            _panelHistory = await Recovery.GetRecoveryHistoryAsync(oppId);
        }
        catch (Exception ex)
        {
            _errorMsg = "تعذّر تحميل السجل: " + ex.Message;
        }
        finally
        {
            _panelLoading = false;
        }
    }

    private void CloseRowHistory() => _panelOppId = null;
    private void Noop() { }
