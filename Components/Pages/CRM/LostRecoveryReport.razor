@page "/crm/lost-recovery/report"
@attribute [Authorize]

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Models
@using COCOBOLOERPNEW.Services
@using System.Globalization
@using ApexCharts
@using ClosedXML.Excel
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization

@inject RecoveryService Recovery
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth
@inject IJSRuntime JS
@implements IDisposable

<div class="rp-page" dir="rtl">

    <!-- ═══════════ HERO ═══════════ -->
    <div class="rp-hero">
        <div class="rp-hero-bg"></div>
        <div class="rp-hero-content">
            <div class="rp-hero-title">
                <div class="rp-hero-icon">📊</div>
                <div>
                    <h1>تقرير استرداد الفرص الخاسرة</h1>
                    <p>صورة كاملة: الفرص في طابور الاسترداد + نتائج التواصل والرفض والعودة — مع فلاتر وفترة للتضييق</p>
                </div>
            </div>
            <div class="rp-hero-btns">
                <button class="rp-btn rp-btn-light" @onclick="GoBack" title="العودة لطابور الاسترداد">
                    <span class="rp-btn-ico">↩</span><span>عودة للطابور</span>
                </button>
                <button class="rp-btn rp-btn-light" @onclick="LoadReportAsync" disabled="@_loading"
                        title="إعادة تحميل التقرير بآخر الفلاتر">
                    <span class="rp-btn-ico">↻</span><span>@(_loading ? "جارٍ التحميل..." : "تحديث")</span>
                </button>
                <button class="rp-btn rp-btn-primary" @onclick="ExportExcelAsync"
                        disabled="@(_exporting || _result.RowCount == 0)" title="تصدير كل النتائج (وليس الصفحة الحالية)">
                    <span class="rp-btn-ico">⬇</span>
                    <span>@(_exporting ? "جارٍ التصدير..." : "تصدير Excel")</span>
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMsg))
    {
        <div class="rp-err">⚠ @_errorMsg</div>
    }

    <!-- ═══════════ KPI CARDS ═══════════ -->
    <div class="rp-kpis">
        <div class="rp-kpi rp-k-blue">
            <span class="rp-k-ico">🎯</span>
            <div><span class="rp-k-v">@_result.RowCount.ToString("N0")</span><span class="rp-k-l">إجمالي الفرص</span></div>
        </div>
        <div class="rp-kpi rp-k-indigo">
            <span class="rp-k-ico">💰</span>
            <div><span class="rp-k-v">@Money(_result.TotalValue)</span><span class="rp-k-l">إجمالي القيمة</span></div>
        </div>
        <div class="rp-kpi rp-k-green">
            <span class="rp-k-ico">🔁</span>
            <div><span class="rp-k-v">@_result.RevivedCount.ToString("N0")</span><span class="rp-k-l">مُسترد</span></div>
        </div>
        <div class="rp-kpi rp-k-gray">
            <span class="rp-k-ico">📉</span>
            <div><span class="rp-k-v">@_result.UncontactedCount.ToString("N0")</span><span class="rp-k-l">لم يُتواصل</span></div>
        </div>
    </div>

    <!-- ═══════════ SEGMENTED BREAKDOWN ═══════════ -->
    @if (_result.RowCount > 0)
    {
        <div class="rp-segments">
            @{ var total = Math.Max(1, _result.RowCount);
               var pctUn = _result.UncontactedCount * 100.0 / total;
               var pctCon = _result.ContactedCount * 100.0 / total;
               var pctRej = _result.RejectedCount * 100.0 / total;
               var pctRev = _result.RevivedCount * 100.0 / total; }
            <span class="rp-seg rp-seg-gray"><b>لم يُتواصل</b> @_result.UncontactedCount.ToString("N0") <i>@pctUn.ToString("0")%</i><em style="width:@pctUn.ToString("0")%"></em></span>
            <span class="rp-seg rp-seg-amber"><b>قيد المتابعة</b> @_result.ContactedCount.ToString("N0") <i>@pctCon.ToString("0")%</i><em style="width:@pctCon.ToString("0")%"></em></span>
            <span class="rp-seg rp-seg-red"><b>رفض نهائي</b> @_result.RejectedCount.ToString("N0") <i>@pctRej.ToString("0")%</i><em style="width:@pctRej.ToString("0")%"></em></span>
            <span class="rp-seg rp-seg-green"><b>مُسترد</b> @_result.RevivedCount.ToString("N0") <i>@pctRev.ToString("0")%</i><em style="width:@pctRev.ToString("0")%"></em></span>
        </div>
    }
<!-- ═══════════ FILTERS ═══════════ -->
    <div class="rp-filters">
        <div class="rp-f">
            <label>من تاريخ</label>
            <input type="date" value="@_from?.ToString("yyyy-MM-dd")" @onchange="OnFromChange" />
        </div>
        <div class="rp-f">
            <label>إلى تاريخ</label>
            <input type="date" value="@_to?.ToString("yyyy-MM-dd")" @onchange="OnToChange" />
        </div>
        <div class="rp-f">
            <label>الحالة</label>
            <select value="@_status" @onchange="OnStatusChange">
                <option value="all">كل الحالات</option>
                <option value="uncontacted">لم يُتواصل</option>
                <option value="contacting">قيد المتابعة</option>
                <option value="rejected">رفض نهائي</option>
                <option value="revived">مُسترد</option>
            </select>
        </div>
        <div class="rp-f">
            <label>موظف خدمة العملاء</label>
            <select value="@(_empId?.ToString() ?? "")" @onchange="OnEmpChange">
                <option value="">الكل</option>
                @foreach (var e in _csEmployees)
                {
                    <option value="@e.EmployeeId">@e.FullName</option>
                }
            </select>
        </div>
        <div class="rp-f rp-f-grow">
            <label>بحث بالعميل / الهاتف</label>
            <div class="rp-search-box">
                <span class="rp-search-ico">🔍</span>
                <input type="text" placeholder="اسم العميل أو رقم الهاتف..." value="@_q"
                       @oninput="OnSearchTyped" @onkeydown="OnSearchKey" />
                @if (!string.IsNullOrWhiteSpace(_q))
                {
                    <button class="rp-search-clear" @onclick="ClearSearch" title="مسح البحث">×</button>
                }
                <button class="rp-search-go" @onclick="ApplyNow" title="تنفيذ البحث فوراً (أو اضغط Enter)">بحث</button>
            </div>
        </div>
    </div>

    <div class="rp-quick" title="نطاقات زمنية سريعة">
        <button type="button" class="rp-chip @(_quick == "month" ? "rp-chip-on" : "")" @onclick="OnQuickMonth">آخر شهر</button>
        <button type="button" class="rp-chip @(_quick == "quarter" ? "rp-chip-on" : "")" @onclick="OnQuickQuarter">آخر 3 شهور</button>
        <button type="button" class="rp-chip @(_quick == "year" ? "rp-chip-on" : "")" @onclick="OnQuickYear">من أول السنة</button>
        <button type="button" class="rp-chip @(_quick == "all" ? "rp-chip-on" : "")" @onclick="OnQuickAll">كل الفترات</button>
        @if (HasActiveFilters)
        {
            <button type="button" class="rp-chip rp-chip-clearall" @onclick="ClearAllFilters"
                    title="إلغاء كل الفلاتر والبحث وإعادة التحميل">✕ مسح الكل (@ActiveFilterCount)</button>
        }
        <span class="rp-stamp">🕒 آخر تحديث: @AsOfText()</span>
        <label class="rp-autoref" title="تحديث هادئ كل 45 ثانية مع الحفاظ على صفحتك الحالية">
            <input type="checkbox" checked="@_autoRefresh" @onchange="ToggleAutoRefresh" /> تحديث تلقائي
        </label>
    </div>

    <!-- ═══════════ TAB BAR ═══════════ -->
    <div class="rp-tabs">
        <button type="button" class="rp-tab @(_tab == "table" ? "rp-tab-on" : "")" @onclick="SwitchTable">📋 الجدول</button>
        <button type="button" class="rp-tab @(_tab == "trend" ? "rp-tab-on" : "")" @onclick="SwitchTrend">📈 الاتجاه الشهري</button>
        <button type="button" class="rp-tab @(_tab == "staff" ? "rp-tab-on" : "")" @onclick="SwitchStaff">👥 أداء الموظفين</button>
        <button type="button" class="rp-tab @(_tab == "reasons" ? "rp-tab-on" : "")" @onclick="SwitchReasons">🧩 أسباب الخسارة</button>
    </div>

    @if (_loading)
    {
        <div class="rp-loading"><span class="rp-spin"></span><span>يتم تجهيز بيانات التقرير…</span></div>
    }
    else if (_searching)
    {
        <div class="rp-loading"><span class="rp-spin"></span><span>جارٍ البحث…</span></div>
    }
    else if (_tab == "trend")
    {
        @if (_trend.Count == 0)
        {
            <div class="rp-empty"><h3>لا توجد بيانات كافية للرسم بعد</h3><p>سيظهر الاتجاه الشهري فور توفر سجلات (تواصل/عودة/رفض) في نطاق التقرير.</p></div>
        }
        else
        {
            <section class="rp-sec">
                <div class="rp-sec-head">
                    <h3>📈 الاتجاه الشهري — آخر 12 شهرًا</h3>
                    <p>عدد الفرص حسب حالة الصف وتاريخ "حدث الحالة" (العودة/آخر تواصل/الخسارة) — على كامل البيانات دون التقيد بفلتر الفترة الحالي.</p>
                </div>
                <ApexChart TItem="RecoveryTrendPoint" Options="_trendOpts" Height="370">
                    <ApexPointSeries TItem="RecoveryTrendPoint" Items="_trend" Name="مُسترد" SeriesType="SeriesType.Line" XValue="x => x.Label" YValue="x => x.Revived" />
                    <ApexPointSeries TItem="RecoveryTrendPoint" Items="_trend" Name="قيد المتابعة" SeriesType="SeriesType.Line" XValue="x => x.Label" YValue="x => x.Contacting" />
                    <ApexPointSeries TItem="RecoveryTrendPoint" Items="_trend" Name="رفض نهائي" SeriesType="SeriesType.Line" XValue="x => x.Label" YValue="x => x.Rejected" />
                    <ApexPointSeries TItem="RecoveryTrendPoint" Items="_trend" Name="لم يُتواصل" SeriesType="SeriesType.Line" XValue="x => x.Label" YValue="x => x.Uncontacted" />
                </ApexChart>
            </section>
        }
    }
    else if (_tab == "staff")
    {
        @if (_staff.Count == 0)
        {
            <div class="rp-empty"><h3>لا توجد بيانات أداء بعد</h3><p>تظهر بيانات كل موظف خدمة عملاء فور تسجيل تواصل أو استرداد يحمل اسمه.</p></div>
        }
        else
        {
            <section class="rp-sec">
                <div class="rp-sec-head">
                    <h3>👥 أداء موظفي خدمة العملاء</h3>
                    <p>الصفوف المنسوبة لكل موظف داخل نطاق التقرير (مهمة مفتوحة أو منفّذ آخر تواصل/عودة) — مرتبة بإجمالي القيمة المُستردة.</p>
                </div>
                <div class="rp-table-wrap">
                    <table class="rp-table">
                        <thead>
                            <tr>
                                <th>الموظف</th><th>القضايا</th><th>لم يُتواصل</th><th>قيد المتابعة</th>
                                <th>رفض نهائي</th><th>مُسترد</th><th>قيمة مُستردة</th><th>نسبة الاسترداد</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in _staff)
                            {
                                <tr>
                                    <td><b>@s.FullName</b></td>
                                    <td class="rp-center">@s.Assigned</td>
                                    <td class="rp-center">@s.Uncontacted</td>
                                    <td class="rp-center">@s.Contacting</td>
                                    <td class="rp-center">@s.Rejected</td>
                                    <td class="rp-center rp-rev">@s.Revived</td>
                                    <td class="rp-val">@Money(s.RevivedValue)</td>
                                    <td>
                                        <span class="rp-rate" style="--w:@((int)Math.Round(s.ReviveRate))%">
                                            <i></i><b>@((int)Math.Round(s.ReviveRate))%</b>
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
    else if (_tab == "reasons")
    {
        @if (_reasons.Count == 0)
        {
            <div class="rp-empty"><h3>لا توجد أسباب مسجلة بعد</h3><p>تظهر أسباب الخسارة فور تسجيلها على الفرص داخل التقرير.</p></div>
        }
        else
        {
            <section class="rp-sec">
                <div class="rp-sec-head">
                    <h3>🧩 أسباب الخسارة ونِسَب الاسترداد</h3>
                    <p>لكل سبب: عدد الفرص، ومنها ما عاد لدورة البيع — لمعرفة أين تتركز فرص الاسترداد.</p>
                </div>
                <div class="rp-table-wrap">
                    <table class="rp-table">
                        <thead>
                            <tr><th>سبب الخسارة</th><th>عدد الفرص</th><th>مُسترد</th><th>نسبة الاسترداد</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var rz in _reasons)
                            {
                                <tr>
                                    <td><b>@rz.ReasonName</b></td>
                                    <td class="rp-center">@rz.Total</td>
                                    <td class="rp-center rp-rev">@rz.Revived</td>
                                    <td>
                                        <span class="rp-rate" style="--w:@((int)Math.Round(rz.ReviveRate))%">
                                            <i></i><b>@((int)Math.Round(rz.ReviveRate))%</b>
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
    else
    {
        @if (_result.Rows.Count == 0)
        {
            <div class="rp-empty">
                @if (HasActiveFilters)
                {
                    <h3>لا توجد نتائج مطابقة للبحث أو الفلاتر</h3>
                    <p>جرّب تعديل الفلترة أو البحث لعرض نطاق أوسع — أو شاهد تبويبات التحليل أعلاه.</p>
                }
                else
                {
                    <h3>لا توجد بيانات لتقرير الاسترداد بعد</h3>
                }
            </div>
        }
        else
        {
            <div class="rp-legend">
                <span><b>لم يُتواصل</b> = لا توجد محاولة تواصل مسجلة بعد الخسارة.</span>
                <span><b>قيد المتابعة</b> = تم التواصل ولم يُحسم الأمر بعد.</span>
                <span><b>رفض نهائي</b> = أُغلق ملف متابعة الاسترداد.</span>
                <span><b>مُسترد</b> = عاد العميل لدورة البيع.</span>
            </div>

            @if (_result.RowCount > _result.PageSize)
            {
                <div class="rp-note">يعرض الجدول @_result.Rows.Count من إجمالي @_result.RowCount.ToString("N0") — للتصدير الكامل استخدم زر Excel.</div>
            }
            <div class="rp-table-wrap">
                <table class="rp-table">
                    <thead>
                        <tr>
                            <th>#</th><th>العميل</th><th>القيمة</th><th>الحالة</th><th>سبب الخسارة</th>
                            <th>الإغلاق</th><th>موظف المتابعة</th><th>التواصل</th><th>آخر نشاط</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _result.Rows)
                        {
                            <tr>
                                <td class="rp-mono">
                                    <a class="rp-link" href="@($"/crm/opportunities/{r.OpportunityId}")" title="فتح الفرصة">@r.OpportunityId</a>
                                </td>
                                <td>
                                    <b>@r.ClientName</b>
                                    @if (!string.IsNullOrWhiteSpace(r.Phone))
                                    {
                                        <div class="rp-sub">@r.Phone</div>
                                    }
                                </td>
                                <td class="rp-val">@Money(r.ExpectedValue)</td>
                                <td><span class="rp-badge @StatusClass(r.StatusAr)">@r.StatusAr</span></td>
                                <td>@(r.LostReasonName ?? "—")</td>
                                <td class="rp-mono">@(r.ClosedAt.HasValue ? r.ClosedAt.Value.ToString("yyyy/MM/dd") : "—")</td>
                                <td>@(r.CsEmployeeName ?? "—")</td>
                                <td class="rp-center">@r.ContactCount</td>
                                <td>
                                    @if (r.RevivedDate.HasValue)
                                    {
                                        <span class="rp-mono rp-rev">↩ @r.RevivedDate.Value.ToString("yyyy/MM/dd")</span>
                                        @if (!string.IsNullOrWhiteSpace(r.LastCsSummary))
                                        {
                                            <div class="rp-sub" title="@r.LastCsSummary">@Trunc(r.LastCsSummary, 36)</div>
                                        }
                                    }
                                    else if (r.LastCsDate.HasValue)
                                    {
                                        <span class="rp-mono">@r.LastCsDate.Value.ToString("yyyy/MM/dd HH:mm")</span>
                                        @if (!string.IsNullOrWhiteSpace(r.LastCsSummary))
                                        {
                                            <div class="rp-sub" title="@r.LastCsSummary">@Trunc(r.LastCsSummary, 36)</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="rp-dim">—</span>
                                    }
                                </td>
                                <td>
                                    <a class="rp-mini" href="@($"/crm/customers/{r.PartyId}")" title="ملف العميل">🧾</a>
                                    <button type="button" class="rp-mini rp-mini-btn" @onclick="() => OpenRowHistory(r.OpportunityId)" title="سجل التواصل بعد الخسارة">🕘</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (_result.TotalPages > 1)
            {
                <div class="rp-pager">
                    <button class="rp-btn rp-btn-outline" @onclick="PrevPage" disabled="@(_result.PageIndex <= 1 || _searching)">→ السابق</button>
                    <span>صفحة @_result.PageIndex من @_result.TotalPages</span>
                    <button class="rp-btn rp-btn-outline" @onclick="NextPage" disabled="@(!_result.HasMore || _searching)">التالي ←</button>
                </div>
            }
        }
    }

    <!-- ═══════════ سجل الفرصة (لوحة جانبية) ═══════════ -->
    @if (_panelOppId.HasValue)
    {
        <div class="rp-overlay" @onclick="CloseRowHistory">
            <div class="rp-drawer" @onclick="Noop" @onclick:stopPropagation>
                <div class="rp-drawer-head">
                    <div>
                        <h3>🕘 سجل التواصل بعد الخسارة</h3>
                        <p class="rp-sub">الفرصة #@_panelOppId — عميل: @_panelClientName</p>
                    </div>
                    <button type="button" class="rp-x" @onclick="CloseRowHistory">✕</button>
                </div>
                <div class="rp-drawer-body">
                    @if (_panelLoading)
                    {
                        <div class="rp-loading"><span class="rp-spin"></span><span>جارٍ تحميل السجل…</span></div>
                    }
                    else if (_panelHistory.Count == 0)
                    {
                        <div class="rp-empty"><h3>لا يوجد سجل تواصل بعد الخسارة</h3><p>لم يُسجَّل أي محاولة تواصل على هذه الفرصة بعد وصولها للخسارة.</p></div>
                    }
                    else
                    {
                        <div class="rp-hist-list">
                            @foreach (var h in _panelHistory)
                            {
                                <div class="rp-hist-item">
                                    <span class="rp-hist-date">@h.Date.ToString("yyyy/MM/dd HH:mm")</span>
                                    @if (!string.IsNullOrWhiteSpace(h.Channel))
                                    {
                                        <span class="rp-hist-channel">@h.Channel</span>
                                    }
                                    <div class="rp-hist-sum">@h.Summary</div>
                                    <div class="rp-hist-by">بواسطة: @(string.IsNullOrWhiteSpace(h.EmployeeName) ? h.CreatedBy : h.EmployeeName)</div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="rp-drawer-foot">
                    <a class="rp-btn rp-btn-primary" href="@($"/crm/opportunities/{_panelOppId}")">فتح الفرصة كاملة ↗</a>
                </div>
            </div>
        </div>
    }
</div>
<style>
    .rp-page { font-family: 'Tajawal', 'Segoe UI', Tahoma, Arial, sans-serif;
        display: flex; flex-direction: column; gap: 16px;
        max-width: 1320px; margin: 0 auto; padding: 22px;
        --r-ink: #0f172a; --r-mut: #64748b; --r-line: #e2e8f0; }
    .rp-hero { position: relative; border-radius: 20px; overflow: hidden; color: #fff;
        background: linear-gradient(135deg, #1e2a4a 0%, #2b3568 55%, #4338ca 100%); }
    .rp-hero-bg { position: absolute; inset: 0; opacity: .12;
        background: radial-gradient(circle at 85% 20%, #6366f1, transparent 60%),
        radial-gradient(circle at 15% 90%, #4f46e5, transparent 55%); }
    .rp-hero-content { position: relative; display: flex; align-items: center; justify-content: space-between;
        gap: 14px; flex-wrap: wrap; padding: 22px 26px; }
    .rp-hero-title { display: flex; align-items: center; gap: 14px; }
    .rp-hero-icon { font-size: 2.1rem; filter: drop-shadow(0 3px 4px rgba(0,0,0,.25)); }
    .rp-hero-title h1 { margin: 0; font-size: 1.45rem; font-weight: 900; }
    .rp-hero-title p { margin: 5px 0 0; font-size: .9rem; opacity: .88; line-height: 1.55; }
    .rp-hero-btns { display: flex; gap: 8px; flex-wrap: wrap; }
    .rp-btn { border: 0; border-radius: 12px; padding: 11px 17px; cursor: pointer;
        font-family: inherit; font-weight: 800; font-size: .85rem; transition: all .15s ease; }
    .rp-btn:disabled { opacity: .55; cursor: not-allowed; }
    .rp-btn-ico { margin-left: 5px; }
    .rp-btn-primary { background: linear-gradient(135deg, #4f46e5, #6366f1); color: #fff;
        box-shadow: 0 4px 14px rgba(79, 70, 229, .3); }
