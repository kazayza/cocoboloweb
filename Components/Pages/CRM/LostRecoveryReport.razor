@page "/crm/lost-recovery/report"
@attribute [Authorize]

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Models
@using COCOBOLOERPNEW.Services
@using System.Globalization
@using ClosedXML.Excel
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization

@inject RecoveryService Recovery
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth
@inject IJSRuntime JS

<div class="rp-page" dir="rtl">

    <!-- ═══════════ HERO ═══════════ -->
    <div class="rp-hero">
        <div class="rp-hero-bg"></div>
        <div class="rp-hero-content">
            <div class="rp-hero-title">
                <div class="rp-hero-icon">📊</div>
                <div>
                    <h1>تقرير استرداد الفرص الخاسرة</h1>
                    <p>صورة كاملة: الفرص في طابور الاسترداد + نتائج التواصل والرفض والعودة — مع فلاتر وفترة للتضييق</p>
                </div>
            </div>
            <div class="rp-hero-btns">
                <button class="rp-btn rp-btn-light" @onclick="GoBack" title="العودة لطابور الاسترداد">
                    <span class="rp-btn-ico">↩</span><span>عودة للطابور</span>
                </button>
                <button class="rp-btn rp-btn-light" @onclick="LoadReportAsync" disabled="@_loading"
                        title="إعادة تحميل التقرير بآخر الفلاتر">
                    <span class="rp-btn-ico">↻</span><span>@(_loading ? "جارٍ التحميل..." : "تحديث")</span>
                </button>
                <button class="rp-btn rp-btn-primary" @onclick="ExportExcelAsync"
                        disabled="@(_exporting || _result.RowCount == 0)" title="تصدير كل النتائج (وليس الصفحة الحالية)">
                    <span class="rp-btn-ico">⬇</span>
                    <span>@(_exporting ? "جارٍ التصدير..." : "تصدير Excel")</span>
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMsg))
    {
        <div class="rp-err">⚠ @_errorMsg</div>
    }

    <!-- ═══════════ KPI CARDS ═══════════ -->
    <div class="rp-kpis">
        <div class="rp-kpi rp-k-blue">
            <span class="rp-k-ico">🎯</span>
            <div><span class="rp-k-v">@_result.RowCount.ToString("N0")</span><span class="rp-k-l">إجمالي الفرص</span></div>
        </div>
        <div class="rp-kpi rp-k-indigo">
            <span class="rp-k-ico">💰</span>
            <div><span class="rp-k-v">@Money(_result.TotalValue)</span><span class="rp-k-l">إجمالي القيمة</span></div>
        </div>
        <div class="rp-kpi rp-k-green">
            <span class="rp-k-ico">🔁</span>
            <div><span class="rp-k-v">@_result.RevivedCount.ToString("N0")</span><span class="rp-k-l">مُسترد</span></div>
        </div>
        <div class="rp-kpi rp-k-gray">
            <span class="rp-k-ico">📉</span>
            <div><span class="rp-k-v">@_result.UncontactedCount.ToString("N0")</span><span class="rp-k-l">لم يُتواصل</span></div>
        </div>
    </div>

    <!-- ═══════════ SEGMENTED BREAKDOWN ═══════════ -->
    @if (_result.RowCount > 0)
    {
        <div class="rp-segments">
            @{ var total = Math.Max(1, _result.RowCount);
               var pctUn = _result.UncontactedCount * 100.0 / total;
               var pctCon = _result.ContactedCount * 100.0 / total;
               var pctRej = _result.RejectedCount * 100.0 / total;
               var pctRev = _result.RevivedCount * 100.0 / total; }
            <span class="rp-seg rp-seg-gray"><b>لم يُتواصل</b> @_result.UncontactedCount.ToString("N0") <i>@pctUn.ToString("0")%</i><em style="width:@pctUn.ToString("0")%"></em></span>
            <span class="rp-seg rp-seg-amber"><b>قيد المتابعة</b> @_result.ContactedCount.ToString("N0") <i>@pctCon.ToString("0")%</i><em style="width:@pctCon.ToString("0")%"></em></span>
            <span class="rp-seg rp-seg-red"><b>رفض نهائي</b> @_result.RejectedCount.ToString("N0") <i>@pctRej.ToString("0")%</i><em style="width:@pctRej.ToString("0")%"></em></span>
            <span class="rp-seg rp-seg-green"><b>مُسترد</b> @_result.RevivedCount.ToString("N0") <i>@pctRev.ToString("0")%</i><em style="width:@pctRev.ToString("0")%"></em></span>
        </div>
    }
<!-- ═══════════ FILTERS ═══════════ -->
    <div class="rp-filters">
        <div class="rp-f">
            <label>من تاريخ</label>
            <input type="date" value="@_from?.ToString("yyyy-MM-dd")" @onchange="OnFromChange" />
        </div>
        <div class="rp-f">
            <label>إلى تاريخ</label>
            <input type="date" value="@_to?.ToString("yyyy-MM-dd")" @onchange="OnToChange" />
        </div>
        <div class="rp-f">
            <label>الحالة</label>
            <select value="@_status" @onchange="OnStatusChange">
                <option value="all">كل الحالات</option>
                <option value="uncontacted">لم يُتواصل</option>
                <option value="contacting">قيد المتابعة</option>
                <option value="rejected">رفض نهائي</option>
                <option value="revived">مُسترد</option>
            </select>
        </div>
        <div class="rp-f">
            <label>موظف خدمة العملاء</label>
            <select value="@(_empId?.ToString() ?? "")" @onchange="OnEmpChange">
                <option value="">الكل</option>
                @foreach (var e in _csEmployees)
                {
                    <option value="@e.EmployeeId">@e.FullName</option>
                }
            </select>
        </div>
        <div class="rp-f rp-f-grow">
            <label>بحث بالعميل / الهاتف</label>
            <div class="rp-search-box">
                <span class="rp-search-ico">🔍</span>
                <input type="text" placeholder="اسم العميل أو رقم الهاتف..." value="@_q"
                       @oninput="OnSearchTyped" @onkeydown="OnSearchKey" />
                @if (!string.IsNullOrWhiteSpace(_q))
                {
                    <button class="rp-search-clear" @onclick="ClearSearch" title="مسح البحث">×</button>
                }
                <button class="rp-search-go" @onclick="ApplyNow" title="تنفيذ البحث فوراً (أو اضغط Enter)">بحث</button>
            </div>
        </div>
    </div>

    <div class="rp-quick" title="نطاقات زمنية سريعة">
        <button type="button" class="rp-chip @(_quick == "month" ? "rp-chip-on" : "")" @onclick="OnQuickMonth">آخر شهر</button>
        <button type="button" class="rp-chip @(_quick == "quarter" ? "rp-chip-on" : "")" @onclick="OnQuickQuarter">آخر 3 شهور</button>
        <button type="button" class="rp-chip @(_quick == "year" ? "rp-chip-on" : "")" @onclick="OnQuickYear">من أول السنة</button>
        <button type="button" class="rp-chip @(_quick == "all" ? "rp-chip-on" : "")" @onclick="OnQuickAll">كل الفترات</button>
        @if (HasActiveFilters)
        {
            <button type="button" class="rp-chip rp-chip-clearall" @onclick="ClearAllFilters"
                    title="إلغاء كل الفلاتر والبحث وإعادة التحميل">✕ مسح الكل (@ActiveFilterCount)</button>
        }
    </div>

    @if (_loading)
    {
        <div class="rp-loading"><span class="rp-spin"></span><span>يتم تجهيز بيانات التقرير…</span></div>
    }
    else if (_searching)
    {
        <div class="rp-loading"><span class="rp-spin"></span><span>جارٍ البحث…</span></div>
    }
    else if (_result.Rows.Count == 0)
    {
        <div class="rp-empty">
            @if (HasActiveFilters)
            {
                <h3>لا توجد نتائج مطابقة للبحث أو الفلاتر</h3>
                <p>جرّب تعديل الفلترة أو البحث لعرض نطاق أوسع.</p>
            }
            else
            {
                <h3>لا توجد بيانات لتقرير الاسترداد بعد</h3>
            }
        </div>
    }
    else
    {
        <div class="rp-legend">
            <span><b>لم يُتواصل</b> = لا توجد محاولة تواصل مسجلة بعد الخسارة.</span>
            <span><b>قيد المتابعة</b> = تم التواصل ولم يُحسم الأمر بعد.</span>
            <span><b>رفض نهائي</b> = أُغلق ملف متابعة الاسترداد.</span>
            <span><b>مُسترد</b> = عاد العميل لدورة البيع.</span>
        </div>

        @if (_result.RowCount > _result.PageSize)
        {
            <div class="rp-note">يعرض الجدول @_result.Rows.Count من إجمالي @_result.RowCount.ToString("N0") — للتصدير الكامل استخدم زر Excel.</div>
        }
<div class="rp-table-wrap">
            <table class="rp-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>العميل</th>
                        <th>القيمة</th>
                        <th>الحالة</th>
                        <th>سبب الخسارة</th>
                        <th>الإغلاق</th>
                        <th>موظف المتابعة</th>
                        <th>التواصل</th>
                        <th>آخر نشاط</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _result.Rows)
                    {
                        <tr>
                            <td class="rp-mono">
                                <a class="rp-link" href="@($"/crm/opportunities/{r.OpportunityId}")" title="فتح الفرصة">@r.OpportunityId</a>
                            </td>
                            <td>
                                <b>@r.ClientName</b>
                                @if (!string.IsNullOrWhiteSpace(r.Phone))
                                {
                                    <div class="rp-sub">@r.Phone</div>
                                }
                            </td>
                            <td class="rp-val">@Money(r.ExpectedValue)</td>
                            <td><span class="rp-badge @StatusClass(r.StatusAr)">@r.StatusAr</span></td>
                            <td>@(r.LostReasonName ?? "—")</td>
                            <td class="rp-mono">@(r.ClosedAt.HasValue ? r.ClosedAt.Value.ToString("yyyy/MM/dd") : "—")</td>
                            <td>@(r.CsEmployeeName ?? "—")</td>
                            <td class="rp-center">@r.ContactCount</td>
                            <td>
                                @if (r.RevivedDate.HasValue)
                                {
                                    <span class="rp-mono rp-rev">↩ @r.RevivedDate.Value.ToString("yyyy/MM/dd")</span>
                                    @if (!string.IsNullOrWhiteSpace(r.LastCsSummary))
                                    {
                                        <div class="rp-sub" title="@r.LastCsSummary">@Trunc(r.LastCsSummary, 36)</div>
                                    }
                                }
                                else if (r.LastCsDate.HasValue)
                                {
                                    <span class="rp-mono">@r.LastCsDate.Value.ToString("yyyy/MM/dd HH:mm")</span>
                                    @if (!string.IsNullOrWhiteSpace(r.LastCsSummary))
                                    {
                                        <div class="rp-sub" title="@r.LastCsSummary">@Trunc(r.LastCsSummary, 36)</div>
                                    }
                                }
                                else
                                {
                                    <span class="rp-dim">—</span>
                                }
                            </td>
                            <td><a class="rp-mini" href="@($"/crm/customers/{r.PartyId}")" title="ملف العميل">🧾</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ═══════════ PAGER ═══════════ -->
        @if (_result.TotalPages > 1)
        {
            <div class="rp-pager">
                <button class="rp-btn rp-btn-outline" @onclick="PrevPage" disabled="@(_result.PageIndex <= 1 || _searching)">→ السابق</button>
                <span>صفحة @_result.PageIndex من @_result.TotalPages</span>
                <button class="rp-btn rp-btn-outline" @onclick="NextPage" disabled="@(!_result.HasMore || _searching)">التالي ←</button>
            </div>
        }
    }
</div>
<style>
    .rp-page { font-family: 'Tajawal', 'Segoe UI', Tahoma, Arial, sans-serif;
        display: flex; flex-direction: column; gap: 16px;
        max-width: 1320px; margin: 0 auto; padding: 22px;
        --r-ink: #0f172a; --r-mut: #64748b; --r-line: #e2e8f0; }
    .rp-hero { position: relative; border-radius: 20px; overflow: hidden; color: #fff;
        background: linear-gradient(135deg, #1e2a4a 0%, #2b3568 55%, #4338ca 100%); }
    .rp-hero-bg { position: absolute; inset: 0; opacity: .12;
        background: radial-gradient(circle at 85% 20%, #6366f1, transparent 60%),
        radial-gradient(circle at 15% 90%, #4f46e5, transparent 55%); }
    .rp-hero-content { position: relative; display: flex; align-items: center; justify-content: space-between;
        gap: 14px; flex-wrap: wrap; padding: 22px 26px; }
    .rp-hero-title { display: flex; align-items: center; gap: 14px; }
    .rp-hero-icon { font-size: 2.1rem; filter: drop-shadow(0 3px 4px rgba(0,0,0,.25)); }
    .rp-hero-title h1 { margin: 0; font-size: 1.45rem; font-weight: 900; }
    .rp-hero-title p { margin: 5px 0 0; font-size: .9rem; opacity: .88; line-height: 1.55; }
    .rp-hero-btns { display: flex; gap: 8px; flex-wrap: wrap; }
    .rp-btn { border: 0; border-radius: 12px; padding: 11px 17px; cursor: pointer;
        font-family: inherit; font-weight: 800; font-size: .85rem; transition: all .15s ease; }
    .rp-btn:disabled { opacity: .55; cursor: not-allowed; }
    .rp-btn-ico { margin-left: 5px; }
    .rp-btn-primary { background: linear-gradient(135deg, #4f46e5, #6366f1); color: #fff;
        box-shadow: 0 4px 14px rgba(79, 70, 229, .3); }
    .rp-btn-light { background: rgba(255,255,255,.12); color: #fff; border: 1px solid rgba(255,255,255,.25); }
    .rp-btn-outline { background: #fff; color: #334155; border: 1px solid var(--r-line); }
    .rp-btn:not(:disabled):hover { transform: translateY(-1px); filter: brightness(1.04); }
    .rp-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; }
    .rp-kpi { background: #fff; border: 1px solid var(--r-line); border-radius: 16px; padding: 14px 16px;
        display: flex; align-items: center; gap: 14px; box-shadow: 0 4px 14px rgba(15, 23, 42, .05); }
    .rp-k-ico { font-size: 1.7rem; }
    .rp-kpi > div { display: flex; flex-direction: column; gap: 2px; }
    .rp-k-v { font-size: 1.5rem; font-weight: 900; white-space: nowrap; }
    .rp-k-l { font-size: .76rem; color: var(--r-mut); font-weight: 600; }
    .rp-k-blue .rp-k-v { color: #2563eb; } .rp-k-indigo .rp-k-v { color: #4f46e5; }
    .rp-k-green .rp-k-v { color: #059669; } .rp-k-gray .rp-k-v { color: #64748b; }
.rp-segments { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
    .rp-seg { position: relative; background: #fff; border: 1px solid var(--r-line); border-radius: 12px;
        padding: 10px 12px 18px; font-size: .8rem; display: flex; align-items: center; gap: 8px; }
    .rp-seg b { color: #334155; font-weight: 800; }
    .rp-seg i { color: var(--r-mut); font-size: .75rem; font-weight: 800; }
    .rp-seg em { position: absolute; bottom: 4px; left: 8px; right: 8px; height: 5px; border-radius: 4px;
        background: currentColor; opacity: .55; }
    .rp-seg-gray { color: #64748b; background: #f1f5f9; }
    .rp-seg-amber { color: #d97706; background: #fef3c7; }
    .rp-seg-red { color: #dc2626; background: #fee2e2; }
    .rp-seg-green { color: #059669; background: #d1fae5; }
    .rp-filters { display: flex; gap: 12px; flex-wrap: wrap; align-items: flex-end;
        background: #fff; border: 1px solid var(--r-line); border-radius: 16px; padding: 14px;
        position: sticky; top: 8px; z-index: 5; box-shadow: 0 6px 18px rgba(15, 23, 42, .07); }
    .rp-f { display: flex; flex-direction: column; gap: 5px; min-width: 150px; }
    .rp-f-grow { flex: 1 1 240px; }
    .rp-f label { font-size: .76rem; font-weight: 800; color: #334155; }
    .rp-f input[type=date], .rp-f select { border: 1px solid #dbe3f3; border-radius: 10px;
        padding: 9px 10px; font-family: inherit; font-size: .86rem; outline: 0; background: #f8fafc; color: #1e293b; }
    .rp-f input:focus, .rp-f select:focus, .rp-search-box:focus-within { border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, .12); background: #fff; }
    .rp-search-box { flex: 1; display: flex; align-items: center; gap: 8px;
        background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 11px; padding: 0 11px; }
    .rp-search-box input { flex: 1; border: 0; outline: 0; background: transparent; padding: 9px 0;
        font-family: inherit; font-size: .87rem; color: #1e293b; }
    .rp-search-ico { opacity: .55; }
    .rp-search-clear { border: 0; background: #e2e8f0; width: 22px; height: 22px; border-radius: 50%;
        color: #475569; cursor: pointer; font-size: 1rem; line-height: 1; }
    .rp-search-go { border: 0; background: linear-gradient(135deg, #4f46e5, #6366f1); color: #fff;
        border-radius: 9px; padding: 7px 16px; font-family: inherit; font-size: .8rem; font-weight: 800;
        cursor: pointer; white-space: nowrap; }
    .rp-quick { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .rp-chip { border: 1px solid #dbe3f3; background: #fff; color: #475569;
        border-radius: 100px; padding: 7px 14px; font-family: inherit; font-size: .8rem;
        font-weight: 700; cursor: pointer; transition: all .15s ease; }
    .rp-chip:hover { border-color: #6366f1; color: #4338ca; }
    .rp-chip-on { background: linear-gradient(135deg, #4f46e5, #6366f1); color: #fff; border-color: transparent; }
    .rp-chip-clearall { background: #fee2e2; color: #b91c1c; border: 1px dashed #fca5a5; }
.rp-legend { display: flex; gap: 14px; flex-wrap: wrap; padding: 10px 14px;
        background: #f8fafc; border: 1px dashed #c7d2fe; border-radius: 12px;
        color: var(--r-mut); font-size: .78rem; line-height: 1.6; }
    .rp-legend b { color: #334155; }
    .rp-err { background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c;
        border-radius: 12px; padding: 11px 15px; font-size: .84rem; font-weight: 600; }
    .rp-loading { display: flex; align-items: center; justify-content: center; gap: 10px;
        padding: 60px 0; color: var(--r-mut); font-weight: 700; }
    .rp-spin { width: 26px; height: 26px; border-radius: 50%;
        border: 3px solid #e0e7ff; border-top-color: #4f46e5; animation: rpspin .8s linear infinite; }
    @@keyframes rpspin { to { transform: rotate(360deg); } }
    .rp-empty { text-align: center; padding: 24px; color: var(--r-mut);
        background: #fff; border: 1px dashed #c7d2fe; border-radius: 14px; }
    .rp-empty h3 { margin: 0 0 6px; color: #334155; font-size: 1.05rem; }
    .rp-empty p { margin: 0; font-size: .85rem; }
    .rp-note { text-align: right; font-size: .8rem; color: var(--r-mut); padding: 9px 13px;
        background: #f8fafc; border: 1px dashed #c7d2fe; border-radius: 10px; }
    .rp-table-wrap { background: #fff; border: 1px solid var(--r-line);
        border-radius: 16px; overflow: auto; max-height: 68vh; }
    .rp-table { border-collapse: collapse; width: 100%; min-width: 1020px; font-size: .84rem; }
    .rp-table th { position: sticky; top: 0; background: #f8fafc; color: #334155;
        font-weight: 800; text-align: right; padding: 10px 12px;
        border-bottom: 2px solid var(--r-line); white-space: nowrap; }
    .rp-table td { padding: 9px 12px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }
    .rp-table tbody tr:hover { background: #f8fafc; }
    .rp-mono { font-size: .8rem; color: #475569; white-space: nowrap; }
    .rp-val { font-weight: 800; color: var(--r-ink); white-space: nowrap; }
    .rp-center { text-align: center; }
    .rp-sub { font-size: .74rem; color: var(--r-mut); margin-top: 2px; }
    .rp-dim { color: #cbd5e1; }
    .rp-rev { color: #047857; font-weight: 800; }
    .rp-link { color: #4f46e5; font-weight: 700; text-decoration: none; }
    .rp-link:hover { text-decoration: underline; }
    .rp-mini { text-decoration: none; }
    .rp-badge { display: inline-flex; font-size: .73rem; font-weight: 800;
        padding: 3px 10px; border-radius: 100px; white-space: nowrap; }
    .rp-b-red { background: #fee2e2; color: #b91c1c; }
    .rp-b-green { background: #d1fae5; color: #047857; }
    .rp-b-amber { background: #fef3c7; color: #92400e; }
    .rp-b-gray { background: #e2e8f0; color: #475569; }
    .rp-b-indigo { background: #e0e7ff; color: #4338ca; }
    .rp-pager { display: flex; align-items: center; justify-content: center; gap: 12px; }
</style>
@code {
    private string _userName = "";
    private bool _canView;
    private bool _loading = true;
    private bool _searching;
    private bool _exporting;

    private DateTime? _from;
    private DateTime? _to;
    private string? _quick = "all";
    private string _status = "all";
    private int? _empId;
    private string _q = "";
    private string? _errorMsg;

    private List<RecoveryEmployeeOptionDto> _csEmployees = new();
    private RecoveryReportResultDto _result = new();
    private CancellationTokenSource? _cts;
    private int _loadSeq;

    private const int _pageSize = 50;

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        var user = auth.User;
        _canView = RecoveryPermissions.CanView(user);
        if (!_canView)
        {
            Nav.NavigateTo("/");
            return;
        }
        _userName = user.Identity?.Name ?? "";
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        var seq = ++_loadSeq;
        _loading = true;
        _searching = false;
        _errorMsg = null;
        try
        {
            if (_csEmployees.Count == 0)
                _csEmployees = await Recovery.GetCustomerServiceEmployeesLightAsync();

            _result = await Recovery.GetRecoveryReportAsync(CurrentFilter(), 1, _pageSize);
            if (seq != _loadSeq) return; // وصل طلب أحدث — نتجاهل النتيجة القديمة
        }
        catch (Exception ex)
        {
            if (seq == _loadSeq)
            {
                _errorMsg = "خطأ في تحميل التقرير: " + ex.Message;
                StateHasChanged();
            }
        }
        finally
        {
            if (seq == _loadSeq)
            {
                _loading = false;
                // ⭐ البحث/الفلاتر/الشرائح تُطلق من أحداث void (fire-and-forget) —
                //    بدون StateHasChanged لا يُعاد رسم الجدول بعد اكتمال الاستعلام
                StateHasChanged();
            }
        }
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || page > _result.TotalPages || _loading || _searching) return;
        var seq = ++_loadSeq;
        _searching = true;
        _errorMsg = null;
        try
        {
            _result = await Recovery.GetRecoveryReportAsync(CurrentFilter(), page, _pageSize);
            if (seq != _loadSeq) return;
        }
        catch (Exception ex)
        {
            if (seq == _loadSeq)
            {
                _errorMsg = "خطأ في التحميل: " + ex.Message;
                StateHasChanged();
            }
        }
        finally
        {
            if (seq == _loadSeq)
            {
                _searching = false;
                StateHasChanged();
            }
        }
    }

    private void PrevPage() => _ = GoToPageAsync((_result.PageIndex - 1));
    private void NextPage() => _ = GoToPageAsync((_result.PageIndex + 1));

    private RecoveryReportFilterDto CurrentFilter() => new()
    {
        From = _from,
        To = _to,
        Status = _status,
        CsEmployeeId = _empId,
        SearchText = string.IsNullOrWhiteSpace(_q) ? null : _q.Trim()
    };

    private void GoBack() => Nav.NavigateTo("/crm/lost-recovery");

    private void SetQuick(string k)
    {
        _quick = k;
        var today = DateTime.Today;
        switch (k)
        {
            case "month": _from = today.AddMonths(-1); _to = today; break;
            case "year": _from = new DateTime(today.Year, 1, 1); _to = today; break;
            case "all": _from = null; _to = null; break;
            default: _from = today.AddMonths(-3); _to = today; break;
        }
        _ = LoadReportAsync();
    }

    private void OnQuickMonth() => SetQuick("month");
    private void OnQuickQuarter() => SetQuick("quarter");
    private void OnQuickYear() => SetQuick("year");
    private void OnQuickAll() => SetQuick("all");

    private void OnFromChange(ChangeEventArgs e) { _from = ParseDate(e.Value?.ToString()); _quick = null; _ = LoadReportAsync(); }
    private void OnToChange(ChangeEventArgs e) { _to = ParseDate(e.Value?.ToString()); _quick = null; _ = LoadReportAsync(); }
    private void OnStatusChange(ChangeEventArgs e) { _status = e.Value?.ToString() ?? "all"; _ = LoadReportAsync(); }
    private void OnEmpChange(ChangeEventArgs e)
    {
        var s = e.Value?.ToString();
        _empId = string.IsNullOrWhiteSpace(s) ? (int?)null : (int.TryParse(s, out var v) ? v : (int?)null);
        _ = LoadReportAsync();
    }

    // ═══════ البحث — debounce + إلغاء + حارس _loadSeq ═══════
    private void OnSearchTyped(ChangeEventArgs e)
    {
        _q = e.Value?.ToString() ?? "";
        _ = DelayedSearch();
    }

    private async Task DelayedSearch()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        try
        {
            await Task.Delay(500, token);
            if (!token.IsCancellationRequested)
                await LoadReportAsync();
        }
        catch (TaskCanceledException) { /* تجاهل */ }
    }

    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _cts?.Cancel();
            _ = LoadReportAsync();
        }
    }

    private void ApplyNow() { _cts?.Cancel(); _ = LoadReportAsync(); }

    private void ClearSearch() { _q = ""; _cts?.Cancel(); _ = LoadReportAsync(); }

    private void ClearAllFilters()
    {
        _q = "";
        _status = "all";
        _empId = null;
        _quick = "all";
        _from = null;
        _to = null;
        _cts?.Cancel();
        _ = LoadReportAsync();
    }

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_q)
        || _status != "all"
        || _empId.HasValue
        || _from.HasValue
        || _to.HasValue;

    private int ActiveFilterCount =>
        (string.IsNullOrWhiteSpace(_q) ? 0 : 1)
        + (_status != "all" ? 1 : 0)
        + (_empId.HasValue ? 1 : 0)
        + (_from.HasValue ? 1 : 0)
        + (_to.HasValue ? 1 : 0);
private static DateTime? ParseDate(string? s)
        => DateTime.TryParse(s, out var d) ? d : (DateTime?)null;

    private async Task ExportExcelAsync()
    {
        if (_exporting || _result.RowCount == 0) return;
        _exporting = true;
        _errorMsg = null;
        try
        {
            var full = await Recovery.GetRecoveryReportAsync(CurrentFilter(), 1, 0); // pageSize 0 = الكل
            using var wb = new XLWorkbook();
            var ws = wb.Worksheets.Add("تقرير الاسترداد");
            string[] hdrs =
            {
                "#", "العميل", "الهاتف", "القيمة (ج.م)", "الحالة", "سبب الخسارة",
                "تاريخ الإغلاق", "موظف المتابعة", "عدد التواصل",
                "آخر تواصل (تاريخ)", "آخر تواصل (موضوع)", "تاريخ العودة"
            };
            for (int i = 0; i < hdrs.Length; i++)
            {
                var c = ws.Cell(1, i + 1);
                c.Value = hdrs[i];
                c.Style.Font.Bold = true;
                c.Style.Fill.BackgroundColor = XLColor.FromHtml("#1e3a8a");
                c.Style.Font.FontColor = XLColor.White;
            }
            int row = 2;
            foreach (var r in full.Rows)
            {
                ws.Cell(row, 1).Value = r.OpportunityId;
                ws.Cell(row, 2).Value = r.ClientName;
                ws.Cell(row, 3).Value = r.Phone ?? "";
                ws.Cell(row, 4).Value = r.ExpectedValue.HasValue ? (double)r.ExpectedValue.Value : 0d;
                ws.Cell(row, 5).Value = r.StatusAr;
                ws.Cell(row, 6).Value = r.LostReasonName ?? "";
                ws.Cell(row, 7).Value = r.ClosedAt.HasValue ? r.ClosedAt.Value.ToString("yyyy/MM/dd") : "";
                ws.Cell(row, 8).Value = r.CsEmployeeName ?? "";
                ws.Cell(row, 9).Value = r.ContactCount;
                ws.Cell(row, 10).Value = r.LastCsDate.HasValue ? r.LastCsDate.Value.ToString("yyyy/MM/dd HH:mm") : "";
                ws.Cell(row, 11).Value = r.LastCsSummary ?? "";
                ws.Cell(row, 12).Value = r.RevivedDate.HasValue ? r.RevivedDate.Value.ToString("yyyy/MM/dd") : "";
                row++;
            }
            ws.Columns().AdjustToContents();
            ws.RightToLeft = true;
            ws.SheetView.FreezeRows(1);

            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            var b64 = Convert.ToBase64String(ms.ToArray());
            await JS.InvokeVoidAsync("downloadFile",
                $"RecoveryReport_{DateTime.Now:yyyyMMdd_HHmm}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                b64);
            _errorMsg = null;
        }
        catch (Exception ex)
        {
            _errorMsg = "فشل التصدير: " + ex.Message;
        }
        finally
        {
            _exporting = false;
        }
    }

    private static string Money(decimal? v)
        => v.HasValue ? v.Value.ToString("N0", CultureInfo.InvariantCulture) + " ج.م" : "—";

    private static string? Trunc(string? s, int n)
        => string.IsNullOrWhiteSpace(s) ? null : (s.Length <= n ? s : s[..n] + "…");

    private static string StatusClass(string status) => status switch
    {
        "رفض نهائي" => "rp-b-red",
        "مُسترد" => "rp-b-green",
        "قيد المتابعة" => "rp-b-amber",
        "لم يُتواصل" => "rp-b-gray",
        _ => "rp-b-indigo"
    };
}
