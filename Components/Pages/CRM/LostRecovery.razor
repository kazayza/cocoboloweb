@code {
    private string _userName = "";
    private ClaimsPrincipal? _user;   // ⭐ تُمرَّر للخدمة — التحصين في طبقة الخدمة لا الواجهة فقط
    private bool _canView;
    private bool _canRevive;

    private bool _loading = true;
    private bool _busy;
    private bool _exporting;

    private RecoveryStatsDto _stats = new();
    private List<LostRecoveryItemDto> _items = new();
    private List<SalesStage> _stages = new();
    private List<RecoveryHistoryDto> _history = new();

    private string? _successMsg;

    private string _q = "";
    private string _kind = "all";
    private bool _candidateOnly;
    private bool _mineOnly;
    private bool _lateOnly;
    private string _sortBy = "value";
    private int _myEmpId;

    // ترحيل / تحميل تدريجي
    private const int _pageSize = 12;
    private int _page = 1;
    private int _total;
    private bool _hasMore;
    private bool _loadingMore;
    private bool _searching;      // مؤشر بحث خفيف (بدون محو القائمة)
    private int _loadSeq;         // تسلسل يمنع عرض نتائج قديمة متأخرة
    private int _restoredPages;   // صفحات محفوظة تُعاد عند الرجوع

    // نوافذ
    private LostRecoveryItemDto? _sel;
    private bool _showContact;
    private bool _showHistory;
    private bool _showRevive;
    private string? _errorMsg;

    // نموذج التواصل
    private string _channel = "اتصال";
    private string _outcome = "تم التواصل";
    private string _summary = "";
    private DateTime? _followUp;

    // نموذج الاسترداد
    private bool _same = true;
    private int _revStageId;
    private string _revProduct = "";
    private string _revNotes = "";
    private decimal? _revValue;

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        var user = auth.User;
        _user = user;
        _canView = RecoveryPermissions.CanView(user);
        if (!_canView)
        {
            Nav.NavigateTo("/");
            return;
        }

        _canRevive = RecoveryPermissions.CanRevive(user);
        _userName = user.Identity?.Name ?? "";

        RestoreSavedState();
        await LoadInitialAsync();
    }

    // ───── تثبيت الحالة (فلتر + مكان "تحميل المزيد") عند الرجوع للصفحة ─────
    private void RestoreSavedState()
    {
        var s = Recovery.QueueState;
        if (!s.Saved) return;
        _q = s.SearchText ?? "";
        _kind = s.Kind;
        _candidateOnly = s.CandidateOnly;
        _mineOnly = s.MineOnly;
        _lateOnly = s.LateOnly;
        _sortBy = s.SortBy;
        _restoredPages = Math.Clamp((int)Math.Ceiling(s.LoadedCount / (double)_pageSize), 0, 60);
    }

    private void SaveState()
    {
        var s = Recovery.QueueState;
        s.Saved = true;
        s.SearchText = _q;
        s.Kind = _kind;
        s.CandidateOnly = _candidateOnly;
        s.MineOnly = _mineOnly;
        s.LateOnly = _lateOnly;
        s.SortBy = _sortBy;
        s.LoadedCount = _items.Count;
        s.TotalCount = _total;
    }

    private LostRecoveryFilterDto CurrentFilter() => new()
    {
        SearchText = string.IsNullOrWhiteSpace(_q) ? null : _q.Trim(),
        Kind = _kind,
        CandidateOnly = _candidateOnly ? true : null,
        MineOnly = _mineOnly,
        LateOnly = _lateOnly ? true : null,
        SortBy = _sortBy,
        MinValue = null
    };

    // التحميل الأولي عند الدخول أو زر "تحديث" — ينفّذ الصيانة (توزيع + تذكير) مرة واحدة فقط
    private async Task LoadInitialAsync()
    {
        _loading = true;
        _errorMsg = null;
        try
        {
            await Recovery.RunQueueMaintenanceAsync();

            _stages = await Recovery.GetRecoveryStagesAsync();
            _myEmpId = await Recovery.GetCurrentCsEmployeeIdAsync(_userName);
            _stats = await Recovery.GetStatsAsync();

            var page = await Recovery.GetQueueAsync(CurrentFilter(), 1, _pageSize, _userName);
            _items = page.Items;
            _total = page.TotalCount;
            _page = page.PageIndex;
            _hasMore = page.HasMore;

            // استعادة نفس عدد الصفحات التي كان وصل إليها المستخدم عبر "تحميل المزيد"
            for (int p = 2; p <= _restoredPages && _hasMore; p++)
            {
                var extra = await Recovery.GetQueueAsync(CurrentFilter(), p, _pageSize, _userName);
                if (extra.Items.Count == 0)
                {
                    _hasMore = extra.HasMore;
                    break;
                }
                _items.AddRange(extra.Items);
                _total = extra.TotalCount;
                _page = extra.PageIndex;
                _hasMore = extra.HasMore;
            }
            _restoredPages = 0;

            if (_revStageId == 0 && _stages.Count > 0)
                _revStageId = _stages.First().StageId;

            SaveState();
        }
        catch (Exception ex)
        {
            _errorMsg = "فشل التحميل: " + ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    // تحديث هادئ بعد إجراء (حفظ تواصل / استرداد) بنفس الفلاتر الحالية — بدون صيانة
    private async Task RefreshAsync()
    {
        _errorMsg = null;
        try
        {
            _stats = await Recovery.GetStatsAsync();
            var page = await Recovery.GetQueueAsync(CurrentFilter(), 1, _pageSize, _userName);
            _items = page.Items;
            _total = page.TotalCount;
            _page = page.PageIndex;
            _hasMore = page.HasMore;
            SaveState();
        }
        catch (Exception ex)
        {
            _errorMsg = "فشل التحديث: " + ex.Message;
        }
    }

    private async Task ReloadAll() => await LoadInitialAsync();

    // ───── التقرير الشامل ─────
    private void GoToReport() => Nav.NavigateTo("/crm/lost-recovery/report");

    // ───── تصدير Excel للطابور حسب الفلاتر الحالية ─────
    private async Task ExportExcelAsync()
    {
        if (_exporting || _items.Count == 0) return;
        _exporting = true;
        _errorMsg = null;
        try
        {
            var filter = new LostRecoveryFilterDto
            {
                SearchText = string.IsNullOrWhiteSpace(_q) ? null : _q.Trim(),
                Kind = _kind,
                CandidateOnly = _candidateOnly ? true : null,
                MineOnly = _mineOnly,
                LateOnly = _lateOnly ? true : null,
                SortBy = _sortBy,
                MinValue = null
            };
            var page = await Recovery.GetQueueAsync(filter, 1, 5000, _userName);
            var rows = page.Items;
            if (rows.Count == 0)
            {
                _successMsg = "لا توجد بيانات مطابقة للتصدير.";
                return;
            }

            using var wb = new XLWorkbook();
            var ws = wb.Worksheets.Add("الاسترداد");
            string[] hdrs =
            {
                "#", "العميل", "الهاتف", "القيمة (ج.م)", "الحالة", "سبب الخسارة",
                "تاريخ الإغلاق", "أيام منذ الإغلاق", "موظف المتابعة",
                "آخر تواصل", "موعد المتابعة", "متأخرة"
            };
            for (int i = 0; i < hdrs.Length; i++)
            {
                var c = ws.Cell(1, i + 1);
                c.Value = hdrs[i];
                c.Style.Font.Bold = true;
                c.Style.Fill.BackgroundColor = XLColor.FromHtml("#4f46e5");
                c.Style.Font.FontColor = XLColor.White;
            }

            int row = 2;
            foreach (var it in rows)
            {
                ws.Cell(row, 1).Value = it.OpportunityId;
                ws.Cell(row, 2).Value = it.ClientName;
                ws.Cell(row, 3).Value = it.Phone ?? "";
                ws.Cell(row, 4).Value = it.ExpectedValue.HasValue
                    ? (double)it.ExpectedValue.Value : 0d;
                ws.Cell(row, 5).Value = it.StageNameAr ?? "";
                ws.Cell(row, 6).Value = it.LostReasonNameAr ?? "";
                ws.Cell(row, 7).Value = it.ClosedAt.HasValue
                    ? it.ClosedAt.Value.ToString("yyyy/MM/dd") : "";
                ws.Cell(row, 8).Value = it.DaysSinceClosed;
                ws.Cell(row, 9).Value = it.RecoveryEmployeeName ?? "";
                ws.Cell(row, 10).Value = it.LastCsDate.HasValue
                    ? $"{it.LastCsDate.Value:yyyy/MM/dd} {it.LastCsBy}".Trim() : "";
                ws.Cell(row, 11).Value = it.NextFollowUpDate.HasValue
                    ? it.NextFollowUpDate.Value.ToString("yyyy/MM/dd") : "";
                ws.Cell(row, 12).Value = it.IsFollowUpOverdue ? "نعم" : "لا";
                row++;
            }

            ws.Columns().AdjustToContents();
            ws.RightToLeft = true;
            ws.SheetView.FreezeRows(1);

            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            var b64 = Convert.ToBase64String(ms.ToArray());
            await JS.InvokeVoidAsync("downloadFile",
                $"LostRecovery_{DateTime.Now:yyyyMMdd_HHmm}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                b64);
            _successMsg = $"تم تصدير {rows.Count} فرصة ✓";
        }
        catch (Exception ex)
        {
            _errorMsg = "فشل التصدير: " + ex.Message;
        }
        finally
        {
            _exporting = false;
        }
    }

    // ───── الفلاتر ─────
    private CancellationTokenSource? _cts;

    private void OnSearchTyped(ChangeEventArgs e)
    {
        _q = e.Value?.ToString() ?? "";
        _ = DelayedApply();
    }

    private async Task DelayedApply()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        try
        {
            await Task.Delay(350, token);
            if (!token.IsCancellationRequested)
                await ApplyFilters();
        }
        catch (TaskCanceledException) { /* تجاهل */ }
    }

    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _cts?.Cancel();
            _ = ApplyFilters();
        }
    }

    private void ClearSearch()
    {
        _q = "";
        _cts?.Cancel();   // ⭐ إلغاء أي بحث مؤجل حتى لا يعيد التنفيذ بعد المسح
        _ = ApplyFilters();
    }

    // ⭐ تنفيذ فوري (زر «بحث» / Enter) — يلغي التأجيل المعلق ثم يطبّق
    private void ApplyNow()
    {
        _cts?.Cancel();
        _ = ApplyFilters();
    }

    // ⭐ إلغاء كل الفلاتر والبحث والعودة للترتيب الافتراضي
    private void ClearAllFilters()
    {
        _q = "";
        _kind = "all";
        _candidateOnly = false;
        _lateOnly = false;
        _mineOnly = false;
        _sortBy = "value";
        _cts?.Cancel();
        _ = ApplyFilters();
    }

    // ⭐ هل هناك بحث/فلتر مفعّل؟ (لزر «مسح الكل» وتمييز القائمة الفارغة)
    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_q)
        || _kind != "all"
        || _candidateOnly
        || _lateOnly
        || _mineOnly;

    private int ActiveFilterCount =>
        (string.IsNullOrWhiteSpace(_q) ? 0 : 1)
        + (_kind != "all" ? 1 : 0)
        + (_candidateOnly ? 1 : 0)
        + (_lateOnly ? 1 : 0)
        + (_mineOnly ? 1 : 0);

    private void SetKind(string k)
    {
        _kind = k;
        _ = ApplyFilters();
    }

    private void ToggleCandidate()
    {
        _candidateOnly = !_candidateOnly;
        _ = ApplyFilters();
    }

    private void ToggleMine()
    {
        _mineOnly = !_mineOnly;
        _ = ApplyFilters();
    }

    private void ToggleLate()
    {
        _lateOnly = !_lateOnly;
        _ = ApplyFilters();
    }

    private void OnSortChange(ChangeEventArgs e)
    {
        _sortBy = e.Value?.ToString() ?? "value";
        _ = ApplyFilters();
    }

    private async Task ApplyFilters()
    {
        var seq = ++_loadSeq;
        _searching = true;
        try
        {
            var page = await Recovery.GetQueueAsync(CurrentFilter(), 1, _pageSize, _userName);
            if (seq != _loadSeq) return; // وصل طلب أحدث — نتجاهل النتيجة القديمة
            _items = page.Items;
            _total = page.TotalCount;
            _page = page.PageIndex;
            _hasMore = page.HasMore;
            SaveState();
        }
        catch (Exception ex)
        {
            if (seq == _loadSeq) _errorMsg = "فشل البحث: " + ex.Message;
        }
        finally
        {
            if (seq == _loadSeq) _searching = false;
        }
    }

    // ───── التحميل التدريجي: الصفحة التالية ─────
    private async Task LoadMoreAsync()
    {
        if (_busy || _loadingMore || !_hasMore) return;
        _loadingMore = true;
        try
        {
            var page = await Recovery.GetQueueAsync(CurrentFilter(), _page + 1, _pageSize, _userName);
            _items.AddRange(page.Items);
            _total = page.TotalCount;
            _page = page.PageIndex;
            _hasMore = page.HasMore;
            SaveState();
        }
        finally
        {
            _loadingMore = false;
        }
    }

    // ───── التواصل ─────
    private void OpenContact(LostRecoveryItemDto it)
    {
        _sel = it;
        _channel = "اتصال";
        _outcome = "تم التواصل";
        _summary = "";
        _followUp = null;
        _errorMsg = null;
        _showContact = true;
    }

    private void OnFollowUpChange(ChangeEventArgs e)
    {
        var s = e.Value?.ToString();
        _followUp = DateTime.TryParse(s, out var d) ? d : (DateTime?)null;
    }

    private async Task SubmitContact()
    {
        if (_sel == null) return;
        if (string.IsNullOrWhiteSpace(_summary))
        {
            _errorMsg = "اكتب ملخص التواصل أولًا.";
            return;
        }

        _busy = true;
        _errorMsg = null;
        try
        {
            var outcome = _outcome;
            var (ok, msg) = await Recovery.LogContactAsync(new RecoveryContactDto
            {
                OpportunityId = _sel.OpportunityId,
                PartyId = _sel.PartyId,
                Channel = _channel,
                Outcome = outcome,
                Summary = _summary.Trim(),
                NextFollowUpDate = _followUp
            }, _userName, _user);

            if (ok)
            {
                CloseModals();
                await RefreshAsync();
                _successMsg = msg;
            }
            else
            {
                _errorMsg = msg;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    // ───── سجل التواصل بعد الخسارة ─────
    private async Task OpenHistory(LostRecoveryItemDto it)
    {
        _sel = it;
        _history = new List<RecoveryHistoryDto>();
        _errorMsg = null;
        _showHistory = true;
        try
        {
            _history = await Recovery.GetRecoveryHistoryAsync(it.OpportunityId);
        }
        catch (Exception ex)
        {
            _errorMsg = ex.Message;
        }
    }

    // ───── الاسترداد ─────
    private void OpenRevive(LostRecoveryItemDto it)
    {
        _sel = it;
        _same = true;
        _revStageId = _stages.Count > 0 ? _stages.First().StageId : 0;
        _revValue = it.ExpectedValue;
        _revProduct = it.InterestedProduct ?? "";
        _revNotes = "";
        _errorMsg = null;
        _showRevive = true;
    }

    private void OnRevValueChange(ChangeEventArgs e)
    {
        var s = e.Value?.ToString();
        _revValue = decimal.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out var v) ? v : (decimal?)null;
    }

    private async Task SubmitRevive()
    {
        if (_sel == null) return;
        _busy = true;
        _errorMsg = null;
        try
        {
            var (ok, msg, newId) = await Recovery.ReviveAsync(new RecoveryReviveDto
            {
                OpportunityId = _sel.OpportunityId,
                SameOpportunity = _same,
                NewStageId = _revStageId,
                ExpectedValue = _revValue,
                NextFollowUpDate = DateTime.Today.AddDays(3),
                NewInterestedProduct = _same ? null : _revProduct,
                Notes = string.IsNullOrWhiteSpace(_revNotes) ? null : _revNotes.Trim()
            }, _userName, _user);

            if (ok)
            {
                CloseModals();
                await RefreshAsync();
            }
            else
            {
                _errorMsg = msg;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    // ───── عام ─────
    private void CloseModals()
    {
        _showContact = false;
        _showHistory = false;
        _showRevive = false;
        _sel = null;
        _errorMsg = null;
    }

    private void DismissToast() => _successMsg = null;

    private void Noop() { } // لالتقاط أحداث النقر داخل النافذة ومنعها من إغلاقها

    private static string Money(decimal? v)
        => v.HasValue ? v.Value.ToString("N0", CultureInfo.InvariantCulture) + " ج.م" : "—";
    private static string? Trunc(string? s, int n)
        => string.IsNullOrWhiteSpace(s) ? null : (s.Length <= n ? s : s[..n] + "…");
    private static string AvatarLetter(string name)
        => string.IsNullOrWhiteSpace(name) ? "؟" : name.Trim()[..1].ToString();

    private static string SoftColor(string? hex)
        => string.IsNullOrWhiteSpace(hex) ? "#eef2f7" : hex + "33";

    private static string WaHref(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return "#";
        var digits = new string(phone.Where(char.IsDigit).ToArray());
        return "https://wa.me/2" + digits;
    }
