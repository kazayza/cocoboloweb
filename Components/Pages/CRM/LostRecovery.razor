@page "/crm/lost-recovery"
@attribute [Authorize]

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Models
@using COCOBOLOERPNEW.Services
@using System.Globalization
@using System.Security.Claims
@using ClosedXML.Excel
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using MudSize = MudBlazor.Size
@using MudColor = MudBlazor.Color

@inject RecoveryService Recovery
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth
@inject IJSRuntime JS

<div class="lr-page" dir="rtl">

    <!-- ═══════════ HERO ═══════════ -->
    <div class="lr-hero">
        <div class="lr-hero-bg"></div>
        <div class="lr-hero-content">
            <div class="lr-hero-title">
                <div class="lr-hero-icon">🔁</div>
                <div>
                    <h1>استرداد الفرص الخاسرة</h1>
                    <p>وحدة متابعة العملاء — تواصل مع العملاء اللي وصلوا مرحلة خسارة/غير مهتم وأعدهم لدورة البيع</p>
                </div>
            </div>
            <div class="lr-hero-btns">
                <button class="lr-btn lr-btn-light" @onclick="ReloadAll">
                    <span class="lr-btn-ico">↻</span>
                    <span>تحديث</span>
                </button>
                <button class="lr-btn lr-btn-light" @onclick="GoToReport" title="تقرير شامل بالاسترداد">
                    <span class="lr-btn-ico">📄</span>
                    <span>التقرير</span>
                </button>
                <button class="lr-btn lr-btn-light" @onclick="ExportExcelAsync"
                        disabled="@(_exporting || _items.Count == 0)" title="تصدير الطابور الحالي Excel (بحد أقصى 5000 صف)">
                    <span class="lr-btn-ico">⬇</span>
                    <span>@(_exporting ? "جارٍ التصدير..." : "تصدير Excel")</span>
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_successMsg))
    {
        <div class="lr-toast" @onclick="DismissToast" title="اضغط للإغلاق">
            <span>@_successMsg</span>
            <span class="lr-toast-x">✕</span>
        </div>
    }

    @if (_loading)
    {
        <div class="lr-loading"><div class="lr-spin"></div><span>يتم الآن تجهيز فرص المتابعة…</span></div>
    }
    else
    {
        <!-- ═══════════ KPI CARDS ═══════════ -->
        <div class="lr-kpis">
            <div class="lr-kpi lr-kpi-red">
                <div class="lr-kpi-ico">📉</div>
                <div class="lr-kpi-body">
                    <span class="lr-kpi-val">@_stats.LostCount.ToString("N0")</span>
                    <span class="lr-kpi-lbl">فرصة خاسرة بانتظار المتابعة</span>
                </div>
            </div>
            <div class="lr-kpi lr-kpi-indigo">
                <div class="lr-kpi-ico">💰</div>
                <div class="lr-kpi-body">
                    <span class="lr-kpi-val">@Money(_stats.LostValue)</span>
                    <span class="lr-kpi-lbl">إجمالي القيمة المتوقعة</span>
                </div>
            </div>
            <div class="lr-kpi lr-kpi-amber">
                <div class="lr-kpi-ico">⏳</div>
                <div class="lr-kpi-body">
                    <span class="lr-kpi-val">@_stats.UnassignedCount.ToString("N0")</span>
                    <span class="lr-kpi-lbl">بانتظار التوزيع التلقائي</span>
                </div>
            </div>
            <div class="lr-kpi lr-kpi-green">
                <div class="lr-kpi-ico">✅</div>
                <div class="lr-kpi-body">
                    <span class="lr-kpi-val">@_stats.RevivedThisMonth.ToString("N0")</span>
                    <span class="lr-kpi-lbl">عميل استُرد هذا الشهر</span>
                </div>
            </div>
            <div class="lr-kpi lr-kpi-rose">
                <div class="lr-kpi-ico">📞</div>
                <div class="lr-kpi-body">
                    <span class="lr-kpi-val">@_stats.UncontactedCount.ToString("N0")</span>
                    <span class="lr-kpi-lbl">مسندة ولم يُتواصل معها بعد</span>
                </div>
            </div>
        </div>

        <!-- ═══════════ FILTER BAR ═══════════ -->
        <div class="lr-filters">
            <div class="lr-search">
                <span class="lr-search-ico">🔍</span>
                <input type="text" placeholder="ابحث بالعميل أو الهاتف..." value="@_q"
                       @oninput="OnSearchTyped" @onkeydown="OnSearchKey" />
                @if (!string.IsNullOrWhiteSpace(_q))
                {
                    <button class="lr-search-clear" @onclick="ClearSearch" title="مسح البحث">×</button>
                }
                <button class="lr-search-go" @onclick="ApplyNow"
                        title="تنفيذ البحث فوراً (أو اضغط Enter) — التنفيذ تلقائي أيضاً بعد 350ms">بحث</button>
            </div>

            <select class="lr-sort" value="@_sortBy" @onchange="OnSortChange" title="ترتيب القائمة">
                <option value="value">الأعلى قيمة</option>
                <option value="recent">الأحدث خسارة</option>
                <option value="days">الأقدم خسارة</option>
                <option value="followup">الأقرب موعد متابعة</option>
            </select>

            <div class="lr-chips">
                <button class="lr-chip @(_kind == "all" ? "lr-chip-on" : "")" @onclick='() => SetKind("all")'>الكل</button>
                <button class="lr-chip @(_kind == "lost" ? "lr-chip-on" : "")" @onclick='() => SetKind("lost")'>خسارة</button>
                <button class="lr-chip @(_kind == "notinterested" ? "lr-chip-on" : "")" @onclick='() => SetKind("notinterested")'>غير مهتم</button>
                <button class="lr-chip @(_candidateOnly ? "lr-chip-on" : "")" @onclick="ToggleCandidate"
                        title="الفرص اللي مندوب المبيعات رشّحها للاسترداد">⭐ مرشحة للاسترداد</button>
                <button class="lr-chip @(_lateOnly ? "lr-chip-late" : "")" @onclick="ToggleLate"
                        title="الفرص اللي فات موعد المتابعة المحدد ليها">⏰ متأخرة فقط</button>
                @if (_myEmpId > 0)
                {
                    <button class="lr-chip @(_mineOnly ? "lr-chip-on" : "")" @onclick="ToggleMine"
                            title="القضايا المسندة لي أنا فقط">👤 قضاياي</button>
                }
                @if (HasActiveFilters)
                {
                    <button class="lr-chip lr-chip-clearall" @onclick="ClearAllFilters"
                            title="إلغاء كل الفلاتر والبحث والعودة للقائمة الكاملة بالترتيب الافتراضي">
                        ✕ مسح الكل (@ActiveFilterCount)
                    </button>
                }
            </div>
        </div>

        @if (_items.Count == 0)
        {
            <div class="lr-empty">
                <div class="lr-empty-ico"></div>
                @if (HasActiveFilters)
                {
                    <h3>لا توجد نتائج مطابقة للبحث أو الفلاتر الحالية</h3>
                    <p>جرّب تعديل كلمات البحث أو إلغاء بعض الفلاتر لعرض قائمة أوسع.</p>
                    <button class="lr-btn lr-btn-primary" @onclick="ClearAllFilters">✕ مسح الفلاتر والبحث</button>
                }
                else
                {
                    <h3>لا توجد فرص خاسرة مطابقة</h3>
                    <p>لو فيه فرصة اتقفلت بخسارة هتظهر هنا تلقائيًا وبيتواصل معاها فريق خدمة العملاء.</p>
                    <button class="lr-btn lr-btn-ghost" @onclick="ReloadAll">فحص الخسائر الجديدة</button>
                }
            </div>
        }
        else
        {
            @if (_searching)
            {
                <div class="lr-searching">🔍 جارٍ البحث وتحديث القائمة…</div>
            }
            <!-- ═══════════ QUEUE CARDS ═══════════ -->
            <div class="lr-queue">
                @foreach (var it in _items)
                {
                    <div class="lr-card @(it.IsRecoveryCandidate == true ? "lr-card-cand" : "")">
                        <div class="lr-avatar" style="background:@SoftColor(it.StageColor)">@AvatarLetter(it.ClientName)</div>

                        <div class="lr-main">
                            <div class="lr-name-row">
                                <span class="lr-name">@it.ClientName</span>
                                @if (it.IsRecoveryCandidate == true)
                                {
                                    <span class="lr-badge lr-badge-green">⭐ قابل للاسترداد</span>
                                }
                                <span class="lr-badge @(it.IsNotInterested ? "lr-badge-gray" : "lr-badge-red")">@it.StageNameAr</span>
                                @if (!string.IsNullOrEmpty(it.Phone))
                                {
                                    <a class="lr-phone" href="@($"tel:{it.Phone}")" title="اتصال">@it.Phone</a>
                                }
                            </div>
                            <div class="lr-sub">
                                <a class="lr-op-link" href="@($"/crm/opportunities/{it.OpportunityId}")"
                                   title="فتح تفاصيل الفرصة في صفحة جديدة">#OP-@it.OpportunityId ↗</a>
                                <span>·</span>
                                <span>مغلق منذ <b>@it.DaysSinceClosed</b> يوم</span>
                                @if (it.ClosedAt.HasValue)
                                {
                                    <span>·</span>
                                    <span>@it.ClosedAt.Value.ToString("yyyy/MM/dd")</span>
                                }
                                @if (!string.IsNullOrEmpty(it.PreviousEmployeeName))
                                {
                                    <span>·</span>
                                    <span>المندوب: @it.PreviousEmployeeName</span>
                                }
                            </div>
                            <div class="lr-reason">
                                @if (!string.IsNullOrEmpty(it.LostReasonNameAr))
                                {
                                    <span class="lr-reason-chip">السبب: @it.LostReasonNameAr</span>
                                }
                                @if (!string.IsNullOrEmpty(it.LostNotes))
                                {
                                    <span class="lr-reason-note" title="@it.LostNotes">@it.LostNotes</span>
                                }
                            </div>

                            @if (it.LastCsDate.HasValue)
                            {
                                <div class="lr-last-cs" title="@it.LastCsSummary">
                                    <span>🕘 آخر تواصل بعد الخسارة:</span>
                                    <b>@Trunc(it.LastCsSummary, 60)</b>
                                    <span>@it.LastCsDate.Value.ToString("yyyy/MM/dd HH:mm")</span>
                                    @if (!string.IsNullOrEmpty(it.LastCsBy))
                                    {
                                        <span>· @it.LastCsBy</span>
                                    }
                                </div>
                            }
                        </div>

                        <div class="lr-side">
                            <div class="lr-value">@Money(it.ExpectedValue)</div>
                            <div class="lr-value-caption">قيمة متوقعة</div>

                            @if (it.NextFollowUpDate.HasValue)
                            {
                                <div class="lr-follow @(it.IsFollowUpOverdue ? "lr-follow-late" : "")">
                                    📅 المتابعة: @it.NextFollowUpDate.Value.ToString("yyyy/MM/dd")
                                    @(it.IsFollowUpOverdue ? "· متأخرة" : "")
                                </div>
                            }

                            <div class="lr-assign-line">
                                @if (it.RecoveryEmployeeName is not null)
                                {
                                    <span class="lr-assign-ok" title="مسؤول المتابعة من خدمة العملاء">👤 المتابعة: @it.RecoveryEmployeeName</span>
                                }
                                else
                                {
                                    <span class="lr-assign-wait">سيُتابَع تلقائيًا من خدمة العملاء</span>
                                }
                            </div>

                            <div class="lr-actions">
                                <a class="lr-act lr-act-wa" href="@WaHref(it.Phone)" title="واتساب سريع"
                                   target="_blank" rel="noopener">
                                    <MudIcon Icon="@Icons.Custom.Brands.WhatsApp" Size="MudSize.Small" Color="MudColor.Success" />
                                </a>
                                <a class="lr-act lr-act-call" href="@($"tel:{it.Phone}")" title="اتصال">
                                    <MudIcon Icon="@Icons.Material.Filled.Phone" Size="MudSize.Small" />
                                </a>
                                <button class="lr-act lr-act-info" title="ملف العميل"
                                        @onclick='() => Nav.NavigateTo($"/crm/customers/{it.PartyId}")'>
                                    <MudIcon Icon="@Icons.Material.Rounded.AccountCircle" Size="MudSize.Small" />
                                </button>
                                <button class="lr-act lr-act-hist" title="سجل التواصل بعد الخسارة"
                                        @onclick='() => OpenHistory(it)'>
                                    <MudIcon Icon="@Icons.Material.Rounded.History" Size="MudSize.Small" />
                                </button>
                            </div>
                        </div>

                        @if (_canRevive)
                        {
                            <div class="lr-foot-actions">
                                <button class="lr-btn lr-btn-contact" @onclick='() => OpenContact(it)'>
                                    📝 سجّل محاولة تواصل
                                </button>
                                <button class="lr-btn lr-btn-revive" @onclick='() => OpenRevive(it)'>
                                    🔁 العميل راجع — استرداد
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="lr-pager">
                <span>عرض @_items.Count من @_total فرصة</span>
                @if (_hasMore)
                {
                    <button class="lr-btn lr-btn-ghost" @onclick="LoadMoreAsync" disabled="@_loadingMore">
                        @(_loadingMore ? "جارٍ تحميل المزيد..." : "تحميل المزيد ⬇")
                    </button>
                }
            </div>
        }
    }

    <!-- ═══════════ MODAL: تواصل ═══════════ -->
    @if (_showContact && _sel != null)
    {
        <div class="lr-overlay" @onclick="CloseModals">
            <div class="lr-modal" @onclick="Noop" @onclick:stopPropagation>
                <div class="lr-modal-head">
                    <div><span class="lr-modal-ico">📝</span> تسجيل محاولة تواصل</div>
                    <button class="lr-x" @onclick="CloseModals">×</button>
                </div>
                <div class="lr-modal-body">
                    <div class="lr-callout">
                        <b>@_sel.ClientName</b> · #OP-@_sel.OpportunityId · مغلق منذ @_sel.DaysSinceClosed يوم ·
                        القيمة: @Money(_sel.ExpectedValue)
                        @if (!string.IsNullOrEmpty(_sel.LostReasonNameAr))
                        {
                            <div class="lr-callout-sub">سبب الخسارة: @_sel.LostReasonNameAr — @_sel.LostNotes</div>
                        }
                    </div>

                    <div class="lr-field">
                        <label>قناة التواصل</label>
                        <select @bind="_channel">
                            <option value="اتصال">اتصال هاتفي</option>
                            <option value="واتساب">واتساب</option>
                            <option value="زيارة">زيارة ميدانية</option>
                            <option value="بريد">بريد إلكتروني</option>
                        </select>
                    </div>

                    <div class="lr-field">
                        <label>ملخص التواصل / نتيجة المكالمة</label>
                        <textarea rows="3" placeholder="مثال: تحدثت مع المدير المالي، طلب عرضًا جديدًا بخصم 10%..." @bind="_summary"></textarea>
                    </div>

                    <div class="lr-field">
                        <label>نتيجة التواصل *</label>
                        <select @bind="_outcome">
                            <option value="تم التواصل">تم التواصل</option>
                            <option value="لم يرد">لم يرد</option>
                            <option value="طلب مهلة">طلب مهلة</option>
                            <option value="رفض نهائي">رفض نهائي — إغلاق ملف المتابعة نهائيًا</option>
                        </select>
                    </div>

                    @if (_outcome == "رفض نهائي")
                    {
                        <div class="lr-warn">⚠ تنبيه: باختيار "رفض نهائي" تُغلق فرصة الاسترداد نهائيًا، ولا تظهر في قائمة المتابعة ولا تُرسَل لها إشعارات مرة أخرى.</div>
                    }

                    <div class="lr-field">
                        <label>موعد المتابعة القادمة (اختياري)</label>
                        <input type="date" value="@_followUp?.ToString("yyyy-MM-dd")" @onchange="OnFollowUpChange" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_errorMsg))
                    {
                        <div class="lr-err">⚠ @_errorMsg</div>
                    }
                </div>
                <div class="lr-modal-foot">
                    <button class="lr-btn lr-btn-ghost" @onclick="CloseModals">إلغاء</button>
                    <button class="lr-btn lr-btn-primary" @onclick="SubmitContact" disabled="@_busy">
                        @(_busy ? "جارٍ الحفظ..." : "حفظ المحاولة")
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ═══════════ MODAL: العميل راجع ═══════════ -->
    @if (_showRevive && _sel != null)
    {
        <div class="lr-overlay" @onclick="CloseModals">
            <div class="lr-modal lr-modal-lg" @onclick="Noop" @onclick:stopPropagation>
                <div class="lr-modal-head lr-modal-head-green">
                    <div><span class="lr-modal-ico">🔁</span> العميل راجع — إعادة تفعيل</div>
                    <button class="lr-x" @onclick="CloseModals">×</button>
                </div>
                <div class="lr-modal-body">
                    <div class="lr-callout lr-callout-green">
                        <b>@_sel.ClientName</b> عاد بعد خسارة #OP-@_sel.OpportunityId بقيمة @Money(_sel.ExpectedValue)
                    </div>

                    <div class="lr-radio-row">
                        <label class="lr-radio">
                            <input type="radio" checked="@_same" @onchange='() => _same = true' name="reviveMode" />
                            <span><b>نفس الفرصة</b> — نفس الاحتياج والمنتج (التاريخ والسجل يكملوا)</span>
                        </label>
                        <label class="lr-radio">
                            <input type="radio" checked="@(!_same)" @onchange='() => _same = false' name="reviveMode" />
                            <span><b>فرصة جديدة</b> — احتياج/منتج مختلف، مرتبطة بالخاسرة</span>
                        </label>
                    </div>

                    <div class="lr-grid2">
                        <div class="lr-field">
                            <label>المرحلة الجديدة *</label>
                            <select @bind="_revStageId">
                                @foreach (var s in _stages)
                                {
                                    <option value="@s.StageId">@(s.StageNameAr ?? s.StageName)</option>
                                }
                            </select>
                        </div>
                        <div class="lr-field">
                            <label>القيمة المتوقعة (ج.م)</label>
                            <input type="number" min="0" step="any" value="@_revValue" @onchange="OnRevValueChange" />
                        </div>
                    </div>

                    @if (!_same)
                    {
                        <div class="lr-field">
                            <label>المنتج / الخدمة المطلوبة (للفرصة الجديدة)</label>
                            <input type="text" placeholder="مثال: نظام محاسبة لفرع جديد..." @bind="_revProduct" />
                        </div>
                    }

                    <div class="lr-field">
                        <label>ملاحظات (اختياري)</label>
                        <textarea rows="2" placeholder="أي تفاصيل عن اتفاق العودة..." @bind="_revNotes"></textarea>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_errorMsg))
                    {
                        <div class="lr-err">⚠ @_errorMsg</div>
                    }
                </div>
                <div class="lr-modal-foot">
                    <button class="lr-btn lr-btn-ghost" @onclick="CloseModals">إلغاء</button>
                    <button class="lr-btn lr-btn-revive" @onclick="SubmitRevive" disabled="@_busy || _revStageId == 0">
                        @(_busy ? "جارٍ التنفيذ..." : (_same ? "تفعيل الفرصة" : "إنشاء فرصة جديدة"))
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ═══════════ MODAL: سجل التواصل بعد الخسارة ═══════════ -->
    @if (_showHistory && _sel != null)
    {
        <div class="lr-overlay" @onclick="CloseModals">
            <div class="lr-modal lr-modal-lg" @onclick="Noop" @onclick:stopPropagation>
                <div class="lr-modal-head">
                    <div><span class="lr-modal-ico">🕘</span> سجل التواصل بعد الخسارة</div>
                    <button class="lr-x" @onclick="CloseModals">×</button>
                </div>
                <div class="lr-modal-body">
                    <div class="lr-callout">
                        <b>@_sel.ClientName</b> · #OP-@_sel.OpportunityId · مغلق منذ @_sel.DaysSinceClosed يوم
                        @if (_sel.RecoveryEmployeeName is not null)
                        {
                            <span>· المتابعة: @_sel.RecoveryEmployeeName</span>
                        }
                    </div>

                    @if (_history.Count == 0)
                    {
                        <div class="lr-hist-empty">لا توجد محاولات تواصل مسجلة بعد الخسارة حتى الآن.</div>
                    }
                    else
                    {
                        <div class="lr-hist-list">
                            @foreach (var h in _history)
                            {
                                <div class="lr-hist-item">
                                    <div class="lr-hist-top">
                                        <span class="lr-hist-date">@h.Date.ToString("yyyy/MM/dd HH:mm")</span>
                                        @if (!string.IsNullOrEmpty(h.Channel))
                                        {
                                            <span class="lr-hist-channel">@h.Channel</span>
                                        }
                                        <span class="lr-hist-who">@h.EmployeeName</span>
                                    </div>
                                    <div class="lr-hist-sum">@h.Summary</div>
                                </div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_errorMsg))
                    {
                        <div class="lr-err">⚠ @_errorMsg</div>
                    }
                </div>
                <div class="lr-modal-foot">
                    <button class="lr-btn lr-btn-ghost" @onclick="CloseModals">إغلاق</button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .lr-page {
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        display: flex; flex-direction: column; gap: 18px;
        max-width: 1280px; margin: 0 auto; padding: 18px;
        --lr-indigo: #4f46e5; --lr-ink: #0f172a; --lr-mut: #64748b;
        --lr-line: #e2e8f0; --lr-bg-soft: #f1f5f9;
    }

    /* ───── HERO ───── */
    .lr-hero { position: relative; overflow: hidden; border-radius: 20px;
        background: linear-gradient(135deg, #312e81 0%, #4f46e5 55%, #6d28d9 100%);
