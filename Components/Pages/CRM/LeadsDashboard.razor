    private string GetFunnelWidth(decimal pct) => Math.Max(pct, 15m).ToString("F0");

    private string GetPlatformClass(string? platform) => platform switch
    {
        "fb" => "platform-fb",
        "ig" => "platform-ig",
        _ => "platform-default"
    };

    private string GetConvRateClass(decimal rate) => rate switch
    {
        >= 20m => "conv-high",
        >= 10m => "conv-mid",
        _ => "conv-low"
    };

    private int GetQuotationTotalCount()
        => _data.QuotationStatusSummary.FirstOrDefault(x => x.StatusKey == "total")?.Count ?? 0;

    private int GetConvertedOutcomeTotalCount()
        => _data.ConvertedLeadOutcomeDistribution.Sum(x => (int)x.Value);

    private int GetPostConversionLostCount()
        => _data.ConvertedLeadOutcomeDistribution
            .Where(x => x.Label == "خسارة")
            .Sum(x => (int)x.Value);

    private int GetConvertedOutcomeUnlinkedCount()
        => _data.ConvertedLeadOutcomeDistribution
            .Where(x => x.Label == "تحويل غير مكتمل")
            .Sum(x => (int)x.Value);

    private int GetConvertedOutcomeValue(string label)
        => _data.ConvertedLeadOutcomeDistribution
            .Where(x => x.Label == label)
            .Sum(x => (int)x.Value);

    private string GetLeadOriginRateText()
    {
        var total = GetConvertedOutcomeTotalCount();
        if (total == 0)
            return "0% من إجمالي الفرص";

        var rate = Math.Round((decimal)_data.Kpis.LeadOriginOpportunitiesCount / total * 100m, 1);
        return $"{rate:F1}% من إجمالي الفرص";
    }

    private int GetBudgetChartHeight()
    {
        var count = _data.BudgetDistribution?.Count ?? 0;
        return Math.Max(360, 120 + (count * 42));
    }

    private string GetLeadOriginLostRateText()
    {
        if (_data.Kpis.LeadOriginOpportunitiesCount == 0)
            return "0% من فرص الليدز";

        var rate = Math.Round((decimal)_data.Kpis.LeadOriginLostCount / _data.Kpis.LeadOriginOpportunitiesCount * 100m, 1);
        return $"{rate:F1}% من فرص الليدز";
    }

    private string GetShowroomRepeatRateText()
    {
        if (_data.ShowroomVisitMetrics.UniqueVisitors == 0)
            return "0% من العملاء الزائرين";

        var rate = Math.Round((decimal)_data.ShowroomVisitMetrics.RepeatVisitors / _data.ShowroomVisitMetrics.UniqueVisitors * 100m, 1);
        return $"{rate:F1}% من العملاء الزائرين";
    }

    private static string FormatClosureDays(double value)
        => value <= 0 ? "0 يوم" : $"{value:F1} يوم";

    private static string FormatClosureDays(int? value)
        => !value.HasValue ? "—" : $"{value.Value} يوم";

    private string GetConvertedOutcomeRateText(string label)
    {
        var total = GetConvertedOutcomeTotalCount();
        if (total == 0)
            return "0% من الإجمالي";

        var value = GetConvertedOutcomeValue(label);
        var rate = Math.Round((decimal)value / total * 100m, 1);
        return $"{rate:F1}% من الفرص";
    }

    private string GetPostConversionInsightToneClass()
    {
        var potential = GetConvertedOutcomeValue("محتمل");
        var interested = GetConvertedOutcomeValue("مهتم");
        var highInterest = GetConvertedOutcomeValue("عالي الاهتمام");
        var openPipeline = potential + interested + highInterest;
        var won = GetConvertedOutcomeValue("تم البيع");
        var lost = GetPostConversionLostCount();
        var unlinked = GetConvertedOutcomeUnlinkedCount();

        if (lost > won && lost >= openPipeline)
            return "tone-risk";

        if (unlinked > 0 || openPipeline > won)
            return "tone-watch";

        return "tone-good";
    }

    private static string FormatMoney(decimal value)
    {
        if (value >= 1_000_000m) return $"{(value / 1_000_000m).ToString("F1")}M";
        if (value >= 1_000m) return $"{(value / 1_000m).ToString("F1")}K";
        return value.ToString("N0");
    }

    private static Chart MakeChart(string fontFamily, bool stacked = false)
    {
        return new Chart
        {
            FontFamily = fontFamily,
            Background = "transparent",
            Toolbar = new Toolbar { Show = false },
            Stacked = stacked,
            StackType = stacked ? StackType.Normal : null
        };
    }

