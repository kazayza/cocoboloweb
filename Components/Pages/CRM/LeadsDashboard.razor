@page "/crm/leads/dashboard"

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Models
@using COCOBOLOERPNEW.Services
@using ApexCharts
@using Microsoft.AspNetCore.Authorization
@using MudColor = MudBlazor.Color
@using MudSize = MudBlazor.Size
@using MudVariant = MudBlazor.Variant

@attribute [Authorize]

@inject ILeadsCrmService LeadsService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>لوحة تحليلات Leads</PageTitle>

@if (_isLoading)
{
    <div class="loading-container">
        <MudProgressCircular Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Large" Indeterminate="true" />
        <MudText Typo="Typo.h6" Class="mt-4">جاري تحميل البيانات...</MudText>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="ma-4">
        حدث خطأ أثناء تحميل بيانات الشاشة:
        <br />
        @_loadError
    </MudAlert>

    <MudButton Variant="MudVariant.Filled"
               Color="MudBlazor.Color.Primary"
               Class="ma-4"
               OnClick="LoadData">
        إعادة المحاولة
    </MudButton>
}
else
{
<div dir="rtl" class="dash-page">

    @* ═══════════════════════════════════════════════════════ *@
    @* ═══ HEADER ═══ *@
    @* ═══════════════════════════════════════════════════════ *@
    <div class="dash-header">
        <div class="dash-hdr-bg">
            <div class="dash-hdr-gradient"></div>
            <div class="dash-hdr-dots"></div>
            <div class="dash-hdr-glow dash-hdr-glow1"></div>
            <div class="dash-hdr-glow dash-hdr-glow2"></div>
        </div>
        <div class="dash-hdr-body">
            <div class="dash-hdr-top">
                <div class="dash-hdr-title-area">
                    <div class="dash-hdr-icon">
                        <MudIcon Icon="@Icons.Material.Rounded.Analytics" Style="font-size:1.6rem" />
                    </div>
                    <div>
                        <h1 class="dash-hdr-h1">لوحة تحليلات Leads</h1>
                        <p class="dash-hdr-sub">رؤية شاملة لأداء الـ Leads والحملات الإعلانية</p>
                    </div>
                </div>
                <div class="dash-hdr-actions">
                    <button class="hdr-btn" @onclick="ExportExcel">
                        <MudIcon Icon="@Icons.Material.Rounded.FileDownload" Size="MudSize.Small" />
                        تصدير Excel
                    </button>
                    <button class="hdr-btn hdr-btn-back" @onclick="GoBack">
                        <MudIcon Icon="@Icons.Material.Rounded.ArrowBack" Size="MudSize.Small" />
                        العودة للقائمة
                    </button>
                </div>
            </div>

            @* ─── Period Selector ─── *@
            <div class="period-row">
                @foreach (var p in _periods)
                {
                    <button class="period-btn @(_selectedPeriod == p.Key ? "period-on" : "")"
                            @onclick="@(async () => await SelectPeriod(p.Key))">
                        @p.Value
                    </button>
                }
                @if (_selectedPeriod == "custom")
                {
                    <MudDatePicker Label="من" Variant="MudVariant.Outlined"
                                   @bind-Date="_filter.DateFrom" Dense="true" Class="period-date" />
                    <MudDatePicker Label="إلى" Variant="MudVariant.Outlined"
                                   @bind-Date="_filter.DateTo" Dense="true" Class="period-date" />
                    <MudButton Variant="MudVariant.Filled" Color="MudColor.Primary"
                               OnClick="ApplyCustomPeriod" Size="MudSize.Small">تطبيق</MudButton>
                }
            </div>

            @* ─── Quick Filters ─── *@
            <div class="quick-filters">
                <div class="qf-group">
                    <span class="qf-label">المنصة:</span>
                    <button class="qf-btn @(_filter.Platform == null ? "qf-on" : "")" @onclick="@(async () => await SetPlatform(null))">الكل</button>
                    <button class="qf-btn @(_filter.Platform == "fb" ? "qf-on" : "")" @onclick="@(async () => await SetPlatform("fb"))">Facebook</button>
                    <button class="qf-btn @(_filter.Platform == "ig" ? "qf-on" : "")" @onclick="@(async () => await SetPlatform("ig"))">Instagram</button>
                </div>
                <div class="qf-group">
                    <span class="qf-label">الموظف:</span>
                    <MudSelect T="int?"
           Value="_filter.EmployeeId"
           ValueChanged="@(async (int? v) => { _filter.EmployeeId = v; await LoadData(); })"
           Dense="true"
           Class="qf-select"
           Clearable="true"
           Placeholder="الكل">
                        @foreach (var emp in _employees)
                        {
                            <MudSelectItem Value="@((int?)emp.EmployeeId)">@emp.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </div>
                <button class="qf-adv-toggle" @onclick="@(() => _showAdvanced = !_showAdvanced)">
                    <MudIcon Icon="@(_showAdvanced ? Icons.Material.Rounded.ExpandLess : Icons.Material.Rounded.ExpandMore)" Size="MudSize.Small" />
                    فلاتر متقدمة
                </button>
            </div>

            @* ─── Advanced Filters (Collapsible) ─── *@
            @if (_showAdvanced)
            {
                <div class="adv-filters">
                    <MudSelect T="string" Label="المدينة" Variant="MudVariant.Outlined"
                               @bind-Value="_filter.City" Dense="true" Class="adv-item"
                               Clearable="true" Placeholder="الكل">
                        @foreach (var c in _data?.AvailableCities ?? new List<string>())
                        {
                            <MudSelectItem Value="@c">@c</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string" Label="نوع المشروع" Variant="MudVariant.Outlined"
                               @bind-Value="_filter.ProjectType" Dense="true" Class="adv-item"
                               Clearable="true" Placeholder="الكل">
                        @foreach (var pt in _data?.AvailableProjectTypes ?? new List<string>())
                        {
                            <MudSelectItem Value="@pt">@pt</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string" Label="مرحلة المشروع" Variant="MudVariant.Outlined"
                               @bind-Value="_filter.ProjectStage" Dense="true" Class="adv-item"
                               Clearable="true" Placeholder="الكل">
                        @foreach (var ps in _data?.AvailableProjectStages ?? new List<string>())
                        {
                            <MudSelectItem Value="@ps">@ps</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string" Label="الحملة" Variant="MudVariant.Outlined"
                               @bind-Value="_filter.CampaignName" Dense="true" Class="adv-item"
                               Clearable="true" Placeholder="الكل">
                        @foreach (var cam in _data?.AvailableCampaigns ?? new List<string>())
                        {
                            <MudSelectItem Value="@cam">@cam</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="MudVariant.Outlined" Color="MudColor.Error"
                               OnClick="ResetAllFilters" Size="MudSize.Small"
                               StartIcon="@Icons.Material.Rounded.FilterAltOff">مسح الكل</MudButton>
                </div>
            }
        </div>
    </div>

    @* ═══════════════════════════════════════════════════════ *@
    @* ═══ KPIs ═══ *@
    @* ═══════════════════════════════════════════════════════ *@
    <div class="kpi-row">
        <div class="kpi-card">
            <div class="kpi-card-ico" style="background:rgba(99,102,241,0.15)">
                <MudIcon Icon="@Icons.Material.Rounded.Layers" Style="color:#6366f1" />
            </div>
            <div class="kpi-card-body">
                <span class="kpi-card-val"><bdi>@_data.Kpis.TotalLeads</bdi></span>
                <span class="kpi-card-lbl">إجمالي Leads</span>
            </div>
            @if (_data.Kpis.TotalLeadsChange.HasValue)
            {
                <span class="kpi-card-delta @(_data.Kpis.TotalLeadsChange >= 0 ? "delta-up" : "delta-down")">
                    @(_data.Kpis.TotalLeadsChange >= 0 ? "↑" : "↓") @Math.Abs(_data.Kpis.TotalLeadsChange.Value).ToString("F1")%
                </span>
            }
        </div>
        <div class="kpi-card">
            <div class="kpi-card-ico" style="background:rgba(16,185,129,0.15)">
                <MudIcon Icon="@Icons.Material.Rounded.TrendingUp" Style="color:#10b981" />
            </div>
            <div class="kpi-card-body">
                <span class="kpi-card-val"><bdi>@_data.Kpis.ConversionRate.ToString("F1")%</bdi></span>
                <span class="kpi-card-lbl">معدل التحويل</span>
            </div>
            @if (_data.Kpis.ConversionRateChange.HasValue)
            {
                <span class="kpi-card-delta @(_data.Kpis.ConversionRateChange >= 0 ? "delta-up" : "delta-down")">
                    @(_data.Kpis.ConversionRateChange >= 0 ? "↑" : "↓") @Math.Abs(_data.Kpis.ConversionRateChange.Value).ToString("F1")%
                </span>
            }
        </div>
        <div class="kpi-card">
            <div class="kpi-card-ico" style="background:rgba(59,130,246,0.15)">
                <MudIcon Icon="@Icons.Material.Rounded.Schedule" Style="color:#3b82f6" />
            </div>
            <div class="kpi-card-body">
                <span class="kpi-card-val"><bdi>@_data.Kpis.AvgConversionDays.ToString("F1")</bdi></span>
                <span class="kpi-card-lbl">متوسط أيام التحويل</span>
            </div>
            @if (_data.Kpis.AvgConversionDaysChange.HasValue)
            {
                <span class="kpi-card-delta @(_data.Kpis.AvgConversionDaysChange <= 0 ? "delta-up" : "delta-down")">
                    @(_data.Kpis.AvgConversionDaysChange <= 0 ? "↓" : "↑") @Math.Abs(_data.Kpis.AvgConversionDaysChange.Value).ToString("F1")
                </span>
            }
        </div>
        <div class="kpi-card">
            <div class="kpi-card-ico" style="background:rgba(139,92,246,0.15)">
                <MudIcon Icon="@Icons.Material.Rounded.CheckCircle" Style="color:#8b5cf6" />
            </div>
            <div class="kpi-card-body">
                <span class="kpi-card-val"><bdi>@_data.Kpis.ConvertedCount</bdi></span>
                <span class="kpi-card-lbl">تم التحويل</span>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-card-ico" style="background:rgba(16,185,129,0.15)">
                <MudIcon Icon="@Icons.Material.Rounded.Handshake" Style="color:#10b981" />
            </div>
            <div class="kpi-card-body">
                <span class="kpi-card-val"><bdi>@_data.Kpis.ClosedDealCount</bdi></span>
                <span class="kpi-card-lbl">صفقة مغلقة</span>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-card-ico" style="background:rgba(239,68,68,0.15)">
                <MudIcon Icon="@Icons.Material.Rounded.Cancel" Style="color:#ef4444" />
            </div>
            <div class="kpi-card-body">
                <span class="kpi-card-val"><bdi>@_data.Kpis.RejectedCount</bdi></span>
                <span class="kpi-card-lbl">مرفوض</span>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-card-ico" style="background:rgba(239,68,68,0.15)">
                <MudIcon Icon="@Icons.Material.Rounded.Percent" Style="color:#ef4444" />
            </div>
            <div class="kpi-card-body">
                <span class="kpi-card-val"><bdi>@_data.Kpis.RejectionRate.ToString("F1")%</bdi></span>
                <span class="kpi-card-lbl">نسبة الرفض</span>
            </div>
            @if (_data.Kpis.RejectionRateChange.HasValue)
            {
                <span class="kpi-card-delta @(_data.Kpis.RejectionRateChange <= 0 ? "delta-up" : "delta-down")">
                    @(_data.Kpis.RejectionRateChange <= 0 ? "↓" : "↑") @Math.Abs(_data.Kpis.RejectionRateChange.Value).ToString("F1")%
                </span>
            }
        </div>
        <div class="kpi-card">
            <div class="kpi-card-ico" style="background:rgba(245,158,11,0.15)">
                <MudIcon Icon="@Icons.Material.Rounded.AttachMoney" Style="color:#f59e0b" />
            </div>
            <div class="kpi-card-body">
                <span class="kpi-card-val"><bdi>@FormatMoney(_data.Kpis.ClosedDealValue)</bdi></span>
                <span class="kpi-card-lbl">قيمة الصفقات المغلقة</span>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-card-ico" style="background:rgba(59,130,246,0.15)">
                <MudIcon Icon="@Icons.Material.Rounded.Paid" Style="color:#3b82f6" />
            </div>
            <div class="kpi-card-body">
                <span class="kpi-card-val"><bdi>@FormatMoney(_data.Kpis.ClosedDealExpectedValue)</bdi></span>
                <span class="kpi-card-lbl">قيمة الصفقات المتوقعة</span>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-card-ico" style="background:rgba(99,102,241,0.15)">
                <MudIcon Icon="@Icons.Material.Rounded.CompareArrows" Style="color:#6366f1" />
            </div>
            <div class="kpi-card-body">
                <span class="kpi-card-val"><bdi>@FormatMoney(Math.Abs(_data.Kpis.ValueVariance))</bdi></span>
                <span class="kpi-card-lbl">@(_data.Kpis.ValueVariance >= 0 ? "عجز عن المتوقع" : "فائض عن المتوقع")</span>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-card-ico" style="background:rgba(245,158,11,0.15)">
                <MudIcon Icon="@Icons.Material.Rounded.ContentCopy" Style="color:#f59e0b" />
            </div>
            <div class="kpi-card-body">
                <span class="kpi-card-val"><bdi>@_data.Kpis.DuplicateRate.ToString("F1")%</bdi></span>
                <span class="kpi-card-lbl">نسبة المكرر</span>
            </div>
            @if (_data.Kpis.DuplicateRateChange.HasValue)
            {
                <span class="kpi-card-delta @(_data.Kpis.DuplicateRateChange <= 0 ? "delta-up" : "delta-down")">
                    @(_data.Kpis.DuplicateRateChange <= 0 ? "↓" : "↑") @Math.Abs(_data.Kpis.DuplicateRateChange.Value).ToString("F1")%
                </span>
            }
        </div>
    </div>

    @* ═══════════════════════════════════════════════════════ *@
    @* ═══ CHARTS ROW 1 ═══ *@
    @* ═══════════════════════════════════════════════════════ *@
    <div class="charts-row">
        @* ─── Status Distribution (Donut) ─── *@
        <div class="chart-card">
            <div class="chart-title">
                <MudIcon Icon="@Icons.Material.Rounded.DonutLarge" Size="MudSize.Small" Style="color:#6366f1" />
                <span>توزيع الحالات</span>
            </div>
            @if (_data.StatusDistribution.Any())
            {
                <div class="donut-chart-wrap">
                    <div class="donut-center-label">
                        <span>الإجمالي</span>
                        <strong><bdi>@_data.Kpis.TotalLeads</bdi></strong>
                    </div>
                    <div class="chart-shell" dir="ltr">
                        <ApexChart TItem="ChartItemDto" Options="_statusDonutOptions" Height="300">
                            <ApexPointSeries TItem="ChartItemDto"
                                             Items="_data.StatusDistribution"
                                             Name="الحالات"
                                             SeriesType="SeriesType.Donut"
                                             XValue="@(x => x.Label)"
                                             YValue="@(x => x.Value)" />
                        </ApexChart>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-sm">لا توجد بيانات للحالات</div>
            }
        </div>

        @* ─── Platform Comparison (Bar) ─── *@
        <div class="chart-card">
            <div class="chart-title">
                <MudIcon Icon="@Icons.Material.Rounded.CompareArrows" Size="MudSize.Small" Style="color:#3b82f6" />
                <span>Leads حسب المنصة</span>
            </div>
            @if (_data.PlatformData.Any())
            {
                <ApexChart TItem="ChartItemDto" Options="_platformBarOptions" Height="300">
                    <ApexPointSeries TItem="ChartItemDto"
                                     Items="_data.PlatformData"
                                     Name="Leads"
                                     SeriesType="SeriesType.Bar"
                                     XValue="@(x => x.Label)"
                                     YValue="@(x => x.Value)" />
                </ApexChart>
            }
            else
            {
                <div class="empty-sm">لا توجد بيانات للمنصات</div>
            }
        </div>

        @* ─── Daily Trend (Area) ─── *@
        <div class="chart-card">
            <div class="chart-title">
                <MudIcon Icon="@Icons.Material.Rounded.ShowChart" Size="MudSize.Small" Style="color:#10b981" />
                <span>تطور Leads يومياً</span>
            </div>
            @if (_data.DailyTrend.Any())
            {
                <ApexChart TItem="DailyTrendItemDto" Options="_areaOptions" Height="300">
                    <ApexPointSeries TItem="DailyTrendItemDto"
                                     Items="_data.DailyTrend"
                                     Name="Leads"
                                     SeriesType="SeriesType.Area"
                                     XValue="@(x => x.Date)"
                                     YValue="@(x => (decimal)x.Leads)" />
                    <ApexPointSeries TItem="DailyTrendItemDto"
                                     Items="_data.DailyTrend"
                                     Name="تفاوض"
                                     SeriesType="SeriesType.Area"
                                     XValue="@(x => x.Date)"
                                     YValue="@(x => (decimal)x.Contacted)" />
                    <ApexPointSeries TItem="DailyTrendItemDto"
                                     Items="_data.DailyTrend"
                                     Name="محول"
                                     SeriesType="SeriesType.Area"
                                     XValue="@(x => x.Date)"
                                     YValue="@(x => (decimal)x.Converted)" />
                </ApexChart>
            }
            else
            {
                <div class="empty-sm">لا توجد بيانات يومية</div>
            }
        </div>
    </div>

    @* ═══════════════════════════════════════════════════════ *@
    @* ═══ COMMERCIAL INSIGHTS ═══ *@
    @* ═══════════════════════════════════════════════════════ *@
    <div class="commercial-overview-grid">
        <div class="commercial-trend-stack">
            @* ─── Sales By Period (Bar) ─── *@
            <div class="chart-card trend-chart-card">
                <div class="chart-title">
                    <MudIcon Icon="@Icons.Material.Rounded.AttachMoney" Size="MudSize.Small" Style="color:#10b981" />
                    <span>المبيعات الفعلية حسب شهر إنشاء الفرصة</span>
                </div>
                @if (_data.SalesByPeriod.Any())
                {
                    <ApexChart TItem="SalesByPeriodDto" Options="_salesBarOptions" Height="280">
                        <ApexPointSeries TItem="SalesByPeriodDto"
                                         Items="_data.SalesByPeriod"
                                         Name="قيمة المبيعات"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(x => x.Period)"
                                         YValue="@(x => x.TotalValue)" />
                    </ApexChart>
                }
                else
                {
                    <div class="empty-sm">لا توجد بيانات مبيعات</div>
                }
            </div>

            @* ─── Expected vs Actual Comparison ─── *@
            <div class="chart-card trend-chart-card">
                <div class="chart-title">
                    <MudIcon Icon="@Icons.Material.Rounded.CompareArrows" Size="MudSize.Small" Style="color:#6366f1" />
                    <span>المتوقع مقابل الفعلي حسب شهر إنشاء الفرصة</span>
                </div>
                @if (_data.ValueComparison.Any())
                {
                    <ApexChart TItem="ValueComparisonDto" Options="_valueCompOptions" Height="280">
                        <ApexPointSeries TItem="ValueComparisonDto"
                                         Items="_data.ValueComparison"
                                         Name="القيمة المتوقعة"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(x => x.Period)"
                                         YValue="@(x => x.ExpectedValue)" />
                        <ApexPointSeries TItem="ValueComparisonDto"
                                         Items="_data.ValueComparison"
                                         Name="القيمة الفعلية"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(x => x.Period)"
                                         YValue="@(x => x.ActualValue)" />
                    </ApexChart>
                }
                else
                {
                    <div class="empty-sm">لا توجد بيانات للمقارنة</div>
                }
            </div>
        </div>

        @* ─── Budget Distribution ─── *@
        <div class="chart-card budget-card-panel">
            <div class="chart-title">
                <MudIcon Icon="@Icons.Material.Rounded.AttachMoney" Size="MudSize.Small" Style="color:#f59e0b" />
                <span>توزيع الميزانيات</span>
            </div>
            @if (_data.BudgetDistribution.Any())
            {
                <div class="chart-shell budget-chart-shell" dir="ltr">
                    <ApexChart TItem="ChartItemDto" Options="_budgetBarOptions" Height="@GetBudgetChartHeight()">
                        <ApexPointSeries TItem="ChartItemDto"
                                         Items="_data.BudgetDistribution"
                                         Name="عدد الحالات"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(x => x.Label)"
                                         YValue="@(x => x.Value)" />
                    </ApexChart>
                </div>
            }
            else
            {
                <div class="empty-sm">لا توجد بيانات للميزانيات</div>
            }
        </div>
    </div>

    <div class="commercial-detail-grid">
        @* ─── Top Cities ─── *@
        <div class="chart-card cities-chart-card">
            <div class="chart-title">
                <MudIcon Icon="@Icons.Material.Rounded.LocationCity" Size="MudSize.Small" Style="color:#8b5cf6" />
                <span>أفضل المدن</span>
            </div>
            @if (_data.TopCities.Any())
            {
                <ApexChart TItem="ChartItemDto" Options="_citiesBarOptions" Height="290">
                    <ApexPointSeries TItem="ChartItemDto"
                                     Items="_data.TopCities"
                                     Name="Leads"
                                     SeriesType="SeriesType.Bar"
                                     XValue="@(x => x.Label)"
                                     YValue="@(x => x.Value)" />
                </ApexChart>
            }
            else
            {
                <div class="empty-sm">لا توجد بيانات للمدن</div>
            }
        </div>

        @* ─── Employee Performance ─── *@
        <div class="chart-card employee-chart-card">
            <div class="chart-title">
                <MudIcon Icon="@Icons.Material.Rounded.People" Size="MudSize.Small" Style="color:#ec4899" />
                <span>أداء الموظفين</span>
            </div>
            @if (_data.EmployeePerformance.Any())
            {
                <ApexChart TItem="DashboardEmployeeDto" Options="_employeeStackedOptions" Height="290">
                    <ApexPointSeries TItem="DashboardEmployeeDto"
                                     Items="_data.EmployeePerformance"
                                     Name="جديد"
                                     SeriesType="SeriesType.Bar"
                                     XValue="@(x => x.Name)"
                                     YValue="@(x => (decimal)x.NewCount)" />
                    <ApexPointSeries TItem="DashboardEmployeeDto"
                                     Items="_data.EmployeePerformance"
                                     Name="تفاوض"
                                     SeriesType="SeriesType.Bar"
                                     XValue="@(x => x.Name)"
                                     YValue="@(x => (decimal)x.ContactedCount)" />
                    <ApexPointSeries TItem="DashboardEmployeeDto"
                                     Items="_data.EmployeePerformance"
                                     Name="محول"
                                     SeriesType="SeriesType.Bar"
                                     XValue="@(x => x.Name)"
                                     YValue="@(x => (decimal)x.ConvertedCount)" />
                    <ApexPointSeries TItem="DashboardEmployeeDto"
                                     Items="_data.EmployeePerformance"
                                     Name="صفقة مغلقة"
                                     SeriesType="SeriesType.Bar"
                                     XValue="@(x => x.Name)"
                                     YValue="@(x => (decimal)x.ClosedDealCount)" />
                    <ApexPointSeries TItem="DashboardEmployeeDto"
                                     Items="_data.EmployeePerformance"
                                     Name="مرفوض"
                                     SeriesType="SeriesType.Bar"
                                     XValue="@(x => x.Name)"
                                     YValue="@(x => (decimal)x.RejectedCount)" />
                </ApexChart>
            }
            else
            {
                <div class="empty-sm">لا توجد بيانات للموظفين</div>
            }
        </div>
    </div>

    @* ═══════════════════════════════════════════════════════ *@
    @* ═══ POST-CONVERSION OUTCOMES ═══ *@
    @* ═══════════════════════════════════════════════════════ *@
    <div class="chart-card post-conversion-card @GetPostConversionInsightToneClass()">
        <div class="chart-title">
            <MudIcon Icon="@Icons.Material.Rounded.Troubleshoot" Size="MudSize.Small" Style="color:#ef4444" />
            <span>نتائج الفرص البيعية</span>
        </div>
        <div class="post-kpi-grid">
            <div class="post-kpi-card">
                <div class="post-kpi-ico" style="background:rgba(99,102,241,.14)">
                    <MudIcon Icon="@Icons.Material.Rounded.Layers" Style="color:#6366f1" />
                </div>
                <div class="post-kpi-body">
                    <span class="post-kpi-label">إجمالي الفرص</span>
                    <strong class="post-kpi-value"><bdi>@GetConvertedOutcomeTotalCount()</bdi></strong>
                    <small class="post-kpi-meta">ضمن التحليل الحالي</small>
                </div>
            </div>

            <div class="post-kpi-card">
                <div class="post-kpi-ico" style="background:rgba(124,58,237,.14)">
                    <MudIcon Icon="@Icons.Material.Rounded.CompareArrows" Style="color:#7c3aed" />
                </div>
                <div class="post-kpi-body">
                    <span class="post-kpi-label">محول من الليدز</span>
                    <strong class="post-kpi-value" style="color:#7c3aed"><bdi>@_data.Kpis.LeadOriginOpportunitiesCount</bdi></strong>
                    <small class="post-kpi-meta">@GetLeadOriginRateText()</small>
                </div>
            </div>

            <div class="post-kpi-card">
                <div class="post-kpi-ico" style="background:rgba(220,38,38,.12)">
                    <MudIcon Icon="@Icons.Material.Rounded.TrendingDown" Style="color:#dc2626" />
                </div>
                <div class="post-kpi-body">
                    <span class="post-kpi-label">خسارة من الليدز</span>
                    <strong class="post-kpi-value" style="color:#dc2626"><bdi>@_data.Kpis.LeadOriginLostCount</bdi></strong>
                    <small class="post-kpi-meta">@GetLeadOriginLostRateText()</small>
                </div>
            </div>

            <div class="post-kpi-card">
                <div class="post-kpi-ico" style="background:rgba(59,130,246,.14)">
                    <MudIcon Icon="@Icons.Material.Rounded.PersonSearch" Style="color:#3b82f6" />
                </div>
                <div class="post-kpi-body">
                    <span class="post-kpi-label">محتمل</span>
                    <strong class="post-kpi-value" style="color:#3b82f6"><bdi>@GetConvertedOutcomeValue("محتمل")</bdi></strong>
                    <small class="post-kpi-meta">@GetConvertedOutcomeRateText("محتمل")</small>
                </div>
            </div>

            <div class="post-kpi-card">
                <div class="post-kpi-ico" style="background:rgba(245,158,11,.14)">
                    <MudIcon Icon="@Icons.Material.Rounded.FavoriteBorder" Style="color:#f59e0b" />
                </div>
                <div class="post-kpi-body">
                    <span class="post-kpi-label">مهتم</span>
                    <strong class="post-kpi-value" style="color:#b45309"><bdi>@GetConvertedOutcomeValue("مهتم")</bdi></strong>
                    <small class="post-kpi-meta">@GetConvertedOutcomeRateText("مهتم")</small>
                </div>
            </div>

            <div class="post-kpi-card">
                <div class="post-kpi-ico" style="background:rgba(124,58,237,.14)">
                    <MudIcon Icon="@Icons.Material.Rounded.LocalFireDepartment" Style="color:#7c3aed" />
                </div>
                <div class="post-kpi-body">
                    <span class="post-kpi-label">عالي الاهتمام</span>
                    <strong class="post-kpi-value" style="color:#7c3aed"><bdi>@GetConvertedOutcomeValue("عالي الاهتمام")</bdi></strong>
                    <small class="post-kpi-meta">@GetConvertedOutcomeRateText("عالي الاهتمام")</small>
                </div>
            </div>

            <div class="post-kpi-card">
                <div class="post-kpi-ico" style="background:rgba(16,185,129,.14)">
                    <MudIcon Icon="@Icons.Material.Rounded.Handshake" Style="color:#047857" />
                </div>
                <div class="post-kpi-body">
                    <span class="post-kpi-label">تم البيع</span>
                    <strong class="post-kpi-value" style="color:#047857"><bdi>@GetConvertedOutcomeValue("تم البيع")</bdi></strong>
                    <small class="post-kpi-meta">@GetConvertedOutcomeRateText("تم البيع")</small>
                </div>
            </div>

            <div class="post-kpi-card">
                <div class="post-kpi-ico" style="background:rgba(185,28,28,.12)">
                    <MudIcon Icon="@Icons.Material.Rounded.Cancel" Style="color:#b91c1c" />
                </div>
                <div class="post-kpi-body">
                    <span class="post-kpi-label">خسارة</span>
                    <strong class="post-kpi-value" style="color:#b91c1c"><bdi>@GetPostConversionLostCount()</bdi></strong>
                    <small class="post-kpi-meta">@GetConvertedOutcomeRateText("خسارة")</small>
                </div>
            </div>
        </div>

        <div class="post-kpi-grid closure-kpi-grid">
            <div class="post-kpi-card">
                <div class="post-kpi-ico" style="background:rgba(59,130,246,.14)">
                    <MudIcon Icon="@Icons.Material.Rounded.Insights" Style="color:#2563eb" />
                </div>
                <div class="post-kpi-body">
                    <span class="post-kpi-label">معدل الإغلاق</span>
                    <strong class="post-kpi-value"><bdi>@_data.OpportunityClosureMetrics.ClosureRate.ToString("F1")%</bdi></strong>
                    <small class="post-kpi-meta">الفرص المغلقة / الإجمالي</small>
                </div>
            </div>

            <div class="post-kpi-card">
                <div class="post-kpi-ico" style="background:rgba(14,165,233,.14)">
                    <MudIcon Icon="@Icons.Material.Rounded.Schedule" Style="color:#0ea5e9" />
                </div>
                <div class="post-kpi-body">
                    <span class="post-kpi-label">متوسط مدة الإغلاق</span>
                    <strong class="post-kpi-value"><bdi>@FormatClosureDays(_data.OpportunityClosureMetrics.AvgDaysToClose)</bdi></strong>
                    <small class="post-kpi-meta">حتى تاريخ الإغلاق</small>
                </div>
            </div>

            <div class="post-kpi-card">
                <div class="post-kpi-ico" style="background:rgba(245,158,11,.16)">
                    <MudIcon Icon="@Icons.Material.Rounded.Bolt" Style="color:#f59e0b" />
                </div>
                <div class="post-kpi-body">
                    <span class="post-kpi-label">أسرع إغلاق</span>
                    <strong class="post-kpi-value"><bdi>@FormatClosureDays(_data.OpportunityClosureMetrics.MinDaysToClose)</bdi></strong>
                    <small class="post-kpi-meta">أقل مدة</small>
                </div>
            </div>

            <div class="post-kpi-card">
                <div class="post-kpi-ico" style="background:rgba(71,85,105,.14)">
                    <MudIcon Icon="@Icons.Material.Rounded.Timer" Style="color:#475569" />
                </div>
                <div class="post-kpi-body">
                    <span class="post-kpi-label">أبطأ إغلاق</span>
                    <strong class="post-kpi-value"><bdi>@FormatClosureDays(_data.OpportunityClosureMetrics.MaxDaysToClose)</bdi></strong>
                    <small class="post-kpi-meta">أكبر مدة</small>
                </div>
            </div>
        </div>

        @if (_data.ConvertedLeadOutcomeDistribution.Any())
        {
            <div class="donut-chart-wrap quotation-donut-wrap">
                <div class="donut-center-label">
                    <span>إجمالي الفرص</span>
                    <strong><bdi>@GetConvertedOutcomeTotalCount()</bdi></strong>
                </div>
                <div class="chart-shell" dir="ltr">
                    <ApexChart TItem="ChartItemDto" Options="_convertedOutcomeDonutOptions" Height="310">
                        <ApexPointSeries TItem="ChartItemDto"
                                         Items="_data.ConvertedLeadOutcomeDistribution"
                                         Name="نتائج الفرص البيعية"
                                         SeriesType="SeriesType.Donut"
                                         XValue="@(x => x.Label)"
                                         YValue="@(x => x.Value)" />
                    </ApexChart>
                </div>
            </div>

        }
        else
        {
            <div class="empty-sm">لا توجد فرص بيعية مطابقة للفلاتر الحالية</div>
        }
    </div>

    @* ═══════════════════════════════════════════════════════ *@
    @* ═══ QUOTATIONS JOURNEY ═══ *@
    @* ═══════════════════════════════════════════════════════ *@
    <div class="quotes-row">
        <div class="chart-card quote-chart-card">
            <div class="chart-title">
                <MudIcon Icon="@Icons.Material.Rounded.RequestQuote" Size="MudSize.Small" Style="color:#8b5cf6" />
                <span>عروض الأسعار المرتبطة بالفرص البيعية</span>
            </div>

            <div class="quote-mini-strip">
                @foreach (var row in _data.QuotationStatusSummary)
                {
                    <div class="quote-mini-pill">
                        <span class="quote-mini-dot" style="@($"background:{row.Color}")"></span>
                        <span>@row.StatusName</span>
                        <strong><bdi>@row.Count</bdi></strong>
                    </div>
                }
            </div>

            @if (_data.QuotationStatusDistribution.Any())
            {
                <div class="donut-chart-wrap quotation-donut-wrap">
                    <div class="donut-center-label">
                        <span>إجمالي العروض</span>
                        <strong><bdi>@GetQuotationTotalCount()</bdi></strong>
                    </div>
                    <div class="chart-shell" dir="ltr">
                        <ApexChart TItem="ChartItemDto" Options="_quotationDonutOptions" Height="310">
                            <ApexPointSeries TItem="ChartItemDto"
                                             Items="_data.QuotationStatusDistribution"
                                             Name="عروض الأسعار"
                                             SeriesType="SeriesType.Donut"
                                             XValue="@(x => x.Label)"
                                             YValue="@(x => x.Value)" />
                        </ApexChart>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-sm">لا توجد عروض أسعار مرتبطة بالفرص البيعية في البيانات الحالية</div>
            }
        </div>

        <div class="table-card quote-table-card">
            <div class="chart-title" style="margin-bottom:0.75rem">
                <MudIcon Icon="@Icons.Material.Rounded.TableChart" Size="MudSize.Small" Style="color:#8b5cf6" />
                <span>ملخص مختصر لعروض الأسعار</span>
            </div>
            <MudTable Items="_data.QuotationStatusSummary" T="QuotationStatusSummaryDto"
                      Hover="true" Dense="true" Elevation="0" Class="dash-table quote-summary-table">
                <HeaderContent>
                    <MudTh>الحالة</MudTh>
                    <MudTh>العدد</MudTh>
                    <MudTh>النسبة</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <span class="quote-status-badge" style="@($"background:{context.Color}15;color:{context.Color};border-color:{context.Color}33;")">
                            @context.StatusName
                        </span>
                    </MudTd>
                    <MudTd><strong><bdi>@context.Count</bdi></strong></MudTd>
                    <MudTd><bdi>@context.Percent.ToString("F1")%</bdi></MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="empty-sm">لا توجد بيانات لعروض الأسعار</div>
                </NoRecordsContent>
            </MudTable>
        </div>
    </div>

    <div class="insight-pair-row">
        <div class="chart-card package-chart-card">
            <div class="chart-title">
                <MudIcon Icon="@Icons.Material.Rounded.Inventory2" Size="MudSize.Small" Style="color:#8b5cf6" />
                <span>عروض الأسعار حسب الباقات</span>
            </div>
            @if (_data.QuotationPackageDistribution.Any())
            {
                <div class="package-mini-grid">
                    @foreach (var pkg in _data.QuotationPackageMetrics)
                    {
                        <div class="package-mini-card">
                            <div class="package-mini-head">
                                <span class="quote-mini-dot" style="@($"background:{pkg.Color}")"></span>
                                <span class="package-mini-name">@pkg.PackageName</span>
                            </div>
                            <strong class="package-mini-value"><bdi>@FormatMoney(pkg.TotalValue)</bdi></strong>
                            <small class="package-mini-meta">العروض: @pkg.Count • المرفوض: @pkg.RejectedCount</small>
                        </div>
                    }
                </div>
                <div class="chart-shell package-chart-shell" dir="ltr">
                    <ApexChart TItem="ChartItemDto" Options="_quotationPackageBarOptions" Height="360">
                        @foreach (var pkg in _data.QuotationPackageDistribution)
                        {
                            <ApexPointSeries TItem="ChartItemDto"
                                             Items="@(new List<ChartItemDto> { pkg })"
                                             Name="@pkg.Label"
                                             SeriesType="SeriesType.Bar"
                                             XValue="@(x => x.Label)"
                                             YValue="@(x => x.Value)" />
                        }
                    </ApexChart>
                </div>
            }
            else
            {
                <div class="empty-sm">لا توجد بيانات لعروض الأسعار حسب الباقات</div>
            }
        </div>

        <div class="chart-card showroom-card">
            <div class="chart-title">
                <MudIcon Icon="@Icons.Material.Rounded.Storefront" Size="MudSize.Small" Style="color:#0ea5e9" />
                <span>زيارات المعرض</span>
            </div>
            <div class="showroom-mini-grid">
                <div class="showroom-mini-card">
                    <div class="showroom-mini-head">
                        <span class="showroom-mini-ico" style="background:rgba(14,165,233,.14)">
                            <MudIcon Icon="@Icons.Material.Rounded.Storefront" Style="color:#0ea5e9" />
                        </span>
                        <span class="showroom-mini-label">إجمالي الزيارات</span>
                    </div>
                    <strong class="showroom-mini-value"><bdi>@_data.ShowroomVisitMetrics.TotalVisits</bdi></strong>
                </div>
                <div class="showroom-mini-card">
                    <div class="showroom-mini-head">
                        <span class="showroom-mini-ico" style="background:rgba(59,130,246,.14)">
                            <MudIcon Icon="@Icons.Material.Rounded.Groups" Style="color:#3b82f6" />
                        </span>
                        <span class="showroom-mini-label">العملاء الزائرون</span>
                    </div>
                    <strong class="showroom-mini-value"><bdi>@_data.ShowroomVisitMetrics.UniqueVisitors</bdi></strong>
                </div>
                <div class="showroom-mini-card">
                    <div class="showroom-mini-head">
                        <span class="showroom-mini-ico" style="background:rgba(124,58,237,.14)">
                            <MudIcon Icon="@Icons.Material.Rounded.ArrowDownward" Style="color:#7c3aed" />
                        </span>
                        <span class="showroom-mini-label">من الليدز</span>
                    </div>
                    <strong class="showroom-mini-value" style="color:#7c3aed"><bdi>@_data.ShowroomVisitMetrics.LeadOriginVisits</bdi></strong>
                </div>
                <div class="showroom-mini-card">
                    <div class="showroom-mini-head">
                        <span class="showroom-mini-ico" style="background:rgba(14,165,233,.14)">
                            <MudIcon Icon="@Icons.Material.Rounded.ArrowUpward" Style="color:#0ea5e9" />
                        </span>
                        <span class="showroom-mini-label">مباشر</span>
                    </div>
                    <strong class="showroom-mini-value" style="color:#0ea5e9"><bdi>@_data.ShowroomVisitMetrics.DirectVisits</bdi></strong>
                </div>
                <div class="showroom-mini-card showroom-mini-card-wide">
                    <div class="showroom-mini-head">
                        <span class="showroom-mini-ico" style="background:rgba(245,158,11,.16)">
                            <MudIcon Icon="@Icons.Material.Rounded.Repeat" Style="color:#f59e0b" />
                        </span>
                        <span class="showroom-mini-label">زاروا أكثر من مرة</span>
                    </div>
                    <strong class="showroom-mini-value" style="color:#f59e0b"><bdi>@_data.ShowroomVisitMetrics.RepeatVisitors</bdi></strong>
                    <small class="showroom-mini-meta">@GetShowroomRepeatRateText()</small>
                </div>
            </div>
            @if (_data.ShowroomVisitOriginDistribution.Any())
            {
                <div class="chart-shell" dir="ltr">
                    <ApexChart TItem="ChartItemDto" Options="_showroomVisitsBarOptions" Height="300">
                        @foreach (var item in _data.ShowroomVisitOriginDistribution)
                        {
                            <ApexPointSeries TItem="ChartItemDto"
                                             Items="@(new List<ChartItemDto> { item })"
                                             Name="@item.Label"
                                             SeriesType="SeriesType.Bar"
                                             XValue="@(x => x.Label)"
                                             YValue="@(x => x.Value)" />
                        }
                    </ApexChart>
                </div>
            }
            else
            {
                <div class="empty-sm">لا توجد زيارات معرض ضمن البيانات الحالية</div>
            }
        </div>
    </div>

    @* ═══════════════════════════════════════════════════════ *@
    @* ═══ FUNNEL ═══ *@
    @* ═══════════════════════════════════════════════════════ *@
    <div class="funnel-section">
        <div class="chart-title" style="margin-bottom:1rem">
            <MudIcon Icon="@Icons.Material.Rounded.FilterAlt" Size="MudSize.Small" Style="color:#6366f1" />
            <span>قمع التحويل (Pipeline Funnel)</span>
        </div>
        <div class="funnel-container">
            @foreach (var item in _data.FunnelData)
            {
                <div class="funnel-step">
                    <div class="funnel-bar" style="width:@GetFunnelWidth(item.Percentage)%;background:@item.Color">
                        <span class="funnel-count"><bdi>@item.Count</bdi></span>
                    </div>
                    <div class="funnel-info">
                        <span class="funnel-stage">@item.Stage</span>
                        <span class="funnel-pct"><bdi>@item.Percentage.ToString("F1")%</bdi></span>
                    </div>
                </div>
            }
        </div>
    </div>

    @* ═══════════════════════════════════════════════════════ *@
    @* ═══ TABLES ═══ *@
    @* ═══════════════════════════════════════════════════════ *@
    <div class="tables-row">
        @* ─── Top Campaigns ─── *@
        <div class="table-card">
            <div class="chart-title" style="margin-bottom:0.75rem">
                <MudIcon Icon="@Icons.Material.Rounded.Campaign" Size="MudSize.Small" Style="color:#10b981" />
                <span>أفضل الحملات</span>
            </div>
            <MudTable Items="_data.TopCampaigns" T="CampaignPerformanceDto"
                      Hover="true" Dense="true" Elevation="0" Class="dash-table">
                <HeaderContent>
                    <MudTh>الحملة</MudTh>
                    <MudTh>المنصة</MudTh>
                    <MudTh>Leads</MudTh>
                    <MudTh>محول</MudTh>
                    <MudTh>معدل التحويل</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.CampaignName</MudTd>
                    <MudTd>
                        <span class="@GetPlatformClass(context.Platform)">
                            @(context.Platform == "fb" ? "FB" : context.Platform == "ig" ? "IG" : "—")
                        </span>
                    </MudTd>
                    <MudTd><strong><bdi>@context.TotalLeads</bdi></strong></MudTd>
                    <MudTd><bdi>@context.ConvertedLeads</bdi></MudTd>
                    <MudTd>
                        <span class="conv-rate @GetConvRateClass(context.ConversionRate)">
                            <bdi>@context.ConversionRate.ToString("F1")%</bdi>
                        </span>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="empty-sm">لا توجد بيانات حملات</div>
                </NoRecordsContent>
            </MudTable>
        </div>

        @* ─── Project Summary ─── *@
        <div class="table-card">
            <div class="chart-title" style="margin-bottom:0.75rem">
                <MudIcon Icon="@Icons.Material.Rounded.HomeWork" Size="MudSize.Small" Style="color:#f59e0b" />
                <span>ملخص المشاريع</span>
            </div>
            <MudTable Items="_data.ProjectSummary" T="ProjectTypeSummaryDto"
                      Hover="true" Dense="true" Elevation="0" Class="dash-table">
                <HeaderContent>
                    <MudTh>نوع المشروع</MudTh>
                    <MudTh>Leads</MudTh>
                    <MudTh>محول</MudTh>
                    <MudTh>معدل التحويل</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><strong>@context.ProjectType</strong></MudTd>
                    <MudTd><bdi>@context.TotalLeads</bdi></MudTd>
                    <MudTd><bdi>@context.ConvertedLeads</bdi></MudTd>
                    <MudTd>
                        <span class="conv-rate @GetConvRateClass(context.ConversionRate)">
                            <bdi>@context.ConversionRate.ToString("F1")%</bdi>
                        </span>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="empty-sm">لا توجد بيانات مشاريع</div>
                </NoRecordsContent>
            </MudTable>
        </div>

        @* ─── Recent Converted ─── *@
        <div class="table-card">
            <div class="chart-title" style="margin-bottom:0.75rem">
                <MudIcon Icon="@Icons.Material.Rounded.PersonAdd" Size="MudSize.Small" Style="color:#8b5cf6" />
                <span>آخر Leads محولة</span>
            </div>
            <MudTable Items="_data.RecentConverted" T="RecentConvertedDto"
                      Hover="true" Dense="true" Elevation="0" Class="dash-table">
                <HeaderContent>
                    <MudTh>الاسم</MudTh>
                    <MudTh>الحملة</MudTh>
                    <MudTh>الموظف</MudTh>
                    <MudTh>التاريخ</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><strong>@context.FullName</strong></MudTd>
                    <MudTd>@(context.CampaignName ?? "—")</MudTd>
                    <MudTd>@(context.EmployeeName ?? "—")</MudTd>
                    <MudTd><bdi>@context.ConvertedDate.ToString("yyyy/MM/dd")</bdi></MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="empty-sm">لا توجد تحويلات حديثة</div>
                </NoRecordsContent>
            </MudTable>
        </div>
    </div>

</div>
}

<style>
