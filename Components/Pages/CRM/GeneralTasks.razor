@page "/crm/general-tasks"
@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Models
@using COCOBOLOERPNEW.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudColor = MudBlazor.Color
@using MudVariant = MudBlazor.Variant

@attribute [Authorize]

@inject ITaskService TaskService
@inject IOpportunityService OppService
@inject IDbContextFactory<db24804Context> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav

<PageTitle>التكليفات العامة</PageTitle>

<style>
    /* هوية المشروع: كحلي #1B2A4A + ذهبي #D4A853 + أبيض */
    .gt-hero {
        background: linear-gradient(135deg, #0F1D36 0%, #1B2A4A 55%, #2D4A7A 100%) !important;
        border: none !important; border-bottom: 3px solid #D4A853 !important;
        border-radius: 18px;
    }
    .gt-hero .mud-typography { color: #fff !important; }
    .gt-hero .mud-typography-body2 { color: rgba(255,255,255,.75) !important; }
    .gt-tab-active { box-shadow: inset 0 -3px 0 #D4A853 !important; border-radius: 8px 8px 0 0; }
    .gt-card {
        background: #fff; transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        animation: gtFadeUp .45s ease both;
    }
    .gt-card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(15,29,54,.14); border-color: #D4A853 !important; }
    .gt-link-chip {
        background: #FEFBF3 !important; color: #B8912A !important;
        border: 1px solid #D4A853 !important; cursor: pointer; font-weight: 700;
    }
    .gt-link-chip:hover { background: #F0DBA8 !important; }
    .gt-overdue-pulse { animation: gtPulse 1.8s ease-in-out infinite; }
    @@keyframes gtFadeUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes gtPulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(220,38,38,.35); } 50% { box-shadow: 0 0 0 6px rgba(220,38,38,0); } }
    @@media (prefers-reduced-motion: reduce) {
        .gt-card { animation: none; transition: none; }
        .gt-card:hover { transform: none; }
        .gt-overdue-pulse { animation: none; }
    }
</style>

@if (_loading)
{
    <MudPaper Class="pa-6 ma-4" Elevation="0">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudProgressCircular Indeterminate="true" Color="MudColor.Primary" />
            <MudText Typo="Typo.h6">جاري تحميل التكليفات العامة...</MudText>
        </MudStack>
    </MudPaper>
}
else
{
    <MudContainer MaxWidth="MaxWidth.False" Class="pa-4" Style="direction:rtl;">
        <MudStack Spacing="3">
            <MudPaper Class="pa-4 gt-hero" Elevation="0">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                    <div>
                        <MudText Typo="Typo.h4" Style="font-weight:800;">التكليفات العامة</MudText>
                        <MudText Typo="Typo.body2" Class="mt-1">مهام عامة للموظفين على مستوى النظام كله — مرتبطة بمستنداتها، بنفس سيناريو الإشعارات والمتابعة.</MudText>
                    </div>
                    @if (_canCreateGeneralTasks)
                    {
                        <MudButton Variant="MudVariant.Filled" Style="background:linear-gradient(135deg,#D4A853,#B8912A);color:#0F1D36;font-weight:800;" StartIcon="@Icons.Material.Rounded.AddTask" OnClick="OpenCreateDialogAsync">
                            إضافة مهمة عامة
                        </MudButton>
                    }
                </MudStack>

                <MudStack Row="true" Class="mt-4" Spacing="2" Wrap="Wrap.Wrap">
                    <MudChip T="string" Style="background:rgba(212,168,83,.2);color:#F0DBA8;border:1px solid rgba(212,168,83,.5);">الإجمالي: @_allTasks.Count</MudChip>
                    <MudChip T="string" Style="background:rgba(255,255,255,.12);color:#fff;">المطلوبة مني: @AssignedToMeTasks.Count()</MudChip>
                    <MudChip T="string" Style="background:rgba(255,255,255,.12);color:#fff;">المرسلة مني: @CreatedByMeTasks.Count()</MudChip>
                    @if (_canViewAll)
                    {
                        <MudChip T="string" Color="MudColor.Error" Variant="Variant.Filled" Class="@(_allTasks.Any(t => t.Status != "Completed" && t.Status != "Cancelled" && t.DueDate.Date < DateTime.Today) ? "gt-overdue-pulse" : "")">المتأخرة: @_allTasks.Count(t => t.Status != "Completed" && t.Status != "Cancelled" && t.DueDate.Date < DateTime.Today)</MudChip>
                    }
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid #e5e7eb;border-radius:18px;">
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                    <MudButton Variant="@(IsTab("mine") ? MudVariant.Filled : MudVariant.Outlined)" Color="MudColor.Warning" Class="@(IsTab("mine") ? "gt-tab-active" : "")" OnClick='() => SetTab("mine")'>المطلوبة مني</MudButton>
                    <MudButton Variant="@(IsTab("created") ? MudVariant.Filled : MudVariant.Outlined)" Color="MudColor.Info" Class="@(IsTab("created") ? "gt-tab-active" : "")" OnClick='() => SetTab("created")'>المرسلة مني</MudButton>
                    @if (_canViewAll)
                    {
                        <MudButton Variant="@(IsTab("all") ? MudVariant.Filled : MudVariant.Outlined)" Color="MudColor.Success" Class="@(IsTab("all") ? "gt-tab-active" : "")" OnClick='() => SetTab("all")'>كل التكليفات</MudButton>
                    }
                    <MudButton Variant="MudVariant.Text" Color="MudColor.Success" StartIcon="@Icons.Material.Rounded.TaskAlt" OnClick="ShowCompletedOnly">المكتملة: @CompletedCount</MudButton>
                    <MudSpacer />
                    <MudSelect T="string" Label="الحالة" Variant="MudVariant.Outlined" Dense="true" Style="min-width:180px" @bind-Value="_statusFilter">
                        <MudSelectItem T="string" Value='@("open")'>المفتوحة فقط</MudSelectItem>
                        <MudSelectItem T="string" Value='@("completed")'>المكتملة فقط</MudSelectItem>
                        <MudSelectItem T="string" Value='@("all")'>الكل</MudSelectItem>
                    </MudSelect>
                    <MudTextField T="string" Label="بحث" Variant="MudVariant.Outlined" Dense="true" Style="min-width:240px" @bind-Value="_searchText" />
                </MudStack>
            </MudPaper>

            @if (_canViewAll && _managerSummary.Count > 0)
            {
                <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid #e5e7eb;border-inline-start:4px solid #D4A853;border-radius:18px;">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:800;color:#1B2A4A;">حِمل التكليفات على الفريق</MudText>
                    <MudTable T="EmployeeTaskLoadDto" Items="_managerSummary" Dense="true" Hover="true" Elevation="0" Class="mt-2">
                        <HeaderContent>
                            <MudTh>الموظف</MudTh>
                            <MudTh Style="text-align:end;">مفتوحة</MudTh>
                            <MudTh Style="text-align:end;">قيد التنفيذ</MudTh>
                            <MudTh Style="text-align:end;">متأخرة</MudTh>
                            <MudTh Style="text-align:end;">مرتجعة بانتظار قرار</MudTh>
                            <MudTh Style="text-align:end;">مكتملة</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="الموظف"><b>@context.EmployeeName</b></MudTd>
                            <MudTd DataLabel="مفتوحة" Style="text-align:end;">@context.OpenCount</MudTd>
                            <MudTd DataLabel="قيد التنفيذ" Style="text-align:end;">@context.InProgressCount</MudTd>
                            <MudTd DataLabel="متأخرة" Style="text-align:end;">
                                <span style="font-weight:800;color:@(context.OverdueCount > 0 ? "#DC2626" : "inherit")">@context.OverdueCount</span>
                            </MudTd>
                            <MudTd DataLabel="مرتجعة بانتظار قرار" Style="text-align:end;">@context.ReturnedPendingCount</MudTd>
                            <MudTd DataLabel="مكتملة" Style="text-align:end;">@context.CompletedCount</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }

            @{ var filteredList = FilteredTasks.ToList(); }
            @if (!filteredList.Any())
            {
                <MudPaper Class="pa-6" Elevation="0" Style="border:1px dashed #cbd5e1;border-radius:18px;text-align:center;">
                    <MudIcon Icon="@Icons.Material.Rounded.AssignmentLate" Size="MudBlazor.Size.Large" Color="MudColor.Info" />
                    <MudText Typo="Typo.h6" Class="mt-2">لا توجد مهام مطابقة</MudText>
                </MudPaper>
            }
            else
            {
                <MudGrid Spacing="2">
                    @for (var idx = 0; idx < filteredList.Count; idx++)
                    {
                        var task = filteredList[idx];
                        <MudItem xs="12" md="6" lg="4">
                            <MudPaper Class="pa-4 gt-card" Elevation="0" Style="@($"height:100%;border:1px solid #e5e7eb;border-radius:18px;animation-delay:{Math.Min(idx, 12) * 45}ms;")">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                                        <MudText Typo="Typo.h6" Style="font-weight:800;line-height:1.5;">@(string.IsNullOrWhiteSpace(task.TaskDescription) ? "مهمة عامة" : task.TaskDescription)</MudText>
                                        <MudChip T="string" Color="@GetStatusColor(task)" Variant="Variant.Filled">@GetStatusText(task.Status)</MudChip>
                                    </MudStack>

                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                        <MudChip T="string" Color="@GetPriorityColor(task.Priority)" Variant="Variant.Outlined">@GetPriorityText(task.Priority)</MudChip>
                                        <MudChip T="string" Color="MudColor.Secondary" Variant="Variant.Outlined">@GetSourceText(task.AssignmentSource)</MudChip>
                                        @if (!string.IsNullOrWhiteSpace(task.TaskTypeNameAr) || !string.IsNullOrWhiteSpace(task.TaskTypeName))
                                        {
                                            <MudChip T="string" Color="MudColor.Info" Variant="Variant.Outlined">@(task.TaskTypeNameAr ?? task.TaskTypeName)</MudChip>
                                        }
                                    </MudStack>

                                    @if (!string.IsNullOrWhiteSpace(task.LinkedEntityTitle))
                                    {
                                        <MudStack Row="true" Spacing="1">
                                            <MudChip T="string" Size="Size.Small" Class="gt-link-chip" Icon="@Icons.Material.Rounded.Link"
                                                     OnClick="@(() => OpenLinked(task))">@task.LinkedEntityTitle</MudChip>
                                        </MudStack>
                                    }

                                    <MudDivider />

                                    <MudText Typo="Typo.body2"><b>المكلف:</b> @(task.AssignedToName ?? "غير محدد")</MudText>
                                    <MudText Typo="Typo.body2"><b>أنشئت بواسطة:</b> @(task.CreatedBy ?? "—")</MudText>
                                    <MudText Typo="Typo.body2"><b>التنفيذ خلال:</b> @task.DueDate.ToString("yyyy/MM/dd") @if (task.DueTime.HasValue) { <span>— @task.DueTime.Value.ToString("HH:mm")</span> }</MudText>

                                    @if (task.AcknowledgedAt.HasValue && task.Status != "Completed" && task.Status != "Cancelled")
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="MudColor.Success" Variant="Variant.Outlined">✓ تم الاستلام @task.AcknowledgedAt.Value.ToString("MM/dd HH:mm")</MudChip>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(task.StartNotes) && task.Status == "In Progress")
                                    {
                                        <MudAlert Severity="Severity.Info" Dense="true">بدأ التنفيذ: @task.StartNotes</MudAlert>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(task.CompletionNotes) && task.Status == "Completed")
                                    {
                                        <MudAlert Severity="Severity.Success" Dense="true">تم التنفيذ: @task.CompletionNotes</MudAlert>
                                    }

                                    @if (task.Status == "Cancelled" && !string.IsNullOrWhiteSpace(task.CancellationReason))
                                    {
                                        <MudAlert Severity="Severity.Error" Dense="true">سبب الإلغاء: @task.CancellationReason</MudAlert>
                                    }

                                    @if (task.Status == "Pending" && !string.IsNullOrWhiteSpace(task.ReturnReason))
                                    {
                                        <MudAlert Severity="Severity.Warning" Dense="true">أرجعها المكلَّف: @task.ReturnReason</MudAlert>
                                    }

                                    <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                                        <MudButton Variant="MudVariant.Text" Color="MudColor.Warning" StartIcon="@Icons.Material.Filled.Forum" OnClick="@(() => OpenTaskDetailAsync(task.TaskId))">التفاصيل والنقاش</MudButton>
                                        @if (CanStartTask(task))
                                        {
                                            <MudButton Variant="MudVariant.Outlined" Color="MudColor.Info" OnClick="@(() => OpenStartDialog(task.TaskId))">بدء التنفيذ</MudButton>
                                        }
                                        @if (CanCompleteTask(task))
                                        {
                                            <MudButton Variant="MudVariant.Filled" Color="MudColor.Success" OnClick="@(() => OpenCompleteDialog(task.TaskId))">تم التنفيذ</MudButton>
                                        }
                                        @if (CanAdministerTask(task))
                                        {
                                            <MudButton Variant="MudVariant.Text" Color="MudColor.Primary" OnClick="@(() => OpenEditDialog(task))">تعديل</MudButton>
                                            <MudButton Variant="MudVariant.Text" Color="MudColor.Error" OnClick="@(() => OpenCancelDialog(task.TaskId))">إلغاء التكليف</MudButton>
                                        }
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudStack>
    </MudContainer>
}

<MudDialog @bind-Visible="_showTaskActionDialog"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@_taskActionDialogTitle</MudText>
    </TitleContent>
    <DialogContent>
        <div dir="rtl" style="display:flex;flex-direction:column;gap:1rem;">
            <MudTextField T="string"
                          Label="@_taskActionDialogLabel"
                          Variant="MudVariant.Outlined"
                          @bind-Value="_taskActionNotes"
                          Dense="true"
                          Lines="4" />
            @if (_taskActionMode == "complete")
            {
                <MudTextField T="string"
                              Label="رابط دليل الإتمام (اختياري)"
                              Variant="MudVariant.Outlined"
                              @bind-Value="_taskActionLink"
                              Dense="true" />
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="MudVariant.Text" OnClick="CloseTaskActionDialog">إلغاء</MudButton>
        <MudButton Variant="MudVariant.Filled" Color="@_taskActionDialogColor" OnClick="SubmitTaskActionAsync">حفظ</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showEditDialog"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">تعديل التكليف</MudText>
    </TitleContent>
    <DialogContent>
        <div dir="rtl" style="display:flex;flex-direction:column;gap:.8rem;">
            <MudSelect T="int" Label="الموظف المكلف *" Variant="MudVariant.Outlined" Dense="true" @bind-Value="_editTask.AssignedTo">
                @foreach (var emp in _employees)
                {
                    <MudSelectItem T="int" Value="@emp.EmployeeId">@emp.FullName</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="int?" Label="نوع المهمة" Variant="MudVariant.Outlined" Dense="true" @bind-Value="_editTask.TaskTypeId" Clearable="true">
                @foreach (var tt in _taskTypes)
                {
                    <MudSelectItem T="int?" Value="@((int?)tt.TaskTypeId)">@(tt.TaskTypeNameAr ?? tt.TaskTypeName)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" Label="الأولوية" Variant="MudVariant.Outlined" Dense="true" @bind-Value="_editTask.Priority">
                <MudSelectItem T="string" Value='@("High")'>عاجلة</MudSelectItem>
                <MudSelectItem T="string" Value='@("Medium")'>متوسطة</MudSelectItem>
                <MudSelectItem T="string" Value='@("Low")'>منخفضة</MudSelectItem>
            </MudSelect>
            <MudTextField T="string" Label="وصف المهمة *" Variant="MudVariant.Outlined" Dense="true" Lines="3" @bind-Value="_editTask.TaskDescription" />
            <MudStack Row="true" Spacing="2">
                <MudDatePicker T="DateTime?" Label="تاريخ التنفيذ *" Variant="MudVariant.Outlined" Date="_editTask.DueDate" DateChanged="@(d => _editTask.DueDate = d ?? _editTask.DueDate)" />
                <MudTimePicker Label="الوقت" Variant="MudVariant.Outlined" Time="_editDueTime" TimeChanged="@(t => _editDueTime = t ?? new TimeSpan(10, 0, 0))" />
            </MudStack>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="MudVariant.Text" OnClick="() => _showEditDialog = false">إلغاء</MudButton>
        <MudButton Variant="MudVariant.Filled" Color="MudColor.Primary" OnClick="SubmitEditAsync" Disabled="_saving">حفظ التعديل</MudButton>
    </DialogActions>
</MudDialog>

@code {
    // رابط عميق من الإشعارات: /crm/general-tasks?taskId=123 — يفتح حوار التكليف تلقائيًا
    [Parameter][SupplyParameterFromQuery(Name = "taskId")] public int? TaskIdFromQuery { get; set; }
    private bool _deepLinkHandled;

    private bool _loading = true;
    private bool _saving;
    private bool _canCreateGeneralTasks;
    private bool _canViewAll;
    private string _currentUserName = "system";
    private int? _currentEmployeeId;
    private string _activeTab = "mine";
    private string _statusFilter = "open";
    private string _searchText = string.Empty;
    private List<EmployeeTaskLoadDto> _managerSummary = new();
    private List<Employee> _employees = new();
    private List<TaskType> _taskTypes = new();
    private List<TaskListDto> _allTasks = new();
    private bool _showTaskActionDialog;
    private string _taskActionMode = "start";   // start | complete | cancel
    private int _taskActionTaskId;
    private string _taskActionNotes = string.Empty;
    private string _taskActionLink = string.Empty;
    private bool _showEditDialog;
    private UpdateGeneralTaskDto _editTask = new();
    private TimeSpan _editDueTime = new(10, 0, 0);
    private string _taskActionDialogTitle = "";
    private string _taskActionDialogLabel = "";
    private MudColor _taskActionDialogColor = MudColor.Primary;

    private IEnumerable<TaskListDto> AssignedToMeTasks => _currentEmployeeId.HasValue
        ? _allTasks.Where(t => t.AssignedTo == _currentEmployeeId.Value)
        : Enumerable.Empty<TaskListDto>();

    private IEnumerable<TaskListDto> CreatedByMeTasks => _allTasks.Where(t => string.Equals(t.CreatedBy, _currentUserName, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<TaskListDto> TabTasks => _activeTab switch
    {
        "created" => CreatedByMeTasks,
        "all" when _canViewAll => _allTasks,
        _ => AssignedToMeTasks
    };

    private int CompletedCount => TabTasks.Count(t => t.Status == "Completed");

    private void ShowCompletedOnly() => _statusFilter = "completed";

    private IEnumerable<TaskListDto> FilteredTasks
    {
        get
        {
            IEnumerable<TaskListDto> query = TabTasks;

            query = _statusFilter switch
            {
                "completed" => query.Where(t => t.Status == "Completed"),
                "open" => query.Where(t => t.Status != "Completed" && t.Status != "Cancelled"),
                _ => query
            };

            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                var s = _searchText.Trim();
                query = query.Where(t =>
                    (t.TaskDescription?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (t.AssignedToName?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (t.CreatedBy?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return query
                .OrderBy(t => t.Status == "Completed" ? 1 : 0)
                .ThenBy(t => t.DueDate)
                .ThenBy(t => t.DueTime ?? new TimeOnly(23, 59))
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthProvider.GetAuthenticationStateAsync();
            var user = auth.User;
            _currentUserName = user.Identity?.Name ?? "system";
            _canCreateGeneralTasks = GeneralTaskPermissions.CanCreate(user);
            _canViewAll = GeneralTaskPermissions.CanManageAll(user);

            await using var db = await DbFactory.CreateDbContextAsync();
            _currentEmployeeId = await db.Users.AsNoTracking()
                .Where(u => u.Username == _currentUserName && u.EmployeeId != null)
                .Select(u => u.EmployeeId)
                .FirstOrDefaultAsync();

            _employees = (await OppService.GetActiveEmployeesAsync())
                .OrderBy(e => e.FullName)
                .ToList();

            if (!_currentEmployeeId.HasValue && _canViewAll)
                _activeTab = "all";

            _taskTypes = await OppService.GetTaskTypesAsync();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add("خطأ: " + ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _deepLinkHandled) return;
        _deepLinkHandled = true;

        if (!TaskIdFromQuery.HasValue || TaskIdFromQuery.Value <= 0) return;

        var target = _allTasks.FirstOrDefault(t => t.TaskId == TaskIdFromQuery.Value);
        if (target is null)
        {
            Snackbar.Add("التكليف غير موجود أو لا تملك صلاحية عرضه", Severity.Warning);
            return;
        }

        await OpenTaskDetailAsync(target.TaskId);
    }

    private async Task LoadDataAsync()
    {
        _allTasks = await TaskService.GetGeneralTasksAsync(_currentUserName);
        if (_canViewAll)
        {
            try { _managerSummary = await TaskService.GetGeneralTasksManagerSummaryAsync(_currentUserName); }
            catch { _managerSummary = new(); }
        }
    }

    private void SetTab(string key) => _activeTab = key;
    private bool IsTab(string key) => string.Equals(_activeTab, key, StringComparison.OrdinalIgnoreCase);

    private async Task OpenCreateDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<CreateGeneralTaskDialog>("تكليف جديد", options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadDataAsync();
    }

    private void OpenLinked(TaskListDto task)
    {
        var route = GeneralTaskLinks.RouteFor(task.LinkedEntityType, task.LinkedEntityId);
        if (!string.IsNullOrWhiteSpace(route))
            Nav.NavigateTo(route);
    }

    private async Task OpenTaskDetailAsync(int taskId)
    {
        var parameters = new DialogParameters { ["TaskId"] = taskId };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<GeneralTaskDetailDialog>("تفاصيل التكليف", parameters, options);
        var result = await dialog.Result;
        if (result is not null)
            await LoadDataAsync();
    }

    private bool CanStartTask(TaskListDto task)
        => _currentEmployeeId.HasValue && task.AssignedTo == _currentEmployeeId.Value && task.Status == "Pending";

    private bool CanCompleteTask(TaskListDto task)
        => _currentEmployeeId.HasValue && task.AssignedTo == _currentEmployeeId.Value && task.Status != "Completed" && task.Status != "Cancelled";

    private void OpenStartDialog(int taskId)
    {
        _taskActionTaskId = taskId;
        _taskActionMode = "start";
        _taskActionNotes = string.Empty;
        _taskActionLink = string.Empty;
        _taskActionDialogTitle = "بدء تنفيذ المهمة";
        _taskActionDialogLabel = "اكتب ماذا ستبدأ تنفيذه *";
        _taskActionDialogColor = MudColor.Info;
        _showTaskActionDialog = true;
    }

    private void OpenCompleteDialog(int taskId)
    {
        _taskActionTaskId = taskId;
        _taskActionMode = "complete";
        _taskActionNotes = string.Empty;
        _taskActionLink = string.Empty;
        _taskActionDialogTitle = "إتمام تنفيذ المهمة";
        _taskActionDialogLabel = "اكتب ما الذي تم تنفيذه *";
        _taskActionDialogColor = MudColor.Success;
        _showTaskActionDialog = true;
    }

    private void OpenCancelDialog(int taskId)
    {
        _taskActionTaskId = taskId;
        _taskActionMode = "cancel";
        _taskActionNotes = string.Empty;
        _taskActionLink = string.Empty;
        _taskActionDialogTitle = "إلغاء التكليف";
        _taskActionDialogLabel = "اكتب سبب الإلغاء *";
        _taskActionDialogColor = MudColor.Error;
        _showTaskActionDialog = true;
    }

    private void CloseTaskActionDialog()
    {
        _showTaskActionDialog = false;
        _taskActionTaskId = 0;
        _taskActionNotes = string.Empty;
        _taskActionLink = string.Empty;
    }

    private async Task SubmitTaskActionAsync()
    {
        if (_taskActionTaskId <= 0) return;
        if (string.IsNullOrWhiteSpace(_taskActionNotes))
        {
            Snackbar.Add(_taskActionMode switch
            {
                "complete" => "اكتب ما الذي تم تنفيذه",
                "cancel" => "اكتب سبب الإلغاء",
                _ => "اكتب ماذا ستبدأ تنفيذه"
            }, Severity.Warning);
            return;
        }

        var (ok, msg) = _taskActionMode switch
        {
            "complete" => await TaskService.CompleteAsync(_taskActionTaskId, _taskActionNotes, _currentUserName, string.IsNullOrWhiteSpace(_taskActionLink) ? null : _taskActionLink),
            "cancel" => await TaskService.CancelGeneralTaskAsync(_taskActionTaskId, _taskActionNotes, _currentUserName),
            _ => await TaskService.StartAsync(_taskActionTaskId, _taskActionNotes, _currentUserName)
        };

        Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);
        if (ok)
        {
            CloseTaskActionDialog();
            await LoadDataAsync();
        }
    }

    private bool CanAdministerTask(TaskListDto task)
        => task.Status != "Completed" && task.Status != "Cancelled"
           && (_canCreateGeneralTasks || string.Equals(task.CreatedBy, _currentUserName, StringComparison.OrdinalIgnoreCase));

    private void OpenEditDialog(TaskListDto task)
    {
        _editTask = new UpdateGeneralTaskDto
        {
            TaskId = task.TaskId,
            AssignedTo = task.AssignedTo,
            TaskTypeId = task.TaskTypeId,
            TaskDescription = task.TaskDescription,
            DueDate = task.DueDate,
            DueTime = task.DueTime,
            Priority = task.Priority == "Normal" ? "Medium" : task.Priority
        };
        _editDueTime = task.DueTime?.ToTimeSpan() ?? new TimeSpan(10, 0, 0);
        _showEditDialog = true;
    }

    private async Task SubmitEditAsync()
    {
        if (string.IsNullOrWhiteSpace(_editTask.TaskDescription))
        {
            Snackbar.Add("اكتب وصف المهمة", Severity.Warning);
            return;
        }

        try
        {
            _saving = true;
            _editTask.DueTime = TimeOnly.FromTimeSpan(_editDueTime);
            var (ok, msg) = await TaskService.UpdateGeneralTaskAsync(_editTask, _currentUserName);
            Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);
            if (ok)
            {
                _showEditDialog = false;
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("خطأ: " + ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static MudColor GetStatusColor(TaskListDto task) => task.Status switch
    {
        "Completed" => MudColor.Success,
        "In Progress" => MudColor.Info,
        _ when task.DueDate.Date < DateTime.Today => MudColor.Error,
        _ => MudColor.Warning
    };

    private static string GetStatusText(string? status) => status switch
    {
        "Completed" => "مكتملة",
        "In Progress" => "جاري التنفيذ",
        "Cancelled" => "ملغية",
        _ => "معلقة"
    };

    private static MudColor GetPriorityColor(string? priority) => priority switch
    {
        "High" => MudColor.Error,
        "Low" => MudColor.Info,
        _ => MudColor.Warning
    };

    private static string GetPriorityText(string? priority) => priority switch
    {
        "High" => "عاجلة",
        "Low" => "منخفضة",
        _ => "متوسطة"
    };

    private static string GetSourceText(string? assignmentSource) => assignmentSource switch
    {
        SystemRoles.GeneralManager => "المدير العام",
        SystemRoles.AccountManager => "مدير الحسابات",
        SystemRoles.Admin => "الإدارة",
        _ => assignmentSource ?? "الإدارة"
    };
}
