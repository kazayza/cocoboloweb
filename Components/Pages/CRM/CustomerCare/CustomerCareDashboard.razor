@page "/crm/customer-care"
@attribute [Authorize]

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization

@inject ICustomerCareService CC
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth

@if (_denied)
{
    <div class="cc-page" dir="rtl">
        <div class="cc-card cc-error-box" style="padding:22px;font-weight:800;border:1px solid #f2c2c7;background:#fdecee;color:#b02a37;border-radius:12px">
            ⛔ لا تملك صلاحية الدخول إلى موديول خدمة العملاء.
        </div>
    </div>
}

<div class="cc-page" dir="rtl">
    @if (!_denied)
    {

    <style>
        .cc-page { font-family: "Cairo","Tajawal",sans-serif; background:#f2f5fa; min-height:100vh; padding:18px; color:#16233b; box-sizing:border-box; }
        .cc-page *,.cc-page *::before,.cc-page *::after{box-sizing:border-box}
        .cc-hero{display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between;background:linear-gradient(120deg,#123a78,#0b5cd6);border-radius:16px;padding:18px 22px;color:#fff;box-shadow:0 10px 24px rgba(18,58,120,.18)}
        .cc-hero h1{margin:0;font-size:21px;font-weight:900}
        .cc-hero p{margin:4px 0 0;font-size:13px;opacity:.85}
        .cc-hero-actions{display:flex;gap:8px;flex-wrap:wrap}
        .cc-btn{border:0;cursor:pointer;border-radius:11px;padding:8px 16px;font-family:inherit;font-weight:800;font-size:13px;display:inline-flex;gap:6px;align-items:center;transition:.15s}
        .cc-btn:hover{transform:translateY(-1px)}
        .cc-btn-light{background:#fff;color:#123a78}
        .cc-btn-ghost{background:rgba(255,255,255,.15);color:#fff;border:1px solid rgba(255,255,255,.3)}
        .cc-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin:16px 0}
        button.cc-kpi{font-family:inherit;text-align:right;width:100%;cursor:pointer;line-height:1.35}
        .cc-kpi{background:#fff;border:1px solid #e4e9f1;border-radius:14px;padding:13px 15px;display:flex;flex-direction:column;gap:4px;transition:transform .15s,box-shadow .15s}
        .cc-kpi:hover{transform:translateY(-2px);box-shadow:0 12px 24px rgba(16,42,80,.13)}
        .cc-kpi.act{border-color:#0f63d9;box-shadow:0 0 0 3px rgba(15,99,217,.15);background:#f3f8ff}
        .cc-kpi .hint{font-size:10px;font-weight:800;color:#a9b4c6;margin-top:2px;text-align:left}
        .cc-kpi .n{font-size:24px;font-weight:900;color:#0f63d9}
        .cc-kpi .l{font-size:12px;color:#6a7890;font-weight:700}
        .cc-kpi.g .n{color:#15965e}.cc-kpi.o .n{color:#efa21b}.cc-kpi.r .n{color:#d93445}.cc-kpi.p .n{color:#7447c6}
        .cc-kpi.t .n{color:#0d8fa0}
        .cc-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
        .cc-tab{border:1px solid #d9e1ec;background:#fff;cursor:pointer;border-radius:12px;padding:9px 18px;font-family:inherit;font-weight:800;font-size:13px;color:#43506a;transition:.15s}
        .cc-tab.active{background:#123a78;color:#fff;border-color:#123a78}
        .cc-card{background:#fff;border:1px solid #e4e9f1;border-radius:14px}
        .cc-empty{padding:40px;text-align:center;color:#8894a8;font-weight:700}
        .cc-row{display:flex;flex-wrap:wrap;gap:12px;align-items:center;padding:14px 18px;border-bottom:1px solid #eef1f7}
        .cc-row:last-child{border-bottom:0}
        .cc-main{flex:1;min-width:200px}
        .cc-name{font-weight:900;font-size:14px;color:#1c2a44;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
        .cc-sub{font-size:12px;color:#6a7890;margin-top:3px}
        .cc-done{background:#e7f6ef;color:#0f8a52;border-radius:20px;padding:3px 12px;font-size:11px;font-weight:800;white-space:nowrap}
        .cc-open{background:#eaf1ff;color:#123a78;border-radius:20px;padding:3px 12px;font-size:11px;font-weight:800;white-space:nowrap}
        .cc-skip{background:#fdf1f1;color:#c0392b;border-radius:20px;padding:3px 12px;font-size:11px;font-weight:800;white-space:nowrap}
        .cc-msg{border-radius:12px;padding:12px 16px;margin:14px 0;font-weight:800;font-size:13px}
        .cc-ok{background:#e7f6ef;color:#0f7a48;border:1px solid #bde9d1}
        .cc-err{background:#fdecee;color:#b02a37;border:1px solid #f5c2c7}
        .cc-overlay{position:fixed;inset:0;background:rgba(10,18,38,.55);display:flex;align-items:center;justify-content:center;z-index:2400;padding:12px}
        .cc-dialog{background:#fff;border-radius:18px;width:min(860px,100%);max-height:calc(100vh - 24px);display:flex;flex-direction:column;box-shadow:0 30px 90px rgba(8,18,45,.45);overflow:hidden}
        .cc-dlg-hd{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 20px;background:linear-gradient(120deg,#123a78,#0b5cd6);color:#fff;flex:0 0 auto}
        .cc-dlg-hd-info{display:flex;align-items:center;gap:13px;min-width:0}
        .cc-avatar{width:48px;height:48px;border-radius:50%;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.4);display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:900;flex:0 0 auto}
        .cc-dlg-meta{min-width:0}
        .cc-dlg-eyebrow{font-size:10px;letter-spacing:1px;opacity:.8;font-weight:800;text-transform:uppercase}
        .cc-dlg-cname{font-size:17px;font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .cc-dlg-csub{font-size:11.5px;opacity:.85;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .cc-dlg-x{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.35);color:#fff;width:34px;height:34px;border-radius:50%;cursor:pointer;font-size:14px;font-weight:900;line-height:1;flex:0 0 auto;transition:.15s}
        .cc-dlg-x:hover{background:rgba(255,255,255,.32);transform:rotate(90deg)}
        .cc-dlg-body{overflow-y:auto;padding:14px 20px 4px;overscroll-behavior:contain}
        .cc-dlg-section{margin-bottom:16px}
        .cc-lbl{font-size:12.5px;font-weight:900;color:#33415a;margin:0 0 8px;display:flex;align-items:center;gap:8px}
        .cc-lbl::after{content:"";flex:1;height:1px;background:linear-gradient(90deg,#e4e9f1,transparent)}
        .cc-mini-lbl{font-size:11.5px;font-weight:800;color:#55617a;margin:0 0 7px}
        .cc-hint{font-size:10px;color:#98a4b8;font-weight:700}
        .cc-chips{display:flex;flex-wrap:wrap;gap:8px}
        .cc-chip{border:1px solid #dbe2ee;background:#f6f8fc;cursor:pointer;border-radius:999px;padding:7px 15px;font-size:12.5px;font-weight:700;font-family:inherit;color:#3c4a66;transition:.12s}
        .cc-chip:hover{border-color:#b9c6dd}
        .cc-chip.sel{background:#0f63d9;color:#fff;border-color:#0f63d9;box-shadow:0 4px 10px rgba(15,99,217,.25)}
        .cc-dlg-split{display:grid;grid-template-columns:1fr 1fr;gap:4px 26px;align-items:start}
        .cc-star-btn{font-size:28px;line-height:1;background:none;border:0;cursor:pointer;color:#dbe3ee;padding:0 2px;transition:transform .12s,color .12s}
        .cc-star-btn.on{color:#f5a623;text-shadow:0 1px 3px rgba(0,0,0,.14)}
        .cc-star-btn:hover{transform:scale(1.22)}
        .cc-input{width:100%;border:1px solid #dbe2ee;border-radius:10px;padding:9px 12px;font-family:inherit;font-size:13px;background:#fbfcfe;transition:border .15s}
        .cc-input:focus{outline:0;border-color:#0f63d9;box-shadow:0 0 0 3px rgba(15,99,217,.12)}
        textarea.cc-input{resize:vertical;min-height:60px}
        .cc-dlg-ft{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px;padding:12px 20px;border-top:1px solid #eef1f7;background:#fafbfe;flex:0 0 auto;border-radius:0 0 18px 18px}
        .cc-dlg-actions{display:flex;gap:10px;align-items:center}
        .cc-btn-primary{background:#15965e;color:#fff;box-shadow:0 6px 14px rgba(21,150,94,.25)}
        .cc-btn-danger{background:#fdecec;color:#b02a37;border:1px solid #f3cdd0}
        .cc-note{font-size:12px;color:#55617a;display:inline-flex;gap:7px;align-items:center;cursor:pointer;font-weight:700}
        .cc-note input{width:16px;height:16px;accent-color:#15965e;cursor:pointer}
        .cc-foot-info{font-size:12px;color:#55617a;font-weight:700;display:inline-flex;gap:6px;align-items:center}
        .cc-stars{display:inline-flex;align-items:center;gap:6px;color:#f5a623;font-size:14px;letter-spacing:1px}
        .cc-stars small{font-size:10.5px;color:#8a93a6;font-weight:800;letter-spacing:0}
        .cc-ch{background:#eef2f8;color:#44506a;border-radius:10px;padding:1px 8px;font-size:10.5px;font-weight:800;margin-inline-start:6px;white-space:nowrap}
        .cc-filter{display:flex;flex-wrap:wrap;gap:8px;align-items:center;background:#fff;border:1px solid #e4e9f1;border-radius:12px;padding:10px 14px;margin-bottom:14px}
        .cc-filter .fl{font-size:12px;font-weight:900;color:#55617a}
        .cc-filter input[type=date]{border:1px solid #dbe2ee;border-radius:9px;padding:6px 8px;font-family:inherit;font-size:12.5px;background:#fbfcfe;color:#33415a}
        .cc-q{border:1px solid #dbe2ee;background:#f6f8fc;cursor:pointer;border-radius:999px;padding:5px 13px;font-size:12px;font-weight:800;font-family:inherit;color:#3c4a66;transition:.12s}
        .cc-q:hover{background:#eaf1ff}
        .cf-chk{display:inline-flex;gap:6px;align-items:center;margin-inline-start:auto;font-size:12px;color:#55617a;font-weight:700}
        .cc-cb{background:#fffaf0;border:1px solid #f0ddbc;border-radius:14px;margin-bottom:14px;overflow:hidden}
        .cc-cb-hd{display:flex;align-items:center;gap:8px;padding:9px 16px;background:#fff3dc;font-weight:900;font-size:13px;color:#8a5a00}
        .cc-cb-hd .cnt{background:#ffd98a;border-radius:20px;padding:1px 10px;font-size:11px;color:#6b4400}
        .cc-cb-row{display:flex;flex-wrap:wrap;gap:10px;align-items:center;padding:8px 16px;border-top:1px dashed #f0e0c2}
        .cc-cb-main{flex:1;min-width:190px}
        .cc-cb-name{font-weight:900;font-size:13px;color:#1c2a44;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
        .cc-cb-sub{font-size:11.5px;color:#8a6a3a;margin-top:2px}
        .cc-pill{border-radius:20px;padding:3px 11px;font-size:11px;font-weight:900;white-space:nowrap}
        .cc-pill.late{background:#fdecee;color:#c0392b}
        .cc-pill.today{background:#fff3d6;color:#a06c00}
        .cc-pill.soon{background:#e7f2ff;color:#155e9e}
        .cc-chip.sm{font-size:11.5px;padding:4px 10px}
        @@media(max-width:820px){.cc-dlg-split{grid-template-columns:1fr}}
        @@media(max-width:640px){.cc-hero{flex-direction:column;align-items:flex-start} .cc-dialog{width:100%} .cc-kpis{grid-template-columns:1fr 1fr}}
        @@media(max-width:420px){.cc-kpis{grid-template-columns:1fr}}
    </style>

    @if (!string.IsNullOrWhiteSpace(_okMsg))
    {
        <div class="cc-msg cc-ok">✅ @_okMsg</div>
    }
    @if (!string.IsNullOrWhiteSpace(_errMsg))
    {
        <div class="cc-msg cc-err">⚠️ @_errMsg</div>
    }

    <div class="cc-hero">
        <div>
            <h1>🎧 خدمة العملاء — فيدباك ما بعد البيع</h1>
            <p>اتصل بالعملاء بعد زيارة المعرض / متابعة فاتورة جديدة لم تُسلَّم / بعد تسليم الفاتورة / لمتابعة الشكاوى وسجّل نتيجتهم ورضاهم</p>
        </div>
        <div class="cc-hero-actions">
            <button class="cc-btn cc-btn-light" @onclick="Reload">↻ تحديث</button>
            <button class="cc-btn cc-btn-ghost" @onclick="GoHistory">📋 السجل والتقرير</button>
        </div>
    </div>

    <div class="cc-kpis">
        <button type="button" class="cc-kpi @KpiVisitsCls" @onclick="OnVisitsTab" title="عرض طابور زيارات المعرض">
            <span class="n">@_kpi.OpenVisits</span><span class="l">🏬 زيارة معرض بانتظار اتصال</span><span class="hint">افتح الطابور</span>
        </button>
        <button type="button" class="cc-kpi @KpiDeliveriesCls" @onclick="OnDeliveriesTab" title="عرض طابور ما بعد التسليم">
            <span class="n">@_kpi.OpenDeliveries</span><span class="l">📦 تسليم بانتظار اتصال</span><span class="hint">افتح الطابور</span>
        </button>
        <button type="button" class="cc-kpi t @KpiSalesInvoicesCls" @onclick="OnSalesInvoicesTab" title="عرض طابور فواتير المبيعات غير المسلَّمة">
            <span class="n">@_kpi.OpenSalesInvoices</span><span class="l">🧾 فاتورة مبيعات لم تُسلَّم</span><span class="hint">افتح الطابور</span>
        </button>
        <button type="button" class="cc-kpi @KpiComplaintsCls" @onclick="OnComplaintsTab" title="عرض طابور الشكاوى">
            <span class="n">@_kpi.OpenComplaints</span><span class="l">📞 شكاوى للمتابعة</span><span class="hint">افتح الطابور</span>
        </button>
        <button type="button" class="cc-kpi g" @onclick="GoHistory" title="مكالمات اليوم — فتح السجل">
            <span class="n">@_kpi.DoneToday</span><span class="l">مكالمات اليوم ✓</span><span class="hint">افتح السجل</span>
        </button>
        <button type="button" class="cc-kpi o" @onclick="GoHistory" title="متوسط الرضا — فتح السجل">
            <span class="n">@SatDisplay()</span><span class="l">متوسط الرضا (1-5)</span><span class="hint">افتح السجل</span>
        </button>
        <button type="button" class="cc-kpi p" @onclick="GoHistory" title="الفيدباك الإيجابي — فتح السجل">
            <span class="n">@_kpi.PositiveCount</span><span class="l">فيدباك إيجابي 👍</span><span class="hint">افتح السجل</span>
        </button>
    </div>

    @if (_dash.Callbacks.Any())
    {
        <div class="cc-cb">
            <div class="cc-cb-hd">⏰ متابعات مجدولة — «يتصل لاحقاً» <span class="cnt">@_dash.Callbacks.Count</span></div>
            @foreach (var cb in _dash.Callbacks)
            {
                <div class="cc-cb-row">
                    <div class="cc-cb-main">
                        <div class="cc-cb-name">@cb.ClientName
                            @if (cb.Phone != null)
                            {
                                <span dir="ltr" style="color:#2f6fd0;font-size:11.5px">📞 @cb.Phone</span>
                            }
                            <span class="cc-pill @CbPillCls(cb.NextCallDate)">@CbPillText(cb.NextCallDate)</span>
                        </div>
                        <div class="cc-cb-sub">@CustomerCareKindText.ToText(cb.Kind) · @(cb.SourceDate?.ToString("yyyy-MM-dd") ?? "—")</div>
                    </div>
                    <button type="button" class="cc-btn cc-btn-primary" @onclick="()=>OpenLog(cb)">📞 سجّل المتابعة</button>
                </div>
            }
        </div>
    }

    <div class="cc-filter">
        <span class="fl">🗓️ المدة:</span>
        <input type="date" @bind="_fromDate" @bind:after="Reload" title="من تاريخ" />
        <span class="fl" style="margin:0 -3px">←</span>
        <input type="date" @bind="_toDate" @bind:after="Reload" title="إلى تاريخ" />
        <button type="button" class="cc-q" @onclick="QuickRange7">آخر 7 أيام</button>
        <button type="button" class="cc-q" @onclick="QuickRange30">آخر 30 يوم</button>
        <label class="cf-chk">
            <input type="checkbox" @bind="_includeContacted" @bind:after="Reload" style="width:16px;height:16px" />
            إظهار من تم التواصل معه
        </label>
    </div>

    <div class="cc-tabs">
        <button class="cc-tab @TabVisitsCls" @onclick="OnVisitsTab">🏬 زيارة المعرض <b>(@_kpi.OpenVisits)</b></button>
        <button class="cc-tab @TabDeliveriesCls" @onclick="OnDeliveriesTab">📦 بعد التسليم <b>(@_kpi.OpenDeliveries)</b></button>
        <button class="cc-tab @TabSalesInvoicesCls" @onclick="OnSalesInvoicesTab">🧾 فاتورة جديدة <b>(@_kpi.OpenSalesInvoices)</b></button>
        <button class="cc-tab @TabComplaintsCls" @onclick="OnComplaintsTab">📞 الشكاوى <b>(@_kpi.OpenComplaints)</b></button>
    </div>

    <div class="cc-card">
        @if (_rows.Count == 0)
        {
            <div class="cc-empty">لا توجد مكالمات بانتظارك في هذا القسم حالياً 🎉</div>
        }
        else
        {
            foreach (var it in _rows)
            {
                <div class="cc-row">
                    <div class="cc-main">
                        <div class="cc-name">
                            <span>@it.ClientName</span>
                            @if (it.Phone != null)
                            {
                                <span style="direction:ltr;color:#2f6fd0;font-size:12px" dir="ltr">📞 @it.Phone</span>
                            }
                        </div>
                        <div class="cc-sub">@it.Title · @(it.SourceDate?.ToString("yyyy-MM-dd") ?? "")@if(!string.IsNullOrWhiteSpace(it.Channel)){<span class="cc-ch">عبر @it.Channel</span>}</div>
                    </div>
                    <div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px">
                        @if (it.FeedbackStatus is null or CustomerCareStatus.Skipped)
                        {
                            <span class="cc-open">بانتظار الاتصال</span>
                        }
                        else if (it.FeedbackStatus == CustomerCareStatus.Open)
                        {
                            <span class="cc-open">⏰ متابعة — @CustomerCareOutcome.ToText(it.FeedbackOutcome)</span>
                        }
                        else
                        {
                            <span class="cc-done">تم — @CustomerCareOutcome.ToText(it.FeedbackOutcome)</span>
                        }
                        @if (it.Satisfaction.HasValue)
                        {
                            <span class="cc-stars" style="gap:5px"><span style="font-size:16px;letter-spacing:0">@StarText(it.Satisfaction)</span><small style="font-size:11px">رضا @it.Satisfaction/5</small></span>
                        }
                    </div>
                    <button class="cc-btn cc-btn-primary" @onclick="()=>OpenLog(it)">
                        @(it.ExistingFeedbackId.HasValue ? "✏️ تسجيل متابعة" : "📝 سجّل نتيجة الاتصال")
                    </button>
                </div>
            }
        }
    </div>

    @if (_logging)
    {
        <div class="cc-overlay" @onclick="CloseLog">
            <div class="cc-dialog" @onclick:stopPropagation="true">
                <div class="cc-dlg-hd">
                    <div class="cc-dlg-hd-info">
                        <div class="cc-avatar">@AvatarChar()</div>
                        <div class="cc-dlg-meta">
                            <div class="cc-dlg-eyebrow">تسجيل نتيجة الاتصال</div>
                            <div class="cc-dlg-cname">@(_sel?.ClientName ?? "—")
                                @if (_sel?.Phone != null)
                                {
                                    <span dir="ltr" style="font-size:12px;font-weight:700;opacity:.9;margin-inline-start:8px">📞 @_sel.Phone</span>
                                }
                            </div>
                            <div class="cc-dlg-csub">@CustomerCareKindText.ToText(_sel?.Kind) · @(_sel?.Title ?? "")</div>
                        </div>
                    </div>
                    <button type="button" class="cc-dlg-x" @onclick="CloseLog" title="إغلاق">✕</button>
                </div>

                <div class="cc-dlg-body">
                    <div class="cc-dlg-section">
                        <span class="cc-lbl">نتيجة المكالمة</span>
                        <div class="cc-chips">
                            @foreach (var (key,label) in Outcomes())
                            {
                                <button type="button" class="cc-chip @OutcomeCls(key)" @onclick="()=>PickOutcome(key)">@label</button>
                            }
                        </div>
                    </div>

                    <div class="cc-dlg-section">
                        <span class="cc-lbl">تفاصيل الاتصال</span>
                        <div class="cc-dlg-split">
                            <div>
                                <div class="cc-mini-lbl">قناة التواصل</div>
                                <div class="cc-chips">
                                    @foreach (var ch in Channels())
                                    {
                                        <button type="button" class="cc-chip @ChannelCls(ch)" @onclick="()=>PickChannel(ch)">@ch</button>
                                    }
                                </div>
                            </div>
                            <div>
                                <div class="cc-mini-lbl">درجة رضا العميل <span class="cc-hint">— اضغط على النجوم (اختياري)</span></div>
                                <div dir="ltr" style="display:flex;align-items:center;gap:2px;flex-wrap:wrap">
                                    @foreach (var s in new[] { 1, 2, 3, 4, 5 })
                                    {
                                        <button type="button" class="cc-star-btn @SatStarCls(s)" @onclick="()=>PickSat(s)" title="درجة @s">@StarGlyph(s)</button>
                                    }
                                    @if (_log.Satisfaction.HasValue)
                                    {
                                        <span style="font-size:12px;color:#8a93a6;font-weight:900;margin-inline-start:8px">@_log.Satisfaction/5</span>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (_log.Outcome == CustomerCareOutcome.CallbackLater)
                        {
                            <div style="margin-top:12px;max-width:280px">
                                <div class="cc-mini-lbl">📅 موعد إعادة الاتصال</div>
                                <input type="date" class="cc-input" value="@_nextCallStr" @onchange="OnNextCallChange" />
                            </div>
                        }
                    </div>

                    <div class="cc-dlg-section">
                        <span class="cc-lbl">الملاحظات</span>
                        <div class="cc-chips" style="margin-bottom:10px">
                            @foreach (var (icon, tpl) in NoteTemplates())
                            {
                                <button type="button" class="cc-chip sm" @onclick="()=>ApplyNoteTemplate(tpl)">@icon @tpl</button>
                            }
                        </div>
                        <div class="cc-dlg-split">
                            <div>
                                <div class="cc-mini-lbl">ماذا قال العميل؟</div>
                                <textarea class="cc-input" rows="4" @bind="_notesText" placeholder="اكتب ملخص الفيدباك..."></textarea>
                            </div>
                            <div>
                                <div class="cc-mini-lbl">💼 انطباع الموظف <span class="cc-hint">— داخلي لا يظهر للعميل</span></div>
                                <textarea class="cc-input" rows="4" @bind="_empNotes" placeholder="انطباعك وتقييمك للمكالمة..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="cc-dlg-ft">
                    @if (_sel?.ExistingFeedbackId == null)
                    {
                        <label class="cc-note">
                            <input type="checkbox" @bind="_markSkipped" />
                            لا يمكن الوصول / أُسقط مؤقتاً (لا يُحسب في الرضا)
                        </label>
                    }
                    else
                    {
                        <span class="cc-foot-info">✏️ متابعة — سيُحدَّث السجل القائم</span>
                    }
                    <div class="cc-dlg-actions">
                        <button class="cc-btn cc-btn-danger" @onclick="CloseLog">إلغاء</button>
                        <button class="cc-btn cc-btn-primary" disabled="@_busy" @onclick="SaveLog">@(_busy ? "جارٍ الحفظ..." : "حفظ الفيدباك ✓")</button>
                    </div>
                </div>
            </div>
        </div>
    }

    }

</div>

    @code {
        private ClaimsPrincipal? _user;
        private bool _denied;

        private void GoHistory() => Nav.NavigateTo("/crm/customer-care/history");
        private bool _busy;
        private string _tab = "visits";
        private string _okMsg = "";
        private string _errMsg = "";
        private CustomerCareDashboardDto _dash = new();
        private CustomerCareKpiDto _kpi => _dash.Kpis;
        private List<CustomerCareQueueItemDto> _rows => _tab switch
        {
            "deliveries" => _dash.Deliveries,
            "salesInvoices" => _dash.SalesInvoices,
            "complaints" => _dash.Complaints,
            _ => _dash.Visits
        };
        private bool _includeContacted;
        private CustomerCareQueueItemDto? _sel;
        private bool _logging;
        private CustomerCareLogDto _log = new();
        private string _notesText = "";
        private string _empNotes = "";
        private DateTime? _fromDate;
        private DateTime? _toDate;
        private string _nextCallStr = "";
        private string _channel = "اتصال";
        private bool _markSkipped;

        protected override async Task OnInitializedAsync()
        {
            var auth = await Auth.GetAuthenticationStateAsync();
            var user = auth.User;
            _user = user;
            if (!CustomerCarePermissions.CanView(user))
            {
                _denied = true;
                return;
            }
            await Reload();
        }

        private async Task Reload()
        {
            _busy = true;
            _errMsg = "";
            try
            {
                _dash = await CC.GetDashboardAsync(new CustomerCareDashboardFilterDto
                {
                    DaysBack = 30,
                    DateFrom = _fromDate,
                    DateTo = _toDate,
                    IncludeContacted = _includeContacted
                }, _user);
            }
            catch (Exception ex)
            {
                _errMsg = ex.Message;
            }
            finally
            {
                _busy = false;
            }
        }

        private string TabVisitsCls => _tab == "visits" ? "active" : "";
        private string TabDeliveriesCls => _tab == "deliveries" ? "active" : "";
        private string TabSalesInvoicesCls => _tab == "salesInvoices" ? "active" : "";
        private string TabComplaintsCls => _tab == "complaints" ? "active" : "";
        private string KpiVisitsCls => _tab == "visits" ? "act" : "";
        private string KpiDeliveriesCls => _tab == "deliveries" ? "act" : "";
        private string KpiSalesInvoicesCls => _tab == "salesInvoices" ? "act" : "";
        private string KpiComplaintsCls => _tab == "complaints" ? "act" : "";
        private void OnVisitsTab() => _tab = "visits";
        private void OnDeliveriesTab() => _tab = "deliveries";
        private void OnSalesInvoicesTab() => _tab = "salesInvoices";
        private void OnComplaintsTab() => _tab = "complaints";

        private void QuickRange7()
        {
            _fromDate = DateTime.Today.AddDays(-6);
            _toDate = DateTime.Today;
            _ = Reload();
        }

        private void QuickRange30()
        {
            _fromDate = null;
            _toDate = null;
            _ = Reload();
        }

        private void PickSat(int s) => _log.Satisfaction = (byte)s;

        private void PickChannel(string c) => _channel = c;
        private string ChannelCls(string c) => _channel == c ? "sel" : "";
        private static string[] Channels() => new[] { "اتصال", "واتساب", "إيميل" };

        private void ApplyNoteTemplate(string text)
        {
            _notesText = string.IsNullOrWhiteSpace(_notesText) ? text : _notesText.TrimEnd() + "\n" + text;
        }

        private static (string, string)[] NoteTemplates() => new[]
        {
            ("😊", "العميل راضٍ تماماً عن الخدمة ولا توجد ملاحظات."),
            ("👍", "أشاد بجودة المنتج وسرعة الاستجابة."),
            ("⏱", "اشتكى من تأخّر التسليم."),
            ("🤝", "أكّد أن الشكوى اتُّحلت بشكل جيّد."),
            ("📞", "طلب التواصل مجدداً في وقت لاحق."),
            ("🧾", "سأل عن تفاصيل الفاتورة والمدفوعات.")
        };

        private string CbPillCls(DateTime? d)
        {
            if (!d.HasValue) return "soon";
            var day = d.Value.Date;
            if (day < DateTime.Today) return "late";
            return day <= DateTime.Today.AddDays(1) ? "today" : "soon";
        }

        private string CbPillText(DateTime? d)
        {
            if (!d.HasValue) return "بلا موعد";
            var day = d.Value.Date;
            if (day < DateTime.Today) return $"متأخرة {DateTime.Today.Subtract(day).Days} يوم";
            if (day == DateTime.Today) return "اليوم";
            if (day == DateTime.Today.AddDays(1)) return "غداً";
            return day.ToString("yyyy-MM-dd");
        }

        private string SatDisplay() => _kpi.AvgSatisfaction?.ToString("0.0") ?? "—";

        private string OutcomeCls(string key) => _log.Outcome == key ? "sel" : "";

        private string SatStarCls(int s) => _log.Satisfaction.HasValue && _log.Satisfaction >= s ? "on" : "";
        private char StarGlyph(int s) => _log.Satisfaction.HasValue && _log.Satisfaction >= s ? '★' : '☆';
        private static string StarText(byte? s)
        {
            if (!s.HasValue || s.Value < 1) return "";
            var n = Math.Min((int)s.Value, 5);
            return new string('★', n) + new string('☆', 5 - n);
        }
        private string AvatarChar()
        {
            var name = _sel?.ClientName;
            return string.IsNullOrWhiteSpace(name) ? "👤" : name.Substring(0, 1);
        }

        private static (string, string)[] Outcomes() => new[]
        {
            (CustomerCareOutcome.Positive, "👍 إيجابي / راضٍ"),
            (CustomerCareOutcome.Negative, "👎 سلبي / استياء"),
            (CustomerCareOutcome.NoAnswer, "📵 لم يرد"),
            (CustomerCareOutcome.NotInterested, "🚫 غير مهتم"),
            (CustomerCareOutcome.CallbackLater, "⏰ يتصل لاحقاً")
        };

        private void PickOutcome(string key)
        {
            _log.Outcome = key;
            if (key != CustomerCareOutcome.CallbackLater)
                _nextCallStr = "";
        }

        private void OnNextCallChange(ChangeEventArgs e)
        {
            _nextCallStr = e.Value?.ToString() ?? "";
        }

        private void OpenLog(CustomerCareQueueItemDto it)
        {
            _sel = it;
            _log = new CustomerCareLogDto
            {
                FeedbackId = it.ExistingFeedbackId,
                Kind = it.Kind,
                PartyId = it.PartyId,
                OpportunityId = it.OpportunityId,
                TransactionId = it.TransactionId,
                ComplaintId = it.ComplaintId,
                VisitInteractionId = it.VisitInteractionId,
                ClientName = it.ClientName,
                Phone = it.Phone,
                SourceDate = it.SourceDate,
                Outcome = CustomerCareOutcome.Positive
            };
            _notesText = "";
            _empNotes = "";
            _channel = "اتصال";
            _markSkipped = false;
            _nextCallStr = "";
            _errMsg = "";
            _logging = true;
        }

        private void CloseLog()
        {
            if (!_busy)
            {
                _logging = false;
                _sel = null;
            }
        }

        private async Task SaveLog()
        {
            if (_sel == null) return;
            _busy = true;
            _errMsg = "";
            try
            {
                _log.Notes = string.IsNullOrWhiteSpace(_notesText) ? null : _notesText.Trim();
                _log.EmployeeNotes = string.IsNullOrWhiteSpace(_empNotes) ? null : _empNotes.Trim();
                _log.Channel = string.IsNullOrWhiteSpace(_channel) ? "اتصال" : _channel.Trim();
                _log.MarkSkipped = _markSkipped;

                if (_log.Outcome == CustomerCareOutcome.CallbackLater)
                {
                    _log.NextCallDate = DateTime.TryParse(_nextCallStr, out var d)
                        ? d
                        : DateTime.Today.AddDays(1);
                }

                var (ok, msg, _) = await CC.LogOutcomeAsync(_log, _user);
                if (ok)
                {
                    _logging = false;
                    _sel = null;
                    await Reload();
                    _okMsg = msg;
                }
                else
                {
                    _errMsg = msg;
                }
            }
            catch (Exception ex)
            {
                _errMsg = ex.Message;
            }
            finally
            {
                _busy = false;
            }
        }
    }

