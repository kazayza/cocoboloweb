@page "/crm/customer-care/history"
@attribute [Authorize]

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop

@inject ICustomerCareService CC
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth
@inject IJSRuntime JS

@if (_denied)
{
    <div class="cch-page" dir="rtl">
        <div class="cch-card cch-err" style="padding:22px;font-weight:800;border:1px solid #f2c2c7;background:#fdecee;color:#b02a37;border-radius:12px">⛔ لا تملك صلاحية الدخول إلى السجل.</div>
    </div>
}

<div class="cch-page" dir="rtl">
    @if (!_denied)
    {

    <style>
        .cch-page{font-family:"Cairo","Tajawal",sans-serif;background:#f2f5fa;min-height:100vh;padding:18px;color:#16233b}
        .cch-page *,.cch-page *::before,.cch-page *::after{box-sizing:border-box}
        .cch-hero{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;background:linear-gradient(120deg,#0e3a6b,#1264d8);border-radius:16px;padding:16px 22px;color:#fff;box-shadow:0 10px 24px rgba(18,58,120,.16)}
        .cch-hero h1{margin:0;font-size:19px;font-weight:900}
        .cch-hero p{margin:3px 0 0;font-size:12.5px;opacity:.85}
        .cch-actions{display:flex;gap:8px;flex-wrap:wrap}
        .cch-btn{border:0;cursor:pointer;border-radius:10px;padding:8px 15px;font-family:inherit;font-weight:800;font-size:12.5px;transition:.15s}
        .cch-btn:hover{transform:translateY(-1px)}
        .cch-btn-l{background:#fff;color:#0e3a6b}
        .cch-btn-g{background:rgba(255,255,255,.16);color:#fff;border:1px solid rgba(255,255,255,.3)}
        .cch-btn-p{background:#15965e;color:#fff}
        .cch-toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;background:#fff;border:1px solid #e4e9f1;border-radius:14px;padding:12px 16px;margin:16px 0}
        .cch-toolbar input[type=text]{border:1px solid #dbe2ee;border-radius:9px;padding:8px 12px;font-family:inherit;font-size:13px;min-width:220px}
        .cch-toolbar select{border:1px solid #dbe2ee;border-radius:9px;padding:8px 12px;font-family:inherit;font-size:13px;background:#fff}
        .cch-hint{margin-inline-start:auto;font-size:12px;color:#6a7890;font-weight:700}
        .cch-card{background:#fff;border:1px solid #e4e9f1;border-radius:14px;overflow:hidden}
        .cch-empty{padding:40px;text-align:center;color:#8894a8;font-weight:700}
        table.cch-tbl{width:100%;border-collapse:collapse}
        table.cch-tbl th{background:#f6f8fc;color:#44506a;font-size:11.5px;padding:11px 12px;text-align:right;font-weight:900;border-bottom:1px solid #e4e9f1;white-space:nowrap}
        table.cch-tbl td{padding:10px 12px;border-bottom:1px solid #f0f2f8;font-size:12.5px;vertical-align:middle}
        table.cch-tbl tr:last-child td{border-bottom:0}
        .st-done{color:#0f8a52;background:#e7f6ef;border-radius:14px;padding:2px 10px;font-size:11px;font-weight:800;white-space:nowrap}
        .st-open{color:#123a78;background:#eaf1ff;border-radius:14px;padding:2px 10px;font-size:11px;font-weight:800;white-space:nowrap}
        .st-skip{color:#c0392b;background:#fdecee;border-radius:14px;padding:2px 10px;font-size:11px;font-weight:800;white-space:nowrap}
        .cch-x{background:transparent;border:1px solid #e3c8c8;color:#b34040;border-radius:8px;padding:4px 10px;cursor:pointer;font-size:11px;font-weight:800;font-family:inherit}
        .cch-pager{display:flex;gap:10px;justify-content:space-between;align-items:center;padding:14px 16px;flex-wrap:wrap}
        .cch-pager b{color:#123a78}
        .cch-msg{border-radius:12px;padding:11px 16px;margin:12px 0;font-weight:800;font-size:13px}
        .cch-ok{background:#e7f6ef;color:#0f7a48;border:1px solid #bde9d1}
        .cch-err{background:#fdecee;color:#b02a37;border:1px solid #f5c2c7}
        .cch-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(118px,1fr));gap:10px;margin:14px 0}
        .cch-stat{background:#fff;border:1px solid #e4e9f1;border-radius:12px;padding:10px 14px;display:flex;flex-direction:column;gap:2px}
        .cch-stat .n{font-size:20px;font-weight:900}
        .cch-stat .l{font-size:11px;color:#6a7890;font-weight:800}
        .cch-stat.all .n{color:#123a78}.cch-stat.pos .n{color:#15965e}.cch-stat.neg .n{color:#d93445}
        .cch-stat.na .n{color:#8a93a6}.cch-stat.ni .n{color:#e08a00}.cch-stat.cl .n{color:#2f6fd0}
        @@media(max-width:720px){table.cch-tbl{font-size:11px} .cch-hint{margin-inline-start:0;width:100%}}
    </style>

    @if (!string.IsNullOrWhiteSpace(_ok))
    {
        <div class="cch-msg cch-ok">✅ @_ok</div>
    }
    @if (!string.IsNullOrWhiteSpace(_err))
    {
        <div class="cch-msg cch-err">⚠️ @_err</div>
    }

    <div class="cch-hero">
        <div>
            <h1>📋 سجل فيدباك خدمة العملاء</h1>
            <p>كل مكالمات الفيدباك المسجّلة — فلترة وتصدير Excel</p>
        </div>
        <div class="cch-actions">
            <button class="cch-btn cch-btn-l" @onclick="GoBack">← عودة للوحة</button>
            <button class="cch-btn cch-btn-p" disabled="@(_exporting || _page.TotalCount==0)" @onclick="ExportAsync">
                @(_exporting ? "جارٍ التصدير..." : "⬇ تصدير Excel")
            </button>
        </div>
    </div>

    @if (_page.OutcomeStats.Any())
    {
        <div class="cch-stats">
            <div class="cch-stat all"><span class="n">@DoneSum</span><span class="l">تم التواصل</span></div>
            <div class="cch-stat pos"><span class="n">@Oc(CustomerCareOutcome.Positive)</span><span class="l">إيجابي 👍</span></div>
            <div class="cch-stat neg"><span class="n">@Oc(CustomerCareOutcome.Negative)</span><span class="l">سلبي 👎</span></div>
            <div class="cch-stat na"><span class="n">@Oc(CustomerCareOutcome.NoAnswer)</span><span class="l">لم يرد 📵</span></div>
            <div class="cch-stat ni"><span class="n">@Oc(CustomerCareOutcome.NotInterested)</span><span class="l">غير مهتم 🚫</span></div>
            <div class="cch-stat cl"><span class="n">@Oc(CustomerCareOutcome.CallbackLater)</span><span class="l">يتصل لاحقاً ⏰</span></div>
        </div>
    }

    <div class="cch-toolbar">
        <input type="text" placeholder="🔎 عميل / جوال / نص الملاحظة..." @bind="_search" @bind:event="oninput" @onkeydown="OnSearchKey" />
        <select @bind="_kindFilter">
            <option value="">كل المصادر</option>
            <option value="Visit">🏬 بعد زيارة المعرض</option>
            <option value="Delivery">📦 بعد تسليم الفاتورة</option>
            <option value="ComplaintFollowUp">📞 متابعة شكوى</option>
        </select>
        <select @bind="_statusFilter">
            <option value="">كل الحالات</option>
            <option value="Done">تم التواصل</option>
            <option value="Open">في انتظار متابعة</option>
            <option value="Skipped">مُسقط</option>
        </select>
        <input type="date" @bind="_fromDate" style="border:1px solid #dbe2ee;border-radius:9px;padding:8px;font-family:inherit;font-size:13px" />
        <span style="color:#8a95a8;font-weight:800">←</span>
        <input type="date" @bind="_toDate" style="border:1px solid #dbe2ee;border-radius:9px;padding:8px;font-family:inherit;font-size:13px" />
        <button class="cch-btn" style="background:#123a78;color:#fff" @onclick="()=>{_pageIndex=1; _=Reload();}">تصفية</button>
        <button class="cch-btn" style="background:#eef2f8;color:#44506a" @onclick="ResetFilters">مسح</button>
        <span class="cch-hint">@_page.TotalCount سجل</span>
    </div>

    <div class="cch-card">
        @if (!_page.Items.Any())
        {
            <div class="cch-empty">لا توجد سجلات مطابقة.</div>
        }
        else
        {
            <table class="cch-tbl">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>المصدر</th>
                        <th>العميل / الجوال</th>
                        <th>النتيجة</th>
                        <th>الرضا</th>
                        <th>سجّله</th>
                        <th>تاريخ التسجيل</th>
                        <th>أكمله</th>
                        @if (_canHide)
                        {
                            <th></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var it in _page.Items)
                    {
                        <tr>
                            <td>@it.FeedbackId</td>
                            <td>@it.KindText</td>
                            <td>
                                <div style="font-weight:900;color:#1c2a44">@it.ClientName</div>
                                @if (it.Phone != null)
                                {
                                    <div dir="ltr" style="font-size:11px;color:#2f6fd0;text-align:right">@it.Phone</div>
                                }
                            </td>
                            <td>
                                @if (it.Status == "Done")
                                {
                                    <span class="st-done">تم — @it.OutcomeText</span>
                                }
                                else if (it.Status == "Open")
                                {
                                    <span class="st-open">متابعة — @it.OutcomeText</span>
                                }
                                else
                                {
                                    <span class="st-skip">مُسقط</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(it.Notes))
                                {
                                    <div style="color:#6a7890;font-size:11px;margin-top:2px;max-width:260px">@it.Notes</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(it.EmployeeNotes))
                                {
                                    <div style="color:#8a5fb8;font-size:11px;margin-top:2px;max-width:260px" title="ملاحظة داخلية">💼 @it.EmployeeNotes</div>
                                }
                            </td>
                            <td>@(it.Satisfaction.HasValue ? $"{it.Satisfaction} ★" : "—")</td>
                            <td>@it.CreatedBy</td>
                            <td style="white-space:nowrap">@(it.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "")</td>
                            <td style="white-space:nowrap">@it.CompletedBy</td>
                            @if (_canHide)
                            {
                                <td><button class="cch-x" title="إخفاء من السجل" @onclick="()=>Hide(it.FeedbackId)">✕</button></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (_page.TotalCount > _page.PageSize)
    {
        <div class="cch-pager">
            <span>صفحة <b>@_pageIndex</b> من @((_page.TotalCount + _page.PageSize - 1) / _page.PageSize)</span>
            <div style="display:flex;gap:8px">
                <button class="cch-btn" style="background:#eef2f8;color:#44506a" disabled="@(_pageIndex<=1)" @onclick="()=>GoPage(_pageIndex-1)">→ السابق</button>
                <button class="cch-btn" style="background:#eef2f8;color:#44506a" disabled="@(!_page.HasMore)" @onclick="()=>GoPage(_pageIndex+1)">التالي ←</button>
            </div>
        </div>
    }

    }

</div>

    @code {
        private ClaimsPrincipal? _user;
        private bool _denied;

        private void GoBack() => Nav.NavigateTo("/crm/customer-care");
        private bool _canHide;
        private bool _exporting;
        private string _ok = "";
        private string _err = "";
        private string _search = "";
        private string _kindFilter = "";
        private string _statusFilter = "";
        private DateTime? _fromDate;
        private DateTime? _toDate;
        private int _pageIndex = 1;
        private const int _pageSize = 25;
        private CustomerCareHistoryDto _page = new();

        protected override async Task OnInitializedAsync()
        {
            var auth = await Auth.GetAuthenticationStateAsync();
            var user = auth.User;
            _user = user;
            if (!CustomerCarePermissions.CanView(user))
            {
                _denied = true;
                return;
            }
            _canHide = CustomerCarePermissions.CanViewAll(user);
            await Reload();
        }

        private void OnSearchKey(KeyboardEventArgs e)
        {
            if (e.Key == "Enter")
            {
                _pageIndex = 1;
                _ = Reload();
            }
        }

        private void ResetFilters()
        {
            _search = "";
            _kindFilter = "";
            _statusFilter = "";
            _fromDate = null;
            _toDate = null;
            _pageIndex = 1;
            _ = Reload();
        }

        private void GoPage(int p)
        {
            if (p < 1) return;
            _pageIndex = p;
            _ = Reload();
        }

        private int Oc(string key) => _page.OutcomeStats.FirstOrDefault(s => s.Outcome == key)?.Count ?? 0;
        private int DoneSum => _page.OutcomeStats.Sum(s => s.Count);

        private async Task Reload()
        {
            _err = "";
            try
            {
                _page = await CC.GetHistoryAsync(new CustomerCareHistoryFilterDto
                {
                    Search = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
                    Kind = string.IsNullOrWhiteSpace(_kindFilter) ? null : _kindFilter,
                    Status = string.IsNullOrWhiteSpace(_statusFilter) ? null : _statusFilter,
                    DateFrom = _fromDate,
                    DateTo = _toDate,
                    PageIndex = _pageIndex,
                    PageSize = _pageSize
                }, _user);
            }
            catch (Exception ex)
            {
                _err = ex.Message;
            }
        }

        private async Task Hide(int feedbackId)
        {
            _err = "";
            try
            {
                var (ok, msg) = await CC.HideAsync(feedbackId, _user);
                if (ok)
                {
                    _ok = msg;
                    await Reload();
                }
                else
                {
                    _err = msg;
                }
            }
            catch (Exception ex)
            {
                _err = ex.Message;
            }
        }

        private async Task ExportAsync()
        {
            if (_exporting) return;
            _exporting = true;
            _err = "";
            try
            {
                var (content, mime, name) = await CC.ExportAsync(new CustomerCareReportFilterDto
                {
                    DateFrom = _fromDate,
                    DateTo = _toDate,
                    Kind = string.IsNullOrWhiteSpace(_kindFilter) ? null : _kindFilter
                }, _user);

                var b64 = Convert.ToBase64String(content);
                await JS.InvokeVoidAsync("downloadFile",
                    $"CustomerCare_{DateTime.Now:yyyyMMdd_HHmm}.xlsx", mime, b64);
                _ok = "تم تصدير السجل ✓";
            }
            catch (Exception ex)
            {
                _err = ex.Message;
            }
            finally
            {
                _exporting = false;
            }
        }

    }

