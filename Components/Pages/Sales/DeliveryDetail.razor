@page "/sales-delivery-status/{TransactionId:int}"
@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using MudBlazor
@using COCOBOLOERPNEW.Components.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.ComponentModel.DataAnnotations

@inject ISalesDeliveryStatusService DeliveryService
@inject ISnackbar Snackbar
@inject ILogger<DeliveryDetail> Logger
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IJSRuntime JS

@attribute [Authorize]

<PageTitle>تفاصيل التسليم #@TransactionId</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">

    @* ── Header مع زرار رجوع ─────────────────────────────── *@
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Nav.NavigateTo("/sales-delivery-status"))">
            رجوع للقائمة
        </MudButton>

        <MudStack Row="true" Spacing="1">
            @if (_canPrint && _detail is not null)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Print"
                           OnClick="PrintAsync">طباعة</MudButton>
            }
            @if (_canCreateTask && _detail is not null)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.AddTask"
                           OnClick="OpenCreateTaskAsync">تكليف جديد</MudButton>
            }
        </MudStack>
    </MudStack>

    @if (_loading)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="min-height:400px;" Spacing="2">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">جارٍ التحميل...</MudText>
        </MudStack>
    }
    else if (_detail is null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
            لا توجد بيانات لهذه الفاتورة (رقم @TransactionId)
        </MudAlert>
    }
    else
    {
        @* ── Hero Header ────────────────────────────────── *@
        <MudPaper Class="pa-4 mb-3 rounded-lg"
                  Style="background:linear-gradient(135deg,#060C18 0%,#0D1B30 60%,#132A47 100%); color:white; border-bottom:2px solid var(--gold);"
                  Elevation="2">
            @* الحالة والمدة المتبقية مثبتتان في أقصى يسار الهيدر (نهاية الاتجاه في RTL) *@
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Style="font-size:3rem; color:var(--gold);" />
                    <div>
                        <MudText Typo="Typo.h4">فاتورة #@_detail.TransactionId</MudText>
                        <MudText Typo="Typo.body2" Style="opacity:.9;">
                            @_detail.TransactionDate.ToString("yyyy/MM/dd")
                            @if (_detail.DueDate.HasValue)
                            {
                                <span> • استحقاق: @_detail.DueDate.Value.ToString("yyyy/MM/dd")</span>
                            }
                        </MudText>
                    </div>
                </MudStack>
                <MudStack AlignItems="AlignItems.End" Spacing="1" Style="margin-inline-start:auto;">
                    <MudChip T="string"
                             Variant="Variant.Filled"
                             Color="@GetChipColor(_detail.DeliveryStatus)"
                             Icon="@GetStatusIcon(_detail.DeliveryStatus)"
                             Size="Size.Large">
                        @_detail.DeliveryStatus
                    </MudChip>
                    @if (_progress?.CompletedBySettlement == true)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                 Color="Color.Info" Style="color:white; border-color:white;">
                            اكتملت بتسوية (ردّ نهائي)
                        </MudChip>
                    }
                    @if (_detail.DaysRemaining.HasValue && _detail.DeliveryStatus != "تم التسليم")
                    {
                        var d = _detail.DaysRemaining.Value;
                        <MudText Typo="Typo.body2" Style="opacity:.9;">
                            @(d < 0 ? $"متأخر {Math.Abs(d)} يوم" : $"باقي {d} يوم")
                        </MudText>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>

        @* ── Customer / Salesman / Delivery Person Cards ── *@
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-3" Elevation="1" Style="height:100%;">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" Style="font-size:2rem;" />
                        <div style="flex:1;">
                            <MudText Typo="Typo.overline" Color="Color.Primary">العميل</MudText>
                            <MudText Typo="Typo.h6">@_detail.PartyName</MudText>
                            @if (!string.IsNullOrWhiteSpace(_detail.PartyPhone))
                            {
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.body2" Style="align-self:center;">
                                        <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" /> @_detail.PartyPhone
                                    </MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Call"
                                                   Size="Size.Small" Color="Color.Success"
                                                   Href="@($"tel:{_detail.PartyPhone}")"
                                                   Title="اتصال بالعميل" />
                                </MudStack>
                            }
                            @if (!string.IsNullOrWhiteSpace(_detail.PartyAddress))
                            {
                                <MudText Typo="Typo.body2">
                                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" /> @_detail.PartyAddress
                                </MudText>
                            }
                        </div>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-3" Elevation="1" Style="height:100%;">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
                        <MudIcon Icon="@Icons.Material.Filled.Badge" Color="Color.Secondary" Style="font-size:2rem;" />
                        <div style="flex:1;">
                            <MudText Typo="Typo.overline" Color="Color.Secondary">مسئول المبيعات</MudText>
                            <MudText Typo="Typo.h6">@(_detail.SalesEmployeeName ?? "—")</MudText>
                        </div>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-3" Elevation="1" Style="height:100%;">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
                        <MudIcon Icon="@Icons.Material.Filled.DeliveryDining" Color="Color.Tertiary" Style="font-size:2rem;" />
                        <div style="flex:1;">
                            <MudText Typo="Typo.overline" Color="Color.Tertiary">مسئول التسليم</MudText>
                            <MudText Typo="Typo.h6">@(_detail.DeliveryEmployeeName ?? "لم يُحدد")</MudText>
                            @if (_detail.DeliveredAt.HasValue)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Success">
                                    سُلّمت في @_detail.DeliveredAt.Value.ToString("yyyy/MM/dd HH:mm")
                                </MudText>
                            }
                        </div>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @* ── Products (كروت / جدول) ───────────────────── *@
        <MudPaper Class="pa-4 mb-3" Elevation="1">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" /> المنتجات (@_detail.Products.Count)
                </MudText>
                <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                    <MudButton StartIcon="@Icons.Material.Filled.TableRows"
                               Variant="@(!_viewCards ? Variant.Filled : Variant.Outlined)"
                               Color="@(!_viewCards ? Color.Primary : Color.Default)"
                               OnClick="@(() => _viewCards = false)">جدول</MudButton>
                    <MudButton StartIcon="@Icons.Material.Filled.GridView"
                               Variant="@(_viewCards ? Variant.Filled : Variant.Outlined)"
                               Color="@(_viewCards ? Color.Primary : Color.Default)"
                               OnClick="@(() => _viewCards = true)">كروت</MudButton>
                </MudButtonGroup>
            </MudStack>

            @if (_detail.Products.Count == 0)
            {
                <MudAlert Severity="Severity.Info">لا توجد منتجات</MudAlert>
            }
            else if (_viewCards)
            {
                <MudGrid Spacing="2">
                    @foreach (var p in _detail.Products)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudPaper Elevation="2" Class="product-card" Style="overflow:hidden; cursor:pointer;"
                                      @onclick="@(async () => await OpenImagePreview(p))">
                                <div style="position:relative; width:100%; padding-top:75%; background:#f5f5f5; overflow:hidden;">
                                    <img src="/api/product-images/@p.ProductId"
                                         alt="@p.ProductName"
                                         loading="lazy"
                                         onerror="this.onerror=null;this.src='data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 75%22><rect fill=%22%23eee%22 width=%22100%22 height=%2275%22/><text x=%2250%22 y=%2240%22 text-anchor=%22middle%22 font-size=%228%22 fill=%22%23999%22>لا توجد صورة</text></svg>';"
                                         style="position:absolute; top:0; left:0; width:100%; height:100%; object-fit:cover; transition:transform .3s;" />
                                </div>
                                <div style="padding:10px;">
                                    <MudText Typo="Typo.body1" Style="font-weight:600; min-height:48px;">
                                        @p.ProductName
                                    </MudText>
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-1">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info">
                                            @p.Quantity.ToString("N2") @p.UnitName
                                        </MudChip>
                                        @if (_canSeeAmounts)
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Primary" Style="font-weight:700;">
                                                @p.TotalAmount.ToString("N2") ج
                                            </MudText>
                                        }
                                    </MudStack>
                                    @if (p.DeliveredQty > 0)
                                    {
                                        <MudText Typo="Typo.caption" Color="@(p.RemainingQty > 0 ? Color.Info : Color.Success)">
                                            سُلّم @p.DeliveredQty.ToString("0.###") • متبقي @p.RemainingQty.ToString("0.###")
                                        </MudText>
                                    }
                                    @if (p.InLoopQty > 0)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block">
                                            🔧 في الصيانة: @p.InLoopQty.ToString("0.###")
                                        </MudText>
                                    }
                                    @if (p.SettledQty > 0)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Info" Class="d-block">
                                            سُوّي بردّ نهائي: @p.SettledQty.ToString("0.###")
                                        </MudText>
                                    }
                                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mt-1">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">موعد التسليم:</MudText>
                                        <DeliveryDateChip Date="@p.ScheduledDate"
                                                          IsOverdue="@p.IsScheduleOverdue"
                                                          IsDelivered="@(p.RemainingQty <= DeliveryScheduleResolver.QtyEpsilon)"
                                                          Size="Size.Small" />
                                        @if (p.ScheduledDateIsCustom)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">موعد خاص</MudChip>
                                        }
                                        @if (p.DeliveredLate)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">سُلّم متأخرًا</MudChip>
                                        }
                                    </MudStack>
                                    @if (p.LastDeliveryDate.HasValue)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                            آخر تسليمة فعلية: @p.LastDeliveryDate.Value.ToString("yyyy/MM/dd")
                                        </MudText>
                                    }
                                    @if (_canSeeAmounts && p.UnitPrice.HasValue)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            سعر الوحدة: @p.UnitPrice.Value.ToString("N2") ج
                                        </MudText>
                                    }
                                </div>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }
            else
            {
                <div class="table-wrap">
                    <MudSimpleTable Dense="true" Hover="true" Striped="true">
                        <thead>
                            <tr>
                                <th style="width:40px;">م</th>
                                <th>المنتج</th>
                                <th>موعد التسليم</th>
                                <th style="text-align:end;">الكمية</th>
                                <th style="text-align:end;">المسلَّم</th>
                                <th style="text-align:end;">المتبقي</th>
                                @if (_canSeeAmounts)
                                {
                                    <th style="text-align:end;">سعر الوحدة</th>
                                    <th style="text-align:end;">الإجمالي</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{ int rowNo = 0; }
                            @foreach (var p in _detail.Products)
                            {
                                rowNo++;
                                <tr>
                                    <td>@rowNo</td>
                                    <td>@p.ProductName</td>
                                    <td>
                                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                            <DeliveryDateChip Date="@p.ScheduledDate"
                                                              IsOverdue="@p.IsScheduleOverdue"
                                                              IsDelivered="@(p.RemainingQty <= DeliveryScheduleResolver.QtyEpsilon)" />
                                            @if (p.ScheduledDateIsCustom)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">موعد خاص</MudChip>
                                            }
                                            @if (p.DeliveredLate)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">سُلّم متأخرًا</MudChip>
                                            }
                                        </MudStack>
                                        @if (p.LastDeliveryDate.HasValue)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                                آخر تسليمة فعلية: @p.LastDeliveryDate.Value.ToString("yyyy/MM/dd")
                                            </MudText>
                                        }
                                        @if (p.InLoopQty > 0)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block">
                                                🔧 في الصيانة: @p.InLoopQty.ToString("0.###")
                                            </MudText>
                                        }
                                        @if (p.SettledQty > 0)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Info" Class="d-block">
                                                سُوّي بردّ نهائي: @p.SettledQty.ToString("0.###")
                                            </MudText>
                                        }
                                    </td>
                                    <td style="text-align:end;">@p.Quantity.ToString("N2") @p.UnitName</td>
                                    <td style="text-align:end;">@p.DeliveredQty.ToString("0.###")</td>
                                    <td style="text-align:end;">@p.RemainingQty.ToString("0.###")</td>
                                    @if (_canSeeAmounts)
                                    {
                                        <td style="text-align:end;">@(p.UnitPrice?.ToString("N2") ?? "—")</td>
                                        <td style="text-align:end;"><b>@p.TotalAmount.ToString("N2")</b></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
            }
        </MudPaper>

        @* ── سجل التسليمات (أحداث التسليم الجزئي) ────────── *@
        <MudPaper Class="pa-4 mb-3" Elevation="1">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Filled.History" /> سجل التسليمات (@(_progress?.Events.Count(e => !e.IsVoided) ?? 0))
                </MudText>
                @if (_canConfirmDelivery && _detail.DeliveryStatus != "تم التسليم" && _detail.DeliveryStatus != "مرتجع")
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.AddCircle"
                               OnClick="OpenRecordDeliveryAsync">تسجيل تسليمة جديدة</MudButton>
                }
            </MudStack>
            @if (_progress is null || _progress.Events.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">لا توجد تسليمات مسجلة بعد لهذه الفاتورة.</MudAlert>
            }
            else
            {
                <div class="table-wrap">
                    <MudSimpleTable Dense="true" Hover="true" Striped="true">
                        <thead>
                            <tr>
                                <th>التاريخ</th>
                                <th>المندوب</th>
                                <th>الكميات</th>
                                <th style="text-align:end;">إجمالي الدفعة</th>
                                <th>سجّلها</th>
                                <th>الحالة</th>
                                <th style="width:88px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in _progress.Events)
                            {
                                <tr style="@(ev.IsVoided ? "opacity:.55;" : "")">
                                    <td>@ev.DeliveryDate.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>@(ev.DeliveryEmployeeName ?? "—")</td>
                                    <td>
                                        @foreach (var it in ev.Items)
                                        {
                                            <div>
                                                @it.ProductName × @it.Quantity.ToString("0.###")
                                                @if (it.MaintenanceId.HasValue)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">إعادة تسليم</MudChip>
                                                }
                                            </div>
                                            @if (it.TotalReturnedQty > 0)
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block">
                                                    مقبول @it.AcceptedQty.ToString("0.###")
                                                    @if (it.ReturnedManufacturingQty > 0)
                                                    {
                                                        <span> • عيب تصنيع @it.ReturnedManufacturingQty.ToString("0.###")</span>
                                                    }
                                                    @if (it.ReturnedHandlingQty > 0)
                                                    {
                                                        <span> • تلف مناولة @it.ReturnedHandlingQty.ToString("0.###")</span>
                                                    }
                                                    @if (it.ReturnedModificationQty > 0)
                                                    {
                                                        <span> • تعديل عميل @it.ReturnedModificationQty.ToString("0.###")</span>
                                                    }
                                                </MudText>
                                                @if (!string.IsNullOrWhiteSpace(it.DispositionNotes))
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                                        «@it.DispositionNotes»
                                                    </MudText>
                                                }
                                            }
                                        }
                                        @if (!string.IsNullOrWhiteSpace(ev.Notes))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@ev.Notes</MudText>
                                        }
                                    </td>
                                    <td style="text-align:end;"><b>@ev.TotalQuantity.ToString("0.###")</b></td>
                                    <td>@ev.RecordedBy</td>
                                    <td>
                                        <MudStack Spacing="0">
                                            @if (ev.IsVoided)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">ملغاة</MudChip>
                                                <MudText Typo="Typo.caption">بواسطة @ev.VoidedBy — @ev.VoidReason</MudText>
                                            }
                                            else if (ev.IsLegacy)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">ترحيل تاريخي</MudChip>
                                            }
                                            @if (ev.CompletedInvoice && !ev.IsVoided)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">أكملت الفاتورة</MudChip>
                                            }
                                            @if (!ev.IsVoided && !ev.IsLegacy)
                                            {
                                                <MudChip T="string" Size="Size.Small"
                                                         Color="@(ev.HasRemarks ? Color.Warning : Color.Success)"
                                                         Variant="@(ev.HasRemarks ? Variant.Filled : Variant.Outlined)">
                                                    @(ev.HasRemarks ? "بملاحظات" : "بدون ملاحظات")
                                                </MudChip>
                                            }
                                            @foreach (var mr in ev.MaintenanceRecords)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                                    🔧 @mr.ProductName × @mr.Quantity.ToString("0.###") (@mr.ReasonClassName) — @mr.StatusName
                                                </MudChip>
                                            }
                                            @foreach (var mc in ev.ModificationCharges)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">
                                                    💰 رسوم تعديل: @mc.StatusName@(_canSeeAmounts ? (mc.ChargeAmount.HasValue ? $" — {mc.ChargeAmount.Value:N2} ج" : " — بلا مبلغ بعد") : "")
                                                </MudChip>
                                            }
                                        </MudStack>
                                    </td>
                                    <td>
                                        <MudStack Row="true" Spacing="0">
                                            @if (_canPrint && !ev.IsVoided)
                                            {
                                                <MudTooltip Text="طباعة إذن تسليم هذه الدفعة">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Print" Size="Size.Small" Color="Color.Primary"
                                                                   OnClick="@(() => PrintEventPermitAsync(ev))" />
                                                </MudTooltip>
                                            }
                                            @if (_canOverride && !ev.IsVoided)
                                            {
                                                <MudTooltip Text="إلغاء التسليمة">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small" Color="Color.Error"
                                                                   OnClick="@(() => OpenVoidEventAsync(ev))" />
                                                </MudTooltip>
                                            }
                                        </MudStack>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
            }
        </MudPaper>

        @* ── Financial Summary (مخفي عن User) ───────────── *@
        @if (_canSeeAmounts)
        {
            <MudPaper Class="pa-4 mb-3" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalance" /> الملخص المالي
                </MudText>
                <MudGrid>
                    <MudItem xs="6" md="3">
                        <MudPaper Class="pa-3 text-center" Elevation="0" Style="background:rgba(33,150,243,.10);">
                            <MudText Typo="Typo.caption">الإجمالي</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Primary">@_detail.GrandTotal.ToString("N2")</MudText>
                            <MudText Typo="Typo.caption">ج.م</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudPaper Class="pa-3 text-center" Elevation="0" Style="background:rgba(76,175,80,.12);">
                            <MudText Typo="Typo.caption">المدفوع</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Success">@_detail.PaidAmount.ToString("N2")</MudText>
                            <MudText Typo="Typo.caption">ج.م</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudPaper Class="pa-3 text-center" Elevation="0"
                                  Style="@($"background:{(_detail.RemainingAmount > 0 ? "rgba(244,67,54,.12)" : "rgba(76,175,80,.12)")};")">
                            <MudText Typo="Typo.caption">المتبقي</MudText>
                            <MudText Typo="Typo.h5"
                                     Color="@(_detail.RemainingAmount > 0 ? Color.Error : Color.Success)">
                                @_detail.RemainingAmount.ToString("N2")
                            </MudText>
                            <MudText Typo="Typo.caption">ج.م</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudPaper Class="pa-3 text-center" Elevation="0" Style="background:rgba(255,152,0,.12);">
                            <MudText Typo="Typo.caption">نسبة السداد</MudText>
                            @{
                                var paidPct = _detail.GrandTotal > 0
                                    ? (decimal)(_detail.PaidAmount / _detail.GrandTotal * 100)
                                    : 0m;
                            }
                            <MudText Typo="Typo.h5" Color="Color.Warning">@paidPct.ToString("N0")%</MudText>
                            <MudProgressLinear Value="@((double)paidPct)" Color="Color.Warning" Class="mt-1" />
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }

        @* ── قاعدة المبالغ المتبقية ────────────────────── *@
        @if (_detail.DeliveryStatus != "تم التسليم" && _remaining > 0)
        {
            @if (_canOverride)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                        <span>⚠️ يوجد مبلغ متبقٍ @(_remaining.ToString("N2")) ج — تسليمك يتم بموافقتك ويتوثق في السجل.</span>
                        @if (_permState is { HasPendingRequest: true })
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Verified"
                                       OnClick="GrantPermissionAsync">منح إذن التسليم (طلب @(_permState.RequestedBy))</MudButton>
                        }
                    </MudStack>
                </MudAlert>
            }
            else if (_permState is { HasPendingRequest: true })
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
                    ⏳ تم إرسال طلب إذن التسليم بواسطة @(_permState.RequestedBy) — بانتظار موافقة الإدارة أو مدير الحسابات.
                </MudAlert>
            }
            else if (!string.IsNullOrWhiteSpace(_permState?.GrantedBy))
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-3">
                    ✅ الإذن ممنوح بواسطة @(_permState.GrantedBy) — يمكنك التسليم الآن.
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                        <span>🚫 التسليم مشروط بالتغطية: لا تُسلَّم دفعة إلا إذا غطّى المدفوع قيمة ما سُلّم + هذه الدفعة — وإلا يلزم إذن. برجاء مراجعة مدير الحسابات أو مسئول الحسابات أو المدير.</span>
                        @if (_canConfirmDelivery)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Send"
                                       OnClick="RequestPermissionAsync">إرسال طلب إذن تسليم</MudButton>
                        }
                    </MudStack>
                </MudAlert>
            }
        }

        @* ── طلبات تعديل المواعيد ─────────────────────── *@
        @if (_canRequestSchedule || _canDecideSchedule || _schedRequests.Count > 0)
        {
            <MudPaper Class="pa-4 mb-3" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.EditCalendar" /> طلبات تعديل المواعيد (@_schedRequests.Count)
                    </MudText>
                    @if (_pendingSchedRequest is not null)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning"
                                 Icon="@Icons.Material.Filled.HourglassTop">
                            طلب تعديل موعد قيد الانتظار — من @(_pendingSchedRequest.RequesterName ?? _pendingSchedRequest.RequesterUserName)
                        </MudChip>
                    }
                    else if (_canRequestSchedule && _scheduleActionable)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.EditCalendar"
                                   OnClick="OpenRequestScheduleAsync">طلب تعديل موعد / تقسيم</MudButton>
                    }
                </MudStack>

                @if (_schedRequests.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        لا توجد طلبات تعديل مواعيد لهذه الفاتورة.
                    </MudAlert>
                }
                else
                {
                    @foreach (var r in _schedRequests)
                    {
                        <div style="border:1px solid var(--mud-palette-lines-default); border-radius:10px; padding:10px 12px; margin-bottom:10px;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                         Color="@ScheduleStatusColor(r.Status)">@r.StatusName</MudChip>
                                <MudText Typo="Typo.body2"><b>@(r.RequesterName ?? r.RequesterUserName)</b></MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@r.CreatedAt.ToString("yyyy/MM/dd HH:mm")</MudText>
                                <span style="margin-inline-start:auto;"></span>
                                @if (r.Status == DeliveryScheduleRequestStatuses.Pending && _canDecideSchedule)
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.FactCheck"
                                               OnClick="@(() => OpenDecideScheduleAsync(r))">اعتماد / رفض</MudButton>
                                }
                                @if (r.Status == DeliveryScheduleRequestStatuses.Pending
                                     && string.Equals(r.RequesterUserName, _currentUserName, StringComparison.OrdinalIgnoreCase))
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Undo"
                                               OnClick="@(() => WithdrawScheduleAsync(r))">سحب الطلب</MudButton>
                                }
                            </MudStack>
                            <MudText Typo="Typo.body2" Class="mt-1">السبب: @r.Reason</MudText>
                            @if (r.ProposedDueDate.HasValue)
                            {
                                <MudText Typo="Typo.body2">
                                    التاريخ الكلي المقترح: <b>@r.ProposedDueDate.Value.ToString("yyyy/MM/dd")</b>
                                </MudText>
                            }
                            @if (r.Lines.Count > 0)
                            {
                                <MudStack Spacing="0" Class="mt-1">
                                    @foreach (var l in r.Lines)
                                    {
                                        <MudText Typo="Typo.body2">
                                            • @l.ProductName —
                                            @if (l.ProposedIsCustom && l.ProposedDate.HasValue)
                                            {
                                                <span>موعد خاص: <b>@l.ProposedDate.Value.ToString("yyyy/MM/dd")</b></span>
                                            }
                                            else
                                            {
                                                <span>اتباع تاريخ الفاتورة</span>
                                            }
                                        </MudText>
                                    }
                                </MudStack>
                            }
                            @if (r.DecidedAt.HasValue)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">
                                    البتّ بواسطة @(r.DecidedBy ?? "—") في @r.DecidedAt.Value.ToString("yyyy/MM/dd HH:mm")
                                    @if (!string.IsNullOrWhiteSpace(r.DecisionNote))
                                    {
                                        <span> — @r.DecisionNote</span>
                                    }
                                </MudText>
                            }
                        </div>
                    }
                }
            </MudPaper>
        }

        @* ── Update / Confirm Section ──────────────────── *@
        <MudPaper Class="pa-4 mb-3" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Edit" /> تحديث حالة التسليم
            </MudText>

            @if (!_canEditFull && !_canConfirmDelivery)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    ليس لديك صلاحية لتعديل بيانات التسليم.
                </MudAlert>
            }
            else
            {
                <MudForm @ref="_form" Model="@_model">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="6">
                            <MudSelect T="string"
                                       @bind-Value="_model.Status"
                                       Label="الحالة"
                                       Variant="Variant.Outlined"
                                       Required="true"
                                       Disabled="@(!_canEditFull)"
                                       AdornmentIcon="@GetStatusIcon(_model.Status)"
                                       Adornment="Adornment.Start">
                                <MudSelectItem T="string" Value='"جارى"'>جارى</MudSelectItem>
                                <MudSelectItem T="string" Value='"متأخر"'>متأخر</MudSelectItem>
                                <MudSelectItem T="string" Value='"مرتجع"'>مرتجع</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudAutocomplete T="EmployeeLookupDto"
                                             @bind-Value="_selectedEmployee"
                                             SearchFunc="SearchEmployeesAsync"
                                             ToStringFunc="@(e => e?.FullName ?? "")"
                                             Label="مسئول التسليم"
                                             Variant="Variant.Outlined"
                                             Clearable="true"
                                             Disabled="@(!_canEditFull)"
                                             AdornmentIcon="@Icons.Material.Filled.DeliveryDining"
                                             Adornment="Adornment.Start" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField T="string"
                                          @bind-Value="_model.Notes"
                                          Label="ملاحظات التسليم"
                                          Variant="Variant.Outlined"
                                          Lines="3"
                                          MaxLength="500"
                                          Counter="500" />
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" Spacing="2" Class="mt-3" Justify="Justify.FlexEnd">
                        @if (_canEditFull)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Restore"
                                       OnClick="ResetForm"
                                       Disabled="_saving">إعادة تعيين</MudButton>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       OnClick="SaveAsync"
                                       Disabled="_saving">
                                @if (_saving)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                                }
                                حفظ التعديلات
                            </MudButton>
                        }
                        @if (_canConfirmDelivery && _detail.DeliveryStatus != "تم التسليم" && _detail.DeliveryStatus != "مرتجع")
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Success"
                                       Size="Size.Large"
                                       StartIcon="@Icons.Material.Filled.LocalShipping"
                                       OnClick="OpenRecordDeliveryAsync"
                                       Disabled="_saving">
                                تسجيل تسليمة
                            </MudButton>
                        }
                    </MudStack>
                </MudForm>
            }
        </MudPaper>
    }

    @* ── شريط التسليم الثابت (موبايل فقط) ── *@
    @if (_detail is not null && !_loading && _canConfirmDelivery && _detail.DeliveryStatus != "تم التسليم" && _detail.DeliveryStatus != "مرتجع")
    {
        <div class="dl-sticky-bar">
            <div class="dl-sticky-info">
                <span class="dl-sticky-title">فاتورة #@_detail.TransactionId</span>
                <span class="dl-sticky-sub">@_detail.PartyName</span>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.LocalShipping"
                       OnClick="OpenRecordDeliveryAsync">تسجيل تسليمة</MudButton>
        </div>
    }

    @* ── ورقة طباعة إذن التسليم الشامل (بدون أسعار — تظهر في الطباعة فقط) ── *@
    @if (_detail is not null && !_loading && _eventPermit is null)
    {
        <div class="dl-print-sheet">
            <div class="dlp-title">إذن تسليم</div>
            <table class="dlp-info">
                <tr>
                    <td class="lbl">فاتورة رقم:</td><td><b>@_detail.TransactionId</b></td>
                    <td class="lbl">تاريخ الفاتورة:</td><td>@_detail.TransactionDate.ToString("yyyy/MM/dd")</td>
                </tr>
                <tr>
                    <td class="lbl">العميل:</td><td><b>@_detail.PartyName</b></td>
                    <td class="lbl">التليفون:</td><td>@(_detail.PartyPhone ?? "—")</td>
                </tr>
                <tr>
                    <td class="lbl">العنوان:</td><td colspan="3">@(_detail.PartyAddress ?? "—")</td>
                </tr>
                <tr>
                    <td class="lbl">مسئول المبيعات:</td><td>@(_detail.SalesEmployeeName ?? "—")</td>
                    <td class="lbl">مسئول التسليم:</td><td>@(_detail.DeliveryEmployeeName ?? "—")</td>
                </tr>
                <tr>
                    <td class="lbl">حالة التسليم:</td><td>@_detail.DeliveryStatus</td>
                    <td class="lbl">تاريخ التسليم:</td>
                    <td>@(_detail.DeliveredAt?.ToString("yyyy/MM/dd") ?? "—")</td>
                </tr>
            </table>
            <table class="dlp-items">
                <thead>
                    <tr><th style="width:36px;">م</th><th>الصنف</th><th style="width:90px;">الكمية</th><th style="width:90px;">الوحدة</th><th style="width:100px;">موعد التسليم</th></tr>
                </thead>
                <tbody>
                    @{ int prNo = 0; }
                    @foreach (var p in _detail.Products)
                    {
                        prNo++;
                        <tr>
                            <td style="text-align:center;">@prNo</td>
                            <td>@p.ProductName</td>
                            <td style="text-align:center;">@p.Quantity.ToString("N2")</td>
                            <td style="text-align:center;">@p.UnitName</td>
                            <td style="text-align:center;">@(p.ScheduledDate?.ToString("yyyy/MM/dd") ?? "—")@(p.ScheduledDateIsCustom ? " (خاص)" : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!string.IsNullOrWhiteSpace(_detail.DeliveredNotes))
            {
                <div class="dlp-notes"><b>ملاحظات:</b> @_detail.DeliveredNotes</div>
            }
            <table class="dlp-signs">
                <tr>
                    <td>توقيع المستلم: ............................</td>
                    <td>توقيع مسئول التسليم: ............................</td>
                </tr>
            </table>
        </div>
    }

    @* ── ورقة طباعة إذن تسليم دفعة واحدة (بنود الحدث فقط — تظهر في الطباعة فقط) ── *@
    @if (_eventPermit is not null)
    {
        var ep = _eventPermit;
        <div class="dl-print-sheet dl-event-print-sheet">
            <div class="dlp-title">إذن تسليم — دفعة</div>
            <table class="dlp-info">
                <tr>
                    <td class="lbl">فاتورة رقم:</td><td><b>@ep.TransactionId</b></td>
                    <td class="lbl">تاريخ الفاتورة:</td><td>@ep.TransactionDate.ToString("yyyy/MM/dd")</td>
                </tr>
                <tr>
                    <td class="lbl">العميل:</td><td><b>@ep.PartyName</b></td>
                    <td class="lbl">التليفون:</td><td>@(ep.PartyPhone ?? "—")</td>
                </tr>
                <tr>
                    <td class="lbl">العنوان:</td><td colspan="3">@(ep.PartyAddress ?? "—")</td>
                </tr>
                <tr>
                    <td class="lbl">مسئول المبيعات:</td><td>@(ep.SalesEmployeeName ?? "—")</td>
                    <td class="lbl">مسئول التسليم:</td><td>@(ep.DeliveryEmployeeName ?? "—")</td>
                </tr>
                <tr>
                    <td class="lbl">تاريخ هذه الدفعة:</td><td><b>@ep.DeliveryDate.ToString("yyyy/MM/dd")</b></td>
                    <td class="lbl">استحقاق الفاتورة:</td><td>@(ep.DueDate?.ToString("yyyy/MM/dd") ?? "—")</td>
                </tr>
            </table>
            <table class="dlp-items">
                <thead>
                    <tr><th style="width:36px;">م</th><th>الصنف</th><th style="width:90px;">الكمية</th><th style="width:90px;">الوحدة</th><th style="width:100px;">موعد التسليم</th></tr>
                </thead>
                <tbody>
                    @{ int evNo = 0; }
                    @foreach (var it in ep.Items)
                    {
                        evNo++;
                        <tr>
                            <td style="text-align:center;">@evNo</td>
                            <td>@it.ProductName</td>
                            <td style="text-align:center;">@it.Quantity.ToString("0.###")</td>
                            <td style="text-align:center;">@it.UnitName</td>
                            <td style="text-align:center;">@(it.ScheduledDate?.ToString("yyyy/MM/dd") ?? "—")@(it.ScheduledDateIsCustom ? " (خاص)" : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="dlp-notes">
                <b>ملخص التسليم:</b>
                إجمالي كميات الفاتورة: @ep.TotalInvoicedQty.ToString("0.###") •
                كمية هذه الدفعة: @ep.EventTotalQty.ToString("0.###") •
                المسلَّم حتى هذه الدفعة: @ep.DeliveredThroughEventQty.ToString("0.###") •
                المتبقي بعدها: @ep.RemainingAfterEventQty.ToString("0.###")
                @if (ep.CompletedInvoice)
                {
                    <span> — بهذه الدفعة اكتمل تسليم الفاتورة.</span>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(ep.Notes))
            {
                <div class="dlp-notes"><b>ملاحظات الدفعة:</b> @ep.Notes</div>
            }
            <table class="dlp-signs">
                <tr>
                    <td>توقيع المستلم: ............................</td>
                    <td>توقيع مسئول التسليم: ............................</td>
                </tr>
            </table>
        </div>
    }

</MudContainer>

<style>
    .product-card { transition: transform .2s, box-shadow .2s; }
    .product-card:hover { transform: translateY(-4px); box-shadow: 0 6px 16px rgba(0,0,0,.15); }
    .product-card:hover img { transform: scale(1.05); }

    /* جدول المنتجات — تمرير أفقي على الموبايل */
    .table-wrap { overflow-x: auto; }
    .table-wrap table { min-width: 420px; }

    /* شريط التأكيد الثابت — موبايل فقط */
    .dl-sticky-bar { display: none; }
    @@media (max-width: 960px) {
        .dl-sticky-bar {
            display: flex; align-items: center; justify-content: space-between; gap: 10px;
            position: fixed; bottom: 0; right: 0; left: 0; z-index: 60;
            padding: 10px 14px calc(10px + env(safe-area-inset-bottom, 0px));
            background: var(--mud-palette-surface);
            box-shadow: 0 -4px 18px rgba(2, 6, 23, .18);
            border-top: 2px solid var(--gold);
        }
        .dl-sticky-info { display: flex; flex-direction: column; min-width: 0; }
        .dl-sticky-title { font-weight: 800; font-size: .9rem; color: var(--mud-palette-primary); }
        .dl-sticky-sub { font-size: .78rem; opacity: .8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .mud-container { padding-bottom: 84px; }
    }

    /* ── ورقة إذن التسليم (طباعة فقط) ── */
    .dl-print-sheet { display: none; }

    @@media print {
        @@page { size: A4; margin: 12mm; }

        body * { visibility: hidden !important; }
        .dl-print-sheet, .dl-print-sheet * { visibility: visible !important; }
        .dl-print-sheet {
            display: block !important;
            position: absolute;
            top: 0; right: 0; left: 0;
            padding: 0;
            color: #000;
            background: #fff;
            font-family: 'Tajawal', 'Segoe UI', sans-serif;
        }
        .dl-print-sheet .dlp-title {
            font-size: 24px; font-weight: 800; text-align: center;
            border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 12px;
        }
        .dl-print-sheet table { width: 100%; border-collapse: collapse; margin: 10px 0; }
        .dl-print-sheet .dlp-items th, .dl-print-sheet .dlp-items td {
            border: 1px solid #333; padding: 6px 8px; font-size: 13px; text-align: right;
        }
        .dl-print-sheet .dlp-items th { background: #eee; }
        .dl-print-sheet .dlp-info td { padding: 3px 8px; font-size: 13px; }
        .dl-print-sheet .dlp-info td.lbl { font-weight: 700; width: 110px; }
        .dl-print-sheet .dlp-notes { font-size: 13px; margin: 8px 0; }
        .dl-print-sheet .dlp-signs { margin-top: 40px; }
        .dl-print-sheet .dlp-signs td { font-size: 14px; padding-top: 30px; width: 50%; }
    }
    .text-end { text-align: end; }

    @@media print {
        .mud-button, .mud-icon-button, .mud-paper:has(.mud-form) { display: none !important; }
    }
</style>

@code {
    [Parameter] public int TransactionId { get; set; }

    private DeliveryDetailDto? _detail;
    private InvoiceDeliveryProgressDto? _progress;
    private DeliveryEventPermitDto? _eventPermit;   // إذن الدفعة الجاهز للطباعة (يُصفَّر عند طباعة الإذن الشامل)
    private MudForm?           _form;
    private bool               _loading = true;
    private bool               _saving  = false;

    private List<EmployeeLookupDto> _employees = new();
    private EmployeeLookupDto?      _selectedEmployee;

