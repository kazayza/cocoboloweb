        var parameters = new DialogParameters
        {
            ["PresetLinkedType"] = GeneralTaskLinks.Delivery,
            ["PresetLinkedId"] = TransactionId,
            ["PresetLinkedTitle"] = $"تسليمة فاتورة {_detail.ReferenceNumber ?? $"#{TransactionId}"} — {_detail.PartyName}"
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<CreateGeneralTaskDialog>("تكليف جديد", parameters, options);
