    private List<ScheduleChangeRequestDto> _schedRequests = new();
    private bool _canRequestSchedule;
    private bool _canDecideSchedule;
    private ScheduleChangeRequestDto? _pendingSchedRequest =>
        _schedRequests.FirstOrDefault(r => r.Status == DeliveryScheduleRequestStatuses.Pending);
    private bool _scheduleActionable =>
        _detail is not null && _detail.DeliveryStatus != "تم التسليم" && _detail.DeliveryStatus != "مرتجع";

    protected override async Task OnInitializedAsync()
    {
        await LoadPermissionsAsync();
        await Task.WhenAll(SafeLoadDetailAsync(), SafeLoadEmployeesAsync(), SafeLoadProgressAsync());
        await LoadPermissionStateAsync();
        await LoadScheduleRequestsAsync();
        if (_detail is not null) BindFromDetail();
        _loading = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        // لو الـ TransactionId اتغير من URL
        if (!_loading && _detail is not null && _detail.TransactionId != TransactionId)
        {
            _loading = true;
            await Task.WhenAll(SafeLoadDetailAsync(), SafeLoadProgressAsync());
            await LoadScheduleRequestsAsync();
            if (_detail is not null) BindFromDetail();
            _loading = false;
        }
    }

    private async Task SafeLoadProgressAsync()
    {
        try { _progress = await DeliveryService.GetDeliveryProgressAsync(TransactionId); }
        catch (Exception ex) { Logger.LogWarning(ex, "Load delivery progress failed"); _progress = null; }
    }

    private async Task ReloadAllAsync()
    {
        await SafeLoadDetailAsync();
        await SafeLoadProgressAsync();
        await LoadPermissionStateAsync();
        await LoadScheduleRequestsAsync();
        if (_detail is not null) BindFromDetail();
        StateHasChanged();
    }

