    private async Task PrintAsync()
    {
        // الإذن الشامل: أي إذن دفعة مختار يُصفَّر أولًا حتى لا تخرج ورقته مكانه
        if (_eventPermit is not null)
        {
            _eventPermit = null;
            StateHasChanged();
            await Task.Delay(50);
        }
        // مرحلياً: طباعة المتصفح. مستقبلاً: QuestPDF
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task PrintEventPermitAsync(DeliveryEventDto ev)
    {
        try
        {
            var permit = await DeliveryService.GetDeliveryEventPermitAsync(ev.DeliveryId);
            if (permit is null)
            {
                Snackbar.Add("تعذّر تجهيز إذن تسليم هذه الدفعة.", Severity.Warning);
                return;
            }
            _eventPermit = permit;
            StateHasChanged();
            await Task.Delay(250);
            await JS.InvokeVoidAsync("window.print");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Print event permit failed for delivery {Id}", ev.DeliveryId);
            Snackbar.Add("تعذّر تجهيز إذن التسليم: " + ex.Message, Severity.Error);
        }
    }

