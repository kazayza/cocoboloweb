            await ReloadCurrent();
        }
        finally { _savingReply = false; }
    }


    private async Task SaveAltSpecsAsync(int alternativeId)
    {
        if (alternativeId <= 0) return;
        var answers = _altSpecDrafts.Values
            .Where(x => x.OptionId.HasValue || x.NumberValue.HasValue || !string.IsNullOrWhiteSpace(x.TextValue))
            .ToList();
        if (answers.Count > 0)
        {
            var (ok, msg) = await SpecService.SaveAnswersAsync(SpecOwners.Alternative, alternativeId, answers);
            if (!ok && !string.IsNullOrWhiteSpace(msg))
                Snackbar.Add(msg, Severity.Warning);
        }
        var listIds = _questions.Where(q => q.ListId.HasValue && q.DataType != SpecDataTypes.Number)
            .Select(q => q.QuestionId)
            .ToHashSet();
        var removed = listIds.Where(id => answers.All(a => a.QuestionId != id)).ToList();
        if (removed.Count > 0)
            await SpecService.RemoveAnswersAsync(SpecOwners.Alternative, alternativeId, removed);
        await SpecService.SaveVariableImagesAsync(SpecOwners.Alternative, alternativeId, _altVariableImages);
    }

    private void OnAltFiles(InputFileChangeEventArgs e)
        => _altFiles = e.GetMultipleFiles(6).ToList();

    private async Task SaveAltImagesAsync(ProductFactoryAlternative alternative)
    {
        if (_altFiles.Count == 0 || alternative.AlternativeId <= 0) return;
        var webRoot = Env.WebRootPath ?? "";
        if (string.IsNullOrWhiteSpace(webRoot))
        {
            Snackbar.Add("تعذر حفظ صور البديل.", Severity.Warning);
            return;
        }

        var relativeFolder = Path.Combine("uploads", "product-alternative-images", alternative.ProductId.ToString(), alternative.AlternativeId.ToString());
        Directory.CreateDirectory(Path.Combine(webRoot, relativeFolder));
        var primary = true;
        foreach (var file in _altFiles.Take(6))
        {
            if (file.Size <= 0) continue;
            if (file.Size > 5 * 1024 * 1024)
            {
                Snackbar.Add($"الصورة {file.Name} تتجاوز 5MB.", Severity.Warning);
                continue;
            }
            var ext = Path.GetExtension(file.Name);
            var storedName = $"{Guid.NewGuid():N}{(string.IsNullOrWhiteSpace(ext) ? ".img" : ext)}";
            var absolutePath = Path.Combine(webRoot, relativeFolder, storedName);
            await using var source = file.OpenReadStream(5 * 1024 * 1024);
            await using var target = new FileStream(absolutePath, FileMode.Create, FileAccess.Write, FileShare.None);
            await source.CopyToAsync(target);
            Db.ProductFactoryAlternativeImages.Add(new ProductFactoryAlternativeImage
            {
                AlternativeId = alternative.AlternativeId,
                ImagePath = "/" + relativeFolder.Replace('\\', '/') + "/" + storedName,
                IsPrimary = primary,
                CreatedAt = DateTime.Now
            });
            primary = false;
        }
        await Db.SaveChangesAsync();
    }

