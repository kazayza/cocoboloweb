    private async Task ApproveAlternative(int productId, int alternativeId)
    {
        if (!_canAnswer || _savingReply) return;
        _savingReply = true;
        try
        {
            var alternatives = await Db.ProductFactoryAlternatives
                .Where(a => a.ProductId == productId)
                .ToListAsync();
            var chosen = alternatives.FirstOrDefault(a => a.AlternativeId == alternativeId);
            if (chosen == null || chosen.Status == ProductFactoryAlternativeStatuses.Rejected)
            {
                Snackbar.Add("البديل غير موجود.", Severity.Warning);
                return;
            }
            foreach (var item in alternatives)
            {
                var isChosen = item.AlternativeId == alternativeId;
                item.IsPrimary = isChosen;
                if (isChosen)
                {
                    item.Status = ProductFactoryAlternativeStatuses.Approved;
                    item.ReviewedBy = _userName;
                    item.ReviewedAt = DateTime.Now;
                }
                else if (item.Status == ProductFactoryAlternativeStatuses.Approved)
                {
                    item.Status = ProductFactoryAlternativeStatuses.Proposed;
                }
            }
            var product = await Db.Products.FirstOrDefaultAsync(p => p.ProductId == productId);
            if (product != null)
            {
                if (chosen.Period is > 0)
                    product.Period = chosen.Period;
                if (!string.IsNullOrWhiteSpace(chosen.ManufacturingDescription))
                    product.ManufacturingDescription = chosen.ManufacturingDescription;
            }
            await Db.SaveChangesAsync();
            var card = _cards.FirstOrDefault(c => c.ProductId == productId);
            var name = card?.Name ?? product?.ProductName ?? "المنتج";
            var form = _partyId > 0
                ? $"customers/{_partyId}/job-spec?product={productId}"
                : $"products/{productId}/job-spec";
            await NotifyPartiesAsync("تم اعتماد البديل", $"{name}: تم اعتماد البديل {chosen.AlternativeName}.", form, null, "factory", SystemRoles.ProductionManager);
            Snackbar.Add("تم اعتماد البديل.", Severity.Success);
            await ReloadCurrent();
        }
        finally { _savingReply = false; }
    }

