        && (_invoiceFilter == "all" || (_invoiceFilter == "linked" ? c.Invoices.Count > 0 : c.Invoices.Count == 0)));

    private int PricedCount => _cards.Count(c => c.IsPriced);
    private int UnpricedCount => _cards.Count(c => !c.IsPriced);
    private int LinkedCount => _cards.Count(c => c.Invoices.Count > 0);
    private int UnlinkedCount => _cards.Count(c => c.Invoices.Count == 0);

