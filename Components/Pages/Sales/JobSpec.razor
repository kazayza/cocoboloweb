    private static string Initial(string? name)
    {
        var text = (name ?? "").Trim();
        return text.Length == 0 ? "ع" : text[..1];
    }

    private async Task AttachInvoicesAsync()
    {
        if (!_canSeeInvoices || _cards.Count == 0 || _user == null) return;
        var ids = _cards.Select(c => c.ProductId).ToList();
        var protectedCreators = SalesInvoiceAccess.CanViewAccountManagerInvoices(_user)
            ? new List<string>()
            : await SalesInvoiceAccess.GetProtectedCreatorUsernamesAsync(Db);
        var rows = await (
            from detail in Db.TransactionDetails.AsNoTracking()
            join invoice in Db.Transactions.AsNoTracking() on detail.TransactionId equals invoice.TransactionId
            where ids.Contains(detail.ProductId)
                && invoice.TransactionType == TransactionTypes.Sale
                && (invoice.InvoiceStatus == null || invoice.InvoiceStatus != InvoiceStatuses.Cancelled)
            orderby invoice.TransactionDate descending
            select new { detail.ProductId, invoice.TransactionId, invoice.ReferenceNumber, invoice.CreatedBy }
        ).ToListAsync();
        var seen = new HashSet<(int ProductId, int TransactionId)>();
        foreach (var row in rows)
        {
            if (protectedCreators.Contains(row.CreatedBy)) continue;
            if (!seen.Add((row.ProductId, row.TransactionId))) continue;
            var card = _cards.FirstOrDefault(c => c.ProductId == row.ProductId);
            card?.Invoices.Add(new InvoiceLink
            {
                TransactionId = row.TransactionId,
                Number = string.IsNullOrWhiteSpace(row.ReferenceNumber) ? row.TransactionId.ToString() : row.ReferenceNumber
            });
        }
    }

    private string HeaderLine()
    {
        if (_partyId > 0)
            return $"{_partyName} — {(string.IsNullOrWhiteSpace(_partyPhone) ? "بدون رقم هاتف" : _partyPhone)} — {_cards.Count} منتج";
        return _cards.FirstOrDefault()?.Name ?? "منتج غير مرتبط بعميل";
    }

