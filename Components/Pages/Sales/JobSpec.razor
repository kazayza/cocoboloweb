@page "/job-spec"
@page "/customers/{PartyId:int}/job-spec"
@page "/products/{ProductId:int}/job-spec"
@attribute [Authorize]

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Models
@using COCOBOLOERPNEW.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Data
@using System.Linq
@using System.Security.Claims
@using Microsoft.AspNetCore.Hosting

@inject db24804Context Db
@inject ISpecService SpecService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NotificationService NotificationService
@inject JobOrderEngineerService Engineers
@inject IWebHostEnvironment Env

<PageTitle>جوب أوردر</PageTitle>

@if (_loading)
{
    <div class="js-loading"><MudProgressCircular Indeterminate="true" /> <p>جاري تجهيز الجوب أوردر...</p></div>
}
else if (!_canView)
{
    <MudAlert Severity="Severity.Error">ليس لديك صلاحية عرض الجوب أوردر.</MudAlert>
}
else if (_missing)
{
    <MudAlert Severity="Severity.Warning">@(_partyId > 0 ? "العميل غير موجود." : "المنتج غير موجود.")</MudAlert>
}
else if (_searchMode)
{
    <div class="js-page" dir="rtl">
        <header class="js-head">
            <div class="js-id">
                <span class="js-mark"><MudIcon Icon="@Icons.Material.Filled.Search" /></span>
                <div>
                    <div class="js-title-line">
                        <h1>الجوب أوردر</h1>
                        <span class="js-badge">بحث العملاء</span>
                    </div>
                    <p>ابحث بالاسم أو الهاتف، ثم افتح ملف المواصفات.</p>
                </div>
            </div>
        </header>
        <section class="js-card js-search-card">
            <div class="js-search-wrap">
                <MudIcon Icon="@Icons.Material.Filled.Search" />
                <input class="js-search" @bind="_customerSearch" @bind:event="oninput" placeholder="اسم العميل أو رقم الهاتف" />
            </div>
            <p class="js-meta">@FilteredCustomers.Count نتيجة</p>
            @if (FilteredCustomers.Count == 0)
            {
                <p class="js-wait">لا توجد نتائج مطابقة.</p>
            }
            else
            {
                <div class="js-picks">
                    @foreach (var customer in FilteredCustomers)
                    {
                        <button type="button" class="js-pick" @onclick="() => OpenCustomer(customer.PartyId)">
                            <span class="js-avatar">@Initial(customer.PartyName)</span>
                            <span class="js-pick-body">
                                <strong>@customer.PartyName</strong>
                                <span>@(string.IsNullOrWhiteSpace(customer.Phone) ? "بدون رقم هاتف" : customer.Phone)</span>
                            </span>
                            <span class="js-count">@customer.ProductCount منتج</span>
                        </button>
                    }
                </div>
            }
        </section>
    </div>
}
else
{
    <div class="js-page" dir="rtl">
        <header class="js-head">
            <div class="js-id">
                <span class="js-mark"><MudIcon Icon="@Icons.Material.Filled.Description" /></span>
                <div>
                    <div class="js-title-line">
                        <h1>جوب أوردر</h1>
                        <span class="js-badge">ملف المواصفات</span>
                    </div>
                    <div class="js-contact">
                        <span><MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" /> @(_partyId > 0 ? _partyName : (VisibleCards.FirstOrDefault()?.Name ?? "منتج غير مرتبط بعميل"))</span>
                        @if (!string.IsNullOrWhiteSpace(_partyPhone))
                        {
                            <span><MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" /> @_partyPhone</span>
                            <button type="button" class="js-copy js-no-print" @onclick="CopyPhone">
                                <MudIcon Icon="@(_phoneCopied ? Icons.Material.Filled.Check : Icons.Material.Filled.ContentCopy)" Size="Size.Small" />
                                <span>@(_phoneCopied ? "تم النسخ" : "نسخ")</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
            <div class="js-actions js-no-print">
                @if (_partyId > 0)
                {
                    <button type="button" class="js-act gold" @onclick="AddAnother"><MudIcon Icon="@Icons.Material.Filled.AddBox" Size="Size.Small" /> منتج آخر</button>
                }
                <button type="button" class="js-act" @onclick="OpenAllInquiries"><MudIcon Icon="@Icons.Material.Filled.QuestionAnswer" Size="Size.Small" /> الاستفسارات @InquiryCount</button>
                <button type="button" class="js-act" disabled="@_printing" @onclick="Print"><MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small" /> طباعة</button>
                <button type="button" class="js-act" @onclick="GoBack"><MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /> رجوع</button>
            </div>
        </header>
        @if (_partyId > 0)
        {
            <section class="js-engineers">
                @if (!_engineersReady)
                {
                    <p>شغّل سكربت مهندسي الجوب أوردر مرة واحدة حتى يُحفظ الاستلام والتحويل.</p>
                }
                else
                {
                    <div>
                        <span>مهندس التصميم</span>
                        <strong>@(string.IsNullOrWhiteSpace(_designEngineerName) ? "لم يُستلم" : _designEngineerName)</strong>
                        @if (_canTransferDesign)
                        {
                            <button type="button" class="js-no-print" @onclick='() => OpenTransfer(JobOrderEngineerService.DesignSeat)'>تحويل</button>
                        }
                    </div>
                    <div>
                        <span>مهندس التنفيذ</span>
                        <strong>@(string.IsNullOrWhiteSpace(_executionEngineerName) ? "لم يُستلم" : _executionEngineerName)</strong>
                        @if (_canTransferExecution)
                        {
                            <button type="button" class="js-no-print" @onclick='() => OpenTransfer(JobOrderEngineerService.ExecutionSeat)'>تحويل</button>
                        }
                    </div>
                }
            </section>
            @if (_transferSeat != null)
            {
                <section class="js-engineers js-transfer js-no-print">
                    <strong>@(_transferSeat == JobOrderEngineerService.DesignSeat ? "تحويل مهندس التصميم" : "تحويل مهندس التنفيذ")</strong>
                    <MudSelect T="int?" @bind-Value="_transferEmployeeId" Label="المهندس" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var candidate in _transferCandidates)
                        {
                            <MudSelectItem T="int?" Value="@((int?)candidate.EmployeeId)">@candidate.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField @bind-Value="_transferReason" Label="سبب التحويل" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="300" />
                    <div class="js-actions">
                        <button type="button" class="js-act gold" @onclick="ConfirmTransfer" disabled="@_transferring">تأكيد التحويل</button>
                        <button type="button" class="js-act" @onclick="CloseTransfer">إلغاء</button>
                    </div>
                </section>
            }
        }
        <div class="js-toolbar js-no-print">
            <button type="button" class="js-filter @(_priceFilter == "all" && _invoiceFilter == "all" ? "active" : "")" @onclick="ClearFilters">الكل @_cards.Count</button>
            <button type="button" class="js-filter @(_priceFilter == "priced" ? "active" : "")" @onclick='() => SetPriceFilter("priced")'>تم التسعير @PricedCount</button>
            <button type="button" class="js-filter @(_priceFilter == "unpriced" ? "active" : "")" @onclick='() => SetPriceFilter("unpriced")'>لم يتم التسعير @UnpricedCount</button>
            @if (_canSeeInvoices)
            {
                <button type="button" class="js-filter @(_invoiceFilter == "linked" ? "active" : "")" @onclick='() => SetInvoiceFilter("linked")'>مرتبطة بفاتورة @LinkedCount</button>
                <button type="button" class="js-filter @(_invoiceFilter == "unlinked" ? "active" : "")" @onclick='() => SetInvoiceFilter("unlinked")'>بدون فاتورة @UnlinkedCount</button>
            }
        </div>

        @if (!VisibleCards.Any())
        {
            <article class="js-card">
                <p class="js-wait">@(_cards.Count == 0 ? "لا توجد منتجات مرتبطة بهذا العميل." : "لا توجد منتجات مطابقة للفلتر.")</p>
            </article>
        }
        else
        {
            @foreach (var card in VisibleCards)
            {
                <article id="js-product-@card.ProductId" class="js-card @(card.ProductId == FocusProductId ? "focused" : "")">
                    <div class="js-card-top">
                        <div>
                            <div class="js-title-row">
                                <h2>@card.Name</h2>
                                <span class="js-pill @(card.IsPriced ? "priced" : "")">@card.StatusName</span>
                            </div>
                            <p class="js-meta">كود @card.ProductId · @card.CreatedText · مدة التصنيع @card.PeriodText</p>
                            @if (_canSeeInvoices && card.Invoices.Count > 0)
                            {
                                <div class="js-invoices">
                                    @foreach (var inv in card.Invoices)
                                    {
                                        <button type="button" class="js-invoice" @onclick="() => OpenInvoice(inv.TransactionId)">
                                            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" />
                                            <span>فاتورة @inv.Number</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        <button type="button" class="js-reply-btn js-no-print" @onclick="() => OpenProduct(card.ProductId)"><MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" /> عرض المنتج</button>
                    </div>
                    <p class="js-desc">@(string.IsNullOrWhiteSpace(card.Description) ? "لا يوجد وصف." : card.Description)</p>
                    @ImageRow(card.Images, card.Name)
                    @SpecBlock(card.Specs)
                    @if (!string.IsNullOrWhiteSpace(card.Manufacturing))
                    {
                        <p class="js-desc"><strong>ملاحظات التصنيع: </strong>@card.Manufacturing</p>
                    }
                    <div class="js-reply js-no-print">
                        <button type="button" class="js-reply-btn" @onclick="() => OpenInquiries(card.ProductId)">
                            استفسارات المنتج
                            @if (card.Notes.Count > 0)
                            {
                                <span class="js-count">@card.Notes.Count</span>
                            }
                        </button>
                        @if (_canAsk || _canAnswer)
                        {
                            <button type="button" class="js-reply-btn gold" @onclick='() => OpenReply(card.ProductId, "note")'>استفسار</button>
                        }
                        @if (_canAnswer)
                        {
                            <button type="button" class="js-reply-btn" @onclick="() => OpenChange(card.ProductId)">طلب تعديل</button>
                        }
                        @if (_canReply && (card.NeedsReply || card.HasOpenChangeRequest))
                        {
                            <button type="button" class="js-reply-btn" @onclick='() => OpenReply(card.ProductId, "price")'>تسعير</button>
                            <button type="button" class="js-reply-btn" @onclick='() => OpenReply(card.ProductId, "alt")'>اقتراح بديل</button>
                        }
                        @if (_replyProductId == card.ProductId)
                        {
                            <div class="js-reply-form">
                                @if (_replyMode == "price" && (card.NeedsReply || card.HasOpenChangeRequest))
                                {
                                    <MudNumericField T="decimal?" @bind-Value="_costC" Label="تكلفة Standard" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudNumericField T="decimal?" @bind-Value="_costP" Label="تكلفة Premium" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudNumericField T="decimal?" @bind-Value="_costE" Label="تكلفة Elite" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <p class="js-hint">سعر البيع يتحدث تلقائيًا حسب نسب الربح المفعلة.</p>
                                    <MudNumericField T="int?" @bind-Value="_replyPeriod" Label="مدة التصنيع باليوم" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudTextField T="string" @bind-Value="_replyText" Label="ملاحظة التصنيع" Variant="Variant.Outlined" Lines="2" />
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_savingReply" OnClick="SavePricing">حفظ التسعير</MudButton>
                                }
                                else if (_replyMode == "alt" && (card.NeedsReply || card.HasOpenChangeRequest))
                                {
                                    <MudTextField T="string" @bind-Value="_altName" Label="اسم البديل" Variant="Variant.Outlined" />
                                    <MudTextField T="string" @bind-Value="_altSummary" Label="المواصفات" Variant="Variant.Outlined" Lines="2" />
                                    <MudNumericField T="decimal?" @bind-Value="_costC" Label="تكلفة Standard" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudNumericField T="decimal?" @bind-Value="_costP" Label="تكلفة Premium" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudNumericField T="decimal?" @bind-Value="_costE" Label="تكلفة Elite" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <p class="js-hint">سعر البيع يتحدث تلقائيًا حسب نسب الربح، ومش بيظهر على الكارت.</p>
                                    <MudNumericField T="int?" @bind-Value="_replyPeriod" Label="مدة التصنيع باليوم" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudTextField T="string" @bind-Value="_replyText" Label="ملاحظة التصنيع" Variant="Variant.Outlined" Lines="2" />
                                    <SpecValueRows Title="متغيرات البديل" Questions="_questions" Drafts="_altSpecDrafts" VariableImages="_altVariableImages" />
                                    <SpecFieldsEditor Questions="BasicSizes" Drafts="_altSpecDrafts" UseFormLabel="true" />
                                    <label class="js-hint">صور البديل</label>
                                    <InputFile OnChange="OnAltFiles" multiple accept="image/*" class="js-target" />
                                    @if (_altFiles.Count > 0)
                                    {
                                        <p class="js-hint">@_altFiles.Count صورة مختارة. حد أقصى 6 صور، وكل صورة 5MB.</p>
                                    }
                                    <p class="js-hint">قيم البديل مستقلة عن المنتج. كل متغير يُكتب أو يُكتب لا يوجد، وتقدر تضيف صورة لكل قيمة.</p>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_savingReply" OnClick="SaveAlternative">حفظ البديل</MudButton>
                                }
                                else if (_replyMode == "note")
                                {
                                    <label class="js-hint">الاستفسار عن</label>
                                    <select class="js-target" @bind="_inquiryTarget">
                                        <option value="المنتج كله">المنتج كله</option>
                                        @foreach (var part in card.Components)
                                        {
                                            <option value="@($"قطعة: {part.Name}")">قطعة: @part.Name</option>
                                        }
                                    </select>
                                    <textarea class="js-target" rows="4" @bind="_replyText" placeholder="اكتب الاستفسار"></textarea>
                                    <p class="js-hint">@InquiryHint(card)</p>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_savingReply" OnClick="SaveNote">إرسال الاستفسار</MudButton>
                                }
                                else if (_replyMode == "change")
                                {
                                    <textarea class="js-target" rows="4" @bind="_replyText" placeholder="ما المطلوب تعديله؟"></textarea>
                                    <p class="js-hint">يصل للمصنع ومدير الإنتاج. من غير أسعار، ومن غير بدء تصنيع.</p>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_savingReply" OnClick="SaveChangeRequest">إرسال طلب التعديل</MudButton>
                                }
                            </div>
                        }
                    </div>

                    @if (card.Components.Count > 0)
                    {
                        <h3>المكونات</h3>
                        @foreach (var part in card.Components)
                        {
                            <div class="js-part">
                                <strong>@part.Name</strong>
                                <span>كمية @part.Quantity · @part.KindLabel</span>
                                @if (!string.IsNullOrWhiteSpace(part.LinkedName))
                                {
                                    <p class="js-desc">منتج مرتبط: @part.LinkedName</p>
                                    @SpecBlock(part.LinkedSpecs)
                                }
                                else
                                {
                                    @SpecBlock(part.OwnSpecs)
                                }
                                @ImageRow(part.Images, part.Name)
                            </div>
                        }
                    }

                    <h3>رد المصنع</h3>
                    @if (card.Alternatives.Count == 0)
                    {
                        <p class="js-wait">لا يوجد بديل مقترح.</p>
                    }
                    else
                    {
                        @foreach (var alt in card.Alternatives)
                        {
                            <div class="js-alt @(alt.IsApproved ? "selected" : "")">
                                <div class="js-card-top">
                                    <strong>@alt.Name</strong>
                                    <span class="js-pill">@(alt.IsApproved ? "بديل معتمد" : "مقترح")</span>
                                    @if (_canAnswer && !alt.IsApproved)
                                    {
                                        <button type="button" class="js-reply-btn gold" disabled="@_savingReply" @onclick="() => ApproveAlternative(card.ProductId, alt.AlternativeId)">اعتماد البديل</button>
                                    }
                                </div>
                                <p class="js-desc">@(string.IsNullOrWhiteSpace(alt.Summary) ? "لا يوجد ملخص." : alt.Summary)</p>
                                @if (alt.Period.HasValue)
                                {
                                    <p class="js-desc">مدة التصنيع: @alt.Period يوم</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(alt.Manufacturing))
                                {
                                    <p class="js-desc">@alt.Manufacturing</p>
                                }
                                @ImageRow(alt.Images, alt.Name)
                                @SpecBlock(alt.Specs)
                            </div>
                        }
                    }
                </article>
            }
        }
    </div>
    @if (_inquiryOpen)
    {
        <div class="js-modal js-no-print" dir="rtl">
            <button type="button" class="js-modal-back" @onclick="CloseInquiries" aria-label="إغلاق"></button>
            <section class="js-modal-card">
                <div class="js-card-top">
                    <div>
                        <span class="js-badge">سجل الاستفسارات</span>
                        <h2>@(_inquiryProductId == null ? "استفسارات الجوب أوردر" : "استفسارات المنتج")</h2>
                    </div>
                    <button type="button" class="js-reply-btn" @onclick="CloseInquiries">إغلاق</button>
                </div>
                <div class="js-modal-switch">
                    <button type="button" class="@AllInquiryClass" @onclick="OpenAllInquiries">الجوب أوردر كله @InquiryCount</button>
                    @if (_inquiryProductId is int selectedId)
                    {
                        <button type="button" class="js-filter active" @onclick="() => OpenInquiries(selectedId)">هذا المنتج @ProductInquiryCount(selectedId)</button>
                    }
                </div>
                <div class="js-modal-body">
                    @if (!InquiryView.Any())
                    {
                        <p class="js-wait">لا توجد استفسارات.</p>
                    }
                    else
                    {
                        @foreach (var item in InquiryView)
                        {
                            <article class="js-inquiry-group">
                                <div class="js-card-top">
                                    <strong>@item.Name</strong>
                                    @if (_inquiryProductId == null)
                                    {
                                        <button type="button" class="js-reply-btn" @onclick="() => OpenInquiries(item.ProductId)">هذا المنتج</button>
                                    }
                                </div>
                                @if (item.Notes.Count == 0)
                                {
                                    <p class="js-wait">لا توجد استفسارات على هذا المنتج.</p>
                                }
                                @foreach (var note in item.Notes)
                                {
                                    <div class="js-inquiry @(note.FromFactory ? "" : "sales")">
                                        <span class="js-pill @(note.FromFactory ? "" : "sales")">@note.Side</span>
                                        <span class="js-pill">@note.Target</span>
                                        <p>@note.Text</p>
                                        <small>@note.By · @note.When</small>
                                    </div>
                                }
                            </article>
                        }
                    }
                </div>
            </section>
        </div>
    }
}

<style>
    .js-loading { min-height: 50vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .6rem; }
    .js-page { max-width: 1180px; margin: 0 auto; padding: .7rem 1rem 2rem; }
    .js-card-top { display: flex; justify-content: space-between; gap: .6rem; align-items: center; flex-wrap: wrap; }
    .js-head { display: flex; justify-content: space-between; gap: .7rem; align-items: center; background: linear-gradient(135deg, #1a2842 0%, #2a3f6a 58%, #1a2842 100%); color: #fff; border-radius: 16px; padding: .62rem .8rem; margin-bottom: .55rem; box-shadow: 0 8px 22px rgba(26,40,66,.16); }
    .js-id { display: flex; align-items: center; gap: .7rem; min-width: 0; }
    .js-mark { width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; flex: 0 0 auto; color: #1a2842; background: linear-gradient(135deg, #ffe9a3, #d4af37); box-shadow: 0 0 14px rgba(212,175,55,.5); }
    .js-title-line { display: flex; align-items: center; gap: .45rem; flex-wrap: wrap; }
    .js-head h1 { font-size: 1.12rem; line-height: 1.3; }
    .js-head p { margin: .12rem 0 0; color: rgba(255,255,255,.72); font-size: .8rem; }
    .js-contact, .js-copy, .js-toolbar, .js-actions { display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; }
    .js-contact { margin-top: .12rem; color: rgba(255,255,255,.78); font-size: .8rem; }
    .js-contact span, .js-copy, .js-act { display: inline-flex; align-items: center; gap: .32rem; }
    .js-copy { background: rgba(255,255,255,.08); color: #fff; border: 1px solid rgba(212,175,55,.4); border-radius: 999px; padding: .12rem .5rem; cursor: pointer; box-shadow: 0 0 10px rgba(212,175,55,.16); }
    .js-actions { justify-content: flex-end; min-width: 0; }
    .js-act { border: 1px solid rgba(212,175,55,.5); background: rgba(255,255,255,.07); color: #fff; border-radius: 999px; min-height: 34px; padding: .3rem .72rem; font-weight: 800; font-size: .8rem; cursor: pointer; white-space: nowrap; box-shadow: inset 0 0 10px rgba(212,175,55,.12), 0 0 10px rgba(212,175,55,.16); transition: box-shadow .2s ease, transform .2s ease; }
    .js-act:hover { background: rgba(212,175,55,.16); box-shadow: 0 0 16px rgba(212,175,55,.42); transform: translateY(-1px); }
    .js-act.gold { position: relative; overflow: hidden; border: 0; color: #1a2842; background: linear-gradient(180deg, #ffe9a3 0%, #f0d060 40%, #d4af37 100%); box-shadow: 0 0 0 1px rgba(255,244,196,.75), 0 0 16px rgba(212,175,55,.55); }
    .js-act.gold::after, .js-reply-btn.gold::after { content: ""; position: absolute; top: 0; bottom: 0; width: 38%; left: -55%; background: linear-gradient(90deg, transparent, rgba(255,255,255,.62), transparent); animation: js-shine 2.8s ease-in-out infinite; pointer-events: none; }
    .js-act:disabled { opacity: .55; cursor: not-allowed; transform: none; }
    .js-toolbar { margin: -.1rem 0 .65rem; }
