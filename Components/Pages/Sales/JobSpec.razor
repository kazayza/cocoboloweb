    private async Task Print()
    {
        if (_printing || _cards.Count == 0)
        {
            if (_cards.Count == 0)
                Snackbar.Add("لا توجد منتجات في الملف.", Severity.Warning);
            return;
        }
        _printing = true;
        try
        {
            string? city = null;
            string? address = null;
            if (_partyId > 0)
            {
                var party = await Db.Parties.AsNoTracking()
                    .Where(p => p.PartyId == _partyId)
                    .Select(p => new { p.City, p.Area, p.Address })
                    .FirstOrDefaultAsync();
                city = string.Join(" - ", new[] { party?.City, party?.Area }.Where(x => !string.IsNullOrWhiteSpace(x)));
                address = party?.Address;
            }
            var ids = _cards.Select(c => c.ProductId).ToList();
            var creators = await Db.Products.AsNoTracking()
                .Where(p => ids.Contains(p.ProductId))
                .Select(p => p.CreatedBy)
                .ToListAsync();
            var doc = new JobSpecPdfDocument
            {
                CustomerName = _partyId > 0 ? _partyName : (_cards[0].Name),
                Phone = _partyPhone,
                City = string.IsNullOrWhiteSpace(city) ? null : city,
                Address = address,
                PrintedBy = _userName,
                PreparedBy = string.Join("، ", creators.Where(x => !string.IsNullOrWhiteSpace(x)).Distinct()),
                IssuedAt = DateTime.Now,
                Products = _cards.Select((card, index) => new JobSpecPdfProduct
                {
                    Number = index + 1,
                    ProductId = card.ProductId,
                    Name = card.Name,
                    Status = card.StatusName,
                    Period = card.PeriodText,
                    Created = card.CreatedText,
                    Description = card.Description,
                    Manufacturing = card.Manufacturing,
                    InvoiceNumbers = card.Invoices.Select(i => i.Number).ToList(),
                    ImageSources = card.Images,
                    Specs = card.Specs,
                    Notes = card.Notes.Select(n => $"{n.Side} — {n.Target} — {n.By} · {n.When}: {n.Text}").ToList(),
                    Parts = card.Components.Select(part => new JobSpecPdfPart
                    {
                        Name = part.Name,
                        Meta = $"كمية {part.Quantity} · {part.KindLabel}",
                        LinkedName = part.LinkedName,
                        Specs = part.LinkedSpecs.Count > 0 ? part.LinkedSpecs : part.OwnSpecs,
                        ImageSources = part.Images
                    }).ToList(),
                    Alternatives = card.Alternatives.Select(alt => new JobSpecPdfAlt
                    {
                        Name = alt.Name,
                        Status = alt.IsApproved ? "بديل معتمد" : "مقترح",
                        Summary = alt.Summary,
                        Manufacturing = alt.Manufacturing,
                        Period = alt.Period,
                        Specs = alt.Specs,
                        ImageSources = alt.Images
                    }).ToList()
                }).ToList()
            };
            var bytes = await JobSpecPdfBuilder.CreateAsync(Db, Env.WebRootPath ?? "", doc);
            var safe = string.Concat((_partyId > 0 ? _partyName : "بدون-عميل").Where(c => !Path.GetInvalidFileNameChars().Contains(c))).Trim();
            if (string.IsNullOrWhiteSpace(safe)) safe = _partyId > 0 ? _partyId.ToString() : "product";
            await JS.InvokeVoidAsync("downloadFile", $"جوب-أوردر-{safe}.pdf", "application/pdf", Convert.ToBase64String(bytes));
            Snackbar.Add("تم تنزيل ملف الطباعة. افتحه واطبعه من عارض الملفات.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message.Contains("خط") ? ex.Message : "تعذر إنشاء ملف الطباعة.", Severity.Error);
        }
        finally
        {
            _printing = false;
        }
    }


