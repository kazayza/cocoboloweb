@code {
    [Parameter] public int PartyId { get; set; }
    [Parameter] public int ProductId { get; set; }
    [SupplyParameterFromQuery(Name = "product")] public int? FocusProductId { get; set; }

    private bool _loading = true;
    private bool _canView;
    private bool _canSeeInvoices;
    private bool _canReply;
    private bool _canAsk;
    private bool _canAnswer;
    private bool _savingReply;
    private int? _replyProductId;
    private string _replyMode = "";
    private decimal? _costC;
    private decimal? _costP;
    private decimal? _costE;
    private int? _replyPeriod;
    private string _replyText = "";
    private string _altName = "";
    private string _altSummary = "";
    private readonly Dictionary<int, SpecAnswerDto> _altSpecDrafts = new();
    private List<SpecVariableImageDto> _altVariableImages = new();
    private List<SpecQuestionDto> BasicSizes => _questions.Where(SpecVariableRules.IsBasicDimension).OrderBy(q => q.SortOrder).ToList();
    private List<IBrowserFile> _altFiles = new();
    private string _userName = "System";
    private ClaimsPrincipal? _user;
    private bool _authChecked;
    private bool _missing;
    private bool _searchMode;
    private string _customerSearch = "";
    private string _priceFilter = "all";
    private string _invoiceFilter = "all";
    private bool _phoneCopied;
    private bool _printing;
    private bool _inquiryOpen;
    private bool _focusScrolled;
    private int? _inquiryProductId;
    private string _inquiryTarget = "المنتج كله";
    private List<CustomerPick> _customerChoices = new();
    private int _partyId;
    private int _seenParty = -1;
    private int _seenProduct = -1;
    private string _partyName = "";
    private string? _partyPhone;
    private List<SpecQuestionDto> _questions = new();
    private Dictionary<int, string> _statusNames = new();
    private List<ProductCard> _cards = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        _user = user;
        _userName = user.Identity?.Name ?? "System";
        _canAsk = user.IsInRole(SystemRoles.Admin) || user.IsInRole("factory")
            || user.IsInRole(SystemRoles.FactoryManager) || user.IsInRole(SystemRoles.ProductionManager);
        _canAnswer = user.IsInRole(SystemRoles.Admin) || user.IsInRole(SystemRoles.Sales)
            || user.IsInRole(SystemRoles.SalesManager) || user.IsInRole(SystemRoles.GeneralManager);
        _canReply = _canAsk;
        _canView = user.IsInRole(SystemRoles.Admin) || user.IsInRole(SystemRoles.SalesManager)
            || user.IsInRole(SystemRoles.Sales) || user.IsInRole(SystemRoles.AccountManager)
            || user.IsInRole(SystemRoles.GeneralManager)
            || user.IsInRole(SystemRoles.ProductionManager) || user.IsInRole(SystemRoles.FactoryManager)
            || user.IsInRole("factory")
            || await Engineers.UserCanOpenJobAsync(_userName);
        _canSeeInvoices = user.IsInRole(SystemRoles.Admin) || user.HasClaim("Permission", "frm_PartiesInvoices:View");
        _authChecked = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusScrolled || _loading || FocusProductId is not int focusId || focusId <= 0) return;
        _focusScrolled = true;
        try
        {
            await JS.InvokeVoidAsync("eval", $"document.getElementById('js-product-{focusId}')?.scrollIntoView({{behavior:'smooth',block:'center'}})");
        }
        catch { }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_authChecked || !_canView)
        {
            _loading = false;
            return;
        }
        if (PartyId == _seenParty && ProductId == _seenProduct)
        {
            _loading = false;
            return;
        }
        _seenParty = PartyId;
        _seenProduct = ProductId;
        _focusScrolled = false;
        _loading = true;
        var redirected = await LoadAsync();
        if (!redirected && _partyId > 0)
            await LoadEngineersAsync();
        if (!redirected)
            _loading = false;
    }

    private async Task<bool> LoadAsync()
    {
        _missing = false;
        _searchMode = false;
        _cards.Clear();
        _partyId = 0;
        _partyName = "";
        _partyPhone = null;
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', 2)[0];
        var customerRoute = path.StartsWith("customers/", StringComparison.OrdinalIgnoreCase);

        if (path.Equals("job-spec", StringComparison.OrdinalIgnoreCase))
        {
            _searchMode = true;
            await LoadCustomerChoicesAsync();
            return false;
        }

        if (!customerRoute)
        {
            var product = await Db.Products.AsNoTracking().FirstOrDefaultAsync(p => p.ProductId == ProductId);
            if (product == null)
            {
                _missing = true;
                return false;
            }
            if (product.Customer is int customerId && customerId > 0)
            {
                Navigation.NavigateTo($"/customers/{customerId}/job-spec?product={product.ProductId}", replace: true);
                return true;
            }
            await LoadSharedAsync();
            _cards.Add(await BuildCardAsync(product));
            await AttachInvoicesAsync();
            await AttachNotesAsync();
            return false;
        }

        var party = await Db.Parties.AsNoTracking().FirstOrDefaultAsync(p => p.PartyId == PartyId);
        if (party == null)
        {
            _missing = true;
            return false;
        }
        _partyId = party.PartyId;
        _partyName = party.PartyName;
        _partyPhone = party.Phone;
        await LoadSharedAsync();
        var products = await Db.Products.AsNoTracking()
            .Where(p => p.Customer == PartyId)
            .OrderByDescending(p => p.CreatedAt)
            .ThenByDescending(p => p.ProductId)
            .ToListAsync();
        foreach (var product in products)
            _cards.Add(await BuildCardAsync(product));
        await AttachInvoicesAsync();
        await AttachNotesAsync();
        return false;
    }

    private async Task LoadSharedAsync()
    {
        if (_questions.Count == 0)
            _questions = await SpecService.GetStandardQuestionsAsync();
        if (_statusNames.Count == 0)
            _statusNames = await Db.ProductPricingStatuses.AsNoTracking()
                .ToDictionaryAsync(s => s.PricingStatusId, s => s.StatusName);
    }

    private async Task<ProductCard> BuildCardAsync(Product product)
    {
        var images = await Db.ProductImages.AsNoTracking().Where(i => i.ProductId == product.ProductId).ToListAsync();
        var components = await Db.ProductComponents.AsNoTracking().Where(c => c.ProductId == product.ProductId).ToListAsync();
        var links = await LoadComponentLinksAsync(components);
        var partImages = await LoadComponentImagesAsync(components);
        var linkedIds = links.Values.Where(x => x.HasValue).Select(x => x!.Value).Distinct().ToList();
        var linkedNames = linkedIds.Count == 0
            ? new Dictionary<int, string>()
            : await Db.Products.AsNoTracking().Where(p => linkedIds.Contains(p.ProductId))
                .ToDictionaryAsync(p => p.ProductId, p => p.ProductName);
        var parts = new List<ComponentVm>();
        foreach (var component in components)
        {
            links.TryGetValue(component.ComponentId, out var linkedId);
            var part = new ComponentVm
            {
                Name = string.IsNullOrWhiteSpace(component.ComponentName) ? "قطعة" : component.ComponentName,
                Quantity = component.Quantity,
                KindLabel = linkedId.HasValue ? "منتج مرتبط" : "قطعة مخصصة",
                Images = partImages.TryGetValue(component.ComponentId, out var pics) ? pics : new()
            };
            if (linkedId.HasValue)
            {
                part.LinkedName = linkedNames.TryGetValue(linkedId.Value, out var linkedName) ? linkedName : null;
                part.LinkedSpecs = await SpecLinesAsync(SpecOwners.Product, linkedId.Value);
            }
            else if (component.ComponentId > 0)
                part.OwnSpecs = await SpecLinesAsync(SpecOwners.Component, component.ComponentId);
            parts.Add(part);
        }

        var alternatives = await Db.ProductFactoryAlternatives.AsNoTracking()
            .Where(a => a.ProductId == product.ProductId && a.Status != ProductFactoryAlternativeStatuses.Rejected)
            .ToListAsync();
        var altIds = alternatives.Select(a => a.AlternativeId).ToList();
        var altImages = altIds.Count == 0
            ? new List<ProductFactoryAlternativeImage>()
            : await Db.ProductFactoryAlternativeImages.AsNoTracking().Where(i => altIds.Contains(i.AlternativeId)).ToListAsync();
        var alts = new List<AltVm>();
        foreach (var alt in alternatives)
        {
            alts.Add(new AltVm
            {
                AlternativeId = alt.AlternativeId,
                Name = alt.AlternativeName,
                Summary = alt.SpecificationSummary,
                Manufacturing = alt.ManufacturingDescription,
                Period = alt.Period,
                IsApproved = alt.Status == ProductFactoryAlternativeStatuses.Approved,
                Images = altImages.Where(i => i.AlternativeId == alt.AlternativeId).Select(i => i.ImagePath).Where(x => !string.IsNullOrWhiteSpace(x)).ToList()!,
                Specs = await SpecLinesAsync(SpecOwners.Alternative, alt.AlternativeId)
            });
        }

        return new ProductCard
        {
            ProductId = product.ProductId,
            Name = product.ProductName,
            Description = product.ProductDescription,
            Manufacturing = product.ManufacturingDescription,
            PeriodText = product.Period.HasValue ? $"{product.Period} يوم" : "غير محددة",
            CreatedText = product.CreatedAt.HasValue ? product.CreatedAt.Value.ToString("dd/MM/yyyy") : "بدون تاريخ",
            StatusName = TranslateStatus(product.PricingStatusId, _statusNames.TryGetValue(product.PricingStatusId, out var status) ? status : null),
            IsPriced = product.PricingStatusId is 3 or 5,
            NeedsReply = product.PricingStatusId is 2 or 4 or 7 or 8,
            CreatedBy = product.CreatedBy,
            Images = images.Select(i => i.ProductImagesId > 0 ? $"/api/product-image-by-id/{i.ProductImagesId}" : i.ImagePath)
                .Where(x => !string.IsNullOrWhiteSpace(x)).ToList()!,
            Specs = await SpecLinesAsync(SpecOwners.Product, product.ProductId),
            Components = parts,
            Alternatives = alts
        };
    }

    private async Task<List<string>> SpecLinesAsync(string owner, int ownerId)
    {
        if (ownerId <= 0 || _questions.Count == 0) return new();
        var answers = await SpecService.GetAnswersAsync(owner, ownerId);
        var lines = new List<string>();
        foreach (var question in _questions)
        {
            var answer = answers.FirstOrDefault(a => a.QuestionId == question.QuestionId);
            if (answer == null) continue;
            var value = question.DataType == SpecDataTypes.Number
                ? answer.NumberValue.HasValue ? $"{answer.NumberValue:0.##} {question.UnitName}".Trim() : null
                : !string.IsNullOrWhiteSpace(answer.TextValue) ? answer.TextValue : question.Options.FirstOrDefault(o => o.OptionId == answer.OptionId)?.OptionNameAr;
            if (!string.IsNullOrWhiteSpace(value))
                lines.Add($"{question.QuestionNameAr}: {value}");
        }
        return lines;
    }

    private async Task<Dictionary<int, int?>> LoadComponentLinksAsync(List<ProductComponent> components)
    {
        var result = new Dictionary<int, int?>();
        var ids = components.Where(c => c.ComponentId > 0).Select(c => c.ComponentId).Distinct().ToList();
        if (ids.Count == 0) return result;
        try
        {
            var conn = Db.Database.GetDbConnection();
            var opened = conn.State != ConnectionState.Open;
            if (opened) await conn.OpenAsync();
            try
            {
                await using var check = conn.CreateCommand();
                check.CommandText = "SELECT COL_LENGTH('dbo.ProductComponents', 'LinkedProductId')";
                if (await check.ExecuteScalarAsync() is null or DBNull) return result;
                await using var cmd = conn.CreateCommand();
                cmd.CommandText = "SELECT ComponentID, LinkedProductId FROM ProductComponents WHERE ComponentID IN (" + string.Join(",", ids) + ")";
                await using var reader = await cmd.ExecuteReaderAsync();
                while (await reader.ReadAsync())
                    result[reader.GetInt32(0)] = reader.IsDBNull(1) ? null : reader.GetInt32(1);
            }
            finally { if (opened) await conn.CloseAsync(); }
        }
        catch { }
        return result;
    }

    private async Task<Dictionary<int, List<string>>> LoadComponentImagesAsync(List<ProductComponent> components)
    {
        var result = new Dictionary<int, List<string>>();
        var ids = components.Where(c => c.ComponentId > 0).Select(c => c.ComponentId).Distinct().ToList();
        if (ids.Count == 0) return result;
        try
        {
            var conn = Db.Database.GetDbConnection();
            var opened = conn.State != ConnectionState.Open;
            if (opened) await conn.OpenAsync();
            try
            {
                await using var check = conn.CreateCommand();
                check.CommandText = "SELECT OBJECT_ID(N'dbo.ComponentImages', N'U')";
                if (await check.ExecuteScalarAsync() is null or DBNull) return result;
                await using var cmd = conn.CreateCommand();
                cmd.CommandText = "SELECT ComponentId, ImagePath FROM ComponentImages WHERE ComponentId IN (" + string.Join(",", ids) + ")";
                await using var reader = await cmd.ExecuteReaderAsync();
                while (await reader.ReadAsync())
                {
                    var id = reader.GetInt32(0);
                    if (!result.TryGetValue(id, out var list))
                        result[id] = list = new();
                    if (!reader.IsDBNull(1)) list.Add(reader.GetString(1));
                }
            }
            finally { if (opened) await conn.CloseAsync(); }
        }
        catch { }
        return result;
    }

    private async Task LoadCustomerChoicesAsync()
    {
        _customerChoices = await (from product in Db.Products.AsNoTracking()
                                  where product.Customer.HasValue
                                  join party in Db.Parties.AsNoTracking() on product.Customer equals party.PartyId
                                  group product by new { party.PartyId, party.PartyName, party.Phone } into g
                                  orderby g.Key.PartyName
                                  select new CustomerPick
                                  {
                                      PartyId = g.Key.PartyId,
                                      PartyName = g.Key.PartyName,
                                      Phone = g.Key.Phone,
                                      ProductCount = g.Count()
                                  }).ToListAsync();
    }

    private List<CustomerPick> FilteredCustomers
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_customerSearch)) return _customerChoices.Take(30).ToList();
            var term = _customerSearch.Trim();
            return _customerChoices.Where(c =>
                    (c.PartyName ?? "").ContainsArabic(term)
                    || (c.Phone ?? "").Contains(term, StringComparison.OrdinalIgnoreCase))
                .Take(30)
                .ToList();
        }
    }

    private int InquiryCount => _cards.Sum(c => c.Notes.Count);
    private int ProductInquiryCount(int productId) => _cards.FirstOrDefault(c => c.ProductId == productId)?.Notes.Count ?? 0;
    private List<ProductCard> InquiryView => _inquiryProductId is int id
        ? _cards.Where(c => c.ProductId == id).ToList()
        : _cards.Where(c => c.Notes.Count > 0).ToList();
    private string AllInquiryClass => _inquiryProductId == null ? "js-filter active" : "js-filter";

    private void OpenReply(int productId, string mode)
    {
        _replyProductId = productId;
        _replyMode = mode;
        _replyText = "";
        _altName = "";
        _altSummary = "";
        _altSpecDrafts.Clear();
        _altVariableImages = new();
        _altFiles = new();
        _inquiryTarget = "المنتج كله";
        _replyPeriod = null;
        _costC = _costP = _costE = null;
    }

    private void OpenAllInquiries()
    {
        _inquiryProductId = null;
        _inquiryOpen = true;
    }

    private void OpenInquiries(int productId)
    {
        _inquiryProductId = productId;
        _inquiryOpen = true;
    }

    private void CloseInquiries() => _inquiryOpen = false;

    private void OpenChange(int productId)
    {
        OpenReply(productId, "change");
        _inquiryTarget = "طلب تعديل";
    }

    private async Task SavePricing()
    {
        if (_replyProductId is not int productId) return;
        var hasCost = (_costC ?? 0) > 0 || (_costP ?? 0) > 0 || (_costE ?? 0) > 0;
        if (!hasCost || _replyPeriod is not > 0)
        {
            Snackbar.Add("أدخل تكلفة واحدة على الأقل ومدة التصنيع.", Severity.Warning);
            return;
        }
        _savingReply = true;
        try
        {
            var margin = await Db.PricingMargins.AsNoTracking()
                .Where(m => m.IsActive)
                .OrderByDescending(m => m.MarginId)
                .FirstOrDefaultAsync();
            if (margin == null)
            {
                Snackbar.Add("لا توجد نسب ربح مفعلة، فسعر البيع ما اتحدثش.", Severity.Warning);
                return;
            }

            var product = await Db.Products.FirstOrDefaultAsync(p => p.ProductId == productId);
            if (product == null) return;
            var oldCostC = product.PurchasePriceCClass;
            var oldSaleC = product.SuggestedSalePriceCClass;
            var oldCostP = product.PurchasePrice;
            var oldSaleP = product.SuggestedSalePrice;
            var oldCostE = product.PurchasePriceElite;
            var oldSaleE = product.SuggestedSalePriceElite;
            var saleC = SaleFromMargin(_costC, margin.CClassMargin);
            var saleP = SaleFromMargin(_costP, margin.PremiumMargin);
            var saleE = SaleFromMargin(_costE, margin.EliteMargin);
            product.PurchasePriceCClass = _costC;
            product.PurchasePrice = _costP;
            product.PurchasePriceElite = _costE;
            product.SuggestedSalePriceCClass = saleC;
            product.SuggestedSalePrice = saleP;
            product.SuggestedSalePriceElite = saleE;
            TrackJobPrice(product, "CClass_Cost", oldCostC, _costC);
            TrackJobPrice(product, "CClass_Sale", oldSaleC, saleC);
            TrackJobPrice(product, "Premium_Cost", oldCostP, _costP);
            TrackJobPrice(product, "Premium_Sale", oldSaleP, saleP);
            TrackJobPrice(product, "Elite_Cost", oldCostE, _costE);
            TrackJobPrice(product, "Elite_Sale", oldSaleE, saleE);
            product.Period = _replyPeriod;
            if (!string.IsNullOrWhiteSpace(_replyText))
                product.ManufacturingDescription = _replyText.Trim();
            product.PricingStatusId = 3;
            await Db.SaveChangesAsync();
            await NotifyJobSpec("تم تسعير منتج", $"تم تسعير {product.ProductName} وتحديث سعر البيع حسب نسب الربح.", new[] { "Sales", "SalesManager", "Admin", "AccountManager" });
            await CloseChangeRequestAsync(productId);
            Snackbar.Add("تم حفظ التسعير وتحديث سعر البيع حسب نسب الربح.", Severity.Success);
            await ReloadCurrent();
        }
        finally { _savingReply = false; }
    }

    private void TrackJobPrice(Product product, string priceType, decimal? oldValue, decimal? newValue)
        => TrackJobPrice(product.ProductId, priceType, oldValue, newValue, "تسعير من الجوب أوردر");

    private void TrackJobPrice(int productId, string priceType, decimal? oldValue, decimal? newValue, string reason)
    {
        if (oldValue == newValue) return;
        Db.PriceHistories.Add(new PriceHistory
        {
            ProductId = productId,
            PriceType = priceType,
            OldPrice = oldValue ?? 0m,
            NewPrice = newValue ?? 0m,
            ChangedBy = _userName,
            ChangedAt = DateTime.Now,
            ChangeReason = reason
        });
    }

    private static decimal? SaleFromMargin(decimal? cost, decimal marginPercent)
    {
        if (cost is not > 0) return null;
        var raw = cost.Value * (1m + marginPercent / 100m);
        return Math.Ceiling(raw / 100m) * 100m;
    }

    private async Task SaveAlternative()
    {
        if (_replyProductId is not int productId) return;
        if (string.IsNullOrWhiteSpace(_altName) || _replyPeriod is not > 0)
        {
            Snackbar.Add("اسم البديل ومدة التصنيع مطلوبان.", Severity.Warning);
            return;
        }
        var hasCost = (_costC ?? 0) > 0 || (_costP ?? 0) > 0 || (_costE ?? 0) > 0;
        if (!hasCost)
        {
            Snackbar.Add("أدخل تكلفة واحدة على الأقل للبديل.", Severity.Warning);
            return;
        }
        var missingAlt = SpecVariableRules.MissingNames(_questions, _altSpecDrafts);
        if (missingAlt.Count > 0)
        {
            Snackbar.Add(SpecVariableRules.MissingMessage("متغيرات البديل", missingAlt), Severity.Warning);
            return;
        }
        _savingReply = true;
        try
        {
            var margin = await Db.PricingMargins.AsNoTracking()
                .Where(m => m.IsActive)
                .OrderByDescending(m => m.MarginId)
                .FirstOrDefaultAsync();
            if (margin == null)
            {
                Snackbar.Add("لا توجد نسب ربح مفعلة، فسعر بيع البديل ما اتسجلش.", Severity.Warning);
                return;
            }

            var name = _altName.Trim();
            var saleC = SaleFromMargin(_costC, margin.CClassMargin);
            var saleP = SaleFromMargin(_costP, margin.PremiumMargin);
            var saleE = SaleFromMargin(_costE, margin.EliteMargin);
            var alternative = new ProductFactoryAlternative
            {
                ProductId = productId,
                AlternativeName = name,
                SpecificationSummary = string.IsNullOrWhiteSpace(_altSummary) ? null : _altSummary.Trim(),
                ManufacturingDescription = string.IsNullOrWhiteSpace(_replyText) ? null : _replyText.Trim(),
                Period = _replyPeriod,
                PurchasePriceCClass = _costC is > 0 ? _costC : null,
                PurchasePricePremium = _costP is > 0 ? _costP : null,
                PurchasePriceElite = _costE is > 0 ? _costE : null,
                SuggestedSalePriceCClass = saleC,
                SuggestedSalePricePremium = saleP,
                SuggestedSalePriceElite = saleE,
                Status = ProductFactoryAlternativeStatuses.Proposed,
                CreatedBy = _userName,
                CreatedAt = DateTime.Now
            };
            Db.ProductFactoryAlternatives.Add(alternative);
            var reason = $"بديل من الجوب أوردر: {name}";
            TrackJobPrice(productId, "Alt_CClass_Cost", null, _costC is > 0 ? _costC : null, reason);
            TrackJobPrice(productId, "Alt_CClass_Sale", null, saleC, reason);
            TrackJobPrice(productId, "Alt_Premium_Cost", null, _costP is > 0 ? _costP : null, reason);
            TrackJobPrice(productId, "Alt_Premium_Sale", null, saleP, reason);
            TrackJobPrice(productId, "Alt_Elite_Cost", null, _costE is > 0 ? _costE : null, reason);
            TrackJobPrice(productId, "Alt_Elite_Sale", null, saleE, reason);
            await Db.SaveChangesAsync();
            await SaveAltSpecsAsync(alternative.AlternativeId);
            await SaveAltImagesAsync(alternative);
            var productName = _cards.FirstOrDefault(c => c.ProductId == productId)?.Name ?? "المنتج";
            await NotifyJobSpec("بديل من المصنع", $"تم اقتراح بديل للمنتج {productName} وتحديث سعر بيعه حسب نسب الربح.", new[] { "Sales", "SalesManager", "Admin", "AccountManager" });
            await CloseChangeRequestAsync(productId);
