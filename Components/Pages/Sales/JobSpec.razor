    private async Task SaveInquiryAsync(bool fromFactory)
    {
        if (fromFactory && !_canAsk) return;
        if (!fromFactory && !_canAnswer) return;
        if (_replyProductId is not int productId || string.IsNullOrWhiteSpace(_replyText))
        {
            Snackbar.Add("اكتب الاستفسار أولاً.", Severity.Warning);
            return;
        }
        var card = _cards.FirstOrDefault(c => c.ProductId == productId);
        if (card == null) return;
        var target = string.IsNullOrWhiteSpace(_inquiryTarget) ? "المنتج كله" : _inquiryTarget.Trim();
        var textBody = _replyText.Trim();
        var side = fromFactory ? "المصنع" : "المبيعات";
        _savingReply = true;
        try
        {
            Db.PriceHistories.Add(new PriceHistory
            {
                ProductId = productId,
                PriceType = "FactoryInquiry",
                OldPrice = 0,
                NewPrice = 0,
                ChangedBy = _userName,
                ChangedAt = DateTime.Now,
                ChangeReason = FormatInquiry(target, side, textBody),
                CustomerId = _partyId > 0 ? _partyId : null
            });
            await Db.SaveChangesAsync();
            try
            {
                await NotifyInquiryAsync(card, target, textBody, fromFactory);
                Snackbar.Add("تم إرسال الاستفسار.", Severity.Success);
            }
            catch
            {
                Snackbar.Add("تم التسجيل، وتعذر إرسال الإشعار.", Severity.Warning);
            }
            await ReloadCurrent();
        }
        finally { _savingReply = false; }
    }

    private async Task AttachNotesAsync()
    {
        var ids = _cards.Select(c => c.ProductId).ToList();
        if (ids.Count == 0) return;
        var rows = await Db.PriceHistories.AsNoTracking()
            .Where(h => ids.Contains(h.ProductId) && h.PriceType == "FactoryInquiry")
            .OrderBy(h => h.ChangedAt)
            .ToListAsync();
        var users = await Db.Users.AsNoTracking()
            .Where(u => u.Username != null)
            .Select(u => new { u.Username, u.FullName })
            .ToListAsync();
        var names = users
            .GroupBy(u => u.Username!, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => string.IsNullOrWhiteSpace(g.First().FullName) ? g.Key : g.First().FullName!, StringComparer.OrdinalIgnoreCase);
        foreach (var row in rows)
        {
            var card = _cards.FirstOrDefault(c => c.ProductId == row.ProductId);
            if (card == null) continue;
            var parsed = ParseInquiry(row.ChangeReason);
            card.Notes.Add(new NoteVm
            {
                Target = parsed.Target,
                Side = parsed.Side,
                FromFactory = parsed.Side != "المبيعات",
                Text = parsed.Text,
                By = names.TryGetValue(row.ChangedBy ?? "", out var full) ? full : (row.ChangedBy ?? ""),
                When = row.ChangedAt.ToString("dd/MM/yyyy HH:mm")
            });
        }
    }

    private async Task NotifyInquiryAsync(ProductCard card, string target, string text, bool fromFactory)
    {
        var preview = text.Length > 160 ? text[..160] + "…" : text;
        var message = $"{card.Name} — {target}: {preview}";
        var form = _partyId > 0
            ? $"customers/{_partyId}/job-spec?product={card.ProductId}"
            : $"products/{card.ProductId}/job-spec";
        if (fromFactory)
        {
            var owner = await ResolveOwnerUsernameAsync(card.CreatedBy);
            var roles = new List<string> { SystemRoles.SalesManager, SystemRoles.GeneralManager };
            if (string.IsNullOrWhiteSpace(owner))
                roles.Add(SystemRoles.Sales);
            await NotifyPartiesAsync("استفسار من المصنع", message, form, owner, roles.ToArray());
            return;
        }
        await NotifyPartiesAsync("استفسار من المبيعات", message, form, null, "factory", SystemRoles.ProductionManager);
    }

    private async Task NotifyPartiesAsync(string title, string message, string form, string? extraUser, params string[] roles)
    {
        var users = await Db.Users.AsNoTracking()
            .Where(u => u.IsActive != false && u.Username != null && u.Role != null)
            .Select(u => new { u.Username, u.Role })
            .ToListAsync();
        var sent = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        async Task SendAsync(string username)
        {
            if (string.IsNullOrWhiteSpace(username)) return;
            if (string.Equals(username, _userName, StringComparison.OrdinalIgnoreCase)) return;
            if (!sent.Add(username)) return;
            await NotificationService.AddAsync(title, message, username, _userName, form, "Parties", null);
        }
        if (!string.IsNullOrWhiteSpace(extraUser))
            await SendAsync(extraUser);
        foreach (var role in roles.Where(r => !string.IsNullOrWhiteSpace(r)))
        {
            var norm = role.Replace(" ", "").ToLowerInvariant();
            var matches = users.Where(u =>
            {
                var current = (u.Role ?? "").Replace(" ", "").ToLowerInvariant();
                return current == norm || string.Equals(u.Role, role, StringComparison.OrdinalIgnoreCase);
            }).Select(u => u.Username!).ToList();
            if (matches.Count == 0)
            {
                await NotificationService.NotifyRoleAsync(title, message, role, _userName, form, "Parties", null);
                continue;
            }
            foreach (var name in matches)
                await SendAsync(name);
        }
    }

    private async Task<string?> ResolveOwnerUsernameAsync(string? createdBy)
    {
        if (string.IsNullOrWhiteSpace(createdBy)) return null;
        var key = createdBy.Trim();
        var users = await Db.Users.AsNoTracking()
            .Where(u => u.IsActive != false && u.Username != null)
            .Select(u => new { u.Username, u.FullName })
            .ToListAsync();
        var byUser = users.FirstOrDefault(u => string.Equals(u.Username, key, StringComparison.OrdinalIgnoreCase));
        if (byUser != null) return byUser.Username;
        var byName = users.Where(u => string.Equals(u.FullName, key, StringComparison.OrdinalIgnoreCase)).Take(2).ToList();
        return byName.Count == 1 ? byName[0].Username : null;
    }

    private static string FormatInquiry(string target, string side, string text) => $"[على: {target}][جهة: {side}]\n{text}";

    private static (string Target, string Side, string Text) ParseInquiry(string? raw)
    {
        const string targetPrefix = "[على: ";
        const string sidePrefix = "[جهة: ";
        var text = (raw ?? "").Trim();
        var target = "المنتج كله";
        var side = "المصنع";
        if (text.StartsWith(targetPrefix, StringComparison.Ordinal))
        {
            var end = text.IndexOf(']');
            if (end > targetPrefix.Length)
            {
                var parsedTarget = text[targetPrefix.Length..end].Trim();
                if (!string.IsNullOrWhiteSpace(parsedTarget)) target = parsedTarget;
                text = text[(end + 1)..].Trim();
            }
        }
        if (text.StartsWith(sidePrefix, StringComparison.Ordinal))
        {
            var end = text.IndexOf(']');
            if (end > sidePrefix.Length)
            {
                var parsedSide = text[sidePrefix.Length..end].Trim();
                if (!string.IsNullOrWhiteSpace(parsedSide)) side = parsedSide;
                text = text[(end + 1)..].Trim();
            }
        }
        return (target, side, text);
    }

