    private bool SendsAsFactory(ProductCard? card)
    {
        if (_canAsk && !_canAnswer) return true;
        if (_canAnswer && !_canAsk) return false;
        var last = card?.Notes.LastOrDefault();
        return last == null || !last.FromFactory;
    }

