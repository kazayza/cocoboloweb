        3 => "تم التسعير",
        4 => "طلب تعديل سعر",
        5 => "السعر معتمد",
        6 => "السعر مرفوض",
        7 => "طلب تعديل سعر البيع",
        8 => "طلب تعديل التكلفة",
        _ => string.IsNullOrWhiteSpace(name) ? "غير محدد" : name.Trim() switch
        {
            "Priced" => "تم التسعير",
            "Draft" => "مسودة",
            "WaitingForPricing" => "انتظار التسعير",
            "PriceApproved" => "السعر معتمد",
            "PriceRejected" => "السعر مرفوض",
            "PriceChangeRequested" => "طلب تعديل سعر",
            "SalePriceChangeRequested" => "طلب تعديل سعر البيع",
