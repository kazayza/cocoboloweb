@code {
    [Parameter] public int InvoiceId { get; set; }
    [Parameter] public int PartyId { get; set; }

    private bool _loading = true;
    private bool _saving;
    private bool _authChecked;
    private bool _canView;
    private bool _canApprove;
    private bool _canOpenSaleInvoice;
    private bool _isAdmin;
    private bool _missing;
    private bool _needsScript;
    private bool _searchMode;
    private bool _showApprove;
    private int _seenParty = -1;
    private int _seenInvoice = -1;
    private string _userName = "System";
    private string _search = "";
    private string _invoiceNo = "";
    private string _partyName = "";
    private string? _partyPhone;

    private int _partyId;
    private int _previewDays;
    private string _changeNote = "";
    private DateTime _invoiceDate;
    private DateTime? _invoiceDueDate;
    private DateTime CalculatedDeliveryDate => DateTime.Today.AddDays(Math.Max(0, _previewDays));
    private ExecutionOrder? _order;
    private List<ExecutionOrderLine> _lines = new();
    private List<DisplayLine> _display = new();
    private List<CustomerRow> _customers = new();
    private List<InvoiceRow> _rows = new();

    private IEnumerable<CustomerRow> Matches => string.IsNullOrWhiteSpace(_search)
        ? _customers
        : _customers.Where(c => (c.Name ?? "").Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
            || (c.Phone ?? "").Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));

    private List<CustomerRow> FilteredCustomers => Matches.Take(48).ToList();
    private int HiddenMatches => Math.Max(0, Matches.Count() - FilteredCustomers.Count);
    private bool HasSpecialLineDates => _invoiceDueDate.HasValue && _display.Any(l => l.DeliveryDate.HasValue && l.DeliveryDate.Value.Date != _invoiceDueDate.Value.Date);

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
        _userName = user.Identity?.Name ?? "System";
        _isAdmin = user.IsInRole(SystemRoles.Admin) || user.IsInRole("Admin");
        var sales = _isAdmin || user.IsInRole(SystemRoles.Sales) || user.IsInRole(SystemRoles.SalesManager)
            || user.IsInRole(SystemRoles.AccountManager) || user.IsInRole(SystemRoles.GeneralManager);
        var factory = user.IsInRole("factory") || user.IsInRole(SystemRoles.FactoryManager);
        var production = user.IsInRole(SystemRoles.ProductionManager);
        var supplyViewer = factory || production;
        var jobOrders = user.HasClaim("Permission", "frm_JobOrders:View");
        _canApprove = sales;
        _canView = sales || factory || production || jobOrders;
        _canOpenSaleInvoice = !supplyViewer && (_isAdmin || user.HasClaim("Permission", "frm_PartiesInvoices:View"));
        _authChecked = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_authChecked || !_canView)
        {
            _loading = false;
            return;
        }
        if (PartyId == _seenParty && InvoiceId == _seenInvoice)
        {
            _loading = false;
            return;
        }
        _seenParty = PartyId;
        _seenInvoice = InvoiceId;
        _showApprove = false;
        _loading = true;
        await Task.Yield();
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        _searchMode = false;
        _missing = false;
        _needsScript = false;
        _order = null;
        _lines = new();
        _display = new();
        _rows = new();
        try
        {
            if (InvoiceId <= 0 && PartyId <= 0)
            {
                _searchMode = true;
                await LoadCustomersAsync();
                return;
            }
            if (InvoiceId <= 0)
            {
                await LoadCustomerAsync();
                return;
            }
            await LoadOrderAsync();
        }
        catch
        {
            _needsScript = true;
        }
    }

    private async Task LoadCustomersAsync()
    {
        if (_canApprove)
        {
            _customers = await (from invoice in Db.Transactions.AsNoTracking()
                                where invoice.TransactionType == TransactionTypes.Sale
                                    && invoice.InvoiceStatus != InvoiceStatuses.Cancelled
                                join party in Db.Parties.AsNoTracking() on invoice.PartyId equals party.PartyId
                                group invoice by new { party.PartyId, party.PartyName, party.Phone } into g
                                orderby g.Key.PartyName
                                select new CustomerRow { PartyId = g.Key.PartyId, Name = g.Key.PartyName, Phone = g.Key.Phone, Count = g.Count() })
                .ToListAsync();
            return;
        }
        _customers = await (from order in Db.ExecutionOrders.AsNoTracking()
                            join invoice in Db.Transactions.AsNoTracking() on order.TransactionId equals invoice.TransactionId
                            join party in Db.Parties.AsNoTracking() on invoice.PartyId equals party.PartyId
                            group order by new { party.PartyId, party.PartyName, party.Phone } into g
                            orderby g.Key.PartyName
                            select new CustomerRow { PartyId = g.Key.PartyId, Name = g.Key.PartyName, Phone = g.Key.Phone, Count = g.Count() })
            .ToListAsync();
    }

    private async Task LoadCustomerAsync()
    {
        var party = await Db.Parties.AsNoTracking().Where(p => p.PartyId == PartyId)
            .Select(p => new { p.PartyName, p.Phone }).FirstOrDefaultAsync();
        _partyName = party?.PartyName ?? "عميل";
        _partyPhone = party?.Phone;
        _partyId = PartyId;
        var invoices = await Db.Transactions.AsNoTracking()
            .Where(t => t.PartyId == PartyId && t.TransactionType == TransactionTypes.Sale && t.InvoiceStatus != InvoiceStatuses.Cancelled)
            .OrderByDescending(t => t.TransactionDate)
            .Select(t => new { t.TransactionId, t.ReferenceNumber, t.TransactionDate, t.DueDate })
            .ToListAsync();
        var ids = invoices.Select(i => i.TransactionId).ToList();
        var orders = new List<ExecutionOrder>();
        if (ids.Count > 0)
        {
            try
            {
                orders = await Db.ExecutionOrders.AsNoTracking().Where(o => ids.Contains(o.TransactionId)).ToListAsync();
            }
            catch
            {
                _needsScript = true;
            }
        }
        var detailIds = ids.Count == 0
            ? new List<int>()
            : await Db.TransactionDetails.AsNoTracking().Where(d => ids.Contains(d.TransactionId)).Select(d => d.TransactionId).ToListAsync();
        _rows = invoices.Select(i =>
        {
            var order = orders.FirstOrDefault(o => o.TransactionId == i.TransactionId);
            return new InvoiceRow
            {
                InvoiceId = i.TransactionId,
                Number = string.IsNullOrWhiteSpace(i.ReferenceNumber) ? i.TransactionId.ToString() : i.ReferenceNumber,
                InvoiceDate = i.TransactionDate,
                InvoiceDeliveryDate = i.DueDate,
                ItemCount = detailIds.Count(id => id == i.TransactionId),
                Approved = order != null,
                ApprovedAt = order?.CreatedAt,
                DueDate = order?.DueDate
            };
        }).Where(r => _canApprove || r.Approved).ToList();
    }

    private async Task LoadOrderAsync()
    {
        var invoice = await Db.Transactions.AsNoTracking().FirstOrDefaultAsync(t => t.TransactionId == InvoiceId);
        if (invoice == null || invoice.TransactionType != TransactionTypes.Sale || invoice.InvoiceStatus == InvoiceStatuses.Cancelled)
        {
            _missing = true;
            return;
        }
        _partyId = invoice.PartyId;
        _invoiceDate = invoice.TransactionDate;
        _invoiceDueDate = invoice.DueDate;
        _invoiceNo = string.IsNullOrWhiteSpace(invoice.ReferenceNumber) ? InvoiceId.ToString() : invoice.ReferenceNumber;
        var party = await Db.Parties.AsNoTracking().Where(p => p.PartyId == invoice.PartyId)
            .Select(p => new { p.PartyName, p.Phone }).FirstOrDefaultAsync();
        _partyName = party?.PartyName ?? "عميل";
        _partyPhone = party?.Phone;
        _display = await BuildInvoiceLinesAsync(invoice.DueDate);
        _previewDays = _display.Select(l => l.PeriodDays ?? 0).DefaultIfEmpty(0).Max();
        try
        {
            _order = await Db.ExecutionOrders.AsNoTracking().FirstOrDefaultAsync(o => o.TransactionId == InvoiceId);
            if (_order == null) return;
            _lines = await Db.ExecutionOrderLines.AsNoTracking().Where(l => l.ExecutionOrderId == _order.ExecutionOrderId).ToListAsync();
            ApplyFrozen();
        }
        catch
        {
            _needsScript = true;
        }
    }

    private async Task<List<DisplayLine>> BuildInvoiceLinesAsync(DateTime? invoiceDue)
    {
        var details = await Db.TransactionDetails.AsNoTracking().Where(d => d.TransactionId == InvoiceId).ToListAsync();
        var questions = await SpecService.GetStandardQuestionsAsync();
        var lines = new List<DisplayLine>();
        foreach (var detail in details)
        {
            var product = await Db.Products.AsNoTracking().FirstOrDefaultAsync(p => p.ProductId == detail.ProductId);
            var alt = detail.SelectedAlternativeId is int altId
                ? await Db.ProductFactoryAlternatives.AsNoTracking().FirstOrDefaultAsync(a => a.AlternativeId == altId)
                : null;
            var owner = alt == null ? SpecOwners.Product : SpecOwners.Alternative;
            var ownerId = alt?.AlternativeId ?? detail.ProductId;
            var parts = await Db.ProductComponents.AsNoTracking().Where(c => c.ProductId == detail.ProductId).ToListAsync();
            string? spec = null;
            try { spec = await SpecTextAsync(questions, owner, ownerId); } catch { spec = null; }
            lines.Add(new DisplayLine
            {
                ProductId = detail.ProductId,
                ProductName = product?.ProductName ?? $"منتج {detail.ProductId}",
                Quantity = detail.Quantity,
                AlternativeId = alt?.AlternativeId,
                AlternativeName = alt?.AlternativeName,
                PeriodDays = alt?.Period ?? product?.Period,
                SpecText = spec,
                ComponentText = parts.Count == 0 ? null : string.Join("، ", parts.Select(p => $"{p.ComponentName} × {p.Quantity:0.##}")),
                ImageUrl = await ImageUrlAsync(detail.ProductId, alt?.AlternativeId),
                DeliveryDate = DeliveryScheduleResolver.EffectiveDate(detail.DeliveryDate, detail.DeliveryDateIsCustom, invoiceDue)
            });
        }
        return lines;
    }

    private async Task<string?> ImageUrlAsync(int productId, int? alternativeId)
    {
        if (alternativeId is int altId)
        {
            var altImage = await Db.ProductFactoryAlternativeImages.AsNoTracking()
                .Where(i => i.AlternativeId == altId && i.ImagePath != "")
                .OrderByDescending(i => i.IsPrimary)
                .Select(i => i.ImagePath)
                .FirstOrDefaultAsync();
            if (!string.IsNullOrWhiteSpace(altImage)) return altImage;
        }
        var photo = await Db.ProductImages.AsNoTracking()
            .Where(i => i.ProductId == productId)
            .OrderByDescending(i => i.IsPrimary)
            .ThenBy(i => i.ProductImagesId)
            .Select(i => new { i.ProductImagesId, i.ImagePath })
            .FirstOrDefaultAsync();
        if (photo == null) return null;
        return photo.ProductImagesId > 0 ? $"/api/product-image-by-id/{photo.ProductImagesId}" : photo.ImagePath;
    }

    private void ApplyFrozen()
    {
        var pool = _lines.ToList();
        foreach (var line in _display)
        {
            var match = pool.FirstOrDefault(f => f.ProductId == line.ProductId && f.AlternativeId == line.AlternativeId)
                ?? pool.FirstOrDefault(f => f.ProductId == line.ProductId);
            if (match == null) continue;
            pool.Remove(match);
            line.Frozen = true;
            if (!string.IsNullOrWhiteSpace(match.SpecSnapshot)) line.SpecText = match.SpecSnapshot;
            if (!string.IsNullOrWhiteSpace(match.ComponentSnapshot)) line.ComponentText = match.ComponentSnapshot;
            if (!string.IsNullOrWhiteSpace(match.AlternativeName)) line.AlternativeName = match.AlternativeName;
            if (match.PeriodDays is > 0) line.PeriodDays = match.PeriodDays;
        }
    }

    private void OpenApprove() => _showApprove = true;

    private void CloseApprove() => _showApprove = false;

    private async Task ConfirmApprove()
    {
        if (_saving || _order != null) return;
        _showApprove = false;
        await ApproveOrder(DateTime.Today);
    }

    private async Task ApproveOrder(DateTime approvalDate)
    {
        if (!_canApprove || _saving || _order != null) return;
        _saving = true;
        var committed = false;
        try
        {
            var details = await Db.TransactionDetails.AsNoTracking().Where(d => d.TransactionId == InvoiceId).ToListAsync();
            if (details.Count == 0)
            {
                Snackbar.Add("لا يمكن الاعتماد. الفاتورة لا تحتوي على منتجات.", Severity.Warning);
                return;
            }
            var questions = await SpecService.GetStandardQuestionsAsync();
            var lines = new List<ExecutionOrderLine>();
            foreach (var detail in details)
            {
                var product = await Db.Products.AsNoTracking().FirstOrDefaultAsync(p => p.ProductId == detail.ProductId);
                var alt = detail.SelectedAlternativeId is int altId
                    ? await Db.ProductFactoryAlternatives.AsNoTracking().FirstOrDefaultAsync(a => a.AlternativeId == altId)
                    : null;
                var owner = alt == null ? SpecOwners.Product : SpecOwners.Alternative;
                var ownerId = alt?.AlternativeId ?? detail.ProductId;
                var parts = await Db.ProductComponents.AsNoTracking().Where(c => c.ProductId == detail.ProductId).ToListAsync();
                lines.Add(new ExecutionOrderLine
                {
                    ProductId = detail.ProductId,
                    ProductName = product?.ProductName ?? $"منتج {detail.ProductId}",
                    AlternativeId = alt?.AlternativeId,
                    AlternativeName = alt?.AlternativeName,
                    Quantity = detail.Quantity,
                    PeriodDays = alt?.Period ?? product?.Period,
                    SpecSnapshot = await SpecTextAsync(questions, owner, ownerId),
                    ComponentSnapshot = parts.Count == 0 ? null : string.Join("، ", parts.Select(p => $"{p.ComponentName} × {p.Quantity:0.##}"))
                });
            }
            var days = lines.Select(l => l.PeriodDays ?? 0).DefaultIfEmpty(0).Max();
            var due = approvalDate.Date.AddDays(Math.Max(0, days));
            var delivered = await LoadDeliveredQtyAsync();
            await using var tx = await Db.Database.BeginTransactionAsync();
            var order = new ExecutionOrder
            {
                TransactionId = InvoiceId,
                Status = "Approved",
                CreatedBy = _userName,
                CreatedAt = DateTime.Now,
                PeriodDays = days,
                DueDate = due
            };
            Db.ExecutionOrders.Add(order);
            await Db.SaveChangesAsync();
            foreach (var line in lines)
            {
                line.ExecutionOrderId = order.ExecutionOrderId;
                Db.ExecutionOrderLines.Add(line);
            }
            var shiftNote = await SyncInvoiceDeliveryAsync(due, days, delivered);
            await Db.SaveChangesAsync();
            await tx.CommitAsync();
            committed = true;
            await AuditService.LogAsync("Transactions", "ExecutionApprovalDate", InvoiceId.ToString(), _deliveryAuditOld, _deliveryAuditNew, _userName);
            var form = $"sales/invoices/{InvoiceId}/execution";
            var message = $"{_invoiceNo}: تم اعتماد أمر التنفيذ. تاريخ التسليم {order.DueDate:yyyy/MM/dd}، وهو نفسه على الفاتورة.";
            await NotificationService.NotifyRoleAsync("اعتماد أمر التنفيذ", message, "factory", _userName, form, "Transactions", InvoiceId);
            await NotificationService.NotifyRoleAsync("اعتماد أمر التنفيذ", message, SystemRoles.ProductionManager, _userName, form, "Transactions", InvoiceId);
            Snackbar.Add($"تم الاعتماد. تاريخ التسليم {order.DueDate:yyyy/MM/dd} على الأمر والفاتورة.{shiftNote}", Severity.Success);
            await LoadOrderAsync();
        }
        catch
        {
            if (committed)
                Snackbar.Add("تم حفظ الاعتماد، وتعذر إكمال الإشعار.", Severity.Warning);
            else
            {
                _needsScript = true;
                Snackbar.Add("تعذر حفظ الاعتماد. يرجى تشغيل سكربت ExecutionOrder.sql مرة واحدة ثم إعادة المحاولة.", Severity.Error);
            }
        }
        finally { _saving = false; }
    }

    private object? _deliveryAuditOld;
    private object? _deliveryAuditNew;

    private async Task<Dictionary<int, decimal>?> LoadDeliveredQtyAsync()
    {
        try
        {
            return await (from item in Db.InvoiceDeliveryItems.AsNoTracking()
                          join delivery in Db.InvoiceDeliveries.AsNoTracking() on item.DeliveryId equals delivery.DeliveryId
                          where delivery.TransactionId == InvoiceId && !delivery.IsVoided
                          group item by item.TransactionDetailId into g
                          select new { DetailId = g.Key, Total = g.Sum(x => x.AcceptedQty) })
                .ToDictionaryAsync(x => x.DetailId, x => x.Total);
        }
        catch
        {
            return null;
        }
    }

    private async Task<string> SyncInvoiceDeliveryAsync(DateTime newDue, int days, Dictionary<int, decimal>? delivered)
    {
        var invoice = await Db.Transactions.FirstOrDefaultAsync(t => t.TransactionId == InvoiceId);
        var oldDue = invoice?.DueDate?.Date;
        var shifts = new List<object>();
        var note = "";
        if (invoice != null && oldDue.HasValue && oldDue.Value != newDue.Date)
        {
            var delta = (newDue.Date - oldDue.Value).Days;
            var custom = await Db.TransactionDetails.Where(d => d.TransactionId == InvoiceId && d.DeliveryDateIsCustom && d.DeliveryDate != null).ToListAsync();
            if (custom.Count > 0 && delta != 0)
            {
                if (delivered == null)
                    note = " دفعات التاريخ الخاص لم تُزَح لأن سجل التسليم غير متاح.";
                else
                {
                    var moved = 0;
                    var kept = 0;
                    foreach (var detail in custom)
                    {
                        var done = delivered.TryGetValue(detail.DetailId, out var qty) && qty + 0.0005m >= detail.Quantity;
                        if (done)
                        {
                            kept++;
                            continue;
                        }
                        var before = detail.DeliveryDate!.Value.Date;
                        detail.DeliveryDate = before.AddDays(delta);
                        shifts.Add(new { detail.DetailId, Before = before, After = detail.DeliveryDate });
                        moved++;
                    }
                    if (moved > 0) note += $" زُحزحت {moved} دفعة.";
                    if (kept > 0) note += $" بقيت {kept} دفعة مسلّمة كما هي.";
                }
            }
        }
        if (invoice != null && oldDue != newDue.Date)
        {
            invoice.DueDate = newDue.Date;
            invoice.EditBy = _userName;
            invoice.EditAt = DateTime.Now;
        }
        _deliveryAuditOld = new { DueDate = oldDue, Reason = "قبل اعتماد أمر التنفيذ" };
        _deliveryAuditNew = new { DueDate = newDue.Date, Reason = $"اعتماد أمر التنفيذ. تاريخ الاعتماد زائد {days} يوم.", Lines = shifts };
        return note;
    }

    private async Task<string?> SpecTextAsync(List<SpecQuestionDto> questions, string owner, int ownerId)
    {
        var answers = await SpecService.GetAnswersAsync(owner, ownerId);
        var lines = new List<string>();
        foreach (var question in questions)
        {
            var answer = answers.FirstOrDefault(a => a.QuestionId == question.QuestionId);
            if (answer == null) continue;
            var value = question.DataType == SpecDataTypes.Number
                ? answer.NumberValue.HasValue ? $"{answer.NumberValue:0.##} {question.UnitName}".Trim() : null
                : !string.IsNullOrWhiteSpace(answer.TextValue) ? answer.TextValue : question.Options.FirstOrDefault(o => o.OptionId == answer.OptionId)?.OptionNameAr;
            if (!string.IsNullOrWhiteSpace(value))
                lines.Add($"{question.QuestionNameAr}: {value}");
        }
        return lines.Count == 0 ? null : string.Join(" | ", lines);
    }

    private async Task RequestChange()
    {
        if (!_isAdmin || _order == null || string.IsNullOrWhiteSpace(_changeNote)) return;
        _saving = true;
        try
        {
            var order = await Db.ExecutionOrders.FirstOrDefaultAsync(o => o.ExecutionOrderId == _order.ExecutionOrderId);
            if (order == null) return;
            order.Status = "ChangeRequested";
            order.ChangeNote = _changeNote.Trim();
            order.ChangeRequestedBy = _userName;
            order.ChangeRequestedAt = DateTime.Now;
            await Db.SaveChangesAsync();
            Snackbar.Add("تم إرسال طلب التعديل.", Severity.Success);
            await LoadOrderAsync();
        }
        finally { _saving = false; }
    }

    private static string Initial(string? name)
    {
        var text = (name ?? "").Trim();
        return text.Length == 0 ? "ع" : text[..1];
    }

    private void OpenCustomer(int id)
    {
        if (id <= 0) return;
        _loading = true;
        Navigation.NavigateTo($"/customers/{id}/execution");
    }

    private void OpenInvoiceOrder(int id)
    {
        if (id <= 0) return;
        _loading = true;
        Navigation.NavigateTo($"/sales/invoices/{id}/execution");
    }

    private void GoSearch()
    {
        _loading = true;
        Navigation.NavigateTo("/execution");
    }

    private void GoCustomer()
    {
        _loading = true;
        Navigation.NavigateTo(_partyId > 0 ? $"/customers/{_partyId}/execution" : "/execution");
    }

    private Task OpenInvoice() => JS.InvokeVoidAsync("open", $"/sales/invoices/{InvoiceId}", "_blank").AsTask();

    private Task OpenJobSpec(int productId)
    {
        var url = _partyId > 0
            ? productId > 0 ? $"/customers/{_partyId}/job-spec?product={productId}" : $"/customers/{_partyId}/job-spec"
            : $"/products/{productId}/job-spec";
        return JS.InvokeVoidAsync("open", url, "_blank").AsTask();
    }

    private sealed class CustomerRow
    {
        public int PartyId { get; set; }
        public string? Name { get; set; }
        public string? Phone { get; set; }
        public int Count { get; set; }
    }

    private sealed class InvoiceRow
    {
        public int InvoiceId { get; set; }
        public string Number { get; set; } = "";
