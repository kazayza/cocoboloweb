@page "/execution"
@page "/customers/{PartyId:int}/execution"
@page "/sales/invoices/{InvoiceId:int}/execution"
@attribute [Authorize]

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Models
@using COCOBOLOERPNEW.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims

@inject db24804Context Db
@inject ISpecService SpecService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject NotificationService NotificationService
@inject IAuditService AuditService
@inject IJSRuntime JS

<PageTitle>أمر التنفيذ</PageTitle>

@if (_loading)
{
    <div class="ex-loading"><MudProgressCircular Indeterminate="true" Size="Size.Large" /> <p>جارٍ فتح أمر التنفيذ...</p></div>
}
else if (!_canView)
{
    <MudAlert Severity="Severity.Error">ليس لديك صلاحية عرض أمر التنفيذ.</MudAlert>
}
else if (_searchMode)
{
    <div class="ex-page" dir="rtl">
        <header class="ex-head">
            <div class="ex-id">
                <span class="ex-mark"><MudIcon Icon="@Icons.Material.Filled.Search" /></span>
                <div>
                    <div class="ex-title-line">
                        <h1>أمر التنفيذ</h1>
                        <span class="ex-badge">بحث العملاء</span>
                    </div>
                    <p>ابحث بالاسم أو الهاتف، ثم اختر العميل.</p>
                </div>
            </div>
            <div class="ex-head-stat">
                <strong>@_customers.Count</strong>
                <span>عميل</span>
            </div>
        </header>
        <section class="ex-board">
            <div class="ex-search-wrap">
                <MudIcon Icon="@Icons.Material.Filled.Search" />
                <input class="ex-search" @bind="_search" @bind:event="oninput" placeholder="اسم العميل أو رقم الهاتف" />
            </div>
            <p class="ex-meta">@FilteredCustomers.Count نتيجة ظاهرة@(HiddenMatches > 0 ? $"، و{HiddenMatches} أخرى. يُرجى تضييق البحث." : "")</p>
            @if (FilteredCustomers.Count == 0)
            {
                <div class="ex-empty">
                    <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Style="font-size:2.4rem;color:#94a3b8" />
                    <p>لا توجد نتائج مطابقة.</p>
                </div>
            }
            else
            {
                <div class="ex-picks">
                    @foreach (var customer in FilteredCustomers)
                    {
                        <button type="button" class="ex-pick" @onclick="() => OpenCustomer(customer.PartyId)">
                            <span class="ex-avatar">@Initial(customer.Name)</span>
                            <span class="ex-pick-body">
                                <strong>@customer.Name</strong>
                                <span>@(string.IsNullOrWhiteSpace(customer.Phone) ? "بدون رقم هاتف" : customer.Phone)</span>
                            </span>
                            <span class="ex-count">@customer.Count @(_canApprove ? "فاتورة" : "أمر")</span>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" />
                        </button>
                    }
                </div>
            }
        </section>
    </div>
}
else if (PartyId > 0 && InvoiceId == 0)
{
    <div class="ex-page" dir="rtl">
        <header class="ex-head">
            <div class="ex-id">
                <span class="ex-mark"><MudIcon Icon="@Icons.Material.Filled.Person" /></span>
                <div>
                    <div class="ex-title-line">
                        <h1>@_partyName</h1>
                        <span class="ex-badge">ملف العميل</span>
                    </div>
                    <p>@(string.IsNullOrWhiteSpace(_partyPhone) ? "فواتير البيع وأوامر التنفيذ" : _partyPhone)</p>
                </div>
            </div>
            <div class="ex-actions">
                @if (_partyId > 0)
                {
                    <button type="button" class="ex-back" @onclick="() => OpenJobSpec(0)"><MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" /> ملف الجوب أوردر</button>
                }
                <button type="button" class="ex-back" @onclick="GoSearch"><MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /> البحث</button>
            </div>
        </header>
        @if (_needsScript)
        {
            <MudAlert Severity="Severity.Warning">يلزم تشغيل سكربت ExecutionOrder.sql مرة واحدة. يمكن الاطلاع على الفواتير، ولن يُحفظ الاعتماد قبل تشغيله.</MudAlert>
        }
        @if (_rows.Count == 0)
        {
            <section class="ex-board ex-empty">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Style="font-size:2.4rem;color:#94a3b8" />
                <p>@(_canApprove ? "لا توجد فواتير بيع غير ملغاة لهذا العميل." : "لا يوجد أمر تنفيذ معتمد لهذا العميل.")</p>
            </section>
        }
        else
        {
            <section class="ex-board">
                <div class="ex-table-head">
                    <span>الفاتورة</span>
                    <span>التاريخ</span>
                    <span>الحالة</span>
                    <span></span>
                </div>
                @foreach (var row in _rows)
                {
                    <article class="ex-invoice">
                        <div>
                            <strong>@row.Number</strong>
                            <span>@row.ItemCount منتج</span>
                        </div>
                        <div>
                            <span>تاريخ الفاتورة</span>
                            <strong>@row.InvoiceDate.ToString("yyyy/MM/dd")</strong>
                            <span>تاريخ التسليم: @(row.InvoiceDeliveryDate?.ToString("yyyy/MM/dd") ?? "غير مسجّل")</span>
                        </div>
                        <div>
                            @if (row.Approved)
                            {
                                <span class="ex-chip ok">معتمد</span>
                                <span>تاريخ التنفيذ @row.DueDate?.ToString("yyyy/MM/dd")</span>
                            }
                            else
                            {
                                <span class="ex-chip wait">بانتظار اعتماد التاريخ</span>
                                <span>المنتجات متاحة للاطلاع</span>
                            }
                        </div>
                        <button type="button" class="ex-gold" @onclick="() => OpenInvoiceOrder(row.InvoiceId)">عرض أمر التنفيذ</button>
                    </article>
                }
            </section>
        }
    </div>
}
else if (_missing)
{
    <MudAlert Severity="Severity.Warning">الفاتورة غير موجودة، أو ليست فاتورة بيع.</MudAlert>
}
else
{
    <div class="ex-page" dir="rtl">
        <header class="ex-head">
            <div class="ex-id">
                <span class="ex-mark"><MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" /></span>
                <div>
                    <div class="ex-title-line">
                        <h1>أمر التنفيذ — @_invoiceNo</h1>
                        <span class="ex-badge @(_order == null ? "wait" : "ok")">@(_order == null ? "بانتظار الاعتماد" : "أمر معتمد")</span>
                    </div>
                    <p>@_partyName@(string.IsNullOrWhiteSpace(_partyPhone) ? "" : $" — {_partyPhone}")</p>
                </div>
            </div>
            <div class="ex-actions">
                @if (_canApprove && _order == null)
                {
                    <button type="button" class="ex-gold" title="اعتماد أمر التنفيذ" disabled="@_saving" @onclick="OpenApprove"><MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Small" /> اعتماد</button>
                }
                @if (_partyId > 0)
                {
                    <button type="button" class="ex-back" title="ملف الجوب أوردر" @onclick="() => OpenJobSpec(0)"><MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" /> الجوب أوردر</button>
                }
                @if (_canOpenSaleInvoice)
                {
                    <button type="button" class="ex-back" title="عرض الفاتورة" @onclick="OpenInvoice"><MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" /> الفاتورة</button>
                }
                <button type="button" class="ex-back" title="العودة إلى ملف العميل" @onclick="GoCustomer"><MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /> العميل</button>
            </div>
        </header>

        @if (_needsScript)
        {
            <MudAlert Severity="Severity.Warning">يلزم تشغيل سكربت ExecutionOrder.sql مرة واحدة قبل حفظ الاعتماد.</MudAlert>
        }

        <div class="ex-metrics">
            <article><span>تاريخ الفاتورة</span><strong>@_invoiceDate.ToString("yyyy/MM/dd")</strong></article>
            <article><span>تاريخ التسليم في الفاتورة</span><strong>@(_invoiceDueDate?.ToString("yyyy/MM/dd") ?? "غير مسجّل")</strong></article>
            <article><span>عدد المنتجات</span><strong>@_display.Count</strong></article>
            @if (_order == null)
            {
                <article><span>أطول مدة تصنيع</span><strong>@_previewDays يوم</strong><small>عند الاعتماد: تاريخ الاعتماد + هذه المدة، ويُكتب على الفاتورة والأمر.</small></article>
            }
            else
            {
                <article><span>تاريخ الاعتماد</span><strong>@_order.CreatedAt.ToString("yyyy/MM/dd HH:mm")</strong><small>سجّله @_order.CreatedBy</small></article>
                <article><span>تاريخ التنفيذ المعتمد</span><strong>@_order.DueDate.ToString("yyyy/MM/dd")</strong></article>
            }
        </div>

        @if (_order != null && (!string.IsNullOrWhiteSpace(_order.ChangeNote) || (_isAdmin && _order.Status != "ChangeRequested")))
        {
            <section class="ex-board">
                @if (!string.IsNullOrWhiteSpace(_order.ChangeNote))
                {
                    <p class="ex-note">طلب تعديل: @_order.ChangeNote</p>
                }
                @if (_isAdmin && _order.Status != "ChangeRequested")
                {
                    <textarea class="ex-note-box" rows="3" @bind="_changeNote" placeholder="سبب طلب التعديل"></textarea>
                    <button type="button" class="ex-gold" disabled="@_saving" @onclick="RequestChange"><MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" /> إرسال طلب التعديل</button>
                }
            </section>
        }

        <section class="ex-board">
                <div class="ex-board-top">
                    <h2>@(_order == null ? "منتجات الفاتورة" : "مواصفات التنفيذ المعتمدة")</h2>
                    <p class="ex-lead">@(_order == null ? "الاطلاع لا يحتاج اعتمادًا. الاعتماد يثبت التاريخ والمواصفات ويشعر المصنع. خطة الإنتاج شاشة مستقلة." : "المواصفات مثبتة عند الاعتماد. الجوب أوردر يفتح الملف الكامل.")</p>
                </div>
                @if (_display.Count == 0)
                {
                    <p>لا توجد منتجات في هذه الفاتورة.</p>
                }
                @foreach (var line in _display)
                {
                    <article class="ex-line">
                        @if (!string.IsNullOrWhiteSpace(line.ImageUrl))
                        {
                            <img class="ex-photo" src="@line.ImageUrl" alt="@line.ProductName" />
                        }
                        else
                        {
                            <span class="ex-photo empty">لا توجد صورة</span>
                        }
                        <div class="ex-line-body">
                            <strong>@line.ProductName</strong>
                            <span>الكمية @line.Quantity.ToString("0.##") — @(string.IsNullOrWhiteSpace(line.AlternativeName) ? "المنتج الأصلي" : line.AlternativeName)</span>
                            <span>
                                @if (line.PeriodDays is > 0)
                                {
                                    <text>مدة التصنيع: @line.PeriodDays يوم. </text>
                                }
                                تاريخ التسليم: @(line.DeliveryDate?.ToString("yyyy/MM/dd") ?? "يتبع تاريخ الفاتورة")
                            </span>
                            @if (line.Frozen)
                            {
                                <span class="ex-chip ok">مثبتة عند الاعتماد</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(line.SpecText))
                            {
                                <p>@line.SpecText</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(line.ComponentText))
                            {
                                <p>المكونات: @line.ComponentText</p>
                            }
                        </div>
                        <button type="button" class="ex-gold ex-line-btn" @onclick="() => OpenJobSpec(line.ProductId)"><MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" /> الجوب أوردر</button>
                    </article>
                }
        </section>
    </div>
}

@if (_showApprove)
{
    <div class="ex-modal" dir="rtl">
        <button type="button" class="ex-modal-back" @onclick="CloseApprove"></button>
        <section class="ex-modal-card">
            <span class="ex-badge">تأكيد الاعتماد</span>
            <h2>اعتماد أمر التنفيذ</h2>
            <p>سيتم اعتماد أمر التنفيذ، وتثبيت المواصفات، وتحديث تاريخ التسليم تلقائيًا، وإشعار المصنع ومدير الإنتاج.</p>
            <div class="ex-alert">تاريخ التسليم بعد الاعتماد: <strong>@CalculatedDeliveryDate.ToString("yyyy/MM/dd")</strong>. يحسب من تاريخ الاعتماد زائد @_previewDays يوم، ويُكتب نفسه على الفاتورة وأمر التنفيذ. التاريخ القديم يبقى في سجل الفاتورة.</div>
            @if (HasSpecialLineDates)
            {
                <p>دفعات لها تاريخ خاص ستتزحل بنفس عدد أيام الفرق. الدفعة التي سُلّمت كاملة لا تتحرك، وسجل التسليم المنفّذ لا يُعاد كتابته.</p>
            }
            <p class="ex-meta">تاريخ البيع لا يتغير. أي تعديل بعد الاعتماد يتم من طلب مواعيد التسليم، لا من هذه الشاشة.</p>
            <div class="ex-modal-actions">
                <button type="button" class="ex-gold" disabled="@_saving" @onclick="ConfirmApprove">تأكيد الاعتماد</button>
                <button type="button" class="ex-cancel" @onclick="CloseApprove">إلغاء</button>
            </div>
        </section>
    </div>
}

<style>
    .ex-loading { min-height: 70vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .8rem; font-size: 1.05rem; }
    .ex-page { width: 100%; color: #1a2842; display: flex; flex-direction: column; gap: .7rem; }
    .ex-head { display: flex; justify-content: space-between; gap: .75rem; align-items: center; background: linear-gradient(135deg, #1a2842 0%, #2a3f6a 58%, #1a2842 100%); color: #fff; border-radius: 16px; padding: .62rem .8rem; box-shadow: 0 8px 22px rgba(26,40,66,.16); }
    .ex-id { display: flex; align-items: center; gap: .7rem; min-width: 0; }
    .ex-mark { width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; flex: 0 0 auto; color: #1a2842; background: linear-gradient(135deg, #ffe9a3, #d4af37); box-shadow: 0 0 14px rgba(212,175,55,.5); }
    .ex-title-line { display: flex; align-items: center; gap: .45rem; flex-wrap: wrap; }
    .ex-head h1 { margin: 0; font-size: 1.12rem; font-weight: 800; line-height: 1.3; }
    .ex-head p { margin: .12rem 0 0; color: rgba(255,255,255,.72); font-size: .8rem; line-height: 1.4; }
    .ex-badge { display: inline-flex; background: rgba(212,175,55,.18); color: #f6e7b4; border: 1px solid rgba(212,175,55,.35); border-radius: 999px; padding: .12rem .55rem; font-weight: 800; font-size: .72rem; }
    .ex-head .ex-badge.ok { background: rgba(34,197,94,.16); color: #bbf7d0; border-color: rgba(34,197,94,.35); }
    .ex-head .ex-badge.wait { background: rgba(212,175,55,.2); color: #f6e7b4; }
    .ex-head-stat { min-width: 64px; text-align: center; background: rgba(255,255,255,.08); border: 1px solid rgba(212,175,55,.28); border-radius: 12px; padding: .35rem .55rem; box-shadow: 0 0 12px rgba(212,175,55,.16); }
    .ex-head-stat strong { display: block; font-size: 1.15rem; color: #f6e7b4; }
    .ex-head-stat span { color: #cbd5e1; font-size: .72rem; }
    .ex-actions { display: flex; flex-direction: row; flex-wrap: wrap; gap: .4rem; align-items: center; justify-content: flex-end; min-width: 0; }
    .ex-back, .ex-cancel, .ex-gold { display: inline-flex; align-items: center; justify-content: center; gap: .32rem; border-radius: 999px; min-height: 34px; padding: .32rem .78rem; font-weight: 800; cursor: pointer; font-size: .82rem; white-space: nowrap; }
    .ex-back { border: 1px solid rgba(212,175,55,.5); background: rgba(255,255,255,.07); color: #fff; box-shadow: inset 0 0 10px rgba(212,175,55,.12), 0 0 10px rgba(212,175,55,.16); transition: box-shadow .2s ease, background .2s ease, transform .2s ease; }
    .ex-back:hover { background: rgba(212,175,55,.16); box-shadow: 0 0 16px rgba(212,175,55,.42); transform: translateY(-1px); }
    .ex-cancel { border: 1px solid #cbd5e1; background: #fff; color: #0f172a; }
    .ex-board { background: #fff; border: 1px solid #e7e1d1; border-radius: 16px; padding: .85rem .95rem; box-shadow: 0 8px 20px rgba(26,40,66,.04); }
    .ex-board-top { display: flex; justify-content: space-between; align-items: baseline; gap: .8rem; margin-bottom: .35rem; }
    .ex-board h2 { margin: 0; font-size: 1.05rem; }
    .ex-lead { margin: 0; font-size: .8rem; line-height: 1.45; }
    .ex-search-wrap { display: flex; align-items: center; gap: .55rem; border: 1px solid #cbd5e1; border-radius: 16px; padding: .35rem .9rem; background: #f8fafc; min-height: 62px; }
    .ex-search { width: 100%; border: 0; background: transparent; font: inherit; font-size: 1.08rem; outline: none; padding: .7rem .2rem; }
    .ex-meta, .ex-board p, .ex-pick-body span, .ex-invoice span, .ex-line span, .ex-metrics span, .ex-metrics small { color: #64748b; }
    .ex-board p, .ex-line p { line-height: 1.75; }
    .ex-meta { margin: .75rem 0 0; }
    .ex-picks { display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: .8rem; margin-top: .9rem; }
    .ex-pick { width: 100%; min-height: 92px; display: flex; align-items: center; gap: .85rem; text-align: right; background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 1rem 1.05rem; cursor: pointer; color: #0f172a; font: inherit; }
    .ex-pick:hover { border-color: #d4af37; background: #fffdf8; box-shadow: 0 12px 26px rgba(15,23,42,.08); }
    .ex-avatar { width: 54px; height: 54px; border-radius: 16px; background: #0f172a; color: #f6e7b4; display: grid; place-items: center; font-weight: 800; font-size: 1.25rem; flex: 0 0 auto; }
    .ex-pick-body { flex: 1; min-width: 0; }
    .ex-pick-body strong, .ex-pick-body span { display: block; }
    .ex-pick-body strong, .ex-invoice strong, .ex-line strong { font-size: 1.05rem; }
    .ex-count, .ex-chip { border-radius: 999px; padding: .28rem .7rem; font-size: .8rem; font-weight: 800; white-space: nowrap; }
    .ex-count { background: #f8fafc; border: 1px solid #e2e8f0; color: #334155; }
    .ex-chip { display: inline-flex; width: fit-content; background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a; }
    .ex-chip.ok { background: #e8f6ee; color: #166534; border-color: #bbf7d0; }
    .ex-chip.wait { background: #fff8e8; color: #92400e; border-color: #fde68a; }
    .ex-empty { min-height: 220px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .45rem; text-align: center; }
    .ex-table-head, .ex-invoice { display: grid; grid-template-columns: 1.2fr 1.3fr 1.3fr auto; gap: 1rem; align-items: center; }
    .ex-table-head { color: #64748b; font-size: .82rem; font-weight: 800; padding: .2rem .4rem .7rem; }
    .ex-invoice { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 16px; min-height: 96px; padding: 1rem 1.05rem; margin-bottom: .7rem; }
    .ex-invoice strong, .ex-line strong { display: block; }
    .ex-invoice div, .ex-line-body { display: flex; flex-direction: column; gap: .25rem; align-items: flex-start; }
    .ex-metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .45rem; }
    .ex-metrics article { background: #fff; border: 1px solid #e7e1d1; border-right: 3px solid #d4af37; border-radius: 12px; padding: .5rem .7rem; }
    .ex-metrics strong { display: block; margin-top: .12rem; font-size: .98rem; color: #1a2842; }
    .ex-metrics small { display: block; margin-top: .1rem; font-size: .72rem; }
    .ex-split { display: grid; grid-template-columns: 1.55fr .8fr; gap: 1rem; align-items: start; }
    .ex-line { display: flex; align-items: center; gap: .75rem; border: 1px solid #e7e1d1; border-radius: 14px; padding: .65rem; margin-top: .5rem; background: #fff; }
    .ex-line-body { flex: 1; min-width: 0; }
    .ex-line p { margin: .15rem 0 0; }
    .ex-photo { width: 92px; height: 76px; object-fit: cover; border-radius: 12px; border: 1px solid #e7e1d1; flex: 0 0 auto; background: #f8fafc; }
    .ex-photo.empty { display: grid; place-items: center; color: #94a3b8; font-size: .78rem; font-weight: 800; text-align: center; padding: .4rem; }
    .ex-stages { list-style: none; margin: .4rem 0 .8rem; padding: 0; display: flex; flex-direction: column; gap: .55rem; }
    .ex-stages li { display: flex; justify-content: space-between; align-items: center; gap: .6rem; min-height: 58px; padding: .75rem .85rem; border: 1px solid #e2e8f0; border-radius: 14px; background: #f8fafc; }
    .ex-stages li.current { background: #fffdf6; border-color: #d4af37; }
    .ex-stages strong, .ex-stages span { display: block; }
    .ex-gold { position: relative; overflow: hidden; border: 0; color: #1a2842; background: linear-gradient(180deg, #ffe9a3 0%, #f0d060 40%, #d4af37 100%); box-shadow: 0 0 0 1px rgba(255,244,196,.75), 0 0 16px rgba(212,175,55,.55), 0 5px 12px rgba(184,146,42,.25); transition: transform .2s ease, box-shadow .2s ease; }
    .ex-gold::after { content: ""; position: absolute; top: 0; bottom: 0; width: 38%; left: -55%; background: linear-gradient(90deg, transparent, rgba(255,255,255,.62), transparent); animation: ex-shine 2.8s ease-in-out infinite; pointer-events: none; }
