@page "/sales/invoices/{InvoiceId:int}/job-order/print"
@layout COCOBOLOERPNEW.Components.Layout.EmptyLayout
@attribute [Authorize]

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore

@inject db24804Context Db
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (_isLoading)
{
    <div class="loading-container">
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
    </div>
}
else if (!_canView || _invoice == null)
{
    <div class="not-found"><h2>الملف غير متاح</h2></div>
}
else
{
    <div class="print-actions no-print">
        <button class="btn-action btn-print" @onclick="PrintNow">🖨️ طباعة</button>
        <button class="btn-action btn-back" @onclick="GoBack">← رجوع</button>
    </div>

    <div class="print-page">
        <div class="content" dir="rtl">
            <div class="invoice-top-meta">
                <div class="meta-type">أمر تشغيل الفاتورة</div>
                <div class="meta-number">@_invoice.ReferenceNumber</div>
                <div class="meta-date">@_invoice.TransactionDate.ToString("yyyy/MM/dd")</div>
            </div>

            <div class="party-grid">
                <div class="party-box">
                    <h3>بيانات العميل</h3>
                    <div class="party-line"><strong>الاسم:</strong> @_invoice.PartyName</div>
                    <div class="party-line"><strong>الموظف:</strong> @(_invoice.EmpName ?? "-")</div>
                    <div class="party-line"><strong>تاريخ التنفيذ المتوقع:</strong> @(_invoice.DueDate?.ToString("yyyy/MM/dd") ?? "-")</div>
                </div>

                <div class="party-box">
                    <h3>بيانات الملف</h3>
                    <div class="party-line"><strong>عدد البنود:</strong> @_items.Count</div>
                    <div class="party-line"><strong>بدائل مختارة:</strong> @_items.Count(x => x.HasAlternative)</div>
                    <div class="party-line"><strong>أكبر مدة تصنيع:</strong> @_maxPeriodDays يوم</div>
                    <div class="party-line"><strong>تاريخ الإصدار:</strong> @DateTime.Now.ToString("yyyy/MM/dd HH:mm")</div>
                </div>
            </div>

            <table class="items-table">
                <thead>
                    <tr>
                        <th style="width:40px;">#</th>
                        <th style="width:100px;">الصورة</th>
                        <th>المنتج</th>
                        <th style="width:150px;">المواصفة المختارة</th>
                        <th style="width:150px;">ملاحظات التصنيع</th>
                        <th style="width:80px;">الباقة</th>
                        <th style="width:70px;">الكمية</th>
                        <th style="width:70px;">المدة</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _items.Count; i++)
                    {
                        var item = _items[i];
                        <tr>
                            <td class="text-center">@(i + 1)</td>
                            <td class="text-center">
                                @if (!string.IsNullOrWhiteSpace(item.DisplayImagePath))
                                {
                                    <img src="@item.DisplayImagePath" alt="@item.ProductName" class="product-img" />
                                }
                                else
                                {
                                    <div class="img-placeholder">📦</div>
                                }
                            </td>
                            <td>
                                <strong>@item.ProductName</strong>
                                <div class="item-desc">#@item.ProductId</div>
                                @if (!string.IsNullOrWhiteSpace(item.ProductDescription))
                                {
                                    <div class="item-desc">@item.ProductDescription</div>
                                }
                            </td>
                            <td>
                                <div class="manufacturing-note">@(item.SelectedAlternativeName ?? "الأصلي الحالي")</div>
                                @if (!string.IsNullOrWhiteSpace(item.SelectedAlternativeSummary))
                                {
                                    <div class="item-desc">@item.SelectedAlternativeSummary</div>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.ManufacturingDescription))
                                {
                                    <div class="manufacturing-note">@item.ManufacturingDescription</div>
                                }
                                else
                                {
                                    <span class="empty-manufacturing">—</span>
                                }
                            </td>
                            <td class="text-center">@GetTierText(item.PricingTier)</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-center">@(item.Period.HasValue && item.Period.Value > 0 ? $"{item.Period.Value} يوم" : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="notes-box notes-large">
                <strong>ملاحظات:</strong>
                <p>
                    هذا أمر تشغيل مبني على بنود الفاتورة الفعلية وما تم اختياره من بدائل/مواصفات وقت الاتفاق التجاري مع العميل.
                </p>
            </div>
        </div>
    </div>
}

<style>
    body { margin: 0; padding: 0; background: #f2f2f2; font-family: 'Segoe UI', 'Tajawal', sans-serif; }
    .loading-container, .not-found { display:flex; justify-content:center; align-items:center; min-height:100vh; }
    .print-actions { position: fixed; top: 1rem; left: 1rem; display:flex; gap:.5rem; z-index:9999; }
    .btn-action { border:none; border-radius:8px; padding:.7rem 1.4rem; cursor:pointer; font-weight:700; }
    .btn-print { background:#d4af37; color:#fff; }
    .btn-back { background:#ddd; }
    .print-page { width:210mm; min-height:297mm; margin:1rem auto; position:relative; background-image:url('/images/design-background.png'); background-repeat:no-repeat; background-size:cover; background-position:center; overflow:hidden; box-shadow:0 0 10px rgba(0,0,0,.15); box-sizing:border-box; }
    .content { position:relative; min-height:297mm; padding-top:42mm; padding-bottom:38mm; padding-left:12mm; padding-right:12mm; box-sizing:border-box; }
    .invoice-top-meta { position:absolute; top:14mm; left:14mm; width:52mm; text-align:center; z-index:5; }
    .meta-type { font-size:.95rem; font-weight:700; color:#1a2842; margin-bottom:.3rem; }
    .meta-number { font-size:.88rem; font-weight:600; color:#444; margin-bottom:.2rem; letter-spacing:.5px; }
    .meta-date { font-size:.8rem; color:#666; }
    .party-grid { display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1.5rem; }
    .party-box { background:#faf6e8; border:1px solid #d4af3744; border-radius:10px; padding:1rem; }
    .party-box h3 { margin:0 0 .45rem 0; font-size:.88rem; color:#1a2842; padding-bottom:.35rem; border-bottom:1px solid #d4af3744; }
    .party-line { font-size:.76rem; margin:.18rem 0; line-height:1.45; }
    .items-table { width:100%; border-collapse:collapse; margin-bottom:1rem; font-size:.82rem; background:#fff; }
    .items-table th, .items-table td { border:1px solid #ddd; padding:.5rem; vertical-align:middle; }
    .items-table thead th { background:#1a2842; color:#fff; font-weight:700; }
    .product-img { width:88px; height:88px; object-fit:cover; border-radius:6px; border:1px solid #ddd; }
    .img-placeholder { width:88px; height:88px; display:flex; align-items:center; justify-content:center; background:#f5f5f5; border-radius:6px; border:1px dashed #ccc; margin:auto; }
    .item-desc { font-size:.72rem; color:#777; margin-top:.2rem; }
    .manufacturing-note { padding:.35rem .5rem; background:#f8fafc; border-right:3px solid #667eea; border-radius:6px; font-size:.73rem; color:#334155; line-height:1.7; }
    .empty-manufacturing { color:#94a3b8; font-style:italic; }
    .notes-box { background:#fafafa; border-right:3px solid #d4af37; padding:.8rem; border-radius:8px; }
    .notes-large { margin-top:1.5rem; font-size:.9rem; }
    .text-center { text-align:center; }
    @@media print {
        @@page { size: A4; margin: 0; }
        html, body { width:210mm; margin:0; padding:0; background:#fff; }
        .no-print { display:none !important; }
        .print-page { margin:0; box-shadow:none; }
    }
</style>

@code {
    [Parameter] public int InvoiceId { get; set; }

    private bool _isLoading = true;
    private bool _canView;
    private InvoiceFormDto? _invoice;
    private List<InvoiceJobOrderPrintItemVm> _items = new();
    private int _maxPeriodDays;
    private bool _didAutoPrint;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        _canView = user.IsInRole(SystemRoles.Admin)
                   || user.IsInRole(SystemRoles.SalesManager)
                   || user.IsInRole(SystemRoles.Sales)
                   || user.IsInRole(SystemRoles.AccountManager)
                   || user.IsInRole(SystemRoles.HrManager)
                   || user.IsInRole(SystemRoles.ProductionManager)
                   || user.IsInRole("factory");

        if (!_canView)
        {
            _isLoading = false;
            return;
        }

        await LoadAsync();
        _isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_didAutoPrint && !_isLoading)
        {
            _didAutoPrint = true;
            await JS.InvokeVoidAsync("window.print");
        }
    }

    private async Task LoadAsync()
    {
        _invoice = await (from t in Db.Transactions.AsNoTracking()
                          join p in Db.Parties.AsNoTracking() on t.PartyId equals p.PartyId
                          where t.TransactionId == InvoiceId && t.TransactionType == TransactionTypes.Sale
                          select new InvoiceFormDto
                          {
                              TransactionId = t.TransactionId,
                              ReferenceNumber = t.ReferenceNumber,
                              TransactionDate = t.TransactionDate,
                              PartyId = t.PartyId,
                              PartyName = p.PartyName,
                              EmpId = t.EmpId,
                              EmpName = t.EmpId == null ? null : Db.Employees.Where(e => e.EmployeeId == t.EmpId).Select(e => e.FullName).FirstOrDefault(),
                              DueDate = t.DueDate,
                              TransactionType = t.TransactionType
                          }).FirstOrDefaultAsync();

        if (_invoice == null) return;

        var items = await (from d in Db.TransactionDetails.AsNoTracking()
                           join pr in Db.Products.AsNoTracking() on d.ProductId equals pr.ProductId
                           where d.TransactionId == InvoiceId
                           select new
                           {
                               d.ProductId,
                               pr.ProductName,
                               pr.ProductDescription,
                               BaseManufacturingDescription = pr.ManufacturingDescription,
                               BasePeriod = pr.Period,
                               d.Quantity,
                               d.PricingTier,
                               d.SelectedAlternativeId
                           }).ToListAsync();

        var alternativeIds = items.Where(x => x.SelectedAlternativeId.HasValue).Select(x => x.SelectedAlternativeId!.Value).Distinct().ToList();
        var alternatives = alternativeIds.Any()
            ? await Db.ProductFactoryAlternatives.AsNoTracking()
                .Where(a => alternativeIds.Contains(a.AlternativeId))
                .ToDictionaryAsync(a => a.AlternativeId)
            : new Dictionary<int, ProductFactoryAlternative>();
        var altImages = alternativeIds.Any()
            ? await Db.ProductFactoryAlternativeImages.AsNoTracking()
                .Where(i => alternativeIds.Contains(i.AlternativeId))
                .OrderByDescending(i => i.IsPrimary)
                .ThenBy(i => i.AlternativeImageId)
                .ToListAsync()
            : new List<ProductFactoryAlternativeImage>();

        _items = items.Select(x =>
        {
            alternatives.TryGetValue(x.SelectedAlternativeId ?? 0, out var alt);
            var altPrimaryImage = x.SelectedAlternativeId.HasValue
                ? altImages.FirstOrDefault(i => i.AlternativeId == x.SelectedAlternativeId.Value)
                : null;

            return new InvoiceJobOrderPrintItemVm
            {
                ProductId = x.ProductId,
                ProductName = x.ProductName,
                ProductDescription = alt?.SpecificationSummary ?? x.ProductDescription,
                ManufacturingDescription = alt?.ManufacturingDescription ?? x.BaseManufacturingDescription,
                Period = alt?.Period ?? x.BasePeriod,
                Quantity = x.Quantity,
                PricingTier = x.PricingTier,
                SelectedAlternativeName = alt?.AlternativeName,
                SelectedAlternativeSummary = alt?.SpecificationSummary,
                AlternativeImagePath = altPrimaryImage?.ImagePath
            };
        }).ToList();

        _maxPeriodDays = _items.Where(x => x.Period.HasValue).Select(x => x.Period!.Value).DefaultIfEmpty(0).Max();
    }

    private void GoBack() => Navigation.NavigateTo($"/sales/invoices/{InvoiceId}/job-order");
    private async Task PrintNow() => await JS.InvokeVoidAsync("window.print");
    private static string GetTierText(string? tier)
        => PricingTiers.All.TryGetValue(tier ?? string.Empty, out var value) ? value : (tier ?? "-");

    private sealed class InvoiceJobOrderPrintItemVm
    {
        public int ProductId { get; set; }
        public string ProductName { get; set; } = "";
        public string? ProductDescription { get; set; }
        public string? ManufacturingDescription { get; set; }
        public int? Period { get; set; }
        public decimal Quantity { get; set; }
        public string PricingTier { get; set; } = PricingTiers.Premium;
        public string? SelectedAlternativeName { get; set; }
        public string? SelectedAlternativeSummary { get; set; }
        public string? AlternativeImagePath { get; set; }
        public bool HasAlternative => !string.IsNullOrWhiteSpace(SelectedAlternativeName) || !string.IsNullOrWhiteSpace(SelectedAlternativeSummary);
        public string? DisplayImagePath => !string.IsNullOrWhiteSpace(AlternativeImagePath) ? AlternativeImagePath : $"/api/product-images/{ProductId}";
    }
}
