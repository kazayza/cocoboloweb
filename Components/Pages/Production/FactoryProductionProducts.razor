@page "/factory/production-products"
@attribute [Authorize]

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims

@inject db24804Context Db
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

<PageTitle>أوامر الإنتاج</PageTitle>

@if (_loading)
{
    <div class="fp-loading">
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        <MudText Typo="Typo.h6" Class="mt-4" Style="color: var(--gold);">جارٍ تجهيز أوامر الإنتاج...</MudText>
    </div>
}
else if (!_canView)
{
    <MudAlert Severity="Severity.Error">هذه الشاشة لطاقم المصنع فقط. فروع المعرض والمبيعات لا تفتحها.</MudAlert>
}
else
{
    <div class="fp-page" dir="rtl">
        <div class="fp-header">
            <div class="fp-overlay"></div>
            <div class="fp-header-top">
                <div class="fp-header-info">
                    <div class="fp-badge"><MudIcon Icon="@Icons.Material.Filled.Inventory" /></div>
                    <div>
                        <h1>أوامر الإنتاج</h1>
                        <p>رقم أمر التنفيذ، العميل، والمستند المرتبط. اضغط الصف لفتح التفاصيل. بلا أسعار.</p>
                    </div>
                </div>
            </div>
            <div class="fp-stats">
                <div class="fp-stat"><span class="fp-stat-icon"><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" /></span><span><strong>@Filtered.Count</strong><em>أمر معتمد</em></span></div>
            </div>
        </div>
        @if (_needsScript)
        {
            <MudAlert Severity="Severity.Warning">يلزم تشغيل سكربت ExecutionOrder.sql مرة واحدة.</MudAlert>
        }
        else
        {
            <div class="fp-filters">
                <MudTextField T="string" @bind-Value="_search" Placeholder="رقم الأمر أو اسم العميل أو رقم الفاتورة" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true" />
                <MudDatePicker @bind-Date="_from" Label="التنفيذ من" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy/MM/dd" Clearable="true" />
                <MudDatePicker @bind-Date="_to" Label="التنفيذ إلى" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy/MM/dd" Clearable="true" />
            </div>
            <div class="fp-table-card">
                <MudTable T="OrderRow" Items="Filtered" Hover="true" Striped="true" OnRowClick="@((TableRowClickEventArgs<OrderRow> args) => Open(args.Item.OrderId))">
                    <HeaderContent>
                        <MudTh>أمر التنفيذ</MudTh>
                        <MudTh>العميل</MudTh>
                        <MudTh>المستند</MudTh>
                    <MudTh>التنفيذ</MudTh>
                    <MudTh>المنتجات</MudTh>
                    <MudTh>الخطة</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><span class="fp-no">@context.Number</span></MudTd>
                    <MudTd><strong>@context.CustomerName</strong></MudTd>
                    <MudTd><span class="fp-chip">@context.DocumentKind</span> @context.DocumentNo</MudTd>
                    <MudTd>@context.DueDate.ToString("yyyy/MM/dd")</MudTd>
                    <MudTd>@context.ProductCount</MudTd>
                    <MudTd>
                        <span class="fp-chip">@context.PlanText</span>
                        <button type="button" class="fp-plan" @onclick:stopPropagation="true" @onclick="() => OpenPlan(context.OrderId)">الخطة</button>
                    </MudTd>
                </RowTemplate>
                    <NoRecordsContent>
                        <div class="fp-empty"><p>لا توجد أوامر تنفيذ معتمدة مطابقة.</p></div>
                    </NoRecordsContent>
                </MudTable>
            </div>
        }
    </div>
}

<style>
    .fp-loading { min-height: 420px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .fp-page { padding: 1.5rem; max-width: 1600px; margin: 0 auto; direction: rtl; }
    .fp-header { position: relative; background: linear-gradient(135deg, #1a2842 0%, #2a3f6a 50%, #1a2842 100%); border-radius: 20px; padding: 1.75rem 2rem; margin-bottom: 1rem; overflow: hidden; }
    .fp-overlay { position: absolute; inset: 0; pointer-events: none; background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23d4af37' fill-opacity='0.06'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E"); }
    .fp-header-top, .fp-stats { position: relative; }
    .fp-header-info { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.2rem; }
    .fp-badge { width: 52px; height: 52px; border-radius: 14px; background: linear-gradient(135deg, #d4af37, #f0d060); color: #1a2842; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 15px rgba(212,175,55,.4); }
    .fp-header h1 { margin: 0; color: #fff; font-size: 1.55rem; font-weight: 800; }
    .fp-header p { margin: .25rem 0 0; color: rgba(255,255,255,.72); }
    .fp-stat { background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.12); border-radius: 14px; padding: .85rem 1rem; display: flex; align-items: center; gap: .75rem; color: #fff; max-width: 240px; }
    .fp-stat strong { display: block; font-size: 1.2rem; }
    .fp-stat em { display: block; font-style: normal; font-size: .72rem; color: rgba(255,255,255,.65); }
    .fp-stat-icon { width: 38px; height: 38px; border-radius: 11px; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,.15); }
    .fp-filters, .fp-table-card { background: var(--mud-palette-surface); border: 1px solid var(--mud-palette-divider); border-radius: 16px; margin-bottom: 1rem; }
    .fp-filters { padding: 1rem 1.1rem; display: grid; grid-template-columns: 1.4fr .8fr .8fr; gap: .6rem; }
    .fp-plan { margin-right: .4rem; border: 0; background: #1a2842; color: #fff; border-radius: 8px; padding: .2rem .55rem; font-weight: 800; cursor: pointer; }
    .fp-table-card { overflow: auto; }
    .fp-no, .fp-chip { display: inline-block; background: rgba(212,175,55,.12); color: var(--gold-dark, #b8860b); border: 1px solid rgba(212,175,55,.28); border-radius: 8px; padding: .12rem .5rem; font-weight: 800; }
    .fp-chip { margin-left: .35rem; font-size: .75rem; }
    .fp-empty { min-height: 140px; display: grid; place-items: center; color: var(--mud-palette-text-secondary); }
    @@media (max-width: 900px) { .fp-page { padding: .75rem; } .fp-header { padding: 1.2rem; } }
</style>

@code {
    private bool _loading = true;
    private bool _canView;
    private bool _canOpenInvoice;
    private bool _needsScript;
    private string _search = "";
    private DateTime? _from;
    private DateTime? _to;
    private List<OrderRow> _rows = new();

    private List<OrderRow> Filtered => _rows.Where(r =>
        (string.IsNullOrWhiteSpace(_search)
            || r.Number.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
            || (r.CustomerName ?? "").Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
            || (r.DocumentNo ?? "").Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))
        && (!_from.HasValue || r.DueDate.Date >= _from.Value.Date)
        && (!_to.HasValue || r.DueDate.Date <= _to.Value.Date)).ToList();

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
        var supply = user.IsInRole("factory") || user.IsInRole(SystemRoles.FactoryManager) || user.IsInRole(SystemRoles.ProductionManager);
        var admin = user.IsInRole("Admin") || user.IsInRole(SystemRoles.Admin);
        _canView = admin || supply;
        _canOpenInvoice = !supply && (admin || user.HasClaim("Permission", "frm_PartiesInvoices:View"));
        if (_canView)
            await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        try
        {
            var raw = await (
                from order in Db.ExecutionOrders.AsNoTracking()
                join invoice in Db.Transactions.AsNoTracking() on order.TransactionId equals invoice.TransactionId
                join party in Db.Parties.AsNoTracking() on invoice.PartyId equals party.PartyId
                where invoice.TransactionType == TransactionTypes.Sale
                    && invoice.InvoiceStatus != InvoiceStatuses.Cancelled
                    && order.Status == "Approved"
                orderby order.DueDate
                select new
                {
                    order.ExecutionOrderId,
                    order.DueDate,
                    invoice.TransactionId,
                    invoice.ReferenceNumber,
                    party.PartyName
                }).ToListAsync();
            var ids = raw.Select(r => r.ExecutionOrderId).ToList();
            var lineIds = ids.Count == 0
                ? new List<int>()
                : await Db.ExecutionOrderLines.AsNoTracking().Where(l => ids.Contains(l.ExecutionOrderId)).Select(l => l.ExecutionOrderId).ToListAsync();
            var plans = ids.Count == 0 ? new List<ProductionPlan>() : await Db.ProductionPlans.AsNoTracking().Where(p => ids.Contains(p.ExecutionOrderId)).ToListAsync();
            var planIds = plans.Select(p => p.PlanId).ToList();
            var started = planIds.Count == 0 ? new List<int>() : await Db.ProductionStages.AsNoTracking().Where(s => planIds.Contains(s.PlanId) && s.Status == "Started").Select(s => s.PlanId).ToListAsync();
            _rows = raw.Select(r =>
            {
                var plan = plans.FirstOrDefault(p => p.ExecutionOrderId == r.ExecutionOrderId);
                var planText = plan == null ? "بلا خطة" : plan.Status == "Saved" && started.Contains(plan.PlanId) ? "شغالة" : plan.Status == "Saved" ? "محفوظة" : "مسودة";
                return new OrderRow
                {
                    OrderId = r.ExecutionOrderId,
                    Number = $"EXE-{r.ExecutionOrderId:D5}",
                    CustomerName = r.PartyName ?? "عميل",
                    DocumentKind = _canOpenInvoice ? "فاتورة" : "بيع",
                    DocumentNo = string.IsNullOrWhiteSpace(r.ReferenceNumber) ? r.TransactionId.ToString() : r.ReferenceNumber,
                    DueDate = r.DueDate,
                    ProductCount = lineIds.Count(id => id == r.ExecutionOrderId),
                    PlanText = planText
                };
            }).ToList();
        }
        catch
        {
            _needsScript = true;
        }
    }

    private void Open(int orderId) => Navigation.NavigateTo($"/factory/production-products/{orderId}");
    private void OpenPlan(int orderId) => Navigation.NavigateTo($"/factory/production-plans/{orderId}");

    private sealed class OrderRow
    {
        public int OrderId { get; set; }
        public string Number { get; set; } = "";
        public string CustomerName { get; set; } = "";
        public string DocumentKind { get; set; } = "";
        public string DocumentNo { get; set; } = "";
        public DateTime DueDate { get; set; }
        public int ProductCount { get; set; }
        public string PlanText { get; set; } = "";
    }
}
