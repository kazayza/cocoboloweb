            return;
        }
        _saving = true;
        try
        {
            var stage = await Db.ProductionStages.FirstOrDefaultAsync(s => s.StageId == stageId);
            if (stage == null) return;
            stage.PlannedStart = _changeStart.Value.Date;
            stage.PlannedEnd = _changeEnd.Value.Date;
            stage.DurationDays = InclusiveDays(stage.PlannedStart.Value, stage.PlannedEnd.Value);
