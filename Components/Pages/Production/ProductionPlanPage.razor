    private string BarStyle(ProductionStage stage)
    {
        if (!stage.PlannedStart.HasValue || !stage.PlannedEnd.HasValue)
            return "inset-inline-start:0%;width:0%;";
        var span = Math.Max(1, (_due.Date - _anchor.Date).Days);
        var startOff = (stage.PlannedStart.Value.Date - _anchor.Date).Days;
        if (startOff < 0) startOff = 0;
        if (startOff > span) startOff = span;
        var left = startOff * 100.0 / span;
        var width = InclusiveDays(stage.PlannedStart.Value, stage.PlannedEnd.Value) * 100.0 / span;
        if (left > 98) left = 98;
        if (left + width > 100) width = 100 - left;
        if (width < 2) width = 2;
        return $"inset-inline-start:{left:0.##}%;width:{width:0.##}%;";
    }

