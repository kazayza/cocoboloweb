@page "/factory/production-plans"
@page "/factory/production-plans/{OrderId:int}"
@attribute [Authorize]

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Models
@using COCOBOLOERPNEW.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims

@inject db24804Context Db
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject NotificationService NotificationService

<PageTitle>خطة الإنتاج</PageTitle>

@if (_loading)
{
    <div class="fpp-loading">
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        <MudText Typo="Typo.h6" Class="mt-4" Style="color: var(--gold);">جارٍ فتح خطة الإنتاج...</MudText>
    </div>
}
else if (_denied)
{
    <MudAlert Severity="Severity.Warning" Class="ma-4">هذه الخطة ليست ضمن تعيينك.</MudAlert>
}
else if (!_canView && !_assignedViewer)
{
    <MudAlert Severity="Severity.Error" Class="ma-4">خطة الإنتاج لطاقم المصنع فقط. فروع المعرض لا تفتحها.</MudAlert>
}
else if (OrderId <= 0)
{
    <div class="fpp-page" dir="rtl">
        <header class="fpp-head">
            <div class="fpp-id">
                <span class="fpp-mark"><MudIcon Icon="@Icons.Material.Filled.AccountTree" /></span>
                <div>
                    <div class="fpp-title-line">
                        <h1>خطط الإنتاج</h1>
                    </div>
                    <p>اختر أمر تنفيذ معتمد لترتيب الدعوة والمراحل والخامات المتوقعة.</p>
                </div>
            </div>
            <div class="fpp-count"><strong>@_orders.Count</strong><span>أمر معتمد</span></div>
        </header>
        @if (_needsScript)
        {
            <MudAlert Severity="Severity.Warning">يلزم تشغيل سكربت ProductionPlanMeeting.sql مرة واحدة بعد ProductionStagePeople.sql.</MudAlert>
        }
        <section class="fpp-card fpp-table-card">
            <MudTable T="OrderRow" Items="_orders" Hover="true" Striped="true" OnRowClick="@((TableRowClickEventArgs<OrderRow> args) => Open(args.Item.OrderId))">
                <HeaderContent>
                    <MudTh>أمر التنفيذ</MudTh>
                    <MudTh>العميل</MudTh>
                    <MudTh>الخطة</MudTh>
                    <MudTh>تاريخ التنفيذ</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><span class="fpp-no">@context.Number</span></MudTd>
                    <MudTd><strong>@context.CustomerName</strong></MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@(context.PlanText == "خطة محفوظة" ? Color.Success : context.PlanText == "مسودة" ? Color.Warning : Color.Default)">@context.PlanText</MudChip>
                    </MudTd>
                    <MudTd><span class="fpp-when">@context.DueDate.ToString("yyyy/MM/dd")</span></MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="fpp-empty"><p>لا توجد أوامر تنفيذ معتمدة.</p></div>
                </NoRecordsContent>
            </MudTable>
        </section>
    </div>
}
else if (_missing)
{
    <MudAlert Severity="Severity.Warning" Class="ma-4">أمر التنفيذ غير موجود، أو لم يُعتمد بعد.</MudAlert>
}
else
{
    <div class="fpp-page" dir="rtl">
        <header class="fpp-head">
            <div class="fpp-id">
                <span class="fpp-mark"><MudIcon Icon="@Icons.Material.Filled.AccountTree" /></span>
                <div>
                    <div class="fpp-title-line">
                        <h1>خطة @_number</h1>
                        <span class="fpp-pill">@PlanStateText</span>
                    </div>
                    <p>@_customer · تاريخ التنفيذ @_due.ToString("yyyy/MM/dd")</p>
                </div>
            </div>
            <div class="fpp-actions">
                @if (_canPlan && !_saved && _stages.Count > 0)
                {
                    <MudButton Variant="Variant.Filled" Class="fpp-gold" Disabled="_saving" OnClick="SavePlan">حفظ الخطة</MudButton>
                }
                <MudButton Variant="Variant.Outlined" Class="fpp-ghost" OnClick="OpenOrder">تفاصيل الأمر</MudButton>
                <MudButton Variant="Variant.Outlined" Class="fpp-ghost" OnClick="GoList">كل الخطط</MudButton>
            </div>
        </header>

            @if (_needsScript)
            {
                <MudAlert Severity="Severity.Warning">يلزم تشغيل سكربت ProductionPlanMeeting.sql مرة واحدة بعد ProductionStagePeople.sql.</MudAlert>
            }
            else if (_needsExtraScript)
            {
                <MudAlert Severity="Severity.Warning">يلزم تشغيل سكربت ProductionPlanStageExtras.sql مرة واحدة لإضافة الوحدة والتعليمات وعينات العميل. إذا كان قد شُغّل قبل ذلك، يُعاد تشغيله؛ الإضافات لا تتكرر.</MudAlert>
            }
            else
            {
            @if (_needsMeetingScript)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">يلزم تشغيل سكربت ProductionPlanMeeting.sql مرة واحدة قبل عرض الدعوات وطلبات الخامات.</MudAlert>
            }
            @if (OrderIsLate)
            {
                <MudAlert Severity="Severity.Error" Dense="true">تجاوز الأمر تاريخ التنفيذ @_due.ToString("yyyy/MM/dd")، ولا تزال هناك مرحلة لم تكتمل.</MudAlert>
            }

            <section class="fpp-guide">
                <div>
                    <h2>وظيفة الشاشة</h2>
                    @if (_canPlan)
                    {
                        <p>تُستخدم لترتيب خطة أمر التنفيذ قبل بدء التشغيل: إرسال الدعوة، ثم موافقة المدعوين، ثم تحديد بداية كل مرحلة ونهايتها، ثم حفظ الخطة. لا تُخصم الخامات من المخزون، ولا تُصدر فاتورة بيع.</p>
                    }
                    else if (MyInvite != null)
                    {
                        <p>دعوة لمراجعة خطة @_number. المطلوب الموافقة أو الرفض. لا يُطلب التخطيط ولا تسجيل الخامات قبل الموافقة.</p>
                    }
                    else
                    {
                        <p>تعرض مراحل أمر @_number: الموظف المسؤول، وتاريخ البداية والنهاية، وحالة اعتماد الجودة.</p>
                    }
                </div>
                <p class="fpp-now">@NowText</p>
                @if (!string.IsNullOrEmpty(OpenFormText))
                {
                    <p class="fpp-now wait">@OpenFormText</p>
                }
            </section>

            @if (MyInvite != null)
            {
                <section class="fpp-card fpp-invite">
                    <div class="fpp-card-title">
                        <h2>دعوة للمراجعة</h2>
                        <p>يُرجى الموافقة على خطة @_number أو رفضها.</p>
                    </div>
                    @if (MyInvite.Status == "Approved")
                    {
                        <MudAlert Severity="Severity.Success" Dense="true">تم تسجيل الموافقة.</MudAlert>
                    }
                    else if (MyInvite.Status == "Rejected")
                    {
                        <MudAlert Severity="Severity.Error" Dense="true">تم تسجيل الرفض. لن تُطلب مدد العمل إلا بعد الموافقة.</MudAlert>
                        <div class="fpp-choice">
                            <MudButton Variant="Variant.Filled" Class="fpp-gold" Disabled="_saving" OnClick="@(() => DecideMeeting(MyInvite.AttendeeId, true))">موافقة</MudButton>
                        </div>
                    }
                    else
                    {
                        <div class="fpp-choice">
                            <MudButton Variant="Variant.Filled" Class="fpp-gold" Disabled="_saving" OnClick="@(() => DecideMeeting(MyInvite.AttendeeId, true))">موافقة</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="_saving" OnClick="@(() => DecideMeeting(MyInvite.AttendeeId, false))">رفض</MudButton>
                        </div>
                    }
                </section>
            }
            else if (_needsMeetingScript && !_canPlan)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">الدعوة موجودة، لكن تعذر قراءتها. يُشغَّل سكربت ProductionPlanMeeting.sql مرة واحدة.</MudAlert>
            }

            @if (_canPlan)
            {
                <ol class="fpp-steps">
                    <li class="@StepClass(1)"><b>1</b><span>الدعوة</span><small>تحديد المراجعين</small></li>
                    <li class="@StepClass(2)"><b>2</b><span>الموافقة</span><small>موافقة جميع المدعوين</small></li>
                    <li class="@StepClass(3)"><b>3</b><span>المواعيد</span><small>بداية كل مرحلة ونهايتها</small></li>
                    <li class="@StepClass(4)"><b>4</b><span>الحفظ</span><small>ثم بدء التنفيذ</small></li>
                </ol>
            }

            <div class="fpp-facts">
                <article>
                    <span>تاريخ التنفيذ</span>
                    <strong>@_due.ToString("yyyy/MM/dd")</strong>
                    <small>الحد الأقصى. لا تتجاوزه نهاية أي مرحلة.</small>
                </article>
                <article>
                    <span>نهاية أطول مسار</span>
                    <strong>@(_pathEnd?.ToString("yyyy/MM/dd") ?? "غير محدد")</strong>
                    <small>عند توازي المراحل يُعتمد أطول مسار، لا مجموع الأيام.</small>
                </article>
                <article>
                    <span>المراحل</span>
                    <strong>@_stages.Count</strong>
                    <small>@(MeetingApproved ? "اكتملت الموافقة. يحدد مسؤول المرحلة المواعيد." : "تبقى المواعيد مغلقة حتى موافقة جميع المدعوين.")</small>
                </article>
            </div>

            @if (_products.Count > 0)
            {
                <div class="fpp-card fpp-products">
                    <span>بنود الأمر</span>
                    @foreach (var product in _products)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@product</MudChip>
                    }
                </div>
            }

            <section class="fpp-card">
                <div class="fpp-card-title">
                    <h2>المدعوون</h2>
                    <p>@(MeetingApproved ? "اكتملت الموافقة. يمكن لمسؤول كل مرحلة تحديد تاريخ البداية والنهاية." : "لا تُحدد مواعيد العمل قبل موافقة جميع المدعوين.")</p>
                </div>
                @if (_attendees.Count == 0)
                {
                    <p class="fpp-quiet">@(_needsMeetingScript ? "لا تظهر الأسماء لأن جدول الاجتماع غير متاح." : _canPlan ? "لم تُرسل دعوة بعد. اختر الموظف ثم أرسل الدعوة." : "لا توجد دعوة ظاهرة على هذا الحساب.")</p>
                }
                else
                {
                    <div class="fpp-people">
                        @foreach (var person in _attendees)
                        {
                            <div class="fpp-person">
                                <div>
                                    <strong>@person.EmployeeName</strong>
                                    <small>@person.Department @(string.IsNullOrWhiteSpace(person.JobTitle) ? "" : "· " + person.JobTitle)</small>
                                </div>
                                <MudChip T="string" Size="Size.Small" Color="@(person.Status == "Approved" ? Color.Success : person.Status == "Rejected" ? Color.Error : Color.Warning)">@(person.Status == "Approved" ? "موافق" : person.Status == "Rejected" ? "رافض" : "بانتظار الرد")</MudChip>
                                @if (_canPlan && !_saved && person.Status != "Approved" && person.UserId != _userId)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="_saving" OnClick="@(() => RemoveAttendee(person.AttendeeId))">حذف</MudButton>
                                }
                            </div>
                        }
                    </div>
                }
                @if (_canPlan && !_saved)
                {
                    <div class="fpp-form">
                        <div class="fpp-fields">
                            <div class="fpp-col-6">
                                <MudSelect T="int" @bind-Value="_inviteId" Label="الموظف المدعو" Variant="Variant.Outlined">
                                    @foreach (var person in InviteOptions)
                                    {
                                        <MudSelectItem T="int" Value="@person.UserId">@person.Label</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                        </div>
                        <div class="fpp-actions">
                            <MudButton Variant="Variant.Filled" Class="fpp-gold" Disabled="_saving" OnClick="Invite">إرسال الدعوة</MudButton>
                        </div>
                    </div>
                }
            </section>

            @if (_canPlan || MyInvite?.Status == "Approved")
            {
                <section class="fpp-card">
                    <div class="fpp-card-title">
                        <h2>خامات متوقعة</h2>
                        <p>تُسجل الخامة المتوقعة بالكمية والوحدة وصاحب الطلب. مثال: قماش كتان، الكمية 12، الوحدة متر.</p>
                    </div>
                    <p class="fpp-quiet">هذا السجل للتخطيط فقط. لا يُخصم من المخزون، ولا يوقف البيع، وليس صرف المرحلة. يُسجل الصرف الفعلي لاحقًا من إجراء «صرف خامة» بعد بدء المرحلة.</p>
                    @if (_materials.Count == 0)
                    {
                        <p class="fpp-quiet">لا توجد خامات متوقعة.</p>
                    }
                    else
                    {
                        <div class="fpp-mat head"><span>الخامة</span><span>الكمية</span><span>الوحدة</span><span>صاحب الطلب</span><span>ملاحظة</span></div>
                        @foreach (var item in _materials)
                        {
                            <div class="fpp-mat">
                                <strong>@item.MaterialName</strong>
                                <span>@item.Quantity.ToString("0.###")</span>
                                <span>@(string.IsNullOrWhiteSpace(item.Unit) ? "—" : item.Unit)</span>
                                <span>@item.OwnerName</span>
                                <span>@(string.IsNullOrWhiteSpace(item.Note) ? "—" : item.Note)</span>
                            </div>
                        }
                    }
                    @if ((_canPlan || IsAttendee) && !_saved && _meeting != null)
                    {
                        @if (_attendees.Count == 0)
                        {
                            <p class="fpp-quiet">يلزم وجود مدعو واحد على الأقل قبل تسجيل الخامة، لأن كل طلب يُحفظ باسم صاحبه.</p>
                        }
                        else
                        {
                            <div class="fpp-form">
                                <div class="fpp-fields">
                                    <div class="fpp-col-4">
                                        <MudTextField T="string" @bind-Value="_materialName" Label="اسم الخامة" Placeholder="قماش كتان" Variant="Variant.Outlined" />
                                    </div>
                                    <div class="fpp-col-2">
                                        <MudTextField T="string" @bind-Value="_materialQty" Label="الكمية" Placeholder="12" Variant="Variant.Outlined" />
                                    </div>
                                    <div class="fpp-col-2">
                                        <MudTextField T="string" @bind-Value="_materialUnit" Label="الوحدة" Placeholder="متر" Variant="Variant.Outlined" />
                                    </div>
                                    <div class="fpp-col-4">
                                        <MudSelect T="int" @bind-Value="_materialOwnerId" Label="صاحب الطلب" Variant="Variant.Outlined">
                                            @foreach (var person in _attendees)
                                            {
                                                <MudSelectItem T="int" Value="@person.UserId">@person.EmployeeName</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </div>
                                    <div class="fpp-col-12">
                                        <MudTextField T="string" @bind-Value="_materialNote" Label="ملاحظة" Placeholder="لون أو مقاس، إن وجد" Variant="Variant.Outlined" />
                                    </div>
                                </div>
                                <div class="fpp-actions">
                                    <MudButton Variant="Variant.Filled" Class="fpp-gold" Disabled="_saving" OnClick="AddMaterialRequest">إضافة الخامة</MudButton>
                                </div>
                            </div>
                        }
                    }
                </section>
            }

            @if (_canPlan && !_saved)
            {
                <section class="fpp-card">
                    <div class="fpp-card-title">
                        <h2>إضافة مرحلة</h2>
                        <p>يُحدد اسم المرحلة وموظفها ومسؤول الجودة، مع التعليمات والملاحظات. لا تُدخل المواعيد هنا. إذا لم تُربط بمرحلة سابقة فهي متوازية، وإذا رُبطت فلا تبدأ إلا بعد نهاية المرحلة المشروطة.</p>
                    </div>
                    @if (_factoryBranchMissing)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">فرع المصنع غير موجود. راجع كود الفرع قبل إضافة مرحلة.</MudAlert>
                    }
                    else if (_staff.Count == 0)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">لا يوجد موظف مصنع مرتبط بحساب نشط. يُربط الحساب قبل إضافة المرحلة.</MudAlert>
                    }
                    <div class="fpp-form">
                        <div class="fpp-fields">
                            <div class="fpp-col-4">
                                <MudTextField T="string" @bind-Value="_newName" Label="اسم المرحلة" Placeholder="مثال: نجارة" Variant="Variant.Outlined" />
                            </div>
                            <div class="fpp-col-4">
                                <MudSelect T="int" @bind-Value="_workerId" Label="موظف المرحلة" Variant="Variant.Outlined" Placeholder="اختر الموظف">
                                    @foreach (var person in _staff)
                                    {
                                        <MudSelectItem T="int" Value="@person.UserId">@person.Label</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                            <div class="fpp-col-4">
                                <MudSelect T="int" @bind-Value="_qualityId" Label="مسؤول الجودة" Variant="Variant.Outlined" Placeholder="اختر مسؤول الجودة">
                                    @foreach (var person in _staff)
                                    {
                                        <MudSelectItem T="int" Value="@person.UserId">@person.Label</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                            <div class="fpp-col-4">
                                <MudSelect T="string" @bind-Value="_newSample" Label="عينة العميل" Variant="Variant.Outlined">
                                    <MudSelectItem T="string" Value="@("None")">لا تستلزم عينة</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("Veneer")">قشرة</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("Paint")">دهان</MudSelectItem>
                                </MudSelect>
                            </div>
                            <div class="fpp-col-6">
                                <MudTextField T="string" @bind-Value="_newInstructions" Label="تعليمات المرحلة" Placeholder="ما المطلوب تنفيذه" Variant="Variant.Outlined" Lines="2" />
                            </div>
                            <div class="fpp-col-6">
                                <MudTextField T="string" @bind-Value="_newNote" Label="ملاحظات" Placeholder="ملاحظة داخلية على المرحلة" Variant="Variant.Outlined" Lines="2" />
                            </div>
                        </div>
                        <div class="fpp-actions">
                            <MudButton Variant="Variant.Filled" Class="fpp-gold" Disabled="_saving" OnClick="AddStage">إضافة المرحلة</MudButton>
                        </div>
                    </div>
                    @if (_stages.Count > 0)
                    {
                        <div class="fpp-preds">
                            <span>شرط التتابع: لا تبدأ إلا بعد انتهاء</span>
                            @foreach (var stage in _stages)
                            {
                                <MudCheckBox T="bool" Value="_selectedPreds.Contains(stage.StageId)" ValueChanged="@((bool _) => TogglePred(stage.StageId))" Label="@stage.StageName" Dense="true" Color="Color.Primary" />
                            }
                        </div>
                    }
                </section>
            }

            @if (_assignStageId.HasValue)
            {
                <section class="fpp-card fpp-editor">
                    <div class="fpp-card-title">
                        <h2>تعيين — @(_stages.FirstOrDefault(s => s.StageId == _assignStageId.Value)?.StageName)</h2>
                        <p>تغيير موظف المرحلة أو مسؤول الجودة. لا يُغيّر هذا التعيين تاريخ المرحلة.</p>
                    </div>
                    <div class="fpp-form">
                        <div class="fpp-fields">
                            <div class="fpp-col-6">
                                <MudSelect T="int" @bind-Value="_workerId" Label="موظف المرحلة" Variant="Variant.Outlined">
                                    @foreach (var person in _staff)
                                    {
                                        <MudSelectItem T="int" Value="@person.UserId">@person.Label</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                            <div class="fpp-col-6">
                                <MudSelect T="int" @bind-Value="_qualityId" Label="مسؤول الجودة" Variant="Variant.Outlined">
                                    @foreach (var person in _staff)
                                    {
                                        <MudSelectItem T="int" Value="@person.UserId">@person.Label</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                        </div>
                        <div class="fpp-actions">
                            <MudButton Variant="Variant.Filled" Class="fpp-gold" Disabled="_saving" OnClick="@(() => SaveAssignment(_assignStageId.Value))">حفظ التعيين</MudButton>
                            <MudButton Variant="Variant.Text" OnClick="@(() => { _assignStageId = null; })">إلغاء</MudButton>
                        </div>
                    </div>
                </section>
            }

            @if (_noteStageId.HasValue)
            {
                <section class="fpp-card fpp-editor">
                    <div class="fpp-card-title">
                        <h2>تعليمات وملاحظات — @(_stages.FirstOrDefault(s => s.StageId == _noteStageId.Value)?.StageName)</h2>
                        <p>تظهر لمسؤول المرحلة. لا تغيّر مواعيد المرحلة.</p>
                    </div>
                    <div class="fpp-form">
                        <div class="fpp-fields">
                            <div class="fpp-col-6">
                                <MudTextField T="string" @bind-Value="_editInstructions" Label="تعليمات المرحلة" Variant="Variant.Outlined" Lines="3" />
                            </div>
                            <div class="fpp-col-6">
                                <MudTextField T="string" @bind-Value="_editNote" Label="ملاحظات" Variant="Variant.Outlined" Lines="3" />
                            </div>
                            <div class="fpp-col-4">
                                <MudSelect T="string" @bind-Value="_editSample" Label="عينة العميل" Variant="Variant.Outlined" Disabled="@SampleLocked">
                                    <MudSelectItem T="string" Value="@("None")">لا تستلزم عينة</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("Veneer")">قشرة</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("Paint")">دهان</MudSelectItem>
                                </MudSelect>
                            </div>
                        </div>
                        <div class="fpp-actions">
                            <MudButton Variant="Variant.Filled" Class="fpp-gold" Disabled="_saving" OnClick="@(() => SaveStageNotes(_noteStageId.Value))">حفظ</MudButton>
                            <MudButton Variant="Variant.Text" OnClick="@(() => { _noteStageId = null; })">إلغاء</MudButton>
                        </div>
                    </div>
                </section>
            }

            @if (_dateStageId.HasValue)
            {
                <section class="fpp-card fpp-editor">
                    <div class="fpp-card-title">
                        <h2>@(_saved ? "طلب تغيير التاريخ" : "مواعيد المرحلة") — @(_stages.FirstOrDefault(s => s.StageId == _dateStageId.Value)?.StageName)</h2>
                        <p>@ScheduleHint(_dateStageId.Value)</p>
                    </div>
                    <p class="fpp-quiet">@(_saved ? "بعد حفظ الخطة لا يغيّر مسؤول المرحلة المواعيد مباشرة. يُرسل طلبًا، ويبقى التاريخ الحالي ساريًا حتى موافقة مدير الإنتاج أو الأدمن." : "أدخل تاريخ البداية وعدد الأيام فيُحسب تاريخ النهاية، أو أدخل تاريخ البداية والنهاية فيُحسب عدد الأيام. اليومان شاملان.")</p>
                    <div class="fpp-form">
                        <div class="fpp-fields">
                            <div class="fpp-col-4">
                                <MudDatePicker Date="_changeStart" DateChanged="OnStartChanged" Label="تاريخ البداية" Variant="Variant.Outlined" DateFormat="yyyy/MM/dd" PickerVariant="PickerVariant.Dialog" MinDate="@EarliestStart(_dateStageId.Value)" MaxDate="@_due" />
                            </div>
                            <div class="fpp-col-2">
                                <MudNumericField T="int?" Value="_changeDays" ValueChanged="OnDaysChanged" Label="عدد الأيام" Variant="Variant.Outlined" Min="1" />
                            </div>
                            <div class="fpp-col-4">
                                <MudDatePicker Date="_changeEnd" DateChanged="OnEndChanged" Label="تاريخ النهاية" Variant="Variant.Outlined" DateFormat="yyyy/MM/dd" PickerVariant="PickerVariant.Dialog" MinDate="@_changeStart" MaxDate="@_due" />
                            </div>
                            <div class="fpp-col-2">
                                <div class="fpp-live">
                                    <span>النتيجة</span>
                                    <strong>@ChangeDays</strong>
                                    <small>ناتج التاريخين</small>
                                </div>
                            </div>
                            @if (_saved)
                            {
                                <div class="fpp-col-12">
                                    <MudTextField T="string" @bind-Value="_changeReason" Label="سبب التغيير" Variant="Variant.Outlined" />
                                </div>
                            }
                        </div>
                        <div class="fpp-actions">
                            @if (_saved)
                            {
                                <MudButton Variant="Variant.Filled" Class="fpp-gold" Disabled="_saving" OnClick="@(() => RequestDateChange(_dateStageId.Value))">إرسال الطلب</MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Filled" Class="fpp-gold" Disabled="@(_saving || UndatedPreds(_dateStageId.Value).Count > 0)" OnClick="@(() => SetStageDates(_dateStageId.Value))">حفظ المواعيد</MudButton>
                            }
                            <MudButton Variant="Variant.Text" OnClick="@(() => { _dateStageId = null; })">إلغاء</MudButton>
                        </div>
                    </div>
                </section>
            }

            @if (_issueStageId.HasValue)
            {
                <section class="fpp-card fpp-editor">
                    <div class="fpp-card-title">
                        <h2>صرف خامة — @(_stages.FirstOrDefault(s => s.StageId == _issueStageId.Value)?.StageName)</h2>
                        <p>يُسجل اسم الخامة والكمية المصروفة على هذه المرحلة أثناء تشغيلها. لا يُخصم من مخزون المعرض، وهو مستقل عن خامات التخطيط.</p>
                    </div>
                    <div class="fpp-form">
                        <div class="fpp-fields">
                            <div class="fpp-col-4">
                                <MudTextField T="string" @bind-Value="_issueName" Label="اسم الخامة" Variant="Variant.Outlined" />
                            </div>
                            <div class="fpp-col-2">
                                <MudTextField T="string" @bind-Value="_issueQty" Label="الكمية" Placeholder="رقم فقط" Variant="Variant.Outlined" />
                            </div>
                            <div class="fpp-col-2">
                                <MudTextField T="string" @bind-Value="_issueUnit" Label="الوحدة" Placeholder="متر" Variant="Variant.Outlined" />
                            </div>
                            <div class="fpp-col-4">
                                <MudTextField T="string" @bind-Value="_issueNote" Label="ملاحظة" Variant="Variant.Outlined" />
                            </div>
                        </div>
                        <div class="fpp-actions">
                            <MudButton Variant="Variant.Filled" Class="fpp-gold" Disabled="_saving" OnClick="@(() => IssueMaterial(_issueStageId.Value))">تسجيل الصرف</MudButton>
                            <MudButton Variant="Variant.Text" OnClick="@(() => { _issueStageId = null; })">إلغاء</MudButton>
                        </div>
                    </div>
                    @if (Suggestions(_issueStageId.Value).Count > 0)
                    {
                        <div class="fpp-preds">
                            <span>من الخامات المتوقعة</span>
                            @foreach (var name in Suggestions(_issueStageId.Value))
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => PickIssue(name))">@name</MudButton>
                            }
                        </div>
                    }
                </section>
            }

            @if (_excuseStageId.HasValue)
            {
                <section class="fpp-card fpp-editor">
                    <div class="fpp-card-title">
                        <h2>تعذر — @(_stages.FirstOrDefault(s => s.StageId == _excuseStageId.Value)?.StageName)</h2>
                        <p>يُذكر سبب التوقف أو نقص الخامة. تصل الرسالة إلى مدير الإنتاج، ولا يتغير تاريخ التنفيذ تلقائيًا.</p>
                    </div>
                    <div class="fpp-form">
                        <div class="fpp-fields">
                            <div class="fpp-col-12">
                                <MudTextField T="string" @bind-Value="_excuseNote" Label="سبب التعذر أو نقص الخامة" Variant="Variant.Outlined" Lines="3" />
                            </div>
                        </div>
                        <div class="fpp-actions">
                            <MudButton Variant="Variant.Filled" Class="fpp-gold" Disabled="_saving" OnClick="@(() => SendExcuse(_excuseStageId.Value))">إرسال</MudButton>
                            <MudButton Variant="Variant.Text" OnClick="@(() => { _excuseStageId = null; })">إلغاء</MudButton>
                        </div>
                    </div>
                </section>
            }

            @if (SampleStages.Count > 0 || _canPlan)
            {
                <section class="fpp-card">
                    <div class="fpp-card-title">
                        <h2>عينات العميل</h2>
                        <p>عينة القشرة وعينة الدهان تُرسلان معًا في إرسال واحد، ومهلة الرد 5 أيام من تاريخ الإرسال. المهلة تُحسب مرة واحدة، لا على كل مرحلة.</p>
                    </div>
                    @if (SampleStages.Count == 0)
                    {
                        <p class="fpp-quiet">لا توجد مرحلة تستلزم عينة. عند إضافة المرحلة اختر قشرة أو دهان إن كان اعتماد العميل لازمًا.</p>
                    }
                    else
                    {
                        <p class="fpp-quiet">قشرة: @SampleStageNames("Veneer") · دهان: @SampleStageNames("Paint")</p>
                        @if (!CanSendSamples && (LatestBatch == null || LatestBatch.Status == "Rejected"))
                        {
                            <p class="fpp-quiet">لا يُرسل نوع واحد. عيّن مرحلة للقشرة ومرحلة للدهان، ثم يُرسلان معًا.</p>
                        }
                        @if (LatestBatch == null)
                        {
                            <p class="fpp-quiet">لم تُرسل العينات بعد. لا تبدأ المرحلة المرتبطة بالعينة قبل اعتماد العميل أو انتهاء المهلة وقرار المتابعة.</p>
                        }
                        else
                        {
                            <p class="fpp-now">@SampleStatusText</p>
                        }
                        @if (_canPlan)
                        {
                            <div class="fpp-actions">
                                @if (LatestBatch == null || LatestBatch.Status == "Rejected")
                                {
                                    <MudButton Variant="Variant.Filled" Class="fpp-gold" Disabled="@(_saving || !CanSendSamples)" OnClick="SendSamples">إرسال العينتين معًا</MudButton>
                                }
                                @if (LatestBatch?.Status == "Pending")
                                {
                                    <MudButton Variant="Variant.Filled" Class="fpp-gold" Disabled="_saving" OnClick="@(() => DecideSample("Approved"))">اعتماد العميل</MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="_saving" OnClick="@(() => DecideSample("Rejected"))">رفض العميل</MudButton>
                                    @if (SampleExpired)
                                    {
                                        <MudButton Variant="Variant.Outlined" Disabled="_saving" OnClick="@(() => DecideSample("Released"))">متابعة بعد انتهاء المهلة</MudButton>
                                    }
                                }
                            </div>
                        }
                    }
                </section>
            }

            <section class="fpp-card fpp-table-card">
                <div class="fpp-card-title">
                    <h2>مراحل التشغيل</h2>
                    <p>المرحلة غير المشروطة تعمل بالتوازي ويجوز تداخل مواعيدها، ويُعتمد أطول مسار لا مجموع الأيام. المرحلة المشروطة لا تبدأ إلا بعد نهاية المرحلة السابقة. بعد حفظ الخطة لا يغيّر مسؤول المرحلة المواعيد مباشرة، بل يرسل طلبًا يبقى التاريخ الحالي ساريًا حتى الموافقة.</p>
                </div>
                @if (_stages.Count > 0)
                {
                    <div class="fpp-flow">
                        @foreach (var stage in _stages)
                        {
                            <span class="fpp-node @stage.Status.ToLowerInvariant()">
                                <b>@stage.StageName</b>
                                <small>@WhenText(stage.PlannedStart) → @WhenText(stage.PlannedEnd)</small>
                            </span>
                        }
                    </div>
                }
                <MudTable T="ProductionStage" Items="_stages" Hover="true" Striped="true" Dense="false" Class="fpp-stages">
                    <HeaderContent>
                        <MudTh>المرحلة</MudTh>
                        <MudTh>تاريخ البداية</MudTh>
                        <MudTh>تاريخ النهاية</MudTh>
                        <MudTh>الأيام</MudTh>
                        <MudTh>الحالة</MudTh>
                        <MudTh>إجراءات</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <div class="fpp-name">
                                <strong>@context.StageName</strong>
                                <div class="fpp-track" title="موقع المرحلة بين بداية الأمر وتاريخ التنفيذ"><span class="@BarClass(context)" style="@BarStyle(context)"></span></div>
                                @{
                                    var preds = PredecessorNames(context.StageId);
                                    var gate = GateText(context.StageId);
                                }
                                <span>الموظف: @(string.IsNullOrWhiteSpace(context.WorkerName) ? "غير معيّن" : context.WorkerName)</span>
                                <span>مسؤول الجودة: @(string.IsNullOrWhiteSpace(context.QualityUserName) ? "غير معيّن" : context.QualityUserName)</span>
                                <span>@RelationText(context.StageId)</span>
                                @if (NeedsSample(context))
                                {
                                    <span>عينة العميل: @SampleLabel(context.SampleType)</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(context.Instructions))
                                {
                                    <span>تعليمات: @context.Instructions</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(context.Note))
                                {
                                    <span>ملاحظات: @context.Note</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(gate))
                                {
                                    <span class="fpp-gate">@gate</span>
                                }
                                @if (context.QualityStatus == "Approved")
                                {
                                    <span>اعتمدها @(string.IsNullOrWhiteSpace(context.QualityBy) ? "مسؤول الجودة" : context.QualityBy) · @(context.QualityAt?.ToString("yyyy/MM/dd HH:mm"))</span>
                                }
                                @{
                                    var pendingDate = PendingDate(context.StageId);
                                }
                                @if (pendingDate != null)
                                {
                                    <span class="fpp-gate">طلب تغيير بانتظار الموافقة: @pendingDate.NewStart.ToString("yyyy/MM/dd") → @pendingDate.NewEnd.ToString("yyyy/MM/dd"). التاريخ الحالي ساري.</span>
                                }
                                @foreach (var issue in IssuesOf(context.StageId))
                                {
                                    <span>صرف @issue.MaterialName · @issue.Quantity.ToString("0.###")@(string.IsNullOrWhiteSpace(issue.Unit) ? "" : " " + issue.Unit) · @issue.IssuedAt.ToString("yyyy/MM/dd HH:mm")</span>
                                }
                                @foreach (var excuse in ExcusesOf(context.StageId))
                                {
                                    <span class="fpp-gate">
                                        تعذر: @excuse.Note · @excuse.RequestedBy
                                        @if (excuse.Status == "Closed")
                                        {
                                            <text> — أُغلق @(excuse.ClosedBy ?? "") ولم يتغير تاريخ التنفيذ.</text>
                                        }
                                        else if (_canApproveDate)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_saving" OnClick="@(() => CloseExcuse(excuse.ExcuseId))">إغلاق</MudButton>
                                        }
                                    </span>
                                }
                            </div>
                        </MudTd>
                        <MudTd>
                            <div class="fpp-date-cell">
                                <span class="fpp-when">@WhenText(context.PlannedStart)</span>
                                @if (context.ActualStart.HasValue)
                                {
                                    <span class="fpp-actual">فعلي @context.ActualStart.Value.ToString("yyyy/MM/dd")</span>
                                }
                            </div>
                        </MudTd>
                        <MudTd>
                            <div class="fpp-date-cell">
                                <span class="fpp-when">@WhenText(context.PlannedEnd)</span>
                                @if (context.ActualStart.HasValue)
                                {
                                    <span class="fpp-actual">@(context.ActualEnd.HasValue ? "فعلي " + context.ActualEnd.Value.ToString("yyyy/MM/dd") : "لم تنته")</span>
                                }
                            </div>
                        </MudTd>
                        <MudTd>
                            <div class="fpp-days-plain">
                                <strong>@(context.PlannedStart.HasValue && context.PlannedEnd.HasValue ? InclusiveDays(context.PlannedStart.Value, context.PlannedEnd.Value) + " يوم" : "—")</strong>
                                <small>ناتج التاريخين</small>
                            </div>
                            @if (context.ActualEnd.HasValue && context.ActualStart.HasValue)
                            {
                                <span class="fpp-actual">فعلي @InclusiveDays(context.ActualStart.Value, context.ActualEnd.Value) يوم</span>
                            }
                        </MudTd>
                        <MudTd>
                            <div class="fpp-chips">
                                <MudChip T="string" Size="Size.Small" Color="@StageColor(context.Status)">@StageText(context.Status)</MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(context.QualityStatus == "Approved" ? Color.Success : Color.Default)">@QualityText(context.QualityStatus)</MudChip>
                                @if (StageIsLate(context))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error">متأخر عن نهاية المرحلة</MudChip>
                                }
                            </div>
                        </MudTd>
                        <MudTd>
                            <div class="fpp-row-actions">
                                @if (_canMove && _saved && context.Status == "Pending" && CanStart(context.StageId))
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Class="fpp-gold" Disabled="_saving" OnClick="@(() => StartStage(context.StageId))">بدء</MudButton>
                                }
                                @if (_canMove && _saved && context.Status == "Started")
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Class="fpp-gold" Disabled="_saving" OnClick="@(() => FinishStage(context.StageId))">إنهاء</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="_saving" OnClick="@(() => { _issueStageId = context.StageId; })">صرف خامة</MudButton>
                                }
                                @if (_saved && context.Status == "Done" && context.QualityStatus != "Approved" && IsAssignedQuality(context))
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Class="fpp-gold" Disabled="_saving" OnClick="@(() => ApproveQuality(context.StageId))">اعتماد الانتهاء</MudButton>
                                }
                                else if (_saved && context.Status == "Done" && context.QualityStatus != "Approved")
                                {
                                    <span class="fpp-gate">الاعتماد لـ @(string.IsNullOrWhiteSpace(context.QualityUserName) ? "مسؤول الجودة غير المعيّن" : context.QualityUserName) فقط</span>
                                }
                                @if (!_saved && context.WorkerUserId == _userId)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Class="fpp-gold" Disabled="@(_saving || !MeetingApproved)" OnClick="@(() => OpenDate(context.StageId))">@(context.PlannedStart.HasValue ? "تعديل المواعيد" : "تحديد المواعيد")</MudButton>
                                }
                                else if (!_saved && !MeetingApproved)
                                {
                                    <span class="fpp-gate">تُحدد المواعيد بعد موافقة الاجتماع</span>
                                }
                                @if (_saved)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_saving" OnClick="@(() => OpenDate(context.StageId))">طلب تغيير التاريخ</MudButton>
                                }
                                @if (_canPlan)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_saving" OnClick="@(() => OpenAssign(context.StageId))">التعيين</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_saving" OnClick="@(() => OpenNotes(context.StageId))">التعليمات</MudButton>
                                }
                                @if (_canMove && _saved)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_saving" OnClick="@(() => { _excuseStageId = context.StageId; })">إبلاغ بتعذر</MudButton>
                                }
                                @if (_canPlan && !_saved && context.Status == "Pending" && !HasDependents(context.StageId))
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="_saving" OnClick="@(() => DeleteStage(context.StageId))">حذف</MudButton>
                                }
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="fpp-empty"><p>لا توجد مراحل. أضف المرحلة بالاسم والموظف ومسؤول الجودة. تُحدد المواعيد بعد موافقة الاجتماع.</p></div>
                    </NoRecordsContent>
                </MudTable>
            </section>

            @if (_canApproveDate && PendingDates.Count > 0)
            {
                <section class="fpp-card">
                    <div class="fpp-card-title">
                        <h2>طلبات تغيير التاريخ</h2>
                        <p>الموافقة لمدير الإنتاج أو الأدمن. يبقى التاريخ الظاهر على المرحلة ساريًا حتى الموافقة.</p>
                    </div>
                    @foreach (var req in PendingDates)
                    {
                        var requestId = req.RequestId;
                        var stageName = _stages.FirstOrDefault(s => s.StageId == req.StageId)?.StageName ?? "مرحلة";
                        <div class="fpp-req">
                            <strong>@stageName</strong>
                            <span>الحالي @req.OldStart.ToString("yyyy/MM/dd") → @req.OldEnd.ToString("yyyy/MM/dd")</span>
                            <span>المطلوب @req.NewStart.ToString("yyyy/MM/dd") → @req.NewEnd.ToString("yyyy/MM/dd") · @InclusiveDays(req.NewStart, req.NewEnd) يوم</span>
                            <span>@req.Reason · @req.RequestedBy</span>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Class="fpp-gold" Disabled="_saving" OnClick="@(async () => await DecideDate(requestId, true))">موافقة</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Disabled="_saving" OnClick="@(async () => await DecideDate(requestId, false))">رفض</MudButton>
                        </div>
                    }
                </section>
            }
        }
    </div>
}

<style>
    .fpp-loading { min-height: 420px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .fpp-page { padding: .85rem 1.15rem 1.6rem; max-width: none; width: 100%; margin: 0; direction: rtl; display: flex; flex-direction: column; gap: .75rem; color: var(--mud-palette-text-primary); }
    .fpp-head { display: flex; justify-content: space-between; gap: .75rem; align-items: center; background: linear-gradient(135deg, #1a2842 0%, #2a3f6a 58%, #1a2842 100%); color: #fff; border-radius: 16px; padding: .7rem .85rem; }
    .fpp-id { display: flex; align-items: center; gap: .7rem; min-width: 0; }
    .fpp-mark { width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; flex: 0 0 auto; color: #1a2842; background: linear-gradient(135deg, #ffe9a3, #d4af37); }
    .fpp-title-line { display: flex; align-items: center; gap: .45rem; flex-wrap: wrap; }
    .fpp-head h1 { margin: 0; font-size: 1.12rem; font-weight: 800; line-height: 1.3; color: #fff; }
    .fpp-head p { margin: .12rem 0 0; color: rgba(255,255,255,.74); font-size: .8rem; line-height: 1.45; }
    .fpp-pill { display: inline-flex; background: rgba(212,175,55,.18); color: #f6e7b4; border: 1px solid rgba(212,175,55,.35); border-radius: 999px; padding: .12rem .55rem; font-weight: 800; font-size: .72rem; }
    .fpp-count { min-width: 72px; text-align: center; background: rgba(255,255,255,.08); border: 1px solid rgba(212,175,55,.28); border-radius: 12px; padding: .35rem .55rem; }
    .fpp-count strong { display: block; font-size: 1.15rem; color: #f6e7b4; }
    .fpp-count span { color: #cbd5e1; font-size: .72rem; }
    .fpp-actions, .fpp-choice { display: flex; flex-direction: row; flex-wrap: wrap; gap: .4rem; align-items: center; }
    .fpp-choice { margin-top: .75rem; }
    .fpp-gold { background: linear-gradient(180deg, #ffe9a3 0%, #f0d060 42%, #d4af37 100%) !important; color: #1a2842 !important; font-weight: 800 !important; border-radius: 999px !important; }
