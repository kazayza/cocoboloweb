            return;
        }
        _dateStageId = stageId;
        _assignStageId = null;
        _noteStageId = null;
        _changeStart = stage.PlannedStart ?? EarliestStart(stageId) ?? _anchor;
        _changeEnd = stage.PlannedEnd;
        _changeDays = stage.PlannedStart.HasValue && stage.PlannedEnd.HasValue
            ? InclusiveDays(stage.PlannedStart.Value, stage.PlannedEnd.Value)
            : null;
        _changeReason = "";
    }

    private void OnStartChanged(DateTime? value)
    {
        _changeStart = value;
        RecalcEndFromDays();
    }

    private void OnDaysChanged(int? value)
    {
        _changeDays = value;
        RecalcEndFromDays();
    }

    private void OnEndChanged(DateTime? value)
    {
        _changeEnd = value;
        if (_changeStart.HasValue && value.HasValue && value.Value.Date >= _changeStart.Value.Date)
            _changeDays = InclusiveDays(_changeStart.Value, value.Value);
    }

    private void RecalcEndFromDays()
    {
        if (_changeStart.HasValue && _changeDays is > 0)
            _changeEnd = _changeStart.Value.Date.AddDays(_changeDays.Value - 1);
    }

    private async Task SetStageDates(int stageId)
