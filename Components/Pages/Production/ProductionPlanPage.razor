@code {
    [Parameter] public int OrderId { get; set; }

    private bool _loading = true;
    private bool _saving;
    private bool _authChecked;
    private bool _canView;
    private bool _canPlan;
    private bool _canMove;
    private bool _canApproveDate;
    private bool _assignedViewer;
    private bool _denied;
    private bool _missing;
    private bool _needsScript;
    private bool _needsMeetingScript;
    private bool _needsExtraScript;
    private bool _saved;
    private int _seen = -1;
    private int _userId;
    private string _userName = "System";
    private string _number = "";
    private string _customer = "";
    private string _newName = "";
    private string _newSample = "None";
    private string _editSample = "None";
    private string _newInstructions = "";
    private string _newNote = "";
    private int? _changeDays;
    private int? _noteStageId;
    private string _editInstructions = "";
    private string _editNote = "";
    private DateTime? _newStart;
    private DateTime? _newEnd;
    private string PreviewDays => _newStart.HasValue && _newEnd.HasValue && _newEnd.Value.Date >= _newStart.Value.Date
        ? InclusiveDays(_newStart.Value, _newEnd.Value).ToString()
        : "—";
    private string ChangeDays => _changeStart.HasValue && _changeEnd.HasValue && _changeEnd.Value.Date >= _changeStart.Value.Date
        ? InclusiveDays(_changeStart.Value, _changeEnd.Value).ToString()
        : "—";
    private bool MeetingApproved => _attendees.Count > 0 && _attendees.All(a => a.Status == "Approved");
    private bool IsAttendee => _attendees.Any(a => a.UserId == _userId);
    private ProductionPlanAttendee? MyInvite => _attendees.FirstOrDefault(a => a.UserId == _userId);
    private List<StaffOption> InviteOptions => _staff.Where(s => _attendees.All(a => a.UserId != s.UserId)).ToList();
    private string PlanStateText => _saved ? "محفوظة" : _plan == null ? "لم تُنشأ" : "مسودة";
    private int GuideStep
    {
        get
        {
            if (_attendees.Count == 0) return 1;
            if (!MeetingApproved) return 2;
            if (!_saved && (_stages.Count == 0 || _stages.Any(s => !s.PlannedStart.HasValue || !s.PlannedEnd.HasValue))) return 3;
            if (!_saved) return 4;
            return 5;
        }
    }
    private string StepClass(int step) => GuideStep == step ? "on" : GuideStep > step ? "done" : "";
    private string NowText
    {
        get
        {
            if (MyInvite != null && MyInvite.Status != "Approved" && MyInvite.Status != "Rejected")
                return _canPlan
                    ? "توجد دعوة باسمك في أعلى الصفحة. يُرجى الموافقة أو الرفض، ويمكن إرسال دعوة لموظف آخر."
                    : "المطلوب الآن الموافقة أو الرفض. لا يُطلب التخطيط ولا تحديد المواعيد قبل ذلك.";
            if (MyInvite?.Status == "Rejected" && !_canPlan)
                return "تم تسجيل الرفض. يمكن تغيير القرار بالضغط على موافقة. لن تُطلب المدد قبل الموافقة.";
            if (_needsMeetingScript)
                return "الدعوة موجودة، لكن تعذر قراءتها حتى يُشغَّل سكربت الاجتماع مرة واحدة.";
            if (_canPlan && _attendees.Count == 0)
                return "الخطوة الحالية: اختيار الموظف وإرسال الدعوة. لا تُحدد مواعيد المراحل قبل موافقة جميع المدعوين.";
            if (!MeetingApproved)
                return "أُرسلت الدعوات. تبقى المواعيد مغلقة حتى موافقة الجميع، ويمكن لمن رفض أن يوافق لاحقًا.";
            if (_stages.Count == 0)
                return "اكتملت الموافقة. أضف مراحل التشغيل: الاسم، والموظف، ومسؤول الجودة.";
            if (!_saved && _stages.Any(s => !s.PlannedStart.HasValue || !s.PlannedEnd.HasValue))
                return "يحدد مسؤول كل مرحلة تاريخ البداية والنهاية. تُحسب الأيام تلقائيًا، ولا تتجاوز النهاية تاريخ التنفيذ.";
            if (!_saved)
                return "أُدخلت المواعيد. راجعها ثم احفظ الخطة. بعد الحفظ، أي تغيير للتاريخ يتم بطلب وموافقة.";
            if (OrderIsLate)
                return "الخطة محفوظة، وتجاوز الأمر تاريخ التنفيذ ولا تزال هناك مرحلة لم تكتمل.";
            return "الخطة محفوظة. يبدأ التشغيل وينتهي من إجراءات المرحلة، ويعتمد مسؤول الجودة انتهاءها.";
        }
    }
    private string OpenFormText
    {
        get
        {
            if (_dateStageId.HasValue) return _saved ? "نموذج طلب تغيير التاريخ مفتوح أعلى جدول المراحل." : "نموذج تحديد البداية والنهاية مفتوح أعلى جدول المراحل.";
            if (_assignStageId.HasValue) return "نموذج التعيين مفتوح أعلى جدول المراحل.";
            if (_issueStageId.HasValue) return "نموذج صرف الخامة مفتوح أعلى جدول المراحل. سجل للاسم والكمية فقط، دون خصم من المخزون.";
            if (_excuseStageId.HasValue) return "نموذج التعذر مفتوح أعلى جدول المراحل. يصل إلى مدير الإنتاج ولا يغيّر تاريخ التنفيذ.";
            return "";
        }
    }
    private static string WhenText(DateTime? value) => value.HasValue ? value.Value.ToString("yyyy/MM/dd") : "بانتظار المسؤول";
    private bool OrderIsLate => _saved && _stages.Count > 0
        && !_stages.All(s => s.Status == "Done" && s.QualityStatus == "Approved")
        && DateTime.Today > _due.Date;
    private List<ProductionStageDateRequest> PendingDates => _dateRequests.Where(r => r.Status == "Pending").ToList();
    private string _issueName = "";
    private string _issueQty = "";
    private string _issueUnit = "";
    private string _issueNote = "";
    private string _excuseNote = "";
    private int? _issueStageId;
    private int? _excuseStageId;
    private int? _assignStageId;
    private int? _dateStageId;
    private int _workerId;
    private int _qualityId;
    private DateTime? _changeStart;
    private DateTime? _changeEnd;
    private string _changeReason = "";
    private DateTime _anchor;
    private DateTime _due;
    private DateTime? _pathEnd;
    private ProductionPlan? _plan;
    private ExecutionOrder? _order;
    private List<ProductionStage> _stages = new();
    private List<ProductionPlanSampleBatch> _sampleBatches = new();
    private List<ProductionStageDependency> _deps = new();
    private List<ProductionMaterialIssue> _issues = new();
    private List<ProductionExcuse> _excuses = new();
    private List<ProductionStageDateRequest> _dateRequests = new();
    private List<StaffOption> _staff = new();
    private ProductionPlanMeeting? _meeting;
    private List<ProductionPlanAttendee> _attendees = new();
    private List<ProductionPlanMaterialRequest> _materials = new();
    private int _inviteId;
    private string _materialName = "";
    private string _materialQty = "";
    private string _materialUnit = "";
    private int _materialOwnerId;
    private string _materialNote = "";
    private int _factoryBranchId;
    private bool _factoryBranchMissing;
    private List<string> _products = new();
    private List<string> _componentHints = new();
    private List<OrderRow> _orders = new();
    private HashSet<int> _selectedPreds = new();

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
        _userName = user.Identity?.Name ?? "System";
        _userId = int.TryParse(user.FindFirst("UserId")?.Value, out var userId) ? userId : 0;
        var admin = user.IsInRole("Admin") || user.IsInRole(SystemRoles.Admin);
        var factory = user.IsInRole("factory") || user.IsInRole(SystemRoles.FactoryManager);
        var production = user.IsInRole(SystemRoles.ProductionManager);
        _canView = admin || factory || production;
        _canPlan = admin || production;
        _canMove = admin || factory || production;
        _canApproveDate = admin || production;
        _authChecked = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_authChecked || (!_canView && OrderId <= 0))
        {
            _loading = false;
            return;
        }
        if (_seen == OrderId)
        {
            if (OrderId > 0)
                await LoadMeetingAsync();
            _loading = false;
            return;
        }
        _seen = OrderId;
        _loading = true;
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        _missing = false;
        _denied = false;
        _assignedViewer = false;
        _needsScript = false;
        _needsExtraScript = false;
        _needsMeetingScript = false;
        _orders = new();
        _stages = new();
        _sampleBatches = new();
        _deps = new();
        _issues = new();
        _excuses = new();
        _dateRequests = new();
        _meeting = null;
        _attendees = new();
        _materials = new();
        _products = new();
        _componentHints = new();
        _plan = null;
        _saved = false;
        _pathEnd = null;
        _assignStageId = null;
        _dateStageId = null;
        _issueStageId = null;
        _excuseStageId = null;
        if (OrderId <= 0)
        {
            await LoadListAsync();
            return;
        }
        _order = await Db.ExecutionOrders.AsNoTracking().FirstOrDefaultAsync(o => o.ExecutionOrderId == OrderId && o.Status == "Approved");
        if (_order == null)
        {
            _missing = true;
            return;
        }
        var invoice = await Db.Transactions.AsNoTracking().FirstOrDefaultAsync(t => t.TransactionId == _order.TransactionId);
        var partyName = invoice == null ? "عميل" : await Db.Parties.AsNoTracking().Where(p => p.PartyId == invoice.PartyId).Select(p => p.PartyName).FirstOrDefaultAsync();
        _number = $"EXE-{_order.ExecutionOrderId:D5}";
        _customer = partyName ?? "عميل";
        _anchor = _order.CreatedAt.Date;
        _due = _order.DueDate.Date;
        _newStart = _anchor;
        _newEnd = _anchor;
        await LoadStaffAsync();
        var lines = await Db.ExecutionOrderLines.AsNoTracking().Where(l => l.ExecutionOrderId == OrderId)
            .Select(l => new { l.ProductName, l.Quantity, l.ComponentSnapshot }).ToListAsync();
        _products = lines.Select(l => $"{l.ProductName} × {l.Quantity:0.##}").ToList();
        _componentHints = lines.Where(l => !string.IsNullOrWhiteSpace(l.ComponentSnapshot))
            .SelectMany(l => l.ComponentSnapshot!.Split('،', ','))
            .Select(p => p.Split('×', 'x', 'X')[0].Trim())
            .Where(n => n.Length > 0)
            .Distinct()
            .Take(12)
            .ToList();
        try
        {
            _plan = await Db.ProductionPlans.AsNoTracking().FirstOrDefaultAsync(p => p.ExecutionOrderId == OrderId);
            _saved = _plan?.Status == "Saved";
            await LoadMeetingAsync();
            if (_plan == null)
            {
                if (!_canView && !IsAttendee)
                    _denied = true;
                else if (!_canView)
                    _assignedViewer = true;
                return;
            }
            _stages = await Db.ProductionStages.AsNoTracking().Where(s => s.PlanId == _plan.PlanId).OrderBy(s => s.SortOrder).ToListAsync();
            _sampleBatches = await Db.ProductionPlanSampleBatches.AsNoTracking().Where(b => b.ExecutionOrderId == OrderId).OrderByDescending(b => b.SentAt).ToListAsync();
            var ids = _stages.Select(s => s.StageId).ToList();
            _deps = ids.Count == 0 ? new() : await Db.ProductionStageDependencies.AsNoTracking().Where(d => ids.Contains(d.StageId)).ToListAsync();
            _issues = ids.Count == 0 ? new() : await Db.ProductionMaterialIssues.AsNoTracking().Where(i => ids.Contains(i.StageId)).ToListAsync();
            _excuses = ids.Count == 0 ? new() : await Db.ProductionExcuses.AsNoTracking().Where(e => ids.Contains(e.StageId)).ToListAsync();
            _dateRequests = ids.Count == 0 ? new() : await Db.ProductionStageDateRequests.AsNoTracking().Where(r => ids.Contains(r.StageId)).ToListAsync();
            if (!_canView)
            {
                var mine = _stages.Any(s => s.WorkerUserId == _userId || s.QualityUserId == _userId) || IsAttendee;
                if (!mine)
                {
                    _denied = true;
                    _stages = new();
                    return;
                }
                _assignedViewer = true;
            }
            var dated = _stages.Where(s => s.PlannedEnd.HasValue).Select(s => s.PlannedEnd!.Value).ToList();
            if (dated.Count > 0)
                _pathEnd = dated.Max();
        }
        catch (Exception ex)
        {
            if (MissingExtra(ex))
                _needsExtraScript = true;
            else
                _needsScript = true;
        }
    }

    private async Task LoadStaffAsync()
    {
        _staff = new();
        _factoryBranchMissing = false;
        try
        {
            var branch = await ResolveFactoryBranchAsync();
            if (branch == null)
            {
                _factoryBranchMissing = true;
                _factoryBranchId = 0;
                return;
            }
            _factoryBranchId = branch.Value.Id;
            var users = await Db.Users.AsNoTracking()
                .Where(u => u.IsActive != false && u.EmployeeId != null)
                .Select(u => new { u.UserId, u.Username, u.EmployeeId })
                .ToListAsync();
            var ids = users.Select(u => u.EmployeeId!.Value).Distinct().ToList();
            var employees = ids.Count == 0
                ? new List<(int Id, string Name, string? Department, string? Job)>()
                : (await Db.Employees.AsNoTracking()
                    .Where(e => ids.Contains(e.EmployeeId)
                        && e.BranchId == _factoryBranchId
                        && (e.Status == EmployeeStatuses.Active || e.Status == EmployeeStatuses.OnLeave))
                    .Select(e => new { e.EmployeeId, e.FullName, e.Department, e.JobTitle })
                    .ToListAsync())
                    .Select(e => (Id: e.EmployeeId, Name: e.FullName, Department: e.Department, Job: e.JobTitle))
                    .ToList();
            _staff = users
                .Select(u => new { u, Emp = employees.FirstOrDefault(e => e.Id == u.EmployeeId) })
                .Where(x => !string.IsNullOrWhiteSpace(x.Emp.Name))
                .Select(x => new StaffOption { UserId = x.u.UserId, Username = x.u.Username, FullName = x.Emp.Name, Department = x.Emp.Department ?? "", JobTitle = x.Emp.Job ?? "" })
                .OrderBy(s => s.FullName)
                .ToList();
        }
        catch
        {
            _staff = new();
            _factoryBranchMissing = true;
        }
    }

    private async Task<(int Id, string Name, string Code)?> ResolveFactoryBranchAsync()
    {
        var branches = await Db.Branches.AsNoTracking()
            .Where(b => b.IsActive)
            .Select(b => new { b.BranchId, b.BranchCode, b.BranchNameAr })
            .ToListAsync();
        var byCode = branches.FirstOrDefault(b => string.Equals((b.BranchCode ?? "").Trim(), "3", StringComparison.OrdinalIgnoreCase));
        if (byCode != null)
            return (byCode.BranchId, byCode.BranchNameAr, byCode.BranchCode);
        var byId = branches.FirstOrDefault(b => b.BranchId == 3);
        if (byId != null)
            return (byId.BranchId, byId.BranchNameAr, byId.BranchCode);
        var byName = branches.FirstOrDefault(b => (b.BranchNameAr ?? "").Contains("مصنع"));
        if (byName != null)
            return (byName.BranchId, byName.BranchNameAr, byName.BranchCode);
        return null;
    }

    private async Task LoadListAsync()
    {
        var raw = await (
            from order in Db.ExecutionOrders.AsNoTracking()
            join invoice in Db.Transactions.AsNoTracking() on order.TransactionId equals invoice.TransactionId
            join party in Db.Parties.AsNoTracking() on invoice.PartyId equals party.PartyId
            where order.Status == "Approved" && invoice.TransactionType == TransactionTypes.Sale && invoice.InvoiceStatus != InvoiceStatuses.Cancelled
            orderby order.DueDate
            select new { order.ExecutionOrderId, order.DueDate, party.PartyName }).ToListAsync();
        var ids = raw.Select(r => r.ExecutionOrderId).ToList();
        var plans = new Dictionary<int, string>();
        try
        {
            if (ids.Count > 0)
                plans = await Db.ProductionPlans.AsNoTracking().Where(p => ids.Contains(p.ExecutionOrderId)).ToDictionaryAsync(p => p.ExecutionOrderId, p => p.Status);
        }
        catch
        {
            _needsScript = true;
        }
        _orders = raw.Select(r => new OrderRow
        {
            OrderId = r.ExecutionOrderId,
            Number = $"EXE-{r.ExecutionOrderId:D5}",
            CustomerName = r.PartyName ?? "عميل",
            DueDate = r.DueDate,
            PlanText = plans.TryGetValue(r.ExecutionOrderId, out var status) ? status == "Saved" ? "خطة محفوظة" : "مسودة" : "لا توجد خطة"
        }).ToList();
    }

    private async Task AddStage()
    {
        if (!_canPlan || _saved || _saving || _order == null) return;
        if (string.IsNullOrWhiteSpace(_newName))
        {
