    private string? GateText(int stageId)
    {
        var stage = _stages.FirstOrDefault(s => s.StageId == stageId);
        if (stage == null || stage.Status != "Pending" || CanStart(stageId))
            return null;
        if (!SampleClear(stage))
            return "لا تبدأ هذه المرحلة قبل اعتماد عينة " + SampleLabel(stage.SampleType) + ". العينتان تُرسلان معًا، ومهلة الرد 5 أيام.";
        var blocked = _deps.Where(d => d.StageId == stageId)
            .Select(d => _stages.FirstOrDefault(s => s.StageId == d.DependsOnStageId))
            .Where(s => s != null && !(s!.Status == "Done" && s.QualityStatus == "Approved"))
            .Select(s => s!.QualityUserId is > 0 ? s!.StageName : s!.StageName + " (بلا مسؤول جودة)")
            .ToList();
        return blocked.Count == 0
            ? null
            : "لا تبدأ هذه المرحلة قبل أن يعتمد مسؤول الجودة المعيّن انتهاء: " + string.Join("، ", blocked);
    }

    private bool CanStart(int stageId)
    {
        var preds = _deps.Where(d => d.StageId == stageId).Select(d => d.DependsOnStageId).ToList();
        var stage = _stages.FirstOrDefault(s => s.StageId == stageId);
        if (stage != null && !SampleClear(stage))
            return false;
        return preds.All(id =>
        {
            var pred = _stages.FirstOrDefault(s => s.StageId == id);
            return pred != null && pred.Status == "Done" && pred.QualityStatus == "Approved";
        });
    }

    private const int SampleReplyDays = 5;
    private ProductionPlanSampleBatch? LatestBatch => _sampleBatches.FirstOrDefault();
    private List<ProductionStage> SampleStages => _stages.Where(NeedsSample).ToList();
    private bool SampleLocked => LatestBatch?.Status is "Pending" or "Approved";
    private bool SampleExpired => LatestBatch?.Status == "Pending" && DateTime.Today > LatestBatch.DueAt.Date;
    private bool CanSendSamples => SampleStages.Any(s => s.SampleType == "Veneer") && SampleStages.Any(s => s.SampleType == "Paint");
    private bool NeedsSample(ProductionStage stage) => stage.SampleType is "Veneer" or "Paint";
    private static string SampleLabel(string? type) => type == "Veneer" ? "القشرة" : type == "Paint" ? "الدهان" : "لا تستلزم";
    private string SampleStageNames(string type)
    {
        var names = _stages.Where(s => s.SampleType == type).Select(s => s.StageName).ToList();
        return names.Count == 0 ? "لا توجد" : string.Join("، ", names);
    }
    private string SampleStatusText
    {
        get
        {
            var batch = LatestBatch;
            if (batch == null) return "لم تُرسل العينات.";
            return batch.Status switch
            {
                "Approved" => $"اعتمد العميل العينتين في {batch.DecidedAt:yyyy/MM/dd}. يمكن بدء المراحل المرتبطة.",
                "Rejected" => $"رفض العميل العينتين في {batch.DecidedAt:yyyy/MM/dd}. يلزم إرسال جديد للعينتين معًا.",
                "Released" => $"انتهت مهلة الرد، وتقررت المتابعة في {batch.DecidedAt:yyyy/MM/dd}.",
                _ => SampleExpired
                    ? $"أُرسلت العينتان في {batch.SentAt:yyyy/MM/dd}، وانتهت مهلة الرد في {batch.DueAt:yyyy/MM/dd}."
                    : $"أُرسلت العينتان معًا في {batch.SentAt:yyyy/MM/dd}. آخر موعد للرد {batch.DueAt:yyyy/MM/dd}."
            };
        }
    }
    private bool SampleClear(ProductionStage stage)
    {
        if (!NeedsSample(stage)) return true;
        return LatestBatch?.Status is "Approved" or "Released";
    }

    private async Task SendSamples()
    {
        if (!_canPlan || _saving || !CanSendSamples || SampleLocked) return;
        _saving = true;
        try
        {
            var sent = DateTime.Now;
            Db.ProductionPlanSampleBatches.Add(new ProductionPlanSampleBatch
            {
                ExecutionOrderId = OrderId,
                SentAt = sent,
                DueAt = sent.Date.AddDays(SampleReplyDays),
                Status = "Pending",
                SentBy = _userName,
                Note = "قشرة ودهان"
            });
            await Db.SaveChangesAsync();
            Snackbar.Add("أُرسلت عينتا القشرة والدهان معًا. مهلة الرد 5 أيام.", Severity.Success);
            _seen = -1;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            if (MissingExtra(ex))
            {
                _needsExtraScript = true;
                Snackbar.Add("تعذر الإرسال. شغّل سكربت ProductionPlanStageExtras.sql مرة واحدة.", Severity.Error);
            }
            else
                Snackbar.Add("تعذر إرسال العينات.", Severity.Error);
        }
        finally { _saving = false; }
    }

    private async Task DecideSample(string status)
    {
        if (!_canPlan || _saving || LatestBatch == null || LatestBatch.Status != "Pending") return;
        if (status == "Released" && !SampleExpired) return;
        _saving = true;
        try
        {
            var batch = await Db.ProductionPlanSampleBatches.FirstOrDefaultAsync(b => b.BatchId == LatestBatch.BatchId && b.Status == "Pending");
            if (batch == null) return;
            batch.Status = status;
            batch.DecidedAt = DateTime.Now;
            batch.DecidedBy = _userName;
            await Db.SaveChangesAsync();
            Snackbar.Add(status == "Approved" ? "تم تسجيل اعتماد العميل." : status == "Rejected" ? "تم تسجيل رفض العميل." : "تمت المتابعة بعد انتهاء المهلة.", status == "Rejected" ? Severity.Warning : Severity.Success);
            _seen = -1;
            await LoadAsync();
        }
        finally { _saving = false; }
    }

