    private async Task SavePlan()
    {
        if (!_canPlan || _plan == null || _saved || _saving) return;
        if (!MeetingApproved)
        {
            Snackbar.Add("موافقة كل مدعوي الاجتماع لازمة قبل حفظ الخطة.", Severity.Warning);
            return;
        }
        var missingDates = _stages.FirstOrDefault(s => !s.PlannedStart.HasValue || !s.PlannedEnd.HasValue);
        if (missingDates != null)
        {
            Snackbar.Add($"مرحلة {missingDates.StageName} بلا بداية أو نهاية. المسئول يكتب المدد.", Severity.Warning);
            return;
        }
        foreach (var stage in _stages)
        {
            if (!DatesFit(stage.StageId, stage.PlannedStart!.Value, stage.PlannedEnd!.Value, out var fitError))
            {
                Snackbar.Add($"{stage.StageName}: {fitError}", Severity.Warning);
                return;
            }
        }
        var lateStage = _stages.FirstOrDefault(s => s.PlannedEnd!.Value.Date > _due.Date);
        if (lateStage != null)
        {
            Snackbar.Add($"مرحلة {lateStage.StageName} تنتهي بعد تاريخ التنفيذ.", Severity.Warning);
            return;
        }
        var missingPeople = _stages.FirstOrDefault(s => s.WorkerUserId is not > 0 || s.QualityUserId is not > 0
            || _staff.All(p => p.UserId != s.WorkerUserId) || _staff.All(p => p.UserId != s.QualityUserId));
        if (missingPeople != null)
        {
            Snackbar.Add($"مرحلة {missingPeople.StageName} لازم لها موظف ومسؤول جودة.", Severity.Warning);
            return;
        }
        _saving = true;
        try
        {
            var plan = await Db.ProductionPlans.FirstAsync(p => p.PlanId == _plan.PlanId);
            plan.Status = "Saved";
            plan.SavedBy = _userName;
            plan.SavedAt = DateTime.Now;
            await Db.SaveChangesAsync();
            await NotificationService.NotifyRoleAsync("خطة الإنتاج", $"{_number}: تم حفظ خطة الإنتاج والتصنيع. التواريخ مقفلة.", "factory", _userName, "factory/production-plans", "ExecutionOrders", OrderId);
            await NotificationService.NotifyRoleAsync("خطة الإنتاج", $"{_number}: تم حفظ خطة الإنتاج والتصنيع. التواريخ مقفلة.", SystemRoles.FactoryManager, _userName, "factory/production-plans", "ExecutionOrders", OrderId);
            foreach (var personId in _stages.SelectMany(s => new int?[] { s.WorkerUserId, s.QualityUserId }).Where(id => id is > 0).Distinct())
                await NotifyUserAsync(personId, "خطة الإنتاج", $"{_number}: تم حفظ الخطة وعيّنتك على مرحلة. تغيير التاريخ بعد الحفظ يحتاج سببًا وموافقة.");
            Snackbar.Add("تم حفظ الخطة. التواريخ مقفلة، ويمكن بدء المراحل المتاحة.", Severity.Success);
            _seen = -1;
            await LoadAsync();
        }
        finally { _saving = false; }
    }

