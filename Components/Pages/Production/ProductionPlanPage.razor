        RecalcEndFromDays();
        if (!_changeStart.HasValue || !_changeEnd.HasValue)
        {
            Snackbar.Add("أدخل تاريخ البداية مع عدد الأيام، أو تاريخ البداية وتاريخ النهاية.", Severity.Warning);
            return;
        }
