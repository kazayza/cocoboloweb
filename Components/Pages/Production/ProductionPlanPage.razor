    private bool TryPeople(out StaffOption? worker, out StaffOption? quality, out string error)
    {
        worker = _staff.FirstOrDefault(s => s.UserId == _workerId);
        quality = _staff.FirstOrDefault(s => s.UserId == _qualityId);
        if (worker == null || quality == null)
        {
            error = "اختر موظف المرحلة ومسؤول الجودة.";
            return false;
        }
        if (worker.UserId == quality.UserId)
        {
            error = "موظف المرحلة ومسؤول الجودة لا يكونان نفس الشخص.";
            return false;
        }
        error = "";
        return true;
    }

    private bool DatesFit(int stageId, DateTime start, DateTime end, out string error)
    {
        error = "";
        if (end.Date < start.Date)
        {
            error = "تاريخ النهاية لا يسبق تاريخ البداية.";
            return false;
        }
        if (end.Date > _due.Date)
        {
            error = $"تاريخ النهاية يتجاوز تاريخ التنفيذ {_due:yyyy/MM/dd}.";
            return false;
        }
        var undated = UndatedPreds(stageId);
        if (undated.Count > 0)
        {
            error = "لا يمكن تحديد الموعد قبل تحديد نهاية المرحلة المشروطة: " + string.Join("، ", undated);
            return false;
        }
        var earliest = EarliestStart(stageId);
        if (earliest.HasValue && start.Date < earliest.Value.Date)
        {
            error = $"تاريخ البداية يجب أن يكون بعد نهاية المرحلة السابقة. أقرب بداية مسموحة {earliest:yyyy/MM/dd}.";
            return false;
        }
        var blocks = _deps.Where(d => d.DependsOnStageId == stageId)
            .Select(d => _stages.FirstOrDefault(s => s.StageId == d.StageId))
            .Where(s => s != null && s!.PlannedStart.HasValue && s.PlannedStart.Value.Date <= end.Date)
            .Select(s => s!.StageName)
            .ToList();
        if (blocks.Count > 0)
        {
            error = "تاريخ النهاية يتداخل مع بداية المرحلة التالية المشروطة: " + string.Join("، ", blocks);
            return false;
        }
        return true;
    }

    private static bool MissingExtra(Exception ex) =>
        ex.ToString().Contains("Instructions", StringComparison.OrdinalIgnoreCase)
        || ex.ToString().Contains("Invalid column name 'Note'", StringComparison.OrdinalIgnoreCase)
        || ex.ToString().Contains("Invalid column name 'Unit'", StringComparison.OrdinalIgnoreCase)
        || ex.ToString().Contains("SampleType", StringComparison.OrdinalIgnoreCase)
        || ex.ToString().Contains("ProductionPlanSampleBatches", StringComparison.OrdinalIgnoreCase);

    private DateTime? EarliestStart(int stageId)
    {
        var ends = _deps.Where(d => d.StageId == stageId)
            .Select(d => _stages.FirstOrDefault(s => s.StageId == d.DependsOnStageId))
            .Where(s => s?.PlannedEnd != null)
            .Select(s => s!.PlannedEnd!.Value.Date)
            .ToList();
        return ends.Count == 0 ? null : ends.Max().AddDays(1);
    }

    private List<string> UndatedPreds(int stageId) => _deps.Where(d => d.StageId == stageId)
        .Select(d => _stages.FirstOrDefault(s => s.StageId == d.DependsOnStageId))
        .Where(s => s != null && !s!.PlannedEnd.HasValue)
        .Select(s => s!.StageName)
        .ToList();

    private string RelationText(int stageId)
    {
        var preds = PredecessorNames(stageId);
        if (preds.Count == 0)
            return "بالتوازي: لا تنتظر مرحلة سابقة، ويجوز تداخل المواعيد.";
        var earliest = EarliestStart(stageId);
        return earliest.HasValue
            ? "مشروطة: تبدأ بعد نهاية " + string.Join("، ", preds) + $"، وأقرب بداية {earliest:yyyy/MM/dd}."
            : "مشروطة: تبدأ بعد نهاية " + string.Join("، ", preds) + "، بعد تحديد نهايتها.";
    }

    private string ScheduleHint(int stageId)
    {
        var preds = PredecessorNames(stageId);
        if (preds.Count == 0)
            return "هذه المرحلة غير مشروطة، ويمكن أن تعمل بالتوازي مع غيرها. يجوز تداخل المواعيد، ويُعتمد أطول مسار لا مجموع الأيام.";
        var earliest = EarliestStart(stageId);
        return earliest.HasValue
            ? $"هذه المرحلة مشروطة. تاريخ البداية يجب أن يكون بعد نهاية: {string.Join("، ", preds)}. أقرب بداية مسموحة {earliest:yyyy/MM/dd}."
            : $"هذه المرحلة مشروطة بـ {string.Join("، ", preds)}. لا يُحدد موعدها قبل تسجيل نهاية المرحلة السابقة.";
    }

