    private async Task RequestDateChange(int stageId)
    {
        if (_saving || !_saved) return;
        RecalcEndFromDays();
        if (!_changeStart.HasValue || !_changeEnd.HasValue || string.IsNullOrWhiteSpace(_changeReason))
        {
            Snackbar.Add("أدخل البداية الجديدة والنهاية الجديدة وسبب التغيير.", Severity.Warning);
            return;
        }
        var start = _changeStart.Value.Date;
        var end = _changeEnd.Value.Date;
        if (!DatesFit(stageId, start, end, out var error))
        {
            Snackbar.Add(error, Severity.Warning);
            return;
        }
        if (_dateRequests.Any(r => r.StageId == stageId && r.Status == "Pending"))
        {
            Snackbar.Add("يوجد طلب تغيير معلّق على هذه المرحلة.", Severity.Warning);
            return;
        }
        var stage = _stages.FirstOrDefault(s => s.StageId == stageId);
        if (stage == null) return;
        _saving = true;
        try
        {
            Db.ProductionStageDateRequests.Add(new ProductionStageDateRequest
            {
                StageId = stageId,
                OldStart = stage.PlannedStart ?? _anchor,
                OldEnd = stage.PlannedEnd ?? _due,
                NewStart = start,
                NewEnd = end,
                Reason = _changeReason.Trim(),
                RequestedBy = _userName,
                RequestedAt = DateTime.Now,
                Status = "Pending"
            });
            await Db.SaveChangesAsync();
            var message = $"{_number}: طلب تغيير {stage.StageName} من {stage.PlannedStart:yyyy/MM/dd}–{stage.PlannedEnd:yyyy/MM/dd} إلى {start:yyyy/MM/dd}–{end:yyyy/MM/dd}. السبب: {_changeReason.Trim()}. التاريخ الحالي ساري حتى الموافقة.";
            await NotificationService.NotifyRoleAsync("طلب تغيير تاريخ", message, SystemRoles.ProductionManager, _userName, "factory/production-plans", "ExecutionOrders", OrderId);
            await NotificationService.NotifyRoleAsync("طلب تغيير تاريخ", message, SystemRoles.Admin, _userName, "factory/production-plans", "ExecutionOrders", OrderId);
            _dateStageId = null;
            _changeReason = "";
            Snackbar.Add("أُرسل الطلب. التاريخ الحالي لم يتغير.", Severity.Success);
            _seen = -1;
            await LoadAsync();
        }
        catch
        {
            Snackbar.Add("تعذر إرسال الطلب. شغّل سكربت ProductionStagePeople.sql مرة واحدة.", Severity.Error);
        }
        finally { _saving = false; }
    }

    private async Task DecideDate(int requestId, bool approve)
    {
        if (!_canApproveDate || _saving) return;
        _saving = true;
        try
        {
            var request = await Db.ProductionStageDateRequests.FirstOrDefaultAsync(r => r.RequestId == requestId && r.Status == "Pending");
            var stage = request == null ? null : await Db.ProductionStages.FirstOrDefaultAsync(s => s.StageId == request.StageId);
            if (request == null || stage == null) return;
            if (approve && !DatesFit(stage.StageId, request.NewStart, request.NewEnd, out var error))
            {
                Snackbar.Add(error, Severity.Warning);
                return;
            }
            request.Status = approve ? "Approved" : "Rejected";
            request.DecidedBy = _userName;
            request.DecidedAt = DateTime.Now;
            if (approve)
            {
                stage.PlannedStart = request.NewStart.Date;
                stage.PlannedEnd = request.NewEnd.Date;
                stage.DurationDays = InclusiveDays(stage.PlannedStart.Value, stage.PlannedEnd.Value);
            }
            await Db.SaveChangesAsync();
            var decision = approve ? "تمت الموافقة وتحدّث تاريخ المرحلة." : "رُفض الطلب. التاريخ القديم ما زال ساريًا.";
            await NotificationService.AddAsync("تغيير تاريخ المرحلة", $"{_number}: {stage.StageName} — {decision}", request.RequestedBy, _userName, "factory/production-plans", "ExecutionOrders", OrderId);
            if (approve)
                await NotificationService.NotifyRoleAsync("تغيير تاريخ المرحلة", $"{_number}: {stage.StageName} — {decision}", "factory", _userName, "factory/production-plans", "ExecutionOrders", OrderId);
            Snackbar.Add(decision, approve ? Severity.Success : Severity.Info);
            _seen = -1;
            await LoadAsync();
        }
        finally { _saving = false; }
    }

