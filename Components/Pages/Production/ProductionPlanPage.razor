            return;
        }
        if (!TryPeople(out var worker, out var quality, out var peopleError))
        {
            Snackbar.Add(peopleError, Severity.Warning);
            return;
        }
        _saving = true;
        try
        {
            var plan = _plan == null
                ? new ProductionPlan { ExecutionOrderId = OrderId, Status = "Draft", CreatedBy = _userName, CreatedAt = DateTime.Now }
                : await Db.ProductionPlans.FirstAsync(p => p.PlanId == _plan.PlanId);
            if (_plan == null)
                Db.ProductionPlans.Add(plan);
            if (plan.Status == "Saved") return;
            var stage = new ProductionStage
            {
                PlanId = plan.PlanId,
                StageName = _newName.Trim(),
                DurationDays = 0,
                Status = "Pending",
                QualityStatus = "Pending",
                WorkerUserId = worker!.UserId,
                WorkerName = worker.FullName,
                QualityUserId = quality!.UserId,
                QualityUserName = quality.FullName,
                Instructions = string.IsNullOrWhiteSpace(_newInstructions) ? null : _newInstructions.Trim(),
                Note = string.IsNullOrWhiteSpace(_newNote) ? null : _newNote.Trim(),
                SampleType = _newSample == "None" ? null : _newSample,
                SortOrder = _stages.Count + 1
            };
            if (plan.PlanId == 0)
                await Db.SaveChangesAsync();
            stage.PlanId = plan.PlanId;
            Db.ProductionStages.Add(stage);
            await Db.SaveChangesAsync();
            foreach (var pred in _selectedPreds.Where(id => _stages.Any(s => s.StageId == id)))
                Db.ProductionStageDependencies.Add(new ProductionStageDependency { StageId = stage.StageId, DependsOnStageId = pred });
            await Db.SaveChangesAsync();
