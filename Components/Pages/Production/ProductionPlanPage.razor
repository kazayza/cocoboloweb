        catch (Exception ex)
        {
            if (MissingExtra(ex))
            {
                _needsExtraScript = true;
                Snackbar.Add("تعذر الحفظ. شغّل سكربت ProductionPlanStageExtras.sql مرة واحدة.", Severity.Error);
            }
            else
            {
                _needsScript = true;
                Snackbar.Add("تعذر الحفظ. شغّل سكربت ProductionPlanMeeting.sql مرة واحدة.", Severity.Error);
            }
        }
        finally { _saving = false; }
