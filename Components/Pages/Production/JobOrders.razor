    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;

        _canView = user.IsInRole(SystemRoles.Admin)
                   || user.IsInRole(SystemRoles.SalesManager)
                   || user.IsInRole(SystemRoles.Sales)
                   || user.IsInRole(SystemRoles.AccountManager)
                   || user.IsInRole(SystemRoles.HrManager)
                   || user.IsInRole(SystemRoles.ProductionManager)
                   || user.IsInRole(SystemRoles.FactoryManager)
                   || user.IsInRole("factory")
                   || user.HasClaim("Permission", "frm_JobOrders:View");   // 🧾 صلاحية شاشة «أوامر التشغيل»

        _canOpenInvoices = user.IsInRole(SystemRoles.Admin)
                           || user.HasClaim("Permission", "frm_PartiesInvoices:View");

        // فتح «أمر تشغيل الفاتورة» لسطور التوريد (فواتير شراء المصنع) — الصفحة نفسها تدعم الشراء
        _canOpenPurchaseJobOrder = user.IsInRole(SystemRoles.Admin)
                           || user.IsInRole(SystemRoles.ProductionManager)
                           || user.IsInRole(SystemRoles.FactoryManager);

        _canSeeAmounts = user.IsInRole(SystemRoles.Admin)
                         || user.IsInRole(SystemRoles.AccountManager)
                         || user.IsInRole(SystemRoles.Account);

        // ⭐ تعديل تاريخ التسليم/الاستلام — مدير الإنتاج أُزيل بقرار المالك:
        // تغييرات التاريخ للإنتاج تمر عبر مسار «طلب تعديل الفاتورة» فقط، لا تعديلًا مباشرًا من هنا
        _canEditDueDate = user.IsInRole(SystemRoles.Admin)
                          || user.IsInRole(SystemRoles.FactoryManager)
                          || user.HasClaim("Permission", "frm_JobOrders:Edit");   // 🧾 تعديل تاريخ التسليم/الاستلام

        _canCreateTask = GeneralTaskPermissions.CanCreate(user);

        // ⭐ إخفاء تاريخ الاستحقاق لغير المستثنين — نفس قاعدة شاشة التسليمات (عرض فقط، لا يُكتب أبدًا)
        _canSeeRealDate = DeliveryPermissions.CanSeeRealDeliveryDate(user);
        _dateBufferDays = Config.GetValue<int?>("Delivery:DateBufferDays") is int buffer && buffer >= 0 ? buffer : 4;

        if (_canView)
            await LoadAsync();

        _isLoading = false;
    }

    /// <summary>
    /// التاريخ المعروض لغير المستثنين: الحقيقي منقوصًا هامش الأيام، ولا يسبق تاريخ الفاتورة أبدًا.
    /// الإخفاء للعرض فقط — التاريخ الحقيقي يبقى في RealDueDate ولا يُكتب أي تاريخ مخفي في قاعدة البيانات.
    /// </summary>
    private DateTime? GetDisplayDueDate(DateTime? realDueDate, DateTime transactionDate)
    {
        if (_canSeeRealDate || realDueDate == null) return realDueDate;
        var shown = realDueDate.Value.AddDays(-_dateBufferDays);
        return shown < transactionDate ? transactionDate : shown;
    }

    /// <summary>
    /// حدود نطاق تاريخ الاستحقاق كما تُقارن بقاعدة البيانات: المستخدم يختار من التواريخ المعروضة له،
    /// فتُزاح الحدود +الهامش للمخفيين قبل الاستعلام حتى تطابق النتائج ما يراه.
    /// </summary>
    private DateTime? ShiftRangeBound(DateTime? bound) =>
        _canSeeRealDate || bound == null ? bound : bound.Value.AddDays(_dateBufferDays);

    /// <summary>عتبة «متأخرة» على التاريخ الحقيقي بحيث تطابق دلالة التاريخ المعروض للمستخدم الحالي.</summary>
    private DateTime OverdueThreshold =>
        DateTime.Today.AddDays(_canSeeRealDate ? 0 : _dateBufferDays);

    private async Task LoadAsync()
    {
        // كل منافذ التحميل (التهيئة، استعادة الفلاتر بعد أول عرض، البحث الفوري، الكروت، الأزرار)
        // تمر من هنا وتتسلسل على البوابة — فلا يعمل تحميلان على نفس DbContext في وقت واحد.
        await _dbGate.WaitAsync();
        try
        {
            await LoadCoreAsync();
        }
        finally
        {
            _dbGate.Release();
        }
    }

    private async Task LoadCoreAsync()
    {
        try
        {
            _isLoading = true;

            // عند تفعيل «متأخرة» تكون دلالة التسليم دائماً «غير المسلّمة» مهما كانت القائمة.
            if (_overdueOnly)
                _deliveryFilter = DefaultDeliveryFilter;

            var query = Db.Transactions
                .AsNoTracking()
                .Where(t => t.InvoiceStatus != InvoiceStatuses.Cancelled
                    && ((t.TransactionType == TransactionTypes.Sale)
                     || (t.TransactionType == TransactionTypes.Purchase
                         && (t.ReferenceType == null || !t.ReferenceType.StartsWith("MirrorOf:")))));

            query = _typeFilter switch
            {
                "sale" => query.Where(t => t.TransactionType == TransactionTypes.Sale),
                "purchase" => query.Where(t => t.TransactionType == TransactionTypes.Purchase),
                _ => query
            };

            // المستخدم يختار نطاق التاريخ من التواريخ المعروضة له — تُزاح الحدود للمخفيين قبل المقارنة بالتاريخ الحقيقي.
            var rangeFrom = ShiftRangeBound(_dueDateFrom);
            var rangeTo = ShiftRangeBound(_dueDateTo);

            if (rangeFrom.HasValue)
                query = query.Where(t => t.DueDate.HasValue && t.DueDate.Value >= rangeFrom.Value.Date);

            if (rangeTo.HasValue)
                query = query.Where(t => t.DueDate.HasValue && t.DueDate.Value <= rangeTo.Value.Date.AddDays(1).AddTicks(-1));

            // أعداد الكروت من قاعدة البيانات ضمن سياق النوع ونطاق التاريخ والبحث فقط،
            // دون أبعاد الحالة السريعة (التسليم/المتأخرة/البدائل) حتى يمثل كل كارت إجمالي بعده.
            await LoadCountsAsync(query);

            if (_overdueOnly)
            {
                // «متأخرة» تُقيَّم على التاريخ المعروض: الحقيقي قبل (اليوم + الهامش) للمخفيين.
                var threshold = OverdueThreshold;
                query = query.Where(t => t.DueDate.HasValue
                    && t.DueDate.Value.Date < threshold
                    && t.IsDelivered != true);
            }
            else
            {
                query = _deliveryFilter switch
                {
                    "delivered" => query.Where(t => t.IsDelivered == true),
                    "all" => query,
                    _ => query.Where(t => t.IsDelivered != true)
                };
            }

            if (_alternativesOnly)
                query = query.Where(t => Db.TransactionDetails.Any(d =>
                    d.TransactionId == t.TransactionId && d.SelectedAlternativeId != null));

            var projected = query.Select(t => new JobOrderRowVm
            {
                TransactionId = t.TransactionId,
                PartyId = t.PartyId,
                ReferenceNumber = t.ReferenceNumber ?? $"#{t.TransactionId}",
                TransactionType = t.TransactionType,
                TransactionDate = t.TransactionDate,
                DueDate = t.DueDate,
                RealDueDate = t.DueDate,
                IsDelivered = t.IsDelivered == true,
                PartyName = Db.Parties.Where(p => p.PartyId == t.PartyId).Select(p => p.PartyName).FirstOrDefault() ?? "",
                Phone = Db.Parties.Where(p => p.PartyId == t.PartyId).Select(p => p.Phone).FirstOrDefault(),
                EmpName = t.EmpId == null ? null : Db.Employees.Where(e => e.EmployeeId == t.EmpId).Select(e => e.FullName).FirstOrDefault(),
                GrandTotal = t.GrandTotal,
                ItemsCount = Db.TransactionDetails.Count(d => d.TransactionId == t.TransactionId),
                AlternativeItemsCount = Db.TransactionDetails.Count(d => d.TransactionId == t.TransactionId && d.SelectedAlternativeId != null)
            });

            var rows = await projected
                .OrderByDescending(x => x.TransactionDate)
                .ThenByDescending(x => x.TransactionId)
                .Take(400)
                .ToListAsync();

            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                var term = _searchText.Trim();
                rows = rows.Where(x =>
                        (x.ReferenceNumber ?? string.Empty).Contains(term, StringComparison.OrdinalIgnoreCase)
                        || (x.PartyName ?? string.Empty).ContainsArabic(term)
                        || (x.Phone ?? string.Empty).ContainsArabic(term))
                    .ToList();
            }

            // العرض فقط: DueDate يصبح التاريخ المعروض، والحقيقي محفوظ في RealDueDate (تستخدمه نافذة التعديل).
            foreach (var row in rows)
                row.DueDate = GetDisplayDueDate(row.RealDueDate, row.TransactionDate);

            _items = rows;
            await SaveFiltersAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ أثناء تحميل أوامر التشغيل: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCountsAsync(IQueryable<Transaction> contextQuery)
    {
        // عدد «متأخرة» يتبع دلالة التاريخ المعروض للمستخدم الحالي (إزاحة الهامش للمخفيين).
        var overdueThreshold = OverdueThreshold;

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            // البحث النصي يستخدم المطابقة العربية المحلية القائمة نفسها في القائمة،
            // لذلك تُجلب الحقول اللازمة فقط من سياق الفلاتر ثم تُحسب الإجماليات دون حد 400.
            var term = _searchText.Trim();
            var countRows = await contextQuery
                .Select(t => new JobOrderCountVm
                {
                    ReferenceNumber = t.ReferenceNumber ?? $"#{t.TransactionId}",
                    PartyName = Db.Parties.Where(p => p.PartyId == t.PartyId).Select(p => p.PartyName).FirstOrDefault() ?? "",
                    Phone = Db.Parties.Where(p => p.PartyId == t.PartyId).Select(p => p.Phone).FirstOrDefault(),
                    IsDelivered = t.IsDelivered == true,
                    DueDate = t.DueDate,
                    HasAlternatives = Db.TransactionDetails.Any(d =>
                        d.TransactionId == t.TransactionId && d.SelectedAlternativeId != null)
                })
                .ToListAsync();

            countRows = countRows.Where(x =>
                    x.ReferenceNumber.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || x.PartyName.ContainsArabic(term)
                    || (x.Phone ?? string.Empty).ContainsArabic(term))
                .ToList();

            _countAll = countRows.Count;
            _countUndelivered = countRows.Count(x => !x.IsDelivered);
            _countDelivered = countRows.Count(x => x.IsDelivered);
            _countOverdue = countRows.Count(x => x.DueDate.HasValue
                && x.DueDate.Value.Date < overdueThreshold
                && !x.IsDelivered);
            _countAlternatives = countRows.Count(x => x.HasAlternatives);
            return;
        }

        _countAll = await contextQuery.CountAsync();
        _countUndelivered = await contextQuery.CountAsync(t => t.IsDelivered != true);
        _countDelivered = await contextQuery.CountAsync(t => t.IsDelivered == true);
        _countOverdue = await contextQuery.CountAsync(t => t.DueDate.HasValue
            && t.DueDate.Value.Date < overdueThreshold
            && t.IsDelivered != true);
        _countAlternatives = await contextQuery.CountAsync(t => Db.TransactionDetails.Any(d =>
            d.TransactionId == t.TransactionId && d.SelectedAlternativeId != null));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        if (!_canView)
        {
            _filtersRestored = true;
            return;
        }

        var shouldReload = false;
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", FiltersStorageKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                var saved = System.Text.Json.JsonSerializer.Deserialize<JobOrderFilterState>(json);
                if (saved is not null)
                {
                    _searchText = saved.SearchText;
                    _deliveryFilter = NormalizeDeliveryFilter(saved.DeliveryFilter);
                    _typeFilter = NormalizeTypeFilter(saved.TypeFilter);
                    _dueDateFrom = saved.DueDateFrom;
                    _dueDateTo = saved.DueDateTo;
                    _alternativesOnly = saved.AlternativesOnly;
                    _overdueOnly = saved.OverdueOnly;
                    if (_overdueOnly)
                        _deliveryFilter = DefaultDeliveryFilter;
                    shouldReload = true;
                }
            }
        }
        catch
        {
            // فشل localStorage لا يجب أن يمنع تشغيل الشاشة أبداً.
        }
        finally
        {
            _filtersRestored = true;
        }

        if (shouldReload)
            await LoadAsync();
    }

    private static string NormalizeDeliveryFilter(string? value) => value switch
    {
        "delivered" => "delivered",
        "all" => "all",
        _ => DefaultDeliveryFilter
    };

    private static string NormalizeTypeFilter(string? value) => value switch
    {
        "sale" => "sale",
        "purchase" => "purchase",
        _ => "all"
    };

    private async Task SaveFiltersAsync()
    {
        if (!_filtersRestored)
            return;

        try
        {
            var state = new JobOrderFilterState
            {
                SearchText = _searchText,
                DeliveryFilter = _deliveryFilter,
                TypeFilter = _typeFilter,
                DueDateFrom = _dueDateFrom,
                DueDateTo = _dueDateTo,
                AlternativesOnly = _alternativesOnly,
                OverdueOnly = _overdueOnly
            };

            var json = System.Text.Json.JsonSerializer.Serialize(state);
            await JS.InvokeVoidAsync("localStorage.setItem", FiltersStorageKey, json);
        }
        catch
        {
            // الحفظ اختياري ولا يجب أن يؤثر على نتيجة التحميل.
        }
    }

    private async Task RemoveStoredFiltersAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", FiltersStorageKey);
        }
        catch
        {
        }
    }

