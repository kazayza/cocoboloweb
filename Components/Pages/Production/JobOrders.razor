@page "/production/job-orders"
@page "/factory/job-orders"
@attribute [Authorize]

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Models
@using COCOBOLOERPNEW.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Configuration
@using ClosedXML.Excel

@inject db24804Context Db
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NotificationService NotifyService
@inject IDialogService DialogService
@inject IConfiguration Config

<PageTitle>أوامر التشغيل</PageTitle>

@if (_isLoading)
{
    <div class="job-orders-loading">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h6" Class="mt-4">جاري تحميل أوامر التشغيل...</MudText>
    </div>
}
else if (!_canView)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="ma-4">
        ليس لديك صلاحية الوصول إلى أوامر التشغيل.
    </MudAlert>
}
else
{
    <div class="job-orders-page" dir="rtl">
        <div class="jo-header">
            <div class="jo-header-bg"></div>
            <div class="jo-header-content">
                <div>
                    <div class="jo-badge">Production Queue</div>
                    <h1>أوامر التشغيل</h1>
                    <p>الافتراضي: عرض أوامر التشغيل التي لم يتم التسليم بعد مع إمكانية البحث والتصفية</p>
                </div>
                <div class="jo-header-actions">
                    <MudTooltip Text="تصدير أوامر التشغيل حسب الفلتر الحالي إلى Excel — بدون مبالغ">
                        <MudButton Variant="Variant.Outlined" Color="Color.Inherit"
                                   StartIcon="@Icons.Material.Filled.FileDownload"
                                   OnClick="ExportToExcelAsync" Disabled="@_isExporting">
                            @(_isExporting ? "جاري التصدير..." : "تصدير Excel")
                        </MudButton>
                    </MudTooltip>
                    <MudTooltip Text="طباعة أوامر التشغيل حسب الفلتر الحالي — بدون مبالغ">
                        <MudButton Variant="Variant.Outlined" Color="Color.Inherit"
                                   StartIcon="@Icons.Material.Filled.Print"
                                   OnClick="OpenPrint" Disabled="@_isExporting">
                            طباعة
                        </MudButton>
                    </MudTooltip>
                    <MudButton Variant="Variant.Outlined" Color="Color.Inherit"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadAsync">
                        تحديث
                    </MudButton>
                </div>
            </div>
        </div>

        <div class="jo-stats-row" aria-label="فلاتر سريعة حسب حالة أوامر التشغيل">
            <button type="button" class="jo-stat-card @(_isAllQuickActive ? "active" : "")"
                    @onclick="ShowAllQuickAsync" title="عرض كل أوامر التشغيل وإلغاء فلاتر الحالة السريعة">
                <span class="jo-stat-label">الكل</span>
                <strong class="jo-stat-value">@_countAll</strong>
            </button>
            <button type="button" class="jo-stat-card @(_isUndeliveredQuickActive ? "active" : "")"
                    @onclick="@(() => SetDeliveryQuickAsync("undelivered"))" title="تصفية الأوامر التي لم يتم تسليمها بعد">
                <span class="jo-stat-label">لم يتم التسليم بعد</span>
                <strong class="jo-stat-value">@_countUndelivered</strong>
            </button>
            <button type="button" class="jo-stat-card @(_isDeliveredQuickActive ? "active" : "")"
                    @onclick="@(() => SetDeliveryQuickAsync("delivered"))" title="تصفية الأوامر التي تم تسليمها">
                <span class="jo-stat-label">تم التسليم</span>
                <strong class="jo-stat-value">@_countDelivered</strong>
            </button>
            <button type="button" class="jo-stat-card overdue @(_overdueOnly ? "active" : "")"
                    @onclick="ToggleOverdueAsync" title="تصفية الأوامر المتأخرة التي مر موعد تسليمها ولم تُسلّم">
                <span class="jo-stat-label">متأخرة</span>
                <strong class="jo-stat-value">@_countOverdue</strong>
            </button>
            <button type="button" class="jo-stat-card @(_alternativesOnly ? "active" : "")"
                    @onclick="ToggleAlternativesAsync" title="تصفية الأوامر التي تحتوي على بدائل مختارة">
                <span class="jo-stat-label">بها بدائل مختارة</span>
                <strong class="jo-stat-value">@_countAlternatives</strong>
            </button>
        </div>

        <MudPaper Class="jo-filter-box" Elevation="0">
            <div class="jo-filter-grid single-row">
                <MudTextField T="string"
                              @bind-Value="_searchText"
                              Label="بحث باسم العميل / رقم الفاتورة / التليفون"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true"
                              Immediate="true"
                              DebounceInterval="400"
                              OnDebounceIntervalElapsed="OnSearchDebouncedAsync"
                              Class="jo-filter-control jo-search-field" />

                <MudSelect T="string" @bind-Value="_deliveryFilter" Label="حالة التسليم" Variant="Variant.Outlined" Class="jo-filter-control">
                    <MudSelectItem T="string" Value='@("undelivered")'>لم يتم التسليم بعد</MudSelectItem>
                    <MudSelectItem T="string" Value='@("delivered")'>تم التسليم</MudSelectItem>
                    <MudSelectItem T="string" Value='@("all")'>الكل</MudSelectItem>
                </MudSelect>

                <MudSelect T="string" @bind-Value="_typeFilter" Label="نوع الأمر" Variant="Variant.Outlined" Class="jo-filter-control">
                    <MudSelectItem T="string" Value='@("all")'>كل الأنواع</MudSelectItem>
                    <MudSelectItem T="string" Value='@("sale")'>أوامر بيع</MudSelectItem>
                    <MudSelectItem T="string" Value='@("purchase")'>أوامر توريد</MudSelectItem>
                </MudSelect>

                <MudDatePicker T="DateTime?" @bind-Date="_dueDateFrom" Label="من تاريخ التسليم" Variant="Variant.Outlined" Class="jo-filter-control" />
                <MudDatePicker T="DateTime?" @bind-Date="_dueDateTo" Label="إلى تاريخ التسليم" Variant="Variant.Outlined" Class="jo-filter-control" />

                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="LoadAsync"
                           Class="jo-filter-action">
                    بحث
                </MudButton>

                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="ClearSearch"
                           Class="jo-filter-action">
                    مسح
                </MudButton>
            </div>

            @if (HasActiveFilters)
            {
                <div class="jo-active-filters" aria-label="الفلاتر النشطة">
                    <span class="jo-active-filters-title">الفلاتر النشطة:</span>

                    @if (!string.IsNullOrWhiteSpace(_searchText))
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                 OnClose="ClearSearchTextAsync">
                            بحث: @_searchText.Trim()
                        </MudChip>
                    }

                    @if (!string.Equals(_deliveryFilter, DefaultDeliveryFilter, StringComparison.OrdinalIgnoreCase))
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                                 OnClose="ClearDeliveryFilterAsync">
                            حالة التسليم: @DeliveryFilterLabel
                        </MudChip>
                    }

                    @if (!string.Equals(_typeFilter, "all", StringComparison.OrdinalIgnoreCase))
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                 OnClose="ClearTypeFilterAsync">
                            نوع الأمر: @TypeFilterLabel
                        </MudChip>
                    }

                    @if (_dueDateFrom.HasValue || _dueDateTo.HasValue)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info"
                                 OnClose="ClearDueDateRangeAsync">
                            موعد التسليم: @DueDateRangeLabel
                        </MudChip>
                    }

                    @if (_overdueOnly)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                 OnClose="ClearOverdueFilterAsync">
                            متأخرة فقط
                        </MudChip>
                    }

                    @if (_alternativesOnly)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success"
                                 OnClose="ClearAlternativesFilterAsync">
                            بها بدائل مختارة فقط
                        </MudChip>
                    }

                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.ClearAll"
                               OnClick="ClearSearch">
                        مسح الكل
                    </MudButton>
                </div>
            }
        </MudPaper>

        <MudPaper Class="jo-table-shell" Elevation="0">
            <MudTable T="JobOrderRowVm" Items="_items" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Md" Elevation="0">
                <HeaderContent>
                    <MudTh>النوع</MudTh>
                    <MudTh>رقم الفاتورة</MudTh>
                    <MudTh>العميل</MudTh>
                    <MudTh>التليفون</MudTh>
                    <MudTh>تاريخ الفاتورة</MudTh>
                    <MudTh>التسليم المتوقع</MudTh>
                    <MudTh>الحالة</MudTh>
                    <MudTh>عدد البنود</MudTh>
                    <MudTh>بدائل مختارة</MudTh>
                    <MudTh>الإجمالي</MudTh>
                    <MudTh>إجراءات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        @if (context.IsPurchase)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled">
                                توريد
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                                بيع
                            </MudChip>
                        }
                    </MudTd>
                    <MudTd>
                        <div class="jo-cell-primary">
                            <strong>@context.ReferenceNumber</strong>
                            <small>#@context.TransactionId</small>
                        </div>
                    </MudTd>
                    <MudTd>
                        <div class="jo-cell-primary">
                            <strong>@context.PartyName</strong>
                            @if (!string.IsNullOrWhiteSpace(context.EmpName))
                            {
                                <small>الموظف: @context.EmpName</small>
                            }
                        </div>
                    </MudTd>
                    <MudTd>@(string.IsNullOrWhiteSpace(context.Phone) ? "—" : context.Phone)</MudTd>
                    <MudTd>@context.TransactionDate.ToString("yyyy/MM/dd")</MudTd>
                    <MudTd>@(context.DueDate?.ToString("yyyy/MM/dd") ?? "—")</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(context.IsDelivered ? Color.Success : Color.Warning)"
                                 Variant="Variant.Filled">
                            @(context.IsDelivered ? "تم التسليم" : "لم يتم التسليم بعد")
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">
                            @context.ItemsCount
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(context.AlternativeItemsCount > 0 ? Color.Success : Color.Default)"
                                 Variant="@(context.AlternativeItemsCount > 0 ? Variant.Filled : Variant.Outlined)">
                            @context.AlternativeItemsCount
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        @if (_canSeeAmounts)
                        {
                            <strong>@context.GrandTotal.ToString("N2")</strong>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </MudTd>
                    <MudTd>
                        <div class="jo-row-actions">
                            @if (!context.IsPurchase)
                            {
                                <MudTooltip Text="فتح أمر التشغيل">
                                    <MudIconButton Icon="@Icons.Material.Filled.Factory"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenJobOrder(context.TransactionId))" />
                                </MudTooltip>
                                <MudTooltip Text="طباعة أمر التشغيل">
                                    <MudIconButton Icon="@Icons.Material.Filled.Print"
                                                   Color="Color.Info"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenJobOrderPrint(context.TransactionId))" />
                                </MudTooltip>
                                <MudTooltip Text="ملف تشغيل العميل">
                                    <MudIconButton Icon="@Icons.Material.Filled.FolderShared"
                                                   Color="Color.Warning"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenCustomerJobOrder(context.PartyId))" />
                                </MudTooltip>
                                @if (_canCreateTask)
                                {
                                    <MudTooltip Text="تكليف جديد على أمر التشغيل">
                                        <MudIconButton Icon="@Icons.Material.Filled.AddTask"
                                                       Color="Color.Warning"
                                                       Size="Size.Small"
                                                       OnClick="@(() => OpenCreateTaskAsync(context))" />
                                    </MudTooltip>
                                }
                            }
                            @if (context.IsPurchase && _canOpenPurchaseJobOrder)
                            {
                                <MudTooltip Text="فتح أمر التشغيل">
                                    <MudIconButton Icon="@Icons.Material.Filled.Factory"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenJobOrder(context.TransactionId))" />
                                </MudTooltip>
                            }
                            @if (_canEditDueDate && !context.IsDelivered)
                            {
                                <MudTooltip Text="تعديل تاريخ التسليم / الاستلام">
                                    <MudIconButton Icon="@Icons.Material.Filled.EditCalendar"
                                                   Color="Color.Secondary"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenDueDateDialog(context))" />
                                </MudTooltip>
                            }
                            @if (_canOpenInvoices)
                            {
                                <MudTooltip Text="فتح الفاتورة">
                                    <MudIconButton Icon="@Icons.Material.Filled.ReceiptLong"
                                                   Color="Color.Success"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenInvoice(context.TransactionId))" />
                                </MudTooltip>
                            }
                        </div>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="jo-empty-box">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Large" />
                        <span>لا توجد أوامر تشغيل مطابقة.</span>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </div>
}

<MudDialog @bind-Visible="_showDueDateDialog">
    <TitleContent>
        <div style="display:flex;align-items:center;gap:.6rem;">
            <MudIcon Icon="@Icons.Material.Filled.EditCalendar" Color="Color.Secondary" />
            <MudText Typo="Typo.h6">تعديل تاريخ التسليم المتوقع</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">الفاتورة: <strong>@_editReferenceNumber</strong></MudText>
        <MudDatePicker T="DateTime?" @bind-Date="_editDueDate" Label="تاريخ التسليم الجديد" Variant="Variant.Outlined" />
        <MudTextField T="string" @bind-Value="_editDueDateNotes" Label="ملاحظات التعديل" Variant="Variant.Outlined" Lines="3" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="CloseDueDateDialog">إلغاء</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="SaveDueDateAsync" Disabled="@_isSavingDueDate">حفظ</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .job-orders-page { padding: 0 1rem 2rem; }
    .job-orders-loading { min-height: 60vh; display:flex; flex-direction:column; align-items:center; justify-content:center; }
    .jo-header { position:relative; border-radius:22px; overflow:hidden; margin-bottom:1rem; box-shadow:0 10px 30px rgba(15,23,42,.12); }
    .jo-header-bg { position:absolute; inset:0; background:linear-gradient(135deg,#0f172a 0%, #1e3a8a 55%, #3b82f6 100%); }
    .jo-header-content { position:relative; z-index:1; padding:1.5rem 1.75rem; display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; color:#fff; }
    .jo-badge { display:inline-block; margin-bottom:.45rem; padding:.28rem .7rem; border-radius:999px; background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.18); font-size:.72rem; font-weight:800; }
    .jo-header-content h1 { margin:0; font-size:1.45rem; font-weight:900; }
    .jo-header-content p { margin:.25rem 0 0; opacity:.86; }

    .jo-stats-row { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:.75rem; margin-bottom:1rem; }
    .jo-stat-card { width:100%; font:inherit; text-align:right; cursor:pointer; background:var(--mud-palette-surface); border:1px solid var(--mud-palette-lines-default); border-radius:16px; padding:1rem 1.1rem; box-shadow:0 2px 10px rgba(0,0,0,.04); transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease, background-color .18s ease; }
    .jo-stat-card:hover { transform:translateY(-2px); box-shadow:0 8px 20px rgba(15,23,42,.10); }
    .jo-stat-card:focus-visible { outline:3px solid var(--mud-palette-primary); outline-offset:2px; }
    .jo-stat-card.active { border-color:var(--mud-palette-primary); background:color-mix(in srgb, var(--mud-palette-primary) 9%, var(--mud-palette-surface)); box-shadow:0 0 0 2px color-mix(in srgb, var(--mud-palette-primary) 28%, transparent), 0 8px 20px rgba(15,23,42,.08); }
    .jo-stat-card.overdue.active { border-color:var(--mud-palette-error); background:color-mix(in srgb, var(--mud-palette-error) 8%, var(--mud-palette-surface)); box-shadow:0 0 0 2px color-mix(in srgb, var(--mud-palette-error) 25%, transparent), 0 8px 20px rgba(15,23,42,.08); }
    .jo-stat-label { display:block; color:var(--mud-palette-text-secondary); font-size:.8rem; font-weight:700; }
    .jo-stat-value { display:block; color:var(--mud-palette-text-primary); font-size:1.35rem; font-weight:900; margin-top:.15rem; }

    .jo-filter-box { position:sticky; top:.75rem; z-index:20; background:var(--mud-palette-surface); border-radius:18px; border:1px solid var(--mud-palette-lines-default); padding:1rem; margin-bottom:1rem; box-shadow:0 10px 28px rgba(15,23,42,.10); }
    .jo-filter-grid { display:grid; gap:.75rem; align-items:center; }
    .jo-filter-grid.single-row { grid-template-columns:minmax(220px,2.2fr) minmax(150px,1fr) minmax(150px,1fr) minmax(140px,.9fr) minmax(140px,.9fr) auto auto; }
    .jo-filter-control, .jo-filter-action { min-width:0; }
    .jo-filter-action { white-space:nowrap; }
    .jo-search-field { min-width:0; }
    .jo-active-filters { display:flex; align-items:center; flex-wrap:wrap; gap:.45rem; margin-top:.85rem; padding-top:.85rem; border-top:1px solid var(--mud-palette-lines-default); }
    .jo-active-filters-title { color:var(--mud-palette-text-secondary); font-size:.78rem; font-weight:800; }

    .jo-table-shell { border-radius:18px; border:1px solid var(--mud-palette-lines-default); overflow:hidden; background:var(--mud-palette-surface); box-shadow:0 4px 16px rgba(0,0,0,.04); }
    .jo-cell-primary { display:flex; flex-direction:column; gap:.12rem; }
    .jo-cell-primary small { color:var(--mud-palette-text-secondary); font-size:.74rem; }
    .jo-row-actions { display:flex; align-items:center; gap:.2rem; }
    .jo-empty-box { padding:2rem; display:flex; flex-direction:column; gap:.5rem; align-items:center; justify-content:center; color:var(--mud-palette-text-secondary); }

    @@media (min-width: 900px) and (max-width: 1279px) {
        .jo-filter-grid.single-row { grid-template-columns:repeat(6,minmax(0,1fr)); }
        .jo-filter-grid.single-row .jo-search-field { grid-column:1 / -1; }
    }

    @@media (max-width: 899px) {
        .jo-filter-box { top:.5rem; padding:.85rem; }
        .jo-filter-grid.single-row { grid-template-columns:repeat(2,minmax(0,1fr)); }
        .jo-filter-grid.single-row .jo-search-field { grid-column:1 / -1; }
        .jo-header-content { padding:1.25rem 1rem; }
    }

    @@media (max-width: 420px) {
        .jo-stats-row { grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); }
        .jo-stat-card { padding:.85rem .9rem; }
    }
</style>

@code {
    private bool _isLoading = true;
    private bool _isExporting;
    private bool _canView;
    private bool _canOpenInvoices;
    private bool _canOpenPurchaseJobOrder;
    private bool _canSeeAmounts;
    private bool _canEditDueDate;
    private bool _canCreateTask;
    private bool _canSeeRealDate = true;
    private int _dateBufferDays = 4;
    private const string DefaultDeliveryFilter = "undelivered";
    private const string FiltersStorageKey = "jobOrdersFilters.v1";
    private string _deliveryFilter = DefaultDeliveryFilter;
    private string _typeFilter = "all";
    private DateTime? _dueDateFrom;
    private DateTime? _dueDateTo;
    private string? _searchText;
    private bool _alternativesOnly;
    private bool _overdueOnly;
    private bool _filtersRestored;
    private int _countAll;
    private int _countUndelivered;
    private int _countDelivered;
    private int _countOverdue;
    private int _countAlternatives;
    private bool _showDueDateDialog;
    private bool _isSavingDueDate;
    private bool _dueDateSaved;
    private int _editTransactionId;
    private string _editReferenceNumber = "";
    private DateTime? _editDueDate;
    private string? _editDueDateNotes;
    private List<JobOrderRowVm> _items = new();

    // ⭐ بوابة تسلسل الوصول إلى قاعدة البيانات: الصفحة تستخدم نسخة DbContext واحدة مشتركة،
    // فتُسلسَل كل العمليات عليها (تحميل/تصدير/حفظ تاريخ) حتى لا تتداخل عمليتان في نفس اللحظة
    // فيظهر خطأ «A second operation was started on this context instance».
    private readonly SemaphoreSlim _dbGate = new(1, 1);

    private bool _isAllQuickActive =>
        !_overdueOnly && !_alternativesOnly
        && string.Equals(_deliveryFilter, "all", StringComparison.OrdinalIgnoreCase);

    private bool _isUndeliveredQuickActive =>
        !_overdueOnly
        && string.Equals(_deliveryFilter, "undelivered", StringComparison.OrdinalIgnoreCase);

    private bool _isDeliveredQuickActive =>
        !_overdueOnly
        && string.Equals(_deliveryFilter, "delivered", StringComparison.OrdinalIgnoreCase);

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchText)
        || !string.Equals(_deliveryFilter, DefaultDeliveryFilter, StringComparison.OrdinalIgnoreCase)
        || !string.Equals(_typeFilter, "all", StringComparison.OrdinalIgnoreCase)
        || _dueDateFrom.HasValue
        || _dueDateTo.HasValue
        || _overdueOnly
        || _alternativesOnly;

