    // ⭐ تصدير أوامر التشغيل حسب الفلتر الحالي بالكامل — بدون أي مبالغ
    private async Task ExportToExcelAsync()
    {
        if (!_canView || _isExporting)
            return;

        _isExporting = true;
        await _dbGate.WaitAsync();
        try
        {
            var query = Db.Transactions
                .AsNoTracking()
                .Where(t => t.InvoiceStatus != InvoiceStatuses.Cancelled
                    && ((t.TransactionType == TransactionTypes.Sale)
                     || (t.TransactionType == TransactionTypes.Purchase
                         && (t.ReferenceType == null || !t.ReferenceType.StartsWith("MirrorOf:")))));

            query = _typeFilter switch
            {
                "sale" => query.Where(t => t.TransactionType == TransactionTypes.Sale),
                "purchase" => query.Where(t => t.TransactionType == TransactionTypes.Purchase),
                _ => query
            };

            // نفس دلالة القائمة: حدود النطاق وعتبة «متأخرة» على التواريخ المعروضة للمستخدم الحالي.
            var rangeFrom = ShiftRangeBound(_dueDateFrom);
            var rangeTo = ShiftRangeBound(_dueDateTo);

            if (rangeFrom.HasValue)
                query = query.Where(t => t.DueDate.HasValue && t.DueDate.Value >= rangeFrom.Value.Date);

            if (rangeTo.HasValue)
                query = query.Where(t => t.DueDate.HasValue && t.DueDate.Value <= rangeTo.Value.Date.AddDays(1).AddTicks(-1));

            if (_overdueOnly)
            {
                var threshold = OverdueThreshold;
                query = query.Where(t => t.DueDate.HasValue
                    && t.DueDate.Value.Date < threshold
                    && t.IsDelivered != true);
            }
            else
            {
                query = _deliveryFilter switch
                {
                    "delivered" => query.Where(t => t.IsDelivered == true),
                    "all" => query,
                    _ => query.Where(t => t.IsDelivered != true)
                };
            }

            if (_alternativesOnly)
                query = query.Where(t => Db.TransactionDetails.Any(d =>
                    d.TransactionId == t.TransactionId && d.SelectedAlternativeId != null));

            // ⭐ القناع على مستوى البيانات: GrandTotal لا يُختار من قاعدة البيانات نهائياً
            var projected = query.Select(t => new JobOrderRowVm
            {
                TransactionId = t.TransactionId,
                ReferenceNumber = t.ReferenceNumber ?? $"#{t.TransactionId}",
                TransactionType = t.TransactionType,
                TransactionDate = t.TransactionDate,
                DueDate = t.DueDate,
                RealDueDate = t.DueDate,
                IsDelivered = t.IsDelivered == true,
                PartyName = Db.Parties.Where(p => p.PartyId == t.PartyId).Select(p => p.PartyName).FirstOrDefault() ?? "",
                Phone = Db.Parties.Where(p => p.PartyId == t.PartyId).Select(p => p.Phone).FirstOrDefault(),
                EmpName = t.EmpId == null ? null : Db.Employees.Where(e => e.EmployeeId == t.EmpId).Select(e => e.FullName).FirstOrDefault(),
                ItemsCount = Db.TransactionDetails.Count(d => d.TransactionId == t.TransactionId),
                AlternativeItemsCount = Db.TransactionDetails.Count(d => d.TransactionId == t.TransactionId && d.SelectedAlternativeId != null)
            });

            var rows = await projected
                .OrderByDescending(x => x.TransactionDate)
                .ThenByDescending(x => x.TransactionId)
                .Take(400)
                .ToListAsync();

            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                var term = _searchText.Trim();
                rows = rows.Where(x =>
                        (x.ReferenceNumber ?? string.Empty).Contains(term, StringComparison.OrdinalIgnoreCase)
                        || (x.PartyName ?? string.Empty).ContainsArabic(term)
                        || (x.Phone ?? string.Empty).ContainsArabic(term))
                    .ToList();
            }

            // التصدير يعرض نفس التواريخ المعروضة في القائمة — الإخفاء يطال الملف أيضًا.
            foreach (var exportRow in rows)
                exportRow.DueDate = GetDisplayDueDate(exportRow.RealDueDate, exportRow.TransactionDate);

            using var workbook = new XLWorkbook();
            var sheet = workbook.Worksheets.Add("أوامر التشغيل");
            sheet.RightToLeft = true;
            sheet.ColumnWidth = 14;
            sheet.Column(2).Width = 18;
            sheet.Column(3).Width = 28;
            sheet.Column(4).Width = 16;
            sheet.Column(5).Width = 14;
            sheet.Column(6).Width = 15;
            sheet.Column(7).Width = 15;

            var headers = new[] { "#", "النوع", "رقم الفاتورة", "العميل", "الموظف", "التليفون", "تاريخ الفاتورة", "التسليم المتوقع", "عدد البنود", "بدائل مختارة" };
            for (int i = 0; i < headers.Length; i++)
            {
                var cell = sheet.Cell(1, i + 1);
                cell.Value = headers[i];
                cell.Style.Font.Bold = true;
                cell.Style.Fill.BackgroundColor = XLColor.FromHtml("#D4A853");
                cell.Style.Font.FontColor = XLColor.White;
                cell.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            }

            int row = 2;
            for (int i = 0; i < rows.Count; i++)
            {
                var x = rows[i];
                sheet.Cell(row, 1).Value = i + 1;
                sheet.Cell(row, 2).Value = x.IsPurchase ? "توريد" : "بيع";
                sheet.Cell(row, 3).Value = x.ReferenceNumber;
                sheet.Cell(row, 4).Value = x.PartyName;
                sheet.Cell(row, 5).Value = x.EmpName ?? "—";
                sheet.Cell(row, 6).Value = string.IsNullOrWhiteSpace(x.Phone) ? "—" : x.Phone;
                sheet.Cell(row, 7).Value = x.TransactionDate.ToString("yyyy/MM/dd");
                sheet.Cell(row, 8).Value = x.DueDate?.ToString("yyyy/MM/dd") ?? "—";
                sheet.Cell(row, 9).Value = x.ItemsCount;
                sheet.Cell(row, 10).Value = x.AlternativeItemsCount;
                sheet.Cell(row, 4).Style.Font.Bold = true;
                row++;
            }

            sheet.SheetView.FreezeRows(1);

            using var stream = new MemoryStream();
            workbook.SaveAs(stream);
            stream.Seek(0, SeekOrigin.Begin);
            var bytes = stream.ToArray();
            var fileName = $"JobOrders_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";

            await JS.InvokeVoidAsync("eval", $@"
    var a = document.createElement('a');
    a.download = '{fileName}';
    a.href = 'data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{Convert.ToBase64String(bytes)}';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
");

            Snackbar.Add($"تم تصدير {rows.Count} أمر تشغيل حسب الفلتر الحالي (بدون مبالغ)", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ أثناء التصدير: {ex.Message}", Severity.Error);
        }
        finally
        {
            _dbGate.Release();
            _isExporting = false;
            StateHasChanged();
        }
    }

    // ⭐ طباعة حسب الفلتر الحالي بالكامل — بدون أي مبالغ
    private async Task OpenPrint()
    {
        if (!_canView)
            return;

        var qs = new List<string>();
        if (!string.IsNullOrWhiteSpace(_searchText))
            qs.Add("q=" + Uri.EscapeDataString(_searchText.Trim()));
        if (_dueDateFrom.HasValue)
            qs.Add("from=" + Uri.EscapeDataString(_dueDateFrom.Value.ToString("yyyy-MM-dd")));
        if (_dueDateTo.HasValue)
            qs.Add("to=" + Uri.EscapeDataString(_dueDateTo.Value.ToString("yyyy-MM-dd")));
        if (!string.Equals(_typeFilter, "all", StringComparison.OrdinalIgnoreCase))
            qs.Add("type=" + Uri.EscapeDataString(_typeFilter));
        if (!string.Equals(_deliveryFilter, DefaultDeliveryFilter, StringComparison.OrdinalIgnoreCase))
            qs.Add("delivery=" + Uri.EscapeDataString(_deliveryFilter));
        if (_overdueOnly)
            qs.Add("overdue=1");
        if (_alternativesOnly)
            qs.Add("alt=1");

        var url = "/production/job-orders/print" + (qs.Count > 0 ? "?" + string.Join("&", qs) : "");
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

