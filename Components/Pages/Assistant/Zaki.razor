@page "/zaki"

@using COCOBOLOERPNEW.Components.Shared
@using COCOBOLOERPNEW.Services.Assistant
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject ZakiAssistantService ZakiService
@inject ZakiChatState State
@inject AuthenticationStateProvider AuthProvider
@inject ZakiUserContext UserCtx

@attribute [Authorize]

<PageTitle>زكي — المساعد الذكي</PageTitle>

<div class="zk-page">

    @if (!_canUse)
    {
        <MudAlert Severity="Severity.Warning" Class="mt-4">ليس لديك صلاحية لاستخدام زكي.</MudAlert>
    }
    else
    {
        <!-- ═══ الهيدر ═══ -->
        <section class="zk-hero">
            <div class="zk-avatar">
                <img src="img/zaki-icon.png" class="zk-avatar-img" alt="زكي" />
            </div>
            <div class="zk-hero-text">
                <div class="zk-title">زكي</div>
                <div class="zk-sub">
                    أهلاً يا @_displayName — مساعدك الذكي: يقرأ بيانات النظام حسب صلاحياتك ويجاوبك في ثواني.
                </div>
            </div>
            <div class="zk-toolbar">
                <MudButton Variant="Variant.Outlined"
                           Class="zk-ghost-btn"
                           StartIcon="@Icons.Material.Filled.PictureInPicture"
                           OnClick="OpenMini">
                    نافذة صغيرة
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Class="zk-ghost-btn"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="NewChat">
                    محادثة جديدة
                </MudButton>
            </div>
        </section>

        <ZakiChatPanel />
    }

</div>

@code {
    private bool _canUse;
    private string _displayName = "";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        _canUse = ZakiService.CanUse(auth.User);
        _displayName = (await UserCtx.ResolveAsync(auth.User)).DisplayName;
    }

    /// <summary>يفتح النافذة الصغيرة جنب الصفحة بنفس المحادثة</summary>
    private void OpenMini() => State.SetMiniOpen(true);

    /// <summary>محادثة جديدة: نمسح الشاشة ونبدأ من جديد</summary>
    private void NewChat() => State.Clear();
}
