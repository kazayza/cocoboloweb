@page "/assistant/usage"
@using System.Globalization
@using COCOBOLOERPNEW.Services.Assistant
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@inject ZakiUsageReportService ReportService
@inject ZakiLogService LogService

<PageTitle>استخدام زكي</PageTitle>

<style>
    .zku { min-height: 60vh; }
    .zku-wrap { padding-top: 20px !important; padding-bottom: 32px !important; }

    /* ── الهيدر ── */
    .zku-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 18px; }
    .zku-title { display: flex; align-items: center; gap: 14px; }
    .zku-title h1 { font-size: 22px; font-weight: 800; margin: 0; color: var(--mud-palette-text-primary); }
    .zku-title p { margin: 2px 0 0; font-size: 13px; color: var(--mud-palette-text-secondary); }
    .zku-logo { width: 46px; height: 46px; border-radius: 14px; display: flex; align-items: center; justify-content: center;
                background: linear-gradient(135deg, #3B82F6, #8B5CF6); color: #fff; box-shadow: 0 6px 16px rgba(59,130,246,.3); }
    .zku-tools { display: flex; align-items: center; gap: 8px; }
    .zku-select { width: 150px; }

    /* ── الكروت الرئيسية ── */
    .zku-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; margin-bottom: 14px; }
    .zku-kpi { background: var(--mud-palette-surface); border: 1px solid var(--mud-palette-divider); border-radius: 14px;
               padding: 14px 16px; display: flex; align-items: center; gap: 12px; border-inline-start: 4px solid var(--kpi, #3B82F6); }
    .zku-kpi__ic { width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center;
                   background: color-mix(in srgb, var(--kpi, #3B82F6) 14%, transparent); color: var(--kpi, #3B82F6); flex: 0 0 auto; }
    .zku-kpi__v { font-size: 20px; font-weight: 800; line-height: 1.1; color: var(--mud-palette-text-primary); }
    .zku-kpi__l { font-size: 12px; color: var(--mud-palette-text-secondary); font-weight: 600; margin-top: 2px; }
    .zku-kpi__s { font-size: 11px; color: var(--mud-palette-text-secondary); opacity: .85; }

    /* ── الشبكة والكروت ── */
    .zku-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 14px; margin-bottom: 14px; }
    .zku-grid--half { grid-template-columns: 1fr 1fr; }
    .zku-card { background: var(--mud-palette-surface); border: 1px solid var(--mud-palette-divider); border-radius: 16px; padding: 16px 18px; min-width: 0; }
    .zku-card__head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-bottom: 12px; }
    .zku-card__head h2 { font-size: 15px; font-weight: 800; margin: 0; color: var(--mud-palette-text-primary); }
    .zku-card__head span { font-size: 12px; color: var(--mud-palette-text-secondary); }
    .zku-empty { padding: 28px 8px; text-align: center; color: var(--mud-palette-text-secondary); font-size: 13px; }

    /* ── جدول ── */
    .zku-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .zku-table th { text-align: start; font-weight: 700; color: var(--mud-palette-text-secondary); font-size: 12px;
                    padding: 8px 6px; border-bottom: 1px solid var(--mud-palette-divider); white-space: nowrap; }
    .zku-table td { padding: 9px 6px; border-bottom: 1px solid var(--mud-palette-lines-default, rgba(0,0,0,.06)); vertical-align: middle; color: var(--mud-palette-text-primary); }
    .zku-table tr:last-child td { border-bottom: none; }
    .zku-table .num { text-align: center; font-variant-numeric: tabular-nums; }
    .zku-name { font-weight: 700; margin-bottom: 4px; }
    .zku-sub { font-size: 11px; color: var(--mud-palette-text-secondary); direction: ltr; text-align: start; }
    .zku-bad { color: #EF4444; font-weight: 700; }
    .zku-q { max-width: 340px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* ── تقييم الردود ── */
    .zku-fb-row { margin-bottom: 14px; }
    .zku-fb-row__top { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px; color: var(--mud-palette-text-primary); }
    .zku-fb-big { font-size: 30px; font-weight: 800; color: var(--mud-palette-text-primary); line-height: 1.1; }

    .zku-alert { margin-bottom: 14px; }

    /* ── رسم الحركة اليومية ── */
    .zku-bars { display: flex; align-items: stretch; gap: 3px; height: 240px; overflow-x: auto; padding-bottom: 2px; }
    .zku-bar-col { flex: 1 0 12px; min-width: 12px; display: flex; flex-direction: column; height: 100%; }
    .zku-bar-track { flex: 1; display: flex; align-items: flex-end; }
    .zku-bar { width: 100%; background: rgba(59,130,246,.22); border-radius: 4px 4px 0 0; display: flex; align-items: flex-end; min-height: 2px; }
    .zku-bar-ok { width: 100%; background: #3B82F6; border-radius: 4px 4px 0 0; min-height: 0; }
    .zku-bar-lbl { height: 16px; font-size: 10px; color: var(--mud-palette-text-secondary); text-align: center; white-space: nowrap; direction: ltr; margin-top: 4px; }

    @@media (max-width: 960px) {
        .zku-grid, .zku-grid--half { grid-template-columns: 1fr; }
        .zku-select { width: 130px; }
    }
</style>

<div dir="rtl" class="zku">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="zku-wrap">

        <div class="zku-head">
            <div class="zku-title">
                <div class="zku-logo"><MudIcon Icon="@Icons.Material.Filled.SmartToy" /></div>
                <div>
                    <h1>استخدام زكي</h1>
                    <p>الأسئلة، جودة الردود، والأخطاء في نظرة واحدة</p>
                </div>
            </div>
            <div class="zku-tools">
                <MudSelect T="int" Value="_days" ValueChanged="OnDaysChanged" Variant="Variant.Outlined"
                           Dense="true" Label="الفترة" Class="zku-select">
                    <MudSelectItem T="int" Value="7">آخر 7 أيام</MudSelectItem>
                    <MudSelectItem T="int" Value="30">آخر 30 يوم</MudSelectItem>
                    <MudSelectItem T="int" Value="90">آخر 90 يوم</MudSelectItem>
                </MudSelect>
                <MudTooltip Text="تحديث">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Color="Color.Default" />
                </MudTooltip>
            </div>
        </div>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
        }
        else
        {
            @if (_quality is not null && _quality.Errors24h >= AlertErrorsIn24h)
            {
                <MudAlert Severity="Severity.Error" Class="zku-alert">
                    في <b>@_quality.Errors24h</b> خطأ في زكي خلال آخر 24 ساعة. راجع جدول الأخطاء تحت.
                </MudAlert>
            }

            @if (_quality is null)
            {
                <MudAlert Severity="Severity.Warning" Class="zku-alert">
                    بيانات التقييم مش متاحة. اتأكد إن جدول AssistantFeedback اتعمل (شغّل Database/ZakiAssistant_Feedback.sql).
                </MudAlert>
            }

            @* ═══ الكروت الرئيسية ═══ *@
            <div class="zku-kpis">
                <div class="zku-kpi" style="--kpi:#3B82F6">
                    <div class="zku-kpi__ic"><MudIcon Icon="@Icons.Material.Filled.Forum" /></div>
                    <div>
                        <div class="zku-kpi__v">@_report.TotalQuestions.ToString("N0")</div>
                        <div class="zku-kpi__l">أسئلة في الفترة</div>
                    </div>
                </div>

                <div class="zku-kpi" style="--kpi:#10B981">
                    <div class="zku-kpi__ic"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" /></div>
                    <div>
                        <div class="zku-kpi__v">@_report.SuccessRate%</div>
                        <div class="zku-kpi__l">نسبة الردود الناجحة</div>
                        <div class="zku-kpi__s">@(_report.TotalQuestions - _report.TotalSuccess) رد فيه مشكلة</div>
                    </div>
                </div>

                <div class="zku-kpi" style="--kpi:#8B5CF6">
                    <div class="zku-kpi__ic"><MudIcon Icon="@Icons.Material.Filled.Token" /></div>
                    <div>
                        <div class="zku-kpi__v">@_report.TotalTokens.ToString("N0")</div>
                        <div class="zku-kpi__l">توكنز مستهلكة</div>
                    </div>
                </div>

                <div class="zku-kpi" style="--kpi:#F59E0B">
                    <div class="zku-kpi__ic"><MudIcon Icon="@Icons.Material.Filled.Timer" /></div>
                    <div>
                        <div class="zku-kpi__v">@Seconds(_report.AvgDurationMs)</div>
                        <div class="zku-kpi__l">متوسط وقت الرد</div>
                    </div>
                </div>

                <div class="zku-kpi" style="--kpi:@ErrorKpiColor">
                    <div class="zku-kpi__ic"><MudIcon Icon="@Icons.Material.Filled.ErrorOutline" /></div>
                    <div>
                        <div class="zku-kpi__v">@(_quality?.Errors24h ?? 0)</div>
                        <div class="zku-kpi__l">أخطاء آخر 24 ساعة</div>
                    </div>
                </div>
            </div>

            @* ═══ الحركة اليومية + تقييم الردود ═══ *@
            <div class="zku-grid">
                <section class="zku-card">
                    <div class="zku-card__head">
                        <h2>الحركة اليومية</h2>
                        <span>الأسئلة والردود الناجحة</span>
                    </div>
                    @if (_report.TotalQuestions == 0)
                    {
                        <div class="zku-empty">مفيش أسئلة في الفترة دي</div>
                    }
                    else
                    {
                        <div class="zku-bars">
                            @foreach (var b in _bars)
                            {
                                <div class="zku-bar-col" title="@b.Title">
                                    <div class="zku-bar-track">
                                        <div class="zku-bar" style="height:@(b.Pct)%">
                                            <div class="zku-bar-ok" style="height:@(b.OkPct)%"></div>
                                        </div>
                                    </div>
                                    <div class="zku-bar-lbl">@b.Label</div>
                                </div>
                            }
                        </div>
                        <div class="zku-kpi__s" style="margin-top:6px;">
                            <span style="display:inline-block;width:10px;height:10px;background:#3B82F6;border-radius:2px;"></span> الناجحة
                            &nbsp;&nbsp;
                            <span style="display:inline-block;width:10px;height:10px;background:rgba(59,130,246,.22);border-radius:2px;"></span> الكل
                        </div>
                    }
                </section>

                <section class="zku-card">
                    <div class="zku-card__head">
                        <h2>تقييم الردود</h2>
                        <span>👍 / 👎 من المستخدمين</span>
                    </div>

                    <div class="zku-fb-big">@UsefulRate()</div>
                    <div class="zku-kpi__l" style="margin-bottom:14px;">نسبة الردود المفيدة من التقييمات</div>

                    <div class="zku-fb-row">
                        <div class="zku-fb-row__top"><span>مفيد 👍</span><b>@(_quality?.ThumbsUp ?? 0)</b></div>
                        <MudProgressLinear Value="@Share(_quality?.ThumbsUp ?? 0, RatedTotal())" Color="Color.Success" Rounded="true" Size="Size.Small" />
                    </div>
                    <div class="zku-fb-row">
                        <div class="zku-fb-row__top"><span>مش مفيد 👎</span><b>@(_quality?.ThumbsDown ?? 0)</b></div>
                        <MudProgressLinear Value="@Share(_quality?.ThumbsDown ?? 0, RatedTotal())" Color="Color.Error" Rounded="true" Size="Size.Small" />
                    </div>
                    <div class="zku-kpi__s">
                        التقييم اختياري، فالأرقام دي بتمثل اللي اتقيّم بس.
                    </div>
                </section>
            </div>

            @* ═══ الأدوات + أكتر المستخدمين ═══ *@
            <div class="zku-grid">
                <section class="zku-card">
                    <div class="zku-card__head">
                        <h2>الأدوات الأكتر استخدام</h2>
                        <span>@_report.Tools.Count أداة</span>
                    </div>
                    @if (_report.Tools.Count == 0)
                    {
                        <div class="zku-empty">مفيش استخدام لأدوات في الفترة دي</div>
                    }
                    else
                    {
                        var maxCalls = _report.Tools.Max(t => t.Calls);
                        <table class="zku-table">
                            <thead>
                                <tr>
                                    <th>الأداة</th>
                                    <th class="num">مرات الاستخدام</th>
                                    <th class="num">مرفوضة</th>
                                    <th class="num">متوسط الوقت</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in _report.Tools.OrderByDescending(x => x.Calls).Take(15))
                                {
                                    <tr>
                                        <td style="min-width:200px;">
                                            <div class="zku-name">@ZakiLabels.Tool(t.ToolName)</div>
                                            <MudProgressLinear Value="@Share(t.Calls, maxCalls)" Color="Color.Primary" Rounded="true" Size="Size.Small" />
                                        </td>
                                        <td class="num"><b>@t.Calls</b></td>
                                        <td class="num @(t.Denied > 0 ? "zku-bad" : "")">@t.Denied</td>
                                        <td class="num">@Ms(t.AvgDurationMs)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>

                <section class="zku-card">
                    <div class="zku-card__head">
                        <h2>أكتر المستخدمين</h2>
                        <span>@_report.TopUsers.Count مستخدم</span>
                    </div>
                    @if (_report.TopUsers.Count == 0)
                    {
                        <div class="zku-empty">مفيش مستخدمين في الفترة دي</div>
                    }
                    else
                    {
                        <table class="zku-table">
                            <thead>
                                <tr>
                                    <th>المستخدم</th>
                                    <th class="num">أسئلة</th>
                                    <th class="num">توكنز</th>
                                    <th>آخر استخدام</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in _report.TopUsers.Take(15))
                                {
                                    <tr>
                                        <td><b>@u.UserName</b></td>
                                        <td class="num">@u.Questions</td>
                                        <td class="num">@u.Tokens.ToString("N0")</td>
                                        <td>@u.LastUsed.ToString("yyyy-MM-dd HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>
            </div>

            @* ═══ الأخطاء + الردود اللي اتعلّم عليها مش مفيد ═══ *@
            <div class="zku-grid zku-grid--half">
                <section class="zku-card">
                    <div class="zku-card__head">
                        <h2>الأخطاء</h2>
                        <span>حسب النوع</span>
                    </div>
                    @if (_report.Errors.Count == 0)
                    {
                        <div class="zku-empty">✅ مفيش أخطاء في الفترة دي</div>
                    }
                    else
                    {
                        <table class="zku-table">
                            <thead>
                                <tr>
                                    <th>الخطأ</th>
                                    <th class="num">العدد</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in _report.Errors)
                                {
                                    <tr>
                                        <td>
                                            <div class="zku-name">@ZakiLabels.Error(e.ErrorCode)</div>
                                            <div style="font-size:12px;color:var(--mud-palette-text-secondary);">@ZakiLabels.ErrorHint(e.ErrorCode)</div>
                                            <div class="zku-sub">@e.ErrorCode</div>
                                        </td>
                                        <td class="num zku-bad">@e.Count</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>

                <section class="zku-card">
                    <div class="zku-card__head">
                        <h2>ردود اتعلّم عليها مش مفيد</h2>
                        <span>آخر 10</span>
                    </div>
                    @if (_quality is null || _quality.RecentThumbsDown.Count == 0)
                    {
                        <div class="zku-empty">مفيش ردود متعلّم عليها مش مفيد 🎉</div>
                    }
                    else
                    {
                        <table class="zku-table">
                            <thead>
                                <tr>
                                    <th>التاريخ</th>
                                    <th>السؤال</th>
                                    <th>الخطأ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in _quality.RecentThumbsDown)
                                {
                                    <tr>
                                        <td style="white-space:nowrap;">
                                            @b.CreatedAt.ToString("MM-dd HH:mm")
                                            <div class="zku-sub">@b.UserName</div>
                                        </td>
                                        <td><div class="zku-q" title="@b.QuestionText">@(b.QuestionText ?? "— (نص السؤال مش متخزن)")</div></td>
                                        <td>@(b.ErrorCode is null ? "—" : ZakiLabels.Error(b.ErrorCode))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>
            </div>
        }
    </MudContainer>
</div>

@code {
    private ZakiUsageReport _report = new();
    private ZakiQualityOverview? _quality;
    private List<DayBar> _bars = new();
    private int _days = 30;
    private bool _loading = true;
    private const int AlertErrorsIn24h = 5;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _report = await ReportService.GetReportAsync(_days);
        _quality = await LogService.GetQualityOverviewAsync(_days);
        BuildDaily();
        _loading = false;
    }

    private async Task OnDaysChanged(int days)
    {
        _days = days;
        await LoadAsync();
    }

    /// <summary>صف في الرسم: يوم واحد (النسب بأرقام صحيحة عشان الـ CSS)</summary>
    private sealed record DayBar(string Label, string Title, int Pct, int OkPct);

    /// <summary>كل يوم في الفترة (حتى الأيام اللي مفيهاش أسئلة) عشان الرسم يبان صح</summary>
    private void BuildDaily()
    {
        var byDay = _report.Daily
            .GroupBy(d => d.Day.Date)
            .ToDictionary(g => g.Key, g => (Questions: g.Sum(x => x.Questions), Success: g.Sum(x => x.Success)));

        var days = Enumerable.Range(0, _days)
            .Select(i => DateTime.Today.AddDays(i - (_days - 1)))
            .ToList();

        var max = Math.Max(1, days.Max(d => byDay.TryGetValue(d, out var v) ? v.Questions : 0));
        var step = Math.Max(1, _days / 10);

        _bars = days.Select((d, idx) =>
        {
            var q = byDay.TryGetValue(d, out var v) ? v.Questions : 0;
            var ok = byDay.TryGetValue(d, out var v2) ? v2.Success : 0;
            var pct = (int)Math.Round(100.0 * q / max);
            var okPct = q == 0 ? 0 : (int)Math.Round(100.0 * ok / q);
            var label = (_days <= 7 || idx % step == 0 || idx == days.Count - 1)
                ? d.ToString("dd/MM", CultureInfo.InvariantCulture)
                : "";
            return new DayBar(label, $"{d.ToString("dd/MM", CultureInfo.InvariantCulture)}: {q} سؤال، {ok} ناجح", pct, okPct);
        }).ToList();
    }

    private string ErrorKpiColor => _quality is not null && _quality.Errors24h >= AlertErrorsIn24h ? "#EF4444" : "#64748B";

    private int RatedTotal() => (_quality?.ThumbsUp ?? 0) + (_quality?.ThumbsDown ?? 0);

    private string UsefulRate()
    {
        var rated = RatedTotal();
        return rated == 0 ? "—" : $"{Math.Round(100.0 * (_quality?.ThumbsUp ?? 0) / rated)}%";
    }

    private static double Share(int value, int max) =>
        max <= 0 ? 0 : Math.Min(100, Math.Round(100.0 * value / max, 0));

    private static string Seconds(int ms) =>
        (ms / 1000.0).ToString("0.0", CultureInfo.InvariantCulture) + " ث";

    private static string Ms(int ms) => ms.ToString("N0", CultureInfo.InvariantCulture) + " ms";
}
