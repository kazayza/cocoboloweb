@page "/assistant/usage"
@using COCOBOLOERPNEW.Services.Assistant
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = "Admin")]

@inject ZakiUsageReportService ReportService
@inject AuthenticationStateProvider AuthState

<PageTitle>استخدام زكي</PageTitle>

<div dir="rtl" class="zku-page">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">

        @* ═══ HERO ═══ *@
        <div class="zku-hero mb-4">
            <div class="zku-hero__glow"></div>
            <div class="zku-hero__content">
                <div class="d-flex align-center gap-3">
                    <div class="zku-hero__avatar">
                        <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Large" />
                    </div>
                    <div>
                        <div class="zku-hero__titlerow">
                            <MudText Typo="Typo.h5" Class="font-weight-bold">استخدام زكي</MudText>
                            <span class="zku-hero__tag">تقرير الإدارة</span>
                        </div>
                        <MudText Typo="Typo.body2" Style="opacity:.85">
                            حركة المساعد الذكي — الأسئلة والنجاح والتوكنز والأدوات والأخطاء
                        </MudText>
                    </div>
                </div>
                <div class="d-flex gap-2 align-center">
                    <MudSelect T="int" Value="_days" ValueChanged="OnDaysChanged" Variant="Variant.Outlined"
                               Margin="Margin.Dense" Style="width:130px;" Class="zku-days">
                        <MudSelectItem T="int" Value="7">آخر 7 أيام</MudSelectItem>
                        <MudSelectItem T="int" Value="30">آخر 30 يوم</MudSelectItem>
                        <MudSelectItem T="int" Value="90">آخر 90 يوم</MudSelectItem>
                    </MudSelect>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadAsync" type="button" Class="zku-btn-ghost">تحديث</MudButton>
                </div>
            </div>
        </div>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
        }
        else
        {
            @* ═══ KPI ═══ *@
            <MudGrid Spacing="2" Class="mb-3">
                <MudItem xs="6" sm="3">
                    <div class="zku-kpi">
                        <div class="zku-kpi__ic" style="color:#3B82F6"><MudIcon Icon="@Icons.Material.Filled.Forum" /></div>
                        <div>
                            <div class="zku-kpi__v" style="color:#3B82F6">@_report.TotalQuestions.ToString("N0")</div>
                            <div class="zku-kpi__l">إجمالي الأسئلة</div>
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <div class="zku-kpi">
                        <div class="zku-kpi__ic" style="color:#10B981"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" /></div>
                        <div>
                            <div class="zku-kpi__v" style="color:#10B981">@(_report.SuccessRate)%</div>
                            <div class="zku-kpi__l">نسبة النجاح</div>
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <div class="zku-kpi">
                        <div class="zku-kpi__ic" style="color:#8B5CF6"><MudIcon Icon="@Icons.Material.Filled.Bolt" /></div>
                        <div>
                            <div class="zku-kpi__v" style="color:#8B5CF6">@_report.TotalTokens.ToString("N0")</div>
                            <div class="zku-kpi__l">إجمالي التوكنز</div>
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <div class="zku-kpi">
                        <div class="zku-kpi__ic" style="color:#F59E0B"><MudIcon Icon="@Icons.Material.Filled.Timer" /></div>
                        <div>
                            <div class="zku-kpi__v" style="color:#F59E0B">@(_report.AvgDurationMs / 1000.0) ث</div>
                            <div class="zku-kpi__l">متوسط زمن الرد</div>
                        </div>
                    </div>
                </MudItem>
            </MudGrid>

            @* ═══ الحركة اليومية ═══ *@
            <div class="zku-shell mb-3">
                <MudTable Items="_report.Daily" Hover="true" Elevation="0" Dense="true">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6" Style="font-weight:600;">الحركة اليومية</MudText>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>اليوم</MudTh>
                        <MudTh>الأسئلة</MudTh>
                        <MudTh>الناجحة</MudTh>
                        <MudTh>النجاح</MudTh>
                        <MudTh>التوكنز</MudTh>
                        <MudTh>متوسط الزمن</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="d">
                        <MudTd DataLabel="اليوم">@d.Day.ToString("yyyy/MM/dd") (@d.Day.ToString("ddd", new System.Globalization.CultureInfo("ar-EG")))</MudTd>
                        <MudTd DataLabel="الأسئلة">@d.Questions</MudTd>
                        <MudTd DataLabel="الناجحة">@d.Success</MudTd>
                        <MudTd DataLabel="النجاح">@(d.Questions == 0 ? "-" : $"{d.Success * 100 / d.Questions}%")</MudTd>
                        <MudTd DataLabel="التوكنز">@d.Tokens.ToString("N0")</MudTd>
                        <MudTd DataLabel="متوسط الزمن">@(d.AvgDurationMs == 0 ? "-" : $"{d.AvgDurationMs / 1000.0} ث")</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Align="Align.Center" Class="py-6" Color="Color.Secondary">مفيش استخدام في الفترة دي</MudText>
                    </NoRecordsContent>
                </MudTable>
            </div>

            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    @* ═══ أكتر المستخدمين ═══ *@
                    <div class="zku-shell">
                        <MudTable Items="_report.TopUsers" Hover="true" Elevation="0" Dense="true">
                            <ToolBarContent>
                                <MudText Typo="Typo.h6" Style="font-weight:600;">أكتر المستخدمين</MudText>
                            </ToolBarContent>
                            <HeaderContent>
                                <MudTh>المستخدم</MudTh>
                                <MudTh>الأسئلة</MudTh>
                                <MudTh>التوكنز</MudTh>
                                <MudTh>آخر استخدام</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="u">
                                <MudTd DataLabel="المستخدم" Style="font-weight:600;">@u.UserName</MudTd>
                                <MudTd DataLabel="الأسئلة">@u.Questions</MudTd>
                                <MudTd DataLabel="التوكنز">@u.Tokens.ToString("N0")</MudTd>
                                <MudTd DataLabel="آخر استخدام">@u.LastUsed.ToString("yyyy/MM/dd")</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Align="Align.Center" Class="py-6" Color="Color.Secondary">مفيش بيانات</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </div>
                </MudItem>
                <MudItem xs="12" md="6">
                    @* ═══ الأدوات ═══ *@
                    <div class="zku-shell">
                        <MudTable Items="_report.Tools" Hover="true" Elevation="0" Dense="true">
                            <ToolBarContent>
                                <MudText Typo="Typo.h6" Style="font-weight:600;">الأدوات</MudText>
                            </ToolBarContent>
                            <HeaderContent>
                                <MudTh>الأداة</MudTh>
                                <MudTh>الاستدعاءات</MudTh>
                                <MudTh>الممنوعة</MudTh>
                                <MudTh>متوسط الزمن</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="t">
                                <MudTd DataLabel="الأداة" Style="direction:ltr;text-align:right;">@t.ToolName</MudTd>
                                <MudTd DataLabel="الاستدعاءات">@t.Calls</MudTd>
                                <MudTd DataLabel="الممنوعة">
                                    <span style="@(t.Denied > 0 ? "color:#EF4444;font-weight:600;" : "")">@t.Denied</span>
                                </MudTd>
                                <MudTd DataLabel="متوسط الزمن">@(t.AvgDurationMs == 0 ? "-" : $"{t.AvgDurationMs} م.ث")</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Align="Align.Center" Class="py-6" Color="Color.Secondary">مفيش بيانات</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </div>
                </MudItem>
            </MudGrid>

            @* ═══ الأخطاء ═══ *@
            @if (_report.Errors.Count > 0)
            {
                <div class="zku-shell mt-3">
                    <MudTable Items="_report.Errors" Hover="true" Elevation="0" Dense="true">
                        <ToolBarContent>
                            <MudText Typo="Typo.h6" Style="font-weight:600;">الأخطاء</MudText>
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh>كود الخطأ</MudTh>
                            <MudTh>العدد</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="e">
                            <MudTd DataLabel="كود الخطأ" Style="direction:ltr;text-align:right;">@e.ErrorCode</MudTd>
                            <MudTd DataLabel="العدد">
                                <span style="color:#EF4444;font-weight:700;">@e.Count</span>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
            }
        }
    </MudContainer>
</div>

<style>
    .zku-page { min-height: 60vh; }
    .zku-hero { position: relative; border-radius: 20px; overflow: hidden; background: linear-gradient(135deg, #070D1A 0%, #1B2A4A 45%, #2D4A7A 100%); color: #fff; box-shadow: 0 12px 32px rgba(15,26,46,.28); }
    .zku-hero__glow { position: absolute; width: 340px; height: 340px; top: -150px; left: -80px; border-radius: 50%; background: radial-gradient(circle, rgba(212,168,83,.30), transparent 60%); animation: zkuFloat 9s ease-in-out infinite; pointer-events: none; }
    .zku-hero__content { position: relative; z-index: 2; padding: 1.4rem 1.6rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
    .zku-hero__avatar { width: 56px; height: 56px; border-radius: 18px; background: linear-gradient(135deg, #D4A853, #B8912A); display: flex; align-items: center; justify-content: center; color: #0F1D36; box-shadow: 0 8px 24px rgba(212,168,83,.35); flex: 0 0 auto; }
    .zku-hero__titlerow { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }
    .zku-hero__tag { display: inline-flex; align-items: center; padding: .2rem .7rem; background: linear-gradient(135deg, #D4A853, #B8912A); color: #0F1D36; font-size: .68rem; font-weight: 800; border-radius: 14px; }
    .zku-btn-ghost { color: #fff !important; border-color: rgba(255,255,255,.4) !important; border-radius: 10px !important; text-transform: none !important; }
    .zku-days ::deep .mud-input-control, .zku-days ::deep .mud-input { color: #fff !important; }
    .zku-days ::deep .mud-input-control-input-container { border-color: rgba(255,255,255,.4) !important; }
    .zku-days ::deep .mud-icon-root { color: #fff !important; }
    @@keyframes zkuFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-14px); } }

    .zku-kpi { background: var(--mud-palette-surface); border: 1px solid var(--mud-palette-divider); border-radius: 14px; padding: 12px 14px; display: flex; align-items: center; gap: 12px; box-shadow: 0 1px 3px rgba(15,26,46,.05); height: 100%; }
    .zku-kpi__ic { width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; }
    .zku-kpi__v { font-size: 19px; font-weight: 900; line-height: 1.1; }
    .zku-kpi__l { font-size: 11.5px; color: var(--mud-palette-text-secondary); font-weight: 700; }

    .zku-shell { border: 1px solid var(--mud-palette-divider); border-radius: 14px; overflow: hidden; background: var(--mud-palette-surface); }

    @@media (max-width: 600px) {
        .zku-hero__content { padding: 1.1rem 1.2rem; }
        .zku-hero__avatar { width: 46px; height: 46px; }
    }
</style>

@code {
    private ZakiUsageReport _report = new();
    private int _days = 30;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _report = await ReportService.GetReportAsync(_days);
        _loading = false;
    }

    private async Task OnDaysChanged(int days)
    {
        _days = days;
        await LoadAsync();
    }
}
