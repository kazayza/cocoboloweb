@page "/cashbox/review"

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using System.Globalization
@using System.Security.Claims

@inject ICashBoxService CashBoxService
@inject CashBoxReviewService ReviewService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject IJSRuntime JS

@if (_isLoading)
{
    <div class="loading-screen">
        <div class="loading-box">
            <div class="loading-logo"><MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Large" /></div>
            <h2>مراجعة الخزينة</h2>
            <p>جاري تحميل بيانات المراجعة...</p>
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Style="border-radius:10px;height:6px;" />
        </div>
    </div>
}
else
{
<div class="rv-page" dir="rtl">

    <div class="screen-only">
        <div class="page-bg-deco"><div class="bg-orb bg-orb-1"></div><div class="bg-orb bg-orb-2"></div></div>
        <div class="top-accent"><div class="accent-shimmer"></div></div>

        <!-- ═══════════════════ HEADER ═══════════════════ -->
        <div class="rv-header">
            <div class="sh-bg">
                <div class="sh-gradient"></div>
                <div class="sh-orbs"><div class="sh-orb sh-o1"></div><div class="sh-orb sh-o2"></div></div>
                <div class="sh-grid"></div>
            </div>
            <div class="sh-content">
                <div class="sh-top">
                    <div class="sh-info">
                        <div class="sh-icon-wrap">
                            <div class="sh-icon-glow"></div>
                            <div class="sh-icon"><MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Large" /></div>
                            <div class="sh-badge"><MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" /></div>
                        </div>
                        <div class="sh-text">
                            <h1>مراجعة الخزينة</h1>
                            <p>
                                <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Class="sh-sub-icon" />
                                مراجعة فترة وختم خفيف بكشف التغيير — دون أي قفل أو منع تعديل
                            </p>
                        </div>
                    </div>
                    <div class="sh-actions">
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print"
                                   OnClick="PrintReport" Class="sh-btn-ghost">طباعة تقرير المراجعة</MudButton>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.SwapHoriz"
                                   OnClick="@(() => Navigation.NavigateTo("/cashbox/transactions"))" Class="sh-btn-ghost">حركات الخزينة</MudButton>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══════════════════ FILTERS ═══════════════════ -->
        <div class="filter-panel">
            <div class="fp-field fp-box">
                <MudSelect T="int?" Value="_selectedBoxId" ValueChanged="OnBoxChanged"
                           Label="الخزينة" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Savings">
                    @foreach (var box in _boxes)
                    {
                        <MudSelectItem T="int?" Value="@((int?)box.CashBoxId)">@box.CashBoxName</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div class="fp-field">
                <MudDatePicker @bind-Date="_dateFrom" Label="من تاريخ" Variant="Variant.Outlined" Margin="Margin.Dense"
                               Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.CalendarMonth" />
            </div>
            <div class="fp-field">
                <MudDatePicker @bind-Date="_dateTo" Label="إلى تاريخ" Variant="Variant.Outlined" Margin="Margin.Dense"
                               Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.CalendarMonth" />
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search"
                       OnClick="LoadReviewAsync" Disabled="_isReviewLoading" Class="fp-apply">
                @if (_isReviewLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
                    <span>جاري العرض...</span>
                }
                else
                {
                    <span>عرض</span>
                }
            </MudButton>
        </div>

        @if (_requiresSql)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="rv-alert">
                جدول أختام مراجعة الخزينة غير مهيأ بعد — الأرقام والمساعدات تعمل، لكن الختم معطّل حتى تشغيل سكربت <strong>cashbox-review.sql</strong>.
            </MudAlert>
        }

        @if (_review == null)
        {
            <div class="empty-state">
                <div class="empty-icon-box"><MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" /></div>
                <h3>لا توجد خزينة لعرضها</h3>
                <p>اختر خزينة ثم اضغط «عرض»</p>
            </div>
        }
        else
        {
            <!-- ═══════════════════ DEFINITION BAND ═══════════════════ -->
            <div class="totals-row">
                <div class="total-card tc-opening">
                    <div class="tc-accent"></div>
                    <div class="tc-inner">
                        <div class="tc-icon-box"><MudIcon Icon="@Icons.Material.Filled.Stars" /></div>
                        <div class="tc-data">
                            <span class="tc-label">رصيد أول المدة</span>
                            <div class="tc-val-row"><span class="tc-value">@FormatMoney(_review.OpeningBalance)</span><span class="tc-curr">ج.م</span></div>
                        </div>
                    </div>
                </div>
                <div class="total-card tc-in">
                    <div class="tc-accent"></div>
                    <div class="tc-inner">
                        <div class="tc-icon-box"><MudIcon Icon="@Icons.Material.Filled.TrendingUp" /></div>
                        <div class="tc-data">
                            <span class="tc-label">إجمالي الوارد</span>
                            <div class="tc-val-row"><span class="tc-value">@FormatMoney(_review.TotalIn)</span><span class="tc-curr">ج.م</span></div>
                        </div>
                    </div>
                </div>
                <div class="total-card tc-out">
                    <div class="tc-accent"></div>
                    <div class="tc-inner">
                        <div class="tc-icon-box"><MudIcon Icon="@Icons.Material.Filled.TrendingDown" /></div>
                        <div class="tc-data">
                            <span class="tc-label">إجمالي الصادر</span>
                            <div class="tc-val-row"><span class="tc-value">@FormatMoney(_review.TotalOut)</span><span class="tc-curr">ج.م</span></div>
                        </div>
                    </div>
                </div>
                <div class="total-card tc-balance">
                    <div class="tc-accent"></div>
                    <div class="tc-inner">
                        <div class="tc-icon-box"><MudIcon Icon="@Icons.Material.Filled.AccountBalance" /></div>
                        <div class="tc-data">
                            <span class="tc-label">رصيد آخر المدة (دفتري)</span>
                            <div class="tc-val-row"><span class="tc-value">@FormatMoney(_review.ClosingBalance)</span><span class="tc-curr">ج.م</span></div>
                            <span class="tc-sub">@_review.TotalMovementCount حركة في المدة</span>
                        </div>
                    </div>
                </div>
            </div>

            @if (_review.IsTruncated)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="rv-alert">
                    عدد حركات المدة (@_review.TotalMovementCount) أكبر من حد العرض (@CashBoxReviewService.MovementCap) — قائمة الحركات وتفصيل المصادر ومساعدات المراجعة تخص أول @_review.Movements.Count حركة معروضة، أما إجماليات الشريط وبصمة الختم فمن بيانات المدة كاملة. أيام الإغلاق السالب معطلة في هذه الحالة.
                </MudAlert>
            }

            <!-- ═══════════════════ BREAKDOWN + STAMP ═══════════════════ -->
            <div class="rv-grid">
                <div class="table-panel">
                    <div class="tp-header">
                        <div class="tp-title-group">
                            <div class="tp-icon"><MudIcon Icon="@Icons.Material.Filled.PieChart" /></div>
                            <div>
                                <h3>تفصيل المصادر</h3>
                                <p>@_review.CashBoxName — من @_review.PeriodFrom.ToString("yyyy/MM/dd") إلى @_review.PeriodTo.ToString("yyyy/MM/dd")</p>
                            </div>
                        </div>
                    </div>
                    <MudTable Items="@_review.SourceBreakdown" Hover="true" Striped="true" Class="premium-table">
                        <HeaderContent>
                            <MudTh>المصدر</MudTh>
                            <MudTh>عدد</MudTh>
                            <MudTh>وارد</MudTh>
                            <MudTh>صادر</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="المصدر">
                                <strong>@context.Category</strong>
                                @if (context.RawReferenceTypes.Any())
                                {
                                    <div class="td-sub">@string.Join("، ", context.RawReferenceTypes)</div>
                                }
                            </MudTd>
                            <MudTd DataLabel="عدد">@context.Count</MudTd>
                            <MudTd DataLabel="وارد"><span class="money-in">@FormatMoney(context.TotalIn)</span></MudTd>
                            <MudTd DataLabel="صادر"><span class="money-out">@FormatMoney(context.TotalOut)</span></MudTd>
                        </RowTemplate>
                    </MudTable>
                    @if (!_review.SourceBreakdown.Any())
                    {
                        <div class="mini-empty">لا توجد حركات في هذه المدة</div>
                    }
                </div>

                <!-- ═══════════ STAMP CARD ═══════════ -->
                <div class="table-panel stamp-panel">
                    <div class="tp-header">
                        <div class="tp-title-group">
                            <div class="tp-icon"><MudIcon Icon="@Icons.Material.Filled.VerifiedUser" /></div>
                            <div>
                                <h3>ختم المراجعة</h3>
                                <p>سجل خفيف — لا يمنع أي تعديل لاحق</p>
                            </div>
                        </div>
                        <span class="status-chip @StatusClass(_review.Stamp.Status)">@StatusText(_review.Stamp.Status)</span>
                    </div>
                    <div class="stamp-body">
                        @if (_review.Stamp.StampId.HasValue)
                        {
                            <div class="stamp-meta">
                                <div><span>راجعها</span><strong>@(_review.Stamp.ReviewedByName ?? _review.Stamp.ReviewedByUserName)</strong></div>
                                <div><span>وقت الختم</span><strong>@_review.Stamp.ReviewedAt?.ToString("yyyy/MM/dd HH:mm")</strong></div>
                                <div><span>بصمة الختم</span><strong>@_review.Stamp.StoredFingerprint?.TxCount حركة — وارد @FormatMoney(_review.Stamp.StoredFingerprint?.TotalIn ?? 0) — صادر @FormatMoney(_review.Stamp.StoredFingerprint?.TotalOut ?? 0)</strong></div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_review.Stamp.Note))
                            {
                                <div class="stamp-note">«@_review.Stamp.Note»</div>
                            }
                            @if (_review.Stamp.Status == CashBoxReviewStatuses.ChangedAfterReview)
                            {
                                <div class="delta-box">
                                    <strong>ما تغيّر منذ الختم (الحالي − وقت الختم):</strong>
                                    <ul>
                                        <li>عدد الحركات: @FormatDelta(_review.Stamp.CountDifference)</li>
                                        <li>إجمالي الوارد: @FormatDelta(_review.Stamp.TotalInDifference) ج.م</li>
                                        <li>إجمالي الصادر: @FormatDelta(_review.Stamp.TotalOutDifference) ج.م</li>
                                        @if (_review.Stamp.LastTxCreatedAtChanged)
                                        {
                                            <li>وُجدت حركة أحدث من آخر حركة وقت الختم</li>
                                        }
                                    </ul>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="stamp-none-text">هذه الفترة غير مختومة بالمراجعة بعد. الختم يحفظ من راجع ومتى وبأي أرقام، وأي تغيير لاحق داخل الفترة سيظهر هنا وفي قائمة الأختام.</p>
                        }

                        <MudTextField @bind-Value="_stampNote" Label="ملاحظة المراجعة (اختيارية)" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Lines="2" MaxLength="1000" Class="stamp-note-field" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Verified"
                                   OnClick="StampAsync" Disabled="@(_isStamping || _requiresSql)" FullWidth="true">
                            @if (_isStamping)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
                                <span>جاري الحفظ...</span>
                            }
                            else
                            {
                                <span>@(_review.Stamp.StampId.HasValue ? "إعادة ختم المراجعة بالأرقام الحالية" : "ختم المراجعة")</span>
                            }
                        </MudButton>
                    </div>
                </div>
            </div>

            <!-- ═══════════════════ REVIEW AIDS ═══════════════════ -->
            <div class="table-panel">
                <div class="tp-header">
                    <div class="tp-title-group">
                        <div class="tp-icon"><MudIcon Icon="@Icons.Material.Filled.Troubleshoot" /></div>
                        <div>
                            <h3>مساعدات المراجعة</h3>
                            <p>اضغط أي عنصر لعرض مجموعته داخل قائمة الحركات</p>
                        </div>
                    </div>
                </div>
                <div class="aid-chips">
                    <button class="aid-chip @(_subset == ReviewSubset.All ? "aid-active" : "")" @onclick="@(() => SetSubset(ReviewSubset.All))">
                        كل الحركات <strong>@_review.Movements.Count</strong>
                    </button>
                    <button class="aid-chip @(_subset == ReviewSubset.Manual ? "aid-active" : "")" @onclick="@(() => SetSubset(ReviewSubset.Manual))">
                        حركات يدوية <strong>@_review.Aids.ManualMovementIds.Count</strong>
                    </button>
                    <button class="aid-chip @(_subset == ReviewSubset.NoReference ? "aid-active" : "")" @onclick="@(() => SetSubset(ReviewSubset.NoReference))">
                        بلا مرجع <strong>@_review.Aids.NoReferenceMovementIds.Count</strong>
                    </button>
                    <button class="aid-chip @(_subset == ReviewSubset.Backdated ? "aid-active" : "")" @onclick="@(() => SetSubset(ReviewSubset.Backdated))">
                        سُجلت بتاريخ رجعي <strong>@_review.Aids.BackdatedMovementIds.Count</strong>
                    </button>
                    <button class="aid-chip @(_subset == ReviewSubset.Largest ? "aid-active" : "")" @onclick="@(() => SetSubset(ReviewSubset.Largest))">
                        أكبر خمس حركات <strong>@_review.Aids.LargestMovements.Count</strong>
                    </button>
                    @if (_review.Aids.NegativeDaysAvailable)
                    {
                        <button class="aid-chip aid-warn @(_subset == ReviewSubset.NegativeDays ? "aid-active" : "")" @onclick="@(() => SetSubset(ReviewSubset.NegativeDays))">
                            أيام أُغلقت سالبة <strong>@_review.Aids.NegativeDays.Count</strong>
                        </button>
                    }
                    else
                    {
                        <span class="aid-chip aid-disabled">أيام أُغلقت سالبة: غير متاحة عند اقتطاع العرض</span>
                    }
                </div>
                @if (_review.Aids.NegativeDays.Any())
                {
                    <div class="neg-days">
                        @foreach (var d in _review.Aids.NegativeDays)
                        {
                            <span class="neg-day">يوم @d.Date.ToString("yyyy/MM/dd") أُغلق على <strong>@FormatMoney(d.ClosingBalance)</strong> ج.م</span>
                        }
                    </div>
                }
            </div>

            <!-- ═══════════════════ MOVEMENTS ═══════════════════ -->
            <div class="table-panel">
                <div class="tp-header">
                    <div class="tp-title-group">
                        <div class="tp-icon"><MudIcon Icon="@Icons.Material.Filled.SwapHoriz" /></div>
                        <div>
                            <h3>@SubsetTitle()</h3>
                            <p>@DisplayedMovements.Count حركة معروضة</p>
                        </div>
                    </div>
                    @if (_subset != ReviewSubset.All)
                    {
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Clear" OnClick="@(() => SetSubset(ReviewSubset.All))">عرض الكل</MudButton>
                    }
                </div>
                <MudTable Items="@DisplayedMovements" Hover="true" Striped="true" Class="premium-table">
                    <HeaderContent>
                        <MudTh>التاريخ</MudTh>
                        <MudTh>المصدر</MudTh>
                        <MudTh>البيان / المرجع</MudTh>
                        <MudTh>وارد</MudTh>
                        <MudTh>صادر</MudTh>
                        <MudTh>سجّلها</MudTh>
                        <MudTh>وقت التسجيل</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="التاريخ">@context.TransactionDate.ToString("yyyy/MM/dd")</MudTd>
                        <MudTd DataLabel="المصدر">
                            <strong>@CashBoxReviewService.GetSourceCategory(context.ReferenceType)</strong>
                            @if (!string.IsNullOrWhiteSpace(context.ReferenceTypeAr) && context.ReferenceTypeAr != CashBoxReviewService.GetSourceCategory(context.ReferenceType))
                            {
                                <div class="td-sub">@context.ReferenceTypeAr</div>
                            }
                        </MudTd>
                        <MudTd DataLabel="البيان / المرجع">
                            @if (!string.IsNullOrWhiteSpace(context.SourceUrl) && !string.IsNullOrWhiteSpace(context.SourceTitle))
                            {
                                <a href="@context.SourceUrl" class="src-link">@context.SourceTitle</a>
                            }
                            else if (!string.IsNullOrWhiteSpace(context.SourceTitle))
                            {
                                <span>@context.SourceTitle</span>
                            }
                            @if (context.ReferenceId.HasValue)
                            {
                                <span class="td-sub">مرجع #@context.ReferenceId.Value</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(context.PartyName))
                            {
                                <div class="td-sub">@context.PartyName</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(context.Notes))
                            {
                                <div class="td-notes">@context.Notes</div>
                            }
                        </MudTd>
                        <MudTd DataLabel="وارد">
                            @if (context.TransactionType == "قبض")
                            {
                                <span class="money-in">+@FormatMoney(context.Amount)</span>
                            }
                            else
                            {
                                <span class="money-dash">—</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="صادر">
                            @if (context.TransactionType == "صرف")
                            {
                                <span class="money-out">-@FormatMoney(context.Amount)</span>
                            }
                            else
                            {
                                <span class="money-dash">—</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="سجّلها">@(string.IsNullOrWhiteSpace(context.CreatedBy) ? "—" : context.CreatedBy)</MudTd>
                        <MudTd DataLabel="وقت التسجيل">
                            @(context.CreatedAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")
                            @if (_backdatedIds.Contains(context.CashboxTransactionId))
                            {
                                <span class="backdated-badge">تاريخ رجعي</span>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
                @if (!DisplayedMovements.Any())
                {
                    <div class="mini-empty">لا توجد حركات في هذه المجموعة</div>
                }
            </div>
        }

        <!-- ═══════════════════ RECENT STAMPS ═══════════════════ -->
        <div class="table-panel">
            <div class="tp-header">
                <div class="tp-title-group">
                    <div class="tp-icon"><MudIcon Icon="@Icons.Material.Filled.History" /></div>
                    <div>
                        <h3>أحدث الأختام</h3>
                        <p>أحدث ختم لكل خزينة وفترة — بحالته الحية الآن</p>
                    </div>
                </div>
            </div>
            @if (_recentStamps.Any())
            {
                <MudTable Items="@_recentStamps" Hover="true" Striped="true" Class="premium-table">
                    <HeaderContent>
                        <MudTh>الخزينة</MudTh>
                        <MudTh>الفترة</MudTh>
                        <MudTh>راجعها</MudTh>
                        <MudTh>وقت الختم</MudTh>
                        <MudTh>الحالة</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="الخزينة"><strong>@context.CashBoxName</strong></MudTd>
                        <MudTd DataLabel="الفترة">@context.PeriodFrom.ToString("yyyy/MM/dd") ← @context.PeriodTo.ToString("yyyy/MM/dd")</MudTd>
                        <MudTd DataLabel="راجعها">@(context.ReviewedByName ?? context.ReviewedByUserName)</MudTd>
                        <MudTd DataLabel="وقت الختم">@context.ReviewedAt.ToString("yyyy/MM/dd HH:mm")</MudTd>
                        <MudTd DataLabel="الحالة"><span class="status-chip @StatusClass(context.Status)">@StatusText(context.Status)</span></MudTd>
                        <MudTd>
                            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.OpenInNew"
                                       OnClick="@(() => OpenRecentAsync(context))">عرض</MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <div class="mini-empty">@(_requiresSql ? "الأختام غير متاحة قبل تشغيل سكربت cashbox-review.sql" : "لا توجد أختام مراجعة بعد")</div>
            }
        </div>

        <div class="dash-footer">
            <div class="footer-inner">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" Class="footer-icon" />
                <span>COCOBOLO ERP — مراجعة الخزينة</span>
                <span class="footer-premium">Premium</span>
            </div>
        </div>
    </div>

    <!-- ═══════════════════ PRINT REPORT (print only) ═══════════════════ -->
    @if (_review != null)
    {
        <div class="print-report print-only">
            <div class="print-header">
                <div class="ph-top">
                    <h1>COCOBOLO ERP</h1>
                    <span class="ph-divider">|</span>
                    <h2>تقرير مراجعة الخزينة</h2>
                </div>
                <div class="ph-meta">
                    <span>الخزينة: <strong>@_review.CashBoxName</strong></span>
                    <span>الفترة: <strong>من @_review.PeriodFrom.ToString("yyyy/MM/dd") إلى @_review.PeriodTo.ToString("yyyy/MM/dd")</strong></span>
                    <span>تاريخ الطباعة: <strong>@DateTime.Now.ToString("yyyy/MM/dd HH:mm")</strong></span>
                </div>
            </div>

            <table class="pr-table">
                <tr><th>رصيد أول المدة</th><th>إجمالي الوارد</th><th>إجمالي الصادر</th><th>رصيد آخر المدة (دفتري)</th></tr>
                <tr>
                    <td>@FormatMoney(_review.OpeningBalance)</td>
                    <td>@FormatMoney(_review.TotalIn)</td>
                    <td>@FormatMoney(_review.TotalOut)</td>
                    <td><strong>@FormatMoney(_review.ClosingBalance)</strong></td>
                </tr>
            </table>

            <h3 class="pr-h">تفصيل المصادر</h3>
            <table class="pr-table">
                <tr><th>المصدر</th><th>عدد</th><th>وارد</th><th>صادر</th></tr>
                @foreach (var s in _review.SourceBreakdown)
                {
                    <tr><td>@s.Category</td><td>@s.Count</td><td>@FormatMoney(s.TotalIn)</td><td>@FormatMoney(s.TotalOut)</td></tr>
                }
            </table>

            <h3 class="pr-h">مساعدات المراجعة</h3>
            <p class="pr-p">
                حركات يدوية: @_review.Aids.ManualMovementIds.Count —
                بلا مرجع: @_review.Aids.NoReferenceMovementIds.Count —
                سُجلت بتاريخ رجعي: @_review.Aids.BackdatedMovementIds.Count —
                أيام أُغلقت سالبة: @(_review.Aids.NegativeDaysAvailable ? _review.Aids.NegativeDays.Count.ToString() : "غير متاحة عند اقتطاع العرض")
            </p>

            <h3 class="pr-h">حالة ختم المراجعة</h3>
            <p class="pr-p">
                الحالة: <strong>@StatusText(_review.Stamp.Status)</strong>
                @if (_review.Stamp.StampId.HasValue)
                {
                    <span> — راجعها @(_review.Stamp.ReviewedByName ?? _review.Stamp.ReviewedByUserName) في @_review.Stamp.ReviewedAt?.ToString("yyyy/MM/dd HH:mm")</span>
                    @if (!string.IsNullOrWhiteSpace(_review.Stamp.Note))
                    {
                        <span> — ملاحظة: «@_review.Stamp.Note»</span>
                    }
                }
            </p>
        </div>
    }
</div>
}

