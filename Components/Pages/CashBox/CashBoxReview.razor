</style>

@code {
    private enum ReviewSubset { All, Manual, NoReference, Backdated, Largest, NegativeDays }

    private bool _isLoading = true;
    private bool _isReviewLoading;
    private bool _isStamping;
    private ClaimsPrincipal _currentUser = new();
    private List<CashBoxListDto> _boxes = new();
    private int? _selectedBoxId;
    private DateTime? _dateFrom = DateTime.Today;
    private DateTime? _dateTo = DateTime.Today;
    private CashBoxReviewDto? _review;
    private List<CashBoxReviewRecentStampDto> _recentStamps = new();
    private bool _requiresSql;
    private string _stampNote = "";
    private ReviewSubset _subset = ReviewSubset.All;
    private HashSet<int> _manualIds = new();
    private HashSet<int> _noReferenceIds = new();
    private HashSet<int> _backdatedIds = new();
    private HashSet<int> _negativeIds = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;

        // قاعدة الوصول نفسها في الصفحة والقائمة: الأدوار الثلاثة أو صلاحية الشاشة
        var canView = user.IsInRole("Admin")
            || user.IsInRole("AccountManager")
            || user.IsInRole("Accountant")
            || user.HasClaim("Permission", "frmCashBoxReview:View");
        if (!canView) { Navigation.NavigateTo("/"); return; }
        _currentUser = user;

        _boxes = await CashBoxService.GetCashBoxesAsync(false);
        _selectedBoxId = (_boxes.FirstOrDefault(b => b.IsDefault && b.IsActive)
            ?? _boxes.FirstOrDefault(b => b.IsActive)
            ?? _boxes.FirstOrDefault())?.CashBoxId;

        await LoadReviewAsync();
        await LoadRecentStampsAsync();
        _isLoading = false;
    }

    private async Task OnBoxChanged(int? boxId)
    {
        _selectedBoxId = boxId;
        await LoadReviewAsync();
    }

    private async Task LoadReviewAsync()
    {
        if (_selectedBoxId == null) { _review = null; return; }

        var from = (_dateFrom ?? DateTime.Today).Date;
        var to = (_dateTo ?? DateTime.Today).Date;
        if (from > to)
        {
            Snackbar.Add("تاريخ البداية بعد تاريخ النهاية — برجاء تصحيح الفترة.", Severity.Error);
            return;
        }
        _dateFrom = from;
        _dateTo = to;

        _isReviewLoading = true;
        try
        {
            _review = await ReviewService.GetReviewAsync(_selectedBoxId.Value, from, to);
            _requiresSql = _review.RequiresSql;
            _manualIds = _review.Aids.ManualMovementIds.ToHashSet();
            _noReferenceIds = _review.Aids.NoReferenceMovementIds.ToHashSet();
            _backdatedIds = _review.Aids.BackdatedMovementIds.ToHashSet();
            _negativeIds = _review.Aids.NegativeDayMovementIds.ToHashSet();
            _subset = ReviewSubset.All;
            _stampNote = "";
        }
        finally
        {
            _isReviewLoading = false;
        }
    }

    private async Task LoadRecentStampsAsync()
    {
        var recent = await ReviewService.GetRecentStampsAsync();
        _recentStamps = recent.Items;
        if (recent.RequiresSql) _requiresSql = true;
    }

    private async Task OpenRecentAsync(CashBoxReviewRecentStampDto item)
    {
        _selectedBoxId = item.CashBoxId;
        _dateFrom = item.PeriodFrom;
        _dateTo = item.PeriodTo;
        await LoadReviewAsync();
    }

    private async Task StampAsync()
    {
        if (_review == null || _selectedBoxId == null) return;

        _isStamping = true;
        try
        {
            var (ok, message) = await ReviewService.StampAsync(
                _selectedBoxId.Value, _review.PeriodFrom, _review.PeriodTo, _stampNote, _currentUser);
            Snackbar.Add(message, ok ? Severity.Success : Severity.Error);
            if (ok)
            {
                await LoadReviewAsync();
                await LoadRecentStampsAsync();
            }
        }
        finally
        {
            _isStamping = false;
        }
    }

    private void SetSubset(ReviewSubset subset) => _subset = subset;

    private List<CashBoxTransactionDto> DisplayedMovements
    {
        get
        {
            if (_review == null) return new List<CashBoxTransactionDto>();
            return _subset switch
            {
                ReviewSubset.Manual => _review.Movements.Where(m => _manualIds.Contains(m.CashboxTransactionId)).ToList(),
                ReviewSubset.NoReference => _review.Movements.Where(m => _noReferenceIds.Contains(m.CashboxTransactionId)).ToList(),
                ReviewSubset.Backdated => _review.Movements.Where(m => _backdatedIds.Contains(m.CashboxTransactionId)).ToList(),
                ReviewSubset.Largest => _review.Aids.LargestMovements,
                ReviewSubset.NegativeDays => _review.Movements.Where(m => _negativeIds.Contains(m.CashboxTransactionId)).ToList(),
                _ => _review.Movements
            };
        }
    }

    private string SubsetTitle() => _subset switch
    {
        ReviewSubset.Manual => "حركات الفترة — الحركات اليدوية",
        ReviewSubset.NoReference => "حركات الفترة — بلا مرجع",
        ReviewSubset.Backdated => "حركات الفترة — سُجلت بتاريخ رجعي",
        ReviewSubset.Largest => "حركات الفترة — أكبر خمس حركات",
        ReviewSubset.NegativeDays => "حركات الفترة — أيام أُغلقت سالبة",
        _ => "حركات الفترة"
    };

    private static string StatusText(string status) => status switch
    {
        CashBoxReviewStatuses.Reviewed => "تمت مراجعتها",
        CashBoxReviewStatuses.ChangedAfterReview => "تغيّرت بعد المراجعة",
        _ => "لم تتم مراجعتها"
    };

    private static string StatusClass(string status) => status switch
    {
        CashBoxReviewStatuses.Reviewed => "st-reviewed",
        CashBoxReviewStatuses.ChangedAfterReview => "st-changed",
        _ => "st-none"
    };

    private async Task PrintReport() => await JS.InvokeVoidAsync("window.print");

    private static string FormatMoney(decimal v) => v.ToString("N2", CultureInfo.InvariantCulture);

    private static string FormatDelta(decimal v) =>
        (v > 0 ? "+" : "") + v.ToString("N2", CultureInfo.InvariantCulture);

    private static string FormatDelta(int v) =>
        (v > 0 ? "+" : "") + v.ToString(CultureInfo.InvariantCulture);
}
