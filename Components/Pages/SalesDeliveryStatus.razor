</style>

@code {
    // ─── Constants ─────────────────────────────────────────
    private const string StatusPending   = "جارى";
    private const string StatusPartial   = "جزئي";
    private const string StatusDelivered = "تم التسليم";
    private const string StatusOverdue   = "متأخر";
    private const string StatusReturned  = "مرتجع";

    // ─── State ─────────────────────────────────────────────
    private const string FilterStorageKey = "sales_delivery_status_filters_v2";
    private List<VwSalesDeliveryStatus> _items   = new();
    private DeliverySummaryDto          _summary = new();
    private bool        _loading = true;
    private DateTime?   _from;
    private DateTime?   _to;
    private string _dateFilterType = DeliveryDateFilterTypes.DueDate;
    private string?     _search;
    private string?     _status;
    private string      _debtFilter = "all";   // all | yes | no — نعم/لا بدون أي مبالغ
    private bool        _multiOnly;            // فلتر «متعددة المواعيد»

    // ─── Permissions ───────────────────────────────────────
    private bool _canSeeAmounts;
    private bool _canEditFull;
    private bool _canConfirmDelivery;
    private bool _canViewPurchaseReceipts;
    private bool _canOverride;
    private string _currentUserName = "system";
    private Dictionary<int, DeliveryPermissionStateDto> _permStates = new();
    private Dictionary<int, ScheduleChangePendingStateDto> _schedStates = new();
    private Dictionary<int, DeliveryProgressSummaryDto> _progress = new();
    private Dictionary<int, InvoiceScheduleSummaryDto> _schedules = new();
    private List<DailyDeliverySheetRowDto> _sheetRows = new();
    private DateTime? _sheetPrintedAt;

    private CancellationTokenSource? _cts;

    // ─── Lifecycle ─────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await LoadPermissionsAsync();
        await RestoreFilterStateAsync();
        await RefreshAsync();
    }

    private async Task LoadPermissionsAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;

        if (!DeliveryPermissions.CanView(user))
        {
            Nav.NavigateTo("/");
            return;
        }

        _currentUserName    = user.Identity?.Name ?? "system";
        _canSeeAmounts      = DeliveryPermissions.CanSeeAmounts(user);
        _canEditFull        = DeliveryPermissions.CanEditFull(user);
        _canConfirmDelivery = DeliveryPermissions.CanConfirmDelivery(user);
        _canOverride        = DeliveryPermissions.CanOverrideRemaining(user);
        _canViewPurchaseReceipts = user.IsInRole("Admin")
            || user.IsInRole(SystemRoles.Admin)
            || user.IsInRole(SystemRoles.GeneralManager)
            || user.IsInRole("AccountManager")
            || user.IsInRole(SystemRoles.AccountManager)
            || user.IsInRole(SystemRoles.Sales)
            || user.IsInRole("User") // مندوب التسليمات
            || user.IsInRole("factory")
            || user.IsInRole(SystemRoles.ProductionManager)
            || user.IsInRole(SystemRoles.FactoryManager)
            || user.HasClaim("Permission", "frm_PurchaseReceiptStatus:View")
            || user.HasClaim("Permission", "frm_SupplierInvoices:View");
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    // ─── Data Loading ──────────────────────────────────────
    private async Task RefreshAsync()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        _loading = true;
        StateHasChanged();

        try
        {
            var itemsTask   = DeliveryService.GetFilteredAsync(_from, _to, _dateFilterType, _search, _status);
            var summaryTask = DeliveryService.GetSummaryAsync(_from, _to, _dateFilterType, _search, _status);

            await Task.WhenAll(itemsTask, summaryTask);

            if (token.IsCancellationRequested) return;

            _items   = (await itemsTask)
                .OrderBy(i => i.DeliveryStatus == StatusDelivered)   // غير المسلَّمة أولاً
                .ThenBy(i => i.DueDate ?? DateTime.MaxValue)         // ثم الأقرب استحقاقاً
                .ThenByDescending(i => i.TransactionId)
                .ToList();
            _summary = await summaryTask;

            // حالات إذن التسليم (طلبات معلقة / أذون ممنوحة)
            try
            {
                _permStates = await DeliveryService.GetDeliveryPermissionStatesAsync(
                    _items.Select(i => i.TransactionId).ToList());
            }
            catch { _permStates = new(); }

            // حالات طلبات تعديل المواعيد المعلّقة — تدهور آمن إن غابت الجداول
            try
            {
                _schedStates = await DeliveryService.GetPendingScheduleRequestStatesAsync(
                    _items.Select(i => i.TransactionId).ToList());
            }
            catch { _schedStates = new(); }

            // تقدم التسليم الجزئي (عمود التقدم) — تدهور آمن إن غابت الجداول
            try
            {
                _progress = await DeliveryService.GetDeliveryProgressBatchAsync(
                    _items.Select(i => i.TransactionId).ToList());
            }
            catch { _progress = new(); }

            // جدولة البنود (مواعيد الفاتورة المميزة) — تدهور آمن إن غاب التخزين
            try
            {
                _schedules = await DeliveryService.GetLineScheduleSummariesBatchAsync(
                    _items.Select(i => i.TransactionId).ToList());
            }
            catch { _schedules = new(); }

            await SaveFilterStateAsync();
        }
        catch (OperationCanceledException) { /* normal */ }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load deliveries");
            Snackbar.Add("تعذّر تحميل البيانات: " + ex.Message, Severity.Error);
            _items = new();
            _summary = new();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private Task OnSearchChangedAsync() => RefreshAsync();

    private async Task ClearAsync()
    {
        _from = null;
        _to = null;
        _search = null;
        _status = null;
        _debtFilter = "all";
        _multiOnly = false;
        _dateFilterType = DeliveryDateFilterTypes.DueDate;
        await RefreshAsync();
    }

    private async Task SetStatusAsync(string? status)
    {
        _status = (_status == status) ? null : status;
        await RefreshAsync();
    }

    // ── الفترات السريعة: اليوم / هذا الأسبوع (من السبت) / هذا الشهر / الكل ──
    private static DateTime WeekStart(DateTime d) =>
        d.AddDays(-(((int)d.DayOfWeek - (int)DayOfWeek.Saturday) + 7) % 7);

    private static (DateTime? From, DateTime? To) PeriodRange(string preset)
    {
        var today = DateTime.Today;
        return preset switch
        {
            "today" => (today, today),
            "week"  => (WeekStart(today), WeekStart(today).AddDays(6)),
            "month" => (new DateTime(today.Year, today.Month, 1),
                        new DateTime(today.Year, today.Month, 1).AddMonths(1).AddDays(-1)),
            _       => (null, null)
        };
    }

    private bool IsPeriodActive(string preset)
    {
        var (f, t) = PeriodRange(preset);
        return _from?.Date == f?.Date && _to?.Date == t?.Date;
    }

    private async Task SetPeriodAsync(string preset)
    {
        (_from, _to) = PeriodRange(preset);
        await RefreshAsync();
    }

    // ════════════════════════════════════════════════════════════
    // ⭐ وحدة الصف في القائمة = (فاتورة × موعد): الفاتورة التي لبنودها موعدان
    // مميزان تظهر صفين كاملين — صف لكل موعد بحالته وبنوده وإجراء تسجيله —
    // فيرى المستخدم المواعيد واضحة من القائمة نفسها دون فتح التفاصيل.
    // كروت الملخص تبقى محسوبة من خدمة الملخص على مستوى الفاتورة (مميزة) —
    // لا تُحسب من الصفوف أبدًا فلا تتضاعف الأعداد.
    // ════════════════════════════════════════════════════════════
    private sealed class DeliveryListRow
    {
        public required VwSalesDeliveryStatus Item { get; init; }
        public DeliveryScheduleGroupDto? Group { get; init; }
        public string StateText { get; init; } = "";
        public Color StateColor { get; init; } = Color.Default;
        public string StateIcon { get; init; } = "";
        /// <summary>حالة الصف التي يُقيَّم عليها فلتر الحالة (على مستوى الموعد لا الفاتورة)</summary>
        public string FilterStatus { get; init; } = "";
        /// <summary>مواعيد الفاتورة الأخرى (معروضة) لتلميح «لها موعد آخر»</summary>
        public List<DateTime?> OtherDates { get; init; } = new();
        /// <summary>ترتيب هذا الموعد بين مواعيد فاتورته (1-based) وعددها — لشيب «موعد X من N»</summary>
        public int AppointmentIndex { get; init; }
        public int AppointmentCount { get; init; }
        /// <summary>الموعد التالي بعد موعد هذا الصف (معروض) إن وجد</summary>
        public DateTime? NextDate { get; init; }
        public DateTime? SortDate => Group?.DisplayDate ?? Item.DueDate;
    }

    private IEnumerable<DeliveryListRow> _displayRows => BuildDisplayRows();

    private List<DeliveryListRow> BuildDisplayRows()
    {
        var rows = new List<DeliveryListRow>();
        foreach (var item in _items)
        {
            // فلتر المديونية: client-side على مستوى الفاتورة — نعم/لا فقط بدون أي مبالغ
            if (_debtFilter == "yes" && item.GrandTotal - item.PaidAmount <= 0) continue;
            if (_debtFilter == "no"  && item.GrandTotal - item.PaidAmount > 0)  continue;

            if (_schedules.TryGetValue(item.TransactionId, out var sched) && sched.Groups.Count > 0)
            {
                // فلتر «متعددة المواعيد»: فواتير بلا موعدين مميزين على الأقل تُستبعد كلية
                if (_multiOnly && sched.Groups.Count < 2) continue;

                var allDates = sched.Groups.Select(g => g.DisplayDate).ToList();
                for (var i = 0; i < sched.Groups.Count; i++)
                {
                    var g = sched.Groups[i];
                    rows.Add(MakeRow(item, g,
                        allDates.Where(d => d != g.DisplayDate).ToList(),
                        apptIndex: i + 1,
                        apptCount: sched.Groups.Count,
                        nextDate: i + 1 < sched.Groups.Count ? sched.Groups[i + 1].DisplayDate : null));
                }
            }
            else
            {
                if (_multiOnly) continue;
                // لا بيانات جدولة (فواتير بلا بنود/تخزين الميزة غائب) — صف واحد بتاريخ الفاتورة
                rows.Add(MakeRow(item, null, new List<DateTime?>()));
            }
        }

        // فلتر الحالة يُقيَّم على صف الموعد نفسه (خدمة القائمة ضمنت الفاتورة
        // بحالتها المعروضة — وهنا يُنتقى من صفوفها ما يطابق على مستوى موعده)
        if (!string.IsNullOrWhiteSpace(_status))
            rows = rows.Where(r => r.FilterStatus == _status).ToList();

        // الترتيب: تاريخ الموعد ثم رقم الفاتورة — الترقيم يعدّ الصفوف
        return rows.OrderBy(r => r.SortDate ?? DateTime.MaxValue)
                   .ThenBy(r => r.Item.TransactionId)
                   .ToList();
    }

    private DeliveryListRow MakeRow(
        VwSalesDeliveryStatus item, DeliveryScheduleGroupDto? g, List<DateTime?> otherDates,
        int apptIndex = 0, int apptCount = 0, DateTime? nextDate = null)
    {
        string text, filter;
        Color color;
        string icon;

        if (item.DeliveryStatus == StatusReturned)
        {
            // المرتجع حالة فاتورة نهائية — تظهر على صفوف مواعيدها كما هي
            text = filter = StatusReturned;
            color = Color.Dark;
            icon = Icons.Material.Filled.AssignmentReturn;
        }
        else if (g is null)
        {
            text = filter = item.DeliveryStatus;
            color = GetStatusColor(item.DeliveryStatus);
            icon = GetStatusIcon(item.DeliveryStatus);
        }
        else
        {
            // حالة الموعد بنفس اشتقاق مداخل المواعيد السابقة (التأخر على التاريخ المعروض)
            var st = DeliveryDisplay.AppointmentState(g.DisplayDate, g.PendingLineCount, g.HasOverdue);
            text = st.Text; color = st.Color; icon = st.Icon;
            filter = g.PendingLineCount == 0            ? StatusDelivered
                   : g.HasOverdue                        ? StatusOverdue
                   : item.DeliveryStatus == StatusPartial   ? StatusPartial
                   : item.DeliveryStatus == StatusDelivered ? StatusDelivered
                   : StatusPending;
        }

        return new DeliveryListRow
        {
            Item = item, Group = g,
            StateText = text, StateColor = color, StateIcon = icon,
            FilterStatus = filter, OtherDates = otherDates,
            AppointmentIndex = apptIndex, AppointmentCount = apptCount, NextDate = nextDate
        };
    }

    private void SetDebtFilter(string f)
    {
        _debtFilter = f;
        _ = SaveFilterStateAsync();
    }

    private void SetMultiOnly(bool multi)
    {
        _multiOnly = multi;
        _ = SaveFilterStateAsync();
    }

    private async Task SaveFilterStateAsync()
    {
        try
        {
            var state = System.Text.Json.JsonSerializer.Serialize(new DeliveryFilterState
            {
                From = _from,
                To = _to,
                DateFilterType = _dateFilterType,
                Search = _search,
                Status = _status,
                DebtFilter = _debtFilter,
                MultiOnly = _multiOnly
            });
            await JS.InvokeVoidAsync("localStorage.setItem", FilterStorageKey, state);
        }
        catch { }
    }

    private async Task RestoreFilterStateAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string>("localStorage.getItem", FilterStorageKey);
            if (string.IsNullOrWhiteSpace(json))
            {
                // ⭐ أول فتح للشاشة: الافتراضي «هذا الشهر»
                (_from, _to) = PeriodRange("month");
                return;
            }

            var saved = System.Text.Json.JsonSerializer.Deserialize<DeliveryFilterState>(json);
            if (saved == null)
                return;

            _from = saved.From;
            _to = saved.To;
            _dateFilterType = string.IsNullOrWhiteSpace(saved.DateFilterType)
                ? DeliveryDateFilterTypes.DueDate
                : saved.DateFilterType;
            _search = saved.Search;
            _status = saved.Status;
            _debtFilter = string.IsNullOrWhiteSpace(saved.DebtFilter) ? "all" : saved.DebtFilter;
            _multiOnly = saved.MultiOnly;
        }
        catch { }
    }

    // ─── Actions ───────────────────────────────────────────
    private async Task PrintDailySheetAsync()
    {
        try
        {
            _sheetRows = await DeliveryService.GetDailyDeliverySheetAsync(_from, _to);
            if (_sheetRows.Count == 0)
            {
                Snackbar.Add("لا توجد فواتير غير مسلَّمة في الفترة المحددة", Severity.Info);
                return;
            }
            _sheetPrintedAt = DateTime.Now;
            StateHasChanged();
            await Task.Delay(250);
            await JS.InvokeVoidAsync("window.print");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Print daily delivery sheet failed");
            Snackbar.Add("تعذّر تجهيز كشف التسليم: " + ex.Message, Severity.Error);
        }
    }

    private void OpenFullPage(int transactionId)
        => Nav.NavigateTo($"/sales-delivery-status/{transactionId}");

    private void OpenPurchaseReceiptsPage()
        => Nav.NavigateTo("/purchase-receipt-status");

    private async Task OpenDialogAsync(int transactionId)
    {
        var parameters = new DialogParameters<DeliveryDetailDialog>
        {
            { x => x.TransactionId, transactionId }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackdropClick = false
        };

        var dialog = await DialogService.ShowAsync<DeliveryDetailDialog>("تفاصيل التسليم", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is true)
            await RefreshAsync();
    }

    private async Task QuickConfirmDeliveryAsync(
        VwSalesDeliveryStatus item, DeliveryScheduleGroupDto? appointment = null)
    {
        // بوابة التغطية المالية صارت على مستوى الدفعة (المدفوع مقابل المسلَّم +
        // هذه الدفعة) ولا تُحسم من القائمة — حوار التسجيل نفسه يعرض حالة التغطية
        // وزر إرسال طلب الإذن، وخادم التسجيل يفرضها عند الحفظ.

        // ⭐ التسليم الجزئي: التأكيد الكلي الفوري استُبدل بحوار تسجيل تسليمة
        // بكميات البنود (قد تكون دفعة جزئية) — الحوار مهيأ بالمتبقي كاملًا افتراضيًا.
        // من مدخل «موعد» يُفتح الحوار مُنطقًا على بنود ذلك الموعد وحده.
        await OpenRecordDeliveryAsync(item.TransactionId, appointment);
    }

    private async Task OpenRecordDeliveryAsync(
        int transactionId, DeliveryScheduleGroupDto? appointment = null)
    {
        var parameters = new DialogParameters<RecordDeliveryDialog>
        {
            { x => x.TransactionId, transactionId }
        };
        if (appointment is not null)
        {
            // الموعد بصيغة العرض لهذا المستخدم — والحوار يقارنه بمواعيد بنوده المعروضة
            // بنفس الصيغة (ScheduledDate في DTO التقدم)، فالتطابق متسق داخل جلسة المستخدم
            parameters.Add(x => x.AppointmentDate, appointment.DisplayDate);
            parameters.Add(x => x.HasAppointmentScope, true);
        }

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackdropClick = false
        };

        var dialog = await DialogService.ShowAsync<RecordDeliveryDialog>("تسجيل تسليمة", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is true)
            await RefreshAsync();
    }

    // ─── UI Helpers ────────────────────────────────────────
    private record CardModel(string Label, string? Status, int Count, string ColorKey, string Icon, bool IsActive);

    private IEnumerable<CardModel> BuildCards() => new[]
    {
        new CardModel("الكل",           null,             _summary.TotalCount,     "primary", Icons.Material.Filled.ListAlt,    _status is null),
        new CardModel(StatusPending,    StatusPending,    _summary.PendingCount,   "warning", Icons.Material.Filled.Pending,    _status == StatusPending),
        new CardModel(StatusPartial,    StatusPartial,    _summary.PartialCount,   "info",    Icons.Material.Filled.PieChart,   _status == StatusPartial),
        new CardModel(StatusDelivered,  StatusDelivered,  _summary.DeliveredCount, "success", Icons.Material.Filled.CheckCircle,_status == StatusDelivered),
        new CardModel(StatusOverdue,    StatusOverdue,    _summary.OverdueCount,   "error",   Icons.Material.Filled.Warning,    _status == StatusOverdue),
    };

    private static Color GetStatusColor(string? status) => status switch
    {
        StatusPending   => Color.Warning,
        StatusPartial   => Color.Info,
        StatusOverdue   => Color.Error,
        StatusDelivered => Color.Success,
        StatusReturned  => Color.Dark,
        _               => Color.Default
    };

    private static string GetStatusIcon(string? status) => status switch
    {
        StatusPending   => Icons.Material.Filled.Pending,
        StatusPartial   => Icons.Material.Filled.PieChart,
        StatusOverdue   => Icons.Material.Filled.Warning,
        StatusDelivered => Icons.Material.Filled.CheckCircle,
        StatusReturned  => Icons.Material.Filled.AssignmentReturn,
        _               => Icons.Material.Filled.HelpOutline
    };

    private sealed class DeliveryFilterState
    {
        public DateTime? From { get; set; }
        public DateTime? To { get; set; }
        public string? DateFilterType { get; set; }
        public string? Search { get; set; }
        public string? Status { get; set; }
        public string? DebtFilter { get; set; }
        public bool MultiOnly { get; set; }
    }
}
