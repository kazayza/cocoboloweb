@page "/sales-delivery-status"
@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Models
@using COCOBOLOERPNEW.Services
@using COCOBOLOERPNEW.Components.Shared
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject ISalesDeliveryStatusService DeliveryService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<SalesDeliveryStatus> Logger
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

@attribute [Authorize]
@implements IDisposable

<PageTitle>متابعة التسليمات</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">

    @* ── Header ────────────────────────────────────────────── *@
    <MudPaper Elevation="0"
              Class="pa-4 mb-4 rounded-lg"
              Style="background:linear-gradient(135deg,#060C18 0%,#0D1B30 60%,#132A47 100%); color:white; border-bottom:2px solid var(--gold);">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Style="color:#ffd700; font-size:2rem;" />
                <div>
                    <MudText Typo="Typo.h5">متابعة التسليمات</MudText>
                    @if (_canSeeAmounts)
                    {
                        <MudText Typo="Typo.caption" Style="opacity:.85;">
                            الإجمالي: @_summary.TotalGrandTotal.ToString("N2") ج |
                            المدفوع: @_summary.TotalPaidAmount.ToString("N2") ج |
                            المتبقي: @_summary.TotalRemaining.ToString("N2") ج
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Style="opacity:.85;">
                            عدد الفواتير: @_summary.TotalCount
                            | 💰 عليها مديونية: @_items.Count(i => i.GrandTotal - i.PaidAmount > 0)
                        </MudText>
                    }
                </div>
            </MudStack>
            <MudStack Row="true" Spacing="1">
                @if (_canViewPurchaseReceipts)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Inherit"
                               StartIcon="@Icons.Material.Filled.Inventory2"
                               OnClick="OpenPurchaseReceiptsPage">
                        استلامات الشراء
                    </MudButton>
                }
                <MudTooltip Text="كشف التسليمات غير المسلَّمة (طباعة)">
                    <MudIconButton Icon="@Icons.Material.Filled.Print"
                                   Color="Color.Inherit"
                                   Disabled="_loading"
                                   OnClick="PrintDailySheetAsync" />
                </MudTooltip>
                <MudTooltip Text="تحديث">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Inherit"
                                   Disabled="_loading"
                                   OnClick="RefreshAsync" />
                </MudTooltip>
            </MudStack>
        </MudStack>
    </MudPaper>

    @* ── Summary Cards (Quick Filters) ─────────────────────── *@
    <MudGrid Spacing="2" Class="mb-4">
        @foreach (var card in BuildCards())
        {
            <MudItem xs="6" md="3">
                <MudPaper Elevation="@(card.IsActive ? 6 : 1)"
                          Class="@($"pa-4 rounded-lg cursor-pointer status-card {(card.IsActive ? "status-card--active" : "")}")"
                          Style="@($"background:var(--mud-palette-surface); border-right:4px solid var(--mud-palette-{card.ColorKey}); transition:all .2s;")"
                          @onclick="(() => SetStatusAsync(card.Status))">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <div>
                            <MudText Typo="Typo.body2" Style="opacity:.75;">@card.Label</MudText>
                            <MudText Typo="Typo.h4" Style="@($"color:var(--mud-palette-{card.ColorKey}); font-weight:800;")">@card.Count</MudText>
                        </div>
                        <MudIcon Icon="@card.Icon" Style="@($"font-size:2.2rem; color:var(--mud-palette-{card.ColorKey}); opacity:.45;")" />
                    </MudStack>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    @* ── Filters ───────────────────────────────────────────── *@
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <div class="df-row">
            <MudDatePicker @bind-Date="_from"
                           Label="من"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true"
                           Class="df-date"
                           MaxDate="_to ?? DateTime.Today" />
            <MudDatePicker @bind-Date="_to"
                           Label="إلى"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true"
                           Class="df-date"
                           MinDate="_from" />
            <MudSelect T="string"
                       @bind-Value="_dateFilterType"
                       Label="نوع التاريخ"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Class="df-type">
                <MudSelectItem T="string" Value="@DeliveryDateFilterTypes.DueDate">تاريخ الاستحقاق</MudSelectItem>
                <MudSelectItem T="string" Value="@DeliveryDateFilterTypes.InvoiceDate">تاريخ الفاتورة</MudSelectItem>
                <MudSelectItem T="string" Value="@DeliveryDateFilterTypes.DeliveredDate">تاريخ التسليم</MudSelectItem>
            </MudSelect>
            <MudTextField T="string"
                          @bind-Value="_search"
                          @bind-Value:after="OnSearchChangedAsync"
                          Label="العميل"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="df-search"
                          DebounceInterval="400"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Clearable="true" />
            <div class="df-actions">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="RefreshAsync"
                           Disabled="_loading">بحث</MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="ClearAsync"
                           Disabled="_loading">مسح</MudButton>
            </div>
        </div>

        @* ── شيبس سريعة: فترة + مديونية ── *@
        <div class="df-chips">
            <span class="df-chips-label">⚡ فترة:</span>
            <MudChip T="string" Size="Size.Small"
                     Color="@(IsPeriodActive("today") ? Color.Primary : Color.Default)"
                     Variant="@(IsPeriodActive("today") ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => SetPeriodAsync("today"))">اليوم</MudChip>
            <MudChip T="string" Size="Size.Small"
                     Color="@(IsPeriodActive("week") ? Color.Primary : Color.Default)"
                     Variant="@(IsPeriodActive("week") ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => SetPeriodAsync("week"))">هذا الأسبوع</MudChip>
            <MudChip T="string" Size="Size.Small"
                     Color="@(IsPeriodActive("month") ? Color.Primary : Color.Default)"
                     Variant="@(IsPeriodActive("month") ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => SetPeriodAsync("month"))">هذا الشهر</MudChip>
            <MudChip T="string" Size="Size.Small"
                     Color="@(!_from.HasValue && !_to.HasValue ? Color.Primary : Color.Default)"
                     Variant="@(!_from.HasValue && !_to.HasValue ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => SetPeriodAsync("all"))">كل الفترات</MudChip>

            <span class="df-chips-label df-chips-label--gap">💰 المديونية:</span>
            <MudChip T="string" Size="Size.Small"
                     Color="@(_debtFilter == "yes" ? Color.Error : Color.Default)"
                     Variant="@(_debtFilter == "yes" ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => SetDebtFilter("yes"))">عليها مديونية</MudChip>
            <MudChip T="string" Size="Size.Small"
                     Color="@(_debtFilter == "no" ? Color.Success : Color.Default)"
                     Variant="@(_debtFilter == "no" ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => SetDebtFilter("no"))">مفيش مديونية</MudChip>
            <MudChip T="string" Size="Size.Small"
                     Color="@(_debtFilter == "all" ? Color.Primary : Color.Default)"
                     Variant="@(_debtFilter == "all" ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => SetDebtFilter("all"))">الكل</MudChip>
        </div>
    </MudPaper>

    @* ── Data Table ────────────────────────────────────────── *@
    <MudPaper Elevation="1">
        <MudTable T="VwSalesDeliveryStatus"
                  Items="_displayItems"
                  Dense="true"
                  Hover="true"
                  Striped="true"
                  Loading="_loading"
                  LoadingProgressColor="Color.Primary"
                  Breakpoint="Breakpoint.Sm"
                  Elevation="0">
            <NoRecordsContent>
                <AppEmpty Icon="@Icons.Material.Filled.LocalShipping"
                          Message="لا توجد فواتير مطابقة"
                          Description="جرّب تغيير الفلاتر أو الفترة الزمنية" />
            </NoRecordsContent>
            <HeaderContent>
                <MudTh>رقم</MudTh>
                <MudTh>التاريخ</MudTh>
                <MudTh>التسليم</MudTh>
                <MudTh>العميل</MudTh>
                <MudTh>المندوب</MudTh>
                @if (_canSeeAmounts)
                {
                    <MudTh Style="text-align:end;">الإجمالي</MudTh>
                    <MudTh Style="text-align:end;">المتبقي</MudTh>
                }
                <MudTh>الحالة</MudTh>
                <MudTh Style="text-align:center;">إجراءات</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="رقم">@context.TransactionId</MudTd>
                <MudTd DataLabel="التاريخ">@context.TransactionDate.ToString("yyyy/MM/dd")</MudTd>
                <MudTd DataLabel="التسليم">
                    @if (context.DueDate.HasValue)
                    {
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <span>@context.DueDate.Value.ToString("yyyy/MM/dd")</span>
                            @if (context.DaysRemaining.HasValue && context.DeliveryStatus != StatusDelivered)
                            {
                                var d = context.DaysRemaining.Value;
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(d < 0 ? Color.Error : d <= 2 ? Color.Warning : Color.Default)">
                                    @(d < 0 ? $"متأخر {Math.Abs(d)} يوم" : $"باقي {d} يوم")
                                </MudChip>
                            }
                        </MudStack>
                    }
                    else { <span>—</span> }
                </MudTd>
                <MudTd DataLabel="العميل">
                    <MudLink Href="@($"/sales-delivery-status/{context.TransactionId}")"
                             Style="text-decoration:none; color:inherit;">@context.PartyName</MudLink>
                </MudTd>
                <MudTd DataLabel="المندوب">@(string.IsNullOrWhiteSpace(context.DeliveryEmployeeName) ? "—" : context.DeliveryEmployeeName)</MudTd>

                @if (_canSeeAmounts)
                {
                    <MudTd DataLabel="الإجمالي" Style="text-align:end;">@context.GrandTotal.ToString("N2")</MudTd>
                    <MudTd DataLabel="المتبقي" Style="text-align:end;">
                        @{ var remaining = context.GrandTotal - context.PaidAmount; }
                        <span style="@(remaining > 0 ? "color:#d32f2f; font-weight:600;" : "color:#388e3c;")">
                            @remaining.ToString("N2")
                        </span>
                    </MudTd>
                }

                <MudTd DataLabel="الحالة">
                    <MudStack Column="true" Spacing="0" AlignItems="AlignItems.Start">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Filled"
                                 Icon="@GetStatusIcon(context.DeliveryStatus)"
                                 Color="@GetStatusColor(context.DeliveryStatus)">
                            @context.DeliveryStatus
                        </MudChip>
                        @if (!_canSeeAmounts && context.GrandTotal - context.PaidAmount > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                     Color="Color.Error" Icon="@Icons.Material.Filled.Payments">
                                عليها مديونية
                            </MudChip>
                        }
                        @if (_permStates.TryGetValue(context.TransactionId, out var pst))
                        {
                            @if (pst.HasPendingRequest)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                         Color="Color.Warning" Icon="@Icons.Material.Filled.HourglassTop">
                                    طلب إذن معلق
                                </MudChip>
                            }
                            else if (!string.IsNullOrWhiteSpace(pst.GrantedBy) && context.DeliveryStatus != StatusDelivered)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                         Color="Color.Success" Icon="@Icons.Material.Filled.Verified">
                                    إذن ممنوح: @pst.GrantedBy
                                </MudChip>
                            }
                        }
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="إجراءات" Style="text-align:center;">
                    <MudStack Row="true" Spacing="0" Justify="Justify.Center">
                        <MudTooltip Text="فتح التفاصيل الكاملة">
                            <MudIconButton Icon="@Icons.Material.Filled.OpenInFull"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           OnClick="@(() => OpenFullPage(context.TransactionId))" />
                        </MudTooltip>
                        @if (_canEditFull)
                        {
                            <MudTooltip Text="تعديل سريع">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Color="Color.Secondary"
                                               OnClick="@(() => OpenDialogAsync(context.TransactionId))" />
                            </MudTooltip>
                        }
                        @if (_canConfirmDelivery && context.DeliveryStatus != StatusDelivered)
                        {
                            <MudTooltip Text="تأكيد التسليم">
                                <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                               Size="Size.Small"
                                               Color="Color.Success"
                                               OnClick="@(() => QuickConfirmDeliveryAsync(context))" />
                            </MudTooltip>
                        }
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="@(new int[] { 10, 25, 50, 100 })"
                               RowsPerPageString="عدد الصفوف"
                               InfoFormat="{first_item}-{last_item} من {all_items}" />
            </PagerContent>
        </MudTable>
    </MudPaper>

    @* ── ورقة طباعة كشف التسليم (تظهر في الطباعة فقط — بدون مبالغ) ── *@
    @if (_sheetRows.Count > 0)
    {
        <div class="dds-print-sheet">
            <div class="dds-title">كشف التسليمات غير المسلَّمة</div>
            <div class="dds-meta">
                الفترة: @((_from ?? _to ?? DateTime.Today).ToString("yyyy/MM/dd")) — @((_to ?? DateTime.Today).ToString("yyyy/MM/dd"))
                &nbsp;|&nbsp; عدد الفواتير: @_sheetRows.Count
                &nbsp;|&nbsp; طُبع في: @_sheetPrintedAt?.ToString("yyyy/MM/dd HH:mm")
            </div>
            <table>
                <thead>
                    <tr>
                        <th style="width:34px;">م</th>
                        <th style="width:64px;">رقم</th>
                        <th>العميل</th>
                        <th style="width:110px;">التليفون</th>
                        <th>العنوان</th>
                        <th style="width:88px;">الاستحقاق</th>
                        <th style="width:64px;">الحالة</th>
                        <th style="width:110px;">مندوب التسليم</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int sn = 0; }
                    @foreach (var r in _sheetRows)
                    {
                        sn++;
                        <tr>
                            <td style="text-align:center;">@sn</td>
                            <td style="text-align:center;">@r.TransactionId</td>
                            <td>@r.PartyName</td>
                            <td>@(r.Phone ?? "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(r.Address) ? "—" : r.Address)</td>
                            <td style="text-align:center;">@(r.DueDate?.ToString("yyyy/MM/dd") ?? "—")</td>
                            <td style="text-align:center;">@r.DeliveryStatus</td>
                            <td>@(r.DeliveryEmployeeName ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="dds-sign">توقيع مسئول التسليم: ............................</div>
        </div>
    }

</MudContainer>

<style>
    /* ── صف الفلاتر: سطر واحد متناسق حسب حجم الشاشة ── */
    .df-row { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }
    .df-row .mud-input-control { margin: 0; }
    .df-date   { flex: 1 1 150px; min-width: 140px; max-width: 200px; }
    .df-type   { flex: 1 1 160px; min-width: 150px; max-width: 210px; }
    .df-search { flex: 3 1 220px; min-width: 180px; }
    .df-actions { display: flex; gap: .4rem; flex: 0 0 auto; margin-inline-start: auto; }
    .df-chips { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem; margin-top: .75rem; }
    .df-chips-label { font-size: .78rem; opacity: .7; margin-inline-end: .2rem; }
    .df-chips-label--gap { margin-inline-start: .8rem; }

    .status-card { user-select:none; }
    .status-card:hover { transform: translateY(-2px); }
    .status-card--active { outline: 3px solid var(--gold); outline-offset: -3px; }
    .cursor-pointer { cursor: pointer; }

    /* ── ورقة كشف التسليم (طباعة فقط) ── */
    .dds-print-sheet { display: none; }

    @@media print {
        @@page { size: A4 landscape; margin: 10mm; }
        body * { visibility: hidden !important; }
        .dds-print-sheet, .dds-print-sheet * { visibility: visible !important; }
        .dds-print-sheet {
            display: block !important;
            position: absolute; top: 0; right: 0; left: 0;
            background: #fff; color: #000;
            font-family: 'Tajawal', 'Segoe UI', sans-serif;
        }
        .dds-print-sheet .dds-title { font-size: 22px; font-weight: 800; text-align: center;
            border-bottom: 2px solid #000; padding-bottom: 6px; margin-bottom: 6px; }
        .dds-print-sheet .dds-meta { font-size: 12px; margin-bottom: 8px; }
        .dds-print-sheet table { width: 100%; border-collapse: collapse; }
        .dds-print-sheet th, .dds-print-sheet td { border: 1px solid #333; padding: 5px 7px; font-size: 12px; text-align: right; }
        .dds-print-sheet th { background: #eee; }
        .dds-print-sheet .dds-sign { margin-top: 26px; font-size: 13px; }
    }
</style>

@code {
    // ─── Constants ─────────────────────────────────────────
    private const string StatusPending   = "جارى";
    private const string StatusDelivered = "تم التسليم";
    private const string StatusOverdue   = "متأخر";

    // ─── State ─────────────────────────────────────────────
    private const string FilterStorageKey = "sales_delivery_status_filters_v2";
    private List<VwSalesDeliveryStatus> _items   = new();
    private DeliverySummaryDto          _summary = new();
    private bool        _loading = true;
    private DateTime?   _from;
    private DateTime?   _to;
    private string _dateFilterType = DeliveryDateFilterTypes.DueDate;
    private string?     _search;
    private string?     _status;
    private string      _debtFilter = "all";   // all | yes 💰 | no ✅ — نعم/لا بدون أي مبالغ

    // ─── Permissions ───────────────────────────────────────
    private bool _canSeeAmounts;
    private bool _canEditFull;
    private bool _canConfirmDelivery;
    private bool _canViewPurchaseReceipts;
    private bool _canOverride;
    private string _currentUserName = "system";
    private Dictionary<int, DeliveryPermissionStateDto> _permStates = new();
    private List<DailyDeliverySheetRowDto> _sheetRows = new();
    private DateTime? _sheetPrintedAt;

    private CancellationTokenSource? _cts;

    // ─── Lifecycle ─────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await LoadPermissionsAsync();
        await RestoreFilterStateAsync();
        await RefreshAsync();
    }

    private async Task LoadPermissionsAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;

        if (!DeliveryPermissions.CanView(user))
        {
            Nav.NavigateTo("/");
            return;
        }

        _currentUserName    = user.Identity?.Name ?? "system";
        _canSeeAmounts      = DeliveryPermissions.CanSeeAmounts(user);
        _canEditFull        = DeliveryPermissions.CanEditFull(user);
        _canConfirmDelivery = DeliveryPermissions.CanConfirmDelivery(user);
        _canOverride        = DeliveryPermissions.CanOverrideRemaining(user);
        _canViewPurchaseReceipts = user.IsInRole("Admin")
            || user.IsInRole(SystemRoles.Admin)
            || user.IsInRole("AccountManager")
            || user.IsInRole(SystemRoles.AccountManager)
            || user.IsInRole("factory")
            || user.IsInRole(SystemRoles.ProductionManager)
            || user.IsInRole(SystemRoles.FactoryManager)
            || user.HasClaim("Permission", "frm_SupplierInvoices:View");
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    // ─── Data Loading ──────────────────────────────────────
    private async Task RefreshAsync()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        _loading = true;
        StateHasChanged();

        try
        {
            var itemsTask   = DeliveryService.GetFilteredAsync(_from, _to, _dateFilterType, _search, _status);
            var summaryTask = DeliveryService.GetSummaryAsync(_from, _to, _dateFilterType, _search, _status);

            await Task.WhenAll(itemsTask, summaryTask);

            if (token.IsCancellationRequested) return;

            _items   = (await itemsTask)
                .OrderBy(i => i.DeliveryStatus == StatusDelivered)   // ⭐ غير المسلَّمة أولاً
                .ThenBy(i => i.DueDate ?? DateTime.MaxValue)         // ثم الأقرب استحقاقاً
                .ThenByDescending(i => i.TransactionId)
                .ToList();
            _summary = await summaryTask;

            // حالات إذن التسليم (طلبات معلقة / أذون ممنوحة)
            try
            {
                _permStates = await DeliveryService.GetDeliveryPermissionStatesAsync(
                    _items.Select(i => i.TransactionId).ToList());
            }
            catch { _permStates = new(); }

            await SaveFilterStateAsync();
        }
        catch (OperationCanceledException) { /* normal */ }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load deliveries");
            Snackbar.Add("تعذّر تحميل البيانات: " + ex.Message, Severity.Error);
            _items = new();
            _summary = new();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private Task OnSearchChangedAsync() => RefreshAsync();

    private async Task ClearAsync()
    {
        _from = null;
        _to = null;
        _search = null;
        _status = null;
        _debtFilter = "all";
        _dateFilterType = DeliveryDateFilterTypes.DueDate;
        await RefreshAsync();
    }

    private async Task SetStatusAsync(string? status)
    {
        _status = (_status == status) ? null : status;
        await RefreshAsync();
    }

    // ── ⚡ الفترات السريعة: اليوم / هذا الأسبوع (من السبت) / هذا الشهر / الكل ──
    private static DateTime WeekStart(DateTime d) =>
        d.AddDays(-(((int)d.DayOfWeek - (int)DayOfWeek.Saturday) + 7) % 7);

    private static (DateTime? From, DateTime? To) PeriodRange(string preset)
    {
        var today = DateTime.Today;
        return preset switch
        {
            "today" => (today, today),
            "week"  => (WeekStart(today), WeekStart(today).AddDays(6)),
            "month" => (new DateTime(today.Year, today.Month, 1),
                        new DateTime(today.Year, today.Month, 1).AddMonths(1).AddDays(-1)),
            _       => (null, null)
        };
    }

    private bool IsPeriodActive(string preset)
    {
        var (f, t) = PeriodRange(preset);
        return _from?.Date == f?.Date && _to?.Date == t?.Date;
    }

    private async Task SetPeriodAsync(string preset)
    {
        (_from, _to) = PeriodRange(preset);
        await RefreshAsync();
    }

    // ── 💰 فلتر المديونية: client-side — نعم/لا فقط بدون أي مبالغ ──
    private IEnumerable<VwSalesDeliveryStatus> _displayItems => _debtFilter switch
    {
        "yes" => _items.Where(i => i.GrandTotal - i.PaidAmount > 0),
        "no"  => _items.Where(i => i.GrandTotal - i.PaidAmount <= 0),
        _     => _items
    };

    private void SetDebtFilter(string f)
    {
        _debtFilter = f;
        _ = SaveFilterStateAsync();
    }

    private async Task SaveFilterStateAsync()
    {
        try
        {
            var state = System.Text.Json.JsonSerializer.Serialize(new DeliveryFilterState
            {
                From = _from,
                To = _to,
                DateFilterType = _dateFilterType,
                Search = _search,
                Status = _status,
                DebtFilter = _debtFilter
            });
            await JS.InvokeVoidAsync("localStorage.setItem", FilterStorageKey, state);
        }
        catch { }
    }

    private async Task RestoreFilterStateAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string>("localStorage.getItem", FilterStorageKey);
            if (string.IsNullOrWhiteSpace(json))
            {
                // ⭐ أول فتح للشاشة: الافتراضي «هذا الشهر»
                (_from, _to) = PeriodRange("month");
                return;
            }

            var saved = System.Text.Json.JsonSerializer.Deserialize<DeliveryFilterState>(json);
            if (saved == null)
                return;

            _from = saved.From;
            _to = saved.To;
            _dateFilterType = string.IsNullOrWhiteSpace(saved.DateFilterType)
                ? DeliveryDateFilterTypes.DueDate
                : saved.DateFilterType;
            _search = saved.Search;
            _status = saved.Status;
            _debtFilter = string.IsNullOrWhiteSpace(saved.DebtFilter) ? "all" : saved.DebtFilter;
        }
        catch { }
    }

    // ─── Actions ───────────────────────────────────────────
    private async Task PrintDailySheetAsync()
    {
        try
        {
            _sheetRows = await DeliveryService.GetDailyDeliverySheetAsync(_from, _to);
            if (_sheetRows.Count == 0)
            {
                Snackbar.Add("لا توجد فواتير غير مسلَّمة في الفترة المحددة", Severity.Info);
                return;
            }
            _sheetPrintedAt = DateTime.Now;
            StateHasChanged();
            await Task.Delay(250);
            await JS.InvokeVoidAsync("window.print");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Print daily delivery sheet failed");
            Snackbar.Add("تعذّر تجهيز كشف التسليم: " + ex.Message, Severity.Error);
        }
    }

