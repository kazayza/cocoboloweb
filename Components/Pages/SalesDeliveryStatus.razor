    private async Task OpenDialogAsync(int transactionId)
    {
        var parameters = new DialogParameters<DeliveryDetailDialog>
        {
            { x => x.TransactionId, transactionId }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackdropClick = false
        };

        var dialog = await DialogService.ShowAsync<DeliveryDetailDialog>("تفاصيل التسليم", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is true)
            await RefreshAsync();
    }

    private async Task QuickConfirmDeliveryAsync(VwSalesDeliveryStatus item)
    {
        // 🔒 قاعدة المبالغ المتبقية: لا تسليم إلا بموافقة المدير/مدير الحسابات أو بإذن ممنوح
        var remaining = item.GrandTotal - item.PaidAmount;
        var permState = _permStates.TryGetValue(item.TransactionId, out var ps) ? ps : null;

        if (remaining > 0 && !_canOverride && permState?.GrantedBy == null)
        {
            var reqParams = new DialogParameters<MudMessageBox>
            {
                { x => x.Title,      "لا يمكن التسليم" },
                { x => x.Message,    $"الفاتورة رقم {item.TransactionId} — يوجد مبالغ متبقية على هذه الفاتورة. برجاء مراجعة مدير الحسابات أو مسئول الحسابات أو المدير." },
                { x => x.YesText,    "إرسال طلب إذن تسليم" },
                { x => x.CancelText, "إغلاق" }
            };
            var reqDlg = await DialogService.ShowAsync<MudMessageBox>("لا يمكن التسليم", reqParams,
                new DialogOptions { MaxWidth = MaxWidth.ExtraSmall });
            var reqRes = await reqDlg.Result;
            if (reqRes is null || reqRes.Canceled) return;

            try
            {
                var (ok, msg) = await DeliveryService.RequestDeliveryPermissionAsync(item.TransactionId, _currentUserName);
                Snackbar.Add(msg, ok ? Severity.Success : Severity.Warning);
                if (ok) await RefreshAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Request delivery permission failed for {Id}", item.TransactionId);
                Snackbar.Add("حدث خطأ أثناء إرسال الطلب: " + ex.Message, Severity.Error);
            }
            return;
        }

        var parameters = new DialogParameters<MudMessageBox>
        {
            { x => x.Title,      "تأكيد التسليم" },
            { x => x.Message,    remaining > 0
                                 ? $"⚠️ يوجد مبلغ متبقٍ {remaining:N2} ج على الفاتورة رقم {item.TransactionId} (العميل {item.PartyName}). هل توافق على التسليم؟"
                                 : $"هل تريد تأكيد تسليم الفاتورة رقم {item.TransactionId} للعميل {item.PartyName}؟" },
            { x => x.YesText,    remaining > 0 ? "نعم، موافقة والتسليم" : "نعم، تم التسليم" },
            { x => x.CancelText, "إلغاء" }
        };

        var msgDialog = await DialogService.ShowAsync<MudMessageBox>(
            "تأكيد التسليم", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall });

        var msgResult = await msgDialog.Result;
        if (msgResult is null || msgResult.Canceled) return;

        try
        {
            // ⭐ تسجيل الموظف في التسليم السريع:
            // 1) مندوب متحدد أصلاً → نحتفظ بكوده واسمه
            // 2) مفيش مندوب → نجيب الموظف (كود + اسم) المرتبط بحساب اللي داس الزرار
            int? empId   = item.DeliveryEmployeeId;
            string? empName = item.DeliveryEmployeeName;
            if (empId == null && string.IsNullOrWhiteSpace(empName))
            {
                var (id, name) = await DeliveryService.GetEmployeeByUserNameAsync(_currentUserName);
                empId   = id;
                empName = string.IsNullOrWhiteSpace(name) ? _currentUserName : name;
            }

            var dto = new DeliveryUpdateDto
            {
                TransactionId        = item.TransactionId,
                Status               = StatusDelivered,
                DeliveryEmployeeId   = empId,
                DeliveryEmployeeName = empName,
                DeliveredAt          = DateTime.Now,
                Notes                = item.DeliveredNotes,
                UserName             = _currentUserName
            };

            var (success, message) = await DeliveryService.UpdateDeliveryStatusAsync(dto);

            if (success)
            {
                Snackbar.Add(message, Severity.Success);
                await RefreshAsync();
            }
            else
            {
                Snackbar.Add(message, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Quick confirm delivery failed for {Id}", item.TransactionId);
            Snackbar.Add("حدث خطأ أثناء تأكيد التسليم: " + ex.Message, Severity.Error);
        }
    }

