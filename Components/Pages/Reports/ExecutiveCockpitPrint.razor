</style>

@code {
    [SupplyParameterFromQuery] public string? period { get; set; }
    [SupplyParameterFromQuery] public int? branch { get; set; }
    [SupplyParameterFromQuery] public DateTime? from { get; set; }
    [SupplyParameterFromQuery] public DateTime? to { get; set; }
    [SupplyParameterFromQuery] public long? snapshot { get; set; }

    private bool _loading = true;
    private bool _noAccess;
    private bool _isSnapshot;
    private ExecutiveCockpitDto? _data;
    private ExecutiveCockpitSnapshotItemDto? _snapshotMeta;

    private string? _companyName;
    private string? _companyContact;
    private string? _logoSrc;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        var allowed = user.IsInRole("Admin")
                   || user.HasClaim(c => c.Type == "Permission" && c.Value == "frm_ExecutiveCockpit:View");
        if (!allowed)
        {
            _noAccess = true;
            _loading = false;
            return;
        }

        await LoadCompanyAsync();

        if (snapshot.HasValue)
        {
            _isSnapshot = true;
            var detail = await SnapshotService.GetSnapshotAsync(snapshot.Value);
            if (detail != null)
            {
                _data = detail.Data;
                _snapshotMeta = detail.Meta;
            }
        }
        else
        {
            try
            {
                _data = await CockpitService.GetCockpitAsync(
                    string.IsNullOrWhiteSpace(period) ? "month" : period,
                    branch, from, to, userScope: "print");
            }
            catch
            {
                _data = null;
            }
        }

        _loading = false;
    }

    private async Task LoadCompanyAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var info = await db.CompanyInfos.AsNoTracking().OrderBy(c => c.CompanyId).FirstOrDefaultAsync();
            if (info != null)
            {
                _companyName = info.CompanyName;
                var parts = new List<string>();
                if (!string.IsNullOrWhiteSpace(info.Address)) parts.Add(info.Address);
                if (!string.IsNullOrWhiteSpace(info.Phone1)) parts.Add("ت: " + info.Phone1);
                _companyContact = string.Join(" — ", parts);
                _logoSrc = info.Logo is { Length: > 0 }
                    ? $"data:image/png;base64,{Convert.ToBase64String(info.Logo)}"
                    : (string.IsNullOrWhiteSpace(info.LogoPath) ? null : info.LogoPath);
            }
        }
        catch { /* الترويسة تعمل بلا بيانات شركة */ }
    }

    private bool Failed(string section) => _data?.FailedSections.Contains(section) == true;

    private string BranchIgnoredText()
    {
        if (_data == null) return "";
        var names = new Dictionary<string, string>
        {
            ["marketing"] = "التسويق",
            ["b2b"] = "بوابة B2B",
            ["gm"] = "لوحة المدير العام",
            ["complaints"] = "الشكاوى"
        };
        return string.Join("، ", _data.BranchIgnoredSections.Select(k => names.GetValueOrDefault(k, k)));
    }

    private RenderFragment KpiRow(string label, ExecutiveKpiDto k) => builder =>
    {
        builder.OpenElement(0, "tr");
        builder.OpenElement(1, "td");
        builder.AddContent(2, label);
        builder.CloseElement();
        builder.OpenElement(3, "td");
        builder.AddAttribute(4, "class", "num");
        builder.AddContent(5, $"{k.Value:N0} ج");
        builder.CloseElement();
        builder.OpenElement(6, "td");
        builder.AddAttribute(7, "class", "num");
        builder.AddContent(8, PctText(k.PrevPctOrNull));
        builder.CloseElement();
        builder.OpenElement(9, "td");
        builder.AddAttribute(10, "class", "num");
        builder.AddContent(11, PctText(k.YearPctOrNull));
        builder.CloseElement();
        builder.CloseElement();
    };

    private static string PctText(decimal? pct)
        => pct == null ? "—" : $"{(pct.Value >= 0 ? "+" : "")}{pct.Value}%";

    private async Task PrintNow() => await JS.InvokeVoidAsync("window.print");

    private void GoBack() => Nav.NavigateTo("/executive-cockpit");
}
