        .pb-table td { border: 1px solid #b9b9b9; padding: .38rem .55rem; font-size: .8rem; color: #000; }
        .pb-table td.val { text-align: left; font-weight: 800; white-space: nowrap; font-variant-numeric: tabular-nums; }
        .pb-table tr.pb-subhead td { background: #eef2f7; font-weight: 900; color: #0F1D36; font-size: .82rem; }
