@page "/reports/balance-sheet"
@page "/financial/balance-sheet"

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using System.Globalization
@using MudBlazor

@inject IFinancialReportsService FinancialService
@inject IBranchService BranchService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>قائمة المركز المالي</PageTitle>

@if (_isLoading)
{
    <div class="loading-screen">
        <MudProgressCircular Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Large" Indeterminate="true" />
        <p>جاري إعداد قائمة المركز المالي...</p>
    </div>
}
else if (!_canView)
{
    <MudAlert Severity="MudBlazor.Severity.Error" Variant="MudBlazor.Variant.Filled" Class="ma-4">
        غير مسموح لك بعرض هذه الشاشة.
    </MudAlert>
}
else if (_report != null)
{
    <div class="bs-page" dir="rtl">

        <!-- ═══ ترويسة الطباعة ═══ -->
        <div class="print-only print-header">
            <div class="ph-top">
                <div class="ph-brand">
                    <img src="logo.png" class="ph-logo" alt="" />
                    <div>
                        <div class="ph-company">COCOBOLO <span>ERP</span></div>
                        <div class="ph-sub">نظام إدارة الأعمال المتكامل</div>
                    </div>
                </div>
                <div class="ph-title">
                    <h1>قائمة المركز المالي</h1>
                    <p>@(_report.IsBranchScoped ? $"فرع: {_report.BranchName}" : "الشركة — على مستوى كل الفروع") — كما في @(_report.AsOfLabel)</p>
                </div>
                <div class="ph-meta">
                    <span>صادر بتاريخ</span>
                    <strong>@DateTime.Now.ToString("yyyy-MM-dd")</strong>
                    <span>@DateTime.Now.ToString("HH:mm")</span>
                </div>
            </div>
        </div>

        <!-- ═══ جسم التقرير المطبوع — صيغة الميزانية الكلاسيكية (عمودان متقابلان) ═══ -->
        <div class="print-only print-body">
            <div class="pb-grid">
                <table class="pb-table">
                    <thead>
                        <tr><th colspan="2" class="pb-col-head assets">الأصول</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>النقدية والخزائن</td><td class="val">@FormatMoney(_report.CashBalance)</td></tr>
                        <tr><td>المدينون (عملاء)</td><td class="val">@FormatMoney(_report.AccountsReceivable)</td></tr>
                        <tr><td>المخزون</td><td class="val">@FormatMoney(_report.InventoryValue)</td></tr>
                        <tr><td>سلف الموظفين</td><td class="val">@FormatMoney(_report.EmployeeLoansOutstanding)</td></tr>
                    </tbody>
                    <tfoot>
                        <tr><td>إجمالي الأصول</td><td class="val">@FormatMoney(_report.TotalAssets)</td></tr>
                    </tfoot>
                </table>
                <table class="pb-table">
                    <thead>
                        <tr><th colspan="2" class="pb-col-head liab">الالتزامات وحقوق الملكية</th></tr>
                    </thead>
                    <tbody>
                        <tr class="pb-subhead"><td colspan="2">الالتزامات</td></tr>
                        <tr><td>رواتب مستحقة</td><td class="val">@FormatMoney(_report.PayrollOutstanding)</td></tr>
                        <tr><td>مستحقات موردين</td><td class="val">@FormatMoney(_report.SupplierPayables)</td></tr>
                        <tr class="pb-sub"><td>إجمالي الالتزامات</td><td class="val">@FormatMoney(_report.TotalLiabilities)</td></tr>
                        <tr class="pb-subhead"><td colspan="2">حقوق الملكية</td></tr>
                        <tr><td>رأس المال الافتتاحي</td><td class="val">@FormatMoney(_report.OpeningCapital)</td></tr>
                        <tr><td>الأرباح المحتجزة</td><td class="val">@FormatMoney(_report.RetainedEarnings)</td></tr>
                        <tr class="pb-sub"><td>إجمالي حقوق الملكية</td><td class="val">@FormatMoney(_report.TotalEquity)</td></tr>
                    </tbody>
                    <tfoot>
                        <tr><td>إجمالي الالتزامات وحقوق الملكية</td><td class="val">@FormatMoney(_report.LiabilitiesAndEquity)</td></tr>
                    </tfoot>
                </table>
            </div>
            <div class="pb-balance">
                الأصول <b>@FormatMoney(_report.TotalAssets)</b>
                = الالتزامات + حقوق الملكية <b>@FormatMoney(_report.LiabilitiesAndEquity)</b>
                <span class="pb-diff">(الفرق: @FormatMoney(_report.BalanceDifference) — @_report.BalanceStatus)</span>
            </div>
        </div>

        <!-- ═══ الهيدر ═══ -->
        <div class="bs-header no-print">
            <div class="header-bg">
                <div class="header-gradient"></div>
                <div class="header-orbs">
                    <div class="header-orb orb-1"></div>
                    <div class="header-orb orb-2"></div>
                </div>
            </div>
            <div class="header-content">
                <div class="header-title">
                    <div class="header-icon"><MudIcon Icon="@Icons.Material.Filled.AccountBalance" /></div>
                    <div>
                        <h1>قائمة المركز المالي</h1>
                        <p>@(_report.IsBranchScoped ? $"فرع {_report.BranchName}" : "الشركة — كل الفروع") · @(_report.AsOfLabel)</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ شريط النطاق والأدوات ═══ -->
        <div class="toolbar no-print">
            <div class="scope-group">
                <span class="scope-label"><MudIcon Icon="@Icons.Material.Filled.FilterAlt" /> نطاق العرض</span>
                <button type="button" class="scope-chip @(!_report.IsBranchScoped ? "active" : "")" @onclick='@(() => PickScopeAsync(null))'>
                    🏢 الشركة
                </button>
                @foreach (var b in _branches)
                {
                    <button type="button" class="scope-chip @(_report.BranchId == b.BranchId ? "active" : "")"
                            @onclick='@(() => PickScopeAsync(b.BranchId))'>
                        📍 @b.BranchNameAr
                    </button>
                }
            </div>
            <div class="toolbar-actions">
                @if (_isAdmin)
                {
                    <MudButton Variant="MudBlazor.Variant.Text" Color="MudBlazor.Color.Warning"
                               StartIcon="@Icons.Material.Filled.Savings" OnClick="OpenCapitalDialog">
                        رأس المال
                    </MudButton>
                }
                <MudButton Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Primary"
                           StartIcon="@Icons.Material.Filled.Print" OnClick="PrintReport">
                    طباعة
                </MudButton>
            </div>
        </div>

        <!-- شريط تحديث رفيع (بدون إعادة تحميل الصفحة) -->
        <div class="refresh-bar @(_isRefreshing ? "on" : "")"></div>

        <!-- ملاحظة الفرع (سطر واحد فقط) -->
        @if (_report.IsBranchScoped)
        {
            <div class="scope-note no-print">
                <MudIcon Icon="@Icons.Material.Filled.Info" />
                رأس المال أصل يخص الشركة كاملة ولا يُقسَّم على الفروع — حكم التوازن يظهر باختيار «الشركة».
            </div>
        }

        <div class="bs-content @(_isRefreshing ? "refreshing" : "")">

        <!-- ═══ لوحة التوازن (الشركة فقط) ═══ -->
        @if (!_report.IsBranchScoped)
        {
            <div class="balance-panel @(_report.IsBalanced ? "balanced" : "off-balance")">
                <div class="balance-main">
                    <MudIcon Icon="@(_report.IsBalanced ? Icons.Material.Filled.Verified : Icons.Material.Filled.ReportProblem)"
                             Class="balance-icon" />
                    <div>
                        <span class="balance-title">
                            الميزانية @_report.BalanceStatus
                            <MudTooltip Text="الفرق = الأصول − (الالتزامات + حقوق الملكية). لو الفرق ≠ صفر: راجع رأس المال الافتتاحي أو حركات نقدية غير مرتبطة بفواتير أو سحوبات ملاك.">
                                <MudIconButton Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="row-info" />
                            </MudTooltip>
                        </span>
                        <span class="balance-sub">الأصول @FormatMoney(_report.TotalAssets) = الالتزامات + حقوق الملكية @FormatMoney(_report.LiabilitiesAndEquity)</span>
                    </div>
                </div>
                <div class="balance-diff @(_report.IsBalanced ? "" : (_report.BalanceDifference > 0 ? "pos" : "neg"))">
                    <span>الفرق</span>
                    <strong>@FormatMoney(_report.BalanceDifference)</strong>
                </div>
            </div>
        }

        <!-- ═══ الأرقام الرئيسية ═══ -->
        <MudGrid Spacing="3" Class="mb-2">
            <MudItem xs="12" md="4">
                <div class="hero-card assets">
                    <div class="hero-icon"><MudIcon Icon="@Icons.Material.Filled.Paid" /></div>
                    <div class="hero-info">
                        <span class="hero-label">إجمالي الأصول</span>
                        <span class="hero-value">@FormatMoney(_report.TotalAssets)</span>
                        <span class="hero-sub">نقدية + مدينون + مخزون + سلف</span>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" md="4">
                <div class="hero-card liabilities">
                    <div class="hero-icon"><MudIcon Icon="@Icons.Material.Filled.CreditScore" /></div>
                    <div class="hero-info">
                        <span class="hero-label">إجمالي الالتزامات</span>
                        <span class="hero-value">@FormatMoney(_report.TotalLiabilities)</span>
                        <span class="hero-sub">رواتب مستحقة + مستحقات موردين</span>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" md="4">
                <div class="hero-card equity">
                    <div class="hero-icon"><MudIcon Icon="@Icons.Material.Filled.Workspaces" /></div>
                    <div class="hero-info">
                        <span class="hero-label">حقوق الملكية</span>
                        <span class="hero-value">@FormatMoney(_report.TotalEquity)</span>
                        <span class="hero-sub">رأس مال + أرباح محتجزة</span>
                    </div>
                </div>
            </MudItem>
        </MudGrid>

        <!-- ═══ الأصول ═══ -->
        <div class="bs-section">
            <div class="section-head assets-head">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
                <h2>الأصول</h2>
                <span class="section-total">@FormatMoney(_report.TotalAssets) ج</span>
            </div>
            <table class="bs-table">
                <thead>
                    <tr><th style="width:24%">البند</th><th>المعادلة</th><th class="num" style="width:17%">القيمة (ج.م)</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="item-name">
                            💵 النقدية والخزائن
                            <MudTooltip Text="المصدر: الخزائن وحركاتها (شاشة الخزنة) • التحقق: إجمالي الرصيد الحالي لكل الخزائن">
                                <MudIconButton Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="row-info" />
                            </MudTooltip>
                        </td>
                        <td class="item-desc">رصيد افتتاحي + مقبوضات − مصروفات</td>
                        <td class="num">@FormatMoney(_report.CashBalance)</td>
                    </tr>
                    <tr>
                        <td class="item-name">
                            🤝 المدينون
                            <MudTooltip Text="@(_report.ReceivableInvoicesCount + " فاتورة بيع غير ملغاة ومتبقيها > صفر • نفس آلية الداشبورد المالي")">
                                <MudIconButton Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="row-info" />
                            </MudTooltip>
                        </td>
                        <td class="item-desc">Σ (إجمالي الفاتورة − المدفوع)</td>
                        <td class="num">@FormatMoney(_report.AccountsReceivable)</td>
                    </tr>
                    <tr>
                        <td class="item-name">
                            📦 المخزون
                            <MudTooltip Text="@(_report.InventoryItemsCount + " صنف بأرصدة > صفر • الكمية × تكلفة باقة المنتج نفسه • يطابق شاشة تقييم المخزون")">
                                <MudIconButton Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="row-info" />
                            </MudTooltip>
                        </td>
                        <td class="item-desc">Σ (الكمية × تكلفة باقة المنتج)</td>
                        <td class="num strong">@FormatMoney(_report.InventoryValue)</td>
                    </tr>
                    <tr>
                        <td class="item-name">
                            🧑‍💼 سلف الموظفين
                            <MudTooltip Text="@(_report.ActiveLoansCount + " سلفة بحالة Active • المتبقي عليها • بفرع الموظف عند التفرعة")">
                                <MudIconButton Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="row-info" />
                            </MudTooltip>
                        </td>
                        <td class="item-desc">Σ المتبقي على السلف القائمة</td>
                        <td class="num">@FormatMoney(_report.EmployeeLoansOutstanding)</td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr><td colspan="2">إجمالي الأصول</td><td class="num">@FormatMoney(_report.TotalAssets)</td></tr>
                </tfoot>
            </table>
        </div>

        <!-- ═══ الالتزامات وحقوق الملكية ═══ -->
        <MudGrid Spacing="3">
            <MudItem xs="12" lg="6">
                <div class="bs-section">
                    <div class="section-head liabilities-head">
                        <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" />
                        <h2>الالتزامات</h2>
                        <span class="section-total">@FormatMoney(_report.TotalLiabilities) ج</span>
                    </div>
                    <table class="bs-table">
                        <tbody>
                            <tr>
                                <td class="item-name">
                                    🧾 رواتب مستحقة
                                    <MudTooltip Text="@(_report.PayrollPendingCount + " مسير رواتب • كل الحالات عدا «مدفوع» و«مرفوض» • صافي الراتب أو الأساسي")">
                                        <MudIconButton Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="row-info" />
                                    </MudTooltip>
                                </td>
                                <td class="item-desc">المسيرات غير المدفوعة (عدا المرفوض)</td>
                                <td class="num">@FormatMoney(_report.PayrollOutstanding)</td>
                            </tr>
                            <tr>
                                <td class="item-name">
                                    🏭 مستحقات موردين
                                    <MudTooltip Text="@(_report.PayablePurchasesCount + " فاتورة شراء غير ملغاة ومتبقيها > صفر")">
                                        <MudIconButton Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="row-info" />
                                    </MudTooltip>
                                </td>
                                <td class="item-desc">Σ (إجمالي الشراء − المدفوع)</td>
                                <td class="num">@FormatMoney(_report.SupplierPayables)</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr><td colspan="2">إجمالي الالتزامات</td><td class="num">@FormatMoney(_report.TotalLiabilities)</td></tr>
                        </tfoot>
                    </table>
                </div>
            </MudItem>
            <MudItem xs="12" lg="6">
                <div class="bs-section">
                    <div class="section-head equity-head">
                        <MudIcon Icon="@Icons.Material.Filled.Workspaces" />
                        <h2>حقوق الملكية</h2>
                        <span class="section-total">@FormatMoney(_report.TotalEquity) ج</span>
                    </div>
                    <table class="bs-table">
                        <tbody>
                            <tr>
                                <td class="item-name">
                                    🏛️ رأس المال الافتتاحي
                                    <MudTooltip Text="إدخال يدوي من Admin (زر رأس المال) • رقم واحد للشركة كاملة • لا يُشتق من المخزون ولا يُقسَّم على الفروع • كل تعديل يُسجل Audit">
                                        <MudIconButton Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="row-info" />
                                    </MudTooltip>
                                </td>
                                <td class="item-desc">
                                    إدخال يدوي — @(_report.CapitalUpdatedAt.HasValue ? $"آخر تحديث {_report.CapitalUpdatedBy}" : "لم يُدخل بعد")
                                </td>
                                <td class="num">@FormatMoney(_report.OpeningCapital)</td>
                            </tr>
                            <tr>
                                <td class="item-name">
                                    📈 الأرباح المحتجزة
                                    <MudTooltip Text="@("نفس محرك قائمة الدخل تراكمياً من " + _report.CumulativeFrom.ToString("yyyy-MM-dd") + " حتى اليوم • " + (_report.IsBranchScoped ? "منسدة للفرع بإسناد الفواتير" : "على مستوى الشركة"))">
                                        <MudIconButton Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="row-info" />
                                    </MudTooltip>
                                </td>
                                <td class="item-desc">
                                    @FormatMoney(_report.CumulativeRevenue) − @FormatMoney(_report.CumulativeCogs) − @FormatMoney(_report.CumulativeOperatingExpenses)
                                </td>
                                <td class="num @(_report.RetainedEarnings >= 0 ? "pos-text" : "neg-text")">@FormatMoney(_report.RetainedEarnings)</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr><td colspan="2">إجمالي حقوق الملكية</td><td class="num">@FormatMoney(_report.TotalEquity)</td></tr>
                        </tfoot>
                    </table>
                </div>
            </MudItem>
        </MudGrid>

        <!-- ═══ المعادلة الختامية ═══ -->
        <div class="closing-equation">
            <span class="eq-box">الأصول <b>@FormatMoney(_report.TotalAssets)</b></span>
            <span class="eq-sign">=</span>
            <span class="eq-box">الالتزامات <b>@FormatMoney(_report.TotalLiabilities)</b></span>
            <span class="eq-sign">+</span>
            <span class="eq-box">حقوق الملكية <b>@FormatMoney(_report.TotalEquity)</b></span>
        </div>

        <!-- ═══ تحليل وتوصيات ═══ -->
        @if (_insights.Count > 0)
        {
            <div class="insight-section no-print">
                <div class="section-head">
                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" />
                    <h2>تحليل وتوصيات</h2>
                </div>
                <div class="insight-grid">
                    @foreach (var ins in _insights)
                    {
                        <div class="insight-card @ins.Severity">
                            <div class="insight-icon"><MudIcon Icon="@ins.Icon" /></div>
                            <div>
                                <span class="insight-title">@ins.Title</span>
                                <span class="insight-text">@ins.Text</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        </div><!-- /bs-content -->

        <div class="print-footer">
            صدرت هذه القائمة من نظام COCOBOLO ERP بتاريخ @DateTime.Now.ToString("yyyy-MM-dd HH:mm")
            — @(_report.IsBranchScoped ? $"فرع {_report.BranchName}" : "الشركة على مستوى كل الفروع")
        </div>
    </div>
}

<!-- ═══ دايلوج رأس المال (Admin) ═══ -->
<MudDialog @bind-Visible="_capitalOpen" Options="_capitalDialogOptions">
    <TitleContent>
        <div style="display:flex;align-items:center;gap:.5rem;">
            <MudIcon Icon="@Icons.Material.Filled.Savings" Style="color:#b8860b;" />
            <MudText Typo="Typo.h6" Style="font-weight:800;">رأس المال الافتتاحي</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="MudBlazor.Severity.Info" Dense="true" Class="mb-4">
            رقم واحد للشركة كاملة — لا يُحتسب من المخزون ولا يُقسَّم على الفروع. يُدخل مرة عند البداية ويُعدَّل فقط عند زيادة رأس مال رسمية.
        </MudAlert>
        <MudNumericField T="decimal" Label="قيمة رأس المال (ج.م)" Variant="MudBlazor.Variant.Outlined"
                          Min="0m" @bind-Value="_capitalValue" Class="mb-3" />
        <MudTextField T="string" Label="ملاحظات (اختياري)" Variant="MudBlazor.Variant.Outlined"
                      Lines="2" @bind-Value="_capitalNotes" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="MudBlazor.Variant.Text" OnClick="CloseCapitalDialog">إلغاء</MudButton>
        <MudButton Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Success" Disabled="_savingCapital"
                   OnClick="SaveCapitalAsync">
            @(_savingCapital ? "جاري الحفظ..." : "حفظ رأس المال")
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    /* ============ الأساس ============ */
    .bs-page { position: relative; padding: 1.25rem 1.5rem 2.5rem; min-height: 100vh; }

    /* ============ الهيدر ============ */
    .bs-header { position: relative; border-radius: 24px; overflow: hidden; margin-bottom: 1rem; }
    .header-bg { position: absolute; inset: 0; }
    .header-gradient { position: absolute; inset: 0; background: linear-gradient(135deg, #0F1D36 0%, #1B2A4A 50%, #2D4A7A 100%); }
    .header-orbs { position: absolute; inset: 0; overflow: hidden; }
    .header-orb { position: absolute; border-radius: 50%; }
    .orb-1 { width: 380px; height: 380px; top: -160px; right: -100px; background: radial-gradient(circle, rgba(212,168,83,.3), transparent 60%); }
    .orb-2 { width: 280px; height: 280px; bottom: -100px; left: 30%; background: radial-gradient(circle, rgba(59,130,246,.2), transparent 60%); }
    .header-content { position: relative; z-index: 1; padding: 1.8rem 2rem; }
    .header-title { display: flex; align-items: center; gap: 1rem; }
    .header-icon { width: 58px; height: 58px; border-radius: 16px; background: rgba(212,175,55,.18); border: 1px solid rgba(212,175,55,.4); display: flex; align-items: center; justify-content: center; color: #d4af37; }
    .header-icon .mud-icon-root { font-size: 1.9rem !important; }
    .header-title h1 { margin: 0; color: #fff; font-size: 1.6rem; font-weight: 900; letter-spacing: -.4px; }
    .header-title p { margin: .3rem 0 0; color: rgba(255,255,255,.78); font-size: .88rem; }

    /* ============ شريط النطاق والأدوات ============ */
    .toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; background: #fff; border: 1px solid rgba(226,232,240,.9); border-radius: 16px; padding: .65rem .9rem; margin-bottom: 1rem; box-shadow: 0 8px 22px rgba(15,23,42,.05); }
    .scope-group { display: flex; align-items: center; gap: .45rem; flex-wrap: wrap; }
