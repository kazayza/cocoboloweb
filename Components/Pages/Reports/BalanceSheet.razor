            position: absolute !important;
            top: 0 !important; right: 0 !important; left: 0 !important;
            width: 100% !important; padding: 0 !important; min-height: auto !important;
        }

        /* 3) صفِّر حشوات الـLayout حتى لا ينزاح التقرير */
        .main-body, .mud-main-content, .mud-layout { margin: 0 !important; padding: 0 !important; }
