    .insight-card.good .insight-icon { background: rgba(16,185,129,.12); color: #059669; }
    .insight-card.warn .insight-icon { background: rgba(245,158,11,.13); color: #b45309; }
    .insight-card.risk .insight-icon { background: rgba(239,68,68,.11); color: #b91c1c; }
