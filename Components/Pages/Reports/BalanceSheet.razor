    /* ============ تحديث بدون تكسير الصفحة ============ */
    .bs-content { transition: opacity .25s ease; }
    .bs-content.refreshing { opacity: .5; pointer-events: none; }
    .refresh-bar { height: 3px; border-radius: 3px; margin: -0.55rem 0 .8rem; background: transparent; }
    .refresh-bar.on {
        background: linear-gradient(90deg, transparent 0%, #d4af37 50%, transparent 100%);
        background-size: 200% 100%;
        animation: bsSlide .9s linear infinite;
    }
    @@keyframes bsSlide { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

    /* ═══ الطباعة: عزل محكم — كل الصفحة مخفية إلا التقرير نفسه ═══
       (يشتغل حتى لو السايدبار والتوب-بار من بره التقرير،
        وبنفس النتيجة سواء الطباعة من الزر أو Ctrl+P) */
    @@page { size: A4; margin: 10mm; }

    @@media print {
        /* 1) أخفِ كل شيء في الصفحة (سايدبار/توب-بار/أي عنصر خارج التقرير) */
        body * { visibility: hidden !important; }

        /* 2) وأظهِر التقرير فقط، ومثِّته أعلى الورقة بعرض كامل */
        .bs-page, .bs-page * { visibility: visible !important; }
