        /* 5) ترويسة وتنسيق التقرير المطبوع */
        .print-header { text-align: center; border-bottom: 3px double #0F1D36; padding-bottom: .5rem; margin-bottom: 1rem; }
        .print-header h1 { margin: 0; font-size: 1.4rem; color: #0F1D36; font-weight: 900; }
        .print-header p { margin: .2rem 0 0; color: #475569; font-size: .85rem; }
        .bs-section { box-shadow: none !important; border: 1px solid #999 !important; border-radius: 0; padding: .7rem .9rem; margin-bottom: .8rem; page-break-inside: avoid; }
        .section-head { border-bottom: 1.5px solid #333; }
