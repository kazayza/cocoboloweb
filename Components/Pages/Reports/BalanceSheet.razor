        .ph-meta strong { font-size: .85rem; color: #0F1D36; }

        /* — صيغة الميزانية الكلاسيكية — */
        .pb-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5mm; margin-top: .8rem; }
