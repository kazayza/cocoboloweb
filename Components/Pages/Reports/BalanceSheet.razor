</style>

@code {
    private bool _isLoading = true;      // للتحميل الأول فقط
    private bool _isRefreshing;          // تحديث داخل الأثناء (بدون تكسير الصفحة)
    private bool _canView;
    private bool _isAdmin;
    private BalanceSheetDto? _report;
    private int? _branchId;
    private List<BranchOptionDto> _branches = new();
    private List<InsightVm> _insights = new();

    // دايلوج رأس المال
    private bool _capitalOpen;
    private bool _savingCapital;
    private decimal _capitalValue;
    private string? _capitalNotes;
    private readonly DialogOptions _capitalDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    private sealed record InsightVm(string Icon, string Severity, string Title, string Text);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;

        // نفس بوابة قائمة الدخل بالحرف
        _canView = user.HasClaim("Permission", "frmIncomeStatement:View")
                || user.HasClaim("Permission", "frmCashBoxDashboard:View")
                || user.IsInRole("Admin");
        _isAdmin = user.IsInRole("Admin");

        if (!_canView) { _isLoading = false; return; }

        try { _branches = await BranchService.GetBranchesForFilterAsync(); } catch { _branches = new(); }
        _report = await FinancialService.GetBalanceSheetAsync(_branchId);
        _insights = BuildInsights(_report);
        _isLoading = false;
    }

    private async Task PickScopeAsync(int? branchId)
    {
        if (_branchId == branchId || _isRefreshing) return;   // منع النقر المزدوج
        _branchId = branchId;
        _isRefreshing = true;                                  // الشاشة تبقى واقفة — تعتم فقط
        try
        {
            _report = await FinancialService.GetBalanceSheetAsync(_branchId);
            _insights = BuildInsights(_report);
        }
        finally
        {
            _isRefreshing = false;
        }
    }

    private async Task OpenCapitalDialog()
    {
        var capital = await FinancialService.GetOpeningCapitalAsync();
        _capitalValue = capital.Value;
        _capitalNotes = capital.Notes;
        _capitalOpen = true;
    }

    private void CloseCapitalDialog() => _capitalOpen = false;

    private async Task SaveCapitalAsync()
    {
        if (_capitalValue < 0)
        {
            Snackbar.Add("قيمة رأس المال غير صحيحة", MudBlazor.Severity.Warning);
            return;
        }

        _savingCapital = true;
        try
        {
            var auth = await AuthProvider.GetAuthenticationStateAsync();
            var userName = auth.User.Identity?.Name ?? "system";

            await FinancialService.SaveOpeningCapitalAsync(_capitalValue, _capitalNotes, userName);
            Snackbar.Add("تم حفظ رأس المال الافتتاحي", MudBlazor.Severity.Success);

            _capitalOpen = false;
            _isRefreshing = true;
            try
            {
                _report = await FinancialService.GetBalanceSheetAsync(_branchId);
                _insights = BuildInsights(_report);
            }
            finally
            {
                _isRefreshing = false;
            }
        }
        finally
        {
            _savingCapital = false;
        }
    }

    private async Task PrintReport() => await JS.InvokeVoidAsync("window.print");

    // ═══════════ محرك التحليل والتوصيات ═══════════
    private List<InsightVm> BuildInsights(BalanceSheetDto r)
    {
        var list = new List<InsightVm>();
        if (r == null) return list;

        decimal assets = r.TotalAssets;

        // 1) السيولة النقدية
        if (assets > 0)
        {
            var cashPct = r.CashBalance / assets * 100m;
            if (cashPct < 10m)
                list.Add(new(Icons.Material.Filled.WaterDrop, "risk", "سيولة نقدية منخفضة",
                    $"النقدية {Pct(r.CashBalance, assets)} فقط من الأصول — راقب التدفقات الداخلة قبل أي التزام دفع."));
            else if (cashPct > 60m)
                list.Add(new(Icons.Material.Filled.Savings, "info", "نقدية راكدة",
                    $"النقدية {Pct(r.CashBalance, assets)} من الأصول — فكّر في توظيفها (بضاعة سريعة الدوران أو سلف مُدرّة)."));
            else
                list.Add(new(Icons.Material.Filled.WaterDrop, "good", "سيولة صحية",
                    $"النقدية تمثل {Pct(r.CashBalance, assets)} من الأصول — نسبة طبيعية."));
        }

        // 2) تركز المخزون
        if (assets > 0)
        {
            var invPct = r.InventoryValue / assets * 100m;
            if (invPct > 70m)
                list.Add(new(Icons.Material.Filled.Inventory, "warn", "تركّز عالي في المخزون",
                    $"المخزون {Pct(r.InventoryValue, assets)} من الأصول — رأس مالك عايش في بضاعة؛ سرّع الدوران أو نوّع."));
            else
                list.Add(new(Icons.Material.Filled.Inventory, "good", "توزيع مخزون معقول",
                    $"المخزون {Pct(r.InventoryValue, assets)} من الأصول."));
        }

        // 3) المدينون
        if (r.ReceivableInvoicesCount > 0)
        {
            var avg = r.AccountsReceivable / r.ReceivableInvoicesCount;
            var recPct = assets > 0 ? r.AccountsReceivable / assets * 100m : 0m;
            list.Add(recPct > 35m
                ? new(Icons.Material.Filled.RequestQuote, "warn", "مدينون مرتفعون",
                    $"{r.ReceivableInvoicesCount} فاتورة متبقية بمتوسط {FormatMoney(avg)} — {Pct(r.AccountsReceivable, assets)} من أصولك عند العملاء؛ شغّل التحصيل.")
                : new(Icons.Material.Filled.RequestQuote, "good", "تحصيلات تحت السيطرة",
                    $"{r.ReceivableInvoicesCount} فاتورة متبقية بمتوسط {FormatMoney(avg)} — نسبة صحية من الأصول."));
        }

        // 4) تغطية الالتزامات
        if (r.TotalLiabilities > 0)
        {
            var coverage = r.CashBalance / r.TotalLiabilities;
            if (coverage < 0.5m)
                list.Add(new(Icons.Material.Filled.Warning, "risk", "تغطية نقدية ضعيفة",
                    $"النقدية تغطي {coverage:N1}x من الالتزامات ({FormatMoney(r.TotalLiabilities)}) — خطّط للمستحقات قريباً."));
            else
                list.Add(new(Icons.Material.Filled.VerifiedUser, "good", "التزامات مغطاة",
                    $"النقدية تغطي {coverage:N1}x من الالتزامات — وضع مريح."));
        }
        else
        {
            list.Add(new(Icons.Material.Filled.VerifiedUser, "good", "لا التزامات مسجلة",
                "لا رواتب مستحقة ولا مستحقات موردين حالياً."));
        }

        // 5) الملاءة (الرافعة)
        if (r.TotalEquity > 0)
        {
            var leverage = r.TotalLiabilities / r.TotalEquity * 100m;
            list.Add(leverage > 100m
                ? new(Icons.Material.Filled.TrendingDown, "warn", "رافعة مالية مرتفعة",
                    $"الالتزامات = {leverage:N0}% من حقوق الملكية — تُدار، لكن تجنّب الاقتراض الإضافي الآن.")
                : new(Icons.Material.Filled.TrendingUp, "good", "ملاءة قوية",
                    $"الالتزامات {leverage:N0}% فقط من حقوق الملكية — بنية تمويل آمنة."));
        }

        // 6) اقتراح التوازن (الشركة فقط)
        if (!r.IsBranchScoped)
        {
            if (r.IsBalanced)
            {
                list.Add(new(Icons.Material.Filled.Balance, "good", "الميزانية متوازنة",
                    "الأرقام متماسكة: الأصول = الالتزامات + حقوق الملكية. استمر في الجرد الدوري لتبقى كذلك."));
            }
            else
            {
                var suggested = r.TotalAssets - r.TotalLiabilities - r.RetainedEarnings;
                list.Add(new(Icons.Material.Filled.TipsAndUpdates, "info", "اقتراح قيمة رأس المال",
                    Math.Abs(suggested) < 0.5m
                        ? "الفرق سببه كمية بسيطة — راجع التقريب أو أدخل رأس المال بدقة أعلى."
                        : $"لتوازن مثالي أدخل رأس مال افتتاحي ≈ {FormatMoney(Math.Max(0m, suggested))} (الأصول − الالتزامات − الأرباح المحتجزة)."));
            }
        }

        return list;
    }

    private static string Pct(decimal part, decimal whole)
        => whole == 0m ? "0%" : $"{part / whole * 100m:N1}%";

    private static string FormatMoney(decimal v)
        => v.ToString("N2", CultureInfo.GetCultureInfo("ar-EG"));
}
