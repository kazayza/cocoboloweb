        .bs-table th { color: #333; }
        .bs-table td { border-bottom: 1px solid #ccc; font-size: .78rem; padding: .45rem .4rem; }
        .bs-table .item-desc, .bs-table .item-desc b { color: #333 !important; }
        .bs-table .num, .bs-table .item-name { color: #000; }
        .bs-table tfoot td { border-top: 2px solid #000; color: #000; }
        .closing-equation { border: 1px solid #999; border-radius: 0; box-shadow: none !important; padding: .7rem; }
        .eq-box { background: none; color: #000; border: 1px solid #333; }
        .eq-box b { color: #000; }
        .eq-sign { color: #000; }
        .print-footer { color: #333; }
        * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }

        /* — ترويسة فخمة — */
        .ph-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
        .ph-brand { display: flex; align-items: center; gap: .55rem; }
        .ph-logo { width: 52px; height: 52px; object-fit: contain; }
