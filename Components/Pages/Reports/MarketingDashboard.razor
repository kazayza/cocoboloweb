@code {

    /* ================================================================
       STATE
       ================================================================ */

    private MarketingDashboardDto? _data;

    private bool _isLoading = true;

    private bool _isRefreshing;

    private bool _noAccess;

    private string? _loadError;

    private int _period = 30;

    private DateTime _dateFrom =
        new(
            DateTime.Today.Year,
            DateTime.Today.Month,
            1
        );

    private DateTime _dateTo = DateTime.Today;

    private string _channel = "all";

    private int _campaignTab;

    private bool _funnelRendered;


    /* ================================================================
       CHANNELS (من جدول المصادر — فيسبوك/انستجرام/واتساب/Traffic/أخرى)
       ================================================================ */

    private static readonly
        (string Key, string Name)[] _channels =
    {
        ("all", "الكل"),
        ("fb", "فيسبوك"),
        ("ig", "انستجرام"),
        ("whatsapp", "واتساب"),
        ("traffic", "Traffic"),
        ("other", "أخرى")
    };


    /* ================================================================
       INITIALIZATION
       ================================================================ */

    protected override async Task OnInitializedAsync()
    {
        var auth =
            await AuthProvider.GetAuthenticationStateAsync();

        var user = auth.User;

        if (!(
            user.IsInRole("Admin") ||
            user.IsInRole("GeneralManager") ||
            user.IsInRole("AccountManager") ||
            user.IsInRole("SocialManager") ||
            user.IsInRole("SocialView")
        ))
        {
            _noAccess = true;

            _isLoading = false;

            return;
        }

        await LoadData();
    }


    /* ================================================================
       LOAD DATA
       ================================================================ */

    private async Task LoadData(bool silent = false)
    {
        if (_dateFrom > _dateTo)
        {
            Snackbar.Add(
                "تاريخ البداية أكبر من تاريخ النهاية",
                MudBlazor.Severity.Warning
            );

            return;
        }


        if (silent && _data is not null)
        {
            _isRefreshing = true;
        }
        else
        {
            _isLoading = true;

            _loadError = null;
        }


        StateHasChanged();


        try
        {
            _data =
                await MarketingService.GetDashboardAsync(
                    _dateFrom,
                    _dateTo,
                    _channel
                );

            // تحديث الجاجات بالبيانات الجديدة (لو اترسموا قبل كده)
            // (الفنل أصبح HTML/CSS بيتحدث تلقائياً مع الداتا)
            if (_funnelRendered)
            {
                await UpdateGauges();
            }
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;

            Snackbar.Add(
                $"خطأ في تحميل البيانات: {ex.Message}",
                MudBlazor.Severity.Error
            );
        }
        finally
        {
            _isLoading = false;

            _isRefreshing = false;

            StateHasChanged();
        }
    }


    /* ================================================================
       PERIOD
       ================================================================ */

    private async Task SetPeriod(int days)
    {
        _period = days;

        var today = DateTime.Today;

        _dateTo = today;


        _dateFrom = days switch
        {
            1 =>
                today,

            7 =>
                today.AddDays(-6),

            30 =>
                new DateTime(
                    today.Year,
                    today.Month,
                    1
                ),

            90 =>
                new DateTime(
                    today.Year,
                    today.Month,
                    1
                ).AddMonths(-2),

            365 =>
                new DateTime(
                    today.Year,
                    today.Month,
                    1
                ).AddMonths(-11),

            _ =>
                _dateFrom
        };


        await LoadData(true);
    }


    /* ================================================================
       CUSTOM DATE
       ================================================================ */

    private void ReloadCustomDate()
    {
        if (_period == 0)
        {
            _ = LoadData(true);
        }
    }


    /* ================================================================
       CHANNEL
       ================================================================ */

    private async Task SetChannel(string channel)
    {
        _channel = channel;

        await LoadData(true);
    }


    /* ================================================================
       CAMPAIGNS
       ================================================================ */

    private List<MarketingCampaignDto> CurrentCampaignRows =>
        _campaignTab == 0
            ? _data!.TopCampaigns
            : _data!.WorstCampaigns;


    /* ================================================================
       APEX CHART OPTIONS
       ================================================================ */

    private ApexChartOptions<MarketingTrendDto> _leadsOpts =>
        BuildChartOptions(
            "#1769d5",
            "function(v){return v>=1000?(v/1000).toFixed(1)+'K':v.toFixed(0)}"
        );


    private ApexChartOptions<MarketingTrendDto> _convOpts =>
        BuildChartOptions(
            "#15965e",
            "function(v){return v.toFixed(1)+'%'}"
        );


    private ApexChartOptions<MarketingTrendDto> _cplOpts =>
        BuildChartOptions(
            "#ed8b16",
            "function(v){return v>=1000?(v/1000).toFixed(1)+'K':v.toFixed(0)}"
        );


    private ApexChartOptions<MarketingTrendDto> _roasOpts =>
        BuildChartOptions(
            "#1787b7",
            "function(v){return v.toFixed(1)+'x'}"
        );


    private static ApexChartOptions<MarketingTrendDto> BuildChartOptions(
        string color,
        string formatter)
    {
        return new ApexChartOptions<MarketingTrendDto>
        {
            Chart = new Chart
            {
                FontFamily = "Cairo,sans-serif",

                Toolbar = new Toolbar
                {
                    Show = false
                },

                Background = "transparent",

                Animations = new Animations
                {
                    Enabled = true,
                    Speed = 350
                }
            },

            Colors = new List<string>
            {
                color
            },

            Fill = new Fill
            {
                Type = new List<FillType>
                {
                    FillType.Gradient
                },

                Gradient = new FillGradient
                {
                    ShadeIntensity = 1,

                    OpacityFrom = .28,

                    OpacityTo = .02,

                    Stops = new List<double>
                    {
                        0,
                        100
                    }
                }
            },

            Stroke = new Stroke
            {
                Curve = new List<Curve>
                {
                    Curve.Smooth
                },

                Width = new List<double>
                {
                    3
                }
            },

            DataLabels = new DataLabels
            {
                Enabled = false
            },

            Grid = new Grid
            {
                BorderColor = "#e9eef4",

                StrokeDashArray = 4
            },

            Xaxis = new XAxis
            {
                Labels = new XAxisLabels
                {
                    Style = new AxisLabelStyle
                    {
                        FontFamily = "Cairo,sans-serif",

                        FontSize = "9px",

                        Colors = new List<string>
                        {
                            "#8996a8"
                        }
                    },

                    HideOverlappingLabels = true
                },

                AxisBorder = new AxisBorder
                {
                    Show = false
                },

                AxisTicks = new AxisTicks
                {
                    Show = false
                }
            },

            Yaxis = new List<YAxis>
            {
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Style = new AxisLabelStyle
                        {
                            FontFamily = "Cairo,sans-serif",

                            FontSize = "9px",

                            Colors = new List<string>
                            {
                                "#8996a8"
                            }
                        },

                        Formatter = formatter
                    }
                }
            },

            Tooltip = new Tooltip
            {
                Style = new TooltipStyle
                {
                    FontSize = "11px",

                    FontFamily = "Cairo,sans-serif"
                }
            },

            Markers = new Markers
            {
                Size = new List<double>
                {
                    3
                },

                Hover = new MarkersHover
                {
                    Size = 5
                }
            }
        };
    }


    /* ================================================================
       📊 الفانل (ApexCharts الحقيقي — JS Interop)
       ================================================================ */

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // نرسم الجاجات أول ما البيانات تتحمل وتظهر الصفحة
        // (الفنل أصبح HTML/CSS — بدون JS)
        if (_data is not null && !_funnelRendered)
        {
            await RenderGauges();
            _funnelRendered = true;
        }
    }


    /* ================================================================
       🎯 Semi-Circle Gauge (ApexCharts — إنجاز التارجيت)
       ================================================================ */

    private async Task RenderGauges()
    {
        try
        {
            // Gauge الفريق
            await JS.InvokeVoidAsync(
                "cocoboloMarketing.renderSemiGauge",
                "gaugeCompany",
                _data!.CompanyTargetPercent,
                GaugeColor(_data.CompanyTargetPercent)
            );

            // Gauge كل موظف
            foreach (var emp in _data.EmployeeTargets)
            {
                await JS.InvokeVoidAsync(
                    "cocoboloMarketing.renderSemiGauge",
                    $"gaugeEmp{emp.EmployeeId}",
                    emp.Percent,
                    GaugeColor(emp.Percent)
                );
            }

            // 🏆 Gauge مؤشر الأداء التسويقي (0-10)
            await JS.InvokeVoidAsync(
                "cocoboloMarketing.renderScoreGauge",
                "scoreGauge",
                _data.PerformanceScore,
                ScoreGaugeColor(_data.PerformanceScore)
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[MarketingDashboard] فشل رسم الجاجات: {ex.Message}"
            );
        }
    }


    private async Task UpdateGauges()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "cocoboloMarketing.updateSemiGauge",
                "gaugeCompany",
                _data!.CompanyTargetPercent,
                GaugeColor(_data.CompanyTargetPercent)
            );

            foreach (var emp in _data.EmployeeTargets)
            {
                await JS.InvokeVoidAsync(
                    "cocoboloMarketing.updateSemiGauge",
                    $"gaugeEmp{emp.EmployeeId}",
                    emp.Percent,
                    GaugeColor(emp.Percent)
                );
            }

            // 🏆 تحديث Gauge مؤشر الأداء التسويقي (0-10)
            await JS.InvokeVoidAsync(
                "cocoboloMarketing.updateScoreGauge",
                "scoreGauge",
                _data.PerformanceScore,
                ScoreGaugeColor(_data.PerformanceScore)
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[MarketingDashboard] فشل تحديث الجاجات: {ex.Message}"
            );
        }
    }


    private static string GaugeColor(double percent) =>
        percent >= 100 ? "#15965e"
        : percent >= 75 ? "#35a86d"
        : percent >= 50 ? "#efa21b"
        : "#d93445";


    // نفس تصنيف الخدمة: ≥9 ممتاز | ≥8 جيد جداً | ≥7 جيد | ≥6 يحتاج تحسين | غير ذلك ضعيف
    private static string ScoreGaugeColor(double score) =>
        score >= 9 ? "#15965e"
        : score >= 8 ? "#3f9338"
        : score >= 7 ? "#84a91f"
        : score >= 6 ? "#efa21b"
        : "#d93445";


    // سهم مؤشر "دليل النتيجة" على الشريط المتدرج (0-100%)
    private string ScoreMarkerLeft()
    {
        var score = _data?.PerformanceScore ?? 0d;
        return Math.Clamp(score * 10, 0, 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) + "%";
    }


    // عرض شريط المكوّن داخل بطاقات "تفصيل الحساب"
    private static string ScoreBarWidth(double earned) =>
        (earned * 10d).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";


    private static string ScoreBarColor(double earned) =>
        earned >= 7 ? "#16a34a"
        : earned >= 4 ? "#f59e0b"
        : "#ef4444";
}
