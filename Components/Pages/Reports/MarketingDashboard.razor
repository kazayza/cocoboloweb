@page "/reports/marketing"

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using ApexCharts
@using Microsoft.AspNetCore.Authorization
@using static COCOBOLOERPNEW.Components.Pages.Reports.MarketingDashboardHelpers

@attribute [Authorize]

@inject IMarketingDashboardService MarketingService
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>لوحة أداء التسويق | Marketing Performance Dashboard</PageTitle>

@if (_isLoading)
{
    <div class="marketing-loading">
        <div class="marketing-spinner"></div>
        <div class="marketing-loading-title">جاري تحميل لوحة أداء التسويق</div>
        <div class="marketing-loading-subtitle">يرجى الانتظار...</div>
    </div>
}
else if (_noAccess)
{
    <div class="marketing-state">
        <div class="state-icon">!</div>
        <h3>ليس لديك صلاحية للدخول</h3>
        <p>يرجى التواصل مع المسؤول</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="marketing-state">
        <div class="state-icon error">!</div>
        <h3>حدث خطأ أثناء تحميل البيانات</h3>
        <p>@_loadError</p>

        <button class="primary-button" @onclick="() => LoadData()">
            إعادة المحاولة
        </button>
    </div>
}
else if (_data is not null)
{
    <div class="marketing-dashboard" dir="rtl">

        <!-- ========================================================= -->
        <!-- HEADER -->
        <!-- ========================================================= -->

        <header class="dashboard-header">

            <div class="header-brand">

                <div class="brand-logo">
                    <img src="logo.png"
                         alt="Cocobolo"
                         class="brand-logo-img" />
                </div>

                <div class="brand-divider"></div>

                <div class="brand-text">
                    <div class="brand-title">
                        Marketing Performance Dashboard
                    </div>

                    <div class="brand-subtitle">
                        لوحة أداء التسويق
                    </div>
                </div>

            </div>

            <div class="header-management">

                <div class="management-text">
                    <div>General Manager View</div>
                    <small>عرض المدير العام</small>
                </div>

                <div class="management-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="7" r="3.5"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.7" />

                        <path d="M5.5 21C5.9 16.8 8.1 14.5 12 14.5C15.9 14.5 18.1 16.8 18.5 21"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.7"
                              stroke-linecap="round" />
                    </svg>
                </div>

            </div>

        </header>


        <!-- ========================================================= -->
        <!-- FILTER BAR -->
        <!-- ========================================================= -->

        <section class="filter-panel">

            <div class="filter-section">

                <span class="filter-caption">
                    الفترة
                </span>

                <div class="filter-pills">

                    <button class="filter-pill @(_period == 1 ? "active" : "")"
                            @onclick="() => SetPeriod(1)">
                        اليوم
                    </button>

                    <button class="filter-pill @(_period == 7 ? "active" : "")"
                            @onclick="() => SetPeriod(7)">
                        أسبوع
                    </button>

                    <button class="filter-pill @(_period == 30 ? "active" : "")"
                            @onclick="() => SetPeriod(30)">
                        شهر
                    </button>

                    <button class="filter-pill @(_period == 90 ? "active" : "")"
                            @onclick="() => SetPeriod(90)">
                        3 شهور
                    </button>

                    <button class="filter-pill @(_period == 365 ? "active" : "")"
                            @onclick="() => SetPeriod(365)">
                        سنة
                    </button>

                    <button class="filter-pill @(_period == 0 ? "active" : "")"
                            @onclick="() => SetPeriod(0)">
                        مخصص
                    </button>

                </div>

            </div>


            @if (_period == 0)
            {
                <div class="date-range-box">

                    <input type="date"
                           class="date-input"
                           @bind="_dateFrom"
                           @bind:after="ReloadCustomDate" />

                    <span class="date-arrow">←</span>

                    <input type="date"
                           class="date-input"
                           @bind="_dateTo"
                           @bind:after="ReloadCustomDate" />

                </div>
            }
            else
            {
                <div class="date-range-box readonly">

                    <svg viewBox="0 0 24 24">
                        <rect x="3" y="5" width="18" height="16" rx="2"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.7" />

                        <path d="M7 3V7M17 3V7M3 10H21"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.7"
                              stroke-linecap="round" />

                    </svg>

                    <span>
                        @_data.DateFrom.ToString("dd/MM/yyyy")
                        -
                        @_data.DateTo.ToString("dd/MM/yyyy")
                    </span>

                </div>
            }


            <div class="filter-section channel-section">

                <span class="filter-caption">
                    القناة
                </span>

                <div class="filter-pills">

                    @foreach (var channel in _channels)
                    {
                        <button class="filter-pill channel-pill @(_channel == channel.Key ? "active" : "")"
                                @onclick="() => SetChannel(channel.Key)">
                            @channel.Name
                        </button>
                    }

                </div>

            </div>


            @if (_data.OverallDelta.HasValue)
            {
                <div class="period-comparison @(_data.OverallDelta >= 0 ? "positive" : "negative")">

                    <span class="comparison-arrow">
                        @(_data.OverallDelta >= 0 ? "↑" : "↓")
                    </span>

                    <strong>
                        @Math.Abs(_data.OverallDelta.Value).ToString("0.0")%
                    </strong>

                    <span>
                        مقارنة بالفترة السابقة
                    </span>

                </div>
            }

        </section>


        @if (_isRefreshing)
        {
            <div class="refresh-progress">
                <div></div>
            </div>
        }


        <!-- ========================================================= -->
        <!-- KPI CARDS -->
        <!-- ========================================================= -->

        <section class="kpi-grid">

            @foreach (var k in _data.Kpis)
            {
                var isGood =
                    !k.Delta.HasValue ||
                    (k.Delta >= 0) == k.GoodWhenUp;

                <article class="kpi-card"
                         style="--kpi-color:@k.Color">

                    <div class="kpi-icon">
                        @RenderKpiIcon(k.Key)
                    </div>

                    <div class="kpi-data">

                        <div class="kpi-label">
                            @k.Label
                        </div>

                        <div class="kpi-value">
                            @k.Value
                        </div>

                        <div class="kpi-change @(isGood ? "good" : "bad")">

                            @if (k.Delta.HasValue)
                            {
                                <span class="change-arrow">
                                    @(isGood ? "↑" : "↓")
                                </span>

                                <strong>
                                    @Math.Abs(k.Delta.Value).ToString("0.0")%
                                </strong>
                            }

                            <span class="change-caption">
                                مقارنة بالسابق
                            </span>

                        </div>

                    </div>

                </article>
            }

        </section>


        <!-- ========================================================= -->
        <!-- MAIN ANALYTICS -->
        <!-- ========================================================= -->

        <section class="analytics-grid">


            <!-- ===================================================== -->
            <!-- FUNNEL -->
            <!-- ===================================================== -->

            <article class="dashboard-card funnel-card">

                <div class="card-header">

                    <div class="card-title">

                        <span class="title-marker blue"></span>

                        <div>
                            <strong>القمع التسويقي</strong>
                            <small>Marketing Funnel</small>
                        </div>

                    </div>

                    <div class="card-header-value">
                        @_data.Funnel.Count مراحل
                    </div>

                </div>


                <div class="card-content funnel-content">

                    @if (_data.Funnel.Count == 0)
                    {
                        <div class="empty-state">
                            لا توجد بيانات للقمع التسويقي
                        </div>
                    }
                    else
                    {
                        <div class="funnel-wrapper">

                            <div class="funnel-main">

                                @* 📊 فانل ApexCharts الحقيقي (type: funnel) *@
                                <div id="mkFunnelChart"
                                     class="mk-funnel-chart"></div>

                                <div class="funnel-note">
                                    * كل مرحلة بالعدد والنسبة من إجمالي اللييدز
                                </div>

                            </div>

                        </div>
                    }

                </div>

            </article>


            <!-- ===================================================== -->
            <!-- CHANNEL + CAMPAIGNS -->
            <!-- ===================================================== -->

            <div class="analytics-middle-column">


                <!-- CHANNEL PERFORMANCE -->

                <article class="dashboard-card channel-card">

                    <div class="card-header">

                        <div class="card-title">

                            <span class="title-marker cyan"></span>

                            <div>
                                <strong>أداء القنوات</strong>
                                <small>Channel Performance</small>
                            </div>

                        </div>

                        <span class="header-chip">
                            @(_data.Channels.Count) قنوات
                        </span>

                    </div>


                    <div class="card-content table-container">

                        <table class="data-table">

                            <thead>

                                <tr>
                                    <th>المصدر</th>
                                    <th>لييدز</th>
                                    <th>عملاء</th>
                                    <th>الإنفاق</th>
                                    <th>CPL</th>
                                    <th>CAC</th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var ch in _data.Channels)
                                {
                                    <tr class="@(ch.IsTotal ? "total-row" : "")">

                                        <td>
                                            <div class="channel-name">

                                                <span class="channel-dot"
                                                      style="background:@ch.Color">
                                                </span>

                                                <strong>
                                                    @ch.Name
                                                </strong>

                                            </div>
                                        </td>

                                        <td>@ch.Leads.ToString("N0")</td>

                                        <td>@ch.Customers.ToString("N0")</td>

                                        <td>@FmtMoney(ch.Spend)</td>

                                        <td>@FmtMoney(ch.Cpl)</td>

                                        <td>@FmtMoney(ch.Cac)</td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                        <div class="table-note">
                            العملاء = فواتير مرتبطة بفرص البيع
                        </div>

                    </div>

                </article>


                <!-- CAMPAIGN PERFORMANCE -->

                <article class="dashboard-card campaign-card">

                    <div class="card-header">

                        <div class="card-title">

                            <span class="title-marker orange"></span>

                            <div>
                                <strong>أداء الحملات</strong>
                                <small>Campaign Performance</small>
                            </div>

                        </div>


                        <div class="campaign-tabs">

                            <button class="@(_campaignTab == 0 ? "active" : "")"
                                    @onclick="() => _campaignTab = 0">
                                الأفضل
                            </button>

                            <button class="@(_campaignTab == 1 ? "active" : "")"
                                    @onclick="() => _campaignTab = 1">
                                الأسوأ
                            </button>

                        </div>

                    </div>


                    <div class="card-content">

                        @if (CurrentCampaignRows.Count == 0)
                        {
                            <div class="empty-state">
                                لا توجد حملات
                            </div>
                        }
                        else
                        {
                            <div class="campaign-table-wrapper">

                                <table class="data-table campaign-table">

                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>الحملة</th>
                                            <th>لييدز</th>
                                            <th>مؤهل</th>
                                            <th>التحويل</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @{
                                            var campaignIndex = 0;
                                        }

                                        @foreach (var cp in CurrentCampaignRows)
                                        {
                                            campaignIndex++;

                                            var conversion =
                                                cp.Leads > 0
                                                    ? cp.Qualified * 100.0 / cp.Leads
                                                    : 0;

                                            <tr>

                                                <td class="campaign-rank">
                                                    @campaignIndex
                                                </td>

                                                <td>
                                                    <strong class="campaign-name">
                                                        @cp.Name
                                                    </strong>
                                                </td>

                                                <td>
                                                    @cp.Leads.ToString("N0")
                                                </td>

                                                <td>
                                                    @cp.Qualified.ToString("N0")
                                                </td>

                                                <td>

                                                    <div class="campaign-conversion">

                                                        <div class="mini-progress">
                                                            <span style="width:@conversion%;background:@(_campaignTab == 0 ? "#059669" : "#d97706")"></span>
                                                        </div>

                                                        <strong>
                                                            @conversion.ToString("0.0")%
                                                        </strong>

                                                    </div>

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }

                    </div>

                </article>

            </div>


            <!-- ===================================================== -->
            <!-- TARGET + MARKETING VS SALES -->
            <!-- ===================================================== -->

            <div class="analytics-right-column">


                <!-- TARGET VS ACTUAL -->

                <article class="dashboard-card target-card">

                    <div class="card-header">

                        <div class="card-title">

                            <span class="title-marker purple"></span>

                            <div>
                                <strong>المستهدف مقابل الفعلي</strong>
                                <small>Target vs Actual</small>
                            </div>

                        </div>

                    </div>


                    <div class="card-content">

                        <div class="target-table">

                            <div class="target-table-header">
                                <span>المؤشر</span>
                                <span>المستهدف</span>
                                <span>الفعلي</span>
                                <span>الإنجاز</span>
                                <span>الحالة</span>
                            </div>


                            @foreach (var target in _data.Targets)
                            {
                                var percent =
                                    Math.Max(
                                        0,
                                        target.Percent
                                    );

                                var progress =
                                    Math.Min(
                                        percent,
                                        100
                                    );

                                <div class="target-row">

                                    <div class="target-metric">
                                        @target.Metric
                                    </div>

                                    <div>
                                        @target.Target
                                    </div>

                                    <div>
                                        @target.Actual
                                    </div>

                                    <div class="target-progress-cell">

                                        <div class="target-percent @(target.Achieved ? "good" : "bad")">
                                            @percent.ToString("0")%
                                        </div>

                                        <div class="target-progress">
                                            <span class="@(target.Achieved ? "good" : "bad")"
                                                  style="width:@progress%">
                                            </span>
                                        </div>

                                    </div>

                                    <div>

                                        @if (target.Achieved)
                                        {
                                            <span class="status-icon success">
                                                ✓
                                            </span>
                                        }
                                        else if (percent >= 50)
                                        {
                                            <span class="status-icon warning">
                                                !
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-icon danger">
                                                !
                                            </span>
                                        }

                                    </div>

                                </div>
                            }

                        </div>


                        <div class="target-summary">

                            <div class="summary-box">

                                <span>
                                    تارجيت الفريق
                                </span>

                                <strong>
                                    @FmtMoney(_data.MonthlySalesTarget)
                                </strong>

                            </div>

                            <div class="summary-box">

                                <span>
                                    موظفو المبيعات
                                </span>

                                <strong>
                                    @_data.SalesEmployeeCount
                                </strong>

                            </div>

                            <div class="summary-box highlighted">

                                <span>
                                    تارجيت الموظف
                                </span>

                                <strong>
                                    @FmtMoney(_data.PerEmployeeMonthlyTarget)
                                </strong>

                            </div>

                        </div>

                    </div>

                </article>


                <!-- MARKETING VS SALES -->

                <article class="dashboard-card vs-card">

                    <div class="card-header">

                        <div class="card-title">

                            <span class="title-marker green"></span>

                            <div>
                                <strong>التسويق مقابل المبيعات</strong>
                                <small>Marketing vs Sales</small>
                            </div>

                        </div>

                    </div>


                    <div class="card-content">

                        <div class="sales-comparison">

                            <div class="sales-funnel">

                                <div class="sales-level level-1">
                                    <span>لييدز التسويق</span>
                                    <strong>@_data.VsSales.Leads.ToString("N0")</strong>
                                </div>

                                <div class="sales-level level-2">
                                    <span>تم التواصل</span>
                                    <strong>@_data.VsSales.Contacted.ToString("N0")</strong>
                                </div>

                                <div class="sales-level level-3">
                                    <span>مؤهلين</span>
                                    <strong>@_data.VsSales.Qualified.ToString("N0")</strong>
                                </div>

                                <div class="sales-level level-4">
                                    <span>فرص</span>
                                    <strong>@_data.VsSales.Opportunities.ToString("N0")</strong>
                                </div>

                                <div class="sales-level level-5">
                                    <span>عملاء</span>
                                    <strong>@_data.VsSales.Customers.ToString("N0")</strong>
                                </div>

                            </div>


                            <div class="vs-status @_data.VsSales.StatusClass">

                                <div class="status-balance">

                                    <svg viewBox="0 0 32 32">
                                        <path d="M16 5V26"
                                              fill="none"
                                              stroke="currentColor"
                                              stroke-width="1.8" />

                                        <path d="M8 9H24"
                                              fill="none"
                                              stroke="currentColor"
                                              stroke-width="1.8"
                                              stroke-linecap="round" />

                                        <path d="M8 9L4 17H12L8 9Z"
                                              fill="none"
                                              stroke="currentColor"
                                              stroke-width="1.8" />

                                        <path d="M24 9L20 17H28L24 9Z"
                                              fill="none"
                                              stroke="currentColor"
                                              stroke-width="1.8" />

                                        <path d="M11 27H21"
                                              fill="none"
                                              stroke="currentColor"
                                              stroke-width="1.8"
                                              stroke-linecap="round" />

                                    </svg>

                                </div>

                                <div>

                                    <small>
                                        الوضع الحالي
                                    </small>

                                    <strong>
                                        @_data.VsSales.StatusText
                                    </strong>

                                </div>

                            </div>

                        </div>

                    </div>

                </article>

            </div>

        </section>


        <!-- ========================================================= -->
        <!-- 🎯 إنجاز التارجيت (Gauge Charts) -->
        <!-- ========================================================= -->

        <section class="dashboard-card target-gauge-card">

            <div class="card-header">

                <div class="card-title">

                    <span class="title-marker green"></span>

                    <div>
                        <strong>إنجاز تارجيت المبيعات</strong>
                        <small>Target Achievement</small>
                    </div>

                </div>

                <span class="header-chip">
                    @(_data.CompanyTargetPercent.ToString("0.0"))% للفريق
                </span>

            </div>


            <div class="target-gauge-grid">

                <!-- 🎯 Gauge الشركة (Semi-Circle ApexCharts) -->
                <div class="target-gauge-box company-gauge">

                    <div id="gaugeCompany"
                         class="mk-gauge-chart"></div>

                    <div class="target-gauge-label">
                        <strong>الفريق</strong>
                        <small>
                            @FmtMoney(_data.CompanyActualRevenue)
                            من
                            @FmtMoney(_data.MonthlySalesTarget)
                        </small>
                    </div>

                </div>


                <!-- 🎯 Gauge كل موظف (Semi-Circle ApexCharts) -->
                @foreach (var emp in _data.EmployeeTargets)
                {
                    <div class="target-gauge-box">

                        <div id="gaugeEmp@(emp.EmployeeId)"
                             class="mk-gauge-chart"></div>

                        <div class="target-gauge-label">
                            <strong>@emp.EmployeeName</strong>
                            <small>
                                @FmtMoney(emp.ActualAmount)
                                من
                                @FmtMoney(emp.TargetAmount)
                            </small>
                            <span class="gauge-status @emp.StatusClass">
                                @emp.StatusText
                            </span>
                        </div>

                    </div>
                }

            </div>

        </section>


        <!-- ========================================================= -->
        <!-- PERFORMANCE TRENDS -->
        <!-- ========================================================= -->

        <section class="dashboard-card trend-card">

            <div class="card-header">

                <div class="card-title">

                    <span class="title-marker blue"></span>

                    <div>
                        <strong>اتجاه الأداء</strong>
                        <small>Performance Trend</small>
                    </div>

                </div>

                <span class="header-chip">
                    آخر البيانات
                </span>

            </div>


            <div class="trend-grid">


                <!-- LEADS -->

                <div class="trend-box">

                    <div class="trend-heading">

                        <div>
                            <strong>Leads</strong>
                            <small>لييدز</small>
                        </div>

                        <span class="trend-indicator positive">
                            ↑
                        </span>

                    </div>

                    <ApexChart TItem="MarketingTrendDto"
                               Options="_leadsOpts"
                               Height="205"
                               Width="@("100%")">

                        <ApexPointSeries TItem="MarketingTrendDto"
                                         Items="_data.LeadsTrend"
                                         Name="Leads"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(d => d.ChartLabel)"
                                         YValue="@(d => (decimal?)d.Value)" />

                    </ApexChart>

                </div>


                <!-- CONVERSION -->

                <div class="trend-box">

                    <div class="trend-heading">

                        <div>
                            <strong>Conversion Rate</strong>
                            <small>معدل التحويل</small>
                        </div>

                        <span class="trend-indicator positive">
                            ↑
                        </span>

                    </div>

                    <ApexChart TItem="MarketingTrendDto"
                               Options="_convOpts"
                               Height="205"
                               Width="@("100%")">

                        <ApexPointSeries TItem="MarketingTrendDto"
                                         Items="_data.ConversionTrend"
                                         Name="Conversion"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(d => d.ChartLabel)"
                                         YValue="@(d => (decimal?)d.Value)" />

                    </ApexChart>

                </div>


                <!-- CPL -->

                <div class="trend-box">

                    <div class="trend-heading">

                        <div>
                            <strong>CPL</strong>
                            <small>تكلفة اللييد</small>
                        </div>

                        <span class="trend-indicator positive">
                            ↓
                        </span>

                    </div>

                    <ApexChart TItem="MarketingTrendDto"
                               Options="_cplOpts"
                               Height="205"
                               Width="@("100%")">

                        <ApexPointSeries TItem="MarketingTrendDto"
                                         Items="_data.CplTrend"
                                         Name="CPL"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(d => d.ChartLabel)"
                                         YValue="@(d => (decimal?)d.Value)" />

                    </ApexChart>

                </div>


                <!-- ROAS -->

                <div class="trend-box">

                    <div class="trend-heading">

                        <div>
                            <strong>ROAS</strong>
                            <small>العائد على الإنفاق</small>
                        </div>

                        <span class="trend-indicator positive">
                            ↑
                        </span>

                    </div>

                    <ApexChart TItem="MarketingTrendDto"
                               Options="_roasOpts"
                               Height="205"
                               Width="@("100%")">

                        <ApexPointSeries TItem="MarketingTrendDto"
                                         Items="_data.RoasTrend"
                                         Name="ROAS"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(d => d.ChartLabel)"
                                         YValue="@(d => (decimal?)d.Value)" />

                    </ApexChart>

                </div>

            </div>

        </section>


        <!-- ========================================================= -->
        <!-- ALERTS + SCORE -->
        <!-- ========================================================= -->

        <section class="bottom-grid">


            <!-- ALERTS -->

            <article class="dashboard-card alerts-card">

                <div class="card-header">

                    <div class="card-title">

                        <span class="title-marker orange"></span>

                        <div>
                            <strong>تنبيهات الإدارة</strong>
                            <small>Management Alerts</small>
                        </div>

                    </div>

                    <span class="alert-count">
                        @_data.Alerts.Count
                    </span>

                </div>


                <div class="card-content alerts-content">

                    @if (_data.Alerts.Count == 0)
                    {
                        <div class="empty-state">
                            لا توجد تنبيهات حاليًا
                        </div>
                    }
                    else
                    {
                        @foreach (var alert in _data.Alerts)
                        {
                            <div class="management-alert alert-@alert.Type">

                                <span class="alert-status-dot"></span>

                                <div class="alert-text">

                                    <strong>
                                        @alert.Text
                                    </strong>

                                    <small>
                                        @alert.Detail
                                    </small>

                                </div>

                            </div>
                        }
                    }

                </div>

            </article>


            <!-- PERFORMANCE SCORE -->

            <article class="dashboard-card score-card">

                <div class="card-header">

                    <div class="card-title">

                        <span class="title-marker green"></span>

                        <div>
                            <strong>مؤشر الأداء التسويقي</strong>
                            <small>Marketing Performance Score</small>
                        </div>

                    </div>

                    <span class="header-chip">
                        Score
                    </span>

                </div>


                <div class="score-content">


                    <div class="score-gauge">

                        <div class="gauge"
                             style="@BuildGaugeStyle((decimal)_data.PerformanceScore)">

                            <div class="gauge-inner">

                                <strong>
                                    @_data.PerformanceScore.ToString("0.0")
                                </strong>

                                <span>
                                    / 10
                                </span>

                            </div>

                        </div>

                        <div class="score-label @_data.ScoreClass">
                            @_data.ScoreLabel
                        </div>

                    </div>


                    <div class="score-guide">

                        <div class="score-guide-title">
                            دليل النتيجة
                        </div>

                        <div class="score-guide-row">
                            <span class="guide-dot excellent"></span>
                            <strong>9 – 10</strong>
                            <span>ممتاز</span>
                        </div>

                        <div class="score-guide-row">
                            <span class="guide-dot very-good"></span>
                            <strong>8 – 8.9</strong>
                            <span>جيد جدًا</span>
                        </div>

                        <div class="score-guide-row">
                            <span class="guide-dot good"></span>
                            <strong>7 – 7.9</strong>
                            <span>جيد</span>
                        </div>

                        <div class="score-guide-row">
                            <span class="guide-dot needs"></span>
                            <strong>6 – 6.9</strong>
                            <span>يحتاج تحسين</span>
                        </div>

                        <div class="score-guide-row">
                            <span class="guide-dot poor"></span>
                            <strong>&lt; 6</strong>
                            <span>ضعيف</span>
                        </div>

                    </div>

                </div>

            </article>

        </section>


        <!-- ========================================================= -->
        <!-- FOOTER -->
        <!-- ========================================================= -->

        <footer class="dashboard-footer">

            <span>
                Smart Marketing = More Leads = Better Conversion = Higher Revenue
            </span>

            <b>|</b>

            <span>
                تسويق أذكى = عملاء أكثر = تحويل أفضل = مبيعات أعلى
            </span>

        </footer>

    </div>
}


<style>

    /* ================================================================
       ROOT
       ================================================================ */

    .marketing-dashboard {
        --navy: #123a78;
        --navy-dark: #092c61;
        --blue: #1264d8;
        --blue-light: #eaf3ff;

        --green: #13965c;
        --green-light: #e9f8f0;

        --orange: #ed8b16;
        --orange-light: #fff4e5;

        --red: #d93445;
        --red-light: #fff0f2;

        --purple: #7447c6;
        --purple-light: #f3effc;

        --cyan: #1787b7;
        --cyan-light: #eaf7fb;

        --page: #f5f7fb;
        --card: #ffffff;
        --border: #dce3ee;

        --text: #17233a;
        --muted: #708099;

        --radius: 13px;

        width: 100%;
        min-height: 100vh;

        padding: 14px;

        background:
            linear-gradient(
                180deg,
                #f7f9fc 0%,
                #f3f6fa 100%
            );

        color: var(--text);

        font-family:
            "Cairo",
            "Tajawal",
            "Inter",
            Arial,
            sans-serif;

        box-sizing: border-box;
    }


    .marketing-dashboard *,
    .marketing-dashboard *::before,
    .marketing-dashboard *::after {
        box-sizing: border-box;
    }


    /* ================================================================
       LOADING / STATES
       ================================================================ */

    .marketing-loading,
    .marketing-state {
        min-height: 70vh;

        display: flex;
        flex-direction: column;

        align-items: center;
        justify-content: center;

        gap: 10px;

        color: #506078;

        font-family:
            "Cairo",
            "Tajawal",
            Arial,
            sans-serif;
    }

    .marketing-loading-title {
        font-size: 17px;
        font-weight: 800;
        color: #17233a;
    }

    .marketing-loading-subtitle {
        font-size: 12px;
        color: #8995a8;
    }

    .marketing-spinner {
        width: 42px;
        height: 42px;

        border: 4px solid #e0e7f0;
        border-top-color: var(--blue);

        border-radius: 50%;

        animation: marketingSpin .8s linear infinite;
    }

    @@keyframes marketingSpin {
        to {
            transform: rotate(360deg);
        }
    }

    .marketing-state .state-icon {
        width: 58px;
        height: 58px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background: #eaf3ff;
        color: var(--blue);

        font-size: 28px;
        font-weight: 900;
    }

    .marketing-state .state-icon.error {
        background: #fff0f2;
        color: var(--red);
    }

    .marketing-state h3 {
        margin: 0;
        color: #17233a;
    }

    .marketing-state p {
        margin: 0;
        color: #8290a5;
        font-size: 13px;
    }

    .primary-button {
        border: 0;
        background: var(--blue);
        color: #fff;

        padding: 9px 20px;

        border-radius: 8px;

        cursor: pointer;

        font-family: inherit;
        font-weight: 700;

        margin-top: 8px;
    }


    /* ================================================================
       HEADER
       ================================================================ */

    .dashboard-header {
        min-height: 66px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 20px;

        padding: 8px 13px 8px 18px;

        border-radius: 13px;

        color: white;

        background:
            linear-gradient(
                100deg,
                #153f80 0%,
                #103874 52%,
                #092f69 100%
            );

        box-shadow:
            0 5px 18px rgba(25, 62, 112, .18);

        overflow: hidden;
    }


    .header-brand {
        display: flex;
        align-items: center;

        min-width: 0;

        gap: 12px;
    }


    .brand-logo {
        width: 45px;
        height: 45px;

        flex: 0 0 45px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background: rgba(255,255,255,.10);
    }

    .brand-logo svg {
        width: 36px;
        height: 36px;
    }


    .brand-logo-img {
        width: 42px;
        height: 42px;

        object-fit: contain;

        border-radius: 50%;
    }


    .brand-divider {
        width: 1px;
        height: 40px;

        background: rgba(255,255,255,.30);
    }


    .brand-title {
        font-family:
            "Inter",
            Arial,
            sans-serif;

        font-size: clamp(18px, 1.8vw, 27px);

        font-weight: 800;

        line-height: 1.1;

        white-space: nowrap;
    }


    .brand-subtitle {
        margin-top: 3px;

        font-size: 12px;

        color: rgba(255,255,255,.82);

        font-weight: 600;
    }


    .header-management {
        display: flex;
        align-items: center;

        gap: 12px;

        flex: 0 0 auto;

        padding: 5px 8px 5px 13px;

        border: 1px solid rgba(255,255,255,.15);

        border-radius: 11px;

        background: rgba(255,255,255,.055);
    }


    .management-text {
        text-align: right;

        font-family:
            "Inter",
            "Cairo",
            Arial,
            sans-serif;

        font-size: 13px;

        font-weight: 700;
    }

    .management-text small {
        display: block;

        margin-top: 1px;

        font-family: "Cairo", Arial, sans-serif;

        font-size: 10px;

        font-weight: 500;

        color: rgba(255,255,255,.68);
    }


    .management-icon {
        width: 39px;
        height: 39px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-left: 1px solid rgba(255,255,255,.16);

        padding-left: 10px;

        color: white;
    }

    .management-icon svg {
        width: 28px;
        height: 28px;
    }


    /* ================================================================
       FILTERS
       ================================================================ */

    .filter-panel {
        min-height: 49px;

        display: flex;
        align-items: center;

        gap: 14px;

        padding: 7px 10px;

        background: #fff;

        border: 1px solid var(--border);

        border-radius: 11px;

        box-shadow:
            0 2px 8px rgba(21, 48, 83, .045);

        overflow-x: auto;
    }


    .filter-section {
        display: flex;
        align-items: center;

        gap: 7px;

        flex: 0 0 auto;
    }


    .filter-caption {
        font-size: 12px;
        font-weight: 800;

        color: #26354d;

        white-space: nowrap;
    }


    .filter-pills {
        display: flex;
        align-items: center;

        gap: 4px;
    }


    .filter-pill {
        height: 29px;

        padding: 0 12px;

        border: 1px solid #d8e0eb;

        border-radius: 7px;

        background: #fff;

        color: #34445d;

        font-family: inherit;

        font-size: 11px;
        font-weight: 700;

        white-space: nowrap;

        cursor: pointer;

        transition:
            background .15s ease,
            color .15s ease,
            border-color .15s ease,
            transform .15s ease;
    }


    .filter-pill:hover {
        border-color: #b9c7da;
        transform: translateY(-1px);
    }


    .filter-pill.active {
        background: var(--orange);
        border-color: var(--orange);

        color: #fff;

        box-shadow:
            0 3px 8px rgba(237,139,22,.22);
    }


    .channel-pill.active {
        background: var(--blue);
        border-color: var(--blue);
    }


    .date-range-box {
        height: 31px;

        display: flex;
        align-items: center;

        gap: 7px;

        padding: 0 10px;

        border: 1px solid #d9e1ec;

        border-radius: 7px;

        background: #fff;

        color: #34445d;

        font-size: 11px;

        white-space: nowrap;
    }


    .date-range-box.readonly svg {
        width: 17px;
        height: 17px;

        color: var(--navy);
    }


    .date-input {
        height: 28px;

        border: 0;

        outline: none;

        color: #34445d;

        font-family: inherit;

        font-size: 11px;

        background: transparent;
    }


    .date-arrow {
        color: #9aa7b9;
        font-weight: 700;
    }


    .period-comparison {
        margin-right: auto;

        height: 31px;

        display: flex;
        align-items: center;

        gap: 5px;

        padding: 0 11px;

        border-radius: 8px;

        font-size: 11px;

        white-space: nowrap;
    }


    .period-comparison.positive {
        color: #087844;
        background: #edf9f2;
        border: 1px solid #c7ead7;
    }

    .period-comparison.negative {
        color: #b42335;
        background: #fff1f3;
        border: 1px solid #f1c8cf;
    }


    .comparison-arrow {
        font-size: 16px;
        font-weight: 900;
    }


    .refresh-progress {
        height: 3px;

        background: #dce5f1;

        overflow: hidden;

        border-radius: 3px;
    }

    .refresh-progress div {
        height: 100%;
        width: 30%;

        background: var(--blue);

        animation: refreshProgress 1.1s infinite ease-in-out;
    }

    @@keyframes refreshProgress {
        0% {
            transform: translateX(-120%);
        }

        100% {
            transform: translateX(450%);
        }
    }


    /* ================================================================
       KPI
       ================================================================ */

    .kpi-grid {
        display: grid;

        grid-template-columns:
            repeat(9, minmax(145px, 1fr));

        gap: 8px;
    }


    .kpi-card {
        min-height: 100px;

        position: relative;

        display: flex;
        align-items: center;

        gap: 10px;

        padding: 11px 10px;

        background: #fff;

        border: 1px solid #dbe3ed;

        border-radius: 11px;

        box-shadow:
            0 2px 8px rgba(20, 44, 77, .035);

        overflow: hidden;

        transition:
            transform .18s ease,
            box-shadow .18s ease;
    }


    .kpi-card::after {
        content: "";

        position: absolute;

        right: 0;
        top: 10px;
        bottom: 10px;

        width: 3px;

        border-radius: 4px 0 0 4px;

        background: var(--kpi-color);
    }


    .kpi-card:hover {
        transform: translateY(-2px);

        box-shadow:
            0 7px 18px rgba(20, 44, 77, .09);
    }


    .kpi-icon {
        width: 39px;
        height: 39px;

        flex: 0 0 39px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 10px;

        background:
            color-mix(
                in srgb,
                var(--kpi-color) 9%,
                white
            );

        color: var(--kpi-color);
    }


    .kpi-icon svg {
        width: 24px;
        height: 24px;
    }


    .kpi-data {
        min-width: 0;
        flex: 1;
    }


    .kpi-label {
        min-height: 26px;

        display: flex;
        align-items: center;

        color: #718096;

        font-size: 9.5px;

        font-weight: 700;

        line-height: 1.25;
    }


    .kpi-value {
        color: #14213a;

        font-family:
            "Inter",
            "Cairo",
            Arial,
            sans-serif;

        font-size: clamp(18px, 1.55vw, 25px);

        font-weight: 900;

        line-height: 1.1;

        white-space: nowrap;

        margin: 2px 0;
    }


    .kpi-change {
        display: flex;
        align-items: center;

        gap: 3px;

        font-size: 9px;

        white-space: nowrap;
    }


    .kpi-change.good {
        color: #12955b;
    }

    .kpi-change.bad {
        color: #d93445;
    }


    .change-arrow {
        font-size: 12px;
        font-weight: 900;
    }


    .change-caption {
        color: #9aa5b5;
        font-weight: 500;
    }


    /* ================================================================
       CARD SYSTEM
       ================================================================ */

    .dashboard-card {
        min-width: 0;

        background: #fff;

        border: 1px solid var(--border);

        border-radius: var(--radius);

        box-shadow:
            0 2px 9px rgba(24, 48, 80, .045);

        overflow: hidden;
    }


    .card-header {
        min-height: 53px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 10px;

        padding: 9px 14px;

        background:
            linear-gradient(
                180deg,
                #ffffff 0%,
                #fafbfd 100%
            );

        border-bottom: 1px solid #e7ecf3;
    }


    .card-title {
        display: flex;
        align-items: center;

        gap: 8px;

        min-width: 0;
    }


    .card-title > div {
        min-width: 0;
    }


    .card-title strong {
        display: block;

        color: #1c2b43;

        font-size: 14px;

        font-weight: 800;

        line-height: 1.2;
    }


    .card-title small {
        display: block;

        margin-top: 2px;

        color: #9aa6b8;

        font-family: "Inter", Arial, sans-serif;

        font-size: 8px;

        font-weight: 500;
    }


    .title-marker {
        width: 7px;
        height: 29px;

        border-radius: 5px;

        flex: 0 0 7px;
    }


    .title-marker.blue {
        background: var(--blue);
    }

    .title-marker.cyan {
        background: var(--cyan);
    }

    .title-marker.orange {
        background: var(--orange);
    }

    .title-marker.purple {
        background: var(--purple);
    }

    .title-marker.green {
        background: var(--green);
    }


    .header-chip {
        padding: 4px 8px;

        border-radius: 7px;

        background: #f1f4f8;

        color: #748198;

        font-family: "Inter", "Cairo", Arial, sans-serif;

        font-size: 9px;

        font-weight: 700;

        white-space: nowrap;
    }


    .card-header-value {
        color: #8793a7;

        font-size: 10px;

        white-space: nowrap;
    }


    .card-content {
        padding: 12px 13px;
    }


    /* ================================================================
       MAIN GRID
       ================================================================ */

    .analytics-grid {
        display: grid;

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 12px;

        align-items: stretch;
    }


    .analytics-middle-column,
    .analytics-right-column {
        display: grid;

        grid-column: span 1;

        grid-template-rows:
            minmax(0, auto)
            minmax(0, auto);

        gap: 12px;

        min-width: 0;
    }


    /* ================================================================
       FUNNEL
       ================================================================ */

    .funnel-card {
        min-height: 100%;

        /* 🟢 الفانل بعرض الشاشة كلها (صف كامل) */
        grid-column: 1 / -1;
    }


    .funnel-content {
        padding: 10px 9px 12px;
    }


    .funnel-wrapper {
        width: 100%;

        display: flex;
        justify-content: center;
        padding: 0 8px;
    }


    .mk-funnel-chart {
        width: 100%;
        min-height: 520px;
    }


    .funnel-note {
        margin-top: 4px;

        color: #99a5b5;

        font-size: 9px;

        text-align: center;
    }


    .funnel-main {
        width: 100%;

        display: flex;
        flex-direction: column;

        align-items: center;
    }


    .funnel-stage-row {
        width: 100%;

        display: flex;
        flex-direction: column;

        align-items: center;
    }


    .funnel-stage {
        position: relative;

        min-width: 170px;

        height: 43px;

        display: grid;

        grid-template-columns: 1fr auto 1fr;

        align-items: center;

        padding: 0 14px;

        color: #fff;

        background:
            linear-gradient(
                135deg,
                color-mix(in srgb, var(--funnel-color) 88%, white),
                var(--funnel-color)
            );

        clip-path:
            polygon(
                4% 0,
                96% 0,
                91% 100%,
                9% 100%
            );

        box-shadow:
            0 4px 8px rgba(20, 45, 75, .08);

        transition:
            width .25s ease,
            transform .18s ease;
    }


    .funnel-stage:hover {
        transform: scaleX(1.015);
    }


    .funnel-stage-name {
        text-align: center;

        font-size: 11px;

        font-weight: 800;

        white-space: nowrap;

        overflow: hidden;

        text-overflow: ellipsis;
    }


    .funnel-stage-value {
        font-family:
            "Inter",
            "Cairo",
            Arial,
            sans-serif;

        font-size: 16px;

        font-weight: 900;

        white-space: nowrap;

        padding: 0 8px;
    }


    .funnel-stage-percent {
        text-align: center;

        font-family: "Inter", Arial, sans-serif;

        font-size: 9px;

        font-weight: 700;

        opacity: .9;

        white-space: nowrap;
    }


    .funnel-drop {
        height: 26px;

        display: flex;
        align-items: center;

        gap: 5px;

        color: #d65b69;

        font-family:
            "Inter",
            "Cairo",
            Arial,
            sans-serif;

        font-size: 9px;

        font-weight: 700;
    }


    .funnel-drop span {
        font-size: 13px;
        font-weight: 900;
    }


    /* ================================================================
       TABLES
       ================================================================ */

    .table-container {
        overflow-x: auto;
    }


    .data-table {
        width: 100%;

        border-collapse: collapse;

        table-layout: auto;

        font-size: 14px;
    }


    .data-table thead th {
        padding: 10px 8px;

        background: #f0f3f7;

        color: #334259;

        border: 1px solid #dfe5ed;

        font-weight: 800;

        font-size: 13px;

        white-space: nowrap;

        text-align: center;
    }


    .data-table thead th:first-child {
        text-align: right;
    }


    .data-table tbody td {
        padding: 10px 8px;

        border-bottom: 1px solid #edf1f5;

        color: #526177;

        text-align: center;

        white-space: nowrap;
    }


    .data-table tbody td:first-child {
        text-align: right;
    }


    .data-table tbody tr:hover td {
        background: #fafcff;
    }


    .data-table .total-row td {
        background: #edf3fb;

        color: #17233a;

        font-weight: 900;

        border-top: 1px solid #cfd9e7;
    }


    .channel-name {
        display: flex;
        align-items: center;

        gap: 6px;
    }


    .channel-dot {
        width: 7px;
        height: 7px;

        flex: 0 0 7px;

        border-radius: 50%;
    }


    .table-note {
        margin-top: 7px;

        padding-top: 7px;

        border-top: 1px dashed #e1e6ee;

        color: #99a5b5;

        font-size: 9px;
    }


    /* ================================================================
       CAMPAIGNS
       ================================================================ */

    .campaign-tabs {
        display: flex;

        gap: 3px;

        padding: 2px;

        border-radius: 7px;

        background: #eef2f7;
    }


    .campaign-tabs button {
        border: 0;

        padding: 4px 10px;

        border-radius: 5px;

        background: transparent;

        color: #8995a7;

        font-family: inherit;

        font-size: 9px;

        font-weight: 700;

        cursor: pointer;
    }


    .campaign-tabs button.active {
        background: #fff;

        color: #1c2b43;

        box-shadow:
            0 1px 3px rgba(20,40,70,.10);
    }


