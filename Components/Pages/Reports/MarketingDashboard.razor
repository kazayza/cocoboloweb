    /* ================================================================
       📊 الفانل (ApexCharts الحقيقي — JS Interop)
       ================================================================ */

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // نرسم الفانل والجاجات أول ما البيانات تتحمل وتظهر الصفحة
        if (_data is not null && !_funnelRendered)
        {
            await RenderFunnel();
            await RenderGauges();
            _funnelRendered = true;
        }
    }


    private async Task RenderFunnel()
    {
        try
        {
            var labels =
                _data!.Funnel
                    .Select(f => f.Name)
                    .ToList();

            var values =
                _data.Funnel
                    .Select(f => (double)f.Count)
                    .ToList();

            var colors =
                FunnelColors
                    .Take(Math.Max(labels.Count, 1))
                    .ToList();

            var drops =
                BuildFunnelDrops(_data.Funnel);

            await JS.InvokeVoidAsync(
                "cocoboloMarketing.renderFunnel",
                "mkFunnelChart",
                labels,
                values,
                colors,
                drops
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[MarketingDashboard] فشل رسم الفانل: {ex.Message}"
            );
        }
    }


    /* ================================================================
       📐 حساب معدل التسريب بين مراحل الفانل
       (المرفوض مرحلة فرعية — من غير تسريب تسلسلي)
       ================================================================ */

    private static List<double> BuildFunnelDrops(
        List<MarketingFunnelStageDto> funnel)
    {
        var drops = new List<double>();

        for (int i = 0; i < funnel.Count; i++)
        {
            // أول مرحلتين (إجمالي + مرفوض) — مفيش تسريب تسلسلي
            if (i <= 1)
            {
                drops.Add(0);
                continue;
            }

            // المحول بيتقارن بالإجمالي (110)
            // وباقي المراحل بتتقارن بالمرحلة اللي قبلها الرئيسية
            var prevCount = i == 2
                ? funnel[0].Count
                : funnel[i - 1].Count;

            var drop = prevCount > 0
                ? Math.Abs(funnel[i].Count - prevCount) * 100.0 / prevCount
                : 0;

            drops.Add(Math.Round(drop, 1));
        }

        return drops;
    }


    private async Task UpdateFunnel()
    {
        try
        {
            var labels =
                _data!.Funnel
                    .Select(f => f.Name)
                    .ToList();

            var values =
                _data.Funnel
                    .Select(f => (double)f.Count)
                    .ToList();

            var drops =
                BuildFunnelDrops(_data.Funnel);

            await JS.InvokeVoidAsync(
                "cocoboloMarketing.updateFunnel",
                "mkFunnelChart",
                labels,
                values,
                drops
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[MarketingDashboard] فشل تحديث الفانل: {ex.Message}"
            );
        }
    }


    /* ================================================================
       🎯 Semi-Circle Gauge (ApexCharts — إنجاز التارجيت)
       ================================================================ */

    private async Task RenderGauges()
    {
        try
        {
            // Gauge الفريق
            await JS.InvokeVoidAsync(
                "cocoboloMarketing.renderSemiGauge",
                "gaugeCompany",
                _data!.CompanyTargetPercent,
                GaugeColor(_data.CompanyTargetPercent)
            );

            // Gauge كل موظف
            foreach (var emp in _data.EmployeeTargets)
            {
                await JS.InvokeVoidAsync(
                    "cocoboloMarketing.renderSemiGauge",
                    $"gaugeEmp{emp.EmployeeId}",
                    emp.Percent,
                    GaugeColor(emp.Percent)
                );
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[MarketingDashboard] فشل رسم الجاجات: {ex.Message}"
            );
        }
    }


    private async Task UpdateGauges()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "cocoboloMarketing.updateSemiGauge",
                "gaugeCompany",
                _data!.CompanyTargetPercent,
                GaugeColor(_data.CompanyTargetPercent)
            );

            foreach (var emp in _data.EmployeeTargets)
            {
                await JS.InvokeVoidAsync(
                    "cocoboloMarketing.updateSemiGauge",
                    $"gaugeEmp{emp.EmployeeId}",
                    emp.Percent,
                    GaugeColor(emp.Percent)
                );
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[MarketingDashboard] فشل تحديث الجاجات: {ex.Message}"
            );
        }
    }


    private static string GaugeColor(double percent) =>
        percent >= 100 ? "#15965e"
        : percent >= 75 ? "#35a86d"
        : percent >= 50 ? "#efa21b"
        : "#d93445";
