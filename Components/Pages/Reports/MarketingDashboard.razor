@page "/reports/marketing"

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using ApexCharts
@using Microsoft.AspNetCore.Authorization
@using static COCOBOLOERPNEW.Components.Pages.Reports.MarketingDashboardHelpers

@attribute [Authorize]

@inject IMarketingDashboardService MarketingService
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>لوحة أداء التسويق | Marketing Performance Dashboard</PageTitle>

@if (_isLoading)
{
    <div class="marketing-loading">
        <div class="marketing-spinner"></div>
        <div class="marketing-loading-title">جاري تحميل لوحة أداء التسويق</div>
        <div class="marketing-loading-subtitle">يرجى الانتظار...</div>
    </div>
}
else if (_noAccess)
{
    <div class="marketing-state">
        <div class="state-icon">!</div>
        <h3>ليس لديك صلاحية للدخول</h3>
        <p>يرجى التواصل مع المسؤول</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="marketing-state">
        <div class="state-icon error">!</div>
        <h3>حدث خطأ أثناء تحميل البيانات</h3>
        <p>@_loadError</p>

        <button class="primary-button" @onclick="() => LoadData()">
            إعادة المحاولة
        </button>
    </div>
}
else if (_data is not null)
{
    <div class="marketing-dashboard" dir="rtl">

        <!-- ========================================================= -->
        <!-- HEADER -->
        <!-- ========================================================= -->

        <header class="dashboard-header">

            <div class="header-brand">

                <div class="brand-logo">
                    <img src="logo.png"
                         alt="Cocobolo"
                         class="brand-logo-img" />
                </div>

                <div class="brand-divider"></div>

                <div class="brand-text">
                    <div class="brand-title">
                        Marketing Performance Dashboard
                    </div>

                    <div class="brand-subtitle">
                        لوحة أداء التسويق
                    </div>
                </div>

            </div>

            <div class="header-management">

                <div class="management-text">
                    <div>General Manager View</div>
                    <small>عرض المدير العام</small>
                </div>

                <div class="management-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="7" r="3.5"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.7" />

                        <path d="M5.5 21C5.9 16.8 8.1 14.5 12 14.5C15.9 14.5 18.1 16.8 18.5 21"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.7"
                              stroke-linecap="round" />
                    </svg>
                </div>

            </div>

        </header>


        <!-- ========================================================= -->
        <!-- FILTER BAR -->
        <!-- ========================================================= -->

        <section class="filter-panel">

            <div class="filter-section">

                <span class="filter-caption">
                    الفترة
                </span>

                <div class="filter-pills">

                    <button class="filter-pill @(_period == 1 ? "active" : "")"
                            @onclick="() => SetPeriod(1)">
                        اليوم
                    </button>

                    <button class="filter-pill @(_period == 7 ? "active" : "")"
                            @onclick="() => SetPeriod(7)">
                        أسبوع
                    </button>

                    <button class="filter-pill @(_period == 30 ? "active" : "")"
                            @onclick="() => SetPeriod(30)">
                        شهر
                    </button>

                    <button class="filter-pill @(_period == 90 ? "active" : "")"
                            @onclick="() => SetPeriod(90)">
                        3 شهور
                    </button>

                    <button class="filter-pill @(_period == 365 ? "active" : "")"
                            @onclick="() => SetPeriod(365)">
                        سنة
                    </button>

                    <button class="filter-pill @(_period == 0 ? "active" : "")"
                            @onclick="() => SetPeriod(0)">
                        مخصص
                    </button>

                </div>

            </div>


            @if (_period == 0)
            {
                <div class="date-range-box">

                    <input type="date"
                           class="date-input"
                           @bind="_dateFrom"
                           @bind:after="ReloadCustomDate" />

                    <span class="date-arrow">←</span>

                    <input type="date"
                           class="date-input"
                           @bind="_dateTo"
                           @bind:after="ReloadCustomDate" />

                </div>
            }
            else
            {
                <div class="date-range-box readonly">

                    <svg viewBox="0 0 24 24">
                        <rect x="3" y="5" width="18" height="16" rx="2"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.7" />

                        <path d="M7 3V7M17 3V7M3 10H21"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.7"
                              stroke-linecap="round" />

                    </svg>

                    <span>
                        @_data.DateFrom.ToString("dd/MM/yyyy")
                        -
                        @_data.DateTo.ToString("dd/MM/yyyy")
                    </span>

                </div>
            }


            <div class="filter-section channel-section">

                <span class="filter-caption">
                    القناة
                </span>

                <div class="filter-pills">

                    @foreach (var channel in _channels)
                    {
                        <button class="filter-pill channel-pill @(_channel == channel.Key ? "active" : "")"
                                @onclick="() => SetChannel(channel.Key)">
                            @channel.Name
                        </button>
                    }

                </div>

            </div>


            @if (_data.OverallDelta.HasValue)
            {
                <div class="period-comparison @(_data.OverallDelta >= 0 ? "positive" : "negative")">

                    <span class="comparison-arrow">
                        @(_data.OverallDelta >= 0 ? "↑" : "↓")
                    </span>

                    <strong>
                        @Math.Abs(_data.OverallDelta.Value).ToString("0.0")%
                    </strong>

                    <span>
                        مقارنة بالفترة السابقة
                    </span>

                </div>
            }

        </section>


        @if (_isRefreshing)
        {
            <div class="refresh-progress">
                <div></div>
            </div>
        }


        <!-- ========================================================= -->
        <!-- KPI CARDS -->
        <!-- ========================================================= -->

        <section class="kpi-grid">

            @foreach (var k in _data.Kpis)
            {
                var isGood =
                    !k.Delta.HasValue ||
                    (k.Delta >= 0) == k.GoodWhenUp;

                <article class="kpi-card"
                         style="--kpi-color:@k.Color">

                    <div class="kpi-icon">
                        @RenderKpiIcon(k.Key)
                    </div>

                    <div class="kpi-data">

                        <div class="kpi-label">
                            @k.Label
                        </div>

                        <div class="kpi-value">
                            @k.Value
                        </div>

                        <div class="kpi-foot">

                            @if (k.Delta.HasValue)
                            {
                                <span class="kpi-change @(isGood ? "good" : "bad")">
                                    <span class="change-arrow">@(isGood ? "↑" : "↓")</span>
                                    @Math.Abs(k.Delta.Value).ToString("0.0")%
                                </span>
                            }

                            @if (!string.IsNullOrWhiteSpace(k.Sub))
                            {
                                <span class="kpi-sub @k.SubClass">@k.Sub</span>
                            }

                        </div>

                    </div>

                </article>
            }

        </section>


        <!-- ========================================================= -->
        <!-- MAIN ANALYTICS -->
        <!-- ========================================================= -->

        <section class="analytics-grid">


            <!-- ===================================================== -->
            <!-- FUNNEL -->
            <!-- ===================================================== -->

            <article class="dashboard-card funnel-card">

                <div class="card-header">

                    <div class="card-title">

                        <span class="title-marker blue"></span>

                        <div>
                            <strong>القمع التسويقي</strong>
                            <small>Marketing Funnel</small>
                        </div>

                    </div>

                    <div class="card-header-value">
                        @_data.Funnel.Count مراحل
                    </div>

                </div>


                <div class="card-content funnel-content">

                    @if (_data.Funnel.Count == 0)
                    {
                        <div class="empty-state">
                            لا توجد بيانات للقمع التسويقي
                        </div>
                    }
                    else
                    {
                        <div class="nf-wrap">
                            @foreach (var s in _data.Funnel)
                            {
                                var width = Math.Clamp(32 + s.PercentOfFirst * 0.68, 30, 100);
                                <div class="nf-row">
                                    <div class="nf-zone">
                                        <div class="nf-bar @(s.IsSideStage ? "side" : "")"
                                             style="width:@(width.ToString("0.#"))%; background:@s.Color;">
                                            <span class="nf-count">@s.Count.ToString("N0")</span>
                                            <span class="nf-name">@s.Name (@s.PercentOfFirst.ToString("0.##")%)</span>
                                        </div>
                                    </div>
                                    <div class="nf-drop">
                                        @if (s.Step == 1)
                                        {
                                            <span class="nf-chip neutral">Start</span>
                                        }
                                        else if (s.IsSideStage)
                                        {
                                            <span class="nf-chip side-chip">جانبية</span>
                                        }
                                        else if (s.DropOff.HasValue)
                                        {
                                            <span class="nf-chip">↓ @(s.DropOff.Value.ToString("0.0"))%</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="funnel-note">* النسبة بين الأقواس = من إجمالي اللييدز • شارات التسرب = الفقد من المرحلة السابقة</div>
                    }

                </div>

            </article>


            <!-- ===================================================== -->
            <!-- CHANNEL + CAMPAIGNS -->
            <!-- ===================================================== -->

            <div class="analytics-middle-column">


                <!-- CHANNEL PERFORMANCE -->

                <article class="dashboard-card channel-card">

                    <div class="card-header">

                        <div class="card-title">

                            <span class="title-marker cyan"></span>

                            <div>
                                <strong>أداء القنوات</strong>
                                <small>Channel Performance</small>
                            </div>

                        </div>

                        <span class="header-chip">
                            @(_data.Channels.Count) قنوات
                        </span>

                    </div>


                    <div class="card-content table-container">

                        <table class="data-table">

                            <thead>

                                <tr>
                                    <th>المصدر</th>
                                    <th>لييدز</th>
                                    <th>عملاء</th>
                                    <th>الإنفاق</th>
                                    <th>CPL</th>
                                    <th>CAC</th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var ch in _data.Channels)
                                {
                                    <tr class="@(ch.IsTotal ? "total-row" : "")">

                                        <td>
                                            <div class="channel-name">

                                                <span class="channel-dot"
                                                      style="background:@ch.Color">
                                                </span>

                                                <strong>
                                                    @ch.Name
                                                </strong>

                                            </div>
                                        </td>

                                        <td>@ch.Leads.ToString("N0")</td>

                                        <td>@ch.Customers.ToString("N0")</td>

                                        <td>@FmtMoney(ch.Spend)</td>

                                        <td>@FmtMoney(ch.Cpl)</td>

                                        <td>@FmtMoney(ch.Cac)</td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                        <div class="table-note">
                            العملاء = فواتير مرتبطة بفرص البيع
                        </div>

                    </div>

                </article>


                <!-- CAMPAIGN PERFORMANCE -->

                <article class="dashboard-card campaign-card">

                    <div class="card-header">

                        <div class="card-title">

                            <span class="title-marker orange"></span>

                            <div>
                                <strong>أداء الحملات</strong>
                                <small>Campaign Performance</small>
                            </div>

                        </div>


                        <div class="campaign-tabs">

                            <button class="@(_campaignTab == 0 ? "active" : "")"
                                    @onclick="() => _campaignTab = 0">
                                الأفضل
                            </button>

                            <button class="@(_campaignTab == 1 ? "active" : "")"
                                    @onclick="() => _campaignTab = 1">
                                الأسوأ
                            </button>

                        </div>

                    </div>


                    <div class="card-content">

                        @if (CurrentCampaignRows.Count == 0)
                        {
                            <div class="empty-state">
                                لا توجد حملات
                            </div>
                        }
                        else
                        {
                            <div class="campaign-table-wrapper">

                                <table class="data-table campaign-table">

                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>الحملة</th>
                                            <th>لييدز</th>
                                            <th>مؤهل</th>
                                            <th>التحويل</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @{
                                            var campaignIndex = 0;
                                        }

                                        @foreach (var cp in CurrentCampaignRows)
                                        {
                                            campaignIndex++;

                                            var conversion =
                                                cp.Leads > 0
                                                    ? cp.Qualified * 100.0 / cp.Leads
                                                    : 0;

                                            <tr>

                                                <td class="campaign-rank">
                                                    @campaignIndex
                                                </td>

                                                <td>
                                                    <strong class="campaign-name">
                                                        @cp.Name
                                                    </strong>
                                                </td>

                                                <td>
                                                    @cp.Leads.ToString("N0")
                                                </td>

                                                <td>
                                                    @cp.Qualified.ToString("N0")
                                                </td>

                                                <td>

                                                    <div class="campaign-conversion">

                                                        <div class="mini-progress">
                                                            <span style="width:@conversion%;background:@(_campaignTab == 0 ? "#059669" : "#d97706")"></span>
                                                        </div>

                                                        <strong>
                                                            @conversion.ToString("0.0")%
                                                        </strong>

                                                    </div>

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }

                    </div>

                </article>

            </div>


            <!-- ===================================================== -->
            <!-- TARGET + MARKETING VS SALES -->
            <!-- ===================================================== -->

            <div class="analytics-right-column">


                <!-- TARGET VS ACTUAL -->

                <article class="dashboard-card target-card">

                    <div class="card-header">

                        <div class="card-title">

                            <span class="title-marker purple"></span>

                            <div>
                                <strong>المستهدف مقابل الفعلي</strong>
                                <small>Target vs Actual</small>
                            </div>

                        </div>

                    </div>


                    <div class="card-content">

                        <div class="target-table">

                            <div class="target-table-header">
                                <span>المؤشر</span>
                                <span>المستهدف</span>
                                <span>الفعلي</span>
                                <span>الإنجاز</span>
                                <span>الحالة</span>
                            </div>


                            @foreach (var target in _data.Targets)
                            {
                                var percent =
                                    Math.Max(
                                        0,
                                        target.Percent
                                    );

                                var progress =
                                    Math.Min(
                                        percent,
                                        100
                                    );

                                <div class="target-row">

                                    <div class="target-metric">
                                        @target.Metric
                                    </div>

                                    <div>
                                        @target.Target
                                    </div>

                                    <div>
                                        @target.Actual
                                    </div>

                                    <div class="target-progress-cell">

                                        <div class="target-percent @(target.Achieved ? "good" : "bad")">
                                            @percent.ToString("0")%
                                        </div>

                                        <div class="target-progress">
                                            <span class="@(target.Achieved ? "good" : "bad")"
                                                  style="width:@progress%">
                                            </span>
                                        </div>

                                    </div>

                                    <div>

                                        @if (target.Achieved)
                                        {
                                            <span class="status-icon success">
                                                ✓
                                            </span>
                                        }
                                        else if (percent >= 50)
                                        {
                                            <span class="status-icon warning">
                                                !
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-icon danger">
                                                !
                                            </span>
                                        }

                                    </div>

                                </div>
                            }

                        </div>


                        <div class="target-summary">

                            <div class="summary-box">

                                <span>
                                    تارجيت الفريق
                                </span>

                                <strong>
                                    @FmtMoney(_data.MonthlySalesTarget)
                                </strong>

                            </div>

                            <div class="summary-box">

                                <span>
                                    موظفو المبيعات
                                </span>

                                <strong>
                                    @_data.SalesEmployeeCount
                                </strong>

                            </div>

                            <div class="summary-box highlighted">

                                <span>
                                    تارجيت الموظف
                                </span>

                                <strong>
                                    @FmtMoney(_data.PerEmployeeMonthlyTarget)
                                </strong>

                            </div>

                        </div>

                    </div>

                </article>


                <!-- MARKETING VS SALES -->

                <article class="dashboard-card vs-card">

                    <div class="card-header">

                        <div class="card-title">

                            <span class="title-marker green"></span>

                            <div>
                                <strong>التسويق مقابل المبيعات</strong>
                                <small>Marketing vs Sales</small>
                            </div>

                        </div>

                    </div>


                    <div class="card-content">

                        <div class="sales-comparison">

                            @{
                                var vs = _data.VsSales;
                                var vsMax = Math.Max(vs.Leads, 1);
                                double VsWidth(int v) => Math.Clamp(30 + 70.0 * v / vsMax, 30, 100);
                            }

                            <div class="sales-funnel">

                                <div class="sales-level level-1" style="width:@(VsWidth(vs.Leads).ToString("0.#"))%">
                                    <span>لييدز التسويق</span>
                                    <strong>@vs.Leads.ToString("N0")</strong>
                                </div>

                                <div class="vs-drop-row"><span class="vs-drop-chip">↓ @(vs.ContactedDrop.ToString("0.0"))%</span></div>

                                <div class="sales-level level-2" style="width:@(VsWidth(vs.Contacted).ToString("0.#"))%">
                                    <span>تم التواصل</span>
                                    <strong>@vs.Contacted.ToString("N0")</strong>
                                </div>

                                <div class="vs-drop-row"><span class="vs-drop-chip">↓ @(vs.QualifiedDrop.ToString("0.0"))%</span></div>

                                <div class="sales-level level-3" style="width:@(VsWidth(vs.Qualified).ToString("0.#"))%">
                                    <span>مؤهلين</span>
                                    <strong>@vs.Qualified.ToString("N0")</strong>
                                </div>

                                <div class="vs-drop-row"><span class="vs-drop-chip">↓ @(vs.OpportunitiesDrop.ToString("0.0"))%</span></div>

                                <div class="sales-level level-4" style="width:@(VsWidth(vs.Opportunities).ToString("0.#"))%">
                                    <span>فرص</span>
                                    <strong>@vs.Opportunities.ToString("N0")</strong>
                                </div>

                                <div class="vs-drop-row"><span class="vs-drop-chip">↓ @(vs.CustomersDrop.ToString("0.0"))%</span></div>

                                <div class="sales-level level-5" style="width:@(VsWidth(vs.Customers).ToString("0.#"))%">
                                    <span>عملاء</span>
                                    <strong>@vs.Customers.ToString("N0")</strong>
                                </div>

                            </div>


                            <div class="vs-status @_data.VsSales.StatusClass">

                                <div class="status-balance">

                                    <svg viewBox="0 0 32 32">
                                        <path d="M16 5V26"
                                              fill="none"
                                              stroke="currentColor"
                                              stroke-width="1.8" />

                                        <path d="M8 9H24"
                                              fill="none"
                                              stroke="currentColor"
                                              stroke-width="1.8"
                                              stroke-linecap="round" />

                                        <path d="M8 9L4 17H12L8 9Z"
                                              fill="none"
                                              stroke="currentColor"
                                              stroke-width="1.8" />

                                        <path d="M24 9L20 17H28L24 9Z"
                                              fill="none"
                                              stroke="currentColor"
                                              stroke-width="1.8" />

                                        <path d="M11 27H21"
                                              fill="none"
                                              stroke="currentColor"
                                              stroke-width="1.8"
                                              stroke-linecap="round" />

                                    </svg>

                                </div>

                                <div>

                                    <small>
                                        الوضع الحالي
                                    </small>

                                    <strong>
                                        @_data.VsSales.StatusText
                                    </strong>

                                </div>

                            </div>

                        </div>

                    </div>

                </article>

            </div>

        </section>


        <!-- ========================================================= -->
        <!-- 🎯 إنجاز التارجيت (Gauge Charts) -->
        <!-- ========================================================= -->

        <section class="dashboard-card target-gauge-card">

            <div class="card-header">

                <div class="card-title">

                    <span class="title-marker green"></span>

                    <div>
                        <strong>إنجاز تارجيت المبيعات</strong>
                        <small>Target Achievement</small>
                    </div>

                </div>

                <span class="header-chip">
                    @(_data.CompanyTargetPercent.ToString("0.0"))% للفريق
                </span>

            </div>


            <div class="target-gauge-grid">

                <!-- 🎯 Gauge الشركة (Semi-Circle ApexCharts) -->
                <div class="target-gauge-box company-gauge">

                    <div id="gaugeCompany"
                         class="mk-gauge-chart"></div>

                    <div class="target-gauge-label">
                        <strong>الفريق</strong>
                        <small>
                            @FmtMoney(_data.CompanyActualRevenue)
                            من
                            @FmtMoney(_data.MonthlySalesTarget)
                        </small>
                    </div>

                </div>


                <!-- 🎯 Gauge كل موظف (Semi-Circle ApexCharts) -->
                @foreach (var emp in _data.EmployeeTargets)
                {
                    <div class="target-gauge-box">

                        <div id="gaugeEmp@(emp.EmployeeId)"
                             class="mk-gauge-chart"></div>

                        <div class="target-gauge-label">
                            <strong>@emp.EmployeeName</strong>
                            <small>
                                @FmtMoney(emp.ActualAmount)
                                من
                                @FmtMoney(emp.TargetAmount)
                            </small>
                            <span class="gauge-status @emp.StatusClass">
                                @emp.StatusText
                            </span>
                        </div>

                    </div>
                }

            </div>

        </section>


        <!-- ========================================================= -->
        <!-- PERFORMANCE TRENDS -->
        <!-- ========================================================= -->

        <section class="dashboard-card trend-card">

            <div class="card-header">

                <div class="card-title">

                    <span class="title-marker blue"></span>

                    <div>
                        <strong>اتجاه الأداء</strong>
                        <small>Performance Trend</small>
                    </div>

                </div>

                <span class="header-chip">
                    آخر البيانات
                </span>

            </div>


            <div class="trend-grid">


                <!-- LEADS -->

                <div class="trend-box">

                    <div class="trend-heading">

                        <div>
                            <strong>Leads</strong>
                            <small>لييدز</small>
                        </div>

                        <span class="trend-indicator positive">
                            ↑
                        </span>

                    </div>

                    <ApexChart TItem="MarketingTrendDto"
                               Options="_leadsOpts"
                               Height="205"
                               Width="@("100%")">

                        <ApexPointSeries TItem="MarketingTrendDto"
                                         Items="_data.LeadsTrend"
                                         Name="Leads"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(d => d.ChartLabel)"
                                         YValue="@(d => (decimal?)d.Value)" />

                    </ApexChart>

                </div>


                <!-- CONVERSION -->

                <div class="trend-box">

                    <div class="trend-heading">

                        <div>
                            <strong>Conversion Rate</strong>
                            <small>معدل التحويل</small>
                        </div>

                        <span class="trend-indicator positive">
                            ↑
                        </span>

                    </div>

                    <ApexChart TItem="MarketingTrendDto"
                               Options="_convOpts"
                               Height="205"
                               Width="@("100%")">

                        <ApexPointSeries TItem="MarketingTrendDto"
                                         Items="_data.ConversionTrend"
                                         Name="Conversion"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(d => d.ChartLabel)"
                                         YValue="@(d => (decimal?)d.Value)" />

                    </ApexChart>

                </div>


                <!-- CPL -->

                <div class="trend-box">

                    <div class="trend-heading">

                        <div>
                            <strong>CPL</strong>
                            <small>تكلفة اللييد</small>
                        </div>

                        <span class="trend-indicator positive">
                            ↓
                        </span>

                    </div>

                    <ApexChart TItem="MarketingTrendDto"
                               Options="_cplOpts"
                               Height="205"
                               Width="@("100%")">

                        <ApexPointSeries TItem="MarketingTrendDto"
                                         Items="_data.CplTrend"
                                         Name="CPL"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(d => d.ChartLabel)"
                                         YValue="@(d => (decimal?)d.Value)" />

                    </ApexChart>

                </div>


                <!-- ROAS -->

                <div class="trend-box">

                    <div class="trend-heading">

                        <div>
                            <strong>ROAS</strong>
                            <small>العائد على الإنفاق</small>
                        </div>

                        <span class="trend-indicator positive">
                            ↑
                        </span>

                    </div>

                    <ApexChart TItem="MarketingTrendDto"
                               Options="_roasOpts"
                               Height="205"
                               Width="@("100%")">

                        <ApexPointSeries TItem="MarketingTrendDto"
                                         Items="_data.RoasTrend"
                                         Name="ROAS"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(d => d.ChartLabel)"
                                         YValue="@(d => (decimal?)d.Value)" />

                    </ApexChart>

                </div>

            </div>

        </section>


        <!-- ========================================================= -->
        <!-- ALERTS + SCORE -->
        <!-- ========================================================= -->

        <section class="bottom-grid">


            <!-- ALERTS -->

            <article class="dashboard-card alerts-card">

                <div class="card-header">

                    <div class="card-title">

                        <span class="title-marker orange"></span>

                        <div>
                            <strong>تنبيهات الإدارة</strong>
                            <small>Management Alerts</small>
                        </div>

                    </div>

                    <span class="alert-count">
                        @_data.Alerts.Count
                    </span>

                </div>


                <div class="card-content alerts-content">

                    @if (_data.Alerts.Count == 0)
                    {
                        <div class="empty-state">
                            لا توجد تنبيهات حاليًا
                        </div>
                    }
                    else
                    {
                        @foreach (var alert in _data.Alerts)
                        {
                            <div class="management-alert alert-@alert.Type">

                                <span class="alert-status-dot"></span>

                                <div class="alert-text">

                                    <strong>
                                        @alert.Text
                                    </strong>

                                    <small>
                                        @alert.Detail
                                    </small>

                                </div>

                            </div>
                        }
                    }

                </div>

            </article>


            <!-- PERFORMANCE SCORE -->

            <article class="dashboard-card score-card">

                <div class="card-header">

                    <div class="card-title">

                        <span class="title-marker green"></span>

                        <div>
                            <strong>مؤشر الأداء التسويقي</strong>
                            <small>Marketing Performance Score</small>
                        </div>

                    </div>

                    <span class="header-chip">
                        Score
                    </span>

                </div>


                <div class="score-content">

                    <div class="score-gauge-cell">

                        <div id="scoreGauge"
                             class="mk-gauge-chart score-gauge-chart"></div>

                        <div class="score-gauge-under">

                            <span class="score-label-new @_data.ScoreClass">
                                @_data.ScoreLabel
                            </span>

                            @if (_data.ScoreCapped)
                            {
                                <div class="score-cap-note">
                                    🚨 سقف 4/10: لا يوجد عملاء أو إيرادات في هذه الفترة
                                </div>
                            }

                        </div>

                    </div>


                    <div class="score-guide">

                        <div class="score-guide-title">
                            دليل النتيجة
                            <small>موضع السكور الحالي على المقياس</small>
                        </div>

                        <div class="sg-track" dir="ltr">
                            <span class="sg-marker"
                                  style="left:@ScoreMarkerLeft()"></span>
                        </div>

                        <div class="sg-labels" dir="ltr">
                            <span style="flex-grow:6">ضعيف</span>
                            <span style="flex-grow:1">يحتاج تحسين</span>
                            <span style="flex-grow:1">جيد</span>
                            <span style="flex-grow:1">جيد جداً</span>
                            <span style="flex-grow:1">ممتاز</span>
                        </div>

                    </div>


                    <div class="score-components">

                        <div class="score-components-head">

                            <h4>تفصيل الحساب</h4>

                            <small>شفافية كاملة — كل مكوّن بدرجته ووزنه</small>

                        </div>

                        <div class="sc-grid">

                            @foreach (var c in _data.ScoreComponents)
                            {
                                <div class="sc-mini">

                                    <div class="sc-mini-top">

                                        <span class="sc-mini-name">@c.Label</span>

                                        <span class="sc-mini-weight">@c.Weight.ToString("0")%</span>

                                    </div>

                                    <strong class="sc-mini-pts">
                                        @c.Earned.ToString("0.0")<i>/10</i>
                                    </strong>

                                    <div class="sc-mini-bar">
                                        <i style="width:@ScoreBarWidth(c.Earned); background:@ScoreBarColor(c.Earned)"></i>
                                    </div>

                                    <small class="sc-mini-detail" title="@c.Detail">@c.Detail</small>

                                </div>
                            }

                        </div>

                        <div class="sc-total">
                            <span>الإجمالي المرجّح</span>
                            <strong>@_data.PerformanceScore.ToString("0.0") / 10</strong>
                        </div>

                    </div>

                </div>

            </article>

        </section>


        <!-- ========================================================= -->
        <!-- FOOTER -->
        <!-- ========================================================= -->

        <footer class="dashboard-footer">

            <span>
                Smart Marketing = More Leads = Better Conversion = Higher Revenue
            </span>

            <b>|</b>

            <span>
                تسويق أذكى = عملاء أكثر = تحويل أفضل = مبيعات أعلى
            </span>

        </footer>

    </div>
}


<style>

    /* ================================================================
       ROOT
       ================================================================ */

    .marketing-dashboard {
        --navy: #123a78;
        --navy-dark: #092c61;
        --blue: #1264d8;
        --blue-light: #eaf3ff;

        --green: #13965c;
        --green-light: #e9f8f0;

        --orange: #ed8b16;
        --orange-light: #fff4e5;

        --red: #d93445;
        --red-light: #fff0f2;

        --purple: #7447c6;
        --purple-light: #f3effc;

        --cyan: #1787b7;
        --cyan-light: #eaf7fb;

        --page: #f5f7fb;
        --card: #ffffff;
        --border: #dce3ee;

        --text: #17233a;
        --muted: #708099;

        --radius: 13px;

        width: 100%;
        min-height: 100vh;

        padding: 14px;

        background:
            linear-gradient(
                180deg,
                #f7f9fc 0%,
                #f3f6fa 100%
            );

        color: var(--text);

        font-family:
            "Cairo",
            "Tajawal",
            "Inter",
            Arial,
            sans-serif;

        box-sizing: border-box;
    }


    .marketing-dashboard *,
    .marketing-dashboard *::before,
    .marketing-dashboard *::after {
        box-sizing: border-box;
    }


    /* ⬇️ فتح المسافات الرأسية بين أقسام اللوحة (كانت ملتصقة) */
    .marketing-dashboard > * + * {
        margin-top: 24px;
    }


    /* ================================================================
       LOADING / STATES
       ================================================================ */

    .marketing-loading,
    .marketing-state {
        min-height: 70vh;

        display: flex;
        flex-direction: column;

        align-items: center;
        justify-content: center;

        gap: 10px;

        color: #506078;

        font-family:
            "Cairo",
            "Tajawal",
            Arial,
            sans-serif;
    }

    .marketing-loading-title {
        font-size: 17px;
        font-weight: 800;
        color: #17233a;
    }

    .marketing-loading-subtitle {
        font-size: 12px;
        color: #8995a8;
    }

    .marketing-spinner {
        width: 42px;
        height: 42px;

        border: 4px solid #e0e7f0;
        border-top-color: var(--blue);

        border-radius: 50%;

        animation: marketingSpin .8s linear infinite;
    }

    @@keyframes marketingSpin {
        to {
            transform: rotate(360deg);
        }
    }

    .marketing-state .state-icon {
        width: 58px;
        height: 58px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background: #eaf3ff;
        color: var(--blue);

        font-size: 28px;
        font-weight: 900;
    }

    .marketing-state .state-icon.error {
        background: #fff0f2;
        color: var(--red);
    }

    .marketing-state h3 {
        margin: 0;
        color: #17233a;
    }

    .marketing-state p {
        margin: 0;
        color: #8290a5;
        font-size: 13px;
    }

    .primary-button {
        border: 0;
        background: var(--blue);
        color: #fff;

        padding: 9px 20px;

        border-radius: 8px;

        cursor: pointer;

        font-family: inherit;
        font-weight: 700;

        margin-top: 8px;
    }


    /* ================================================================
       HEADER
       ================================================================ */

    .dashboard-header {
        min-height: 66px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 20px;

        padding: 8px 13px 8px 18px;

        border-radius: 13px;

        color: white;

        background:
            linear-gradient(
                100deg,
                #153f80 0%,
                #103874 52%,
                #092f69 100%
            );

        box-shadow:
            0 5px 18px rgba(25, 62, 112, .18);

        overflow: hidden;
    }


    .header-brand {
        display: flex;
        align-items: center;

        min-width: 0;

        gap: 12px;
    }


    .brand-logo {
        width: 45px;
        height: 45px;

        flex: 0 0 45px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background: rgba(255,255,255,.10);
    }

    .brand-logo svg {
        width: 36px;
        height: 36px;
    }


    .brand-logo-img {
        width: 42px;
        height: 42px;

        object-fit: contain;

        border-radius: 50%;
    }


    .brand-divider {
        width: 1px;
        height: 40px;

        background: rgba(255,255,255,.30);
    }


    .brand-title {
        font-family:
            "Inter",
            Arial,
            sans-serif;

        font-size: clamp(18px, 1.8vw, 27px);

        font-weight: 800;

        line-height: 1.1;

        white-space: nowrap;
    }


    .brand-subtitle {
        margin-top: 3px;

        font-size: 12px;

        color: rgba(255,255,255,.82);

        font-weight: 600;
    }


    .header-management {
        display: flex;
        align-items: center;

        gap: 12px;

        flex: 0 0 auto;

        padding: 5px 8px 5px 13px;

        border: 1px solid rgba(255,255,255,.15);

        border-radius: 11px;

        background: rgba(255,255,255,.055);
    }


    .management-text {
        text-align: right;

        font-family:
            "Inter",
            "Cairo",
            Arial,
            sans-serif;

        font-size: 13px;

        font-weight: 700;
    }

    .management-text small {
        display: block;

        margin-top: 1px;

        font-family: "Cairo", Arial, sans-serif;

        font-size: 10px;

        font-weight: 500;

        color: rgba(255,255,255,.68);
    }


    .management-icon {
        width: 39px;
        height: 39px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-left: 1px solid rgba(255,255,255,.16);

        padding-left: 10px;

        color: white;
    }

    .management-icon svg {
        width: 28px;
        height: 28px;
    }


    /* ================================================================
       FILTERS
       ================================================================ */

    .filter-panel {
        min-height: 49px;

        display: flex;
        align-items: center;

        gap: 14px;

        padding: 7px 10px;

        background: #fff;

        border: 1px solid var(--border);

        border-radius: 11px;

        box-shadow:
            0 2px 8px rgba(21, 48, 83, .045);

        overflow-x: auto;
    }


    .filter-section {
        display: flex;
        align-items: center;

        gap: 7px;

        flex: 0 0 auto;
    }


    .filter-caption {
        font-size: 12px;
        font-weight: 800;

        color: #26354d;

        white-space: nowrap;
    }


    .filter-pills {
        display: flex;
        align-items: center;

        gap: 4px;
    }


    .filter-pill {
        height: 29px;

        padding: 0 12px;

        border: 1px solid #d8e0eb;

        border-radius: 7px;

        background: #fff;

        color: #34445d;

        font-family: inherit;

        font-size: 11px;
        font-weight: 700;

        white-space: nowrap;

        cursor: pointer;

        transition:
            background .15s ease,
            color .15s ease,
            border-color .15s ease,
            transform .15s ease;
    }


    .filter-pill:hover {
        border-color: #b9c7da;
        transform: translateY(-1px);
    }


    .filter-pill.active {
        background: var(--orange);
        border-color: var(--orange);

        color: #fff;

        box-shadow:
            0 3px 8px rgba(237,139,22,.22);
    }


    .channel-pill.active {
        background: var(--blue);
        border-color: var(--blue);
    }


    .date-range-box {
        height: 31px;

        display: flex;
        align-items: center;

        gap: 7px;

        padding: 0 10px;

        border: 1px solid #d9e1ec;

        border-radius: 7px;

        background: #fff;

        color: #34445d;

        font-size: 11px;

        white-space: nowrap;
    }


    .date-range-box.readonly svg {
        width: 17px;
        height: 17px;

        color: var(--navy);
    }


    .date-input {
        height: 28px;

        border: 0;

        outline: none;

        color: #34445d;

        font-family: inherit;

        font-size: 11px;

        background: transparent;
    }


    .date-arrow {
        color: #9aa7b9;
        font-weight: 700;
    }


    .period-comparison {
        margin-right: auto;

        height: 31px;

        display: flex;
        align-items: center;

        gap: 5px;

        padding: 0 11px;

        border-radius: 8px;

        font-size: 11px;

        white-space: nowrap;
    }


    .period-comparison.positive {
        color: #087844;
        background: #edf9f2;
        border: 1px solid #c7ead7;
    }

    .period-comparison.negative {
        color: #b42335;
        background: #fff1f3;
        border: 1px solid #f1c8cf;
    }


    .comparison-arrow {
        font-size: 16px;
        font-weight: 900;
    }


    .refresh-progress {
        height: 3px;

        background: #dce5f1;

        overflow: hidden;

        border-radius: 3px;
    }

    .refresh-progress div {
        height: 100%;
        width: 30%;

        background: var(--blue);

        animation: refreshProgress 1.1s infinite ease-in-out;
    }

    @@keyframes refreshProgress {
        0% {
            transform: translateX(-120%);
        }

        100% {
            transform: translateX(450%);
        }
    }


    /* ================================================================
       KPI
       ================================================================ */

    .kpi-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;

        /* عدد الكروت في الصف الواحد (سطرين على الشاشات الواسعة) */
        --kpi-rows: 2;
    }

    .kpi-card {
        /* ≈ 7 كروت لكل صف على الشاشات الكبيرة → أول صف 7 + تاني صف 6 (بيمتلئ)
           والصندوق بيتمطط فآخر صف يستعرض بنفس العرض بدون فراغات */
        flex: 1 1 calc((100% - 90px) / 7);

        min-width: 0;
        min-height: 106px;

        position: relative;

        display: flex;
        align-items: center;

        gap: 12px;

        padding: 12px 14px;

        background:
            linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);

        border: 1px solid #dbe3ed;

        border-radius: 13px;

        box-shadow:
            0 2px 8px rgba(20, 44, 77, .04);

        overflow: hidden;

        transition:
            transform .18s ease,
            box-shadow .18s ease;
    }

    .kpi-card::after {
        content: "";

        position: absolute;

        right: 0;
        top: 12px;
        bottom: 12px;

        width: 3px;

        border-radius: 4px 0 0 4px;

        background: var(--kpi-color);
    }

    .kpi-card:hover {
        transform: translateY(-2px);

        box-shadow:
            0 8px 20px rgba(20, 44, 77, .1);
    }

    .kpi-icon {
        width: 48px;
        height: 48px;

        flex: 0 0 48px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 13px;

        background:
            color-mix(
                in srgb,
                var(--kpi-color) 10%,
                white
            );

        color: var(--kpi-color);
    }

    .kpi-icon svg {
        width: 26px;
        height: 26px;
    }

    .kpi-data {
        min-width: 0;
        flex: 1;
    }

    .kpi-label {
        color: #64748b;

        font-size: 12px;
        font-weight: 700;

        line-height: 1.3;

        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .kpi-value {
        color: #14213a;

        font-family:
            "Inter",
            "Cairo",
            Arial,
            sans-serif;

        font-size: clamp(20px, 1.35vw, 26px);

        font-weight: 900;

        line-height: 1.15;

        white-space: nowrap;

        margin: 3px 0 5px;
    }

    .kpi-foot {
        display: flex;
        align-items: center;
        gap: 6px;

        min-height: 20px;

        flex-wrap: wrap;
    }

    .kpi-change {
        display: inline-flex;
        align-items: center;

        gap: 4px;

        padding: 2px 8px;

        border-radius: 999px;

        font-size: 11px;
        font-weight: 800;

        white-space: nowrap;
    }

    .kpi-change.good {
        color: #0b8a50;

        background: #e7f6ee;
    }

    .kpi-change.bad {
        color: #c2242f;

        background: #fdeaec;
    }

    .change-arrow {
        font-size: 12px;
        font-weight: 900;
    }

    .kpi-sub {
        display: inline-flex;
        align-items: center;

        padding: 2px 8px;

        border-radius: 999px;

        font-size: 10.5px;
        font-weight: 700;

        white-space: nowrap;

        color: #64748b;
        background: #eef2f7;
    }

    .kpi-sub.sub-good {
        color: #0b8a50;
        background: #e7f6ee;
    }

    .kpi-sub.sub-bad {
        color: #c2242f;
        background: #fdeaec;
    }

/* ================================================================
       CARD SYSTEM
       ================================================================ */

    .dashboard-card {
        min-width: 0;

        background: #fff;

        border: 1px solid var(--border);

        border-radius: var(--radius);

        box-shadow:
            0 2px 9px rgba(24, 48, 80, .045);

        overflow: hidden;
    }


    .card-header {
        min-height: 53px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 10px;

        padding: 9px 14px;

        background:
            linear-gradient(
                180deg,
                #ffffff 0%,
                #fafbfd 100%
            );

        border-bottom: 1px solid #e7ecf3;
    }


    .card-title {
        display: flex;
        align-items: center;

        gap: 8px;

        min-width: 0;
    }


    .card-title > div {
        min-width: 0;
    }


    .card-title strong {
        display: block;

        color: #1c2b43;

        font-size: 14px;

        font-weight: 800;

        line-height: 1.2;
    }


    .card-title small {
        display: block;

        margin-top: 2px;

        color: #9aa6b8;

        font-family: "Inter", Arial, sans-serif;

        font-size: 8px;

        font-weight: 500;
    }


    .title-marker {
        width: 7px;
        height: 29px;

        border-radius: 5px;

        flex: 0 0 7px;
    }


    .title-marker.blue {
        background: var(--blue);
    }

    .title-marker.cyan {
        background: var(--cyan);
    }

    .title-marker.orange {
        background: var(--orange);
    }

    .title-marker.purple {
        background: var(--purple);
    }

    .title-marker.green {
        background: var(--green);
    }


    .header-chip {
        padding: 4px 8px;

        border-radius: 7px;

        background: #f1f4f8;

        color: #748198;

        font-family: "Inter", "Cairo", Arial, sans-serif;

        font-size: 9px;

        font-weight: 700;

        white-space: nowrap;
    }


    .card-header-value {
        color: #8793a7;

        font-size: 10px;

        white-space: nowrap;
    }


    .card-content {
        padding: 12px 13px;
    }


    /* ================================================================
       MAIN GRID
       ================================================================ */

    .analytics-grid {
        display: grid;

        /* 🆕 3 أعمدة: الفنل | القنوات+الحملات | المستهدف+التسويق مقابل المبيعات */
        grid-template-columns:
            1.05fr 1.25fr 1.05fr;

        gap: 16px;

        align-items: stretch;
    }


    .analytics-middle-column,
    .analytics-right-column {
        display: grid;

        grid-column: span 1;

        grid-template-rows:
            minmax(0, auto)
            minmax(0, auto);

        gap: 16px;

        min-width: 0;
    }


    /* ================================================================
       FUNNEL
       ================================================================ */

    .funnel-card {
        min-height: 100%;

        /* 🆕 عمود مستقل جنب باقي الكروت (مش صف كامل) */
        grid-column: auto;
    }


    .funnel-content {
        padding: 10px 9px 12px;
    }


    .funnel-wrapper {
        width: 100%;

        display: flex;
        justify-content: center;
        padding: 0 8px;
    }


    .mk-funnel-chart {
        width: 100%;
        min-height: 520px;
    }


    .funnel-note {
        margin-top: 4px;

        color: #99a5b5;

        font-size: 9px;

        text-align: center;
    }


    /* ═══════════════ 🪜 الفنل الجديد (HTML/CSS — هرم متوسّط + تسرب جانبي) ═══════════════ */
    .nf-wrap { display: flex; flex-direction: column; gap: .55rem; padding: 4px 2px; }
    .nf-row { display: grid; grid-template-columns: 1fr 86px; align-items: center; gap: .6rem; }
    .nf-zone { display: flex; justify-content: center; min-width: 0; }
    .nf-bar { border-radius: 12px; padding: .55rem .9rem; display: flex; align-items: center; justify-content: center;
        gap: .7rem; box-shadow: 0 4px 12px rgba(15,23,42,.18); transition: transform .18s ease; }
    .nf-bar:hover { transform: scale(1.02); }
    .nf-bar.side { border: 2px dashed #fb7185; }
    .nf-count { font-weight: 900; font-size: 1.05rem; }
    .nf-name { font-size: .78rem; font-weight: 700; opacity: .95; }
    .nf-drop { display: flex; justify-content: center; }
    .nf-chip { background: #ffe4e6; color: #e11d48; font-size: .74rem; font-weight: 900;
        border-radius: 999px; padding: .3rem .6rem; white-space: nowrap; border: 1px solid #fecdd3; }
    .nf-chip.neutral { background: #f1f5f9; color: #94a3b8; border-color: #e2e8f0; }
    .nf-chip.side-chip { background: #fff1f2; color: #e11d48; border: 1px dashed #fb7185; }


    .funnel-main {
        width: 100%;

        display: flex;
        flex-direction: column;

        align-items: center;
    }


    .funnel-stage-row {
        width: 100%;

        display: flex;
        flex-direction: column;

        align-items: center;
    }


    .funnel-stage {
        position: relative;

        min-width: 170px;

        height: 43px;

        display: grid;

        grid-template-columns: 1fr auto 1fr;

        align-items: center;

        padding: 0 14px;

        color: #fff;

        background:
            linear-gradient(
                135deg,
                color-mix(in srgb, var(--funnel-color) 88%, white),
                var(--funnel-color)
            );

        clip-path:
            polygon(
                4% 0,
                96% 0,
                91% 100%,
                9% 100%
            );

        box-shadow:
            0 4px 8px rgba(20, 45, 75, .08);

        transition:
            width .25s ease,
            transform .18s ease;
    }


    .funnel-stage:hover {
        transform: scaleX(1.015);
    }


    .funnel-stage-name {
        text-align: center;

        font-size: 11px;

        font-weight: 800;

        white-space: nowrap;

        overflow: hidden;

        text-overflow: ellipsis;
    }


    .funnel-stage-value {
        font-family:
            "Inter",
            "Cairo",
            Arial,
            sans-serif;

        font-size: 16px;

        font-weight: 900;

        white-space: nowrap;

        padding: 0 8px;
    }


    .funnel-stage-percent {
        text-align: center;

        font-family: "Inter", Arial, sans-serif;

        font-size: 9px;

        font-weight: 700;

        opacity: .9;

        white-space: nowrap;
    }


    .funnel-drop {
        height: 26px;

        display: flex;
        align-items: center;

        gap: 5px;

        color: #d65b69;

        font-family:
            "Inter",
            "Cairo",
            Arial,
            sans-serif;

        font-size: 9px;

        font-weight: 700;
    }


    .funnel-drop span {
        font-size: 13px;
        font-weight: 900;
    }


    /* ================================================================
       TABLES
       ================================================================ */

    .table-container {
        overflow-x: auto;
    }


    .data-table {
        width: 100%;

        border-collapse: collapse;

        table-layout: auto;

        font-size: 14px;
    }


    .data-table thead th {
        padding: 10px 8px;

        background: #f0f3f7;

        color: #334259;

        border: 1px solid #dfe5ed;

        font-weight: 800;

        font-size: 13px;

        white-space: nowrap;

        text-align: center;
    }


    .data-table thead th:first-child {
        text-align: right;
    }


    .data-table tbody td {
        padding: 10px 8px;

        border-bottom: 1px solid #edf1f5;

        color: #526177;

        text-align: center;

        white-space: nowrap;
    }


    .data-table tbody td:first-child {
        text-align: right;
    }


    .data-table tbody tr:hover td {
        background: #fafcff;
    }


    .data-table .total-row td {
        background: #edf3fb;

        color: #17233a;

        font-weight: 900;

        border-top: 1px solid #cfd9e7;
    }


    .channel-name {
        display: flex;
        align-items: center;

        gap: 6px;
    }


    .channel-dot {
        width: 7px;
        height: 7px;

        flex: 0 0 7px;

        border-radius: 50%;
    }


    .table-note {
        margin-top: 7px;

        padding-top: 7px;

        border-top: 1px dashed #e1e6ee;

        color: #99a5b5;

        font-size: 9px;
    }


    /* ================================================================
       CAMPAIGNS
       ================================================================ */

    .campaign-tabs {
        display: flex;

        gap: 3px;

        padding: 2px;

        border-radius: 7px;

        background: #eef2f7;
    }


    .campaign-tabs button {
        border: 0;

        padding: 4px 10px;

        border-radius: 5px;

        background: transparent;

        color: #8995a7;

        font-family: inherit;

        font-size: 9px;

        font-weight: 700;

        cursor: pointer;
    }


    .campaign-tabs button.active {
        background: #fff;

        color: #1c2b43;

        box-shadow:
            0 1px 3px rgba(20,40,70,.10);
    }


    .campaign-table td {
        height: 35px;
    }


    .campaign-rank {
        width: 28px;

        color: #8d99aa !important;

        font-family: "Inter", Arial, sans-serif;

        font-weight: 800;
    }


    .campaign-name {
        color: #24334b;

        max-width: 125px;

        overflow: hidden;

        text-overflow: ellipsis;

        display: block;
    }


    .campaign-conversion {
        display: flex;
        align-items: center;

        justify-content: center;

        gap: 5px;
    }


    .mini-progress {
        width: 55px;
        height: 5px;

        overflow: hidden;

        background: #e5eaf1;

        border-radius: 5px;
    }


    .mini-progress span {
        display: block;

        height: 100%;

        border-radius: inherit;
    }


    .campaign-conversion strong {
        min-width: 35px;

        font-family: "Inter", Arial, sans-serif;

        font-size: 9px;

        color: #47566d;
    }


    /* ================================================================
       TARGET
       ================================================================ */

    .target-table {
        width: 100%;

        border: 1px solid #dfe5ed;

        border-radius: 8px;

        overflow: hidden;
    }


    .target-table-header,
    .target-row {
        display: grid;

        grid-template-columns:
            1.25fr
            .8fr
            .8fr
            1.05fr
            .45fr;

        align-items: center;

        column-gap: 4px;
    }


    .target-table-header {
        min-height: 34px;

        background: #f0f3f7;

        color: #344258;

        font-size: 9px;

        font-weight: 800;
    }


    .target-table-header span {
        text-align: center;
    }


    .target-table-header span:first-child {
        text-align: right;
        padding-right: 8px;
    }


    .target-row {
        min-height: 42px;

        border-top: 1px solid #edf1f5;

        color: #55637a;

        font-family:
            "Cairo",
            "Inter",
            Arial,
            sans-serif;

        font-size: 9px;
    }


    .target-row > div {
        text-align: center;
    }


    .target-metric {
        text-align: right !important;

        padding-right: 8px;

        color: #24334b;

        font-weight: 800;
    }


    .target-progress-cell {
        display: flex;

        flex-direction: column;

        align-items: center;

        gap: 3px;
    }


    .target-percent {
        font-family: "Inter", Arial, sans-serif;

        font-size: 9px;

        font-weight: 900;
    }


    .target-percent.good {
        color: #11945b;
    }

    .target-percent.bad {
        color: #d93445;
    }


    .target-progress {
        width: 48px;
        height: 4px;

        background: #e5eaf1;

        border-radius: 5px;

        overflow: hidden;
    }


    .target-progress span {
        display: block;

        height: 100%;

        border-radius: inherit;
    }


    .target-progress span.good {
        background: #15965e;
    }

    .target-progress span.bad {
        background: #d93445;
    }


    .status-icon {
        width: 19px;
        height: 19px;

        display: inline-flex;

        align-items: center;
        justify-content: center;

        border-radius: 50%;

        color: #fff;

        font-family: "Inter", Arial, sans-serif;

        font-size: 11px;

        font-weight: 900;
    }


    .status-icon.success {
        background: #13965c;
    }

    .status-icon.warning {
        background: #efa016;
    }

    .status-icon.danger {
        background: #d93445;
    }


    .target-summary {
        display: grid;

        grid-template-columns:
            repeat(3, 1fr);

        gap: 7px;

        margin-top: 10px;
    }


    .summary-box {
        min-height: 53px;

        display: flex;
        flex-direction: column;

        justify-content: center;

        gap: 2px;

        padding: 7px 9px;

        border-radius: 8px;

        background: #f5f7fa;

        border: 1px solid #e4e9f0;
    }


    .summary-box span {
        color: #8a96a8;

        font-size: 8px;

        font-weight: 600;
    }


    .summary-box strong {
        color: #1b2941;

        font-family:
            "Inter",
            "Cairo",
            Arial,
            sans-serif;

        font-size: 13px;

        font-weight: 900;
    }


    .summary-box.highlighted {
        background: #fff8e9;

        border-color: #f2d18d;
    }


    .summary-box.highlighted strong {
        color: #a76605;
    }


    /* ================================================================
       MARKETING VS SALES
       ================================================================ */

    .sales-comparison {
        display: grid;

        grid-template-columns:
            minmax(0, 1fr)
            135px;

        gap: 12px;

        align-items: center;
    }


    .sales-funnel {
        display: flex;

        flex-direction: column;

        align-items: center;

        gap: 4px;
    }


    .sales-level {
        min-height: 29px;

        display: flex;

        align-items: center;

        justify-content: space-between;

        padding: 0 10px;

        border-radius: 5px;

        color: white;

        font-size: 9px;

        font-weight: 700;

        transition: transform .15s ease;
    }


    .sales-level:hover {
        transform: scaleX(1.01);
    }


    .sales-level strong {
        font-family: "Inter", Arial, sans-serif;

        font-size: 12px;
    }


    .sales-level.level-1 {
        width: 100%;
        background: #ef801d;
    }

    .sales-level.level-2 {
        width: 82%;
        background: #eb7620;
    }

    .sales-level.level-3 {
        width: 66%;
        background: #df6529;
    }

    .sales-level.level-4 {
        width: 48%;
        background: #d94e2c;
    }

    .sales-level.level-5 {
        width: 30%;
        background: #c93635;
    }


    .vs-status {
        min-height: 110px;

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 9px;

        padding: 12px;

        border-radius: 10px;

        text-align: center;
    }


    .vs-status.good {
        background: #e8f8ef;

        border: 1px solid #b9e5ca;

        color: #137448;
    }


    .vs-status.warning {
        background: #fff7e8;

        border: 1px solid #f0d69c;

        color: #9a6509;
    }


    .vs-status.poor {
        background: #fff0f2;

        border: 1px solid #efc2ca;

        color: #b32e40;
    }


    .status-balance svg {
        width: 35px;
        height: 35px;
    }


    .vs-status small {
        display: block;

        font-size: 8px;

        opacity: .75;
    }


    .vs-status strong {
        display: block;

        margin-top: 4px;

        font-size: 11px;

        line-height: 1.35;
    }


    /* ================================================================
       🎯 TARGET GAUGE (إنجاز التارجيت)
       ================================================================ */

    .target-gauge-card {
        width: 100%;
    }


    .target-gauge-grid {
        display: grid;

        grid-template-columns:
            repeat(auto-fit, minmax(170px, 1fr));

        gap: 16px;

        padding: 12px;
    }


    .target-gauge-box {
        display: flex;
        flex-direction: column;

        align-items: center;

        gap: 7px;

        padding: 12px 8px;

        border: 1px solid #e3e9f1;

        border-radius: 11px;

        background:
            linear-gradient(
                180deg,
                #fbfcfe,
                #f6f8fb
            );
    }


    .target-gauge-box .mk-gauge-chart {
        width: 100%;
        min-height: 175px;

        display: flex;
        align-items: center;
        justify-content: center;
    }




    .target-gauge-label {
        text-align: center;

        min-width: 0;
    }


    .target-gauge-label strong {
        display: block;

        color: #24334b;

        font-size: 11px;

        font-weight: 800;

        white-space: nowrap;

        overflow: hidden;

        text-overflow: ellipsis;
    }


    .target-gauge-label small {
        display: block;

        margin-top: 2px;

        color: #8a96a8;

        font-size: 8px;

        white-space: nowrap;
    }


    .gauge-status {
        display: inline-block;

        margin-top: 4px;

        padding: 2px 9px;

        border-radius: 10px;

        font-size: 8px;

        font-weight: 800;
    }


    .gauge-status.good {
        color: #137a4b;
        background: #e8f8ef;
    }

    .gauge-status.warn {
        color: #9b6507;
        background: #fff5df;
    }

    .gauge-status.bad {
        color: #b52f40;
        background: #fff0f2;
    }


    .company-gauge {
        border-color: #c9dcf5;

        background:
            linear-gradient(
                180deg,
                #f3f8ff,
                #eaf3ff
            );
    }


    /* ================================================================
       TRENDS
       ================================================================ */

    .trend-card {
        width: 100%;
    }


    .trend-grid {
        display: grid;

        grid-template-columns:
            repeat(4, minmax(0, 1fr));

        gap: 9px;

        padding: 10px;
    }


    .trend-box {
        min-width: 0;

        border: 1px solid #e1e7ef;

        border-radius: 10px;

        background:
            linear-gradient(
                180deg,
                #fbfcfe,
                #f7f9fc
            );

        overflow: hidden;

        padding: 8px 8px 2px;
    }


    .trend-heading {
        display: flex;

        align-items: center;
        justify-content: space-between;

        min-height: 33px;

        padding: 0 3px;
    }


    .trend-heading strong {
        display: block;

        color: #27364e;

        font-family: "Inter", Arial, sans-serif;

        font-size: 11px;

        font-weight: 800;
    }


    .trend-heading small {
        display: block;

        margin-top: 1px;

        color: #9aa5b5;

        font-size: 8px;
    }


    .trend-indicator {
        width: 25px;
        height: 25px;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 7px;

        font-family: "Inter", Arial, sans-serif;

        font-size: 15px;

        font-weight: 900;
    }


    .trend-indicator.positive {
        color: #138b58;

        background: #eaf8f0;
    }


    .trend-box .apexcharts-canvas {
        max-width: 100% !important;
    }


    .trend-box .apexcharts-svg {
        overflow: visible;
    }


    /* ================================================================
       ALERTS
       ================================================================ */

    .bottom-grid {
        display: grid;

        grid-template-columns:
            minmax(0, .9fr)
            minmax(0, 1.1fr);

        gap: 20px;
    }


    .alerts-content {
        padding: 11px;
    }


    .alert-count {
        min-width: 24px;
        height: 24px;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 7px;

        background: #fff2e5;

        color: #c56b0b;

        font-family: "Inter", Arial, sans-serif;

        font-size: 10px;

        font-weight: 900;
    }


    .management-alert {
        min-height: 34px;

        display: flex;

        align-items: flex-start;

        gap: 9px;

        margin-bottom: 5px;

        padding: 8px 10px;

        border: 1px solid transparent;

        border-inline-start: 4px solid #cbd5e1;

        border-radius: 12px;

        background: #f8fafc;
    }

    /* 🆕 تنسيق V2 — شريط جانبي ملون حسب النوع */
    .management-alert.alert-good { border-inline-start-color: #16a34a; background: #f0fdf4; }
    .management-alert.alert-warn { border-inline-start-color: #f59e0b; background: #fffbeb; }
    .management-alert.alert-bad { border-inline-start-color: #dc2626; background: #fef2f2; }
    .management-alert.alert-info { border-inline-start-color: #3b82f6; background: #eff6ff; }

    .management-alert .alert-text strong { font-size: .78rem; display: block; color: #0f172a; }
    .management-alert .alert-text small { font-size: .7rem; color: #64748b; }


    /* ═══════════════ ⬇️ شارات التسرب (Marketing vs Sales) ═══════════════ */
    .vs-drop-row { display: flex; justify-content: flex-start; padding: 0 4px; }
    .vs-drop-chip { background: #ffe4e6; color: #e11d48; font-size: .68rem; font-weight: 900;
        border-radius: 999px; padding: .14rem .5rem; border: 1px solid #fecdd3; }


    .management-alert:last-child {
        margin-bottom: 0;
    }


    .alert-status-dot {
        width: 9px;
        height: 9px;

        flex: 0 0 9px;

        border-radius: 50%;
    }


    .alert-text {
        min-width: 0;
    }


    .alert-text strong {
        display: block;

        color: #24334a;

        font-size: 9px;

        font-weight: 800;
    }


    .alert-text small {
        display: block;

        margin-top: 1px;

        color: #7e8b9f;

        font-size: 8px;
    }




    /* 🏆 المؤشر العام — نتيجة الأداء التسويقي
       ================================================================
       جاج نصف دائرة (أكبر من جاجات التارجيت) + دليل متدرج + تفصيل كبطاقات */

    .score-card {
        display: block;
    }

    .score-content {
        display: grid;
        grid-template-columns: 320px minmax(0, 1fr);
        gap: 22px 32px;
        align-items: start;
        padding: 14px 18px 20px;
    }

    /* ---- خلية الجاج (نصف دائرة ApexCharts كبيرة) ---- */
    .score-gauge-cell {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        min-width: 0;
    }

    .score-gauge-chart {
        width: 100%;
        min-height: 250px;

        display: flex;
        align-items: center;
        justify-content: center;
    }

    .score-gauge-under {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        width: 100%;
        margin-top: -30px;
    }

    .score-label-new {
        font-size: 17px;
        font-weight: 800;
        padding: 4px 16px;
        border-radius: 20px;
        background: #edf5ff;
        color: #1c6fe0;
    }

    .score-label-new.score-excellent { background: #e7f6ef; color: #0f8a52; }
    .score-label-new.score-vgood     { background: #ecf7e3; color: #3f9338; }
    .score-label-new.score-good      { background: #f3f8dc; color: #6f9e1c; }
    .score-label-new.score-needs     { background: #fff4de; color: #c07f12; }
    .score-label-new.score-poor      { background: #fdecee; color: #cf3344; }

    .score-cap-note {
        font-size: 12.5px;
        color: #b45309;
        background: #fff7e6;
        border: 1px solid #fcd34d;
        padding: 7px 12px;
        border-radius: 10px;
        line-height: 1.55;
        text-align: center;
        width: 100%;
    }

    /* ---- دليل النتيجة: شريط متدرج + مؤشر موضع ---- */
    .score-guide {
        display: flex;
        flex-direction: column;
        gap: 13px;
        min-width: 0;
        padding-top: 12px;
    }

    .score-guide-title {
        display: flex;
        flex-direction: column;
        gap: 3px;
        font-size: 14px;
        font-weight: 800;
        color: #17233a;
    }

    .score-guide-title small {
        font-weight: 500;
        color: #7c8799;
        font-size: 11.5px;
    }

    .sg-track {
        position: relative;
        height: 14px;
        border-radius: 9px;
        background: linear-gradient(90deg,
            #ef4444 0%,
            #f59e0b 40%,
            #fbbf24 50%,
            #84cc16 68%,
            #16a34a 100%);
    }

    .sg-marker {
        position: absolute;
        top: -6px;
        transform: translateX(-50%);
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: #ffffff;
        border: 3px solid #17233a;
        box-shadow: 0 3px 8px rgba(15, 23, 42, 0.35);
        z-index: 2;
        pointer-events: none;
    }

    .sg-labels {
        display: flex;
        justify-content: space-between;
        color: #7c8799;
        font-size: 11.5px;
        font-weight: 600;
        text-align: center;
        gap: 2px;
    }

    .sg-labels span {
        white-space: nowrap;
    }

    /* ---- تفصيل الحساب (بطاقات صغيرة متناسقة) ---- */
    .score-components {
        grid-column: 1 / -1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding-top: 6px;
    }

    .score-components-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .score-components-head h4 {
