@code {

    /* ================================================================
       STATE
       ================================================================ */

    private MarketingDashboardDto? _data;

    private bool _isLoading = true;

    private bool _isRefreshing;

    private bool _noAccess;

    private string? _loadError;

    private int _period = 30;

    private DateTime _dateFrom =
        new(
            DateTime.Today.Year,
            DateTime.Today.Month,
            1
        );

    private DateTime _dateTo = DateTime.Today;

    private string _channel = "all";

    private int _campaignTab;

    private bool _funnelRendered;


    /* ================================================================
       CHANNELS (من جدول المصادر — فيسبوك/انستجرام/واتساب/Traffic/أخرى)
       ================================================================ */

    private static readonly
        (string Key, string Name)[] _channels =
    {
        ("all", "الكل"),
        ("fb", "فيسبوك"),
        ("ig", "انستجرام"),
        ("whatsapp", "واتساب"),
        ("traffic", "Traffic"),
        ("other", "أخرى")
    };


    /* ================================================================
       INITIALIZATION
       ================================================================ */

    protected override async Task OnInitializedAsync()
    {
        var auth =
            await AuthProvider.GetAuthenticationStateAsync();

        var user = auth.User;

        if (!(
            user.IsInRole("Admin") ||
            user.IsInRole("GeneralManager") ||
            user.IsInRole("SalesManager") ||
            user.IsInRole("SocialManager") ||
            user.IsInRole("SocialView")
        ))
        {
            _noAccess = true;

            _isLoading = false;

            return;
        }

        await LoadData();
    }


    /* ================================================================
       LOAD DATA
       ================================================================ */

    private async Task LoadData(bool silent = false)
    {
        if (_dateFrom > _dateTo)
        {
            Snackbar.Add(
                "تاريخ البداية أكبر من تاريخ النهاية",
                MudBlazor.Severity.Warning
            );

            return;
        }


        if (silent && _data is not null)
        {
            _isRefreshing = true;
        }
        else
        {
            _isLoading = true;

            _loadError = null;
        }


        StateHasChanged();


        try
        {
            _data =
                await MarketingService.GetDashboardAsync(
                    _dateFrom,
                    _dateTo,
                    _channel
                );

            // تحديث الفانل والجاجات بالبيانات الجديدة (لو اترسموا قبل كده)
            if (_funnelRendered)
            {
                await UpdateFunnel();
                await UpdateGauges();
            }
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;

            Snackbar.Add(
                $"خطأ في تحميل البيانات: {ex.Message}",
                MudBlazor.Severity.Error
            );
        }
        finally
        {
            _isLoading = false;

            _isRefreshing = false;

            StateHasChanged();
        }
    }


    /* ================================================================
       PERIOD
       ================================================================ */

    private void SetPeriod(int days)
    {
        _period = days;

        var today = DateTime.Today;

        _dateTo = today;


        _dateFrom = days switch
        {
            1 =>
                today,

            7 =>
                today.AddDays(-6),

            30 =>
                new DateTime(
                    today.Year,
                    today.Month,
                    1
                ),

            90 =>
                new DateTime(
                    today.Year,
                    today.Month,
                    1
                ).AddMonths(-2),

            365 =>
                new DateTime(
                    today.Year,
                    today.Month,
                    1
                ).AddMonths(-11),

            _ =>
                _dateFrom
        };


        _ = LoadData(true);
    }


    /* ================================================================
       CUSTOM DATE
       ================================================================ */

    private void ReloadCustomDate()
    {
        if (_period == 0)
        {
            _ = LoadData(true);
        }
    }


    /* ================================================================
