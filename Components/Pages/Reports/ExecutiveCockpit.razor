@page "/executive-cockpit"

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using ApexCharts
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size
@using Align = MudBlazor.Align
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize]
@implements IDisposable

@inject IExecutiveCockpitService CockpitService
@inject IBranchService BranchService
@inject ExecutiveCockpitSnapshotService SnapshotService
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>لوحة القيادة التنفيذية</PageTitle>

@if (_loading)
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
        <MudStack AlignItems="AlignItems.Center" Spacing="3" Style="min-height:300px; justify-content:center;">
            <MudProgressCircular Indeterminate="true" Color="Color.Warning" Size="Size.Large" />
            <MudText Typo="Typo.body1" Color="Color.Secondary">جارٍ تجهيز لوحة القيادة التنفيذية...</MudText>
        </MudStack>
    </MudContainer>
}
else if (_noAccess)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
            ليس لديك صلاحية للدخول — هذه الشاشة لرئيس مجلس الإدارة (Admin) أو بإذن «لوحة القيادة التنفيذية».
        </MudAlert>
    </MudContainer>
}
else if (_data != null)
{
<div class="ec-root">
    <div class="ec-wrap">

        @* ══ Hero ══ *@
        <div class="ec-hero">
            <div class="ec-hero-side">
                <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Class="ec-crown" Color="Color.Warning" />
                <div>
                    <h1>لوحة القيادة التنفيذية</h1>
                    <div class="ec-hero-sub">بيانات لحظية من النظام · آخر تحديث @_data.GeneratedAt.ToString("yyyy/MM/dd hh:mm tt")@(_data.BranchId != null ? $" · فرع {_data.BranchName}" : "")@if (_refreshing) { <text> · جارٍ التحديث…</text> }</div>
                </div>
            </div>
            <div class="ec-ptabs">
                @foreach (var p in _periods)
                {
                    <button class="ec-ptab @(_period == p.Key ? "on" : "")" @onclick="() => SetPeriodAsync(p.Key)">@p.Value</button>
                }
            </div>
        </div>

        @* ══ شريط الأدوات — مرحلة 3: فرع/فترة مخصصة/تحديث/طباعة/لقطات ══ *@
        <div class="ec-toolbar">
            <div class="ec-tgroup">
                <MudSelect T="int?" Value="_branchId" ValueChanged="SetBranchAsync"
                           Placeholder="🏬 كل الفروع" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Clearable="true" ClearText="كل الفروع" Style="min-width:190px;">
                    <MudSelectItem T="int?" Value="null">🏬 كل الفروع</MudSelectItem>
                    @foreach (var b in _branches)
                    {
                        <MudSelectItem T="int?" Value="@((int?)b.BranchId)">@b.BranchNameAr</MudSelectItem>
                    }
                </MudSelect>
                @if (_period == "custom")
                {
                    <MudDatePicker @bind-Date="_customFrom" @bind-Date:after="ApplyCustomAsync" Label="من"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:175px;" />
                    <MudDatePicker @bind-Date="_customTo" @bind-Date:after="ApplyCustomAsync" Label="إلى"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:175px;" />
                }
            </div>
            <div class="ec-tgroup">
                <MudSwitch T="bool" @bind-Value="_autoRefresh" Color="Color.Warning" Label="تحديث تلقائي (5 دقائق)" />
                <button class="ec-tbtn" @onclick="ManualRefreshAsync" disabled="@_refreshing">⟳ تحديث الآن</button>
                <a class="ec-tbtn" href="@PrintUrl()" target="_blank">🖨️ نسخة مجلس إدارة</a>
                <button class="ec-tbtn" @onclick="SaveSnapshotAsync">📸 حفظ لقطة</button>
                <button class="ec-tbtn" @onclick="OpenSnapshotsAsync">اللقطات المحفوظة</button>
            </div>
        </div>

        @* ══ القصة ══ *@
        <div class="ec-story">
            <MudIcon Icon="@Icons.Material.Filled.Bolt" Color="Color.Warning" Style="font-size:1.5rem;" />
            <div style="flex:1;">@_data.Story</div>
            @if (_data.DecisionsPending > 0)
            {
                <button class="ec-act" @onclick="OpenDecisions">@_data.DecisionsPending بند في انتظارك <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Style="font-size:.9rem; vertical-align:-2px;" /></button>
            }
        </div>

        @* ══ تنبيه صريح: أقسام لا يدعم بياناتها فلتر الفرع ══ *@
        @if (_data.BranchId != null && _data.BranchIgnoredSections.Count > 0)
        {
            <div class="ec-branch-note">
                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" Style="font-size:1rem; vertical-align:-2px;" />
                فرع «@_data.BranchName» مختار — كل الأرقام للفرع إلا: @BranchIgnoredText() (بياناتها في النظام بلا إسناد لفرع، فتظهر بإجمالي الشركة).
            </div>
        }

        @* ══ الاستثناءات — مباشرة تحت القصة (أ7) ══ *@
        <div class="sec-h"><span class="dot"></span> استثناءات تحتاج قرارك</div>
        @if (SectionFailed("exceptions"))
        {
            <div class="ec-fail">تعذّر تحميل هذا القسم</div>
        }
        else
        {
        <div class="ec-exc mb-4">
            <div class="ec-exc-card red" @onclick="@(() => Nav.NavigateTo("/sales/invoices"))">
                <div class="n">@_data.Exceptions.Debts30</div>
                <div class="t">مديونات +30 يوم<br>@_data.Exceptions.Debts30Amount.ToString("N0") ج — قائمة فواتير البيع</div>
            </div>
            <div class="ec-exc-card red" @onclick="@(() => Nav.NavigateTo("/sales-delivery-status"))">
                <div class="n">@_data.Exceptions.LateDeliveries</div>
                <div class="t">تسليم متأخر<br>عن موعده</div>
            </div>
            <div class="ec-exc-card yellow" @onclick="@(() => Nav.NavigateTo("/sales/price-requests"))">
                <div class="n">@_data.Exceptions.PendingPrice</div>
                <div class="t">طلبات أسعار<br>معلقة</div>
            </div>
            <div class="ec-exc-card yellow" @onclick="@(() => Nav.NavigateTo("/products"))">
                <div class="n">@_data.Exceptions.NegativeStock</div>
                <div class="t">أصناف برصيد سالب<br>— شاشة المنتجات والمخزون</div>
            </div>
            <div class="ec-exc-card blue" @onclick="@(() => Nav.NavigateTo("/crm/leads/dashboard"))">
                <div class="n">@_data.Exceptions.StalledLeads</div>
                <div class="t">Lead بلا متابعة<br>+10 أيام</div>
            </div>
            <div class="ec-exc-card blue" @onclick="@(() => Nav.NavigateTo("/complaints/list"))">
                <div class="n">@_data.Exceptions.OpenComplaints</div>
                <div class="t">شكاوى عملاء<br>مفتوحة</div>
            </div>
        </div>
        }

        @* ══ تنبيه الموظفين المتوقفين ══ *@
        @if (DormantEmployees().Count > 0)
        {
            <div class="ec-dormant">
                <div class="ec-dormant-head">
                    <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Color="Color.Error" Style="font-size:1.4rem;" />
                    <b>موظفون ساكنون يحتاجون قرارًا (@DormantEmployees().Count)</b>
                    <small>بلا أي إجراء في النظام منذ 3 أيام أو أكثر</small>
                </div>
                <div class="ec-dormant-list">
                    @foreach (var e in DormantEmployees())
                    {
                        <div class="ec-dormant-item" @onclick="() => OpenTimelineAsync(e.EmployeeId)">
                            <span class="ec-avatar">@(e.FullName.FirstOrDefault())</span>
                            <div>
                                <b>@e.FullName</b>
                                <div class="ec-dormant-meta">@e.JobTitle · آخر نشاط: @e.LastActivityText · حضور: @e.Attendance</div>
                            </div>
                            <span class="ec-dormant-go">الخط الزمني <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Style="font-size:.8rem; vertical-align:-2px;" /></span>
                        </div>
                    }
                </div>
            </div>
        }

        @* ══ 1) نبض الشركة ══ *@
        <div class="sec-h"><span class="dot"></span> نبض الشركة — @_data.PeriodLabel <small>مقارنة بنفس الأيام المنقضية من الفترة السابقة ونفس الفترة سنويًا · اضغط أي كارت للتفاصيل</small></div>
        @if (SectionFailed("kpis"))
        {
            <div class="ec-fail">تعذّر تحميل هذا القسم</div>
        }
        else
        {
        <div class="ec-kpis">
            @foreach (var k in KpiCards())
            {
                <div class="ec-kpi @(string.IsNullOrEmpty(k.Route) ? "" : "ec-kpi-click")" @onclick="() => GoKpi(k.Route)">
                    <div class="lab"><MudIcon Icon="@k.Icon" Color="Color.Warning" Style="font-size:1rem; vertical-align:-3px;" /> @k.Label</div>
                    <div class="val">@k.Value.ToString("N0") <small>ج</small></div>
                    @if (!string.IsNullOrEmpty(k.Sub))
                    {
                        <div class="ec-kpi-sub">@k.Sub</div>
                    }
                    @if (k.ShowCmp)
                    {
                        <div class="cmps">
                            @CmpChip(k.PrevPct, k.Invert, "عن السابق")
                            @CmpChip(k.YearPct, k.Invert, "سنويًا")
                        </div>
                    }
                    else
                    {
                        <div class="cmps"><span class="ec-cmp ec-flat">الرصيد اللحظي لكل الخزن</span></div>
                    }
                </div>
            }
        </div>
        }
        @if (SectionFailed("profit"))
        {
            <div class="ec-fail">تعذّر تحميل الربحية (قائمة الدخل) لهذه الفترة</div>
        }

        @* ══ 1ب) أعمار الذمم والمستحقات ══ *@
        <div class="sec-h"><span class="dot"></span> أعمار الذمم والمستحقات <small>— الرصيد المفتوح حسب تاريخ الاستحقاق (الاستحقاق أو تاريخ الفاتورة)</small></div>
        @if (SectionFailed("aging"))
        {
            <div class="ec-fail">تعذّر تحميل هذا القسم</div>
        }
        else
        {
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="12" md="8">
                <div class="ec-card">
                    <div class="ec-age-head">ذمم العملاء — إجمالي مفتوح <b>@_data.Aging.TotalReceivables.ToString("N0") ج</b></div>
                    <div class="ec-ages">
                        @foreach (var b in _data.Aging.Receivables)
                        {
                            <div class="ec-age"><div class="a-lab">@b.Label</div><div class="a-val">@b.Amount.ToString("N0")</div><div class="a-cnt">@b.Count فاتورة</div></div>
                        }
                    </div>
                    <div class="ec-age-head" style="margin-top:14px;">مستحقات الموردين — إجمالي مفتوح <b>@_data.Aging.TotalPayables.ToString("N0") ج</b> <small>(مشتريات حقيقية فقط، بلا مرآة)</small></div>
                    <div class="ec-ages">
                        @foreach (var b in _data.Aging.Payables)
                        {
                            <div class="ec-age"><div class="a-lab">@b.Label</div><div class="a-val">@b.Amount.ToString("N0")</div><div class="a-cnt">@b.Count فاتورة</div></div>
                        }
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" md="4">
                <div class="ec-card" style="height:100%;">
                    <div class="ec-age-head"><MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Warning" Style="font-size:1rem; vertical-align:-2px;" /> أكبر المدينين</div>
                    @foreach (var d in _data.Aging.TopDebtors)
                    {
                        <div class="ec-gm-row"><span>@d.Name</span><b style="color:#DC2626;">@d.Amount.ToString("N0") ج</b></div>
                    }
                    @if (_data.Aging.TopDebtors.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Style="color:#64748B;">لا مديونيات مفتوحة</MudText>
                    }
                </div>
            </MudItem>
        </MudGrid>
        }

        @* ══ 1ج) قائمة دخل مصغرة ══ *@
        <div class="sec-h"><span class="dot"></span> الربحية — قائمة دخل مصغرة <small>— نفس أرقام قائمة الدخل لـ @_data.PeriodLabel · اضغط للفتح</small></div>
        @if (!_data.MiniPl.Loaded)
        {
            <div class="ec-fail">تعذّر تحميل هذا القسم</div>
        }
        else
        {
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="12" md="7">
                <div class="ec-card" style="cursor:pointer; height:100%;" @onclick="@(() => Nav.NavigateTo("/reports/income-statement"))">
                    <div class="ec-gm-row"><span>صافي الإيراد</span><b>@_data.MiniPl.NetRevenue.ToString("N0") ج</b></div>
                    <div class="ec-gm-row"><span>تكلفة المبيعات (COGS)</span><b>@_data.MiniPl.Cogs.ToString("N0") ج</b></div>
                    <div class="ec-gm-row"><span>مجمل الربح</span><b style="color:#059669;">@_data.MiniPl.GrossProfit.ToString("N0") ج · هامش @_data.MiniPl.GrossProfitMargin%</b></div>
                    <div class="ec-gm-row"><span>مصروفات التشغيل (منها رواتب @_data.MiniPl.PayrollExpense.ToString("N0") ج)</span><b>@_data.MiniPl.OperatingExpenses.ToString("N0") ج</b></div>
                    <div class="ec-gm-row"><span>صافي الربح</span><b style="color:@(_data.MiniPl.NetProfit >= 0 ? "#1E293B" : "#DC2626"); font-size:1.02rem;">@_data.MiniPl.NetProfit.ToString("N0") ج · هامش @_data.MiniPl.NetProfitMargin%</b></div>
                </div>
            </MudItem>
            <MudItem xs="12" md="5">
                <div class="ec-card" style="height:100%;">
                    <div class="ec-age-head"><MudIcon Icon="@Icons.Material.Filled.Flag" Color="Color.Warning" Style="font-size:1rem; vertical-align:-2px;" /> هدف هامش الربح</div>
                    <div class="ec-gm-row"><span>الهامش الحالي</span><b>@_data.MiniPl.NetProfitMargin%</b></div>
                    <div class="ec-gm-row"><span>الهدف الحالي / التالي</span><b>@_data.MiniPl.TargetMarginPct% / @_data.MiniPl.NextTargetMarginPct%</b></div>
                    <div class="ec-lb-bar" style="margin:10px 0 6px;"><i style="width:@((int)Math.Clamp(_data.MiniPl.TargetAchievementPct, 0, 100))%; background:linear-gradient(90deg,#d4af37,#E8C855);"></i></div>
                    <MudText Typo="Typo.body2">تحقيق الهدف: <b>@_data.MiniPl.TargetAchievementPct%</b> — @_data.MiniPl.TargetStatus</MudText>
                    <MudText Typo="Typo.caption" Style="color:#64748B;">@_data.MiniPl.TargetMessage</MudText>
                </div>
            </MudItem>
        </MudGrid>
        }

        @* ══ 2) بايبلاين الفرص وB2B ══ *@
        @if (SectionFailed("pipeline"))
        {
            <div class="ec-fail">تعذّر تحميل هذا القسم</div>
        }
        else
        {
        <div class="ec-pipe">
            <div class="ec-pipe-card" @onclick="@(() => Nav.NavigateTo("/crm/opportunities"))">
                <div class="n">@_data.PipelineOpen</div>
                <div class="t"><MudIcon Icon="@Icons.Material.Filled.BusinessCenter" Style="font-size:.9rem; vertical-align:-2px;" /> فرصة بيعية مفتوحة</div>
            </div>
            <div class="ec-pipe-card" @onclick="@(() => Nav.NavigateTo("/crm/opportunities"))">
                <div class="n">@_data.PipelineValue.ToString("N0") <small>ج</small></div>
                <div class="t"><MudIcon Icon="@Icons.Material.Filled.Paid" Style="font-size:.9rem; vertical-align:-2px;" /> قيمتها المتوقعة</div>
            </div>
            <div class="ec-pipe-card @( _data.PipelineStalled > 0 ? "warn" : "")" @onclick="@(() => Nav.NavigateTo("/crm/opportunities"))">
                <div class="n">@_data.PipelineStalled</div>
                <div class="t"><MudIcon Icon="@Icons.Material.Filled.Schedule" Style="font-size:.9rem; vertical-align:-2px;" /> متابعة متأخرة على فرص</div>
            </div>
            <div class="ec-pipe-card @(_data.B2bPending > 0 ? "warn" : "")" @onclick="@(() => Nav.NavigateTo("/admin/b2b/requests"))">
                <div class="n">@_data.B2bPending</div>
                <div class="t"><MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Style="font-size:.9rem; vertical-align:-2px;" /> طلبات B2B جديدة/قيد المراجعة</div>
            </div>
        </div>
        }

        @* ══ 2ب) عروض الأسعار — مرحلة 2 ══ *@
        <div class="sec-h"><span class="dot"></span> عروض الأسعار — خط مبيعات الغد <small>— عروض @_data.PeriodLabel بحالتها الحالية · اضغط للفتح</small></div>
        @if (SectionFailed("quotations"))
        {
            <div class="ec-fail">تعذّر تحميل هذا القسم</div>
        }
        else
        {
        <div class="ec-card mb-3" style="cursor:pointer;" @onclick="@(() => Nav.NavigateTo("/quotations"))">
            <div class="ec-qgrid">
                @foreach (var s in _data.Quotations.ByStatus)
                {
                    <div class="ec-age"><div class="a-lab">@s.Label</div><div class="a-val">@s.Count</div><div class="a-cnt">@s.Value.ToString("N0") ج</div></div>
                }
            </div>
            <MudGrid Spacing="2" Class="mt-2">
                <MudItem xs="6" md="3">
                    <div class="ec-gm-row"><span>معدل التحويل لفاتورة (من المحسومة)</span><b style="color:#059669;">@(_data.Quotations.HasDecided ? _data.Quotations.ConversionRate + "%" : "—")</b></div>
                    <div class="ec-lb-sub">@_data.Quotations.ConvertedCount عرض تحوّل من @_data.Quotations.PeriodCount عرضًا في الفترة</div>
                </MudItem>
                <MudItem xs="6" md="3">
                    <div class="ec-gm-row"><span>بانتظار رد العميل (مرسلة الآن)</span><b>@_data.Quotations.SentCount</b></div>
                    <div class="ec-lb-sub">بقيمة @_data.Quotations.SentValue.ToString("N0") ج</div>
                </MudItem>
                <MudItem xs="6" md="3">
                    <div class="ec-gm-row"><span>مقبولة ولم تُحوَّل بعد</span><b style="color:@(_data.Quotations.AcceptedNotConvertedCount > 0 ? "#D97706" : "inherit")">@_data.Quotations.AcceptedNotConvertedCount</b></div>
                    <div class="ec-lb-sub">بقيمة @_data.Quotations.AcceptedNotConvertedValue.ToString("N0") ج — مبيعات مؤكدة لم تُفوتر</div>
                </MudItem>
                <MudItem xs="6" md="3">
                    <div class="ec-gm-row"><span>تنتهي صلاحيتها خلال 7 أيام</span><b style="color:@(_data.Quotations.ExpiringSoonCount > 0 ? "#DC2626" : "inherit")">@_data.Quotations.ExpiringSoonCount</b></div>
                    <div class="ec-lb-sub">عروض مرسلة تحتاج متابعة قبل الانتهاء</div>
                </MudItem>
            </MudGrid>
        </div>
        }

        @* ══ 3) الاتجاهات + التوقع ══ *@
        <div class="sec-h"><span class="dot"></span> الاتجاهات والتوقعات <small>— 12 شهر (مبيعات ومشتريات صافية بعد المرتجعات، والمشتريات بلا مرآة)</small></div>
        @if (SectionFailed("trend"))
        {
            <div class="ec-fail">تعذّر تحميل هذا القسم</div>
        }
        else
        {
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="12" md="8">
                <div class="ec-card">
                    <ApexChart TItem="ExecutiveTrendPointDto"
                               Options="_trendOpts"
                               Height="300"
                               Width="@("100%")">
                        <ApexPointSeries TItem="ExecutiveTrendPointDto" Items="_data.Trend"
                                         Name="المبيعات" SeriesType="SeriesType.Area"
                                         XValue="@(d => d.Label)" YValue="@(d => (decimal?)d.Sales)" />
                        <ApexPointSeries TItem="ExecutiveTrendPointDto" Items="_data.Trend"
                                         Name="التحصيلات" SeriesType="SeriesType.Area"
                                         XValue="@(d => d.Label)" YValue="@(d => (decimal?)d.Collected)" />
                        <ApexPointSeries TItem="ExecutiveTrendPointDto" Items="_data.Trend"
                                         Name="المشتريات" SeriesType="SeriesType.Line"
                                         XValue="@(d => d.Label)" YValue="@(d => (decimal?)d.Purchases)" />
                    </ApexChart>
                </div>
            </MudItem>
            <MudItem xs="12" md="4">
                <div class="ec-card ec-center" style="height:100%;">
                    <MudText Typo="Typo.subtitle2" Style="color:#64748B;"><MudIcon Icon="@Icons.Material.Filled.Insights" Color="Color.Warning" Style="font-size:1rem; vertical-align:-2px;" /> توقع إقفال الشهر الحالي</MudText>
                    <svg width="190" height="108" viewBox="0 0 190 108">
                        <path d="M 20 100 A 75 75 0 0 1 170 100" pathLength="100" fill="none" stroke="#E3E8EF" stroke-width="14" stroke-linecap="round" />
                        @if (GaugeFill() > 0)
                        {
                            <path d="M 20 100 A 75 75 0 0 1 170 100" pathLength="100" fill="none" stroke="@GaugeColor()" stroke-width="14" stroke-linecap="round" stroke-dasharray="@GaugeDash()" />
                        }
                    </svg>
                    <div class="ec-gauge-pct" dir="ltr" style="color:@GaugeColor(); unicode-bidi:isolate;">@ForecastPctDisplay()</div>
                    <div class="ec-gauge-cap">مقارنة بالشهر الماضي</div>
                    <div class="ec-gauge-num">@_data.ForecastValue.ToString("N0") ج</div>
                    <div class="ec-gauge-sub">على معدل أول @_dayOfMonth يوم — الشهر الماضي @_data.LastMonthSales.ToString("N0") ج</div>
                </div>
            </MudItem>
        </MudGrid>
        }

        @* ══ 3ب) التشغيل: المخزون والإنتاج والتسليمات — مرحلة 2 ══ *@
        <div class="sec-h"><span class="dot"></span> التشغيل — المخزون والإنتاج والتسليمات <small>— المخزون والمتأخرات لقطة حالية، وباقي الأرقام لـ @_data.PeriodLabel · اضغط أي كارت لشاشته</small></div>
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="12" md="4">
                <div class="ec-card" style="cursor:pointer; height:100%;" @onclick="@(() => Nav.NavigateTo("/inventory/stock-value"))">
                    <div class="ec-gm-h"><MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Warning" Style="font-size:.95rem; vertical-align:-2px;" /> المخزون الآن</div>
                    @if (SectionFailed("inventory"))
                    {
                        <MudText Typo="Typo.body2" Style="color:#B45309;">تعذّر تحميل هذا القسم</MudText>
                    }
                    else
                    {
                    <div class="ec-big">@_data.Inventory.TotalCostValue.ToString("N0") <small style="font-size:.65rem; color:#64748B;">ج — قيمة المخزون بالتكلفة</small></div>
                    <div class="ec-gm-row"><span>قيمة البيع المتوقعة</span><b>@_data.Inventory.TotalSaleValue.ToString("N0") ج</b></div>
                    <div class="ec-gm-row"><span>أصناف / إجمالي كمية</span><b>@_data.Inventory.ProductsCount / @_data.Inventory.TotalQuantity.ToString("N0")</b></div>
                    <div class="ec-gm-row"><span>أصناف نافدة (رصيد ≤ 0)</span><b style="color:@(_data.Inventory.OutOfStockCount > 0 ? "#DC2626" : "inherit")">@_data.Inventory.OutOfStockCount</b></div>
                    <div class="ec-gm-row"><span>منخفضة (1–5 وحدات)</span><b style="color:@(_data.Inventory.LowStockCount > 0 ? "#D97706" : "inherit")">@_data.Inventory.LowStockCount</b></div>
                    <div class="ec-gm-row"><span>راكدة بلا حركة 90 يومًا</span><b>@_data.Inventory.DeadStockCount صنف — @_data.Inventory.DeadStockValue.ToString("N0") ج مجمّدة</b></div>
                    @foreach (var p in _data.Inventory.TopValueProducts.Take(3))
                    {
                        <div class="ec-gm-row"><span>@p.Name</span><b>@p.Value.ToString("N0") ج</b></div>
                    }
                    @if (_data.Inventory.Warehouses.Count > 0)
                    {
                        <div style="border-top:1px solid #E2E8F0; margin-top:8px; padding-top:8px;">
                            <div style="font-size:.72rem; font-weight:700; color:#64748B; margin-bottom:2px;">القيمة حسب المخزن — بالتكلفة</div>
                            @foreach (var w in _data.Inventory.Warehouses)
                            {
                                <div style="margin-bottom:5px;">
                                    <div class="ec-gm-row">
                                        <span>@w.WarehouseName <small style="color:#64748B;">(@w.ProductsCount صنف)</small></span>
                                        <b>@w.CostValue.ToString("N0") ج · <span dir="ltr" style="unicode-bidi:isolate;">@w.SharePct.ToString("0.#")%</span></b>
                                    </div>
                                    <div class="ec-lb-bar"><i style="width:@((int)Math.Clamp(w.SharePct, 0, 100))%; background:linear-gradient(90deg,#d4af37,#E8C855);"></i></div>
                                </div>
                            }
                        </div>
                    }
                    }
                </div>
            </MudItem>
            <MudItem xs="12" md="4">
                <div class="ec-card" style="cursor:pointer; height:100%;" @onclick="@(() => Nav.NavigateTo("/production/job-orders"))">
                    <div class="ec-gm-h"><MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Color="Color.Info" Style="font-size:.95rem; vertical-align:-2px;" /> أوامر التشغيل والإنتاج</div>
                    @if (SectionFailed("joborders"))
                    {
                        <MudText Typo="Typo.body2" Style="color:#B45309;">تعذّر تحميل هذا القسم</MudText>
                    }
                    else
                    {
                    <div class="ec-big">@_data.JobOrders.OpenCount <small style="font-size:.65rem; color:#64748B;">أمر مفتوح (بيع @_data.JobOrders.OpenSale · توريد @_data.JobOrders.OpenPurchase)</small></div>
                    <div class="ec-gm-row"><span>متأخرة عن موعد التسليم</span><b style="color:@(_data.JobOrders.OverdueCount > 0 ? "#DC2626" : "inherit")">@_data.JobOrders.OverdueCount — @_data.JobOrders.OverdueValue.ToString("N0") ج</b></div>
                    <div class="ec-gm-row"><span>بها بدائل مختارة</span><b>@_data.JobOrders.WithAlternativesCount</b></div>
                    <div class="ec-gm-row"><span>سُلّمت في الفترة</span><b style="color:#059669;">@_data.JobOrders.DeliveredInPeriod</b></div>
                    }
                </div>
            </MudItem>
            <MudItem xs="12" md="4">
                <div class="ec-card" style="cursor:pointer; height:100%;" @onclick="@(() => Nav.NavigateTo("/sales-delivery-status"))">
                    <div class="ec-gm-h"><MudIcon Icon="@Icons.Material.Filled.LocalShipping" Color="Color.Success" Style="font-size:.95rem; vertical-align:-2px;" /> التسليمات والالتزام بالمواعيد</div>
                    @if (SectionFailed("deliveries"))
                    {
                        <MudText Typo="Typo.body2" Style="color:#B45309;">تعذّر تحميل هذا القسم</MudText>
                    }
                    else
                    {
                    <div class="ec-big" style="color:@(_data.Deliveries.OnTimePct >= 85 ? "#059669" : _data.Deliveries.OnTimePct >= 60 ? "#D97706" : "#DC2626");">@(_data.Deliveries.HasDelivered ? _data.Deliveries.OnTimePct + "%" : "—") <small style="font-size:.65rem; color:#64748B;">التزام بالمواعيد — من المُسلَّمة فعليًا</small></div>
                    <div class="ec-gm-row"><span>مخطط / سُلّم (في الموعد · متأخر)</span><b>@_data.Deliveries.Planned / @_data.Deliveries.Delivered (@_data.Deliveries.OnTime · @_data.Deliveries.Late)</b></div>
                    <div class="ec-gm-row"><span>معلّقة من مخطط الفترة</span><b>@_data.Deliveries.Pending</b></div>
                    <div class="ec-gm-row"><span>لم تُسلّم / جزئي (من مخطط الفترة)</span><b>@_data.Deliveries.NotDeliveredInPeriod / @_data.Deliveries.PartialInPeriod</b></div>
                    <div class="ec-gm-row"><span>جزئي مفتوح الآن</span><b>@_data.Deliveries.PartialOpenNow</b></div>
                    <div class="ec-gm-row"><span>دقة الدفعات — في موعدها</span><b>@(_data.Deliveries.HasBatchEvents ? $"{_data.Deliveries.BatchPunctualityPct}% ({_data.Deliveries.BatchOnTimeEvents}/{_data.Deliveries.BatchEventsInPeriod})" : "—")</b></div>
                    <div class="ec-gm-row"><span>مرتجعة في الفترة</span><b>@_data.Deliveries.ReturnedInPeriod</b></div>
                    <div class="ec-gm-row"><span>تسليمات بملاحظات في الفترة</span><b>@_data.Deliveries.EventsWithRemarksInPeriod</b></div>
                    <div class="ec-gm-row"><span>رجوع عيب تصنيع / تلف مناولة (كمية)</span><b>@_data.Deliveries.ManufacturingDefectQtyInPeriod.ToString("0.###") / @_data.Deliveries.HandlingDamageQtyInPeriod.ToString("0.###")</b></div>
                    <div class="ec-gm-row"><span>في الصيانة الآن (سجل · كمية · أقدم)</span><b>@_data.Deliveries.MaintenanceBacklogRecords · @_data.Deliveries.MaintenanceBacklogQty.ToString("0.###") · @(_data.Deliveries.MaintenanceOldestAgeDays.HasValue ? _data.Deliveries.MaintenanceOldestAgeDays.Value + " يوم" : "—")</b></div>
                    <div class="ec-gm-row"><span>رسوم تعديل: بانتظار الاعتماد / معتمدة غير محصّلة</span><b>@_data.Deliveries.PendingModificationChargesCount / @_data.Deliveries.ApprovedUncollectedModificationAmount.ToString("N0") ج</b></div>
                    <div class="ec-gm-row"><span>تكلفة إصلاح داخلية في الفترة</span><b>@_data.Deliveries.RepairCostInPeriod.ToString("N0") ج</b></div>
                    <div class="ec-gm-row"><span>متأخرة الآن</span><b style="color:@(_data.Deliveries.OverdueNow > 0 ? "#DC2626" : "inherit")">@_data.Deliveries.OverdueNow — @_data.Deliveries.OverdueAmount.ToString("N0") ج</b></div>
                    <div class="ec-gm-row"><span>مستحقة اليوم / غدًا</span><b>@_data.Deliveries.DueToday / @_data.Deliveries.DueTomorrow</b></div>
                    }
                </div>
            </MudItem>
            <MudItem xs="12" md="4">
                <div class="ec-card" style="cursor:pointer; height:100%;" @onclick="@(() => Nav.NavigateTo("/crm/general-tasks"))">
                    <div class="ec-gm-h"><MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Warning" Style="font-size:.95rem; vertical-align:-2px;" /> التكليفات العامة</div>
                    @if (SectionFailed("generaltasks"))
                    {
                        <MudText Typo="Typo.body2" Style="color:#B45309;">تعذّر تحميل هذا القسم</MudText>
                    }
                    else
                    {
                    <div class="ec-big" style="color:@(_data.GeneralTasks.OverdueTotal > 0 ? "#DC2626" : "#059669");">@_data.GeneralTasks.OverdueTotal <small style="font-size:.65rem; color:#64748B;">تكليف متأخر الآن — من @_data.GeneralTasks.OpenTotal مفتوح</small></div>
                    <div class="ec-gm-row"><span>قيد التنفيذ</span><b>@_data.GeneralTasks.InProgressTotal</b></div>
                    <div class="ec-gm-row"><span>مرتجعة بانتظار قرار</span><b style="color:@(_data.GeneralTasks.ReturnedPendingTotal > 0 ? "#D97706" : "inherit")">@_data.GeneralTasks.ReturnedPendingTotal</b></div>
                    <div class="ec-gm-row"><span>أُنجزت في الفترة / أُلغيت</span><b style="color:#059669;">@_data.GeneralTasks.CompletedInPeriod</b> / <b>@_data.GeneralTasks.CancelledInPeriod</b></div>
                    @foreach (var row in _data.GeneralTasks.TopOverdueEmployees)
                    {
                        <div class="ec-gm-row"><span>⏰ @row.EmployeeName</span><b style="color:#DC2626;">@row.Overdue متأخرة · @row.Open مفتوحة</b></div>
                    }
                    }
                </div>
            </MudItem>
        </MudGrid>

        @* ══ 4) الفروع + الأكثر نشاطًا ══ *@
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="12" md="6">
                <div class="ec-card">
                    <MudText Typo="Typo.subtitle2" Class="mb-2"><MudIcon Icon="@Icons.Material.Filled.Storefront" Color="Color.Info" Style="font-size:1rem; vertical-align:-2px;" /> المبيعات حسب الفرع — @_data.PeriodLabel</MudText>
                    @if (SectionFailed("pipeline"))
                    {
                        <MudText Typo="Typo.body2" Style="color:#B45309;">تعذّر تحميل هذا القسم</MudText>
                    }
                    else if (_data.BranchSales.Count > 0)
                    {
                        <ApexChart TItem="ExecutiveBranchSaleDto" Options="_branchOpts" Height="250" Width="@("100%")">
                            <ApexPointSeries TItem="ExecutiveBranchSaleDto" Items="_data.BranchSales"
                                             Name="مبيعات" SeriesType="SeriesType.Bar"
                                             XValue="@(d => d.Name)" YValue="@(d => (decimal?)d.Value)" />
                        </ApexChart>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Style="color:#64748B;">لا مبيعات مرتبطة بفروع في هذه الفترة</MudText>
                    }
                </div>
            </MudItem>
            <MudItem xs="12" md="6">
                <div class="ec-card">
                    <MudText Typo="Typo.subtitle2" Class="mb-2"><MudIcon Icon="@Icons.Material.Filled.BarChart" Color="Color.Warning" Style="font-size:1rem; vertical-align:-2px;" /> الأكثر إجراءً في النظام (30 يوم)</MudText>
                    <ApexChart TItem="ExecutiveEmployeeRowDto" Options="_actOpts" Height="250" Width="@("100%")">
                        <ApexPointSeries TItem="ExecutiveEmployeeRowDto" Items="TopActive()"
                                         Name="إجراء" SeriesType="SeriesType.Bar"
                                         XValue="@(d => d.FullName)" YValue="@(d => (decimal?)d.ActionsMonth)" />
                    </ApexChart>
                </div>
            </MudItem>
        </MudGrid>

        @* ══ 5) لوحة الشرف ══ *@
        <div class="sec-h"><span class="dot"></span> لوحة الشرف — المبيعات <small>— إنتاج الشهر الحالي</small></div>
        @if (SectionFailed("team"))
        {
            <div class="ec-fail">تعذّر تحميل هذا القسم (الفريق)</div>
        }
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="12" md="6">
                <div class="ec-card">
                    <MudText Typo="Typo.subtitle2" Class="mb-2"><MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" Style="font-size:1rem; vertical-align:-2px;" /> الأعلى إنتاجًا</MudText>
                    @foreach (var (e, i) in TopSales().Select((e, i) => (e, i)))
                    {
                        <div class="ec-lb" @onclick="() => OpenTimelineAsync(e.EmployeeId)">
                            <span class="ec-rank rk@(i + 1)">@(i + 1)</span>
                            <div style="flex:1;">
                                <div class="ec-lb-name">@e.FullName <small>@e.JobTitle</small></div>
                                <div class="ec-lb-bar"><i style="width:@(TopMax() == 0 ? 0 : (int)(e.MonthSales / TopMax() * 100))%; background:linear-gradient(90deg,#d4af37,#E8C855);"></i></div>
                                <div class="ec-lb-sub">تحصيل الشهر: @e.MonthCollection.ToString("N0") ج</div>
                            </div>
                            <b class="ec-lb-val">@e.MonthSales.ToString("N0") ج</b>
                        </div>
                    }
                    @if (TopSales().Count == 0)
                    {
                        <MudText Typo="Typo.body2" Style="color:#64748B;">لا مبيعات بعد هذا الشهر</MudText>
                    }
                </div>
            </MudItem>
            <MudItem xs="12" md="6">
                <div class="ec-card">
                    <MudText Typo="Typo.subtitle2" Class="mb-2"><MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Style="font-size:1rem; vertical-align:-2px;" /> يحتاجون متابعة</MudText>
                    @foreach (var e in BottomSales())
                    {
                        <div class="ec-lb" @onclick="() => OpenTimelineAsync(e.EmployeeId)">
                            <span class="ec-rank rkx"><MudIcon Icon="@(e.MonthSales == 0 ? Icons.Material.Filled.PriorityHigh : Icons.Material.Filled.WarningAmber)" Style="font-size:.95rem;" /></span>
                            <div style="flex:1;">
                                <div class="ec-lb-name">@e.FullName <small>@e.JobTitle</small></div>
                                <div class="ec-lb-bar"><i style="width:@(TopMax() == 0 ? 6 : Math.Max(6, (int)(e.MonthSales / TopMax() * 100)))%; background:linear-gradient(90deg,#FCA5A5,#DC2626);"></i></div>
                                <div class="ec-lb-sub">تحصيل الشهر: @e.MonthCollection.ToString("N0") ج</div>
                            </div>
                            <b class="ec-lb-val" style="color:#DC2626;">@e.MonthSales.ToString("N0") ج</b>
                        </div>
                    }
                    @if (BottomSales().Count == 0)
                    {
                        <MudText Typo="Typo.body2" Style="color:#64748B;">—</MudText>
                    }
                </div>
            </MudItem>
        </MudGrid>

        @* ══ 6) الفريق ══ *@
        <div class="sec-h"><span class="dot"></span> فريق العمل <small>— الحرارة = نشاط 7 أيام · اضغط الصف للخط الزمني</small></div>
        <div class="ec-chips mb-2">
            @foreach (var f in _filters)
            {
                <button class="ec-chip @(_filter == f.Key ? "on" : "")" @onclick="() => SetFilter(f.Key)">
                    <span class="ec-dot dc-@f.Key"></span>@f.Value @if (f.Key == "all") { <text>(@_data.Employees.Count)</text> } @if (f.Key == "red") { <text>(@DormantEmployees().Count)</text> }
                </button>
            }
        </div>
        <div class="ec-card mb-4" style="padding:0; overflow:hidden;">
            <MudTable T="ExecutiveEmployeeRowDto" Items="FilteredEmployees()" Dense="true" Hover="true" Striped="true"
                      Breakpoint="Breakpoint.Sm" Elevation="0" OnRowClick="@(r => OpenTimelineAsync(r.Item.EmployeeId))">
                <HeaderContent>
                    <MudTh>الموظف</MudTh>
                    <MudTh>الوظيفة</MudTh>
                    <MudTh>الحضور اليوم</MudTh>
                    <MudTh>نشاط 7 أيام</MudTh>
                    <MudTh>إجراءات اليوم</MudTh>
                    <MudTh>آخر نشاط</MudTh>
                    <MudTh Style="text-align:end;">إنتاج الشهر</MudTh>
                    <MudTh Style="text-align:end;">تحصيل الشهر</MudTh>
                    <MudTh>المهام (متأخر)</MudTh>
                    <MudTh>الحالة</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="الموظف">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <span class="ec-avatar">@context.FullName.FirstOrDefault()</span>
                            <b>@context.FullName</b>
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="الوظيفة">@context.JobTitle</MudTd>
                    <MudTd DataLabel="الحضور">@context.Attendance</MudTd>
                    <MudTd DataLabel="نشاط 7 أيام">
                        @if (context.Status == "off" || context.Status == "gray")
                        {
                            <span style="color:#64748B;">—</span>
                        }
                        else
                        {
                            <span class="ec-heat">
                                @foreach (var h in context.Heat7)
                                {
                                    <i style="background:@HeatColor(h)"></i>
                                }
                            </span>
                        }
                    </MudTd>
                    <MudTd DataLabel="إجراءات اليوم"><b>@context.ActionsToday</b></MudTd>
                    <MudTd DataLabel="آخر نشاط">
                        <span style="@(context.Status == "red" ? "color:#DC2626; font-weight:700;" : "")">@context.LastActivityText</span>
                    </MudTd>
                    <MudTd DataLabel="إنتاج الشهر" Style="text-align:end;">
                        @if (context.IsSales)
                        {
                            <span>@context.MonthSales.ToString("N0") ج</span>
                        }
                        else
                        {
                            <span style="color:#64748B;">—</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="تحصيل الشهر" Style="text-align:end;">
                        @if (context.IsSales)
                        {
                            <span>@context.MonthCollection.ToString("N0") ج</span>
                        }
                        else
                        {
                            <span style="color:#64748B;">—</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="المهام">
                        @context.TasksPending
                        @if (context.TasksOverdue > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">متأخر @context.TasksOverdue</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="الحالة">
                        <span class="ec-badge @BadgeClass(context.Status)"><i class="bd-dot"></i>@BadgeText(context.Status)</span>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>لا موظفين بهذه الحالة</NoRecordsContent>
            </MudTable>
        </div>

        @* ══ 7) لوحة المدير العام ══ *@
        <div class="sec-h"><span class="dot"></span> لوحة المدير العام <small>— قياس بالأثر</small></div>
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="12" sm="6" md="3">
                <div class="ec-card ec-gm">
                    <div class="ec-gm-h"><MudIcon Icon="@Icons.Material.Filled.Gavel" Color="Color.Warning" Style="font-size:.95rem; vertical-align:-2px;" /> آخر قراراته وإجراءاته</div>
                    @if (_data.Gm.Found)
                    {
                        <MudText Typo="Typo.body2" Class="mb-1"><b>@_data.Gm.FullName</b> — @_data.Gm.LastActivityText</MudText>
                        @foreach (var a in _data.Gm.Recent)
                        {
                            <div class="ec-gm-row"><span>@a.When</span><b>@a.What</b></div>
                        }
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Style="color:#64748B;">
                            لم يتم التعرف على المدير العام — اكتب «مدير عام» في حقل الوظيفة ببيانات الموظف.
                        </MudText>
                    }
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="ec-card ec-gm">
                    <div class="ec-gm-h"><MudIcon Icon="@Icons.Material.Filled.Inbox" Color="Color.Info" Style="font-size:.95rem; vertical-align:-2px;" /> طابور الانتظار عنده</div>
                    <div class="ec-gm-row"><span>طلبات تغيير أسعار</span><b style="color:@(_data.Gm.PendingPrice > 0 ? "#DC2626" : "inherit")">@_data.Gm.PendingPrice</b></div>
                    <div class="ec-gm-row"><span>طلبات تعديل فواتير معلقة</span><b style="color:@(_data.PendingInvoiceEdits > 0 ? "#DC2626" : "inherit")">@_data.PendingInvoiceEdits</b></div>
                    <div class="ec-gm-row"><span>اعتمادات إغلاق فرص</span><b style="color:@(_data.PendingClosureApprovals > 0 ? "#DC2626" : "inherit")">@_data.PendingClosureApprovals</b></div>
                    <div class="ec-gm-row"><span>أذونات تسليم معلقة</span><b style="color:@(_data.PendingDeliveryPermits > 0 ? "#DC2626" : "inherit")">@_data.PendingDeliveryPermits</b></div>
                    <div class="ec-gm-row"><span>شكاوى مصعَّدة</span><b style="color:@(_data.Gm.EscalatedComplaints > 0 ? "#DC2626" : "inherit")">@_data.Gm.EscalatedComplaints</b></div>
                    <div class="ec-gm-row"><span>متابعات فرص متأخرة</span><b style="color:@(_data.PipelineStalled > 0 ? "#D97706" : "inherit")">@_data.PipelineStalled</b></div>
                    <div class="ec-gm-row"><span>إجراءاته آخر 7 أيام</span><b>@_data.Gm.ActionsWeek</b></div>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="ec-card ec-gm">
                    <div class="ec-gm-h"><MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Success" Style="font-size:.95rem; vertical-align:-2px;" /> فريقه في سطر</div>
                    <div class="ec-gm-row"><span>مبيعات الفريق (شهر)</span><b>@_data.Gm.TeamSalesMonth.ToString("N0") ج</b></div>
                    <div class="ec-gm-row"><span>نشطون اليوم (لهم حساب)</span><b style="color:#059669;">@_data.Gm.TeamActiveToday / @_data.Gm.TeamTotal</b></div>
                    <div class="ec-gm-row"><span>ساكنون</span><b style="color:@(_data.DormantCount > 0 ? "#DC2626" : "inherit")">@_data.DormantCount</b></div>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="ec-card ec-gm">
                    <div class="ec-gm-h"><MudIcon Icon="@Icons.Material.Filled.Factory" Color="Color.Info" Style="font-size:.95rem; vertical-align:-2px;" /> نبض التشغيل</div>
                    @if (SectionFailed("ops"))
                    {
                        <MudText Typo="Typo.body2" Style="color:#B45309;">تعذّر تحميل هذا القسم</MudText>
                    }
                    else
                    {
                    <div class="ec-gm-row"><span>أوامر مصنع بانتظار الاستلام</span><b>@_data.Ops.FactoryOpen</b></div>
                    <div class="ec-gm-row"><span>استلامات المصنع (شهر)</span><b>@_data.Ops.FactoryMonth</b></div>
                    <div class="ec-gm-row"><span>Leads جديدة (شهر)</span><b>@_data.Ops.NewLeads</b></div>
                    }
                </div>
            </MudItem>
        </MudGrid>

        @* ══ 7ب) التسويق وبوابة التجار والموارد البشرية — مرحلة 2 ══ *@
        <div class="sec-h"><span class="dot"></span> التسويق وبوابة التجار والموارد البشرية <small>— التسويق وبوابة التجار لـ @_data.PeriodLabel · الحضور لقطة اليوم والرواتب للشهر الحالي · اضغط أي كارت لشاشته</small></div>
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="12" md="4">
                <div class="ec-card" style="cursor:pointer; height:100%;" @onclick="@(() => Nav.NavigateTo("/reports/marketing"))">
                    <div class="ec-gm-h"><MudIcon Icon="@Icons.Material.Filled.Campaign" Color="Color.Warning" Style="font-size:.95rem; vertical-align:-2px;" /> التسويق — من أين يأتي العميل؟</div>
                    @if (SectionFailed("marketing"))
                    {
                        <MudText Typo="Typo.body2" Style="color:#B45309;">تعذّر تحميل هذا القسم</MudText>
                    }
                    else
                    {
                    <div class="ec-big">@_data.Marketing.Leads <small style="font-size:.65rem; color:#64748B;">ليد في الفترة</small></div>
                    <div class="ec-gm-row"><span>تحوّلوا لعملاء</span><b style="color:#059669;">@_data.Marketing.Customers (@_data.Marketing.ConversionPct%)</b></div>
                    <div class="ec-gm-row"><span>إنفاق تسويقي / تكلفة الليد</span><b>@_data.Marketing.Spend.ToString("N0") ج / @_data.Marketing.CostPerLead.ToString("N0") ج</b></div>
                    @if (!string.IsNullOrEmpty(_data.Marketing.TopSourceName))
                    {
                        <div class="ec-gm-row"><span>أقوى مصدر: @_data.Marketing.TopSourceName</span><b>@_data.Marketing.TopSourceLeads ليد</b></div>
                    }
                    @if (!string.IsNullOrEmpty(_data.Marketing.TopCampaignName))
                    {
                        <div class="ec-gm-row"><span>أنشط حملة: @_data.Marketing.TopCampaignName</span><b>@_data.Marketing.TopCampaignLeads ليد · @_data.Marketing.TopCampaignDeals صفقة</b></div>
                    }
                    }
                </div>
            </MudItem>
            <MudItem xs="12" md="4">
                <div class="ec-card" style="cursor:pointer; height:100%;" @onclick="@(() => Nav.NavigateTo("/admin/b2b/dashboard"))">
                    <div class="ec-gm-h"><MudIcon Icon="@Icons.Material.Filled.Storefront" Color="Color.Info" Style="font-size:.95rem; vertical-align:-2px;" /> بوابة التجار B2B</div>
                    @if (SectionFailed("b2b"))
                    {
                        <MudText Typo="Typo.body2" Style="color:#B45309;">تعذّر تحميل هذا القسم</MudText>
                    }
                    else
                    {
                    <div class="ec-big">@_data.B2bBlock.RequestsInPeriod <small style="font-size:.65rem; color:#64748B;">طلب في الفترة</small></div>
                    <div class="ec-gm-row"><span>شركات مسجلة بالبوابة</span><b>@_data.B2bBlock.Companies</b></div>
                    <div class="ec-gm-row"><span>حسابات نشطة / غير مفعّلة</span><b>@_data.B2bBlock.ActiveUsers / @_data.B2bBlock.InactiveUsers</b></div>
                    <div class="ec-gm-row"><span>تحوّلت لفواتير في الفترة</span><b style="color:#059669;">@_data.B2bBlock.ConvertedInPeriod — @_data.B2bBlock.ConvertedValue.ToString("N0") ج</b></div>
                    <div class="ec-gm-row"><span>بانتظار المعالجة الآن</span><b style="color:@(_data.B2bBlock.PendingNow > 0 ? "#D97706" : "inherit")">@_data.B2bBlock.PendingNow</b></div>
                    }
                </div>
            </MudItem>
            <MudItem xs="12" md="4">
                <div class="ec-card" style="height:100%;">
                    <div class="ec-gm-h"><MudIcon Icon="@Icons.Material.Filled.Badge" Color="Color.Success" Style="font-size:.95rem; vertical-align:-2px;" /> الموارد البشرية — اليوم والشهر</div>
                    @if (SectionFailed("hr"))
                    {
                        <MudText Typo="Typo.body2" Style="color:#B45309;">تعذّر تحميل هذا القسم</MudText>
                    }
                    else
                    {
                    <div style="cursor:pointer;" @onclick="@(() => Nav.NavigateTo("/attendance/dashboard"))">
                        <div class="ec-big">@_data.Hr.PresentToday / @_data.Hr.ActiveEmployees <small style="font-size:.65rem; color:#64748B;">حاضر اليوم من النشطين — حضور @_data.Hr.AttendancePct%</small></div>
                        <div class="ec-gm-row"><span>متأخر (+15 د) / غائب / بإجازة</span><b>@_data.Hr.LateToday / @_data.Hr.AbsentToday / @_data.Hr.OnLeaveCount</b></div>
                    </div>
                    @if (_data.Hr.ExemptCount > 0)
                    {
                    <div class="ec-gm-row"><span>معفون من البصمة (حضور يدوي — خارج أساس النسبة)</span><b>@_data.Hr.ExemptCount</b></div>
                    }
                    <div class="ec-gm-row" style="cursor:pointer;" @onclick="@(() => Nav.NavigateTo("/hr/payroll"))"><span>تكلفة رواتب الشهر الحالي (@_data.Hr.PayrollMonthLabel)</span><b>@_data.Hr.PayrollMonthCost.ToString("N0") ج</b></div>
                    <div class="ec-gm-row" style="cursor:pointer;" @onclick="@(() => Nav.NavigateTo("/hr/loans"))"><span>سلف نشطة — المتبقي منها</span><b>@_data.Hr.ActiveLoansCount سلفة — @_data.Hr.ActiveLoansRemaining.ToString("N0") ج</b></div>
                    <div class="ec-gm-row" style="cursor:pointer;" @onclick="@(() => Nav.NavigateTo("/hr/loans"))"><span>سلف جديدة في الفترة</span><b>@_data.Hr.NewLoansInPeriod — @_data.Hr.NewLoansAmountInPeriod.ToString("N0") ج</b></div>
                    }
                </div>
            </MudItem>
        </MudGrid>

        <div class="ec-note">
            كل الأرقام لحظية من: الفواتير · المدفوعات · قائمة الدخل · المصروفات · الخزائن · الفرص البيعية · عروض الأسعار · المخزون · أوامر التشغيل · التسليمات · التسويق · B2B · الحضور والرواتب والسلف · سجل التدقيق · المهام · العملاء المحتملين · الشكاوى — شاشة للقراءة فقط
        </div>
    </div>
</div>
}

@* ══ دايلوج الخط الزمني ══ *@
<MudDialog @bind-Visible="_showTimeline" Options="_timelineDlgOpts">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Timeline" Color="Color.Warning" />
            <MudText Typo="Typo.h6">@_timelineName</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (_timelineLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Style="min-height:150px; justify-content:center;">
                <MudProgressCircular Indeterminate="true" Color="Color.Warning" />
            </MudStack>
        }
        else
        {
            <MudTimeline TimelineOrientation="TimelineOrientation.Vertical" TimelinePosition="TimelinePosition.Start">
                @foreach (var row in _timelineRows)
                {
                    <MudTimelineItem Size="Size.Small"
                                     Color="@(row.Kind == "invoice" ? Color.Warning : Color.Info)"
                                     Variant="Variant.Outlined">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@row.When.ToString("yyyy/MM/dd hh:mm tt")</MudText>
                        <MudText Typo="Typo.body2">@row.What</MudText>
                    </MudTimelineItem>
                }
                @if (_timelineRows.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">لا يوجد سجل بعد</MudText>
                }
            </MudTimeline>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showTimeline = false)">إغلاق</MudButton>
    </DialogActions>
</MudDialog>

@* ══ دايلوج القرارات ══ *@
<MudDialog @bind-Visible="_showDecisions">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Gavel" Color="Color.Warning" />
            <MudText Typo="Typo.h6">بنود في انتظارك</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (_data != null)
        {
            <MudList T="string" Dense="true">
                @if (_data.Exceptions.PendingPrice > 0)
                {
                    <MudListItem T="string" Icon="@Icons.Material.Filled.RequestQuote" IconColor="Color.Error">
                        @_data.Exceptions.PendingPrice طلب تغيير أسعار معلق — <MudLink Href="/sales/price-requests">اعتماد/رفض</MudLink>
                    </MudListItem>
                }
                @if (_data.PendingInvoiceEdits > 0)
                {
                    <MudListItem T="string" Icon="@Icons.Material.Filled.EditNote" IconColor="Color.Error">
                        @_data.PendingInvoiceEdits طلب تعديل فاتورة معلق — <MudLink Href="/sales/invoices">مراجعة الفواتير</MudLink>
                    </MudListItem>
                }
                @if (_data.PendingClosureApprovals > 0)
                {
                    <MudListItem T="string" Icon="@Icons.Material.Filled.BusinessCenter" IconColor="Color.Error">
                        @_data.PendingClosureApprovals طلب اعتماد إغلاق فرصة — <MudLink Href="/crm/opportunities/closure-requests">مراجعة الطلبات</MudLink>
                    </MudListItem>
                }
                @if (_data.PendingDeliveryPermits > 0)
                {
                    <MudListItem T="string" Icon="@Icons.Material.Filled.LocalShipping" IconColor="Color.Warning">
                        @_data.PendingDeliveryPermits إذن تسليم بانتظار الاعتماد — <MudLink Href="/sales-delivery-status">فتح حالة التسليمات</MudLink>
                    </MudListItem>
                }
                @if (_data.Gm.EscalatedComplaints > 0)
                {
                    <MudListItem T="string" Icon="@Icons.Material.Filled.ReportProblem" IconColor="Color.Error">
                        @_data.Gm.EscalatedComplaints شكوى مصعَّدة للمدير العام — <MudLink Href="/complaints/list">فتح الشكاوى</MudLink>
                    </MudListItem>
                }
                @if (_data.DormantCount > 0)
                {
                    <MudListItem T="string" Icon="@Icons.Material.Filled.PersonOff" IconColor="Color.Warning">
                        @_data.DormantCount موظف ساكن 3+ أيام — إنذار / متابعة / إعادة توزيع
                    </MudListItem>
                }
            </MudList>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showDecisions = false)">إغلاق</MudButton>
    </DialogActions>
</MudDialog>

@* ══ دايلوج اللقطات المحفوظة — مرحلة 3 ══ *@
<MudDialog @bind-Visible="_showSnapshots" Options="_snapshotDlgOpts">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Color="Color.Warning" />
            <MudText Typo="Typo.h6">لقطات اللوحة المحفوظة</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (_snapshotsLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Style="min-height:120px; justify-content:center;">
                <MudProgressCircular Indeterminate="true" Color="Color.Warning" />
            </MudStack>
        }
        else if (_snapshotTableMissing)
        {
            <MudAlert Severity="Severity.Warning">
                جدول اللقطات غير مُنشأ بعد — شغّل سكربت <b>executive-cockpit-snapshot-table.sql</b> على قاعدة البيانات مرة واحدة، وبعدها يشتغل الحفظ والقائمة.
            </MudAlert>
        }
        else if (_snapshots.Count == 0)
        {
            <MudText Typo="Typo.body2">لا لقطات محفوظة بعد — احفظ أول لقطة من زرار «📸 حفظ لقطة» في شريط الأدوات.</MudText>
        }
        else
        {
            <MudList T="string" Dense="true">
                @foreach (var s in _snapshots)
                {
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Description">
                        <b>@s.CreatedAt.ToString("yyyy/MM/dd hh:mm tt")</b> — @s.PeriodLabel
                        · @(s.BranchId == null ? "كل الفروع" : $"فرع {s.BranchName}")
                        · حفظها: @s.CreatedBy
                        — <MudLink Href="@($"/executive-cockpit/print?snapshot={s.SnapshotId}")" Target="_blank">عرض / طباعة</MudLink>
                    </MudListItem>
                }
            </MudList>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showSnapshots = false)">إغلاق</MudButton>
    </DialogActions>
</MudDialog>

<style>
    /* ═══ لوحة تنفيذية بثيم التطبيق الفاتح (PaletteLight في MainLayout) ═══
       الأسطح بيضاء، النص الأساسي #1E293B، الثانوي #64748B، الحدود #E2E8F0،
       والذهبي #D4AF37 (لون التطبيق الثانوي) لمسات علامة فقط. */
    .ec-root { color: #1E293B; margin: 4px 0 30px; }
    .ec-wrap { max-width: 1400px; margin: 0 auto; padding: 6px 4px 20px; }
    .ec-root b, .ec-root strong { font-weight: 800; }

    .ec-hero { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; flex-wrap: wrap;
               padding: 16px 18px; margin-bottom: 16px; border-radius: 14px;
               background: #FFFFFF; border: 1px solid #E2E8F0; border-bottom: 3px solid var(--gold);
               box-shadow: 0 4px 12px rgba(0,0,0,.05); }
    .ec-hero-side { display: flex; align-items: center; gap: 12px; }
    .ec-crown { font-size: 2.2rem !important; color: var(--gold); }
    .ec-hero h1 { font-size: 1.45rem; font-weight: 900; margin: 0; color: #1E293B; }
    .ec-hero-sub { color: #64748B; font-size: .8rem; margin-top: 4px; }

    .ec-ptabs { display: flex; background: #F1F5F9; border: 1px solid #E2E8F0; border-radius: 10px; overflow: hidden; }
    .ec-ptab { background: none; border: none; color: #64748B; padding: 8px 15px; cursor: pointer; font-family: inherit; font-size: .82rem; transition: .2s; white-space: nowrap; }
    .ec-ptab:hover { color: #1E293B; }
    .ec-ptab.on { background: linear-gradient(135deg, var(--gold), var(--gold-dark)); color: #1E293B; font-weight: 800; }

    .ec-story { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; border: 1px solid rgba(212,175,55,.35);
                border-inline-start: 4px solid var(--gold); border-radius: 12px; padding: 12px 16px; margin-bottom: 16px;
                background: linear-gradient(90deg, rgba(212,175,55,.10), rgba(212,175,55,.02)); line-height: 1.9; }
    .ec-act { background: linear-gradient(135deg, var(--gold), var(--gold-dark)); color: #1E293B; border: none; font-family: inherit; font-weight: 800;
              padding: 8px 16px; border-radius: 10px; cursor: pointer; font-size: .8rem; box-shadow: 0 4px 14px rgba(212,175,55,.30); }

    /* الساكنون */
    .ec-dormant { border: 1px solid rgba(239,68,68,.40); border-radius: 14px; margin-bottom: 16px; overflow: hidden;
                  background: linear-gradient(90deg, rgba(239,68,68,.06), rgba(239,68,68,.015)); }
    .ec-dormant-head { display: flex; align-items: center; gap: 10px; padding: 12px 16px; color: #B91C1C; font-size: .95rem;
                       border-bottom: 1px dashed rgba(239,68,68,.30); flex-wrap: wrap; }
    .ec-dormant-head small { color: #64748B; font-weight: 400; font-size: .72rem; }
    .ec-dormant-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 8px; padding: 10px 14px; }
    .ec-dormant-item { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 10px; cursor: pointer;
                       background: #FFFFFF; border: 1px solid #E2E8F0; transition: .15s; }
    .ec-dormant-item:hover { border-color: rgba(239,68,68,.55); background: rgba(239,68,68,.05); }
    .ec-dormant-meta { color: #64748B; font-size: .7rem; margin-top: 2px; }
    .ec-dormant-go { margin-inline-start: auto; color: #DC2626; font-size: .72rem; white-space: nowrap; }

    .sec-h { display: flex; align-items: center; gap: 8px; margin: 20px 0 10px; font-size: 1.05rem; font-weight: 800; flex-wrap: wrap; color: #1E293B; }
    .sec-h .dot { width: 8px; height: 20px; border-radius: 3px; background: linear-gradient(180deg, var(--gold), rgba(212,175,55,.25)); display: inline-block; }
    .sec-h small { color: #64748B; font-weight: 400; font-size: .74rem; }

    .ec-card { background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 14px; padding: 14px; transition: .2s;
               box-shadow: 0 4px 12px rgba(0,0,0,.05); }
    .ec-card:hover { border-color: rgba(212,175,55,.55); box-shadow: 0 8px 24px rgba(0,0,0,.08); }
    .ec-center { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 4px; }
    .ec-gauge-pct { font-size: 1.45rem; font-weight: 900; line-height: 1.1; margin-top: -40px; position: relative; }
    .ec-gauge-cap { font-size: .7rem; color: #64748B; }
    .ec-gauge-num { font-size: 1.5rem; font-weight: 900; color: #1E293B; }
    .ec-gauge-sub { font-size: .74rem; color: #64748B; line-height: 1.8; }

    /* KPIs */
    .ec-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; }
    .ec-kpi { background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 14px; padding: 14px;
              position: relative; transition: .2s; overflow: hidden; box-shadow: 0 4px 12px rgba(0,0,0,.05); }
    .ec-kpi:hover { transform: translateY(-2px); border-color: rgba(212,175,55,.55); box-shadow: 0 10px 30px rgba(0,0,0,.10); }
    .ec-kpi-click { cursor: pointer; }
    .ec-kpi-sub { color: #B45309; font-size: .66rem; margin-top: 4px; line-height: 1.6; }

    /* فشل قسم */
    .ec-fail { border: 1px dashed rgba(245,158,11,.55); color: #B45309; border-radius: 12px; padding: 14px;
               text-align: center; font-size: .8rem; margin-bottom: 12px; background: #FFFBEB; }

    /* أعمار الذمم */
    .ec-age-head { font-size: .82rem; font-weight: 700; margin-bottom: 8px; }
    .ec-age-head small { color: #64748B; font-weight: 400; font-size: .7rem; }
    .ec-ages { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
    .ec-age { background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 10px; padding: 8px; text-align: center; }
    .ec-age .a-lab { color: #64748B; font-size: .68rem; }
    .ec-age .a-val { font-weight: 900; font-size: .95rem; margin-top: 3px; }
    .ec-age .a-cnt { color: #64748B; font-size: .64rem; margin-top: 2px; }
    .ec-lb-sub { color: #64748B; font-size: .68rem; margin-top: 3px; }

    /* مرحلة 2: شبكة حالات العروض + الرقم الكبير لكروت التشغيل */
    .ec-qgrid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; }
    .ec-big { font-size: 1.35rem; font-weight: 900; margin-bottom: 6px; }
    .ec-kpi::after { content: ''; position: absolute; inset-inline-start: 0; top: 0; bottom: 0; width: 3px; background: var(--gold); opacity: .85; }
    .ec-kpi .lab { color: #64748B; font-size: .72rem; margin-bottom: 6px; }
    .ec-kpi .val { font-size: 1.28rem; font-weight: 900; letter-spacing: -.5px; color: #1E293B; }
