@code {
    private bool _loading = true;
    private bool _noAccess;
    private ExecutiveCockpitDto? _data;
    private string _period = "month";
    private string _filter = "all";
    private int _dayOfMonth = DateTime.Today.Day;

    // ⭐ مرحلة 3: فرع + فترة مخصصة + تحديث تلقائي + لقطات
    private int? _branchId;
    private List<BranchOptionDto> _branches = new();
    private DateTime? _customFrom = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _customTo = DateTime.Today;
    private bool _autoRefresh = true;
    private bool _refreshing;
    private string _userScope = "shared";
    private readonly SemaphoreSlim _loadGate = new(1, 1);
    private System.Threading.Timer? _refreshTimer;

    private bool _showSnapshots;
    private bool _snapshotsLoading;
    private bool _snapshotTableMissing;
    private List<ExecutiveCockpitSnapshotItemDto> _snapshots = new();
    private readonly DialogOptions _snapshotDlgOpts = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    private readonly Dictionary<string, string> _periods = new()
    {
        ["today"] = "اليوم",
        ["week"] = "الأسبوع",
        ["month"] = "هذا الشهر",
        ["quarter"] = "ربع السنة",
        ["year"] = "السنة",
        ["custom"] = "مخصص"
    };

    private readonly Dictionary<string, string> _filters = new()
    {
        ["all"] = "الكل",
        ["green"] = "نشط",
        ["yellow"] = "نشاط قليل",
        ["red"] = "ساكن",
        ["off"] = "موقوف/إجازة",
        ["gray"] = "بلا حساب"
    };

    private ApexChartOptions<ExecutiveTrendPointDto> _trendOpts = default!;
    private ApexChartOptions<ExecutiveEmployeeRowDto> _actOpts = default!;
    private ApexChartOptions<ExecutiveBranchSaleDto> _branchOpts = default!;

    private bool _showTimeline;
    private bool _timelineLoading;
    private string _timelineName = "";
    private List<ExecutiveTimelineRowDto> _timelineRows = new();
    private readonly DialogOptions _timelineDlgOpts = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    private bool _showDecisions;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        var allowed = user.IsInRole("Admin")
                   || user.HasClaim(c => c.Type == "Permission" && c.Value == "frm_ExecutiveCockpit:View");
        if (!allowed)
        {
            _noAccess = true;
            _loading = false;
            return;
        }

        _userScope = "u:" + (user.Identity?.Name ?? "anon");
        try { _branches = await BranchService.GetBranchesForFilterAsync(); }
        catch { _branches = new(); }

        await LoadAsync();

        // ⭐ تحديث تلقائي كل 5 دقائق — يمر بنفس بوابة التحميل (لا تداخل
        //    أبدًا)، ويُتخطى أثناء فتح أي دايلوج، ويُحرَّر مع مغادرة الصفحة.
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    if (_autoRefresh && !_showTimeline && !_showDecisions && !_showSnapshots)
                        await LoadAsync();
                });
            }
            catch { }
        }, null, TimeSpan.FromMinutes(5), TimeSpan.FromMinutes(5));
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
        _loadGate.Dispose();
    }

    // كل التحميلات (يدوي/تلقائي/تغيير فلتر) تمر من بوابة واحدة:
    // طلب أثناء تحميل جارٍ يُتخطى بدل أن يتداخل معه.
    private async Task LoadAsync(bool bypassCache = false)
    {
        if (!await _loadGate.WaitAsync(0)) return;
        try
        {
            if (_data == null) _loading = true; else _refreshing = true;
            StateHasChanged();
            try
            {
                _data = await CockpitService.GetCockpitAsync(
                    _period, _branchId,
                    _period == "custom" ? _customFrom : null,
                    _period == "custom" ? _customTo : null,
                    bypassCache, _userScope);
                BuildChartOptions();
            }
            catch (Exception ex)
            {
                Snackbar.Add("تعذّر تحميل لوحة القيادة: " + ex.Message, Severity.Error);
                // عند فشل تحديث لاحق تُحفَظ البيانات المعروضة بدل إسقاط الصفحة
                if (_data == null) _data = null;
            }
            finally
            {
                _loading = false;
                _refreshing = false;
                StateHasChanged();
            }
        }
        finally
        {
            _loadGate.Release();
        }
    }

    private async Task SetPeriodAsync(string p)
    {
        _period = p;
        await LoadAsync();
    }

    private async Task SetBranchAsync(int? branchId)
    {
        _branchId = branchId;
        await LoadAsync();
    }

    private async Task ApplyCustomAsync()
    {
        if (_period == "custom") await LoadAsync();
    }

    private async Task ManualRefreshAsync() => await LoadAsync(bypassCache: true);

    private string PrintUrl()
    {
        var url = "/executive-cockpit/print?period=" + _period;
        if (_branchId.HasValue) url += "&branch=" + _branchId.Value;
        if (_period == "custom" && _customFrom.HasValue) url += "&from=" + _customFrom.Value.ToString("yyyy-MM-dd");
        if (_period == "custom" && _customTo.HasValue) url += "&to=" + _customTo.Value.ToString("yyyy-MM-dd");
        return url;
    }

    private string BranchIgnoredText()
    {
        if (_data == null) return "";
        var names = new Dictionary<string, string>
        {
            ["marketing"] = "التسويق",
            ["b2b"] = "بوابة B2B",
            ["gm"] = "لوحة المدير العام",
            ["complaints"] = "الشكاوى (داخل الاستثناءات ونبض التشغيل)"
        };
        return string.Join("، ", _data.BranchIgnoredSections
            .Select(k => names.GetValueOrDefault(k, k)));
    }

    // ── اللقطات ──
    private async Task SaveSnapshotAsync()
    {
        if (_data == null) return;
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var name = auth.User.Identity?.Name ?? "";
        if (await SnapshotService.SaveSnapshotAsync(_data, name))
            Snackbar.Add("تم حفظ لقطة اللوحة الحالية بنجاح", Severity.Success);
        else
            Snackbar.Add("تعذّر حفظ اللقطة — تأكد من تشغيل سكربت إنشاء جدول اللقطات (executive-cockpit-snapshot-table.sql) على قاعدة البيانات", Severity.Error);
    }

    private async Task OpenSnapshotsAsync()
    {
        _showSnapshots = true;
        _snapshotsLoading = true;
        StateHasChanged();
        _snapshotTableMissing = !await SnapshotService.IsAvailableAsync();
        _snapshots = _snapshotTableMissing ? new() : await SnapshotService.ListSnapshotsAsync();
        _snapshotsLoading = false;
        StateHasChanged();
    }

    private void SetFilter(string f) => _filter = f;

    private IEnumerable<ExecutiveEmployeeRowDto> FilteredEmployees()
        => _filter == "all" ? _data?.Employees ?? new() : (_data?.Employees ?? new()).Where(e => e.Status == _filter);

    private List<ExecutiveEmployeeRowDto> DormantEmployees()
        => (_data?.Employees ?? new()).Where(e => e.Status == "red")
           .OrderBy(e => e.LastActivity ?? DateTime.MinValue).ToList();

    private List<ExecutiveEmployeeRowDto> SalesTeam()
        => (_data?.Employees ?? new()).Where(e => e.IsSales && e.Status != "off").OrderByDescending(e => e.MonthSales).ToList();

    private List<ExecutiveEmployeeRowDto> TopSales() => SalesTeam().Take(3).ToList();
    private List<ExecutiveEmployeeRowDto> BottomSales() => SalesTeam().OrderBy(e => e.MonthSales).Take(3).ToList();
    private decimal TopMax() => SalesTeam().Select(e => e.MonthSales).DefaultIfEmpty(0).Max();

    private List<ExecutiveEmployeeRowDto> TopActive()
        => (_data?.Employees ?? new()).Where(e => e.Status != "off").OrderByDescending(e => e.ActionsMonth).Take(8).ToList();

    // ── KPI cards ──
