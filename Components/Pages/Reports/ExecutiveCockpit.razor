@code {
    private bool _loading = true;
    private bool _noAccess;
    private ExecutiveCockpitDto? _data;
    private string _period = "month";
    private string _filter = "all";
    private int _dayOfMonth = DateTime.Today.Day;

    private readonly Dictionary<string, string> _periods = new()
    {
        ["today"] = "اليوم",
        ["week"] = "الأسبوع",
        ["month"] = "هذا الشهر",
        ["quarter"] = "ربع السنة",
        ["year"] = "السنة"
    };

    private readonly Dictionary<string, string> _filters = new()
    {
        ["all"] = "الكل",
        ["green"] = "نشط",
        ["yellow"] = "نشاط قليل",
        ["red"] = "ساكن",
        ["off"] = "موقوف/إجازة",
        ["gray"] = "بلا حساب"
    };

    private ApexChartOptions<ExecutiveTrendPointDto> _trendOpts = default!;
    private ApexChartOptions<ExecutiveEmployeeRowDto> _actOpts = default!;
    private ApexChartOptions<ExecutiveBranchSaleDto> _branchOpts = default!;

    private bool _showTimeline;
    private bool _timelineLoading;
    private string _timelineName = "";
    private List<ExecutiveTimelineRowDto> _timelineRows = new();
    private readonly DialogOptions _timelineDlgOpts = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    private bool _showDecisions;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        var allowed = user.IsInRole("Admin")
                   || user.HasClaim(c => c.Type == "Permission" && c.Value == "frm_ExecutiveCockpit:View");
        if (!allowed)
        {
            _noAccess = true;
            _loading = false;
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _data = await CockpitService.GetCockpitAsync(_period);
            BuildChartOptions();
        }
        catch (Exception ex)
        {
            Snackbar.Add("تعذّر تحميل لوحة القيادة: " + ex.Message, Severity.Error);
            _data = null;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SetPeriodAsync(string p)
    {
        _period = p;
        await LoadAsync();
    }

    private void SetFilter(string f) => _filter = f;

    private IEnumerable<ExecutiveEmployeeRowDto> FilteredEmployees()
        => _filter == "all" ? _data?.Employees ?? new() : (_data?.Employees ?? new()).Where(e => e.Status == _filter);

    private List<ExecutiveEmployeeRowDto> DormantEmployees()
        => (_data?.Employees ?? new()).Where(e => e.Status == "red")
           .OrderBy(e => e.LastActivity ?? DateTime.MinValue).ToList();

    private List<ExecutiveEmployeeRowDto> SalesTeam()
        => (_data?.Employees ?? new()).Where(e => e.IsSales && e.Status != "off").OrderByDescending(e => e.MonthSales).ToList();

    private List<ExecutiveEmployeeRowDto> TopSales() => SalesTeam().Take(3).ToList();
    private List<ExecutiveEmployeeRowDto> BottomSales() => SalesTeam().OrderBy(e => e.MonthSales).Take(3).ToList();
    private decimal TopMax() => SalesTeam().Select(e => e.MonthSales).DefaultIfEmpty(0).Max();

    private List<ExecutiveEmployeeRowDto> TopActive()
        => (_data?.Employees ?? new()).Where(e => e.Status != "off").OrderByDescending(e => e.ActionsMonth).Take(8).ToList();

    // ── KPI cards ──
    private sealed record KpiCard(string Icon, string Label, decimal Value, decimal PrevPct, decimal YearPct, bool Invert, bool ShowCmp);
    private List<KpiCard> KpiCards()
    {
        if (_data == null) return new();
        return new()
        {
            new(Icons.Material.Filled.Paid, "المبيعات", _data.Sales.Value, _data.Sales.PrevPct, _data.Sales.YearPct, false, true),
            new(Icons.Material.Filled.AccountBalance, "المحصَّل من فواتير الفترة", _data.Collected.Value, _data.Collected.PrevPct, _data.Collected.YearPct, false, true),
            new(Icons.Material.Filled.LocalShipping, "المشتريات", _data.Purchases.Value, _data.Purchases.PrevPct, _data.Purchases.YearPct, true, true),
            new(Icons.Material.Filled.ReceiptLong, "المصروفات", _data.Expenses.Value, _data.Expenses.PrevPct, _data.Expenses.YearPct, true, true),
            new(Icons.Material.Filled.CurrencyExchange, "صافي التدفق", _data.Net.Value, _data.Net.PrevPct, _data.Net.YearPct, false, true),
            new(Icons.Material.Filled.Savings, "رصيد الخزائن", _data.CashBalance, 0, 0, false, false)
        };
    }

    private RenderFragment CmpChip(decimal pct, bool invert, string caption) => builder =>
    {
        var good = invert ? pct <= 0 : pct >= 0;
        var cls = pct == 0 ? "ec-flat" : good ? "ec-up" : "ec-down";
        var arr = pct > 0 ? "▲" : pct < 0 ? "▼" : "•";
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"ec-cmp {cls}");
        builder.AddContent(2, $"{arr} {Math.Abs(pct)}% {caption}");
        builder.CloseElement();
    };

    private static string HeatColor(int count)
        => count == 0 ? "rgba(239,83,80,.55)"
         : count <= 2 ? "rgba(255,201,77,.5)"
         : count <= 4 ? "rgba(76,175,80,.45)"
         : "rgba(76,175,80,.9)";

    private static string BadgeClass(string st) => st switch
    {
        "green" => "bd-green", "yellow" => "bd-yellow", "red" => "bd-red",
        "off" => "bd-off", _ => "bd-gray"
    };
    private static string BadgeText(string st) => st switch
    {
        "green" => "نشط", "yellow" => "قليل", "red" => "ساكن",
        "off" => "موقوف/إجازة", _ => "بلا حساب"
    };

    // ── عداد التوقع ──
    private decimal ForecastPctValue()
        => _data == null ? 0 : Math.Clamp(_data.ForecastVsLastPct, -100, 100);

    private string ForecastPctDisplay()
        => _data == null ? "" : $"{(_data.ForecastVsLastPct >= 0 ? "+" : "")}{_data.ForecastVsLastPct}%";

    private string GaugeColor()
        => ForecastPctValue() >= 0 ? "#4caf50" : ForecastPctValue() >= -15 ? "#ffc94d" : "#ef5350";

    private string GaugeArc()
    {
        const double r = 75, cx = 95, cy = 100;
        var frac = (double)((ForecastPctValue() + 100) / 200m);
        var ang = Math.PI * (1 - frac);
        var x = cx + r * Math.Cos(ang);
        var y = cy - r * Math.Sin(ang);
        var large = frac > 0.5 ? 1 : 0;
        return $"M {cx - r} {cy} A {r} {r} 0 {large} 1 {x:F1} {y:F1}";
    }

    // ── الخط الزمني ──
    private async Task OpenTimelineAsync(int employeeId)
    {
        var emp = _data?.Employees.FirstOrDefault(e => e.EmployeeId == employeeId);
        _timelineName = emp == null ? "" : $"{emp.FullName} — {emp.JobTitle}";
        _timelineRows = new();
        _timelineLoading = true;
        _showTimeline = true;
        StateHasChanged();
        try
        {
            _timelineRows = await CockpitService.GetEmployeeTimelineAsync(employeeId);
        }
        catch
        {
            Snackbar.Add("تعذّر تحميل الخط الزمني", Severity.Error);
        }
        finally
        {
            _timelineLoading = false;
            StateHasChanged();
        }
    }

    private void OpenDecisions() => _showDecisions = true;

