@page "/executive-cockpit"

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using ApexCharts
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size
@using Align = MudBlazor.Align
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize]

@inject IExecutiveCockpitService CockpitService
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>لوحة القيادة التنفيذية</PageTitle>

@if (_loading)
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
        <MudStack AlignItems="AlignItems.Center" Spacing="3" Style="min-height:300px; justify-content:center;">
            <MudProgressCircular Indeterminate="true" Color="Color.Warning" Size="Size.Large" />
            <MudText Typo="Typo.body1" Color="Color.Secondary">جارٍ تجهيز لوحة القيادة التنفيذية...</MudText>
        </MudStack>
    </MudContainer>
}
else if (_noAccess)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
            ليس لديك صلاحية للدخول — هذه الشاشة لرئيس مجلس الإدارة (Admin) أو بإذن «لوحة القيادة التنفيذية».
        </MudAlert>
    </MudContainer>
}
else if (_data != null)
{
<div class="ec-root">
    <div class="ec-wrap">

        @* ══ Hero ══ *@
        <div class="ec-hero">
            <div class="ec-hero-side">
                <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Class="ec-crown" Color="Color.Warning" />
                <div>
                    <h1>لوحة القيادة التنفيذية</h1>
                    <div class="ec-hero-sub">بيانات لحظية من النظام · آخر تحديث @_data.GeneratedAt.ToString("hh:mm tt")</div>
                </div>
            </div>
            <div class="ec-ptabs">
                @foreach (var p in _periods)
                {
                    <button class="ec-ptab @(_period == p.Key ? "on" : "")" @onclick="() => SetPeriodAsync(p.Key)">@p.Value</button>
                }
            </div>
        </div>

        @* ══ القصة ══ *@
        <div class="ec-story">
            <MudIcon Icon="@Icons.Material.Filled.Bolt" Color="Color.Warning" Style="font-size:1.5rem;" />
            <div style="flex:1;">@_data.Story</div>
            @if (_data.DecisionsPending > 0)
            {
                <button class="ec-act" @onclick="OpenDecisions">@_data.DecisionsPending بند في انتظارك <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Style="font-size:.9rem; vertical-align:-2px;" /></button>
            }
        </div>

        @* ══ تنبيه الموظفين المتوقفين ══ *@
        @if (DormantEmployees().Count > 0)
        {
            <div class="ec-dormant">
                <div class="ec-dormant-head">
                    <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Color="Color.Error" Style="font-size:1.4rem;" />
                    <b>موظفون ساكنون يحتاجون قرارًا (@DormantEmployees().Count)</b>
                    <small>بلا أي إجراء في النظام منذ 3 أيام أو أكثر</small>
                </div>
                <div class="ec-dormant-list">
                    @foreach (var e in DormantEmployees())
                    {
                        <div class="ec-dormant-item" @onclick="() => OpenTimelineAsync(e.EmployeeId)">
                            <span class="ec-avatar">@(e.FullName.FirstOrDefault())</span>
                            <div>
                                <b>@e.FullName</b>
                                <div class="ec-dormant-meta">@e.JobTitle · آخر نشاط: @e.LastActivityText · حضور: @e.Attendance</div>
                            </div>
                            <span class="ec-dormant-go">الخط الزمني <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Style="font-size:.8rem; vertical-align:-2px;" /></span>
                        </div>
                    }
                </div>
            </div>
        }

        @* ══ 1) نبض الشركة ══ *@
        <div class="sec-h"><span class="dot"></span> نبض الشركة — @_data.PeriodLabel <small>مقارنة بالفترة السابقة ونفس الفترة سنويًا</small></div>
        <div class="ec-kpis">
            @foreach (var k in KpiCards())
            {
                <div class="ec-kpi">
                    <div class="lab"><MudIcon Icon="@k.Icon" Color="Color.Warning" Style="font-size:1rem; vertical-align:-3px;" /> @k.Label</div>
                    <div class="val">@k.Value.ToString("N0") <small>ج</small></div>
                    @if (k.ShowCmp)
                    {
                        <div class="cmps">
                            @CmpChip(k.PrevPct, k.Invert, "عن السابق")
                            @CmpChip(k.YearPct, k.Invert, "سنويًا")
                        </div>
                    }
                    else
                    {
                        <div class="cmps"><span class="ec-cmp ec-flat">الرصيد اللحظي لكل الخزن</span></div>
                    }
                </div>
            }
        </div>

        @* ══ 2) بايبلاين الفرص وB2B ══ *@
        <div class="ec-pipe">
            <div class="ec-pipe-card" @onclick="@(() => Nav.NavigateTo("/crm/opportunities"))">
                <div class="n">@_data.PipelineOpen</div>
                <div class="t"><MudIcon Icon="@Icons.Material.Filled.BusinessCenter" Style="font-size:.9rem; vertical-align:-2px;" /> فرصة بيعية مفتوحة</div>
            </div>
            <div class="ec-pipe-card" @onclick="@(() => Nav.NavigateTo("/crm/opportunities"))">
                <div class="n">@_data.PipelineValue.ToString("N0") <small>ج</small></div>
                <div class="t"><MudIcon Icon="@Icons.Material.Filled.Paid" Style="font-size:.9rem; vertical-align:-2px;" /> قيمتها المتوقعة</div>
            </div>
            <div class="ec-pipe-card @( _data.PipelineStalled > 0 ? "warn" : "")" @onclick="@(() => Nav.NavigateTo("/crm/opportunities"))">
                <div class="n">@_data.PipelineStalled</div>
                <div class="t"><MudIcon Icon="@Icons.Material.Filled.Schedule" Style="font-size:.9rem; vertical-align:-2px;" /> متابعة متأخرة على فرص</div>
            </div>
            <div class="ec-pipe-card @(_data.B2bPending > 0 ? "warn" : "")" @onclick="@(() => Nav.NavigateTo("/admin/b2b/requests"))">
                <div class="n">@_data.B2bPending</div>
                <div class="t"><MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Style="font-size:.9rem; vertical-align:-2px;" /> طلبات B2B جديدة/قيد المراجعة</div>
            </div>
        </div>

        @* ══ 3) الاتجاهات + التوقع ══ *@
        <div class="sec-h"><span class="dot"></span> الاتجاهات والتوقعات <small>— 12 شهر</small></div>
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="12" md="8">
                <div class="ec-card">
                    <ApexChart TItem="ExecutiveTrendPointDto"
                               Options="_trendOpts"
                               Height="300"
                               Width="@("100%")">
                        <ApexPointSeries TItem="ExecutiveTrendPointDto" Items="_data.Trend"
                                         Name="المبيعات" SeriesType="SeriesType.Area"
                                         XValue="@(d => d.Label)" YValue="@(d => (decimal?)d.Sales)" />
                        <ApexPointSeries TItem="ExecutiveTrendPointDto" Items="_data.Trend"
                                         Name="المحصَّل" SeriesType="SeriesType.Area"
                                         XValue="@(d => d.Label)" YValue="@(d => (decimal?)d.Collected)" />
                        <ApexPointSeries TItem="ExecutiveTrendPointDto" Items="_data.Trend"
                                         Name="المشتريات" SeriesType="SeriesType.Line"
                                         XValue="@(d => d.Label)" YValue="@(d => (decimal?)d.Purchases)" />
                    </ApexChart>
                </div>
            </MudItem>
            <MudItem xs="12" md="4">
                <div class="ec-card ec-center" style="height:100%;">
                    <MudText Typo="Typo.subtitle2" Style="color:#93a4bd;"><MudIcon Icon="@Icons.Material.Filled.Insights" Color="Color.Warning" Style="font-size:1rem; vertical-align:-2px;" /> توقع إقفال الشهر الحالي</MudText>
                    <svg width="190" height="120" viewBox="0 0 190 120">
                        <path d="M 20 100 A 75 75 0 0 1 170 100" fill="none" stroke="rgba(255,255,255,.08)" stroke-width="14" stroke-linecap="round" />
                        <path d="@GaugeArc()" fill="none" stroke="@GaugeColor()" stroke-width="14" stroke-linecap="round" />
                        <text x="95" y="88" fill="@GaugeColor()" font-size="24" font-weight="900" text-anchor="middle">@ForecastPctDisplay()</text>
                        <text x="95" y="108" fill="#93a4bd" font-size="10" text-anchor="middle">مقارنة بالشهر الماضي</text>
                    </svg>
                    <div class="ec-gauge-num">@_data.ForecastValue.ToString("N0") ج</div>
                    <div class="ec-gauge-sub">على معدل أول @_dayOfMonth يوم — الشهر الماضي @_data.LastMonthSales.ToString("N0") ج</div>
                </div>
            </MudItem>
        </MudGrid>

        @* ══ 4) الفروع + الأكثر نشاطًا ══ *@
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="12" md="6">
                <div class="ec-card">
                    <MudText Typo="Typo.subtitle2" Class="mb-2"><MudIcon Icon="@Icons.Material.Filled.Storefront" Color="Color.Info" Style="font-size:1rem; vertical-align:-2px;" /> المبيعات حسب الفرع — @_data.PeriodLabel</MudText>
                    @if (_data.BranchSales.Count > 0)
                    {
                        <ApexChart TItem="ExecutiveBranchSaleDto" Options="_branchOpts" Height="250" Width="@("100%")">
                            <ApexPointSeries TItem="ExecutiveBranchSaleDto" Items="_data.BranchSales"
                                             Name="مبيعات" SeriesType="SeriesType.Bar"
                                             XValue="@(d => d.Name)" YValue="@(d => (decimal?)d.Value)" />
                        </ApexChart>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Style="color:#93a4bd;">لا مبيعات مرتبطة بفروع في هذه الفترة</MudText>
                    }
                </div>
            </MudItem>
            <MudItem xs="12" md="6">
                <div class="ec-card">
                    <MudText Typo="Typo.subtitle2" Class="mb-2"><MudIcon Icon="@Icons.Material.Filled.BarChart" Color="Color.Warning" Style="font-size:1rem; vertical-align:-2px;" /> الأكثر إجراءً في النظام (30 يوم)</MudText>
                    <ApexChart TItem="ExecutiveEmployeeRowDto" Options="_actOpts" Height="250" Width="@("100%")">
                        <ApexPointSeries TItem="ExecutiveEmployeeRowDto" Items="TopActive()"
                                         Name="إجراء" SeriesType="SeriesType.Bar"
                                         XValue="@(d => d.FullName)" YValue="@(d => (decimal?)d.ActionsMonth)" />
                    </ApexChart>
                </div>
            </MudItem>
        </MudGrid>

        @* ══ 5) لوحة الشرف ══ *@
        <div class="sec-h"><span class="dot"></span> لوحة الشرف — المبيعات <small>— إنتاج الشهر الحالي</small></div>
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="12" md="6">
                <div class="ec-card">
                    <MudText Typo="Typo.subtitle2" Class="mb-2"><MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" Style="font-size:1rem; vertical-align:-2px;" /> الأعلى إنتاجًا</MudText>
                    @foreach (var (e, i) in TopSales().Select((e, i) => (e, i)))
                    {
                        <div class="ec-lb" @onclick="() => OpenTimelineAsync(e.EmployeeId)">
                            <span class="ec-rank rk@(i + 1)">@(i + 1)</span>
                            <div style="flex:1;">
                                <div class="ec-lb-name">@e.FullName <small>@e.JobTitle</small></div>
                                <div class="ec-lb-bar"><i style="width:@(TopMax() == 0 ? 0 : (int)(e.MonthSales / TopMax() * 100))%; background:linear-gradient(90deg,#d4af37,#ffd700);"></i></div>
                            </div>
                            <b class="ec-lb-val">@e.MonthSales.ToString("N0") ج</b>
                        </div>
                    }
                    @if (TopSales().Count == 0)
                    {
                        <MudText Typo="Typo.body2" Style="color:#93a4bd;">لا مبيعات بعد هذا الشهر</MudText>
                    }
                </div>
            </MudItem>
            <MudItem xs="12" md="6">
                <div class="ec-card">
                    <MudText Typo="Typo.subtitle2" Class="mb-2"><MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Style="font-size:1rem; vertical-align:-2px;" /> يحتاجون متابعة</MudText>
                    @foreach (var e in BottomSales())
                    {
                        <div class="ec-lb" @onclick="() => OpenTimelineAsync(e.EmployeeId)">
                            <span class="ec-rank rkx"><MudIcon Icon="@(e.MonthSales == 0 ? Icons.Material.Filled.PriorityHigh : Icons.Material.Filled.WarningAmber)" Style="font-size:.95rem;" /></span>
                            <div style="flex:1;">
                                <div class="ec-lb-name">@e.FullName <small>@e.JobTitle</small></div>
                                <div class="ec-lb-bar"><i style="width:@(TopMax() == 0 ? 6 : Math.Max(6, (int)(e.MonthSales / TopMax() * 100)))%; background:linear-gradient(90deg,#7a3b3b,#ef5350);"></i></div>
                            </div>
                            <b class="ec-lb-val" style="color:#ef5350;">@e.MonthSales.ToString("N0") ج</b>
                        </div>
                    }
                    @if (BottomSales().Count == 0)
                    {
                        <MudText Typo="Typo.body2" Style="color:#93a4bd;">—</MudText>
                    }
                </div>
            </MudItem>
        </MudGrid>

        @* ══ 6) الفريق ══ *@
        <div class="sec-h"><span class="dot"></span> فريق العمل <small>— الحرارة = نشاط 7 أيام · اضغط الصف للخط الزمني</small></div>
        <div class="ec-chips mb-2">
            @foreach (var f in _filters)
            {
                <button class="ec-chip @(_filter == f.Key ? "on" : "")" @onclick="() => SetFilter(f.Key)">
                    <span class="ec-dot dc-@f.Key"></span>@f.Value @if (f.Key == "all") { <text>(@_data.Employees.Count)</text> } @if (f.Key == "red") { <text>(@DormantEmployees().Count)</text> }
                </button>
            }
        </div>
        <div class="ec-card mb-4" style="padding:0; overflow:hidden;">
            <MudTable T="ExecutiveEmployeeRowDto" Items="FilteredEmployees()" Dense="true" Hover="true" Striped="true"
                      Breakpoint="Breakpoint.Sm" Elevation="0" OnRowClick="@(r => OpenTimelineAsync(r.Item.EmployeeId))">
                <HeaderContent>
                    <MudTh>الموظف</MudTh>
                    <MudTh>الوظيفة</MudTh>
                    <MudTh>الحضور اليوم</MudTh>
                    <MudTh>نشاط 7 أيام</MudTh>
                    <MudTh>إجراءات اليوم</MudTh>
                    <MudTh>آخر نشاط</MudTh>
                    <MudTh Style="text-align:end;">إنتاج الشهر</MudTh>
                    <MudTh>المهام (متأخر)</MudTh>
                    <MudTh>الحالة</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="الموظف">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <span class="ec-avatar">@context.FullName.FirstOrDefault()</span>
                            <b>@context.FullName</b>
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="الوظيفة">@context.JobTitle</MudTd>
                    <MudTd DataLabel="الحضور">@context.Attendance</MudTd>
                    <MudTd DataLabel="نشاط 7 أيام">
                        @if (context.Status == "off" || context.Status == "gray")
                        {
                            <span style="color:#93a4bd;">—</span>
                        }
                        else
                        {
                            <span class="ec-heat">
                                @foreach (var h in context.Heat7)
                                {
                                    <i style="background:@HeatColor(h)"></i>
                                }
                            </span>
                        }
                    </MudTd>
                    <MudTd DataLabel="إجراءات اليوم"><b>@context.ActionsToday</b></MudTd>
                    <MudTd DataLabel="آخر نشاط">
                        <span style="@(context.Status == "red" ? "color:#ef5350; font-weight:700;" : "")">@context.LastActivityText</span>
                    </MudTd>
                    <MudTd DataLabel="إنتاج الشهر" Style="text-align:end;">
                        @if (context.IsSales)
                        {
                            <span>@context.MonthSales.ToString("N0") ج</span>
                        }
                        else
                        {
                            <span style="color:#93a4bd;">—</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="المهام">
                        @context.TasksPending
                        @if (context.TasksOverdue > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">متأخر @context.TasksOverdue</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="الحالة">
                        <span class="ec-badge @BadgeClass(context.Status)"><i class="bd-dot"></i>@BadgeText(context.Status)</span>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>لا موظفين بهذه الحالة</NoRecordsContent>
            </MudTable>
        </div>

        @* ══ 7) لوحة المدير العام ══ *@
        <div class="sec-h"><span class="dot"></span> لوحة المدير العام <small>— قياس بالأثر</small></div>
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="12" sm="6" md="3">
                <div class="ec-card ec-gm">
                    <div class="ec-gm-h"><MudIcon Icon="@Icons.Material.Filled.Gavel" Color="Color.Warning" Style="font-size:.95rem; vertical-align:-2px;" /> آخر قراراته وإجراءاته</div>
                    @if (_data.Gm.Found)
                    {
                        <MudText Typo="Typo.body2" Class="mb-1"><b>@_data.Gm.FullName</b> — @_data.Gm.LastActivityText</MudText>
                        @foreach (var a in _data.Gm.Recent)
                        {
                            <div class="ec-gm-row"><span>@a.When</span><b>@a.What</b></div>
                        }
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Style="color:#93a4bd;">
                            لم يتم التعرف على المدير العام — اكتب «مدير عام» في حقل الوظيفة ببيانات الموظف.
                        </MudText>
                    }
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="ec-card ec-gm">
                    <div class="ec-gm-h"><MudIcon Icon="@Icons.Material.Filled.Inbox" Color="Color.Info" Style="font-size:.95rem; vertical-align:-2px;" /> طابور الانتظار عنده</div>
                    <div class="ec-gm-row"><span>طلبات تغيير أسعار</span><b style="color:@(_data.Gm.PendingPrice > 0 ? "#ef5350" : "inherit")">@_data.Gm.PendingPrice</b></div>
                    <div class="ec-gm-row"><span>شكاوى مصعَّدة</span><b style="color:@(_data.Gm.EscalatedComplaints > 0 ? "#ef5350" : "inherit")">@_data.Gm.EscalatedComplaints</b></div>
                    <div class="ec-gm-row"><span>متابعات فرص متأخرة</span><b style="color:@(_data.PipelineStalled > 0 ? "#ffc94d" : "inherit")">@_data.PipelineStalled</b></div>
                    <div class="ec-gm-row"><span>إجراءاته آخر 7 أيام</span><b>@_data.Gm.ActionsWeek</b></div>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="ec-card ec-gm">
                    <div class="ec-gm-h"><MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Success" Style="font-size:.95rem; vertical-align:-2px;" /> فريقه في سطر</div>
                    <div class="ec-gm-row"><span>مبيعات الفريق (شهر)</span><b>@_data.Gm.TeamSalesMonth.ToString("N0") ج</b></div>
                    <div class="ec-gm-row"><span>نشطون اليوم (لهم حساب)</span><b style="color:#4caf50;">@_data.Gm.TeamActiveToday / @_data.Gm.TeamTotal</b></div>
                    <div class="ec-gm-row"><span>ساكنون</span><b style="color:@(_data.DormantCount > 0 ? "#ef5350" : "inherit")">@_data.DormantCount</b></div>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="ec-card ec-gm">
                    <div class="ec-gm-h"><MudIcon Icon="@Icons.Material.Filled.Factory" Color="Color.Info" Style="font-size:.95rem; vertical-align:-2px;" /> نبض التشغيل</div>
                    <div class="ec-gm-row"><span>أوامر مصنع بانتظار الاستلام</span><b>@_data.Ops.FactoryOpen</b></div>
                    <div class="ec-gm-row"><span>استلامات المصنع (شهر)</span><b>@_data.Ops.FactoryMonth</b></div>
                    <div class="ec-gm-row"><span>Leads جديدة (شهر)</span><b>@_data.Ops.NewLeads</b></div>
                </div>
            </MudItem>
        </MudGrid>

        @* ══ 8) الاستثناءات ══ *@
        <div class="sec-h"><span class="dot"></span> استثناءات تحتاج قرارك</div>
        <div class="ec-exc mb-4">
            <div class="ec-exc-card red" @onclick="@(() => Nav.NavigateTo("/sales-delivery-status"))">
                <div class="n">@_data.Exceptions.Debts30</div>
                <div class="t">مديونات +30 يوم<br>@_data.Exceptions.Debts30Amount.ToString("N0") ج</div>
            </div>
            <div class="ec-exc-card red" @onclick="@(() => Nav.NavigateTo("/sales-delivery-status"))">
                <div class="n">@_data.Exceptions.LateDeliveries</div>
                <div class="t">تسليم متأخر<br>عن موعده</div>
            </div>
            <div class="ec-exc-card yellow" @onclick="@(() => Nav.NavigateTo("/sales/price-requests"))">
                <div class="n">@_data.Exceptions.PendingPrice</div>
                <div class="t">طلبات أسعار<br>معلقة</div>
            </div>
            <div class="ec-exc-card yellow" @onclick="@(() => Snackbar.Add("راجع تقرير المخزون — أصناف برصيد سالب تحتاج تسوية", Severity.Info))">
                <div class="n">@_data.Exceptions.NegativeStock</div>
                <div class="t">أصناف برصيد سالب</div>
            </div>
            <div class="ec-exc-card blue" @onclick="@(() => Nav.NavigateTo("/crm/leads/dashboard"))">
                <div class="n">@_data.Exceptions.StalledLeads</div>
                <div class="t">Lead بلا متابعة<br>+10 أيام</div>
            </div>
            <div class="ec-exc-card blue" @onclick="@(() => Snackbar.Add($"{_data.Exceptions.OpenComplaints} شكوى مفتوحة لدى رعاية العملاء", Severity.Info))">
                <div class="n">@_data.Exceptions.OpenComplaints</div>
                <div class="t">شكاوى عملاء<br>مفتوحة</div>
            </div>
        </div>

        <div class="ec-note">
            كل الأرقام لحظية من: الفواتير · المصروفات · الخزائن · الفرص البيعية · B2B · سجل التدقيق · الحضور · المهام · العملاء المحتملين · الشكاوى — شاشة للقراءة فقط
        </div>
    </div>
</div>
}

@* ══ دايلوج الخط الزمني ══ *@
<MudDialog @bind-Visible="_showTimeline" Options="_timelineDlgOpts">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Timeline" Color="Color.Warning" />
            <MudText Typo="Typo.h6">@_timelineName</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (_timelineLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Style="min-height:150px; justify-content:center;">
                <MudProgressCircular Indeterminate="true" Color="Color.Warning" />
            </MudStack>
        }
        else
        {
            <MudTimeline TimelineOrientation="TimelineOrientation.Vertical" TimelinePosition="TimelinePosition.Start">
                @foreach (var row in _timelineRows)
                {
                    <MudTimelineItem Size="Size.Small"
                                     Color="@(row.Kind == "invoice" ? Color.Warning : Color.Info)"
                                     Variant="Variant.Outlined">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@row.When.ToString("yyyy/MM/dd hh:mm tt")</MudText>
                        <MudText Typo="Typo.body2">@row.What</MudText>
                    </MudTimelineItem>
                }
                @if (_timelineRows.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">لا يوجد سجل بعد</MudText>
                }
            </MudTimeline>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showTimeline = false)">إغلاق</MudButton>
    </DialogActions>
</MudDialog>

@* ══ دايلوج القرارات ══ *@
<MudDialog @bind-Visible="_showDecisions">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Gavel" Color="Color.Warning" />
            <MudText Typo="Typo.h6">بنود في انتظارك</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (_data != null)
        {
            <MudList T="string" Dense="true">
                @if (_data.Exceptions.PendingPrice > 0)
                {
                    <MudListItem T="string" Icon="@Icons.Material.Filled.RequestQuote" IconColor="Color.Error">
                        @_data.Exceptions.PendingPrice طلب تغيير أسعار معلق — <MudLink Href="/sales/price-requests">اعتماد/رفض</MudLink>
                    </MudListItem>
                }
                @if (_data.Gm.EscalatedComplaints > 0)
                {
                    <MudListItem T="string" Icon="@Icons.Material.Filled.ReportProblem" IconColor="Color.Error">
                        @_data.Gm.EscalatedComplaints شكوى مصعَّدة للمدير العام
                    </MudListItem>
                }
                @if (_data.DormantCount > 0)
                {
                    <MudListItem T="string" Icon="@Icons.Material.Filled.PersonOff" IconColor="Color.Warning">
                        @_data.DormantCount موظف ساكن 3+ أيام — إنذار / متابعة / إعادة توزيع
                    </MudListItem>
                }
            </MudList>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showDecisions = false)">إغلاق</MudButton>
    </DialogActions>
</MudDialog>

