    private RenderFragment CmpChip(decimal? pct, bool invert, string caption) => builder =>
    {
        builder.OpenElement(0, "span");
        if (pct == null)
        {
            // لا أساس للمقارنة (الفترة المقابلة صفر) — «—» بدل 0% المضللة
            builder.AddAttribute(1, "class", "ec-cmp ec-flat");
            builder.AddContent(2, $"— {caption}");
        }
        else
        {
            var p = pct.Value;
            var good = invert ? p <= 0 : p >= 0;
            var cls = p == 0 ? "ec-flat" : good ? "ec-up" : "ec-down";
            var arr = p > 0 ? "▲" : p < 0 ? "▼" : "•";
            builder.AddAttribute(1, "class", $"ec-cmp {cls}");
            // السهم والرقم وعلامة % داخل عنصر LTR معزول الاتجاه — وإلا خلطت
            // خوارزمية الاتجاه الثنائي ترتيبها داخل الصفحة العربية (كانت
            // تظهر مقلوبة مثل «%1.5+» بدل «+1.5%»).
            builder.OpenElement(2, "span");
            builder.AddAttribute(3, "dir", "ltr");
            builder.AddAttribute(4, "style", "unicode-bidi:isolate;");
            builder.AddContent(5, $"{arr} {Math.Abs(p)}%");
            builder.CloseElement();
            builder.AddContent(6, $" {caption}");
        }
        builder.CloseElement();
    };

    // درجات حرارة النشاط بألوان صلبة مقروءة على الثيم الفاتح
    private static string HeatColor(int count)
        => count == 0 ? "#FCA5A5"
         : count <= 2 ? "#FBBF24"
         : count <= 4 ? "#34D399"
         : "#059669";

