@page "/products/price-list"
@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Models
@using COCOBOLOERPNEW.Services
@using COCOBOLOERPNEW.Components.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject IPriceListService PriceListService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<ProductsPriceList> Logger

@attribute [Authorize]

<PageTitle>قائمة الأسعار</PageTitle>

<style>
    /* ══════════════════════════════════════════════════════
       VARIABLES
    ══════════════════════════════════════════════════════ */
    :root {
        --gold:          #d4af37;
        --gold-light:    #e8c855;
        --gold-dark:     #b8941f;
        --gold-subtle:   rgba(212,175,55,.07);
        --gold-glow:     rgba(212,175,55,.25);
        --std-color:     #64748b;
        --prem-color:    #6366f1;
        --elite-color:   #d4af37;
        --up-color:      #22c55e;
        --down-color:    #ef4444;
        --radius-sm:     8px;
        --radius-md:     12px;
        --radius-lg:     16px;
        --radius-xl:     20px;
        --radius-2xl:    26px;
        --shadow-gold:   0 0 0 2px rgba(212,175,55,.3), 0 8px 32px rgba(212,175,55,.18);
        --transition:    all .2s cubic-bezier(.4,0,.2,1);
    }

    /* ══════════════════════════════════════════════════════
       HERO — Enhanced
    ══════════════════════════════════════════════════════ */
    .pl-hero {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
        background: linear-gradient(135deg, #020810 0%, #060C18 30%, #0D1B30 65%, #132A47 100%);
        border-radius: var(--radius-2xl);
        padding: 28px 32px;
        margin-bottom: 22px;
        border: 1px solid rgba(212,175,55,.22);
        box-shadow: 0 20px 60px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.05);
    }
    /* خطوط شبكية خلفية */
    .pl-hero::before {
        content: '';
        position: absolute; inset: 0;
        background-image:
            linear-gradient(rgba(212,175,55,.04) 1px, transparent 1px),
            linear-gradient(90deg, rgba(212,175,55,.04) 1px, transparent 1px);
        background-size: 32px 32px;
        pointer-events: none;
    }
    /* توهج ذهبي يسار */
    .pl-hero-glow-l {
        position: absolute; left: -60px; top: -60px;
        width: 320px; height: 320px; border-radius: 50%;
        background: radial-gradient(circle, rgba(212,175,55,.14) 0%, transparent 65%);
        pointer-events: none; animation: pl-glow-pulse 4s ease-in-out infinite;
    }
    /* توهج بنفسجي يمين */
    .pl-hero-glow-r {
        position: absolute; right: 60px; bottom: -80px;
        width: 280px; height: 280px; border-radius: 50%;
        background: radial-gradient(circle, rgba(99,102,241,.1) 0%, transparent 65%);
        pointer-events: none; animation: pl-glow-pulse 4s ease-in-out infinite .8s;
    }
    @@keyframes pl-glow-pulse {
        0%,100% { opacity: .7; transform: scale(1); }
        50%      { opacity: 1;  transform: scale(1.08); }
    }
    .pl-hero-left {
        display: flex; align-items: center; gap: 18px; z-index: 1; flex: 1;
    }
    .pl-hero-icon {
        position: relative;
        width: 62px; height: 62px;
        border-radius: 18px;
        display: flex; align-items: center; justify-content: center;
        background: linear-gradient(135deg, rgba(212,175,55,.2), rgba(212,175,55,.05));
        border: 1px solid rgba(212,175,55,.35);
        color: var(--gold);
        font-size: 1.9rem;
        flex-shrink: 0;
        box-shadow: 0 8px 24px rgba(212,175,55,.18), inset 0 1px 0 rgba(255,255,255,.08);
    }
    .pl-hero-icon::after {
        content: '';
        position: absolute; inset: -1px;
        border-radius: 19px;
        background: linear-gradient(135deg, rgba(212,175,55,.4), transparent 60%);
        pointer-events: none;
    }
    .pl-hero-text { z-index: 1; }
    .pl-hero-eyebrow {
        display: inline-flex; align-items: center; gap: 6px;
        font-size: 10.5px; font-weight: 700;
        color: var(--gold);
        letter-spacing: 1.2px; text-transform: uppercase;
        background: rgba(212,175,55,.1);
        border: 1px solid rgba(212,175,55,.2);
        border-radius: 100px;
        padding: 3px 10px; margin-bottom: 8px;
    }
    .pl-hero-title {
        margin: 0 0 6px;
        font-size: 1.75rem; font-weight: 900;
        color: #fff; line-height: 1.15;
        letter-spacing: -.3px;
        text-shadow: 0 2px 20px rgba(0,0,0,.3);
    }
    .pl-hero-title span { color: var(--gold); }
    .pl-hero-sub {
        margin: 0; font-size: .82rem;
        color: rgba(255,255,255,.55);
        line-height: 1.6;
    }
    .pl-hero-badges {
        display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap;
    }
    .pl-hero-badge {
        display: inline-flex; align-items: center; gap: 4px;
        font-size: .68rem; font-weight: 700;
        padding: 3px 9px; border-radius: 100px;
        border: 1px solid rgba(255,255,255,.1);
        color: rgba(255,255,255,.6);
        background: rgba(255,255,255,.05);
    }
    /* Stats */
    .pl-hero-right { display: flex; flex-direction: column; align-items: flex-end; gap: 12px; z-index: 1; }
    .pl-hero-stats { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
    .pl-stat {
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(255,255,255,.09);
        border-radius: var(--radius-lg);
        padding: 14px 22px;
        display: flex; flex-direction: column; align-items: center; gap: 3px;
        min-width: 108px;
        cursor: pointer;
        transition: var(--transition);
        position: relative; overflow: hidden;
    }
    .pl-stat::after {
        content: '';
        position: absolute; bottom: 0; left: 0; right: 0;
        height: 2px; background: var(--gold);
        transform: scaleX(0); transition: transform .2s;
    }
    .pl-stat:hover { transform: translateY(-4px); border-color: rgba(212,175,55,.35); box-shadow: 0 12px 32px rgba(0,0,0,.25); }
    .pl-stat:hover::after { transform: scaleX(1); }
    .pl-stat.act { border-color: var(--gold); box-shadow: var(--shadow-gold); }
    .pl-stat.act::after { transform: scaleX(1); }
    .pl-stat.act.act-green { border-color: #4ade80; box-shadow: 0 0 0 2px rgba(74,222,128,.2), 0 8px 24px rgba(74,222,128,.12); }
    .pl-stat.act.act-green::after { background: #4ade80; }
    .pl-stat.act.act-warn  { border-color: #fbbf24; box-shadow: 0 0 0 2px rgba(251,191,36,.2), 0 8px 24px rgba(251,191,36,.12); }
    .pl-stat.act.act-warn::after { background: #fbbf24; }
    .pl-stat.act.act-cyan  { border-color: #22d3ee; box-shadow: 0 0 0 2px rgba(34,211,238,.2), 0 8px 24px rgba(34,211,238,.12); }
    .pl-stat.act.act-cyan::after { background: #22d3ee; }
    .pl-stat-icon-wrap {
        width: 30px; height: 30px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
        background: rgba(212,175,55,.12); margin-bottom: 5px;
    }
    .pl-stat-icon-wrap.green { background: rgba(74,222,128,.12); }
    .pl-stat-icon-wrap.warn  { background: rgba(251,191,36,.12); }
    .pl-stat-icon-wrap.cyan  { background: rgba(34,211,238,.12); }
    .pl-stat-icon-wrap.cyan  .pl-stat-ico { color: #22d3ee; }
    .pl-stat-ico { font-size: 15px !important; color: var(--gold); }
    .pl-stat-icon-wrap.green .pl-stat-ico { color: #4ade80; }
    .pl-stat-icon-wrap.warn  .pl-stat-ico { color: #fbbf24; }
    .pl-stat-num  { font-size: 1.5rem; font-weight: 900; color: #fff; line-height: 1; font-variant-numeric: tabular-nums; }
    .pl-stat-ok   { color: #4ade80; }
    .pl-stat-warn { color: #fbbf24; }
    .pl-stat-cyan { color: #22d3ee; }
    .pl-stat-lbl  { font-size: .67rem; color: rgba(255,255,255,.5); font-weight: 600; letter-spacing: .3px; }
    /* Keyboard hint */
    .pl-hero-kb {
        display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end;
    }
    .pl-kb-hint {
        display: inline-flex; align-items: center; gap: 4px;
        font-size: .64rem; color: rgba(255,255,255,.35);
    }
    .pl-kb-hint kbd {
        display: inline-flex; align-items: center; justify-content: center;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 4px; padding: 1px 5px;
        font-size: .62rem; font-family: monospace;
        color: rgba(255,255,255,.6);
    }

    /* ══════════════════════════════════════════════════════
       ACTIVE FILTERS CHIPS
    ══════════════════════════════════════════════════════ */
    .pl-active-filters {
        display: flex; align-items: center; gap: 8px;
        flex-wrap: wrap; margin-bottom: 14px;
        padding: 10px 14px;
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-divider);
        border-radius: var(--radius-md);
        animation: pl-fade-in .2s ease;
    }
    .pl-active-filters-label {
        font-size: 11px; font-weight: 700;
        color: var(--mud-palette-text-secondary);
        text-transform: uppercase; letter-spacing: .5px;
        white-space: nowrap;
    }
    .pl-filter-chip {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 4px 10px; border-radius: 100px;
        background: rgba(212,175,55,.1);
        border: 1px solid rgba(212,175,55,.3);
        color: var(--gold-dark); font-size: 12px; font-weight: 600;
        cursor: pointer; transition: var(--transition);
    }
    .pl-filter-chip:hover { background: rgba(212,175,55,.2); }
    .pl-filter-chip .chip-x {
        width: 14px; height: 14px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: rgba(212,175,55,.3); font-size: 9px; font-weight: 900;
    }
    .pl-filter-chip-clear {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 4px 10px; border-radius: 100px;
        background: rgba(239,68,68,.08);
        border: 1px solid rgba(239,68,68,.2);
        color: #ef4444; font-size: 11px; font-weight: 700;
        cursor: pointer; transition: var(--transition);
        margin-right: auto;
    }
    .pl-filter-chip-clear:hover { background: rgba(239,68,68,.15); }

    /* ══════════════════════════════════════════════════════
       TOOLBAR
    ══════════════════════════════════════════════════════ */
    .pl-toolbar {
        background: var(--mud-palette-surface);
        border-radius: var(--radius-lg);
        border: 1px solid var(--mud-palette-divider);
        padding: 16px 18px; margin-bottom: 14px;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
    }
    .pl-toolbar-row1 {
        display: grid;
        grid-template-columns: 1.8fr 1fr 1fr auto;
        gap: 10px; align-items: center;
    }
    .pl-search-wrap { position: relative; display: flex; align-items: center; }
    .pl-search-ico  { position: absolute; right: 12px; color: var(--mud-palette-text-secondary) !important; font-size: 18px !important; pointer-events: none; z-index: 1; }
    .pl-search-input {
        width: 100%;
        background: var(--mud-palette-background-grey, rgba(0,0,0,.04));
        border: 1.5px solid var(--mud-palette-divider);
        border-radius: var(--radius-sm);
        color: var(--mud-palette-text-primary);
        font-size: 14px; font-family: inherit;
        padding: 10px 42px 10px 36px;
        outline: none;
        transition: var(--transition);
        direction: rtl; box-sizing: border-box;
    }
    .pl-search-input:focus { border-color: var(--gold); box-shadow: 0 0 0 3px rgba(212,175,55,.12); background: var(--mud-palette-surface); }
    .pl-search-input::placeholder { color: var(--mud-palette-text-secondary); opacity: .6; }
    .pl-search-clear {
        position: absolute; left: 10px; width: 24px; height: 24px;
        border: 0; background: rgba(100,116,139,.15); border-radius: 50%;
        cursor: pointer; display: flex; align-items: center; justify-content: center;
        color: var(--mud-palette-text-secondary); transition: var(--transition);
    }
    .pl-search-clear:hover { background: rgba(239,68,68,.2); color: #ef4444; }
    .pl-toolbar-actions { display: flex; gap: 6px; }
    .pl-icon-btn {
        width: 38px; height: 38px; border-radius: var(--radius-sm);
        border: 1.5px solid var(--mud-palette-divider);
        background: transparent; color: var(--mud-palette-text-secondary);
        cursor: pointer; display: flex; align-items: center; justify-content: center;
        transition: var(--transition); position: relative;
    }
    .pl-icon-btn:hover { border-color: var(--gold); color: var(--gold); background: var(--gold-subtle); transform: translateY(-1px); }
    .pl-icon-btn.active-warn { border-color: #fbbf24; color: #f59e0b; background: rgba(251,191,36,.1); }
    .pl-icon-btn .pl-kb-badge {
        position: absolute; top: -6px; right: -6px;
        background: var(--mud-palette-background-grey);
        border: 1px solid var(--mud-palette-divider);
        border-radius: 4px; font-size: 8px; padding: 0 3px;
        color: var(--mud-palette-text-secondary); font-family: monospace;
    }
    .pl-toolbar-row2 { display: flex; align-items: center; gap: 10px; margin-top: 12px; flex-wrap: wrap; }
    .pl-view-switcher {
        display: flex;
        background: var(--mud-palette-background-grey, rgba(0,0,0,.04));
        border-radius: var(--radius-sm); padding: 3px; gap: 2px;
    }
    .pl-view-btn {
        display: flex; align-items: center; gap: 5px;
        padding: 6px 13px; border-radius: 6px; border: 0;
        background: transparent; color: var(--mud-palette-text-secondary);
        font-size: 12px; font-weight: 600; cursor: pointer;
        transition: var(--transition); font-family: inherit;
    }
    .pl-view-btn:hover { color: var(--mud-palette-text-primary); }
    .pl-view-btn.active { background: var(--mud-palette-surface); color: var(--gold); box-shadow: 0 1px 4px rgba(0,0,0,.12); }
    .pl-view-btn .vb-kb { font-size: 9px; opacity: .5; margin-right: 2px; font-family: monospace; }
    .pl-tier-switcher {
        display: flex; align-items: center; gap: 3px; padding: 3px;
        background: var(--mud-palette-background-grey, rgba(0,0,0,.04));
        border-radius: var(--radius-sm);
    }
    .pl-tier-btn {
        display: flex; align-items: center; gap: 5px;
        padding: 6px 14px; border-radius: 6px; border: 0;
        background: transparent; color: var(--mud-palette-text-secondary);
        font-size: 12px; font-weight: 600; cursor: pointer;
        transition: var(--transition); font-family: inherit;
    }
    .pl-tier-btn:hover { color: var(--mud-palette-text-primary); }
    .pl-tier-btn.active { background: var(--mud-palette-surface); font-weight: 700; box-shadow: 0 1px 4px rgba(0,0,0,.12); }
    .pl-tier-btn.std.active   { color: var(--std-color); }
    .pl-tier-btn.prem.active  { color: var(--prem-color); }
    .pl-tier-btn.elite.active { color: var(--gold); }
    .pl-toolbar-end { display: flex; align-items: center; gap: 10px; margin-right: auto; }
    .pl-results-badge {
        font-size: 12px; font-weight: 700;
        color: var(--mud-palette-text-secondary);
        background: var(--mud-palette-background-grey, rgba(0,0,0,.04));
        border: 1px solid var(--mud-palette-divider);
        border-radius: 100px; padding: 5px 14px; white-space: nowrap;
    }
    /* Saved Views */
    .pl-saved-views { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .pl-saved-view-chip {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 4px 10px; border-radius: 100px; cursor: pointer;
        background: rgba(99,102,241,.08); border: 1px solid rgba(99,102,241,.25);
        color: var(--prem-color); font-size: 11px; font-weight: 600;
        transition: var(--transition);
    }
    .pl-saved-view-chip:hover { background: rgba(99,102,241,.15); }
    .pl-saved-view-chip .sv-del { font-size: 10px; opacity: .6; cursor: pointer; }
    .pl-saved-view-chip .sv-del:hover { opacity: 1; color: #ef4444; }
    .pl-save-view-btn {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 4px 10px; border-radius: 100px; cursor: pointer;
        background: transparent; border: 1.5px dashed var(--mud-palette-divider);
        color: var(--mud-palette-text-secondary); font-size: 11px; font-weight: 600;
        transition: var(--transition); font-family: inherit;
    }
    .pl-save-view-btn:hover { border-color: var(--gold); color: var(--gold); background: var(--gold-subtle); }

    /* ══════════════════════════════════════════════════════
       DOTS & SHARED
    ══════════════════════════════════════════════════════ */
    .ch-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; flex-shrink: 0; }
    .d-std   { background: var(--std-color); }
    .d-prem  { background: var(--prem-color); }
    .d-elite { background: var(--gold); box-shadow: 0 0 6px rgba(212,175,55,.5); }
    .pl-code-link { color: var(--mud-palette-text-secondary); text-decoration: none; font-variant-numeric: tabular-nums; border-bottom: 1px dashed rgba(100,116,139,.4); transition: var(--transition); font-size: .74rem; font-weight: 600; }
    .pl-code-link:hover { color: var(--gold-dark); border-color: var(--gold); }
    .pl-clickable { cursor: zoom-in; }
    .pl-footnote { padding: 10px 16px; font-size: .7rem; color: var(--mud-palette-text-secondary); border-top: 1px solid var(--mud-palette-divider); }

    /* ══════════════════════════════════════════════════════
       SEARCH HIGHLIGHT
    ══════════════════════════════════════════════════════ */
    .pl-highlight { background: rgba(212,175,55,.35); color: var(--gold-dark); border-radius: 3px; padding: 0 2px; font-weight: 700; }

    /* ══════════════════════════════════════════════════════
       PRICE PULSE ANIMATION
    ══════════════════════════════════════════════════════ */
    .pl-price-pulse {
        position: absolute; top: 8px; left: 8px; z-index: 3;
        display: flex; align-items: center; gap: 3px;
        font-size: .62rem; font-weight: 800;
        padding: 2px 8px; border-radius: 100px;
        backdrop-filter: blur(6px);
    }
    .pl-price-pulse.up   { background: rgba(22,101,52,.85); color: #bbf7d0; border: 1px solid rgba(34,197,94,.3); animation: pl-pulse-up 2s ease-in-out infinite; }
    .pl-price-pulse.down { background: rgba(127,29,29,.85);  color: #fecaca; border: 1px solid rgba(239,68,68,.3);  animation: pl-pulse-dn 2s ease-in-out infinite; }
    @@keyframes pl-pulse-up { 0%,100% { box-shadow: 0 0 0 0 rgba(34,197,94,.4); } 50% { box-shadow: 0 0 0 5px rgba(34,197,94,0); } }
    @@keyframes pl-pulse-dn { 0%,100% { box-shadow: 0 0 0 0 rgba(239,68,68,.4); } 50% { box-shadow: 0 0 0 5px rgba(239,68,68,0); } }

    /* ══════════════════════════════════════════════════════
       LOADING SKELETON
    ══════════════════════════════════════════════════════ */
    .pl-loading-bar { height: 3px; background: var(--mud-palette-background-grey); border-radius: 2px; overflow: hidden; margin-bottom: 18px; }
    .pl-loading-fill { height: 100%; width: 35%; background: linear-gradient(90deg, var(--gold), var(--prem-color), var(--gold)); background-size: 200% 100%; border-radius: 2px; animation: pl-load-slide 1.6s ease-in-out infinite; }
    @@keyframes pl-load-slide { 0% { transform: translateX(300%); } 100% { transform: translateX(-100%); } }
    .pl-loading-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
    .pl-skeleton-card { background: var(--mud-palette-surface); border-radius: var(--radius-lg); border: 1px solid var(--mud-palette-divider); overflow: hidden; }
    .pl-skel { background: linear-gradient(90deg, var(--mud-palette-background-grey) 25%, rgba(255,255,255,.06) 50%, var(--mud-palette-background-grey) 75%); background-size: 200% 100%; animation: pl-shimmer 1.8s infinite; border-radius: 6px; }
    @@keyframes pl-shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
    .pl-skel-img   { height: 165px; border-radius: 0; }
    .pl-skel-body  { padding: 14px; display: flex; flex-direction: column; gap: 9px; }
    .pl-skel-title { height: 16px; width: 78%; }
    .pl-skel-sub   { height: 12px; width: 48%; }
    .pl-skel-price { height: 34px; width: 100%; }

    /* ══════════════════════════════════════════════════════
       EMPTY STATE
    ══════════════════════════════════════════════════════ */
    .pl-empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 80px 20px; text-align: center; gap: 10px; }
    .pl-empty-icon { width: 76px; height: 76px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--mud-palette-background-grey); color: var(--mud-palette-text-secondary); font-size: 2.4rem !important; margin-bottom: 8px; }
    .pl-empty-state h3 { margin: 0; font-size: 1.1rem; color: var(--mud-palette-text-primary); }
    .pl-empty-state p  { margin: 0; font-size: .85rem; color: var(--mud-palette-text-secondary); }
    .pl-empty-reset { display: flex; align-items: center; gap: 6px; margin-top: 10px; padding: 9px 20px; border-radius: var(--radius-sm); border: 1.5px solid var(--mud-palette-divider); background: transparent; color: var(--mud-palette-text-secondary); font-size: 13px; font-family: inherit; cursor: pointer; transition: var(--transition); }
    .pl-empty-reset:hover { border-color: var(--gold); color: var(--gold); background: var(--gold-subtle); transform: translateY(-1px); }

    /* ══════════════════════════════════════════════════════
       GRID VIEW
    ══════════════════════════════════════════════════════ */
    .pl-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(245px, 1fr)); gap: 15px; }
    .plg-card {
        background: var(--mud-palette-surface);
        border-radius: var(--radius-lg);
        border: 1px solid var(--mud-palette-divider);
        overflow: hidden; display: flex; flex-direction: column;
        transition: transform .22s cubic-bezier(.34,1.56,.64,1), box-shadow .22s ease, border-color .22s ease;
        position: relative;
    }
    .plg-card:hover { transform: translateY(-6px); border-color: rgba(212,175,55,.4); box-shadow: 0 20px 48px rgba(0,0,0,.14), 0 0 0 1px rgba(212,175,55,.18); }
    .plg-card.selected { border-color: var(--prem-color); box-shadow: 0 0 0 2px rgba(99,102,241,.3); }
    /* Compare checkbox */
    .plg-compare-cb {
        position: absolute; top: 10px; right: 10px; z-index: 4;
        width: 22px; height: 22px; border-radius: 6px;
        background: rgba(0,0,0,.5); border: 2px solid rgba(255,255,255,.4);
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; transition: var(--transition);
        backdrop-filter: blur(4px);
        opacity: 0;
    }
    .plg-card:hover .plg-compare-cb, .plg-compare-cb.checked { opacity: 1; }
    .plg-compare-cb.checked { background: var(--prem-color); border-color: var(--prem-color); }
    .plg-img-wrap { position: relative; width: 100%; padding-top: 65%; background: var(--mud-palette-background-grey); overflow: hidden; }
    .plg-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .38s cubic-bezier(.4,0,.2,1); }
    .plg-card:hover .plg-img { transform: scale(1.07); }
    .plg-stock-badge { position: absolute; bottom: 10px; right: 10px; display: flex; align-items: center; gap: 4px; font-size: .66rem; font-weight: 800; padding: 3px 9px; border-radius: 100px; backdrop-filter: blur(6px); z-index: 2; }
    .plg-stock-badge.in-stock  { background: rgba(22,101,52,.88); color: #bbf7d0; border: 1px solid rgba(74,222,128,.3); }
    .plg-stock-badge.out-stock { background: rgba(127,29,29,.88); color: #fecaca; border: 1px solid rgba(252,129,129,.3); }
    .plg-pending-badge { position: absolute; top: 10px; left: 10px; display: flex; align-items: center; gap: 4px; font-size: .64rem; font-weight: 800; padding: 3px 8px; border-radius: 100px; background: rgba(120,53,15,.9); color: #fef3c7; border: 1px solid rgba(251,191,36,.4); backdrop-filter: blur(6px); z-index: 2; }
    .plg-zoom-btn { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,.3); opacity: 0; transition: opacity .2s; z-index: 1; }
    .plg-zoom-btn-inner { width: 44px; height: 44px; border-radius: 50%; background: rgba(255,255,255,.15); border: 2px solid rgba(255,255,255,.4); display: flex; align-items: center; justify-content: center; color: #fff; backdrop-filter: blur(4px); }
    .plg-card:hover .plg-zoom-btn { opacity: 1; }
    .plg-body { padding: 14px; display: flex; flex-direction: column; flex: 1; }
    .plg-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; margin-bottom: 4px; }
    .plg-name { font-weight: 700; font-size: .88rem; line-height: 1.5; color: var(--mud-palette-text-primary); overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .plg-code { font-size: .68rem; font-weight: 700; color: var(--mud-palette-text-secondary); text-decoration: none; background: var(--mud-palette-background-grey); border-radius: 4px; padding: 2px 6px; white-space: nowrap; flex-shrink: 0; transition: var(--transition); }
    .plg-code:hover { color: var(--gold); background: var(--gold-subtle); }
    .plg-group { display: flex; align-items: center; gap: 4px; font-size: .7rem; color: var(--mud-palette-text-secondary); margin-bottom: 10px; }
    /* Price rows */
    .plg-prices { display: flex; flex-direction: column; gap: 5px; margin-bottom: 12px; }
    .plg-price-row { display: flex; align-items: center; justify-content: space-between; padding: 8px 11px; border-radius: var(--radius-sm); border: 1px solid var(--mud-palette-divider); background: var(--mud-palette-background-grey, rgba(0,0,0,.03)); transition: var(--transition); }
    .plg-price-row.highlighted { border-width: 1.5px; }
    .plg-price-row.std.highlighted   { border-color: rgba(100,116,139,.5); background: rgba(100,116,139,.07); }
    .plg-price-row.prem.highlighted  { border-color: rgba(99,102,241,.45); background: rgba(99,102,241,.07); }
    .plg-price-row.elite.highlighted { border-color: rgba(212,175,55,.55); background: rgba(212,175,55,.08); }
    .plg-price-tier { display: flex; align-items: center; gap: 6px; font-size: .72rem; color: var(--mud-palette-text-secondary); font-weight: 600; }
    .plg-price-val  { display: flex; align-items: baseline; gap: 3px; }
    .plg-price-val b { font-size: .92rem; font-weight: 800; font-variant-numeric: tabular-nums; color: var(--mud-palette-text-primary); }
    .plg-currency   { font-size: .68rem; color: var(--mud-palette-text-secondary); font-weight: 600; }
    .plg-no-price   { font-size: .8rem; color: var(--mud-palette-text-secondary); opacity: .45; }
    /* Price comparison bar */
    .plg-compare-bar { margin: -4px 0 10px; }
    .plg-bar-track { height: 4px; background: var(--mud-palette-divider); border-radius: 2px; overflow: hidden; margin-bottom: 2px; }
    .plg-bar-fill-std  { height: 100%; background: var(--std-color);  border-radius: 2px; transition: width .4s ease; }
    .plg-bar-fill-prem { height: 100%; background: var(--prem-color); border-radius: 2px; transition: width .4s ease; }
    .plg-bar-fill-elite { height: 100%; background: var(--gold); border-radius: 2px; transition: width .4s ease; }
    /* Actions */
    .plg-actions { display: flex; align-items: center; gap: 6px; margin-top: auto; padding-top: 10px; border-top: 1px solid var(--mud-palette-divider); }
    .plg-action-ghost { width: 34px; height: 34px; border-radius: var(--radius-sm); border: 1px solid var(--mud-palette-divider); background: transparent; color: var(--mud-palette-text-secondary); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: var(--transition); }
    .plg-action-ghost:hover { border-color: var(--gold); color: var(--gold); background: var(--gold-subtle); transform: translateY(-1px); }
    .plg-action-primary, .plg-action-secondary { flex: 1; display: flex; align-items: center; justify-content: center; gap: 6px; padding: 7px 12px; border-radius: var(--radius-sm); border: 0; font-size: 12px; font-weight: 700; font-family: inherit; cursor: pointer; transition: var(--transition); }
    .plg-action-primary   { background: var(--mud-palette-primary, #594ae2); color: #fff; }
    .plg-action-primary:hover   { opacity: .88; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(89,74,226,.3); }
    .plg-action-secondary { background: var(--gold-subtle); color: var(--gold-dark); border: 1px solid rgba(212,175,55,.3); }
    .plg-action-secondary:hover { background: rgba(212,175,55,.15); transform: translateY(-1px); }

    /* ══════════════════════════════════════════════════════
       LIST VIEW
    ══════════════════════════════════════════════════════ */
    .pl-list { background: var(--mud-palette-surface); border-radius: var(--radius-lg); border: 1px solid var(--mud-palette-divider); overflow: hidden; }
    .pll-row { display: flex; align-items: center; gap: 14px; padding: 10px 16px; border-bottom: 1px solid var(--mud-palette-divider); transition: background .15s; cursor: default; }
    .pll-row:last-child { border-bottom: none; }
    .pll-row:hover { background: var(--gold-subtle); }
    .pll-thumb { width: 46px; height: 46px; border-radius: var(--radius-sm); object-fit: cover; background: var(--mud-palette-background-grey); border: 1px solid var(--mud-palette-divider); flex-shrink: 0; cursor: zoom-in; transition: var(--transition); }
    .pll-thumb:hover { transform: scale(1.1); box-shadow: 0 4px 14px rgba(0,0,0,.15); }
    .pll-info { display: flex; flex-direction: column; min-width: 0; flex: 1; }
    .pll-name { font-weight: 700; font-size: .86rem; color: var(--mud-palette-text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pll-meta { display: flex; align-items: center; gap: 4px; font-size: .7rem; color: var(--mud-palette-text-secondary); margin-top: 2px; }
    .pll-sep  { opacity: .4; }
    .pll-prices { display: flex; gap: 6px; align-items: center; }
    .pll-price-chip { display: flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 100px; font-size: .76rem; font-weight: 700; border: 1px solid var(--mud-palette-divider); background: var(--mud-palette-background-grey); font-variant-numeric: tabular-nums; transition: opacity .2s; }
    .pll-price-chip.prem  { border-color: rgba(99,102,241,.3);  background: rgba(99,102,241,.06); }
    .pll-price-chip.elite { border-color: rgba(212,175,55,.4);  background: rgba(212,175,55,.07); }
    .pll-price-chip.dim   { opacity: .3; filter: saturate(.3); }
    .pll-stock { font-size: .72rem; font-weight: 800; padding: 3px 10px; border-radius: 100px; white-space: nowrap; }
    .pll-stock.ok  { background: rgba(76,175,80,.1);  color: #2e7d32; }
    .pll-stock.out { background: rgba(244,67,54,.1); color: #c62828; }
    .pll-actions { display: flex; gap: 4px; }
    .pll-btn { width: 32px; height: 32px; border-radius: var(--radius-sm); border: 1px solid var(--mud-palette-divider); background: transparent; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: var(--transition); color: var(--mud-palette-text-secondary); }
    .pll-btn.ghost:hover    { border-color: var(--gold); color: var(--gold); background: var(--gold-subtle); }
    .pll-btn.primary        { background: var(--mud-palette-primary, #594ae2); color: #fff; border-color: transparent; }
    .pll-btn.primary:hover  { opacity: .85; }
    .pll-btn.secondary      { border-color: rgba(212,175,55,.4); color: var(--gold-dark); }
    .pll-btn.secondary:hover { background: var(--gold-subtle); }
    .pll-btn.warn           { border-color: rgba(251,191,36,.4); color: #d97706; }
    .pll-btn:disabled       { opacity: .45; cursor: not-allowed; }

    /* ══════════════════════════════════════════════════════
       TABLE VIEW — with Collapsible Groups
    ══════════════════════════════════════════════════════ */
    .pl-table-wrap { background: var(--mud-palette-surface); border-radius: var(--radius-lg); border: 1px solid var(--mud-palette-divider); overflow: hidden; }
    .pl-table { width: 100%; border-collapse: collapse; min-width: 560px; }
    .pl-table thead th { background: var(--mud-palette-background-grey); font-size: .72rem; font-weight: 800; color: var(--mud-palette-text-secondary); padding: 11px 14px; text-align: right; border-bottom: 2px solid var(--mud-palette-divider); letter-spacing: .3px; white-space: nowrap; }
    .th-img     { width: 60px; }
    .th-code    { width: 72px; }
    .th-price   { width: 100px; text-align: center !important; }
    .th-stock   { width: 90px;  text-align: center !important; }
    .th-actions { width: 80px; }
    .th-price.dim { opacity: .35; }
    /* Group Row */
    .pl-group-row { background: var(--mud-palette-background-grey); cursor: pointer; }
    .pl-group-row:hover { background: var(--gold-subtle); }
    .pl-group-cell { padding: 9px 14px; font-size: .8rem; font-weight: 800; color: var(--mud-palette-text-primary); display: flex; align-items: center; gap: 8px; }
    .pl-group-arrow { transition: transform .2s; font-size: 16px !important; color: var(--mud-palette-text-secondary); }
    .pl-group-arrow.open { transform: rotate(90deg); }
    .pl-group-badge { font-size: .68rem; font-weight: 700; padding: 2px 8px; border-radius: 100px; background: rgba(212,175,55,.12); color: var(--gold-dark); border: 1px solid rgba(212,175,55,.25); }
    .pl-group-divider { height: 3px; background: linear-gradient(90deg, var(--gold), transparent); opacity: .3; }
    .pl-table-row { transition: background .15s; }
    .pl-table-row:hover { background: var(--gold-subtle); }
    .pl-table tbody td { padding: 8px 14px; border-bottom: 1px solid var(--mud-palette-divider); vertical-align: middle; }
    .pl-table tbody tr:last-child td { border-bottom: none; }
    .plt-thumb { width: 44px; height: 44px; border-radius: var(--radius-sm); object-fit: cover; background: var(--mud-palette-background-grey); border: 1px solid var(--mud-palette-divider); cursor: zoom-in; display: block; transition: var(--transition); }
    .plt-thumb:hover { transform: scale(1.12); box-shadow: 0 4px 14px rgba(0,0,0,.15); }
    .td-code   { font-size: .74rem; text-align: center; }
    .plt-name  { font-weight: 700; font-size: .84rem; }
    .plt-group { font-size: .7rem; color: var(--mud-palette-text-secondary); margin-top: 2px; }
    .td-price  { text-align: center; transition: opacity .2s; }
    .td-price.dim { opacity: .3; filter: saturate(.3); }
    .td-price.active-col { background: rgba(212,175,55,.04); }
    .plt-price-val { display: inline-block; padding: 4px 10px; border-radius: 100px; font-size: .8rem; font-weight: 800; font-variant-numeric: tabular-nums; background: var(--mud-palette-background-grey); border: 1px solid var(--mud-palette-divider); }
    .plt-price-val.prem  { background: rgba(99,102,241,.07); border-color: rgba(99,102,241,.3); color: var(--prem-color); }
    .plt-price-val.elite { background: rgba(212,175,55,.08); border-color: rgba(212,175,55,.4); color: var(--gold-dark); }
    .plt-stock { display: inline-block; font-size: .72rem; font-weight: 800; padding: 3px 10px; border-radius: 100px; }
    .plt-stock.ok  { background: rgba(76,175,80,.1);  color: #2e7d32; }
    .plt-stock.out { background: rgba(244,67,54,.1); color: #c62828; }
    .td-actions { text-align: center; }
    .plt-btn { width: 30px; height: 30px; border-radius: 7px; border: 1px solid var(--mud-palette-divider); background: transparent; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; color: var(--mud-palette-text-secondary); transition: var(--transition); margin: 0 2px; }
    .plt-btn.ghost:hover    { border-color: var(--gold); color: var(--gold); background: var(--gold-subtle); }
    .plt-btn.primary        { background: var(--mud-palette-primary); color: #fff; border-color: transparent; }
    .plt-btn.primary:hover  { opacity: .85; }
    .plt-btn.secondary      { border-color: rgba(212,175,55,.4); color: var(--gold-dark); }
    .plt-btn.secondary:hover { background: var(--gold-subtle); }
    .plt-btn.warn           { color: #d97706; border-color: rgba(251,191,36,.4); }
    .plt-btn:disabled       { opacity: .4; cursor: not-allowed; }

    /* ══════════════════════════════════════════════════════
       CONTEXT MENU
    ══════════════════════════════════════════════════════ */
    .pl-context-menu {
        position: fixed; z-index: 9000;
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-divider);
        border-radius: var(--radius-md);
        box-shadow: 0 16px 48px rgba(0,0,0,.2), 0 4px 12px rgba(0,0,0,.12);
        min-width: 200px; overflow: hidden;
        animation: pl-ctx-pop .12s cubic-bezier(.34,1.56,.64,1);
    }
    @@keyframes pl-ctx-pop { from { transform: scale(.92); opacity: 0; } to { transform: none; opacity: 1; } }
    .pl-ctx-header { padding: 10px 14px 8px; border-bottom: 1px solid var(--mud-palette-divider); }
    .pl-ctx-product-name { font-size: .78rem; font-weight: 700; color: var(--mud-palette-text-primary); }
    .pl-ctx-product-code { font-size: .68rem; color: var(--mud-palette-text-secondary); }
    .pl-ctx-item { display: flex; align-items: center; gap: 10px; padding: 9px 14px; cursor: pointer; font-size: 13px; color: var(--mud-palette-text-primary); transition: background .12s; }
    .pl-ctx-item:hover { background: var(--gold-subtle); color: var(--gold-dark); }
    .pl-ctx-item.danger:hover { background: rgba(239,68,68,.08); color: #ef4444; }
    .pl-ctx-item-icon { width: 20px; text-align: center; color: var(--mud-palette-text-secondary); font-size: 16px !important; }
    .pl-ctx-item:hover .pl-ctx-item-icon { color: inherit; }
    .pl-ctx-divider { height: 1px; background: var(--mud-palette-divider); margin: 4px 0; }
    .pl-ctx-kb { font-size: .65rem; margin-right: auto; color: var(--mud-palette-text-secondary); font-family: monospace; background: var(--mud-palette-background-grey); border-radius: 3px; padding: 1px 5px; }

    /* ══════════════════════════════════════════════════════
       STICKY COMPARISON BAR
    ══════════════════════════════════════════════════════ */
    .pl-compare-bar {
        position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
        z-index: 1200;
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-divider);
        border-radius: var(--radius-xl);
        box-shadow: 0 20px 60px rgba(0,0,0,.2), 0 0 0 1px rgba(212,175,55,.15);
        padding: 14px 20px;
        display: flex; align-items: center; gap: 16px;
        min-width: 400px; max-width: 90vw;
        animation: pl-bar-slide-up .25s cubic-bezier(.34,1.56,.64,1);
        backdrop-filter: blur(12px);
    }
    @@keyframes pl-bar-slide-up { from { transform: translateX(-50%) translateY(20px); opacity: 0; } to { transform: translateX(-50%) translateY(0); opacity: 1; } }
    .pl-compare-label { font-size: 12px; font-weight: 700; color: var(--mud-palette-text-secondary); white-space: nowrap; }
    .pl-compare-items { display: flex; gap: 10px; flex: 1; overflow-x: auto; }
    .pl-compare-item { display: flex; flex-direction: column; align-items: center; gap: 3px; min-width: 80px; }
    .pl-compare-item-name { font-size: .68rem; font-weight: 700; color: var(--mud-palette-text-primary); text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 90px; }
    .pl-compare-item-prices { display: flex; flex-direction: column; gap: 1px; }
    .pl-compare-price-row { display: flex; align-items: center; gap: 4px; font-size: .64rem; font-variant-numeric: tabular-nums; }
    .pl-compare-clear-btn { width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--mud-palette-divider); background: transparent; color: var(--mud-palette-text-secondary); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: var(--transition); flex-shrink: 0; }
    .pl-compare-clear-btn:hover { background: rgba(239,68,68,.1); color: #ef4444; border-color: rgba(239,68,68,.3); }
    .pl-compare-close { width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--mud-palette-divider); background: transparent; color: var(--mud-palette-text-secondary); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: var(--transition); flex-shrink: 0; margin-right: -6px; }
    .pl-compare-close:hover { background: rgba(239,68,68,.1); color: #ef4444; border-color: rgba(239,68,68,.3); }

    /* ══════════════════════════════════════════════════════
       MODAL
    ══════════════════════════════════════════════════════ */
    .pl-overlay { position: fixed; inset: 0; background: rgba(5,10,20,.6); backdrop-filter: blur(5px); z-index: 1320; display: flex; align-items: center; justify-content: center; padding: 16px; }
    .pl-modal { background: var(--mud-palette-surface); border-radius: var(--radius-xl); width: min(500px, 96vw); max-height: 92vh; display: flex; flex-direction: column; box-shadow: 0 32px 80px rgba(0,0,0,.35); animation: pl-pop .2s cubic-bezier(.34,1.56,.64,1); overflow: hidden; border: 1px solid rgba(255,255,255,.07); }
    @@keyframes pl-pop { from { transform: scale(.93) translateY(12px); opacity: 0; } to { transform: none; opacity: 1; } }
    .plm-head { display: flex; align-items: center; gap: 14px; padding: 18px 20px; background: linear-gradient(135deg, #060C18, #132A47); border-bottom: 2px solid var(--gold); flex-shrink: 0; }
    .plm-thumb { width: 54px; height: 54px; border-radius: var(--radius-md); object-fit: cover; border: 2px solid rgba(212,175,55,.4); background: rgba(255,255,255,.08); flex-shrink: 0; }
    .plm-head-info { flex: 1; min-width: 0; }
    .plm-head-tag  { font-size: .68rem; font-weight: 700; color: var(--gold); text-transform: uppercase; letter-spacing: .6px; margin-bottom: 3px; }
    .plm-head-name { font-size: .95rem; font-weight: 800; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .plm-head-sub  { font-size: .72rem; color: rgba(255,255,255,.55); margin-top: 2px; }
    .pl-close-btn { width: 32px; height: 32px; border-radius: var(--radius-sm); border: 0; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: var(--transition); background: rgba(255,255,255,.1); color: rgba(255,255,255,.7); }
    .pl-close-btn:hover { background: rgba(255,255,255,.2); color: #fff; }
    .plm-body { padding: 20px; overflow-y: auto; flex: 1; }
    .plm-section-label { font-size: 11.5px; font-weight: 700; color: var(--mud-palette-text-secondary); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 10px; }
    .plm-tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .plm-tier { position: relative; padding: 12px 10px; border-radius: var(--radius-md); border: 1.5px solid var(--mud-palette-divider); background: var(--mud-palette-background-grey); cursor: pointer; transition: var(--transition); display: flex; flex-direction: column; gap: 4px; }
    .plm-tier:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(0,0,0,.1); }
    .plm-tier-top  { display: flex; align-items: center; gap: 6px; margin-bottom: 4px; }
    .plm-tier-name { font-size: .76rem; font-weight: 800; color: var(--mud-palette-text-primary); }
    .plm-tier-price { font-size: .84rem; font-weight: 800; font-variant-numeric: tabular-nums; color: var(--mud-palette-text-secondary); }
    .plm-tier.sel { box-shadow: 0 4px 16px rgba(0,0,0,.1); }
    .plm-tier.sel.std   { border-color: var(--std-color);  background: rgba(100,116,139,.07); }
    .plm-tier.sel.prem  { border-color: var(--prem-color); background: rgba(99,102,241,.07); }
    .plm-tier.sel.elite { border-color: var(--gold);       background: rgba(212,175,55,.08); }
    .plm-notice { display: flex; align-items: flex-start; gap: 10px; padding: 12px 14px; border-radius: var(--radius-sm); font-size: 12px; line-height: 1.55; margin-top: 14px; }
    .plm-notice.info { background: rgba(59,130,246,.08); border: 1px solid rgba(59,130,246,.2); color: #3b82f6; }
    .plm-notice.warn { background: rgba(245,158,11,.08); border: 1px solid rgba(245,158,11,.2); color: #d97706; }
    .plm-footer { display: flex; justify-content: flex-end; gap: 8px; padding: 14px 20px; border-top: 1px solid var(--mud-palette-divider); background: var(--mud-palette-background-grey, rgba(0,0,0,.02)); flex-shrink: 0; }
    .plm-btn { display: flex; align-items: center; gap: 6px; padding: 9px 22px; border-radius: var(--radius-sm); border: 0; font-size: 13px; font-weight: 700; font-family: inherit; cursor: pointer; transition: var(--transition); }
    .plm-btn.cancel    { background: transparent; color: var(--mud-palette-text-secondary); border: 1.5px solid var(--mud-palette-divider); }
    .plm-btn.cancel:hover { background: var(--mud-palette-background-grey); }
    .plm-btn.primary   { background: var(--mud-palette-primary, #594ae2); color: #fff; }
    .plm-btn.primary:hover  { opacity: .88; transform: translateY(-1px); box-shadow: 0 4px 14px rgba(89,74,226,.3); }
    .plm-btn.secondary { background: var(--gold); color: #1a1200; }
    .plm-btn.secondary:hover { background: var(--gold-dark); transform: translateY(-1px); }
    .plm-btn:disabled  { opacity: .45; cursor: not-allowed; transform: none !important; }

    /* ══════════════════════════════════════════════════════
       MOBILE BOTTOM SHEET
    ══════════════════════════════════════════════════════ */
    .pl-bottom-sheet-overlay { position: fixed; inset: 0; background: rgba(5,10,20,.5); backdrop-filter: blur(4px); z-index: 1320; display: flex; align-items: flex-end; }
    .pl-bottom-sheet { width: 100%; background: var(--mud-palette-surface); border-radius: 24px 24px 0 0; border-top: 2px solid var(--gold); box-shadow: 0 -20px 60px rgba(0,0,0,.25); display: flex; flex-direction: column; max-height: 88vh; animation: pl-sheet-up .28s cubic-bezier(.34,1.4,.64,1); }
    @@keyframes pl-sheet-up { from { transform: translateY(100%); } to { transform: none; } }
    .pl-sheet-handle-wrap { display: flex; justify-content: center; padding: 12px 0 6px; cursor: grab; }
    .pl-sheet-handle { width: 40px; height: 4px; border-radius: 2px; background: var(--mud-palette-divider); }
    .pl-sheet-body { overflow-y: auto; flex: 1; padding: 0 20px 30px; }

    /* ══════════════════════════════════════════════════════
       HISTORY DRAWER
    ══════════════════════════════════════════════════════ */
    .plh-overlay { position: fixed; inset: 0; background: rgba(5,10,20,.45); backdrop-filter: blur(3px); z-index: 1320; display: flex; justify-content: flex-start; }
    .plh-drawer { width: min(460px, 94vw); height: 100%; background: var(--mud-palette-surface); box-shadow: 4px 0 40px rgba(0,0,0,.2); display: flex; flex-direction: column; animation: plh-slide .2s ease; border-left: 1px solid var(--mud-palette-divider); }
    @@keyframes plh-slide { from { transform: translateX(-22px); opacity: 0; } to { transform: none; opacity: 1; } }
    .plh-head { display: flex; align-items: center; gap: 12px; padding: 18px 20px; background: linear-gradient(135deg, #060C18, #132A47); border-bottom: 2px solid var(--gold); flex-shrink: 0; }
    .plh-head-icon { width: 38px; height: 38px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; background: rgba(212,175,55,.15); color: var(--gold); flex-shrink: 0; }
    .plh-head-title { font-size: .95rem; font-weight: 800; color: #fff; }
    .plh-head-sub   { font-size: .76rem; color: rgba(255,255,255,.55); margin-top: 2px; }
    .plh-body       { flex: 1; overflow-y: auto; padding: 18px; }
    .plh-hint { display: inline-flex; align-items: center; gap: 5px; font-size: .74rem; font-weight: 700; color: var(--prem-color); background: rgba(99,102,241,.08); border: 1px solid rgba(99,102,241,.2); border-radius: 100px; padding: 4px 12px; margin-bottom: 16px; }
    .plh-timeline { position: relative; display: flex; flex-direction: column; gap: 12px; padding-right: 22px; }
    .plh-timeline::before { content: ''; position: absolute; right: 8px; top: 12px; bottom: 12px; width: 2px; background: linear-gradient(180deg, var(--gold), var(--mud-palette-divider)); border-radius: 2px; }
    .plh-item { position: relative; }
    .plh-item-dot { position: absolute; right: -22px; top: 10px; width: 16px; height: 16px; border-radius: 50%; border: 2.5px solid var(--mud-palette-surface); background: var(--std-color); z-index: 1; }
    .plh-item-dot.prem  { background: var(--prem-color); box-shadow: 0 0 8px rgba(99,102,241,.4); }
    .plh-item-dot.elite { background: var(--gold); box-shadow: 0 0 8px rgba(212,175,55,.5); }
    .plh-item-card { background: var(--mud-palette-background-grey, rgba(0,0,0,.03)); border: 1px solid var(--mud-palette-divider); border-radius: var(--radius-md); padding: 12px 14px; }
    .plh-item-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
    .plh-tier-badge { font-size: .68rem; font-weight: 800; padding: 2px 8px; border-radius: 100px; text-transform: uppercase; letter-spacing: .4px; }
    .plh-tier-badge.std   { background: rgba(100,116,139,.15); color: var(--std-color); }
    .plh-tier-badge.prem  { background: rgba(99,102,241,.12);  color: var(--prem-color); }
    .plh-tier-badge.elite { background: rgba(212,175,55,.15);  color: var(--gold-dark); }
    .plh-date { font-size: .7rem; font-weight: 700; color: var(--mud-palette-text-secondary); direction: ltr; }
    .plh-price-change { display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: var(--mud-palette-surface); border-radius: var(--radius-sm); border: 1px solid var(--mud-palette-divider); margin-bottom: 8px; }
    .plh-old-price { color: #ef4444; text-decoration: line-through; font-size: .84rem; font-variant-numeric: tabular-nums; }
    .plh-new-price { color: #16a34a; font-size: .95rem; font-weight: 800; font-variant-numeric: tabular-nums; }
    .plh-changed-by { display: flex; align-items: center; gap: 4px; font-size: .72rem; color: var(--mud-palette-text-secondary); margin-bottom: 4px; }
    .plh-reason { display: flex; align-items: flex-start; gap: 5px; font-size: .74rem; color: var(--mud-palette-text-secondary); padding: 6px 10px; background: var(--mud-palette-surface); border: 1px dashed var(--mud-palette-divider); border-radius: var(--radius-sm); line-height: 1.5; }
    .plh-loading { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 60px 20px; color: var(--mud-palette-text-secondary); font-size: 14px; }
    .plh-spinner { width: 28px; height: 28px; border: 3px solid var(--mud-palette-divider); border-top-color: var(--gold); border-radius: 50%; animation: plh-spin .8s linear infinite; }
    @@keyframes plh-spin { to { transform: rotate(360deg); } }
    .plh-empty { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 60px 20px; text-align: center; }
    .plh-empty-title { font-size: 1rem; font-weight: 700; color: var(--mud-palette-text-primary); }
    .plh-empty-sub   { font-size: .8rem; color: var(--mud-palette-text-secondary); }

    /* ══════════════════════════════════════════════════════
       GALLERY
    ══════════════════════════════════════════════════════ */
    .plgal-overlay { position: fixed; inset: 0; z-index: 1320; background: rgba(2,6,23,.85); backdrop-filter: blur(10px); display: flex; align-items: center; justify-content: center; padding: 14px; animation: pl-fade-in .18s ease; }
    @@keyframes pl-fade-in { from { opacity: 0; } to { opacity: 1; } }
    .plgal-box { background: var(--mud-palette-surface); border-radius: var(--radius-xl); overflow: hidden; width: min(900px, 96vw); max-height: 92vh; display: flex; flex-direction: column; box-shadow: 0 40px 100px rgba(0,0,0,.55); border: 1px solid rgba(255,255,255,.06); border-top: 3px solid var(--gold); }
    .plgal-head { display: flex; align-items: center; gap: 12px; padding: 14px 18px; background: linear-gradient(135deg, #060C18, #132A47); border-bottom: 2px solid var(--gold); flex-shrink: 0; }
    .plgal-head-info { flex: 1; min-width: 0; }
    .plgal-name { font-weight: 800; font-size: .95rem; color: #fff; }
    .plgal-sub  { font-size: .7rem; color: rgba(255,255,255,.55); margin-top: 2px; }
    .plgal-counter { font-size: .78rem; font-weight: 800; direction: ltr; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.18); border-radius: 100px; padding: 3px 12px; color: var(--gold-light); white-space: nowrap; }
    .plgal-stage { position: relative; display: flex; align-items: center; justify-content: center; flex: 1; min-height: 260px; padding: 16px; background: repeating-conic-gradient(var(--mud-palette-background-grey, rgba(0,0,0,.03)) 0% 25%, transparent 0% 50%) 0 0 / 22px 22px; }
    .plgal-main { max-width: 100%; max-height: min(60vh, 560px); object-fit: contain; border-radius: var(--radius-md); box-shadow: 0 10px 32px rgba(0,0,0,.22); background: #fff; }
    .plgal-nav { position: absolute; top: 50%; transform: translateY(-50%); width: 46px; height: 46px; border-radius: 50%; border: 0; cursor: pointer; background: rgba(10,15,30,.65); color: #fff; display: flex; align-items: center; justify-content: center; transition: var(--transition); z-index: 2; backdrop-filter: blur(4px); }
    .plgal-nav:hover { background: rgba(10,15,30,.9); transform: translateY(-50%) scale(1.08); }
    .plgal-nav.prev { right: 14px; }
    .plgal-nav.next { left: 14px; }
    .plgal-thumbs { display: flex; gap: 8px; padding: 10px 16px 14px; overflow-x: auto; border-top: 1px solid var(--mud-palette-divider); flex-shrink: 0; }
    .plgal-thumb { width: 62px; height: 62px; border-radius: var(--radius-sm); object-fit: cover; border: 2px solid var(--mud-palette-divider); cursor: pointer; flex-shrink: 0; opacity: .55; transition: var(--transition); }
    .plgal-thumb:hover { opacity: .85; transform: translateY(-2px); }
    .plgal-thumb.active { border-color: var(--gold); opacity: 1; box-shadow: 0 3px 12px rgba(212,175,55,.3); }
    .plgal-empty { display: flex; flex-direction: column; align-items: center; gap: 10px; color: var(--mud-palette-text-secondary); padding: 40px 0; }

    /* ══════════════════════════════════════════════════════
       KEYBOARD SHORTCUT TOAST
    ══════════════════════════════════════════════════════ */
    .pl-kb-toast {
        position: fixed; bottom: 24px; left: 24px; z-index: 9999;
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-divider);
        border-radius: var(--radius-md);
        box-shadow: 0 12px 40px rgba(0,0,0,.18);
        padding: 14px 18px;
        animation: pl-toast-in .2s ease;
        min-width: 220px;
    }
    @@keyframes pl-toast-in { from { transform: translateY(12px); opacity: 0; } to { transform: none; opacity: 1; } }
    .pl-kb-toast-title { font-size: 12px; font-weight: 800; color: var(--mud-palette-text-secondary); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 10px; }
    .pl-kb-row { display: flex; align-items: center; justify-content: space-between; padding: 5px 0; font-size: 12px; gap: 16px; border-bottom: 1px solid var(--mud-palette-divider); }
    .pl-kb-row:last-child { border-bottom: none; }
    .pl-kb-desc { color: var(--mud-palette-text-secondary); }
    .pl-kb-keys { display: flex; gap: 3px; }
    .pl-kb-keys kbd { display: inline-flex; align-items: center; justify-content: center; background: var(--mud-palette-background-grey); border: 1px solid var(--mud-palette-divider); border-radius: 4px; padding: 2px 6px; font-size: 11px; font-family: monospace; color: var(--mud-palette-text-primary); box-shadow: 0 2px 0 var(--mud-palette-divider); }

    /* ══════════════════════════════════════════════════════
       PRINT SHEET
    ══════════════════════════════════════════════════════ */
    .pl-print-sheet { display: none; }
    @@media print {
        @@page { size: A4; margin: 12mm 10mm; }
        body * { visibility: hidden !important; }
        .pl-print-sheet, .pl-print-sheet * { visibility: visible !important; }
        .pl-print-sheet { display: block !important; position: absolute; top: 0; right: 0; left: 0; background: #fff; color: #111; font-family: 'Tajawal','Segoe UI',sans-serif; }
        .plp-band { background: #0D1B30; color: #fff; border-radius: 10px; padding: 14px 18px 12px; border-bottom: 3px solid #d4af37; margin-bottom: 12px; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .plp-brand-row { display: flex; justify-content: space-between; align-items: center; }
        .plp-brand { font-size: 12px; letter-spacing: 2.5px; font-weight: 700; color: #d4af37; }
        .plp-brand span { color: rgba(255,255,255,.7); }
        .plp-version { font-size: 10px; font-weight: 800; border: 1.5px solid #d4af37; color: #d4af37; border-radius: 100px; padding: 2px 12px; }
        .plp-title { font-size: 22px; font-weight: 800; text-align: center; margin: 6px 0 2px; }
        .plp-sub   { font-size: 10.5px; text-align: center; opacity: .8; }
        .plp-group-header { display: flex; justify-content: space-between; align-items: center; background: #f5f0e1; border-right: 4px solid #d4af37; border-radius: 6px; padding: 5px 10px; margin: 14px 0 5px; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .plp-group-name  { font-size: 13px; font-weight: 800; color: #6b5716; }
        .plp-group-count { font-size: 10px; opacity: .7; }
        .pl-print-sheet table { width: 100%; border-collapse: collapse; margin-bottom: 4px; }
        .pl-print-sheet thead { display: table-header-group; }
        .pl-print-sheet tr    { break-inside: avoid; }
        .pl-print-sheet th, .pl-print-sheet td { border: 1px solid #ccc; padding: 4.5px 7px; font-size: 11px; text-align: right; }
        .pl-print-sheet th    { background: #eee; font-weight: 800; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .pl-print-sheet tbody tr:nth-child(even) { background: #fafafa; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .plp-c      { text-align: center; }
        .plp-strong { font-weight: 800; }
        .plp-std    { font-weight: 600; }
        .plp-prem   { font-weight: 700; color: #3730a3; }
        .plp-elite  { font-weight: 800; color: #8b6f17; }
        .plp-img    { width: 36px; height: 36px; object-fit: cover; border-radius: 5px; border: 1px solid #bbb; }
        .plp-footer { display: flex; justify-content: space-between; align-items: center; gap: 10px; border-top: 2px solid #d4af37; margin-top: 16px; padding-top: 8px; font-size: 10px; }
        .plp-sign   { font-weight: 700; white-space: nowrap; }
    }

    /* ══════════════════════════════════════════════════════
       RESPONSIVE
    ══════════════════════════════════════════════════════ */
    @@media (max-width: 1100px) { .pl-toolbar-row1 { grid-template-columns: 1fr 1fr; } }
    @@media (max-width: 768px) {
        .pl-hero { flex-direction: column; align-items: flex-start; padding: 20px; }
        .pl-hero-right { align-items: flex-start; width: 100%; }
        .pl-hero-stats { justify-content: flex-start; width: 100%; }
        .pl-hero-kb { display: none; }
        .pl-toolbar-row1 { grid-template-columns: 1fr; }
        .pl-toolbar-row2 { flex-direction: column; align-items: flex-start; }
        .pl-view-switcher, .pl-tier-switcher { width: 100%; }
        .pl-toolbar-end { width: 100%; justify-content: space-between; }
        .pll-prices { display: none; }
        .plm-tiers  { grid-template-columns: 1fr; gap: 6px; }
        .plgal-nav  { width: 38px; height: 38px; }
        .pl-compare-bar { min-width: unset; width: calc(100vw - 32px); }
    }
    @@media (max-width: 480px) {
        .pl-hero-stats { flex-wrap: nowrap; }
        .pl-stat       { flex: 1; min-width: 0; padding: 10px 8px; }
        .pl-grid       { grid-template-columns: 1fr 1fr; gap: 10px; }
        .plh-drawer    { width: 100vw; }
    }
    @@media (max-width: 380px) {
        .pl-grid { grid-template-columns: 1fr; }
    }
    /* ═══ تكلفة الباقات — لذوي الصلاحية فقط (إضافة 2026-09-17) ═══ */
    .pl-cost-inline { font-size: .6rem; font-weight: 700; color: var(--mud-palette-text-secondary); background: rgba(0,0,0,.05); border-radius: 6px; padding: 1px 5px; margin-inline-start: 4px; white-space: nowrap; }
    .plt-cost { display: block; font-size: .6rem; font-weight: 700; color: var(--mud-palette-text-secondary); margin-top: 1px; }
    .plm-cost-grid { display: grid; gap: 6px; margin-top: 6px; }
    /* ═══ تحميل المزيد ═══ */
    .pl-more { display: block; margin: 12px auto 0; border: 1.5px solid var(--mud-palette-divider); background: var(--mud-palette-surface); color: var(--mud-palette-text-primary); font-family: inherit; font-weight: 800; font-size: .8rem; padding: 8px 24px; border-radius: 100px; cursor: pointer; transition: .15s; box-shadow: 0 2px 8px rgba(0,0,0,.06); }
    .pl-more:hover { border-color: var(--gold); color: var(--gold-dark); transform: translateY(-1px); }
    /* ═══ شارة منتجات الموقع (إضافة 2026-09-17) ═══ */
    .pl-web-badge { display: inline-flex; align-items: center; justify-content: center; font-size: .6rem; line-height: 1; background: rgba(34,211,238,.12); border: 1px solid rgba(34,211,238,.35); border-radius: 100px; padding: 2px 6px; margin-inline-start: 5px; cursor: default; }
</style>

@* ══════════════════════════════════════════════════════
   Context Menu & Keyboard Toast — خارج الـ Container
══════════════════════════════════════════════════════ *@
@if (_ctxOpen && _ctxProduct is not null)
{
    <div style="position:fixed;inset:0;z-index:8999;" @onclick="CloseContext" @oncontextmenu:preventDefault="true"></div>
    <div class="pl-context-menu" style="top:@(_ctxY)px;left:@(_ctxX)px" @onclick:stopPropagation="true">
        <div class="pl-ctx-header">
            <div class="pl-ctx-product-name">@_ctxProduct.ProductName</div>
            <div class="pl-ctx-product-code">#@_ctxProduct.ProductId · @_ctxProduct.GroupName</div>
        </div>
        <div class="pl-ctx-item" @onclick="@(() => { CopyToClipboard(_ctxProduct.ProductName); CloseContext(); })">
            <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Class="pl-ctx-item-icon" />
            نسخ اسم المنتج
            <span class="pl-ctx-kb">Ctrl+C</span>
        </div>
        <div class="pl-ctx-item" @onclick="@(() => { Nav.NavigateTo($"/products/form/{_ctxProduct.ProductId}", true); CloseContext(); })">
            <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Class="pl-ctx-item-icon" />
            فتح صفحة المنتج
        </div>
        <div class="pl-ctx-item" @onclick="@(() => { OpenGalleryAsync(_ctxProduct); CloseContext(); })">
            <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Class="pl-ctx-item-icon" />
            عرض الصور
        </div>
        <div class="pl-ctx-divider"></div>
        @if (_canSeeCosts)
        {
            <div class="pl-ctx-item" @onclick="@(() => { OpenHistoryAsync(_ctxProduct); CloseContext(); })">
                <MudIcon Icon="@Icons.Material.Filled.History" Class="pl-ctx-item-icon" />
                سجل الأسعار
            </div>
            <div class="pl-ctx-item" @onclick="@(() => { OpenPriceModal(_ctxProduct, false); CloseContext(); })">
                <MudIcon Icon="@Icons.Material.Filled.Edit" Class="pl-ctx-item-icon" />
                تعديل السعر
            </div>
        }
        else if (_showPrices && !_pendingRequests.Contains(_ctxProduct.ProductId))
        {
            <div class="pl-ctx-item" @onclick="@(() => { OpenPriceModal(_ctxProduct, true); CloseContext(); })">
                <MudIcon Icon="@Icons.Material.Filled.OutlinedFlag" Class="pl-ctx-item-icon" />
                طلب تعديل سعر
            </div>
        }
        <div class="pl-ctx-divider"></div>
        <div class="pl-ctx-item" @onclick="@(() => { ToggleCompare(_ctxProduct); CloseContext(); })">
            <MudIcon Icon="@Icons.Material.Filled.Compare" Class="pl-ctx-item-icon" />
            @(_compareList.Any(x => x.ProductId == _ctxProduct.ProductId) ? "إزالة من المقارنة" : "إضافة للمقارنة")
        </div>
    </div>
}

@if (_showKbToast)
{
    <div class="pl-kb-toast">
        <div class="pl-kb-toast-title">اختصارات لوحة المفاتيح</div>
        <div class="pl-kb-row"><span class="pl-kb-desc">بحث</span><div class="pl-kb-keys"><kbd>Ctrl</kbd><kbd>F</kbd></div></div>
        <div class="pl-kb-row"><span class="pl-kb-desc">طباعة</span><div class="pl-kb-keys"><kbd>Ctrl</kbd><kbd>P</kbd></div></div>
        <div class="pl-kb-row"><span class="pl-kb-desc">عرض شبكة</span><div class="pl-kb-keys"><kbd>G</kbd></div></div>
        <div class="pl-kb-row"><span class="pl-kb-desc">عرض قائمة</span><div class="pl-kb-keys"><kbd>L</kbd></div></div>
        <div class="pl-kb-row"><span class="pl-kb-desc">عرض جدول</span><div class="pl-kb-keys"><kbd>T</kbd></div></div>
        <div class="pl-kb-row"><span class="pl-kb-desc">تصفير الفلاتر</span><div class="pl-kb-keys"><kbd>Esc</kbd></div></div>
        <div class="pl-kb-row"><span class="pl-kb-desc">إغلاق هذا</span><div class="pl-kb-keys"><kbd>?</kbd></div></div>
    </div>
}

@if (!_canView)
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
        <AppEmpty Icon="@Icons.Material.Filled.Lock"
                  Message="غير مصرح بالوصول"
                  Description="ليس لديك صلاحية عرض قائمة الأسعار" />
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pl-page">

        @* ══ HERO ══ *@
        <div class="pl-hero" @onkeydown="OnKeyDown" tabindex="0">
            <div class="pl-hero-glow-l"></div>
            <div class="pl-hero-glow-r"></div>

            <div class="pl-hero-left">
                <div class="pl-hero-icon">
                    <MudIcon Icon="@Icons.Material.Rounded.Sell" />
                </div>
                <div class="pl-hero-text">
                    <div class="pl-hero-eyebrow">
                        <MudIcon Icon="@Icons.Material.Filled.Store" Style="font-size:11px" />
                        المنتجات · الكتالوج
                    </div>
                    <h1 class="pl-hero-title">قائمة <span>الأسعار</span></h1>
                    <p class="pl-hero-sub">الكتالوج العام — أسعار البيع بالفئات الثلاثة</p>
                    <div class="pl-hero-badges">
                        <span class="pl-hero-badge"><span class="ch-dot d-std"></span> ستاندرد</span>
                        <span class="pl-hero-badge"><span class="ch-dot d-prem"></span> بريميوم</span>
                        <span class="pl-hero-badge"><MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Style="font-size:10px;color:var(--gold)" /> إيليت</span>
                    </div>
                </div>
            </div>

            <div class="pl-hero-right">
                <div class="pl-hero-stats">
                    <div class="pl-stat @(_noActiveFilters ? "act" : "")"
                         title="اضغط لعرض الكل" @onclick="ResetAllFiltersAsync">
                        <div class="pl-stat-icon-wrap">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Class="pl-stat-ico" />
                        </div>
                        <span class="pl-stat-num">@_statTotal</span>
                        <span class="pl-stat-lbl">إجمالي الأصناف</span>
                    </div>
                    <div class="pl-stat @(_priceFilter == 2 ? "act act-green" : "")"
                         title="المُسعَّر فقط"
                         @onclick="@(() => _priceFilter = _priceFilter == 2 ? 0 : 2)">
                        <div class="pl-stat-icon-wrap green">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="pl-stat-ico" />
                        </div>
                        <span class="pl-stat-num pl-stat-ok">@_statPriced</span>
                        <span class="pl-stat-lbl">بأسعار</span>
                    </div>
                    <div class="pl-stat @(_priceFilter == 1 ? "act act-warn" : "")"
                         title="بدون سعر فقط"
                         @onclick="@(() => _priceFilter = _priceFilter == 1 ? 0 : 1)">
                        <div class="pl-stat-icon-wrap warn">
                            <MudIcon Icon="@Icons.Material.Filled.PriceChange" Class="pl-stat-ico" />
                        </div>
                        <span class="pl-stat-num pl-stat-warn">@_statMissing</span>
                        <span class="pl-stat-lbl">بدون سعر</span>
                    </div>
                    <div class="pl-stat @(_onlyWebsite ? "act act-cyan" : "")"
                         title="منتجات الموقع فقط"
                         @onclick="@(() => { _onlyWebsite = !_onlyWebsite; StateHasChanged(); })">
                        <div class="pl-stat-icon-wrap cyan">
                            <MudIcon Icon="@Icons.Material.Filled.Public" Class="pl-stat-ico" />
                        </div>
                        <span class="pl-stat-num pl-stat-cyan">@_statWebsite</span>
                        <span class="pl-stat-lbl">🌐 منتجات الموقع</span>
                    </div>
                </div>
                <div class="pl-hero-kb">
                    <span class="pl-kb-hint"><kbd>Ctrl+F</kbd> بحث</span>
                    <span class="pl-kb-hint"><kbd>G</kbd> شبكة</span>
                    <span class="pl-kb-hint"><kbd>L</kbd> قائمة</span>
                    <span class="pl-kb-hint"><kbd>T</kbd> جدول</span>
                    <span class="pl-kb-hint" style="cursor:pointer" @onclick="() => _showKbToast = !_showKbToast"><kbd>?</kbd> كل الاختصارات</span>
                </div>
            </div>
        </div>

        @* ══ ACTIVE FILTERS CHIPS ══ *@
        @if (HasActiveFilters)
        {
            <div class="pl-active-filters">
                <span class="pl-active-filters-label">الفلاتر الفعّالة:</span>
                @if (!string.IsNullOrWhiteSpace(_search))
                {
                    <div class="pl-filter-chip" @onclick="() => { _search = null; StateHasChanged(); }">
                        <MudIcon Icon="@Icons.Material.Filled.Search" Style="font-size:13px" />
                        بحث: "@_search"
                        <span class="chip-x">✕</span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_group))
                {
                    <div class="pl-filter-chip" @onclick="() => { _group = null; StateHasChanged(); }">
                        <MudIcon Icon="@Icons.Material.Filled.Category" Style="font-size:13px" />
                        @_group
                        <span class="chip-x">✕</span>
                    </div>
                }
                @if (_branchId.HasValue)
                {
                    var bn = _branches.FirstOrDefault(b => b.BranchId == _branchId)?.BranchName ?? "فرع";
                    <div class="pl-filter-chip" @onclick="() => { _branchId = null; _ = OnBranchChangedAsync(); }">
                        <MudIcon Icon="@Icons.Material.Filled.Store" Style="font-size:13px" />
                        @bn
                        <span class="chip-x">✕</span>
                    </div>
                }
                @if (_tierView != "all")
                {
                    <div class="pl-filter-chip" @onclick='@(() => { _tierView = "all"; StateHasChanged(); })'>
                        <span class="ch-dot @(_tierView == "CClass" ? "d-std" : _tierView == "Premium" ? "d-prem" : "d-elite")"></span>
                        @TierLabel(_tierView)
                        <span class="chip-x">✕</span>
                    </div>
                }
                @if (_onlyWebsite)
                {
                    <div class="pl-filter-chip" @onclick="@(() => { _onlyWebsite = false; StateHasChanged(); })">
                        <MudIcon Icon="@Icons.Material.Filled.Public" Style="font-size:13px" />
                        🌐 منتجات الموقع
                        <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:12px;opacity:.6" />
                    </div>
                }
                @if (_priceFilter != 0)
                {
                    <div class="pl-filter-chip" @onclick="() => { _priceFilter = 0; StateHasChanged(); }">
                        <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Style="font-size:13px" />
                        @(_priceFilter == 1 ? "بدون سعر فقط" : "بأسعار فقط")
                        <span class="chip-x">✕</span>
                    </div>
                }
                <div class="pl-filter-chip-clear" @onclick="ResetAllFiltersAsync">
                    <MudIcon Icon="@Icons.Material.Filled.ClearAll" Style="font-size:13px" />
                    مسح الكل
                </div>
            </div>
        }

        @* ══ TOOLBAR ══ *@
        <div class="pl-toolbar">
            <div class="pl-toolbar-row1">
                <div class="pl-search-wrap">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Class="pl-search-ico" />
                    <input id="pl-search-input" class="pl-search-input"
                           placeholder="بحث بالاسم أو الكود… (Ctrl+F)"
                           value="@_search"
                           @oninput="e => { _search = e.Value?.ToString(); StateHasChanged(); }" />
                    @if (!string.IsNullOrEmpty(_search))
                    {
                        <button class="pl-search-clear"
                                @onclick="() => { _search = null; StateHasChanged(); }">
                            <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:15px" />
                        </button>
                    }
                </div>
                <MudSelect T="string" @bind-Value="_group" Label="المجموعة"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                    @foreach (var g in _groups)
                    {
                        <MudSelectItem T="string" Value="@g">@g</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="int?" @bind-Value="_branchId"
                           @bind-Value:after="OnBranchChangedAsync"
                           Label="الفرع" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Clearable="true">
                    <MudSelectItem T="int?" Value="null">كل الفروع</MudSelectItem>
                    @foreach (var b in _branches)
                    {
                        <MudSelectItem T="int?" Value="@(b.BranchId)">@b.BranchName</MudSelectItem>
                    }
                </MudSelect>
                <div class="pl-toolbar-actions">
                    <button class="pl-icon-btn @(_priceFilter == 1 ? "active-warn" : "")"
                            title="بدون سعر فقط"
                            @onclick="@(() => _priceFilter = _priceFilter == 1 ? 0 : 1)">
                        <MudIcon Icon="@Icons.Material.Filled.PriceChange" Style="font-size:18px" />
                    </button>
                    <button class="pl-icon-btn" title="تحديث (F5)" disabled="@_loading" @onclick="LoadAllAsync">
                        <MudIcon Icon="@Icons.Material.Filled.Refresh" Style="font-size:18px" />
                    </button>
                </div>
            </div>

            <div class="pl-toolbar-row2">
                <div class="pl-view-switcher">
                    <button class="pl-view-btn @(_viewMode == "grid"  ? "active" : "")" @onclick='@(() => _viewMode = "grid")'>
                        <MudIcon Icon="@Icons.Material.Filled.GridView" Style="font-size:17px" />
                        <span>شبكة</span><span class="vb-kb">G</span>
                    </button>
                    <button class="pl-view-btn @(_viewMode == "list"  ? "active" : "")" @onclick='@(() => _viewMode = "list")'>
                        <MudIcon Icon="@Icons.Material.Filled.ViewList" Style="font-size:17px" />
                        <span>قائمة</span><span class="vb-kb">L</span>
                    </button>
                    <button class="pl-view-btn @(_viewMode == "table" ? "active" : "")" @onclick='@(() => _viewMode = "table")'>
                        <MudIcon Icon="@Icons.Material.Filled.TableRows" Style="font-size:17px" />
                        <span>جدول</span><span class="vb-kb">T</span>
                    </button>
                </div>

                @if (_showPrices)
                {
                    <div class="pl-tier-switcher">
                        <button class="pl-tier-btn @(_tierView == "all"     ? "active" : "")" @onclick='@(() => _tierView = "all")'>كل الفئات</button>
                        <button class="pl-tier-btn std   @(_tierView == "CClass"  ? "active" : "")" @onclick='@(() => _tierView = "CClass")'>
                            <span class="ch-dot d-std"></span> ستاندرد
                        </button>
                        <button class="pl-tier-btn prem  @(_tierView == "Premium" ? "active" : "")" @onclick='@(() => _tierView = "Premium")'>
                            <span class="ch-dot d-prem"></span> بريميوم
                        </button>
                        <button class="pl-tier-btn elite @(_tierView == "Elite"   ? "active" : "")" @onclick='@(() => _tierView = "Elite")'>
                            <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Style="font-size:12px;color:var(--gold)" /> إيليت
                        </button>
                    </div>
                }

                <div class="pl-toolbar-end">
                    <span class="pl-results-badge">
                        <MudIcon Icon="@Icons.Material.Filled.FilterList" Style="font-size:13px;margin-left:3px" />
                        @_filtered.Count من @_rows.Count صنف
                    </span>

                    @* Saved Views *@
                    @if (_savedViews.Any())
                    {
                        <div class="pl-saved-views">
                            @foreach (var v in _savedViews)
                            {
                                <div class="pl-saved-view-chip" @onclick="@(() => ApplySavedView(v))">
                                    <MudIcon Icon="@Icons.Material.Filled.Bookmark" Style="font-size:12px" />
                                    @v.Name
                                    @if (_isAdmin || _canView)
                                    {
                                        <span class="sv-del" @onclick:stopPropagation="true"
                                              @onclick="@(() => DeleteSavedView(v))">✕</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    <button class="pl-save-view-btn" @onclick="SaveCurrentView">
                        <MudIcon Icon="@Icons.Material.Filled.BookmarkAdd" Style="font-size:13px" />
                        حفظ العرض
                    </button>

                    @if (_isAdmin)
                    {
                        <MudMenu Icon="@Icons.Material.Filled.Print"
                                 Label="طباعة / تصدير"
                                 Variant="Variant.Outlined" Size="Size.Small"
                                 EndIcon="@Icons.Material.Filled.ArrowDropDown">
                            <MudMenuItem OnClick="@(() => PrintAsync("full"))">
                                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Class="mr-2" Size="Size.Small" />
                                كتالوج كامل (الفئات الثلاثة)
                            </MudMenuItem>
                            <MudMenuItem OnClick="@(() => PrintAsync("tier"))">
                                <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Class="mr-2" Size="Size.Small" />
                                كتالوج فئة واحدة
                            </MudMenuItem>
                            <MudMenuItem OnClick="@(() => PrintAsync("noprice"))">
                                <MudIcon Icon="@Icons.Material.Filled.AutoStories" Class="mr-2" Size="Size.Small" />
                                كتالوج بدون أسعار
                            </MudMenuItem>
                            <MudMenuItem OnClick="@(() => PrintAsync("costs"))">
                                <MudIcon Icon="@Icons.Material.Filled.Paid" Class="mr-2" Size="Size.Small" />
                                كتالوج كامل + التكاليف (داخلي)
                            </MudMenuItem>
                            <MudDivider Class="my-1" />
                            <MudMenuItem OnClick="ExportToExcel">
                                <MudIcon Icon="@Icons.Material.Filled.GridOn" Class="mr-2" Size="Size.Small" />
                                تصدير Excel
                            </MudMenuItem>
                        </MudMenu>
                    }
                </div>
            </div>
        </div>

        @* ══ LOADING ══ *@
        @if (_loading)
        {
            <div>
                <div class="pl-loading-bar"><div class="pl-loading-fill"></div></div>
                <div class="pl-loading-cards">
                    @for (int i = 0; i < 8; i++)
                    {
                        <div class="pl-skeleton-card">
                            <div class="pl-skel pl-skel-img"></div>
                            <div class="pl-skel-body">
                                <div class="pl-skel pl-skel-title"></div>
                                <div class="pl-skel pl-skel-sub"></div>
                                <div class="pl-skel pl-skel-price"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @* ══ EMPTY ══ *@
        else if (_filtered.Count == 0)
        {
            <div class="pl-empty-state">
                <div class="pl-empty-icon">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" />
                </div>
                <h3>لا توجد أصناف مطابقة</h3>
                <p>جرّب تغيير البحث أو الفلاتر</p>
                <button class="pl-empty-reset" @onclick="ResetAllFiltersAsync">
                    <MudIcon Icon="@Icons.Material.Filled.RestartAlt" Style="font-size:16px" />
                    إعادة ضبط الفلاتر
                </button>
            </div>
        }

        @* ══ GRID ══ *@
        else if (_viewMode == "grid")
        {
            <div class="pl-grid">
                @foreach (var p in _filtered.Take(_visibleCount))
                {
                    var stock    = _stockMap.TryGetValue(p.ProductId, out var s) ? s : 0;
                    var isComp   = _compareList.Any(x => x.ProductId == p.ProductId);
                    var pulse    = GetPricePulse(p);
                    var maxPrice = new[] { p.StdPrice ?? 0, p.PremiumPrice ?? 0, p.ElitePrice ?? 0 }.Max();

                    <div class="plg-card @(isComp ? "selected" : "")"
                         @oncontextmenu="@(e => OpenContext(e, p))"
                         @oncontextmenu:preventDefault="true">

                        @* Compare Checkbox *@
                        <div class="plg-compare-cb @(isComp ? "checked" : "")"
                             @onclick="@(() => ToggleCompare(p))"
                             @onclick:stopPropagation="true">
                            @if (isComp) { <MudIcon Icon="@Icons.Material.Filled.Check" Style="font-size:13px;color:#fff" /> }
                        </div>

                        <div class="plg-img-wrap pl-clickable" @onclick="@(() => OpenGalleryAsync(p))">
                            <img class="plg-img" src="/api/product-images/@p.ProductId"
                                 alt="@p.ProductName" loading="lazy"
                                 onerror="this.onerror=null;this.src='data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 80 60%22><rect fill=%22%23f1f5f9%22 width=%2280%22 height=%2260%22/><text x=%2240%22 y=%2234%22 text-anchor=%22middle%22 font-size=%2210%22 fill=%22%2394a3b8%22>لا صورة</text></svg>';" />

                            @* Price Pulse *@
                            @if (pulse != null && _showPrices)
                            {
                                <div class="pl-price-pulse @(pulse.Value.up ? "up" : "down")">
                                    @(pulse.Value.up ? "↑" : "↓") @pulse.Value.pct%
                                </div>
                            }

                            <div class="plg-stock-badge @(stock > 0 ? "in-stock" : "out-stock")">
                                <MudIcon Icon="@(stock > 0 ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RemoveCircle)" Style="font-size:11px" />
                                @(stock > 0 ? stock.ToString("N0") + " متاح" : "نفذ")
                            </div>
                            @if (_pendingRequests.Contains(p.ProductId))
                            {
                                <div class="plg-pending-badge">
                                    <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Style="font-size:11px" />
                                    طلب معلق
                                </div>
                            }
                            <div class="plg-zoom-btn">
                                <div class="plg-zoom-btn-inner">
                                    <MudIcon Icon="@Icons.Material.Filled.ZoomIn" Style="font-size:22px" />
                                </div>
                            </div>
                        </div>

                        <div class="plg-body">
                            <div class="plg-header">
                                <div class="plg-name" title="@p.ProductName">
                                    @((MarkupString)HighlightText(p.ProductName))
                                </div>
                                <a class="plg-code" href="/products/form/@p.ProductId"
                                   target="_blank" title="فتح صفحة المنتج">#@p.ProductId</a>
                            </div>
                            <div class="plg-group">
                                <MudIcon Icon="@Icons.Material.Filled.Category" Style="font-size:12px;opacity:.5" />
                                @((MarkupString)HighlightText(p.GroupName))
                                @if (p.IsWebsite) { <span class="pl-web-badge" title="منتج الموقع">🌐</span> }
                            </div>

                            @if (_showPrices)
                            {
                                <div class="plg-prices">
                                    @if (_tierView == "all" || _tierView == "CClass")
                                    {
                                        <div class="plg-price-row std @(_tierView == "CClass" ? "highlighted" : "")">
                                            <div class="plg-price-tier"><span class="ch-dot d-std"></span><span>ستاندرد</span></div>
                                            <div class="plg-price-val">
                                                @if (p.StdPrice > 0) { <b>@p.StdPrice.Value.ToString("N0")</b><span class="plg-currency">ج</span> }
                                                @if (_canSeeCosts && p.StdCost > 0) { <span class="pl-cost-inline">ت @p.StdCost.Value.ToString("N0")</span> }                                                else { <span class="plg-no-price">—</span> }
                                            </div>
                                        </div>
                                    }
                                    @if (_tierView == "all" || _tierView == "Premium")
                                    {
                                        <div class="plg-price-row prem @(_tierView == "Premium" ? "highlighted" : "")">
                                            <div class="plg-price-tier"><span class="ch-dot d-prem"></span><span>بريميوم</span></div>
                                            <div class="plg-price-val">
                                                @if (p.PremiumPrice > 0) { <b>@p.PremiumPrice.Value.ToString("N0")</b><span class="plg-currency">ج</span> }
                                                @if (_canSeeCosts && p.PremiumCost > 0) { <span class="pl-cost-inline">ت @p.PremiumCost.Value.ToString("N0")</span> }                                                else { <span class="plg-no-price">—</span> }
                                            </div>
                                        </div>
                                    }
                                    @if (_tierView == "all" || _tierView == "Elite")
                                    {
                                        <div class="plg-price-row elite @(_tierView == "Elite" ? "highlighted" : "")">
                                            <div class="plg-price-tier">
                                                <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Style="font-size:12px;color:var(--gold)" />
                                                <span>إيليت</span>
                                            </div>
                                            <div class="plg-price-val">
                                                @if (p.ElitePrice > 0) { <b>@p.ElitePrice.Value.ToString("N0")</b><span class="plg-currency">ج</span> }
                                                @if (_canSeeCosts && p.EliteCost > 0) { <span class="pl-cost-inline">ت @p.EliteCost.Value.ToString("N0")</span> }                                                else { <span class="plg-no-price">—</span> }
                                            </div>
                                        </div>
                                    }
                                </div>

                                @* Price Comparison Bar *@
                                @if (_tierView == "all" && maxPrice > 0 && (p.StdPrice > 0 || p.PremiumPrice > 0 || p.ElitePrice > 0))
                                {
                                    <div class="plg-compare-bar">
                                        @if (p.StdPrice > 0)
                                        {
                                            <div class="plg-bar-track">
                                                <div class="plg-bar-fill-std" style="width:@((p.StdPrice.Value / maxPrice * 100).ToString("F0"))%"></div>
                                            </div>
                                        }
                                        @if (p.PremiumPrice > 0)
                                        {
                                            <div class="plg-bar-track">
                                                <div class="plg-bar-fill-prem" style="width:@((p.PremiumPrice.Value / maxPrice * 100).ToString("F0"))%"></div>
                                            </div>
                                        }
                                        @if (p.ElitePrice > 0)
                                        {
                                            <div class="plg-bar-track">
                                                <div class="plg-bar-fill-elite" style="width:100%"></div>
                                            </div>
                                        }
                                    </div>
                                }
                            }

                            <div class="plg-actions">
                                @if (_canSeeCosts)
                                {
                                    <button class="plg-action-ghost" title="سجل الأسعار"
                                            @onclick="@(() => OpenHistoryAsync(p))">
                                        <MudIcon Icon="@Icons.Material.Filled.History" Style="font-size:16px" />
                                    </button>
                                    <button class="plg-action-primary"
                                            @onclick="@(() => OpenPriceModal(p, false))">
                                        <MudIcon Icon="@Icons.Material.Filled.Edit" Style="font-size:15px" />
                                        تعديل سعر
                                    </button>
                                }
                                else if (_showPrices && !_pendingRequests.Contains(p.ProductId))
                                {
                                    <button class="plg-action-secondary"
                                            @onclick="@(() => OpenPriceModal(p, true))">
                                        <MudIcon Icon="@Icons.Material.Filled.OutlinedFlag" Style="font-size:15px" />
                                        طلب تعديل
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
            @if (_visibleCount < _filtered.Count)
            {
                <button class="pl-more" @onclick="LoadMore">⬇ تحميل المزيد — متبقٍ @(_filtered.Count - _visibleCount) صنف</button>
            }
        }

        @* ══ LIST ══ *@
        else if (_viewMode == "list")
        {
            <div class="pl-list">
                @foreach (var p in _filtered.Take(_visibleCount))
                {
                    var stock  = _stockMap.TryGetValue(p.ProductId, out var s) ? s : 0;
                    var pulse  = GetPricePulse(p);
                    <div class="pll-row" @oncontextmenu="@(e => OpenContext(e, p))" @oncontextmenu:preventDefault="true">
                        <img class="pll-thumb pl-clickable"
                             src="/api/product-images/@p.ProductId" alt="@p.ProductName"
                             loading="lazy" @onclick="@(() => OpenGalleryAsync(p))"
                             onerror="this.onerror=null;this.src='data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 40 40%22><rect fill=%22%23f1f5f9%22 width=%2240%22 height=%2240%22 rx=%228%22/></svg>';" />
                        <div class="pll-info">
                            <div class="pll-name">@((MarkupString)HighlightText(p.ProductName))</div>
                            <div class="pll-meta">
                                <a class="pl-code-link" href="/products/form/@p.ProductId" target="_blank">#@p.ProductId</a>
                                @if (p.IsWebsite) { <span class="pl-web-badge" title="منتج الموقع">🌐</span> }
                                <span class="pll-sep">·</span>
                                <span>@((MarkupString)HighlightText(p.GroupName))</span>
                                @if (pulse != null && _showPrices)
                                {
                                    <span style="font-size:.65rem;font-weight:800;padding:1px 6px;border-radius:100px;margin-right:4px;@(pulse.Value.up ? "background:rgba(22,101,52,.15);color:#16a34a" : "background:rgba(127,29,29,.15);color:#dc2626")">
                                        @(pulse.Value.up ? "↑" : "↓") @pulse.Value.pct%
                                    </span>
                                }
                            </div>
                        </div>
                        @if (_showPrices)
                        {
                            <div class="pll-prices">
                                <div class="pll-price-chip @(_tierView != "all" && _tierView != "CClass" ? "dim" : "")">
                                    <span class="ch-dot d-std"></span>
                                    <span>@(p.StdPrice > 0 ? p.StdPrice.Value.ToString("N0") : "—")</span>
                                @if (_canSeeCosts && p.StdCost > 0) { <span class="pl-cost-inline">ت @p.StdCost.Value.ToString("N0")</span> }                                </div>
                                <div class="pll-price-chip prem @(_tierView != "all" && _tierView != "Premium" ? "dim" : "")">
                                    <span class="ch-dot d-prem"></span>
                                    <span>@(p.PremiumPrice > 0 ? p.PremiumPrice.Value.ToString("N0") : "—")</span>
                                @if (_canSeeCosts && p.PremiumCost > 0) { <span class="pl-cost-inline">ت @p.PremiumCost.Value.ToString("N0")</span> }                                </div>
                                <div class="pll-price-chip elite @(_tierView != "all" && _tierView != "Elite" ? "dim" : "")">
                                    <span class="ch-dot d-elite"></span>
                                    <span>@(p.ElitePrice > 0 ? p.ElitePrice.Value.ToString("N0") : "—")</span>
                                @if (_canSeeCosts && p.EliteCost > 0) { <span class="pl-cost-inline">ت @p.EliteCost.Value.ToString("N0")</span> }                                </div>
                            </div>
                        }
                        <div class="pll-stock @(stock > 0 ? "ok" : "out")">@(stock > 0 ? stock.ToString("N0") : "نفذ")</div>
                        <div class="pll-actions">
                            @if (_canSeeCosts)
                            {
                                <button class="pll-btn ghost" title="سجل الأسعار" @onclick="@(() => OpenHistoryAsync(p))">
                                    <MudIcon Icon="@Icons.Material.Filled.History" Style="font-size:16px" />
                                </button>
                                <button class="pll-btn primary" title="تعديل سعر" @onclick="@(() => OpenPriceModal(p, false))">
                                    <MudIcon Icon="@Icons.Material.Filled.Edit" Style="font-size:16px" />
                                </button>
                            }
                            else if (_showPrices)
                            {
                                @if (_pendingRequests.Contains(p.ProductId))
                                {
                                    <button class="pll-btn warn" disabled title="طلب معلق">
                                        <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Style="font-size:16px" />
                                    </button>
                                }
                                else
                                {
                                    <button class="pll-btn secondary" title="طلب تعديل سعر" @onclick="@(() => OpenPriceModal(p, true))">
                                        <MudIcon Icon="@Icons.Material.Filled.OutlinedFlag" Style="font-size:16px" />
                                    </button>
                                }
                            }
                        </div>
                    </div>
                }
                @if (_visibleCount < _filtered.Count)
                {
                    <button class="pl-more" @onclick="LoadMore">⬇ تحميل المزيد — متبقٍ @(_filtered.Count - _visibleCount) صنف</button>
                }
                <div class="pl-footnote">عرض @Math.Min(_visibleCount, _filtered.Count) من @_rows.Count صنف</div>
            </div>
        }

        @* ══ TABLE — with Collapsible Groups ══ *@
        else
        {
            <div class="pl-table-wrap" style="overflow-x:auto">
                <table class="pl-table">
                    <thead>
                        <tr>
                            <th class="th-img"></th>
                            <th class="th-code">الكود</th>
                            <th>الصنف</th>
                            @if (_showPrices)
                            {
                                <th class="th-price @(_tierView != "all" && _tierView != "CClass"  ? "dim" : "")"><span class="ch-dot d-std"></span> ستاندرد</th>
                                <th class="th-price @(_tierView != "all" && _tierView != "Premium" ? "dim" : "")"><span class="ch-dot d-prem"></span> بريميوم</th>
                                <th class="th-price @(_tierView != "all" && _tierView != "Elite"   ? "dim" : "")">
                                    <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Style="font-size:12px;color:var(--gold)" /> إيليت
                                </th>
                            }
                            <th class="th-stock">المتاح</th>
                            <th class="th-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var grp in TableGroups)
                        {
                            var grpOpen = !_collapsedGroups.Contains(grp.Key);
                            var arrowClass = grpOpen ? "pl-group-arrow open" : "pl-group-arrow";
                            @* Group Header Row *@
                            <tr class="pl-group-row" @onclick="@(() => ToggleGroup(grp.Key))">
                                <td colspan="@((_showPrices ? 8 : 5))">
                                    <div class="pl-group-cell">
                                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight"
                                                 Class="@arrowClass" />
                                        @grp.Key
                                        <span class="pl-group-badge">@grp.Count() صنف</span>
                                    </div>
                                </td>
                            </tr>
                            @if (grpOpen)
                            {
                                @foreach (var p in grp)
                                {
                                    var stock = _stockMap.TryGetValue(p.ProductId, out var sv) ? sv : 0;
                                    <tr class="pl-table-row"
                                        @oncontextmenu="@(e => OpenContext(e, p))"
                                        @oncontextmenu:preventDefault="true">
                                        <td>
                                            <img class="plt-thumb pl-clickable"
                                                 src="/api/product-images/@p.ProductId" alt="@p.ProductName"
                                                 loading="lazy" @onclick="@(() => OpenGalleryAsync(p))"
                                                 onerror="this.onerror=null;this.src='data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 48 48%22><rect fill=%22%23f1f5f9%22 width=%2248%22 height=%2248%22 rx=%228%22/></svg>';" />
                                        </td>
                                        <td class="td-code">
                                            <a class="pl-code-link" href="/products/form/@p.ProductId" target="_blank">#@p.ProductId</a>
                                            @if (p.IsWebsite) { <span class="pl-web-badge" title="منتج الموقع">🌐</span> }
                                        </td>
                                        <td>
                                            <div class="plt-name">@((MarkupString)HighlightText(p.ProductName))</div>
                                        </td>
                                        @if (_showPrices)
                                        {
                                            <td class="td-price @(_tierView != "all" && _tierView != "CClass"  ? "dim" : "") @(_tierView == "CClass"  ? "active-col" : "")">
                                                <span class="plt-price-val">@(p.StdPrice > 0 ? p.StdPrice.Value.ToString("N0") : "—")</span>
                                                @if (_canSeeCosts && p.StdCost > 0) { <span class="plt-cost">ت @p.StdCost.Value.ToString("N0")</span> }                                            </td>
                                            <td class="td-price @(_tierView != "all" && _tierView != "Premium" ? "dim" : "") @(_tierView == "Premium" ? "active-col" : "")">
                                                <span class="plt-price-val prem">@(p.PremiumPrice > 0 ? p.PremiumPrice.Value.ToString("N0") : "—")</span>
                                                @if (_canSeeCosts && p.PremiumCost > 0) { <span class="plt-cost">ت @p.PremiumCost.Value.ToString("N0")</span> }                                            </td>
                                            <td class="td-price @(_tierView != "all" && _tierView != "Elite"   ? "dim" : "") @(_tierView == "Elite"   ? "active-col" : "")">
                                                <span class="plt-price-val elite">@(p.ElitePrice > 0 ? p.ElitePrice.Value.ToString("N0") : "—")</span>
                                                @if (_canSeeCosts && p.EliteCost > 0) { <span class="plt-cost">ت @p.EliteCost.Value.ToString("N0")</span> }                                            </td>
                                        }
                                        <td><span class="plt-stock @(stock > 0 ? "ok" : "out")">@(stock > 0 ? stock.ToString("N0") : "نفذ")</span></td>
                                        <td class="td-actions">
                                            @if (_canSeeCosts)
                                            {
                                                <button class="plt-btn ghost" title="سجل الأسعار" @onclick="@(() => OpenHistoryAsync(p))">
                                                    <MudIcon Icon="@Icons.Material.Filled.History" Style="font-size:15px" />
                                                </button>
                                                <button class="plt-btn primary" title="تعديل سعر" @onclick="@(() => OpenPriceModal(p, false))">
                                                    <MudIcon Icon="@Icons.Material.Filled.Edit" Style="font-size:15px" />
                                                </button>
                                            }
                                            else if (_showPrices)
                                            {
                                                @if (_pendingRequests.Contains(p.ProductId))
                                                {
                                                    <MudTooltip Text="يوجد طلب معلق">
                                                        <button class="plt-btn warn" disabled>
                                                            <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Style="font-size:15px" />
                                                        </button>
                                                    </MudTooltip>
                                                }
                                                else
                                                {
                                                    <button class="plt-btn secondary" title="طلب تعديل سعر" @onclick="@(() => OpenPriceModal(p, true))">
                                                        <MudIcon Icon="@Icons.Material.Filled.OutlinedFlag" Style="font-size:15px" />
                                                    </button>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
                @if (_visibleCount < _filtered.Count)
                {
                    <button class="pl-more" @onclick="LoadMore">⬇ تحميل المزيد — متبقٍ @(_filtered.Count - _visibleCount) صنف</button>
                }
                <div class="pl-footnote">عرض @Math.Min(_visibleCount, _filtered.Count) من @_rows.Count صنف — الأسعار بالجنيه المصري وقابلة للتغيير.</div>
            </div>
        }

        @* ══ PRICE MODAL — Desktop or Mobile Bottom Sheet ══ *@
        @if (_priceModalOpen && _modalProduct is not null)
        {
            @if (_isMobile)
            {
                @* Mobile Bottom Sheet *@
                <div class="pl-bottom-sheet-overlay" @onclick="ClosePriceModal">
                    <div class="pl-bottom-sheet" @onclick:stopPropagation="true">
                        <div class="pl-sheet-handle-wrap"><div class="pl-sheet-handle"></div></div>
                        <div class="plm-head" style="border-radius:0">
                            <img class="plm-thumb" src="/api/product-images/@_modalProduct.ProductId" alt=""
                                 onerror="this.onerror=null;this.src='data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 52 52%22><rect fill=%22%23ffffff22%22 width=%2252%22 height=%2252%22 rx=%2212%22/></svg>';" />
                            <div class="plm-head-info">
                                <div class="plm-head-tag">@(_modalIsRequest ? "طلب تعديل سعر" : _isAdmin ? "تعديل سعر مباشر" : "تعديل التكاليف")</div>
                                <div class="plm-head-name">@_modalProduct.ProductName</div>
                                <div class="plm-head-sub">@_modalProduct.GroupName · كود @_modalProduct.ProductId</div>
                            </div>
                            <button type="button" class="pl-close-btn" @onclick="ClosePriceModal">
                                <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:18px" />
                            </button>
                        </div>
                        <div class="pl-sheet-body">
                            @* نفس محتوى المودال *@
                            @ModalBody()
                        </div>
                        <div class="plm-footer">
                            <button class="plm-btn cancel" @onclick="ClosePriceModal">إلغاء</button>
                            <button class="plm-btn @(_modalIsRequest ? "secondary" : "primary")"
                                    disabled="@(_isSaving || string.IsNullOrWhiteSpace(_modalReason))"
                                    @onclick="SavePriceAsync">
                                @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                                @(_modalIsRequest ? "إرسال الطلب" : "حفظ التعديل")
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                @* Desktop Modal *@
                <div class="pl-overlay" @onclick="ClosePriceModal">
                    <div class="pl-modal" @onclick:stopPropagation="true">
                        <div class="plm-head">
                            <img class="plm-thumb" src="/api/product-images/@_modalProduct.ProductId" alt=""
                                 onerror="this.onerror=null;this.src='data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 52 52%22><rect fill=%22%23ffffff22%22 width=%2252%22 height=%2252%22 rx=%2212%22/></svg>';" />
                            <div class="plm-head-info">
                                <div class="plm-head-tag">@(_modalIsRequest ? "طلب تعديل سعر" : _isAdmin ? "تعديل سعر مباشر" : "تعديل التكاليف")</div>
                                <div class="plm-head-name">@_modalProduct.ProductName</div>
                                <div class="plm-head-sub">@_modalProduct.GroupName · كود @_modalProduct.ProductId</div>
                            </div>
                            <button type="button" class="pl-close-btn" @onclick="ClosePriceModal">
                                <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:18px" />
                            </button>
                        </div>
                        <div class="plm-body">@ModalBody()</div>
                        <div class="plm-footer">
                            <button class="plm-btn cancel" @onclick="ClosePriceModal">إلغاء</button>
                            <button class="plm-btn @(_modalIsRequest ? "secondary" : "primary")"
                                    disabled="@(_isSaving || string.IsNullOrWhiteSpace(_modalReason))"
                                    @onclick="SavePriceAsync">
                                @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                                @(_modalIsRequest ? "إرسال الطلب" : "حفظ التعديل")
                            </button>
                        </div>
                    </div>
                </div>
            }
        }

        @* ══ HISTORY DRAWER ══ *@
        @if (_historyOpen && _historyProduct is not null)
        {
            <div class="plh-overlay" @onclick="@(() => _historyOpen = false)">
                <div class="plh-drawer" @onclick:stopPropagation="true">
                    <div class="plh-head">
                        <div class="plh-head-icon"><MudIcon Icon="@Icons.Material.Filled.History" /></div>
                        <div class="plh-head-info">
                            <div class="plh-head-title">سجل الأسعار</div>
                            <div class="plh-head-sub">@_historyProduct.ProductName</div>
                        </div>
                        <button type="button" class="pl-close-btn" @onclick="@(() => _historyOpen = false)">
                            <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:18px" />
                        </button>
                    </div>
                    <div class="plh-body">
                        @if (_historyLoading)
                        {
                            <div class="plh-loading"><div class="plh-spinner"></div><span>جارٍ التحميل…</span></div>
                        }
                        else if (_history.Count == 0)
                        {
                            <div class="plh-empty">
                                <MudIcon Icon="@Icons.Material.Filled.History" Style="font-size:48px;opacity:.2" />
                                <div class="plh-empty-title">لا يوجد سجل بعد</div>
                                <div class="plh-empty-sub">أول تعديل سعر هيتسجل هنا تلقائياً</div>
                            </div>
                        }
                        else
                        {
                            <div class="plh-hint">
                                <MudIcon Icon="@Icons.Material.Filled.Sort" Style="font-size:14px" />
                                من الأحدث للأقدم · @_history.Count تغيير
                            </div>
                            <div class="plh-timeline">
                                @foreach (var h in _history)
                                {
                                    var dotCls   = h.PriceType switch { "CClass" => "",      "Elite" => "elite", _ => "prem" };
                                    var badgeCls = h.PriceType switch { "CClass" => "std",   "Elite" => "elite", _ => "prem" };
                                    <div class="plh-item">
                                        <div class="plh-item-dot @dotCls"></div>
                                        <div class="plh-item-card">
                                            <div class="plh-item-head">
                                                <span class="plh-tier-badge @badgeCls">@(h.PriceType.EndsWith("_Cost") ? "تكلفة " + TierLabel(h.PriceType.Replace("_Cost", "")) : TierLabel(h.PriceType))</span>
                                                <span class="plh-date">@h.ChangedAt.ToString("yyyy/MM/dd HH:mm")</span>
                                            </div>
                                            <div class="plh-price-change">
                                                @if (h.OldPrice.HasValue)
                                                {
                                                    <span class="plh-old-price">@h.OldPrice.Value.ToString("N0") ج</span>
                                                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Style="font-size:14px;color:#94a3b8" />
                                                }
                                                <span class="plh-new-price">@h.NewPrice.ToString("N0") ج</span>
                                            </div>
                                            <div class="plh-changed-by">
                                                <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size:12px;opacity:.5" />
                                                @h.ChangedBy
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(h.ChangeReason))
                                            {
                                                <div class="plh-reason">
                                                    <MudIcon Icon="@Icons.Material.Filled.Notes" Style="font-size:12px;opacity:.6" />
                                                    @h.ChangeReason
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @* ══ GALLERY ══ *@
        @if (_galleryOpen && _galleryProduct is not null)
        {
            <div class="plgal-overlay" @onclick="CloseGallery">
                <div class="plgal-box" @onclick:stopPropagation="true">
                    <div class="plgal-head">
                        <div class="plgal-head-info">
                            <div class="plgal-name">@_galleryProduct.ProductName</div>
                            <div class="plgal-sub">@_galleryProduct.GroupName · كود @_galleryProduct.ProductId</div>
                        </div>
                        @if (_galleryIds.Count > 1) { <div class="plgal-counter">@(_galleryIndex + 1) / @_galleryIds.Count</div> }
                        <button type="button" class="pl-close-btn" @onclick="CloseGallery">
                            <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:18px" />
                        </button>
                    </div>
                    <div class="plgal-stage">
                        @if (_galleryLoading)
                        {
                            <div class="plh-loading"><div class="plh-spinner"></div><span>جارٍ تحميل الصور…</span></div>
                        }
                        else if (_galleryIds.Count == 0)
                        {
                            <div class="plgal-empty">
                                <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Style="font-size:52px;opacity:.25" />
                                <p>لا توجد صور لهذا المنتج</p>
                            </div>
                        }
                        else
                        {
                            @if (_galleryIds.Count > 1)
                            {
                                <button type="button" class="plgal-nav prev" @onclick="GalleryPrevAsync">
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
                                </button>
                            }
                            <img class="plgal-main"
                                 src="/api/product-image-by-id/@_galleryIds[_galleryIndex]"
                                 alt="@_galleryProduct.ProductName" />
                            @if (_galleryIds.Count > 1)
                            {
                                <button type="button" class="plgal-nav next" @onclick="GalleryNextAsync">
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" />
                                </button>
                            }
                        }
                    </div>
                    @if (!_galleryLoading && _galleryIds.Count > 1)
                    {
                        <div class="plgal-thumbs">
                            @for (var i = 0; i < _galleryIds.Count; i++)
                            {
                                var idx = i;
                                <img class="plgal-thumb @(idx == _galleryIndex ? "active" : "")"
                                     src="/api/product-image-by-id/@_galleryIds[idx]"
                                     alt="صورة @(idx+1)" loading="lazy"
                                     @onclick="@(() => _galleryIndex = idx)" />
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @* ══ STICKY COMPARISON BAR ══ *@
        @if (_compareList.Count > 0 && _showPrices)
        {
            <div class="pl-compare-bar">
                <span class="pl-compare-label">
                    <MudIcon Icon="@Icons.Material.Filled.Compare" Style="font-size:16px;vertical-align:middle" />
                    مقارنة (@_compareList.Count)
                </span>
                <div class="pl-compare-items">
                    @foreach (var cp in _compareList)
                    {
                        <div class="pl-compare-item">
                            <div class="pl-compare-item-name" title="@cp.ProductName">@cp.ProductName</div>
                            <div class="pl-compare-item-prices">
                                @if (cp.StdPrice > 0) {
                                    <div class="pl-compare-price-row"><span class="ch-dot d-std"></span><span>@cp.StdPrice.Value.ToString("N0") ج</span></div>
                                }
                                @if (cp.PremiumPrice > 0) {
                                    <div class="pl-compare-price-row"><span class="ch-dot d-prem"></span><span>@cp.PremiumPrice.Value.ToString("N0") ج</span></div>
                                }
                                @if (cp.ElitePrice > 0) {
                                    <div class="pl-compare-price-row"><span class="ch-dot d-elite"></span><span>@cp.ElitePrice.Value.ToString("N0") ج</span></div>
                                }
                            </div>
                            <button class="pl-compare-clear-btn" title="إزالة" @onclick="@(() => _compareList.Remove(cp))">
                                <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:14px" />
                            </button>
                        </div>
                    }
                </div>
                <button class="pl-compare-close" title="إغلاق المقارنة" @onclick="() => _compareList.Clear()">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:16px" />
                </button>
            </div>
        }

        @* ══ PRINT SHEET ══ *@
        @if (_printMode is not null)
        {
            var showAllTiers = _printMode == "full" || _printMode == "costs";
            var showNoPrice  = _printMode == "noprice";
            var showCosts    = _printMode == "costs";
            var tierFilter   = showAllTiers || showNoPrice ? "all" : _tierView == "all" ? "Premium" : _tierView;
            var versionLbl   = _printMode == "costs" ? "إصدار داخلي — الفئات الثلاثة + التكاليف"
                             : showAllTiers ? "الإصدار الكامل — الفئات الثلاثة"
                             : showNoPrice  ? "كتالوج عرض — بدون أسعار"
                             : $"إصدار فئة {TierLabel(tierFilter)}";
            var printRows    = _filtered.Where(r => showNoPrice || r.HasAnyPrice).ToList();
            var printGroups  = printRows.GroupBy(r => r.GroupName).OrderBy(g => g.Key).ToList();
            <div class="pl-print-sheet">
                <div class="plp-band">
                    <div class="plp-brand-row">
                        <div class="plp-brand">COCOBOLO <span>ERP</span></div>
                        <div class="plp-version">@versionLbl</div>
                    </div>
                    <div class="plp-title">@(showNoPrice ? "كتالوج المنتجات" : "قائمة الأسعار")</div>
                    <div class="plp-sub">@printRows.Count صنف في @printGroups.Count مجموعة — بتاريخ @DateTime.Now.ToString("yyyy/MM/dd")</div>
                </div>
                @foreach (var grp in printGroups)
                {
                    <div class="plp-group-header">
                        <span class="plp-group-name">@grp.Key</span>
                        <span class="plp-group-count">@grp.Count() صنف</span>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th style="width:28px">م</th>
                                <th style="width:54px">الكود</th>
                                <th style="width:50px" class="plp-c">الصورة</th>
                                <th>الصنف</th>
                                @if (!showNoPrice)
                                {
                                    @if (showAllTiers) {
                                        <th style="width:76px" class="plp-c">ستاندرد</th>
                                        <th style="width:76px" class="plp-c">بريميوم</th>
                                        <th style="width:76px" class="plp-c">إيليت</th>
                                        @if (showCosts) {
                                            <th style="width:64px" class="plp-c">ت. ستاندرد</th>
                                            <th style="width:64px" class="plp-c">ت. بريميوم</th>
                                            <th style="width:64px" class="plp-c">ت. إيليت</th>
                                        }
                                    } else {
                                        <th style="width:100px" class="plp-c">السعر (@TierLabel(tierFilter))</th>
                                    }
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{ int n = 0; }
                            @foreach (var p in grp)
                            {
                                n++;
                                <tr>
                                    <td class="plp-c">@n</td>
                                    <td class="plp-c">@p.ProductId</td>
                                    <td class="plp-c"><img class="plp-img" src="/api/product-images/@p.ProductId" alt="" /></td>
                                    <td>@p.ProductName</td>
                                    @if (!showNoPrice)
                                    {
                                        @if (showAllTiers) {
                                            <td class="plp-c plp-std">@(p.StdPrice > 0 ? p.StdPrice.Value.ToString("N0") : "—")</td>
                                            <td class="plp-c plp-prem">@(p.PremiumPrice > 0 ? p.PremiumPrice.Value.ToString("N0") : "—")</td>
                                            <td class="plp-c plp-elite">@(p.ElitePrice > 0 ? p.ElitePrice.Value.ToString("N0") : "—")</td>
                                            @if (showCosts) {
                                                <td class="plp-c">@(p.StdCost > 0 ? p.StdCost.Value.ToString("N0") : "—")</td>
                                                <td class="plp-c">@(p.PremiumCost > 0 ? p.PremiumCost.Value.ToString("N0") : "—")</td>
                                                <td class="plp-c">@(p.EliteCost > 0 ? p.EliteCost.Value.ToString("N0") : "—")</td>
                                            }
                                        } else {
                                            var v = tierFilter == "CClass" ? p.StdPrice : tierFilter == "Elite" ? p.ElitePrice : p.PremiumPrice;
                                            <td class="plp-c plp-strong">@(v > 0 ? v.Value.ToString("N0") : "—")</td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                <div class="plp-footer">
                    <span>جميع الأسعار بالجنيه المصري وقابلة للتغيير دون إشعار مسبق.</span>
                    <span class="plp-sign">اعتماد: ....................</span>
                </div>
            </div>
        }

    </MudContainer>
}

@code {
    // ══ Permissions ══
    private bool   _canView;
    private bool   _showPrices = true;
    private bool   _isAdmin;
    private string _currentUserName = "System";
    private bool   _isMobile;

    // ══ Data ══
    private List<PriceListRowDto>     _rows            = new();
    private List<string>              _groups          = new();
    private List<PriceListBranchDto>  _branches        = new();
    private Dictionary<int, int>      _stockMap        = new();
    private HashSet<int>              _pendingRequests  = new();
    private Dictionary<int, decimal>  _prevPriceMap    = new(); // للـ pulse

    // ══ Filters & View ══
    private string? _search;
    private string? _group;
    private int?    _branchId;
    private int     _priceFilter;
    private bool    _onlyWebsite;        // 🌐 فلتر منتجات الموقع (2026-09-17)
    private string  _tierView  = "all";
    private string  _viewMode  = "grid";
    private bool    _loading   = true;

    // ══ Collapsible Groups ══
    private HashSet<string> _collapsedGroups = new();
    private IEnumerable<IGrouping<string, PriceListRowDto>> TableGroups =>
        _filtered.Take(_visibleCount).GroupBy(r => r.GroupName).OrderBy(g => g.Key);
    private void ToggleGroup(string key) { if (!_collapsedGroups.Add(key)) _collapsedGroups.Remove(key); }

    // ══ Price Modal ══
    private bool              _priceModalOpen;
    private bool              _modalIsRequest;
    private PriceListRowDto?  _modalProduct;
    private string            _modalTier     = "Premium";
    private decimal           _modalNewPrice;
    private string?           _modalReason;
    private bool              _canSeeCosts;                                  // 💰 Admin/AM/Account فقط
    private int               _visibleCount = 60;                            // ترقيم تدريجي — تحميل المزيد
    private decimal?[]        _modalCosts  = new decimal?[3];                // تكاليف جديدة (null = بدون تغيير)
    private (decimal s, decimal p, decimal e) _modalCostOrig;                // تكاليف الحفظ عند فتح المودال
    private bool              _isSaving;

    // ══ History ══
    private bool                     _historyOpen;
    private bool                     _historyLoading;
    private PriceListRowDto?         _historyProduct;
    private List<PriceHistoryRowDto> _history = new();

    // ══ Gallery ══
    private bool             _galleryOpen;
    private bool             _galleryLoading;
    private PriceListRowDto? _galleryProduct;
    private List<int>        _galleryIds  = new();
    private int              _galleryIndex;

    // ══ Context Menu ══
    private bool             _ctxOpen;
    private PriceListRowDto? _ctxProduct;
    private double           _ctxX, _ctxY;

    // ══ Compare ══
    private List<PriceListRowDto> _compareList = new();
    private void ToggleCompare(PriceListRowDto p)
    {
        var existing = _compareList.FirstOrDefault(x => x.ProductId == p.ProductId);
        if (existing != null) _compareList.Remove(existing);
        else if (_compareList.Count < 4) _compareList.Add(p);
        else Snackbar.Add("أقصى عدد للمقارنة 4 منتجات", Severity.Warning);
        StateHasChanged();
    }

    // ══ Saved Views ══
    private List<SavedView> _savedViews = new();
    private record SavedView(string Name, string Search, string Group, int? BranchId, string TierView, int PriceFilter, string ViewMode);
    private async Task SaveCurrentView()
    {
        var name = $"{(!string.IsNullOrEmpty(_group) ? _group : "كل المجموعات")} · {TierLabel(_tierView)}";
        _savedViews.Add(new SavedView(name, _search ?? "", _group ?? "", _branchId, _tierView, _priceFilter, _viewMode));
        try { await JS.InvokeVoidAsync("localStorage.setItem", "pl_saved_views", System.Text.Json.JsonSerializer.Serialize(_savedViews)); } catch { }
        Snackbar.Add("تم حفظ العرض الحالي", Severity.Success);
        StateHasChanged();
    }
    private void ApplySavedView(SavedView v) { _search = v.Search; _group = v.Group; _branchId = v.BranchId; _tierView = v.TierView; _priceFilter = v.PriceFilter; _viewMode = v.ViewMode; StateHasChanged(); }
    private async Task DeleteSavedView(SavedView v)
    {
        _savedViews.Remove(v);
        try { await JS.InvokeVoidAsync("localStorage.setItem", "pl_saved_views", System.Text.Json.JsonSerializer.Serialize(_savedViews)); } catch { }
        StateHasChanged();
    }

    // ══ KB Shortcut Toast ══
    private bool _showKbToast;
    private string? _printMode;

    // ══ Keyboard ══
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (_priceModalOpen || _historyOpen || _galleryOpen) { if (e.Key == "Escape") { ClosePriceModal(); _historyOpen = false; CloseGallery(); } return; }
        switch (e.Key)
        {
            case "g" or "G": _viewMode = "grid";  StateHasChanged(); break;
            case "l" or "L": _viewMode = "list";  StateHasChanged(); break;
            case "t" or "T": _viewMode = "table"; StateHasChanged(); break;
            case "?":        _showKbToast = !_showKbToast; StateHasChanged(); break;
            case "Escape":
                if (_showKbToast) { _showKbToast = false; StateHasChanged(); }
                else if (HasActiveFilters) await ResetAllFiltersAsync();
                break;
            case "f" or "F":
                if (e.CtrlKey) { await JS.InvokeVoidAsync("document.getElementById('pl-search-input')?.focus"); }
                break;
            case "p" or "P":
                if (e.CtrlKey && _isAdmin) { await PrintAsync("full"); }
                break;
        }
    }

    // ══ Context Menu ══
    private void OpenContext(MouseEventArgs e, PriceListRowDto p)
    {
        _ctxProduct = p; _ctxX = e.ClientX; _ctxY = e.ClientY; _ctxOpen = true; StateHasChanged();
    }
    private void CloseContext() { _ctxOpen = false; StateHasChanged(); }
    private async Task CopyToClipboard(string text)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); Snackbar.Add("تم النسخ", Severity.Success); } catch { }
    }

    // ══ Price Pulse ══
    private (bool up, int pct)? GetPricePulse(PriceListRowDto p)
    {
        if (!_prevPriceMap.TryGetValue(p.ProductId, out var prev) || prev <= 0) return null;
        var curr = p.PremiumPrice ?? p.StdPrice ?? p.ElitePrice ?? 0;
        if (curr <= 0 || curr == prev) return null;
        var pct = (int)Math.Abs((curr - prev) / prev * 100);
        if (pct < 1) return null;
        return (curr > prev, pct);
    }

    // ══ Search Highlight ══
    private string HighlightText(string text)
    {
        if (string.IsNullOrWhiteSpace(_search) || string.IsNullOrWhiteSpace(text)) return System.Net.WebUtility.HtmlEncode(text);
        var escaped = System.Net.WebUtility.HtmlEncode(text);
        var term    = System.Net.WebUtility.HtmlEncode(_search.Trim());
        return System.Text.RegularExpressions.Regex.Replace(escaped, System.Text.RegularExpressions.Regex.Escape(term),
            m => $"<mark class='pl-highlight'>{m.Value}</mark>",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    }

    // ══ Modal Body (shared between Desktop & Mobile) ══
    private RenderFragment ModalBody() => __builder =>
    {
        if (_modalProduct is null) return;
        <div class="plm-section-label">اختر الفئة السعرية</div>
        <div class="plm-tiers">
            <div class="plm-tier @(_modalTier == "CClass"  ? "sel std"   : "")" @onclick='@(() => _modalTier = "CClass")'>
                <div class="plm-tier-top"><span class="ch-dot d-std"></span>@if(_modalTier=="CClass"){<MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:15px;color:#64748b;margin-right:auto"/>}</div>
                <div class="plm-tier-name">ستاندرد</div>
                <div class="plm-tier-price">@(_modalProduct.StdPrice > 0 ? _modalProduct.StdPrice.Value.ToString("N0") + " ج" : "—")</div>
            </div>
            <div class="plm-tier @(_modalTier == "Premium" ? "sel prem"  : "")" @onclick='@(() => _modalTier = "Premium")'>
                <div class="plm-tier-top"><span class="ch-dot d-prem"></span>@if(_modalTier=="Premium"){<MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:15px;color:#6366f1;margin-right:auto"/>}</div>
                <div class="plm-tier-name">بريميوم</div>
                <div class="plm-tier-price">@(_modalProduct.PremiumPrice > 0 ? _modalProduct.PremiumPrice.Value.ToString("N0") + " ج" : "—")</div>
            </div>
            <div class="plm-tier @(_modalTier == "Elite"   ? "sel elite" : "")" @onclick='@(() => _modalTier = "Elite")'>
                <div class="plm-tier-top"><MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Style="font-size:15px;color:var(--gold)"/>@if(_modalTier=="Elite"){<MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:15px;color:var(--gold);margin-right:auto"/>}</div>
                <div class="plm-tier-name">إيليت</div>
                <div class="plm-tier-price">@(_modalProduct.ElitePrice > 0 ? _modalProduct.ElitePrice.Value.ToString("N0") + " ج" : "—")</div>
            </div>
        </div>
        @if (_modalIsRequest || _isAdmin)
        {
            <div class="plm-section-label" style="margin-top:18px">السعر الجديد</div>
            <MudNumericField T="decimal" @bind-Value="_modalNewPrice" Variant="Variant.Outlined" Min="0" Max="10000000" FullWidth="true" Suffix="ج.م" />
        }
        @if (!_modalIsRequest && _canSeeCosts)
        {
            <div class="plm-section-label" style="margin-top:16px">تكلفة الباقات <span style="font-weight:600;font-size:.68rem;color:var(--mud-palette-text-secondary)">(اتركها كما هي إن لم تتغير)</span></div>
            <div class="plm-cost-grid">
                <MudNumericField T="decimal?" @bind-Value="_modalCosts[0]" Placeholder='@_modalCostOrig.s.ToString("N0")' Label="تكلفة ستاندرد" Variant="Variant.Outlined" Min="0" FullWidth="true" Suffix="ج.م" />
                <MudNumericField T="decimal?" @bind-Value="_modalCosts[1]" Placeholder='@_modalCostOrig.p.ToString("N0")' Label="تكلفة بريميوم" Variant="Variant.Outlined" Min="0" FullWidth="true" Suffix="ج.م" />
                <MudNumericField T="decimal?" @bind-Value="_modalCosts[2]" Placeholder='@_modalCostOrig.e.ToString("N0")' Label="تكلفة إيليت" Variant="Variant.Outlined" Min="0" FullWidth="true" Suffix="ج.م" />
            </div>
        }<div class="plm-section-label" style="margin-top:16px">@(_modalIsRequest ? "سبب الطلب" : "سبب التعديل") <span style="color:#FC8181">*</span></div>
        <MudTextField T="string" @bind-Value="_modalReason" Variant="Variant.Outlined" Lines="2" MaxLength="300" Counter="300" Placeholder="اكتب السبب هنا…" />
        <div class="plm-notice @(_modalIsRequest ? "info" : "warn")">
            <MudIcon Icon="@(_modalIsRequest ? Icons.Material.Filled.Info : Icons.Material.Filled.Warning)" Style="font-size:16px;flex-shrink:0" />
            <span>@(_modalIsRequest ? "الطلب يظهر للمدير ومدير الحسابات وبعد الموافقة يُحدَّث السعر ويُوثَّق." : "سيتم توثيق التعديل في تاريخ الأسعار باسمك مع السبب.")</span>
        </div>
    };

    // ══ Active Filters ══
    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_search) || !string.IsNullOrWhiteSpace(_group)
        || _branchId.HasValue || _tierView != "all" || _priceFilter != 0;

    // ══ Filter Logic ══
    private static string NormTxt(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;
        var sb = new System.Text.StringBuilder(input.Length);
        foreach (var ch in input.Trim().ToLowerInvariant())
        {
            if (ch == '\u0640' || (ch >= '\u064B' && ch <= '\u0652') || ch == '\u0670') continue;
            switch (ch)
            {
                case '\u0623' or '\u0625' or '\u0622': sb.Append('\u0627'); break;
                case '\u0629': sb.Append('\u0647'); break;
                case '\u0649': sb.Append('\u064A'); break;
                case '\u0624': sb.Append('\u0648'); break;
                case '\u0626': sb.Append('\u064A'); break;
                default: if (char.IsLetterOrDigit(ch)) sb.Append(ch); break;
            }
        }
        return sb.ToString();
    }

    private bool MatchesCore(PriceListRowDto r)
    {
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var term   = NormTxt(_search);
            var byText = NormTxt(r.ProductName).Contains(term, StringComparison.Ordinal)
                      || NormTxt(r.GroupName).Contains(term, StringComparison.Ordinal);
            var byCode = int.TryParse(_search.Trim(), out var code) && r.ProductId == code;
            if (!byText && !byCode) return false;
        }
        if (!string.IsNullOrWhiteSpace(_group) && !string.Equals(NormTxt(r.GroupName), NormTxt(_group), StringComparison.Ordinal)) return false;
        if (_tierView == "CClass"  && !((r.StdPrice     ?? 0) > 0)) return false;
        if (_tierView == "Premium" && !((r.PremiumPrice  ?? 0) > 0)) return false;
        if (_tierView == "Elite"   && !((r.ElitePrice    ?? 0) > 0)) return false;
        if (_branchId.HasValue) { var st = _stockMap.TryGetValue(r.ProductId, out var sv) ? sv : 0; if (st <= 0) return false; }
        return true;
    }

    private bool MatchesFilters(PriceListRowDto r) => MatchesCore(r)
        && (!_onlyWebsite || r.IsWebsite)
        && _priceFilter switch
        {
            1 => !r.HasAnyPrice, 2 => r.HasAnyPrice, _ => true
        };

    private List<PriceListRowDto> _filtered     => _rows.Where(MatchesFilters).ToList();
    private List<PriceListRowDto> _coreFiltered => _rows.Where(MatchesCore).ToList();
    private int  _statTotal   => _coreFiltered.Count;
    private int  _statPriced  => _coreFiltered.Count(r =>  r.HasAnyPrice);
    private int  _statMissing => _coreFiltered.Count(r => !r.HasAnyPrice);
    private int  _statWebsite => _coreFiltered.Count(r => r.IsWebsite);
    private bool _noActiveFilters => !HasActiveFilters;

    private async Task ResetAllFiltersAsync()
    {
        _search = null; _group = null; _branchId = null; _tierView = "all"; _priceFilter = 0; _onlyWebsite = false;
        try { _stockMap = await PriceListService.GetStockMapAsync(null); } catch { }
        StateHasChanged();
    }

    // ══ Init ══
    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;

        _canView = user.HasClaim("Permission", "frm_PriceList:View")
            || user.IsInRole("Admin") || user.IsInRole(SystemRoles.Admin);
        if (!_canView) { Nav.NavigateTo("/"); return; }

        var role    = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        _showPrices = role != "factory";
        _isAdmin    = user.IsInRole("Admin") || user.IsInRole(SystemRoles.Admin)
            || user.IsInRole("AccountManager") || user.IsInRole(SystemRoles.AccountManager);
        _currentUserName = user.Identity?.Name ?? "System";
        // 💰 التكلفة: المدير ومدير الحسابات والمحاسب فقط (قرار المستخدم 2026-09-17)
        _canSeeCosts = _isAdmin || role == "Account";

        // Load saved views from localStorage
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", "pl_saved_views");
            if (!string.IsNullOrEmpty(json))
                _savedViews = System.Text.Json.JsonSerializer.Deserialize<List<SavedView>>(json) ?? new();
        }
        catch { }

        // Detect mobile
        try { _isMobile = await JS.InvokeAsync<bool>("eval", "window.innerWidth < 768"); } catch { }

        await LoadAllAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Keyboard listener على مستوى الـ document
            await JS.InvokeVoidAsync("eval", @"
                window._plKeyHandler = function(e) {
                    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
                    if (e.key === 'g' || e.key === 'G') window._plDotNet?.invokeMethodAsync('SetView','grid');
                    if (e.key === 'l' || e.key === 'L') window._plDotNet?.invokeMethodAsync('SetView','list');
                    if (e.key === 't' || e.key === 'T') window._plDotNet?.invokeMethodAsync('SetView','table');
                    if (e.ctrlKey && e.key === 'f') { e.preventDefault(); document.getElementById('pl-search-input')?.focus(); }
                };
                document.addEventListener('keydown', window._plKeyHandler);
            ");
        }
    }

    private async Task LoadAllAsync()
    {
        _loading = true; StateHasChanged();
        try
        {
            // حفظ الأسعار القديمة للـ pulse
            if (_rows.Any())
                _prevPriceMap = _rows.ToDictionary(r => r.ProductId, r => r.PremiumPrice ?? r.StdPrice ?? 0);

            var rowsTask    = PriceListService.GetRowsAsync();
            var branchTask  = PriceListService.GetBranchesAsync();
            var stockTask   = PriceListService.GetStockMapAsync(_branchId);
            var pendingTask = PriceListService.GetPendingRequestProductIdsAsync();
            await Task.WhenAll(rowsTask, branchTask, stockTask, pendingTask);
            _rows            = rowsTask.Result;
            _branches        = branchTask.Result;
            _stockMap        = stockTask.Result;
            _pendingRequests = pendingTask.Result;
            _groups          = _rows.Select(r => r.GroupName).Where(g => !string.IsNullOrWhiteSpace(g)).Distinct().OrderBy(g => g).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load price list");
            Snackbar.Add("تعذّر تحميل قائمة الأسعار: " + ex.Message, Severity.Error);
        }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task OnBranchChangedAsync()
    {
        try   { _stockMap = await PriceListService.GetStockMapAsync(_branchId); }
        catch (Exception ex) { Logger.LogWarning(ex, "Stock map reload failed"); }
        StateHasChanged();
    }

    // ══ Price Modal ══
    private void OpenPriceModal(PriceListRowDto p, bool asRequest)
    {
        // التحقق من الصلاحية
        if (asRequest && !_showPrices) return;
        if (!asRequest && !_canSeeCosts) return;
        _modalProduct   = p; _modalIsRequest = asRequest;
        _modalTier      = _tierView == "all" ? "Premium" : _tierView;
        _modalNewPrice  = 0; _modalReason = null;
        _modalCostOrig  = (p.StdCost ?? 0, p.PremiumCost ?? 0, p.EliteCost ?? 0);
        _modalCosts     = new decimal?[3];
        _priceModalOpen = true; StateHasChanged();
    }
    private void LoadMore() { _visibleCount += 60; StateHasChanged(); }
    private void ClosePriceModal() { _priceModalOpen = false; StateHasChanged(); }

    private async Task SavePriceAsync()
    {
        if (_modalProduct is null || string.IsNullOrWhiteSpace(_modalReason)) return;
        if (_modalNewPrice < 0) { Snackbar.Add("السعر غير صالح", Severity.Warning); return; }
        // تحقق إضافي من الصلاحيات
        if (_modalIsRequest && !_showPrices)   { Snackbar.Add("غير مصرح", Severity.Error); return; }
        if (!_modalIsRequest && !_canSeeCosts) { Snackbar.Add("غير مصرح", Severity.Error); return; }

        // 💰 جمع تغييرات التكلفة (null = بدون تغيير)
        var costChange = new (string Tier, decimal Val, int Idx)?[3];
        if (!_modalIsRequest && _canSeeCosts)
        {
            string[] tiers  = { "CClass", "Premium", "Elite" };
            decimal[] origs = { _modalCostOrig.s, _modalCostOrig.p, _modalCostOrig.e };
            for (int i = 0; i < 3; i++)
                if (_modalCosts[i].HasValue && Math.Round(_modalCosts[i]!.Value, 2) != Math.Round(origs[i], 2))
                    costChange[i] = (tiers[i], _modalCosts[i]!.Value, i);
        }
        var anyCostChange = costChange.Any(c => c.HasValue);
        var isPriceEdit   = _modalIsRequest || _isAdmin;   // المحاسب: تكلفة فقط
        if (!isPriceEdit && !anyCostChange) { Snackbar.Add("أدخل تغييراً واحداً على الأقل في التكاليف", Severity.Warning); return; }

        _isSaving = true; StateHasChanged();
        try
        {
            var (ok, msg) = (true, "");
            if (_modalIsRequest)
                (ok, msg) = await PriceListService.RequestPriceChangeAsync(_modalProduct.ProductId, _modalTier, _modalNewPrice, _modalReason, _currentUserName);
            else if (_isAdmin)
                (ok, msg) = await PriceListService.UpdatePriceAsync(_modalProduct.ProductId, _modalTier, _modalNewPrice, _modalReason, _currentUserName);

            var costSaved = 0; var costMsg = "";
            foreach (var c in costChange.Where(c => c.HasValue))
            {
                var (cok, cmsg) = await PriceListService.UpdateCostAsync(_modalProduct.ProductId, c!.Value.Tier, c.Value.Val, _modalReason, _currentUserName);
                if (cok) costSaved++; else costMsg = cmsg;
            }

            if (ok && costSaved > 0)          msg += $" + تم تحديث {costSaved} تكلفة.";
            else if (!ok && costSaved > 0)    msg = $"تم تحديث {costSaved} تكلفة بنجاح." + (costMsg != "" ? " — " + costMsg : "");
            else if (!ok && costMsg != "")    { msg = costMsg; }

            var anyOk = ok || costSaved > 0;
            Snackbar.Add(msg, anyOk ? Severity.Success : Severity.Warning);
            if (anyOk)
            {
                _priceModalOpen = false;
                var idx = _rows.FindIndex(r => r.ProductId == _modalProduct.ProductId);
                if (!_modalIsRequest && idx >= 0)
                {
                    if (ok && _isAdmin)
                    {
                        // حفظ السعر القديم للـ pulse
                        _prevPriceMap[_modalProduct.ProductId] = _rows[idx].PremiumPrice ?? _rows[idx].StdPrice ?? 0;
                        switch (_modalTier)
                        {
                            case "CClass": _rows[idx].StdPrice     = _modalNewPrice; break;
                            case "Elite":  _rows[idx].ElitePrice   = _modalNewPrice; break;
                            default:       _rows[idx].PremiumPrice = _modalNewPrice; break;
                        }
                    }
                    if (costSaved > 0)
                        foreach (var c in costChange.Where(c => c.HasValue))
                        {
                            var v = c!.Value.Val; var i = c.Value.Idx;
                            if (i == 0)      _rows[idx].StdCost     = v;
                            else if (i == 1) _rows[idx].PremiumCost = v;
                            else             _rows[idx].EliteCost   = v;
                        }
                }
                else if (_modalIsRequest && idx >= 0 && ok) _pendingRequests.Add(_modalProduct.ProductId);
                StateHasChanged();
            }
        }
        catch (Exception ex) { Logger.LogError(ex, "Save price failed"); Snackbar.Add("حدث خطأ: " + ex.Message, Severity.Error); }
        finally { _isSaving = false; StateHasChanged(); }
    }

    // ══ History ══
    private async Task OpenHistoryAsync(PriceListRowDto p)
    {
        if (!_isAdmin) return; // صلاحية السجل للأدمن فقط
        _historyProduct = p; _history = new();
        _historyLoading = true; _historyOpen = true; StateHasChanged();
        try   { _history = await PriceListService.GetHistoryAsync(p.ProductId); }
        catch (Exception ex) { Logger.LogWarning(ex, "History load failed"); }
        finally { _historyLoading = false; }
        StateHasChanged();
    }

    // ══ Gallery ══
    private async Task OpenGalleryAsync(PriceListRowDto p)
    {
        _galleryProduct = p; _galleryIds = new(); _galleryIndex = 0;
        _galleryLoading = true; _galleryOpen = true; StateHasChanged();
        try   { _galleryIds = await PriceListService.GetImageIdsAsync(p.ProductId); }
        catch (Exception ex) { Logger.LogWarning(ex, "Gallery load failed {Pid}", p.ProductId); }
        finally { _galleryLoading = false; }
        StateHasChanged();
    }
    private void CloseGallery() { _galleryOpen = false; StateHasChanged(); }
    private void GalleryNextAsync() { if (_galleryIds.Count == 0) return; _galleryIndex = (_galleryIndex + 1) % _galleryIds.Count; StateHasChanged(); }
    private void GalleryPrevAsync() { if (_galleryIds.Count == 0) return; _galleryIndex = (_galleryIndex - 1 + _galleryIds.Count) % _galleryIds.Count; StateHasChanged(); }

    // ══ Print & Export ══
    private async Task PrintAsync(string mode)
    {
        if (!_isAdmin) return;
        try
        {
            _printMode = mode; StateHasChanged(); await Task.Delay(350);
            try { await JS.InvokeVoidAsync("eval", "window.__plWaitImgs=()=>Promise.all([...document.querySelectorAll('.pl-print-sheet img')].map(im=>im.complete?1:new Promise(r=>{im.onload=r;im.onerror=r;}))); window.__plWaitImgs().then(()=>true)"); } catch { }
            await JS.InvokeVoidAsync("window.print");
        }
        catch (Exception ex) { Logger.LogError(ex, "Print failed"); }
        finally { _printMode = null; StateHasChanged(); }
    }

    private async Task ExportToExcel()
    {
        if (!_isAdmin) return;
        try
        {
            var html = new System.Text.StringBuilder();
            html.Append("<meta charset='utf-8'><table border='1' style='direction:rtl;font-family:Tahoma;border-collapse:collapse;'>");
            html.Append("<tr style='background:#0D1B30;color:#d4af37;font-weight:bold;'><th>الكود</th><th>الصنف</th><th>المجموعة</th><th>ستاندرد</th><th>بريميوم</th><th>إيليت</th><th>ت. ستاندرد</th><th>ت. بريميوم</th><th>ت. إيليت</th><th>المتاح</th></tr>");
            foreach (var p in _filtered)
            {
                var stock = _stockMap.TryGetValue(p.ProductId, out var sv) ? sv : 0;
                html.Append($"<tr><td>{p.ProductId}</td><td>{System.Net.WebUtility.HtmlEncode(p.ProductName)}</td><td>{System.Net.WebUtility.HtmlEncode(p.GroupName)}</td><td>{(p.StdPrice > 0 ? p.StdPrice.Value.ToString("N0") : "-")}</td><td>{(p.PremiumPrice > 0 ? p.PremiumPrice.Value.ToString("N0") : "-")}</td><td>{(p.ElitePrice > 0 ? p.ElitePrice.Value.ToString("N0") : "-")}</td><td>{(p.StdCost > 0 ? p.StdCost.Value.ToString("N0") : "-")}</td><td>{(p.PremiumCost > 0 ? p.PremiumCost.Value.ToString("N0") : "-")}</td><td>{(p.EliteCost > 0 ? p.EliteCost.Value.ToString("N0") : "-")}</td><td>{stock}</td></tr>");
            }
            html.Append("</table>");
            var b64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(html.ToString()));
            await JS.InvokeVoidAsync("eval", $"var a=document.createElement('a');a.href='data:application/vnd.ms-excel;base64,{b64}';a.download='قائمة-الاسعار.xls';a.click();");
        }
        catch (Exception ex) { Logger.LogError(ex, "Export failed"); Snackbar.Add("تعذّر التصدير: " + ex.Message, Severity.Error); }
    }

    private static string TierLabel(string tier) => tier switch
    {
        "CClass"  => "ستاندرد",
        "Premium" => "بريميوم",
        "Elite"   => "إيليت",
        _         => "كل الفئات"
    };
}