@page "/expenses/report"

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using COCOBOLOERPNEW.Helpers
@using System.Globalization
@using ApexCharts

@inject IExpenseService ExpenseService
@inject ICashBoxService CashBoxService
@inject IBranchService BranchService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthProvider

@implements IDisposable

<div class="exp-report-page" dir="rtl">

    <!-- ============ HERO HEADER ============ -->
    <div class="hero-header">
        <div class="hero-bg-pattern"></div>
        <div class="hero-content">
            <div class="hero-title-block">
                <div class="hero-icon-wrap">
                    <MudIcon Icon="@Icons.Material.Filled.Analytics" Size="MudBlazor.Size.Large" />
                </div>
                <div>
                    <h1>تقرير المصروفات</h1>
                    <p>تقرير تفصيلي أو إجمالي شهري مع فلترة ذكية وطباعة وتصدير</p>
                </div>
            </div>

            <div class="hero-actions">
                <button class="hero-btn hero-btn-glass" @onclick='@(() => Navigation.NavigateTo("/expenses/dashboard"))'>
                    <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="MudBlazor.Size.Small" />
                    <span>لوحة التحكم</span>
                </button>
                <button class="hero-btn hero-btn-glass" @onclick='@(() => Navigation.NavigateTo("/expenses"))'>
                    <MudIcon Icon="@Icons.Material.Filled.List" Size="MudBlazor.Size.Small" />
                    <span>إدارة المصروفات</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ============ KPI CARDS (ديناميك حسب الوضع) ============ -->
    <div class="kpi-grid">
        <div class="kpi-card kpi-blue">
            <div class="kpi-icon"><MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" /></div>
            <div class="kpi-body">
                <span class="kpi-label">إجمالي المصروفات</span>
                <span class="kpi-value">@N0(KpiTotal) <small>ج</small></span>
            </div>
        </div>

        <div class="kpi-card kpi-orange">
            <div class="kpi-icon"><MudIcon Icon="@Icons.Material.Filled.Receipt" /></div>
            <div class="kpi-body">
                <span class="kpi-label">عدد العمليات</span>
                <span class="kpi-value">@KpiCount</span>
            </div>
        </div>

        <div class="kpi-card kpi-green">
            <div class="kpi-icon"><MudIcon Icon="@Icons.Material.Filled.TrendingUp" /></div>
            <div class="kpi-body">
                <span class="kpi-label">@KpiAvgLabel</span>
                <span class="kpi-value">@N0(KpiAvg) <small>ج</small></span>
            </div>
        </div>

        <div class="kpi-card kpi-red">
            <div class="kpi-icon"><MudIcon Icon="@Icons.Material.Filled.ArrowUpward" /></div>
            <div class="kpi-body">
                <span class="kpi-label">@KpiMaxLabel</span>
                <span class="kpi-value">@N0(KpiMax) <small>ج</small></span>
            </div>
        </div>
    </div>

    <!-- ============ التحكم: تفصيلي / إجمالي شهري ============ -->
    <div class="filters-card filters-card--compact">

        <div class="mode-toolbar">
            <div class="mode-switch" role="tablist" aria-label="نوع التقرير">
                <button type="button" class="mode-btn @(_mode == ModeDetail ? "active" : "")"
                        @onclick='() => SetModeAsync(ModeDetail)'>
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="MudBlazor.Size.Small" />
                    <span>تقرير تفصيلي</span>
                </button>
                <button type="button" class="mode-btn @(_mode == ModeSummary ? "active" : "")"
                        @onclick='() => SetModeAsync(ModeSummary)'>
                    <MudIcon Icon="@Icons.Material.Filled.CalendarViewMonth" Size="MudBlazor.Size.Small" />
                    <span>تقرير إجمالي شهري</span>
                </button>
            </div>
            <div class="filters-toolbar-meta">
                <span class="filters-count">@GetActiveFiltersCount() فلتر نشط</span>
                <button type="button" class="filters-toggle" @onclick="ToggleFilters"
                        title='@(_filtersExpanded ? "إخفاء لوحة الفلاتر" : "عرض لوحة الفلاتر لتعديلها")'>
                    <MudIcon Icon="@Icons.Material.Filled.Tune" Size="MudBlazor.Size.Small" />
                    <span>@(_filtersExpanded ? "إخفاء الفلاتر" : "عرض الفلاتر")</span>
                </button>
            </div>
        </div>

        @if (ActiveFilterTags.Any())
        {
            <div class="active-filter-strip">
                @foreach (var chip in ActiveFilterTags)
                {
                    <span class="active-filter-chip">
                        @chip.Label
                        <button type="button" class="chip-x" @onclick='@(() => RemoveFilterAsync(chip.Key))'
                                title="إزالة الفلتر">
                            <MudIcon Icon="@Icons.Material.Filled.Close" Size="MudBlazor.Size.Small" />
                        </button>
                    </span>
                }
            </div>
        }

        @if (_filtersExpanded)
        {
            <!-- الفلاتر -->
            <div class="filters-sections">
            <!-- الفترة الزمنية -->
            <div class="fsection">
                <p class="fsection-title">
                    <MudIcon Icon="@Icons.Material.Filled.DateRange" Size="MudBlazor.Size.Small" />
                    الفترة الزمنية
                </p>
                <div class="filters-quick-row" style="margin-bottom:10px;">
                    <div class="quick-range-group">
                        <button class="quick-chip @(IsQuickRangeActive("today") ? "active" : "")" @onclick='() => ApplyQuickRangeAsync("today")'>اليوم</button>
                        <button class="quick-chip @(IsQuickRangeActive("month") ? "active" : "")" @onclick='() => ApplyQuickRangeAsync("month")'>هذا الشهر</button>
                        <button class="quick-chip @(IsQuickRangeActive("lastMonth") ? "active" : "")" @onclick='() => ApplyQuickRangeAsync("lastMonth")'>الشهر السابق</button>
                        <button class="quick-chip @(IsQuickRangeActive("year") ? "active" : "")" @onclick='() => ApplyQuickRangeAsync("year")'>هذه السنة</button>
                        <button class="quick-chip @(IsQuickRangeActive("all") ? "active" : "")" @onclick='() => ApplyQuickRangeAsync("all")'>كل الفترات</button>
                    </div>
                </div>
                <div class="fs-grid">
                    <MudDatePicker Date="@_dateFrom"
                                   DateChanged="@(OnDateFromChanged)"
                                   Label="من تاريخ" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" Dense="true" Clearable="true" Class="toolbar-control" />
                    <MudDatePicker Date="@_dateTo"
                                   DateChanged="@(OnDateToChanged)"
                                   Label="إلى تاريخ" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" Dense="true" Clearable="true" Class="toolbar-control" />
                </div>
            </div>

            <!-- التصنيف والفرع -->
            <div class="fsection">
                <p class="fsection-title">
                    <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="MudBlazor.Size.Small" />
                    البحث والتصنيف
                </p>
                <div class="fs-grid">
                    <div class="fs-cell--full">
                        <MudTextField T="string" Value="@_searchDisplay" ValueChanged="OnSearchChanged"
                                      Label="بحث نصي" Placeholder="اسم المصروف / المستلم / الملاحظات / المجموعة"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                      Clearable="true" Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Class="toolbar-control" />
                    </div>
                    <MudSelect T="int?" Value="@_filter.BranchId" ValueChanged="@(OnBranchChanged)"
                               Label="الفرع" Variant="Variant.Outlined" Margin="Margin.Dense"
                               Dense="true" Clearable="true" Class="toolbar-control">
                        @foreach (var branch in _branches)
                        {
                            <MudSelectItem T="int?" Value="@((int?)branch.BranchId)">@branch.BranchNameAr</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="int?" Value="@_filter.CashBoxId" ValueChanged="@(OnCashBoxChanged)"
                               Label="الخزينة" Variant="Variant.Outlined" Margin="Margin.Dense"
                               Dense="true" Clearable="true" Class="toolbar-control">
                        @foreach (var box in GetFilterCashBoxes())
                        {
                            <MudSelectItem T="int?" Value="@((int?)box.CashBoxId)">@box.CashBoxName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="int?" Value="@_filter.ParentGroupId" ValueChanged="@(OnParentGroupChanged)"
                               Label="المجموعة الرئيسية" Variant="Variant.Outlined" Margin="Margin.Dense"
                               Dense="true" Clearable="true" Class="toolbar-control">
                        @foreach (var g in _mainGroups)
                        {
                            <MudSelectItem T="int?" Value="@((int?)g.ExpenseGroupId)">@g.ExpenseGroupName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudAutocomplete T="ExpenseGroupDto"
                                     Value="@_selectedType"
                                     ValueChanged="@(OnTypeSelected)"
                                     SearchFunc="@SearchTypeGroups"
                                     ToStringFunc="@(TypeGroupLabel)"
                                     Label="نوع المصروف (ابحث واختر)"
                                     Placeholder="اكتب لتبحث في أنواع المصروفات..."
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Dense="true" Clearable="true" ResetValueOnEmptyText="true"
                                     MinCharacters="0"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                     Class="toolbar-control">
                        <ItemTemplate>
                            <div class="type-option">
                                <MudIcon Icon="@Icons.Material.Filled.Folder" Size="MudBlazor.Size.Small" />
                                <span>@TypeGroupLabel(context)</span>
                            </div>
                        </ItemTemplate>
                    </MudAutocomplete>
                </div>
                <p class="fsection-hint">النوع يعمل مستقلًا عن المجموعة الرئيسية</p>
            </div>
        </div>
        }

        <div class="fs-actions">
            <button class="btn btn-ghost" @onclick="ClearFilters">
                <MudIcon Icon="@Icons.Material.Filled.Clear" Size="MudBlazor.Size.Small" />
                <span>تفريغ الفلاتر</span>
            </button>
            <button class="btn btn-purple" disabled="@(!HasResults)" @onclick="PrintReport">
                <MudIcon Icon="@Icons.Material.Filled.Print" Size="MudBlazor.Size.Small" />
                <span>PDF</span>
            </button>
            <button class="btn btn-success" disabled="@(!HasResults)" @onclick="ExportExcel">
                <MudIcon Icon="@Icons.Material.Filled.TableView" Size="MudBlazor.Size.Small" />
                <span>Excel</span>
            </button>
        </div>
    </div>

    <!-- ============ RESULTS ============ -->
    @if (_mode == ModeSummary)
    {
        <div class="table-card">
            <div class="card-header">
                <div class="card-title">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarViewMonth" />
                    <h3>ملخص المصروفات الشهري</h3>
                </div>
                @if (_summary is { Months.Count: > 0 })
                {
                    <span class="results-count">@_summary.Months.Count شهر • @_summary.TotalCount عملية</span>
                }
            </div>

            @if (_isLoading)
            {
                <div class="skeleton-wrap">
                    @for (int i = 0; i < 5; i++)
                    {
                        <div class="skeleton-row"></div>
                    }
                </div>
            }
            else if (_summary is null || !_summary.Months.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="MudBlazor.Size.Large" />
                    </div>
                    <h4>لا توجد بيانات</h4>
                    <p>لا توجد مصروفات مطابقة للفلاتر الحالية لتجميعها شهريًا.</p>
                </div>
            }
            else
            {
                <div class="summary-chart">
                    <ApexChart TItem="ExpenseMonthlySummaryDto" Height="320" Options="_summaryChartOptions">
                        <ApexPointSeries TItem="ExpenseMonthlySummaryDto"
                                         Items="_summary.Months"
                                         SeriesType="SeriesType.Bar"
                                         Name="@(ChartTxt("المصروفات"))"
                                         XValue="e => ChartTxt(e.MonthShort)"
                                         YValue="e => e.Total" />
                    </ApexChart>
                </div>

                <div class="table-responsive">
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>الشهر</th>
                                <th>عدد العمليات</th>
                                <th class="text-left">الإجمالي</th>
                                <th class="text-left">التغير عن السابق</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in _summary.Months)
                            {
                                <tr>
                                    <td>
                                        <div class="month-cell">
                                            <strong>@m.MonthLabel</strong>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge badge-group">@m.Count عملية</span>
                                    </td>
                                    <td class="text-left amount">
                                        @m.Total.ToString("N2", CultureInfo.InvariantCulture) <small>ج</small>
                                    </td>
                                    <td class="text-left">
                                        @if (m.HasPrevious)
                                        {
                                            <span class="@GetChangeClass(m.ChangePercent)">
                                                @GetChangeText(m.ChangePercent)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="flat">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="2" class="text-left foot-label sum-foot-label">إجمالي الفترة</td>
                                <td class="text-left foot-total">@N2(_summary.GrandTotal) <small>ج</small></td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                    <span class="sum-avg-note">
                        <MudIcon Icon="@Icons.Material.Filled.Functions" Size="MudBlazor.Size.Small" />
                        متوسط المصروف الشهري خلال الفترة: @N2(_summary.MonthlyAverage) ج
                    </span>
                </div>
            }
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="card-header">
                <div class="card-title">
                    <MudIcon Icon="@Icons.Material.Filled.TableChart" />
                    <h3>نتائج التقرير التفصيلي</h3>
                </div>
                @if (_expenses.Any())
                {
                    <span class="results-count">@_expenses.Count سجل</span>
                }
            </div>

            @if (_isLoading)
            {
                <div class="skeleton-wrap">
                    @for (int i = 0; i < 5; i++)
                    {
                        <div class="skeleton-row"></div>
                    }
                </div>
            }
            else if (!_expenses.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="MudBlazor.Size.Large" />
                    </div>
                    <h4>لا توجد نتائج</h4>
                    <p>لم نعثر على أي مصروفات مطابقة للفلاتر المحددة. جرّب تعديل الفلاتر أو إعادة تعيينها.</p>
                    <button class="btn btn-ghost" @onclick="ClearFilters">
                        <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="MudBlazor.Size.Small" />
                        <span>إعادة تعيين الفلاتر</span>
                    </button>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>التاريخ</th>
                                <th>الفرع</th>
                                <th>المصروف</th>
                                <th>المجموعة</th>
                                <th>الخزينة</th>
                                <th>المستلم</th>
                                <th class="text-left">المبلغ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var exp in _expenses)
                            {
                                <tr>
                                    <td>
                                        <div class="date-cell">
                                            <span class="date-day">@exp.ExpenseDate.ToString("dd")</span>
                                            <span class="date-rest">@exp.ExpenseDate.ToString("MM/yyyy")</span>
                                        </div>
                                    </td>
                                    <td><span class="badge badge-group">@(exp.BranchName ?? "غير محدد")</span></td>
                                    <td>
                                        <div class="name-cell">
                                            <strong>@exp.ExpenseName</strong>
                                            @if (exp.IsAdvance)
                                            {
                                                <span class="badge badge-advance">مقدم</span>
                                            }
                                        </div>
                                    </td>
                                    <td><span class="badge badge-group">@(string.IsNullOrWhiteSpace(exp.FullGroupPath) ? exp.ExpenseGroupName : exp.FullGroupPath)</span></td>
                                    <td>@exp.CashBoxName</td>
                                    <td>@exp.Recipient</td>
                                    <td class="text-left amount">
                                        @exp.Amount.ToString("N2", CultureInfo.InvariantCulture)
                                        <small>ج</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="6" class="text-left foot-label">
                                    <MudIcon Icon="@Icons.Material.Filled.Functions" Size="MudBlazor.Size.Small" />
                                    إجمالي المصروفات
                                </td>
                                <td class="text-left foot-total">
                                    @_totalAmount.ToString("N2", CultureInfo.InvariantCulture) <small>ج</small>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    }
</div>

<style>
    /* ============ PAGE WRAPPER ============ */
    .exp-report-page {
        max-width: 1400px;
        margin: auto;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        font-family: 'Cairo', 'Tajawal', sans-serif;
    }

    /* ============ HERO HEADER ============ */
    .hero-header {
        position: relative;
        background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 50%, #9333EA 100%);
        border-radius: 20px;
        padding: 2rem 2.5rem;
        color: white;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(79, 70, 229, 0.3);
    }

    .hero-bg-pattern {
        position: absolute;
        inset: 0;
        background-image: 
            radial-gradient(circle at 20% 20%, rgba(255,255,255,0.1) 0%, transparent 50%),
            radial-gradient(circle at 80% 80%, rgba(255,255,255,0.08) 0%, transparent 50%);
        pointer-events: none;
    }

    .hero-content {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1.5rem;
        z-index: 1;
    }

    .hero-title-block {
        display: flex;
        align-items: center;
        gap: 1.25rem;
    }

    .hero-icon-wrap {
        width: 60px; height: 60px;
        background: rgba(255,255,255,0.18);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.25);
        border-radius: 16px;
        display: grid; place-items: center;
        color: white;
    }

    .hero-title-block h1 {
        margin: 0; font-size: 1.75rem; font-weight: 800; color: white;
    }
    .hero-title-block p {
        margin: .25rem 0 0; opacity: .9; font-size: .95rem;
    }

    .hero-actions { display: flex; gap: .75rem; flex-wrap: wrap; }
    .hero-btn {
        display: inline-flex; align-items: center; gap: .5rem;
        padding: .65rem 1.25rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: .9rem;
        cursor: pointer;
        transition: all .2s ease;
        border: 1px solid rgba(255,255,255,0.25);
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        color: white;
    }
    .hero-btn:hover { background: rgba(255,255,255,0.25); transform: translateY(-2px); }

    /* ============ KPI CARDS ============ */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
    }
    .kpi-card {
        background: white;
        border-radius: 16px;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        border: 1px solid #f1f5f9;
        position: relative;
        overflow: hidden;
        transition: all .3s ease;
    }
    .kpi-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,0.08); }
    .kpi-card::before {
        content: ''; position: absolute; top: 0; right: 0; left: 0; height: 4px;
    }
    .kpi-blue::before   { background: linear-gradient(90deg, #3b82f6, #60a5fa); }
    .kpi-orange::before { background: linear-gradient(90deg, #f97316, #fb923c); }
    .kpi-green::before  { background: linear-gradient(90deg, #10b981, #34d399); }
    .kpi-red::before    { background: linear-gradient(90deg, #ef4444, #f87171); }

    .kpi-icon {
        width: 52px; height: 52px;
        border-radius: 14px;
        display: grid; place-items: center;
        flex-shrink: 0;
    }
    .kpi-blue   .kpi-icon { background: #dbeafe; color: #2563eb; }
    .kpi-orange .kpi-icon { background: #ffedd5; color: #ea580c; }
    .kpi-green  .kpi-icon { background: #d1fae5; color: #059669; }
    .kpi-red    .kpi-icon { background: #fee2e2; color: #dc2626; }

    .kpi-body { display: flex; flex-direction: column; gap: .25rem; }
    .kpi-label { font-size: .85rem; color: #64748b; font-weight: 500; }
    .kpi-value { font-size: 1.5rem; font-weight: 800; color: #0f172a; }
    .kpi-value small { font-size: .85rem; font-weight: 600; color: #64748b; margin-right: .25rem; }

    /* ============ CARDS ============ */
    .filters-card, .table-card {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        border: 1px solid #f1f5f9;
    }

    .filters-card--compact {
        padding: 1rem 1.25rem 1.15rem;
        background: linear-gradient(180deg, rgba(255,255,255,.96) 0%, rgba(250,251,255,.98) 100%);
        box-shadow: 0 10px 30px rgba(79, 70, 229, 0.06);
    }

    .card-header {
        display: flex; justify-content: space-between; align-items: center;
        margin-bottom: 1.25rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #f1f5f9;
    }
    .card-title { display: flex; align-items: center; gap: .6rem; color: #4F46E5; }
    .card-title h3 { margin: 0; font-size: 1.1rem; font-weight: 700; color: #0f172a; }

    .filters-toolbar-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: .9rem;
        padding-bottom: .85rem;
        border-bottom: 1px solid #eef2ff;
        flex-wrap: wrap;
    }

    .filters-toolbar-title {
        display: flex;
        align-items: center;
        gap: .8rem;
