@code {
    // ═══════════════════════════════════════════════════════════════════
    // MODE
    private const string ModeDetail = "detail";
    private const string ModeSummary = "summary";
    private string _mode = ModeDetail;

    // لوحة الفلاتر مطوية افتراضيًا (المساحة للنتائج) — تُفتح بضغطة "عرض الفلاتر"
    private bool _filtersExpanded = false;
    private void ToggleFilters() => _filtersExpanded = !_filtersExpanded;

    // ═══════════════════════════════════════════════════════════════════
    // STATE
    private bool _isLoading = true;
    private bool _disposed = false;

    // ⛔ بوابة تسلسل: تمنع تنفيذ تحميلين متزامنين على نفس الـ DbContext
    //    (لو حصل استدعاء LoadData أثناء تحميل جارٍ — من مؤقت بحث أو حدث — ينتظر دوره)
    private readonly SemaphoreSlim _loadGate = new(1, 1);

    private ExpenseFilterDto _filter = new() { ExcludeAdvanceHeaders = true };
    private DateTime? _dateFrom;
    private DateTime? _dateTo;
    private string _searchDisplay = "";

    private List<ExpenseListDto> _expenses = new();
    private decimal _totalAmount = 0;
    private decimal _avgAmount = 0;
    private decimal _maxAmount = 0;

    private ExpenseSummaryReportDto? _summary;
    private ApexChartOptions<ExpenseMonthlySummaryDto> _summaryChartOptions = new();

    private List<ExpenseGroupDto> _allGroups = new();
    private List<ExpenseGroupDto> _mainGroups = new();
    private List<BranchListDto> _branches = new();
    private List<CashBoxListDto> _boxes = new();

    // الكائن المختار في حقل "نوع المصروف" (Autocomplete)
    private ExpenseGroupDto? _selectedType;

    private readonly CultureInfo _ar = new("ar-EG");
    private System.Timers.Timer? _searchTimer;

    // ═══════════════════════════════════════════════════════════════════
    // LIFECYCLE
    protected override async Task OnInitializedAsync()
    {
        // ⛔ فحص الصلاحية: تقرير المصروفات (تفصيلي/إجمالي/تصدير) يتطلب صلاحية عرض القائمة
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        var canView = user.HasClaim("Permission", "frm_ExpensesList:View") || user.IsInRole("Admin");
        if (!canView)
        {
            Navigation.NavigateTo("/");
            return;
        }

        _allGroups = await ExpenseService.GetExpenseGroupsAsync();
        _mainGroups = _allGroups
            .Where(g => g.ParentGroupId == null)
            .OrderBy(g => g.ExpenseGroupName)
            .ToList();

        _branches = (await BranchService.GetBranchesAsync()).Where(b => b.IsActive).ToList();
        _boxes = await CashBoxService.GetCashBoxesAsync();

        // الافتتاح الافتراضي: الشهر الحالي
        var today = DateTime.Today;
        _dateFrom = new DateTime(today.Year, today.Month, 1);
        _dateTo = _dateFrom.Value.AddMonths(1).AddDays(-1);
        _filter.DateFrom = _dateFrom;
        _filter.DateTo = _dateTo;

        InitChartOptions();
        await LoadData();
    }

    public void Dispose()
    {
        _disposed = true;
        _searchTimer?.Stop();
        _searchTimer?.Dispose();
        _searchTimer = null;
    }

    // ═══════════════════════════════════════════════════════════════════
    // KPI (ديناميك حسب الوضع)
    private decimal KpiTotal => _mode == ModeSummary ? (_summary?.GrandTotal ?? 0) : _totalAmount;
    private int KpiCount => _mode == ModeSummary ? (_summary?.TotalCount ?? 0) : _expenses.Count;
    private string KpiAvgLabel => _mode == ModeSummary ? "متوسط الشهر" : "متوسط المصروف";
    private decimal KpiAvg => _mode == ModeSummary ? (_summary?.MonthlyAverage ?? 0) : _avgAmount;
    private string KpiMaxLabel => _mode == ModeSummary ? "أعلى شهر" : "أعلى مصروف";
    private decimal KpiMax
    {
        get
        {
            if (_mode == ModeSummary)
                return _summary is { Months.Count: > 0 } ? _summary.Months.Max(m => m.Total) : 0;
            return _maxAmount;
        }
    }

    private bool HasResults => _mode == ModeSummary
        ? (_summary is { Months.Count: > 0 })
        : _expenses.Any();

    // ═══════════════════════════════════════════════════════════════════
    // MODE
    private async Task SetModeAsync(string mode)
    {
        if (_mode == mode) return;
        _mode = mode;
        await LoadData();
    }

    // ═══════════════════════════════════════════════════════════════════
    // DATA
    private async Task LoadData()
    {
        if (_disposed) return;

        await _loadGate.WaitAsync();
        try
        {
            if (_disposed) return;
            await LoadDataCoreAsync();
        }
        finally
        {
            _loadGate.Release();
        }
    }

    // 🛡️ التنفيذ الفعلي مع إعادة محاولة تلقائية عند تعارض DbContext المؤقت
    private async Task LoadDataCoreAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            // في تطبيق Blazor التفاعلي الـ DbContext Scoped مشترك على مستوى الـ circuit كله،
            // فلو كان فيه استعلام قديم لسه شغال (من صفحة/تنقل سابق) بيحصل خطأ
            // "A second operation was started..." → إعادة المحاولة بعد لحظات بتنضف التعارض.
            for (int attempt = 0; ; attempt++)
            {
                try
                {
                    await LoadDataOnceAsync();
                    break;
                }
                catch (InvalidOperationException ex) when (
                    attempt < 2 &&
                    ex.Message.Contains("second operation", StringComparison.OrdinalIgnoreCase))
                {
                    if (_disposed) return;
                    await Task.Delay(250 * (attempt + 1));
                }
            }
        }
        finally
        {
            _isLoading = false;
            if (!_disposed)
                StateHasChanged();
        }
    }

    private async Task LoadDataOnceAsync()
    {
        if (_filter.BranchId.HasValue && _filter.CashBoxId.HasValue)
        {
            var selectedBox = _boxes.FirstOrDefault(b => b.CashBoxId == _filter.CashBoxId.Value);
            if (selectedBox?.BranchId != _filter.BranchId.Value)
                _filter.CashBoxId = null;
        }

        if (_mode == ModeSummary)
        {
            var f = CopyFilter();
            _summary = await ExpenseService.GetMonthlySummaryAsync(f);
            _expenses = new();
            _totalAmount = _avgAmount = _maxAmount = 0;
        }
        else
        {
            var f = CopyFilter();
            f.PageNumber = 1;
            f.PageSize = 5000;
            var result = await ExpenseService.GetExpensesAsync(f);

            _expenses = result.Items.ToList();
            _totalAmount = _expenses.Sum(e => e.Amount);
            _avgAmount = _expenses.Any() ? _expenses.Average(e => e.Amount) : 0;
            _maxAmount = _expenses.Any() ? _expenses.Max(e => e.Amount) : 0;
            _summary = null;
        }
    }

    private ExpenseFilterDto CopyFilter() => new()
    {
        SearchText = string.IsNullOrWhiteSpace(_filter.SearchText) ? null : _filter.SearchText,
        BranchId = _filter.BranchId,
        ParentGroupId = _filter.ParentGroupId,
        ExpenseGroupId = _filter.ExpenseGroupId,
        CashBoxId = _filter.CashBoxId,
        DateFrom = _filter.DateFrom,
        DateTo = _filter.DateTo,
        AmountFrom = _filter.AmountFrom,
        AmountTo = _filter.AmountTo,
        IsAdvance = _filter.IsAdvance,
        OnlyParents = _filter.OnlyParents,
        ExcludeAdvanceHeaders = _filter.ExcludeAdvanceHeaders,
        PageNumber = _filter.PageNumber,
        PageSize = _filter.PageSize,
        SortBy = _filter.SortBy,
        SortDescending = _filter.SortDescending
    };

    // ═══════════════════════════════════════════════════════════════════
    // FILTERS
    private void OnSearchChanged(string? value)
    {
        var v = value ?? "";
        _searchDisplay = v;
        _filter.SearchText = string.IsNullOrWhiteSpace(v) ? null : v.Trim();

        _searchTimer?.Stop();
        _searchTimer?.Dispose();
        _searchTimer = new System.Timers.Timer(400);
        _searchTimer.Elapsed += async (_, _) =>
        {
            _searchTimer?.Stop();
            await InvokeAsync(async () =>
            {
                if (_disposed) return;
                await LoadData();
            });
        };
        _searchTimer.AutoReset = false;
        _searchTimer.Start();
    }

    private async Task OnDateFromChanged(DateTime? d)
    {
        _dateFrom = d;
        _filter.DateFrom = d;
        await LoadData();
    }

    private async Task OnDateToChanged(DateTime? d)
    {
        _dateTo = d;
        _filter.DateTo = d;
        await LoadData();
    }

    private async Task OnBranchChanged(int? v)
    {
        _filter.BranchId = v;
        await LoadData();
    }

    private async Task OnCashBoxChanged(int? v)
    {
        _filter.CashBoxId = v;
        await LoadData();
    }

    private async Task OnParentGroupChanged(int? v)
    {
        _filter.ParentGroupId = v;

        // لو كان فيه نوع مختار ومبقاش جوه المجموعة الجديدة → امسحه (حتى ما يبقاش في فلاتر متناقضة)
        if (v.HasValue && _filter.ExpenseGroupId.HasValue
            && !IsGroupInSubtree(_filter.ExpenseGroupId.Value, v.Value))
        {
            _filter.ExpenseGroupId = null;
            _selectedType = null;
        }

        await LoadData();
    }

    private async Task OnTypeSelected(ExpenseGroupDto? group)
    {
        _selectedType = group;
        _filter.ExpenseGroupId = group?.ExpenseGroupId;
        await LoadData();
    }

    // ═══════════════════════════════════════════════════════════════════
    // النوع (Autocomplete): تقييده حسب المجموعة المختارة + بحث فوري
    // ═══════════════════════════════════════════════════════════════════
    private List<ExpenseGroupDto> GetTypeGroupOptions()
    {
        if (!_filter.ParentGroupId.HasValue)
            return _allGroups;

        var rootId = _filter.ParentGroupId.Value;
        return _allGroups.Where(g => IsGroupInSubtree(g.ExpenseGroupId, rootId)).ToList();
    }

    private Task<IEnumerable<ExpenseGroupDto>> SearchTypeGroups(string? value, CancellationToken token)
    {
        var source = GetTypeGroupOptions();
        var q = value?.Trim() ?? "";

        IEnumerable<ExpenseGroupDto> res = source;
        if (q.Length > 0)
        {
            res = source.Where(g =>
                TypeGroupLabel(g).Contains(q, StringComparison.OrdinalIgnoreCase)
                || g.ExpenseGroupName.Contains(q, StringComparison.OrdinalIgnoreCase));
        }

        var ordered = res
            .OrderBy(g => TypeGroupLabel(g))
            .Take(80)
            .ToList();

        return Task.FromResult<IEnumerable<ExpenseGroupDto>>(ordered);
    }

    private bool IsGroupInSubtree(int groupId, int rootId)
    {
        var current = _allGroups.FirstOrDefault(g => g.ExpenseGroupId == groupId);
        int safety = 15;
        while (current != null && safety-- > 0)
        {
            if (current.ExpenseGroupId == rootId) return true;
            if (!current.ParentGroupId.HasValue) return false;
            current = _allGroups.FirstOrDefault(g => g.ExpenseGroupId == current.ParentGroupId.Value);
        }
        return false;
    }

    // تسمية النوع: لو في مجموعة رئيسية مختارة → مسار نسبي من عندها؛ غير كده المسار الكامل
    // (MudAutocomplete بيستدعي ToStringFunc بقيمة null أثناء التهيئة → لازم حماية)
    private string TypeGroupLabel(ExpenseGroupDto group)
    {
        if (group is null)
            return string.Empty;

        if (_filter.ParentGroupId.HasValue)
        {
            var path = new List<string> { group.ExpenseGroupName };
            int? pid = group.ParentGroupId;
            int safety = 10;
            while (pid.HasValue && pid.Value != _filter.ParentGroupId.Value && safety-- > 0)
            {
                var p = _allGroups.FirstOrDefault(g => g.ExpenseGroupId == pid.Value);
                if (p == null) break;
                path.Insert(0, p.ExpenseGroupName);
                pid = p.ParentGroupId;
            }
            return string.Join(" / ", path);
        }

        return GetGroupOptionLabel(group);
    }

    private async Task ClearFilters()
    {
        _searchTimer?.Stop();
        _searchDisplay = "";
        _filter = new ExpenseFilterDto { ExcludeAdvanceHeaders = true, PageSize = 5000 };
        _dateFrom = null;
        _dateTo = null;
        _selectedType = null;
        await LoadData();
    }

    // ═══════════════════════════════════════════════════════════════════
    // ACTIVE FILTER CHIPS
    private sealed record FilterTag(string Key, string Label);

    private List<FilterTag> ActiveFilterTags
    {
        get
        {
            var tags = new List<FilterTag>();

            if (!string.IsNullOrWhiteSpace(_searchDisplay))
                tags.Add(new("search", $"بحث: {_searchDisplay}"));

            if (_dateFrom.HasValue || _dateTo.HasValue)
            {
                var fromText = _dateFrom?.ToString("yyyy/MM/dd") ?? "البداية";
                var toText = _dateTo?.ToString("yyyy/MM/dd") ?? "النهاية";
                tags.Add(new("period", $"الفترة: {fromText} ← {toText}"));
            }

            if (_filter.BranchId.HasValue)
            {
                var branch = _branches.FirstOrDefault(b => b.BranchId == _filter.BranchId.Value);
                if (branch != null) tags.Add(new("branch", $"الفرع: {branch.BranchNameAr}"));
            }

            if (_filter.ParentGroupId.HasValue)
            {
                var parent = _mainGroups.FirstOrDefault(g => g.ExpenseGroupId == _filter.ParentGroupId.Value);
                if (parent != null) tags.Add(new("parentgroup", $"المجموعة: {parent.ExpenseGroupName}"));
            }

            if (_filter.ExpenseGroupId.HasValue)
            {
                var group = _allGroups.FirstOrDefault(g => g.ExpenseGroupId == _filter.ExpenseGroupId.Value);
                if (group != null) tags.Add(new("type", $"النوع: {TypeGroupLabel(group)}"));
            }

            if (_filter.CashBoxId.HasValue)
            {
                var box = _boxes.FirstOrDefault(b => b.CashBoxId == _filter.CashBoxId.Value);
                if (box != null) tags.Add(new("cashbox", $"الخزينة: {box.CashBoxName}"));
            }

            return tags;
        }
    }

    private int GetActiveFiltersCount()
    {
        int count = 0;
        if (!string.IsNullOrWhiteSpace(_searchDisplay)) count++;
        if (_dateFrom.HasValue || _dateTo.HasValue) count++;
        if (_filter.BranchId.HasValue) count++;
        if (_filter.ParentGroupId.HasValue) count++;
        if (_filter.ExpenseGroupId.HasValue) count++;
        if (_filter.CashBoxId.HasValue) count++;
        return count;
    }

    private async Task RemoveFilterAsync(string key)
    {
        switch (key)
        {
            case "search":
                _searchDisplay = "";
                _filter.SearchText = null;
                break;
            case "period":
                _dateFrom = null;
                _dateTo = null;
                _filter.DateFrom = null;
                _filter.DateTo = null;
                break;
            case "branch":
                _filter.BranchId = null;
                break;
            case "parentgroup":
                _filter.ParentGroupId = null;
                break;
            case "type":
                _filter.ExpenseGroupId = null;
                _selectedType = null;
                break;
            case "cashbox":
                _filter.CashBoxId = null;
                break;
        }

        await LoadData();
    }

    // ═══════════════════════════════════════════════════════════════════
    // QUICK RANGES
    private async Task ApplyQuickRangeAsync(string preset)
    {
        var (from, to) = GetQuickRange(preset);
        _dateFrom = from;
        _dateTo = to;
        _filter.DateFrom = from;
        _filter.DateTo = to;
        await LoadData();
    }

    private bool IsQuickRangeActive(string preset)
    {
        var (from, to) = GetQuickRange(preset);
        return _dateFrom == from && _dateTo == to;
    }

    private static (DateTime? From, DateTime? To) GetQuickRange(string preset)
    {
        var today = DateTime.Today;
        return preset switch
        {
            "today" => (today, today),
            "month" => (new DateTime(today.Year, today.Month, 1), new DateTime(today.Year, today.Month, 1).AddMonths(1).AddDays(-1)),
            "lastMonth" => (new DateTime(today.Year, today.Month, 1).AddMonths(-1), new DateTime(today.Year, today.Month, 1).AddDays(-1)),
            "year" => (new DateTime(today.Year, 1, 1), new DateTime(today.Year, 12, 31)),
            "all" => (null, null),
            _ => (null, null)
        };
    }

    // ═══════════════════════════════════════════════════════════════════
    // HELPERS
    private List<CashBoxListDto> GetFilterCashBoxes()
    {
        return _boxes
            .Where(b => !_filter.BranchId.HasValue || b.BranchId == _filter.BranchId.Value)
            .OrderBy(b => b.BranchName)
            .ThenBy(b => b.CashBoxName)
            .ToList();
    }

    private string GetGroupOptionLabel(ExpenseGroupDto group)
    {
        if (group is null)
            return string.Empty;

        if (string.IsNullOrWhiteSpace(group.ParentGroupName))
            return group.ExpenseGroupName;

        return $"{group.ParentGroupName} / {group.ExpenseGroupName}";
    }

    private string N0(decimal v) => v.ToString("N0", CultureInfo.InvariantCulture);
    private string N2(decimal v) => v.ToString("N2", CultureInfo.InvariantCulture);
    private static string ChartTxt(string? value) => ChartTextHelper.Safe(value);

    private static string GetChangeText(decimal change)
    {
        var abs = Math.Abs(change);
        if (change > 0) return $"↑ {abs:N1}%";
        if (change < 0) return $"↓ {abs:N1}%";
        return "بدون تغيير";
    }

    private static string GetChangeClass(decimal change)
    {
        if (change > 0) return "neg";
        if (change < 0) return "pos";
        return "flat";
    }

    // ═══════════════════════════════════════════════════════════════════
    // PRINT & EXPORT
    private string BuildReportUrl()
    {
        var q = new List<string> { $"Mode={_mode}" };
        if (!string.IsNullOrWhiteSpace(_searchDisplay))
            q.Add($"SearchText={Uri.EscapeDataString(_searchDisplay.Trim())}");
        if (_dateFrom.HasValue) q.Add($"DateFrom={_dateFrom.Value:yyyy-MM-dd}");
        if (_dateTo.HasValue) q.Add($"DateTo={_dateTo.Value:yyyy-MM-dd}");
        if (_filter.BranchId.HasValue) q.Add($"BranchId={_filter.BranchId.Value}");
        if (_filter.ParentGroupId.HasValue) q.Add($"ParentGroupId={_filter.ParentGroupId.Value}");
        if (_filter.ExpenseGroupId.HasValue) q.Add($"GroupId={_filter.ExpenseGroupId.Value}");
        if (_filter.CashBoxId.HasValue) q.Add($"BoxId={_filter.CashBoxId.Value}");

        return "/expenses/print" + (q.Any() ? "?" + string.Join("&", q) : "");
    }

    private async Task PrintReport()
    {
        var url = BuildReportUrl();
        await JS.InvokeVoidAsync("window.open", url, "_blank");
    }

    private async Task ExportExcel()
    {
        byte[] fileBytes;
        string fileName;

        if (_mode == ModeSummary)
        {
            fileBytes = await ExpenseService.ExportMonthlySummaryToExcelAsync(CopyFilter());
            fileName = "ExpenseMonthlySummary.xlsx";
        }
        else
        {
            fileBytes = await ExpenseService.ExportExpensesToExcelAsync(CopyFilter());
            fileName = "ExpenseReport.xlsx";
        }

        var base64 = Convert.ToBase64String(fileBytes);
        await JS.InvokeVoidAsync("downloadFileFromBase64", base64, fileName);
    }

