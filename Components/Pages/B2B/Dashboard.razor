@page "/b2b"
@page "/b2b/dashboard"
@layout COCOBOLOERPNEW.Components.Layout.B2BLayout

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthProvider
@inject IB2BPortalService PortalService
@inject NavigationManager Navigation

<PageTitle>الرئيسية - بوابة B2B</PageTitle>

@if (_isLoading)
{
    <div class="b2b-loading">
        <div class="loading-shell">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <div class="loading-text">
                <strong>جاري تحميل لوحة التحكم</strong>
                <span>يرجى الانتظار لحظات...</span>
            </div>
        </div>
    </div>
}
else if (_dashboard != null)
{
    <div class="b2b-dashboard" dir="rtl">

        <!-- ══════════════ HERO ══════════════ -->
        <section class="hero-panel">
            <div class="hero-glow g1"></div>
            <div class="hero-glow g2"></div>

            <div class="hero-body">
                <div class="hero-avatar">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                </div>

                <div class="hero-text">
                    <div class="hero-chip">
                        <span class="chip-dot"></span>
                        بوابة العملاء B2B
                    </div>
                    <h1>مرحبًا، @_dashboard.PortalUserName</h1>
                    <p>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21l1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/></svg>
                        @_dashboard.PartyName
                    </p>
                </div>
            </div>

            <div class="hero-metrics-row">
                <div class="h-metric">
                    <strong>@_dashboard.OpenQuotationsCount</strong>
                    <span>عروض مفتوحة</span>
                </div>
                <div class="h-metric-sep"></div>
                <div class="h-metric">
                    <strong>@_dashboard.OpenInvoicesCount</strong>
                    <span>فواتير</span>
                </div>
                <div class="h-metric-sep"></div>
                <div class="h-metric">
                    <strong>@_dashboard.PendingDeliveriesCount</strong>
                    <span>تسليمات</span>
                </div>
                <div class="h-metric-sep"></div>
                <div class="h-metric">
                    <strong>@FormatMoney(_dashboard.OutstandingAmount)</strong>
                    <span>المستحق</span>
                </div>
            </div>
        </section>

        <!-- ══════════════ KPIs ══════════════ -->
        <section class="kpi-strip">
            <div class="kpi-card kpi-blue">
                <div class="kpi-icon-wrap">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14,2 14,8 20,8"/></svg>
                </div>
                <div class="kpi-info">
                    <span>عروض أسعار مفتوحة</span>
                    <strong>@_dashboard.OpenQuotationsCount</strong>
                </div>
            </div>

            <div class="kpi-card kpi-amber">
                <div class="kpi-icon-wrap">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                </div>
                <div class="kpi-info">
                    <span>فواتير مفتوحة</span>
                    <strong>@_dashboard.OpenInvoicesCount</strong>
                </div>
            </div>

            <div class="kpi-card kpi-green">
                <div class="kpi-icon-wrap">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16,8 20,8 23,11 23,16 16,16 16,8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                </div>
                <div class="kpi-info">
                    <span>تسليمات قيد المتابعة</span>
                    <strong>@_dashboard.PendingDeliveriesCount</strong>
                </div>
            </div>

            <div class="kpi-card kpi-red">
                <div class="kpi-icon-wrap">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <div class="kpi-info">
                    <span>إجمالي المستحق</span>
                    <strong>@FormatMoney(_dashboard.OutstandingAmount)</strong>
                </div>
            </div>
        </section>

        <!-- ══════════════ QUICK ACTIONS ══════════════ -->
        <section class="quick-actions">
            <div class="qa-card" @onclick='() => Navigation.NavigateTo("/b2b/requests")'>
                <div class="qa-icon blue">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                </div>
                <div class="qa-text">
                    <strong>إنشاء طلب جديد</strong>
                    <small>عرض سعر، إعادة طلب، دعم</small>
                </div>
                <div class="qa-arrow">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15,18 9,12 15,6"/></svg>
                </div>
            </div>

            <div class="qa-card" @onclick='() => Navigation.NavigateTo("/b2b/requests")'>
                <div class="qa-icon amber">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
                </div>
                <div class="qa-text">
                    <strong>متابعة الطلبات</strong>
                    <small>راجع حالة طلباتك السابقة</small>
                </div>
                <div class="qa-arrow">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15,18 9,12 15,6"/></svg>
                </div>
            </div>

            <div class="qa-card" @onclick='() => Navigation.NavigateTo("/b2b/requests")'>
                <div class="qa-icon green">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                </div>
                <div class="qa-text">
                    <strong>إثبات دفع</strong>
                    <small>أرسل بيانات التحويل أو الدفع</small>
                </div>
                <div class="qa-arrow">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15,18 9,12 15,6"/></svg>
                </div>
            </div>
        </section>

        <!-- ══════════════ RECENT REQUESTS ══════════════ -->
        <section class="recent-surface">
            <div class="recent-header">
                <div class="recent-header-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
                </div>
                <div>
                    <h3>آخر الطلبات</h3>
                    <p>أحدث الطلبات المقدمة من حسابك.</p>
                </div>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           EndIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick='() => Navigation.NavigateTo("/b2b/requests")'>
                    عرض الكل
                </MudButton>
            </div>

            @if (_dashboard.RecentRequests.Any())
            {
                <div class="recent-cards-grid">
                    @foreach (var req in _dashboard.RecentRequests)
                    {
                        <div class='recent-card @GetStatusClass(req.Status)' @onclick='() => Navigation.NavigateTo($"/b2b/requests/{req.RequestId}")'>
                            <div class="recent-card-top">
                                <div class="recent-card-id">
                                    <span class="recent-hash">#@req.RequestId</span>
                                    <span class="recent-type">@GetRequestTypeText(req.RequestType)</span>
                                </div>
                                <span class='status-pill @GetStatusClass(req.Status)'>@GetRequestStatusText(req.Status)</span>
                            </div>

                            <div class="recent-progress">
                                <div class='recent-progress-fill @GetStatusClass(req.Status)' style="width:@(GetProgressPercent(req.Status))%"></div>
                            </div>

                            <div class="recent-card-meta">
                                <div class="meta-chip">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                    @req.CreatedAt.ToString("yyyy/MM/dd")
                                </div>
                                @if (!string.IsNullOrWhiteSpace(req.ResponsibleEmployeeName))
                                {
                                    <div class="meta-chip">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                        @req.ResponsibleEmployeeName
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(req.Notes))
                            {
                                <div class="recent-card-note">
                                    @(req.Notes.Length > 70 ? req.Notes[..70] + "..." : req.Notes)
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-state-visual">📭</div>
                    <strong>لا توجد طلبات بعد</strong>
                    <p>أنشئ طلبك الأول من زر "إنشاء طلب جديد" بالأعلى.</p>
                </div>
            }
        </section>
    </div>
}

<style>
    :root {
        --surface: #ffffff;
        --border: #e4eaf3;
        --text: #0f172a;
        --muted: #64748b;
        --primary: #2563eb;
        --primary-light: #dbeafe;
        --r-xl: 28px;
        --r-lg: 22px;
        --r-md: 16px;
        --sh-sm: 0 4px 14px rgba(15,23,42,.04);
        --sh-md: 0 12px 30px rgba(15,23,42,.06);
        --sh-lg: 0 20px 50px rgba(15,23,42,.10);
    }

    /* ── Loading ── */
    .b2b-loading { min-height: 55vh; display: flex; align-items: center; justify-content: center; }
    .loading-shell {
        display: flex; align-items: center; gap: 1rem;
        background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--r-xl); padding: 1.4rem 1.6rem; box-shadow: var(--sh-lg);
    }
    .loading-text { display: flex; flex-direction: column; gap: .12rem; }
    .loading-text strong { color: var(--text); font-size: .95rem; }
    .loading-text span { color: var(--muted); font-size: .82rem; }

    /* ── Page ── */
    .b2b-dashboard { display: flex; flex-direction: column; gap: 1rem; padding: .15rem; }

    /* ══ HERO ══ */
    .hero-panel {
        position: relative; overflow: hidden;
        border-radius: var(--r-xl); padding: 1rem 1.2rem;
        color: #fff;
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #2563eb 100%);
        display: flex; align-items: center; justify-content: space-between;
        gap: 1rem; flex-wrap: wrap;
        box-shadow: 0 16px 42px rgba(15,23,42,.20);
    }

    .hero-glow { position: absolute; border-radius: 50%; filter: blur(70px); opacity: .3; pointer-events: none; }
    .hero-glow.g1 { width: 180px; height: 180px; top: -50px; right: -25px; background: radial-gradient(circle, #60a5fa, transparent); }
    .hero-glow.g2 { width: 140px; height: 140px; bottom: -40px; left: -15px; background: radial-gradient(circle, #34d399, transparent); }

    .hero-body { position: relative; z-index: 1; display: flex; align-items: center; gap: .85rem; flex-wrap: wrap; flex: 1; }

    .hero-avatar {
        width: 50px; height: 50px; border-radius: var(--r-md);
        background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.16);
        display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #dbeafe;
    }

    .hero-text { flex: 1; min-width: 200px; }

    .hero-chip {
        display: inline-flex; align-items: center; gap: .4rem;
        padding: .28rem .7rem; border-radius: 999px;
        background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.14);
        font-size: .7rem; font-weight: 800; margin-bottom: .35rem;
    }

    .chip-dot { width: 7px; height: 7px; border-radius: 50%; background: #34d399; animation: pulse-dot 2s infinite; }
    @@keyframes pulse-dot { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: .4; transform: scale(1.5); } }

    .hero-text h1 { margin: 0; font-size: 1.3rem; font-weight: 900; line-height: 1.2; }
    .hero-text p {
        margin: .3rem 0 0; color: #bfdbfe; font-size: .84rem; line-height: 1.6;
        display: flex; align-items: center; gap: .35rem;
    }

    .hero-metrics-row {
        position: relative; z-index: 1;
        display: flex; align-items: center;
        background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.12);
        border-radius: var(--r-lg); backdrop-filter: blur(8px); overflow: hidden;
    }
    .h-metric { flex: 1; display: flex; flex-direction: column; align-items: center; padding: .6rem .5rem; min-width: 70px; }
    .h-metric strong { font-size: 1.25rem; font-weight: 900; line-height: 1; }
    .h-metric span { margin-top: .18rem; color: #bfdbfe; font-size: .7rem; font-weight: 700; }
    .h-metric-sep { width: 1px; height: 32px; background: rgba(255,255,255,.14); flex-shrink: 0; }

    /* ══ KPIs ══ */
    .kpi-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: .85rem; }

    .kpi-card {
        display: flex; align-items: center; gap: .8rem;
        background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--r-lg); padding: .9rem 1rem;
        box-shadow: var(--sh-sm); transition: .22s ease;
    }
    .kpi-card:hover { transform: translateY(-3px); box-shadow: var(--sh-md); }

    .kpi-icon-wrap {
        width: 46px; height: 46px; border-radius: 14px;
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }

    .kpi-blue .kpi-icon-wrap { background: #dbeafe; color: #2563eb; }
    .kpi-amber .kpi-icon-wrap { background: #fef3c7; color: #d97706; }
    .kpi-green .kpi-icon-wrap { background: #d1fae5; color: #059669; }
    .kpi-red .kpi-icon-wrap { background: #fee2e2; color: #dc2626; }

    .kpi-info { display: flex; flex-direction: column; }
    .kpi-info span { color: var(--muted); font-size: .82rem; margin-bottom: .15rem; }
    .kpi-info strong { color: var(--text); font-size: 1.35rem; line-height: 1; }

    /* ══ QUICK ACTIONS ══ */
    .quick-actions { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: .85rem; }

    .qa-card {
        display: flex; align-items: center; gap: .75rem;
        background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--r-lg); padding: .85rem 1rem;
        box-shadow: var(--sh-sm); cursor: pointer;
        transition: .22s ease;
    }
    .qa-card:hover { transform: translateY(-2px); box-shadow: var(--sh-md); border-color: #c7d3e0; }

    .qa-icon {
        width: 42px; height: 42px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .qa-icon.blue { background: #dbeafe; color: #2563eb; }
    .qa-icon.amber { background: #fef3c7; color: #d97706; }
    .qa-icon.green { background: #d1fae5; color: #059669; }

    .qa-text { flex: 1; }
    .qa-text strong { display: block; color: var(--text); font-size: .9rem; margin-bottom: .12rem; }
    .qa-text small { color: var(--muted); font-size: .78rem; }

    .qa-arrow { color: var(--muted); flex-shrink: 0; opacity: .5; transition: .2s; }
    .qa-card:hover .qa-arrow { opacity: 1; transform: translateX(-4px); }

    /* ══ RECENT ══ */
    .recent-surface {
        background: rgba(255,255,255,.96); border: 1px solid var(--border);
        border-radius: var(--r-xl); padding: 1.2rem; box-shadow: var(--sh-md);
    }

    .recent-header {
        display: flex; align-items: center; gap: .8rem;
        margin-bottom: .9rem; flex-wrap: wrap;
    }

    .recent-header-icon {
        width: 42px; height: 42px; border-radius: 14px;
        background: #f1f5f9; color: var(--muted);
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }

    .recent-header h3 { margin: 0; color: var(--text); font-size: 1.1rem; font-weight: 900; }
    .recent-header p { margin: .2rem 0 0; color: var(--muted); font-size: .84rem; }
    .recent-header > .mud-button-root { margin-right: auto; margin-left: 0; }

    /* ── Recent cards ── */
    .recent-cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: .85rem; }

    .recent-card {
        background: var(--surface); border: 1px solid var(--border);
        border-top: 4px solid #94a3b8;
        border-radius: var(--r-xl); padding: .9rem;
        display: flex; flex-direction: column; gap: .6rem;
        box-shadow: var(--sh-sm); cursor: pointer; transition: .25s ease;
    }
    .recent-card:hover { transform: translateY(-3px); box-shadow: var(--sh-lg); }

    .recent-card.new { border-top-color: #3b82f6; }
    .recent-card.review { border-top-color: #f59e0b; }
    .recent-card.converted { border-top-color: #10b981; }
    .recent-card.closed { border-top-color: #94a3b8; }
    .recent-card.rejected { border-top-color: #ef4444; }

    .recent-card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: .7rem; }
    .recent-card-id { display: flex; flex-direction: column; gap: .12rem; }
    .recent-hash { font-weight: 900; color: var(--text); font-size: .95rem; }
    .recent-type { color: var(--muted); font-size: .78rem; }

    .status-pill {
        display: inline-flex; padding: .25rem .6rem; border-radius: 999px;
        font-size: .68rem; font-weight: 900; white-space: nowrap;
    }
    .status-pill.new { background: #dbeafe; color: #1d4ed8; }
    .status-pill.review { background: #fef3c7; color: #b45309; }
    .status-pill.converted { background: #d1fae5; color: #047857; }
    .status-pill.closed { background: #e2e8f0; color: #475569; }
    .status-pill.rejected { background: #fee2e2; color: #b91c1c; }

    .recent-progress { height: 3px; border-radius: 999px; background: #edf2f7; overflow: hidden; }
    .recent-progress-fill { height: 100%; border-radius: 999px; transition: width .4s ease; }
    .recent-progress-fill.new { background: #3b82f6; }
    .recent-progress-fill.review { background: #f59e0b; }
    .recent-progress-fill.converted { background: #10b981; }
    .recent-progress-fill.closed { background: #94a3b8; }
    .recent-progress-fill.rejected { background: #ef4444; }

    .recent-card-meta { display: flex; gap: .45rem; flex-wrap: wrap; }
    .meta-chip {
        display: inline-flex; align-items: center; gap: .3rem;
        padding: .35rem .55rem; border-radius: 10px;
        background: #f8fafc; border: 1px solid #edf2f7;
        color: var(--muted); font-size: .74rem;
    }

    .recent-card-note {
        padding: .55rem .65rem; border-radius: 12px;
        background: #f8fafc; border: 1px solid #edf2f7;
        color: #334155; font-size: .78rem; line-height: 1.7;
    }

    /* ── Empty ── */
    .empty-state {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: .5rem; padding: 2rem 1rem; text-align: center;
        border-radius: var(--r-xl); background: linear-gradient(180deg, #fbfdff, #f8fafc);
        border: 1.5px dashed #d8e2ec;
    }
    .empty-state-visual { font-size: 1.8rem; margin-bottom: .2rem; }
    .empty-state strong { color: var(--text); font-size: .95rem; }
    .empty-state p { margin: 0; color: var(--muted); font-size: .85rem; }

    /* ── Responsive ── */
    @@media (max-width: 960px) {
        .hero-panel { padding: .9rem 1rem; }
        .hero-text h1 { font-size: 1.15rem; }
    }

    @@media (max-width: 700px) {
        .hero-panel, .recent-surface { border-radius: var(--r-lg); padding: .9rem; }
        .hero-body { flex-direction: column; align-items: flex-start; }
        .hero-metrics-row { width: 100%; }
        .recent-header { flex-direction: column; align-items: flex-start; }
        .recent-header > .mud-button-root { margin-right: 0; }
    }
</style>

@code {
    private bool _isLoading = true;
    private B2BPortalDashboardDto? _dashboard;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        if (!B2BPermissions.IsPortalUser(user))
        {
            Navigation.NavigateTo("/b2b/login", forceLoad: true);
            return;
        }

        var partyId = B2BPermissions.GetPartyId(user);
        var portalUserId = B2BPermissions.GetPortalUserId(user);
        if (!partyId.HasValue || !portalUserId.HasValue)
        {
            Navigation.NavigateTo("/b2b/login", forceLoad: true);
            return;
        }

        _dashboard = await PortalService.GetDashboardAsync(partyId.Value, portalUserId.Value);
        _isLoading = false;
    }

    private static string FormatMoney(decimal value) => value.ToString("N0") + " ج.م";

    private static int GetProgressPercent(string status) => status switch
    {
        B2BRequestStatuses.New => 20,
        B2BRequestStatuses.UnderReview => 50,
        B2BRequestStatuses.Converted => 100,
        B2BRequestStatuses.Closed => 100,
        B2BRequestStatuses.Rejected => 100,
        _ => 10
    };

