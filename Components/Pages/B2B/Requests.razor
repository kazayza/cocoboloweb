    .req-card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:.7rem}
    .req-card-id{display:flex;flex-direction:column;gap:.15rem}
    .req-hash{font-weight:900;color:var(--text);font-size:1rem}
