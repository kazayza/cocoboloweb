    .filter-chip b{min-width:20px;height:20px;padding:0 .3rem;border-radius:999px;display:inline-flex;align-items:center;justify-content:center;background:#f1f5f9;color:var(--text);font-size:.68rem;font-weight:900}
    .filter-chip.active b{background:rgba(255,255,255,.15);color:#fff}

    .requests-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:.9rem}
    .req-card{
