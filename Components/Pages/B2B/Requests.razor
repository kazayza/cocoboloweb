@page "/b2b/requests"
@layout COCOBOLOERPNEW.Components.Layout.B2BLayout

@using COCOBOLOERPNEW.DTOs
@using COCOBOLOERPNEW.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthProvider
@inject IB2BRequestService RequestService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>طلباتي - بوابة B2B</PageTitle>

@if (_isLoading)
{
    <div class="b2b-loading">
        <div class="loading-shell">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <div class="loading-text">
                <strong>جاري تحميل الطلبات</strong>
                <span>يرجى الانتظار لحظات...</span>
            </div>
        </div>
    </div>
}
else
{
    var filteredRequests = FilteredRequests.ToList();
    var activeCount = _requests.Count(x => x.Status == B2BRequestStatuses.New || x.Status == B2BRequestStatuses.UnderReview);

    <div class="b2b-requests-page" dir="rtl">

        <!-- ══════════════ HERO ══════════════ -->
        <section class="hero-panel">
            <div class="hero-glow g1"></div>
            <div class="hero-glow g2"></div>

            <div class="hero-body">
                <div class="hero-icon-wrap">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14,2 14,8 20,8"/>
                        <line x1="16" y1="13" x2="8" y2="13"/>
                        <line x1="16" y1="17" x2="8" y2="17"/>
                        <polyline points="10,9 9,9 8,9"/>
                    </svg>
                </div>

                <div class="hero-text">
                    <div class="hero-chip">
                        <span class="chip-dot"></span>
                        بوابة العملاء B2B
                    </div>
                    <h1>إدارة الطلبات</h1>
                    <p>أنشئ طلباتك الجديدة وتابع حالتها لحظة بلحظة مع الموظف المسئول.</p>
                </div>
            </div>

            <div class="hero-metrics-row">
                <div class="h-metric">
                    <strong>@_requests.Count</strong>
                    <span>إجمالي</span>
                </div>
                <div class="h-metric-sep"></div>
                <div class="h-metric">
                    <strong>@activeCount</strong>
                    <span>نشطة</span>
                </div>
                <div class="h-metric-sep"></div>
                <div class="h-metric">
                    <strong>@_requests.Count(x => x.Status == B2BRequestStatuses.Converted)</strong>
                    <span>محوّلة</span>
                </div>
                <div class="h-metric-sep"></div>
                <div class="h-metric">
                    <strong>@_requests.Count(x => x.Status == B2BRequestStatuses.Closed || x.Status == B2BRequestStatuses.Rejected)</strong>
                    <span>مغلق/مرفوض</span>
                </div>
            </div>
        </section>

        <!-- ══════════════ KPIs ══════════════ -->
        <section class="kpi-strip">
            <div class="kpi-card">
                <div class="kpi-dot new-dot"></div>
                <div class="kpi-info"><span>جديد</span><strong>@_requests.Count(x => x.Status == B2BRequestStatuses.New)</strong></div>
            </div>
            <div class="kpi-card">
                <div class="kpi-dot review-dot"></div>
                <div class="kpi-info"><span>تحت المراجعة</span><strong>@_requests.Count(x => x.Status == B2BRequestStatuses.UnderReview)</strong></div>
            </div>
            <div class="kpi-card">
                <div class="kpi-dot converted-dot"></div>
                <div class="kpi-info"><span>تم التحويل</span><strong>@_requests.Count(x => x.Status == B2BRequestStatuses.Converted)</strong></div>
            </div>
            <div class="kpi-card">
                <div class="kpi-dot closed-dot"></div>
                <div class="kpi-info"><span>مغلق / مرفوض</span><strong>@_requests.Count(x => x.Status == B2BRequestStatuses.Closed || x.Status == B2BRequestStatuses.Rejected)</strong></div>
            </div>
        </section>

        <!-- ══════════════ CREATE REQUEST ══════════════ -->
        <section class="create-surface" id="create-request">
            <div class="surface-glow"></div>

            <div class="create-header">
                <div class="create-header-icon">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                </div>
                <div>
                    <h3>إنشاء طلب جديد</h3>
                    <p>حدد نوع الطلب، اكتب التفاصيل، ثم أرسله لفريقنا.</p>
                </div>
            </div>

            <!-- Wizard -->
            <div class="wizard-steps">
                <div class="wizard-step active">
                    <div class="wizard-step-num">1</div>
                    <div class="wizard-step-text"><strong>نوع الطلب</strong><small>اختر التصنيف</small></div>
                </div>
                <div class="wizard-connector"></div>
                <div class="wizard-step active">
                    <div class="wizard-step-num">2</div>
                    <div class="wizard-step-text"><strong>التفاصيل</strong><small>ملاحظات وبنود</small></div>
                </div>
                <div class="wizard-connector"></div>
                <div class="wizard-step active">
                    <div class="wizard-step-num">3</div>
                    <div class="wizard-step-text"><strong>الإرسال</strong><small>راجع وأرسل</small></div>
                </div>
            </div>

            <!-- Type tiles -->
            <div class="type-selection-grid">
                @foreach (var type in _requestTypes)
                {
                    var isActive = _createModel.RequestType == type.Key;
                    <button type="button"
                            class='type-tile @(isActive ? "active" : "")'
                            @onclick='() => SelectRequestType(type.Key)'>
                        <div class="tile-glow"></div>
                        <div class="tile-check">
                            @if (isActive)
                            {
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20,6 9,17 4,12"/></svg>
                            }
                        </div>
                        <div class="tile-icon">@type.Icon</div>
                        <strong>@type.Title</strong>
                        <small>@type.Description</small>
                    </button>
                }
            </div>

            <!-- Form -->
            <div class="form-panel">
                <div class="form-panel-label">
                    <span class="form-label-icon">📝</span>
                    <div>
                        <strong>تفاصيل الطلب — @GetRequestTypeText(_createModel.RequestType)</strong>
                        <small>وضح احتياجك بشكل مفصل ليتمكن فريقنا من خدمتك بأسرع وقت.</small>
                    </div>
                </div>

                <MudTextField T="string"
                              Label="ملخص الطلب / ملاحظات عامة"
                              @bind-Value="_createModel.Notes"
                              Lines="5"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Placeholder="مثال: أحتاج عرض سعر لـ 500 قطعة من المنتج X مع التوصيل..." />
            </div>

            <!-- Items -->
            @if (SupportsItems(_createModel.RequestType))
            {
                <div class="items-zone">
                    <div class="items-zone-head">
                        <div class="items-zone-title">
                            <span class="zone-icon">📦</span>
                            <div>
                                <strong>بنود الطلب</strong>
                                <p>عدد البنود الحالية: <b>@_createModel.Items.Count</b></p>
                            </div>
                        </div>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add" Class="add-item-btn"
                                   OnClick="AddItemLine">إضافة بند</MudButton>
                    </div>

                    @if (!_createModel.Items.Any())
                    {
                        <div class="empty-items-card">
                            <div class="empty-items-visual">
                                <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                            </div>
                            <strong>لا توجد بنود مضافة بعد</strong>
                            <p>اضغط "إضافة بند" لتحديد المنتجات والكميات.</p>
                        </div>
                    }
                    else
                    {
                        <div class="items-list">
                            @for (var i = 0; i < _createModel.Items.Count; i++)
                            {
                                var idx = i;
                                <div class="item-row">
                                    <div class="item-row-badge">@(idx + 1)</div>
                                    <MudGrid>
                                        <MudItem xs="12" md="5">
                                            <MudAutocomplete T="B2BProductLookupDto"
                                                             Value="_createModel.Items[idx].SelectedProduct"
                                                             ValueChanged="@(p => OnProductChanged(idx, p))"
                                                             SearchFunc="SearchProductsAsync"
                                                             ToStringFunc="@(p => p?.DisplayName ?? string.Empty)"
                                                             Label="ابحث عن المنتج"
                                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                                             Clearable="true" ResetValueOnEmptyText="true" CoerceText="false"
                                                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search">
                                                <ItemTemplate Context="product">
                                                    <div class="product-dropdown-item">
                                                        <strong>@product.ProductName</strong>
                                                        @if (!string.IsNullOrWhiteSpace(product.ProductDescription))
                                                        { <small>@product.ProductDescription</small> }
                                                    </div>
                                                </ItemTemplate>
                                            </MudAutocomplete>
                                        </MudItem>
                                        <MudItem xs="12" md="2">
                                            <MudNumericField T="decimal" @bind-Value="_createModel.Items[idx].Quantity"
                                                             Label="الكمية" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="12" md="4">
                                            <MudTextField T="string" @bind-Value="_createModel.Items[idx].Notes"
                                                          Label="ملاحظات البند" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="12" md="1" Class="d-flex align-center justify-center">
                                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                           Color="Color.Error" Class="delete-item-btn"
                                                           OnClick='() => RemoveItemLine(idx)' />
                                        </MudItem>
                                    </MudGrid>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <!-- Submit bar -->
            <div class="submit-bar">
                <div class="submit-bar-summary">
                    <div class="summary-icon">
                        @(_requestTypes.FirstOrDefault(x => x.Key == _createModel.RequestType)?.Icon ?? "📄")
                    </div>
                    <div class="summary-text">
                        <strong>@GetRequestTypeText(_createModel.RequestType)</strong>
                        <span>
                            @if (SupportsItems(_createModel.RequestType))
                            { <text>@_createModel.Items.Count بند</text> }
                            else
                            { <text>طلب نصّي</text> }
                            @if (!string.IsNullOrWhiteSpace(_createModel.Notes))
                            { <text> · يحتوي ملاحظات</text> }
                        </span>
                    </div>
                </div>
                <div class="submit-bar-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium"
                               StartIcon="@Icons.Material.Filled.Send" Class="submit-btn"
                               OnClick="CreateRequestAsync">إرسال الطلب</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Medium"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetForm">مسح</MudButton>
                </div>
            </div>
        </section>

        <!-- ══════════════ HISTORY ══════════════ -->
        <section class="history-surface" id="requests-history">
            <div class="history-header">
                <div class="history-header-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
                </div>
                <div>
                    <h3>سجل الطلبات</h3>
                    <p>تابع وراجع كل طلباتك السابقة وحالاتها.</p>
                </div>
                <div class="history-badge">
                    <strong>@filteredRequests.Count</strong>
                    <span>من @_requests.Count</span>
                </div>
            </div>

            <div class="history-toolbar">
                <div class="toolbar-search">
                    <MudTextField T="string" @bind-Value="_historySearch"
                                  Placeholder="ابحث برقم الطلب أو النوع أو الملاحظات..."
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Clearable="true" Immediate="true" />
                </div>
                <div class="toolbar-filters">
                    @foreach (var f in _historyFilters)
                    {
                        <button type="button"
                                class='filter-chip @(_historyStatus == f.Key ? "active" : "")'
                                @onclick='() => SetHistoryFilter(f.Key)'>
                            @f.Title <b>@GetHistoryFilterCount(f.Key)</b>
                        </button>
                    }
                </div>
            </div>

            @if (filteredRequests.Any())
            {
                <div class="requests-grid">
                    @foreach (var req in filteredRequests)
                    {
                        <div class='req-card @GetStatusClass(req.Status)' @key="req.RequestId">
                            <div class="req-card-top">
                                <div class="req-card-id">
                                    <span class="req-hash">#@req.RequestId</span>
                                    <span class="req-type-label">@GetRequestTypeText(req.RequestType)</span>
                                </div>
                                <span class='req-status @GetStatusClass(req.Status)'>@GetRequestStatusText(req.Status)</span>
                            </div>
                            <div class="req-progress"><div class='req-progress-fill @GetStatusClass(req.Status)' style="width:@(GetProgressPercent(req.Status))%"></div></div>
                            <div class="req-card-meta">
                                <div class="meta-item">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                    <span>@req.CreatedAt.ToString("yyyy/MM/dd")</span>
                                </div>
                                <div class="meta-item">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                    <span>@(req.ResponsibleEmployeeName ?? "لم يحدد بعد")</span>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(req.Notes))
                            {
                                <div class="req-card-note">@(req.Notes.Length > 90 ? req.Notes[..90] + "..." : req.Notes)</div>
                            }
                            <div class="req-card-action">
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                           EndIcon="@Icons.Material.Filled.ArrowBack"
                                           OnClick='() => Navigation.NavigateTo($"/b2b/requests/{req.RequestId}")'>
                                    عرض التفاصيل
                                </MudButton>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (_requests.Any())
            {
                <div class="empty-state">
                    <div class="empty-state-visual">🔍</div>
                    <strong>لا توجد نتائج مطابقة</strong>
                    <p>جرّب تغيير كلمات البحث أو اختيار فلتر آخر.</p>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-state-visual">📭</div>
                    <strong>لا توجد طلبات سابقة</strong>
                    <p>أنشئ طلبك الأول من القسم العلوي وسيظهر هنا.</p>
                </div>
            }
        </section>
    </div>
}

<style>
    :root {
        --surface:#ffffff;
        --border:#e4eaf3;
        --text:#0f172a;
        --muted:#64748b;
        --primary:#2563eb;
        --primary-light:#dbeafe;
        --r-xl:28px;
        --r-lg:22px;
        --r-md:16px;
        --sh-sm:0 4px 14px rgba(15,23,42,.04);
        --sh-md:0 12px 30px rgba(15,23,42,.06);
        --sh-lg:0 20px 50px rgba(15,23,42,.10);
    }

    .b2b-loading{min-height:55vh;display:flex;align-items:center;justify-content:center}
    .loading-shell{display:flex;align-items:center;gap:1rem;background:var(--surface);border:1px solid var(--border);border-radius:var(--r-xl);padding:1.4rem 1.6rem;box-shadow:var(--sh-lg)}
    .loading-text{display:flex;flex-direction:column;gap:.12rem}
    .loading-text strong{color:var(--text);font-size:.95rem}
    .loading-text span{color:var(--muted);font-size:.82rem}

    .b2b-requests-page{display:flex;flex-direction:column;gap:1rem;padding:.15rem}

    /* ══ HERO ══ */
    .hero-panel{
        position:relative;overflow:hidden;
        border-radius:var(--r-xl);padding:1rem 1.2rem;
        color:#fff;
        background:linear-gradient(135deg,#0f172a 0%,#1e3a8a 50%,#2563eb 100%);
        display:flex;align-items:center;justify-content:space-between;
        gap:1rem;flex-wrap:wrap;
        box-shadow:0 16px 42px rgba(15,23,42,.20);
    }

    .hero-glow{position:absolute;border-radius:50%;filter:blur(70px);opacity:.3;pointer-events:none}
    .hero-glow.g1{width:180px;height:180px;top:-50px;right:-25px;background:radial-gradient(circle,#60a5fa,transparent)}
    .hero-glow.g2{width:140px;height:140px;bottom:-40px;left:-15px;background:radial-gradient(circle,#34d399,transparent)}

    .hero-body{position:relative;z-index:1;display:flex;align-items:center;gap:.85rem;flex-wrap:wrap;flex:1}

    .hero-icon-wrap{
        width:50px;height:50px;border-radius:var(--r-md);
        background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.16);
        display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#dbeafe;
    }

    .hero-text{flex:1;min-width:200px}

    .hero-chip{
        display:inline-flex;align-items:center;gap:.4rem;
        padding:.28rem .7rem;border-radius:999px;
        background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.14);
        font-size:.7rem;font-weight:800;margin-bottom:.35rem;
    }

    .chip-dot{width:7px;height:7px;border-radius:50%;background:#34d399;animation:pulse-dot 2s infinite}
    @@keyframes pulse-dot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(1.5)}}

    .hero-text h1{margin:0;font-size:1.3rem;font-weight:900;line-height:1.2}
    .hero-text p{margin:.25rem 0 0;color:#bfdbfe;font-size:.84rem;line-height:1.6}

    .hero-metrics-row{
        position:relative;z-index:1;
        display:flex;align-items:center;
        background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);
        border-radius:var(--r-lg);backdrop-filter:blur(8px);overflow:hidden;
    }
    .h-metric{flex:1;display:flex;flex-direction:column;align-items:center;padding:.6rem .5rem;min-width:70px}
    .h-metric strong{font-size:1.3rem;font-weight:900;line-height:1}
    .h-metric span{margin-top:.18rem;color:#bfdbfe;font-size:.7rem;font-weight:700}
    .h-metric-sep{width:1px;height:32px;background:rgba(255,255,255,.14);flex-shrink:0}

    /* ══ KPIs ══ */
    .kpi-strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(185px,1fr));gap:.8rem}
    .kpi-card{
        display:flex;align-items:center;gap:.75rem;
        background:var(--surface);border:1px solid var(--border);
        border-radius:var(--r-lg);padding:.85rem .95rem;
        box-shadow:var(--sh-sm);transition:.22s ease;
    }
    .kpi-card:hover{transform:translateY(-3px);box-shadow:var(--sh-md)}
    .kpi-dot{width:11px;height:11px;border-radius:50%;flex-shrink:0;box-shadow:0 0 0 3px rgba(0,0,0,.04)}
    .new-dot{background:#3b82f6}.review-dot{background:#f59e0b}.converted-dot{background:#10b981}.closed-dot{background:#94a3b8}
    .kpi-info{display:flex;flex-direction:column}
    .kpi-info span{color:var(--muted);font-size:.82rem;margin-bottom:.12rem}
    .kpi-info strong{color:var(--text);font-size:1.35rem;line-height:1}

    /* ══ CREATE ══ */
    .create-surface{
        position:relative;overflow:hidden;
        background:rgba(255,255,255,.96);border:1px solid var(--border);
        border-radius:var(--r-xl);padding:1.2rem;
        box-shadow:var(--sh-md);backdrop-filter:blur(6px);
    }
    .surface-glow{
        position:absolute;top:-50px;right:-50px;width:160px;height:160px;
        border-radius:50%;background:radial-gradient(circle,rgba(37,99,235,.07),transparent);pointer-events:none;
    }
    .create-header{display:flex;align-items:flex-start;gap:.8rem;margin-bottom:.9rem;position:relative;z-index:1}
    .create-header-icon{
        width:46px;height:46px;border-radius:var(--r-md);
        background:var(--primary-light);color:var(--primary);
        display:flex;align-items:center;justify-content:center;flex-shrink:0;
    }
    .create-header h3{margin:0;color:var(--text);font-size:1.12rem;font-weight:900}
    .create-header p{margin:.25rem 0 0;color:var(--muted);font-size:.86rem}

    .wizard-steps{
        display:flex;align-items:center;gap:.6rem;
        padding:.75rem .9rem;border:1px solid #edf2f7;
        border-radius:var(--r-lg);background:linear-gradient(180deg,#fbfdff,#f8fafc);
        margin-bottom:.9rem;overflow-x:auto;
    }
    .wizard-step{display:flex;align-items:center;gap:.5rem;white-space:nowrap}
    .wizard-step-num{
        width:26px;height:26px;border-radius:50%;
        background:var(--primary-light);color:var(--primary);
        display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:900;flex-shrink:0;
    }
    .wizard-step-text strong{display:block;color:var(--text);font-size:.8rem}
    .wizard-step-text small{color:var(--muted);font-size:.7rem}
    .wizard-connector{width:32px;height:2px;background:#dbe2ea;border-radius:999px;flex-shrink:0}

