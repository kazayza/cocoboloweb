</style>

@code {
    private bool _isLoading = true;
    private List<B2BRequestListDto> _requests = new();
    private B2BCreateRequestDto _createModel = new()
    {
        RequestType = B2BRequestTypes.Quotation,
        Items = new List<B2BRequestItemInputDto> { new() { Quantity = 1 } }
    };

    private int? _portalUserId;
    private int? _partyId;
    private int? _responsibleEmployeeId;
    private string _currentUserName = "portal";
    private string _historySearch = string.Empty;
    private string _historyStatus = "All";

    private readonly List<RequestTypeCardVm> _requestTypes =
    [
        new(B2BRequestTypes.Quotation, "🧾", "طلب عرض سعر", "اطلب عرض سعر لمنتجات أو خدمات جديدة."),
        new(B2BRequestTypes.Reorder, "🔁", "إعادة طلب", "أعد طلب فاتورة أو منتجات سابقة بسهولة."),
        new(B2BRequestTypes.PaymentProof, "💳", "إثبات دفع", "أرسل تفاصيل تحويل أو دفعة لمراجعتها."),
        new(B2BRequestTypes.Support, "🎧", "دعم / استفسار", "استفسار عام أو طلب مساعدة.")
    ];

    private readonly List<HistoryFilterVm> _historyFilters =
    [
        new("All", "الكل"),
        new(B2BRequestStatuses.New, "جديد"),
        new(B2BRequestStatuses.UnderReview, "قيد المراجعة"),
        new(B2BRequestStatuses.Converted, "محوّل"),
        new(B2BRequestStatuses.Closed, "مغلق"),
        new(B2BRequestStatuses.Rejected, "مرفوض")
    ];

    private IEnumerable<B2BRequestListDto> FilteredRequests =>
        _requests.Where(r =>
        {
            if (_historyStatus != "All" && r.Status != _historyStatus) return false;
            if (string.IsNullOrWhiteSpace(_historySearch)) return true;
            var t = _historySearch.Trim();
            return r.RequestId.ToString().Contains(t, StringComparison.OrdinalIgnoreCase)
                || GetRequestTypeText(r.RequestType).Contains(t, StringComparison.OrdinalIgnoreCase)
                || (r.Notes?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false)
                || (r.ResponsibleEmployeeName?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false);
        });

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        if (!B2BPermissions.IsPortalUser(user))
        {
            Navigation.NavigateTo("/b2b/login", forceLoad: true);
            return;
        }

        _portalUserId = B2BPermissions.GetPortalUserId(user);
        _partyId = B2BPermissions.GetPartyId(user);
        _responsibleEmployeeId = B2BPermissions.GetResponsibleEmployeeId(user);
        _currentUserName = user.Identity?.Name ?? "portal";

        await LoadRequestsAsync();
        _isLoading = false;
    }

    private async Task LoadRequestsAsync()
    {
        if (_partyId.HasValue)
            _requests = await RequestService.GetRequestsAsync(partyId: _partyId.Value);
    }

    private void SelectRequestType(string type)
    {
        _createModel.RequestType = type;
        if (!SupportsItems(type)) _createModel.Items.Clear();
        else if (!_createModel.Items.Any()) AddItemLine();
    }

    private bool SupportsItems(string type)
        => type is B2BRequestTypes.Quotation or B2BRequestTypes.Reorder;

    private void AddItemLine() => _createModel.Items.Add(new B2BRequestItemInputDto { Quantity = 1 });

    private void RemoveItemLine(int index)
    {
        if (index >= 0 && index < _createModel.Items.Count)
            _createModel.Items.RemoveAt(index);
    }

    private async Task<IEnumerable<B2BProductLookupDto>> SearchProductsAsync(string? value, CancellationToken token)
    {
        try { return await RequestService.SearchProductsAsync(value, 20); }
        catch { return Enumerable.Empty<B2BProductLookupDto>(); }
    }

    private Task OnProductChanged(int index, B2BProductLookupDto? product)
    {
        if (index < 0 || index >= _createModel.Items.Count) return Task.CompletedTask;
        _createModel.Items[index].SelectedProduct = product;
        _createModel.Items[index].ProductId = product?.ProductId;
        return Task.CompletedTask;
    }

    private void ResetForm()
    {
        _createModel = new B2BCreateRequestDto { RequestType = B2BRequestTypes.Quotation };
        AddItemLine();
    }

    private async Task CreateRequestAsync()
    {
        if (!_portalUserId.HasValue || !_partyId.HasValue) return;

        var hasData = _createModel.Items.Any(i => i.ProductId.HasValue || !string.IsNullOrWhiteSpace(i.Notes));

        if (SupportsItems(_createModel.RequestType) && !hasData)
        { Snackbar.Add("أضف بندًا واحدًا على الأقل.", Severity.Warning); return; }

        if (!SupportsItems(_createModel.RequestType) && string.IsNullOrWhiteSpace(_createModel.Notes))
        { Snackbar.Add("اكتب ملخص الطلب قبل الإرسال.", Severity.Warning); return; }

        var (success, message, newId) = await RequestService.CreateAsync(
            _createModel, _portalUserId.Value, _partyId.Value, _responsibleEmployeeId, _currentUserName);

        Snackbar.Add(message, success ? Severity.Success : Severity.Error);
        if (!success) return;

        await LoadRequestsAsync();
        var createdId = newId;
        ResetForm();
        StateHasChanged();

        if (createdId.HasValue)
            Navigation.NavigateTo($"/b2b/requests/{createdId.Value}");
    }

    private void SetHistoryFilter(string status) => _historyStatus = status;

    private int GetHistoryFilterCount(string status) =>
        status == "All" ? _requests.Count : _requests.Count(x => x.Status == status);

    private static int GetProgressPercent(string status) => status switch
    {
        B2BRequestStatuses.New => 20,
        B2BRequestStatuses.UnderReview => 50,
        B2BRequestStatuses.Converted => 100,
        B2BRequestStatuses.Closed => 100,
        B2BRequestStatuses.Rejected => 100,
        _ => 10
    };

    private static string GetRequestTypeText(string v) => v switch
    {
        B2BRequestTypes.Quotation => "طلب عرض سعر",
        B2BRequestTypes.Reorder => "إعادة طلب",
        B2BRequestTypes.PaymentProof => "إثبات دفع",
        B2BRequestTypes.Support => "دعم / استفسار",
        _ => v
    };

    private static string GetRequestStatusText(string v) => v switch
    {
        B2BRequestStatuses.New => "جديد",
        B2BRequestStatuses.UnderReview => "تحت المراجعة",
        B2BRequestStatuses.Converted => "تم التحويل",
        B2BRequestStatuses.Closed => "مغلق",
        B2BRequestStatuses.Rejected => "مرفوض",
        _ => v
    };

    private static string GetStatusClass(string v) => v switch
    {
        B2BRequestStatuses.New => "new",
        B2BRequestStatuses.UnderReview => "review",
        B2BRequestStatuses.Converted => "converted",
        B2BRequestStatuses.Closed => "closed",
        B2BRequestStatuses.Rejected => "rejected",
        _ => "closed"
    };

    private sealed record RequestTypeCardVm(string Key, string Icon, string Title, string Description);
    private sealed record HistoryFilterVm(string Key, string Title);
}